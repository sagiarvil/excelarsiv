  "sayfalar": {
    "KAPAK": {
      "A1": "HAKEDİŞ FİYAT FARKI VE HAK KAYBI CETVELİ",
      "A3": "Hakedişlerinizde fiyat farkını doğru hesaplayın, hak kaybınızı ölçün.",
      "A4": "Sözleşmeli işlerde endeks esaslı fiyat farkı katsayısı sözleşmedeki ağırlık ve endekslerden hesaplanır. Bu cetvel; her hakediş dönemi için fiyat farkını, birikimli etkiyi ve piyasa-rayiç farkından doğan hak kaybını üretir.",
      "A6": "1. SOZLESME_KARTI sayfasına sözleşme bilgilerini ve fiyat farkı formülünü girin.",
      "A7": "2. HAKEDIS_KALEMLERI, ENDEKS_KAYITLARI ve HAKEDIS_DONEMLERI sayfalarını doldurun.",
      "A8": "3. KARAR sayfasında fiyat farkını, hak kaybını ve aksiyonları okuyun.",
      "A10": "Bu dosya karar destek aracıdır; fiyat farkı hesaplama danışmanlığı yerine geçmez. Formül katsayıları (a, b, c, d) sözleşmeden birebir alınmalıdır.",
      "A15": "ExcelArşiv",
      "A16": "Rev 1.0 | 2026-08-08 | Lisans: Tek kullanıcı"
    },
    "HIZLI_BASLANGIC": {
      "A3": "Nasıl kullanılır?",
      "A4": "1. AYARLAR sayfasından rapor tarihini ve eşikleri (kayıp eşiği, endeks bant oranı) kontrol edin.",
      "A5": "2. SOZLESME_KARTI sayfasına sözleşme bilgilerini, ağırlıkları (a, b, c, d) ve temel endeksleri girin.",
      "A6": "3. HAKEDIS_KALEMLERI sayfasına kalem bazında hakediş miktar ve birim fiyatlarını girin.",
      "A7": "4. ENDEKS_KAYITLARI sayfasına her endeksin dönem değerlerini girin; katsayı otomatik hesaplanır.",
      "A8": "5. HAKEDIS_DONEMLERI sayfasına dönem hakediş tutarlarını ve ödeme tarihlerini girin.",
      "A9": "6. KARAR sayfası fiyat farkını, hak kaybını ve UYGUN / İNCELE / DURDUR kararını gösterir.",
      "A10": "7. PANO ve RAPOR sayfaları yönetici özetini ve yazdırılabilir raporu sunar.",
      "A12": "Sık yapılan hatalar",
      "A13": "Ağırlık katsayılarını (a+b+c+d=1) sözleşmeden teyit etmeden girmek — katsayı toplamı 1 olmazsa sonuç bozulur.",
      "A14": "Temel endeks ile dönem endeksini karıştırmak — oran ters döner, fiyat farkı eksi çıkar.",
      "A15": "Hakediş tutarını KDV dahil girmek — fiyat farkı KDV hariç tutar üzerinden işler.",
      "A16": "Piyasa birim fiyatı yerine sözleşme fiyatını girmek — hak kaybı görünmez olur.",
      "A17": "Kilitli (beyaz/yeşil) hücrelere yazmaya çalışmak — yalnızca sarı hücreler giriş içindir.",
      "A19": "Tüm eşikler ve katsayılar AYARLAR sayfasından beslenir; formüle gömülü sayı kullanılmaz."
    },
