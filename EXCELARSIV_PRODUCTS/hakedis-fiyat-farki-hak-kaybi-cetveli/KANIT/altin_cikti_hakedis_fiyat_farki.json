    "SENARYO_DUYARLILIK": {
      "A1": "SENARYO DUYARLILIK — HAKEDİŞ FİYAT FARKI VE HAK KAYBI CETVELİ",
      "A3": "Senaryo ve Duyarlılık Analizi",
      "A5": "A. SENARYO MOTORU",
      "A6": "Senaryo",
      "B6": "İşçilik Değişimi",
      "C6": "Malzeme Değişimi",
      "D6": "Fiyat Farkı Katsayısı",
      "E6": "Dönem Fiyat Farkı (₺)",
      "F6": "Hak Kaybı Oranı",
      "G6": "Karar",
      "A7": "KÖTÜMSER",
      "B7": "=IsciEndeksOran*(1+SenaryoKotumserKat)",
      "C7": "=MalzemeEndeksOran*(1+SenaryoKotumserKat)",
      "D7": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+B7)+_c*(1+C7)+d*(1+MakineEndeksOran))-1)",
      "E7": "=ROUND(DonemHakedisToplam*D7,0)",
      "F7": "=IFERROR(IF(HakedisKalemToplam=0,0,HakKaybiToplam/HakedisKalemToplam*(1+SenaryoKotumserKat)),0)",
      "G7": "=IF(E7<=0,\"DURDUR\",IF(F7>KayipDikkatOran,\"DURDUR\",\"İNCELE\"))",
      "A8": "BAZ",
      "B8": "=IsciEndeksOran",
      "C8": "=MalzemeEndeksOran",
      "D8": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+B8)+_c*(1+C8)+d*(1+MakineEndeksOran))-1)",
      "E8": "=ROUND(DonemHakedisToplam*D8,0)",
      "F8": "=IFERROR(IF(HakedisKalemToplam=0,0,HakKaybiToplam/HakedisKalemToplam),0)",
      "G8": "=IF(E8<=0,\"DURDUR\",IF(F8>KayipDikkatOran,\"DURDUR\",\"UYGUN\"))",
      "A9": "İYİMSER",
      "B9": "=IsciEndeksOran*(1-SenaryoIyimserKat)",
      "C9": "=MalzemeEndeksOran*(1-SenaryoIyimserKat)",
      "D9": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+B9)+_c*(1+C9)+d*(1+MakineEndeksOran))-1)",
      "E9": "=ROUND(DonemHakedisToplam*D9,0)",
      "F9": "=IFERROR(IF(HakedisKalemToplam=0,0,HakKaybiToplam/HakedisKalemToplam*(1-SenaryoIyimserKat)),0)",
      "G9": "=IF(E9<=0,\"DURDUR\",IF(F9>KayipDikkatOran,\"DURDUR\",\"UYGUN\"))",
      "A11": "B. TORNADO / DUYARLILIK",
      "A12": "Değişken",
      "B12": "Alt (-%5)",
      "C12": "Baz",
      "D12": "Üst (+%5)",
      "E12": "Katsayı Alt",
      "F12": "Katsayı Üst",
      "G12": "Etki (puan)",
      "A13": "İşçilik Endeksi",
      "B13": "=IsciEndeksOran-DuyarliDegisim",
      "C13": "=IsciEndeksOran",
      "D13": "=IsciEndeksOran+DuyarliDegisim",
      "E13": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+B13)+_c*(1+MalzemeEndeksOran)+d*(1+MakineEndeksOran))-1)",
      "F13": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+D13)+_c*(1+MalzemeEndeksOran)+d*(1+MakineEndeksOran))-1)",
      "G13": "=ABS(F13-E13)",
      "A14": "Malzeme Endeksi",
      "B14": "=MalzemeEndeksOran-DuyarliDegisim",
      "C14": "=MalzemeEndeksOran",
      "D14": "=MalzemeEndeksOran+DuyarliDegisim",
      "E14": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+IsciEndeksOran)+_c*(1+B14)+d*(1+MakineEndeksOran))-1)",
      "F14": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+b*(1+IsciEndeksOran)+_c*(1+D14)+d*(1+MakineEndeksOran))-1)",
      "G14": "=ABS(F14-E14)",
      "A15": "b Ağırlığı",
      "B15": "=MAX(0,b-DuyarliDegisim)",
      "C15": "=b",
      "D15": "=MIN(1,b+DuyarliDegisim)",
      "E15": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+B15*(1+IsciEndeksOran)+_c*(1+MalzemeEndeksOran)+d*(1+MakineEndeksOran))-1)",
      "F15": "=IF(FiyatFarkiVarMi=\"Hayır\",0,(a+D15*(1+IsciEndeksOran)+_c*(1+MalzemeEndeksOran)+d*(1+MakineEndeksOran))-1)",
      "G15": "=ABS(F15-E15)",
      "A17": "C. EŞİK / KIRILIM ANALİZİ",
      "A18": "Kırılım: Fiyat Farkının Sıfırlandığı Endeks Değişimi",
      "B18": "=IFERROR(-(a-1)/(b+_c+d),0)",
      "A19": "Eşik Farkı (Mevcut Kayıp Oranı - Kabul Edilebilir)",
      "B19": "=IFERROR(HakKaybiOran-KayipEsikOran,0)",
      "A20": "Değer Ölçer: Toplam Fiyat Farkı + Fark",
      "B20": "=IFERROR(BirikimliFiyatFarki+HakKaybiToplam,0)",
      "A23": "Senaryo çarpanları ve duyarlılık oranı AYARLAR'dan gelir."
    },
    "RAPOR": {
      "A1": "HAKEDİŞ FİYAT FARKI VE HAK KAYBI RAPORU",
      "A2": "=SozlesmeAdi & \" — \" & Yuklenici",
      "A3": "=TEXT(SozlesmeTarihi,\"gg.aa.yyyy\") & \" | Rapor: \" & TEXT(raporTarihi,\"gg.aa.yyyy\")",
      "A5": "1. ÖZET",
      "A6": "Sözleşme Bedeli",
      "B6": "=SozlesmeBedeli",
      "A7": "Fiyat Farkı Katsayısı",
      "B7": "=FiyatFarkiKatsayi",
      "A8": "Dönem Fiyat Farkı",
      "B8": "=DonemFiyatFarki",
      "A9": "Toplam Hak Kaybı",
      "B9": "=HakKaybiToplam",
      "A10": "Karar",
      "B10": "=KararSonuc",
      "A12": "2. KARAR GEREKÇESİ",
      "A13": "=KararGerekce",
      "A15": "3. VARSAYIMLAR",
      "A16": "• Fiyat farkı formülü sözleşmedeki ağırlıklara (a, b, c, d) ve temel endekslere dayanır.",
      "A17": "• Endeksler TÜİK veya sözleşmede tanımlı endekslerden alınır.",
      "A18": "• Piyasa birim fiyatları hakediş döneminin güncel rayiçleridir.",
      "A19": "• Fiyat farkı KDV hariç hakediş tutarı üzerinden hesaplanır.",
      "A21": "4. UYARILAR",
      "A22": "=IF(KayipDurumu=\"KRİTİK\",\"Hak kaybı kritik seviyede; yüklenici ile mutabakat önerilir.\",\"Hak kaybı kabul edilebilir seviyede.\")",
      "A23": "=IF(AnomaliEndeksAdet>0,\"Uç endeks hareketi var; TÜİK verisiyle teyit edin.\",\"Endeks hareketleri tutarlı.\")",
      "A25": "5. ÖNERİLEN AKSİYONLAR",
      "A26": "=Aksiyon1",
      "A27": "=Aksiyon2",
      "A28": "=Aksiyon3",
      "A30": "=SozlesmeAdi & \" | \" & TEXT(raporTarihi,\"gg.aa.yyyy\") & \" | Rev 1.0\"",
      "A31": "Bu rapor karar destek çıktısıdır; mali müşavirlik veya hukuk danışmanlığı yerine geçmez."
    },
    "ORNEK_VERI": {
      "A1": "ORNEK VERI — HAKEDİŞ FİYAT FARKI VE HAK KAYBI CETVELİ",
      "A3": "Örnek Veri ve İçe Aktarma Yapısı",
      "A4": "Bu sayfa otomasyon/içe aktarma içindir; kalemleri CSV/Excel'den kopyalayabilirsiniz.",
      "A6": "Kalem Adı",
      "B6": "Birim",
      "C6": "Hakediş Miktarı",
      "D6": "Sözleşme Birim Fiyatı (₺)",
      "E6": "Piyasa Birim Fiyatı (₺)",
      "A7": "Beton",
      "B7": "m³",
      "C7": 1200,
      "D7": 1450,
