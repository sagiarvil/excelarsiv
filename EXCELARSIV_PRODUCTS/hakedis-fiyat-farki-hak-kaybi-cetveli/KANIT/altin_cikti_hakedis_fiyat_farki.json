    "MOTOR": {
      "A1": "MOTOR — HAKEDİŞ FİYAT FARKI VE HAK KAYBI CETVELİ",
      "A3": "Hesaplama Motoru — Fiyat Farkı ve Hak Kaybı",
      "A6": "İşçilik Endeks Oranı (Gk/G0)",
      "B6": "=IFERROR(INDEX(tblEndeks[Değişim Oranı],MATCH(\"İşçilik\",tblEndeks[Endeks Adı],0)),0)",
      "A7": "Malzeme Endeks Oranı (Bk/B0)",
      "B7": "=IFERROR(INDEX(tblEndeks[Değişim Oranı],MATCH(\"Malzeme\",tblEndeks[Endeks Adı],0)),0)",
      "A8": "Makine Endeks Oranı (Yk/Y0)",
      "B8": "=IFERROR(INDEX(tblEndeks[Değişim Oranı],MATCH(\"Makine\",tblEndeks[Endeks Adı],0)),0)",
      "A9": "Ağırlık Toplamı (a+b+c+d)",
      "B9": "=IFERROR(a+b+_c+d,0)",
      "A10": "Fiyat Farkı Katsayısı (F)",
      "B10": "=IF(OR(FiyatFarkiVarMi=\"Hayır\",AgirlikToplam=0),0,IFERROR((a+b*(1+IsciEndeksOran)+_c*(1+MalzemeEndeksOran)+d*(1+MakineEndeksOran))-1,0))",
      "A11": "Dönem Fiyat Farkı Tutarı",
      "B11": "=IFERROR(ROUND(DonemHakedisToplam*FiyatFarkiKatsayi,0),0)",
      "A12": "Birikimli Fiyat Farkı",
      "B12": "=IFERROR(ROUND(DonemFiyatFarki*COUNTA(tblDonem[Dönem Numarası]),0),0)",
      "A13": "Hakediş Kalemleri Toplamı",
      "B13": "=IFERROR(ROUND(SUM(tblKalem[Hakediş Tutarı (₺)]),0),0)",
      "A14": "Piyasa Kalem Toplamı",
      "B14": "=IFERROR(ROUND(SUM(tblKalem[Piyasa Tutarı (₺)]),0),0)",
      "A15": "Toplam Hak Kaybı",
      "B15": "=IFERROR(ROUND(SUM(tblKalem[Kayıp (₺)]),0),0)",
      "A16": "Hak Kaybı Oranı",
      "B16": "=IFERROR(IF(HakedisKalemToplam=0,0,HakKaybiToplam/HakedisKalemToplam),0)",
      "A17": "Kayıp Durumu",
      "B17": "=IF(OR(HakedisKalemToplam=0,HakKaybiToplam=0),\"VERİ YETERSİZ\",IF(HakKaybiOran<=KayipEsikOran,\"NORMAL\",IF(HakKaybiOran<=KayipDikkatOran,\"DİKKAT\",\"KRİTİK\")))",
      "A18": "Endeks Ortalama Değişim",
      "B18": "=IFERROR(AVERAGE(tblEndeks[Değişim Oranı]),0)",
      "A19": "Endeks Projeksiyonu (Sonraki Dönem)",
      "B19": "=IFERROR(forecast.lınear(COUNTA(tblEndeks[Endeks Adı])+1,tblEndeks[Dönem Endeksi],ROW(tblEndeks[Dönem Endeksi])-ROW(tblEndeks[[#Headers],[Dönem Endeksi]])),0)",
      "A20": "Tahmin Alt Sınırı",
      "B20": "=IFERROR(EndeksProjeksiyon-EndeksOrtalama*EndeksBantOrani,0)",
      "A21": "Tahmin Üst Sınırı",
      "B21": "=IFERROR(EndeksProjeksiyon+EndeksOrtalama*EndeksBantOrani,0)",
      "A22": "Anomali Endeks Adedi",
      "B22": "=SUMPRODUCT(--(tblEndeks[Değişim Oranı]<>\"\"),--(ABS(tblEndeks[Değişim Oranı]-EndeksOrtalama)>AnomaliZEsik*IFERROR(stdev.p(tblEndeks[Değişim Oranı]),0)))",
      "A23": "Analitik Modül Hesapları",
      "A24": "Modül T2: Endeks Eğilimi (dönem başı)",
      "B24": "=IFERROR(SLOPE(tblEndeks[Dönem Endeksi],ROW(tblEndeks[Dönem Endeksi])-ROW(tblEndeks[[#Headers],[Dönem Endeksi]]))/MAX(1,AVERAGE(tblEndeks[Dönem Endeksi])),0)",
      "A25": "Modül T3: En Büyük Kalem Kaybının Payı",
      "B25": "=IFERROR(LARGE(tblKalem[Kayıp (₺)],1)/MAX(1,SUM(tblKalem[Kayıp (₺)])),0)",
      "A26": "Modül T5: Kalem-Piyasa Mutabakat Farkı",
      "B26": "=IFERROR(HakedisKalemToplam-DonemHakedisToplam,0)",
      "A27": "Modül T6: Kayıp Kırılım Oranı",
      "B27": "=IFERROR(IF(KayipDikkatOran=0,0,HakKaybiOran/KayipDikkatOran),0)",
      "A28": "Modül O1: Anomali Endeks Sayısı",
      "B28": "=AnomaliEndeksAdet",
      "A29": "Modül O2: En Etkili Değişken (Tornado)",
      "B29": "=IFERROR(INDEX(SENARYO_DUYARLILIK!$A$13:$A$15,MATCH(MAX(SENARYO_DUYARLILIK!$G$13:$G$15),SENARYO_DUYARLILIK!$G$13:$G$15,0)),\"VERİ YETERSİZ\")",
      "A30": "Modül O3: Baz Senaryo Katsayısı",
      "B30": "=SENARYO_DUYARLILIK!$D$8",
      "A31": "Modül O4: Ortalama Geç Ödeme Günü",
      "B31": "=IFERROR(AVERAGE(tblDonem[Geç Ödeme Gün]),0)",
      "A32": "Modül O8: Veri Kalite Skoru",
      "B32": "=KONTROL!$B$19",
      "A33": "Modül I1: Tahmin Orta Noktası",
      "B33": "=EndeksProjeksiyon",
      "A34": "Modül I2: Endeks P90",
      "B34": "=IFERROR(PERCENTILE(tblEndeks[Dönem Endeksi],P90Kuantil),0)",
      "A35": "Modül I7: Geç Ödeme Kaynaklı Nakit Açığı",
      "B35": "=IFERROR(ROUND(DonemHakedisToplam*KayipOraniEsik*MAX(0,modulO4NakitGunu-ODemeGecikmeEsik)/MAX(ODemeGecikmeEsik,1),0),0)",
      "A36": "Değer Ölçer: Toplam Kazanım",
      "B36": "=IFERROR(BirikimliFiyatFarki+MAX(0,HakKaybiToplam),0)",
      "A37": "Değer Ölçer: Kazanım Oranı",
      "B37": "=IFERROR(IF(SozlesmeBedeli=0,0,degerKazanim/SozlesmeBedeli),0)",
      "A39": "Modül Makine Yorumları",
      "A40": "T2 Endeks Eğilimi",
      "B40": "=modulT2EndeksEgim",
      "C40": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"T2: Endeks eğilimi dönem başına \"&TEXT(modulT2EndeksEgim*100,\"0,0\")&\"% değişim öngörüyor\",IF(modulT2EndeksEgim>0,\"endeksler yükselme eğiliminde, fiyat farkı lehte\",\"endeksler düşme eğiliminde, fiyat farkı sınırlı\"))",
      "A41": "T3 Pareto Kayıp Payı",
      "B41": "=modulT3ParetoPayi",
      "C41": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"T3: Kayıp yoğunlaşması — en büyük kalem toplam kaybın \"&TEXT(modulT3ParetoPayi*100,\"0\")&\"% tutarında\",IF(modulT3ParetoPayi>ParetoEsikOran,\"kayıp tek kalemde yoğun, revize birim fiyat öncelikli\",\"kayıp kalemlere dağılmış\"))",
      "A42": "T5 Mutabakat Farkı",
      "B42": "=modulT5MutabakatFark",
      "C42": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"T5: Kalem toplamı ile dönem hakedişi arası fark \"&TEXT(modulT5MutabakatFark,\"#,##0\")&\" TL\",IF(ABS(modulT5MutabakatFark)<=MutabakatTolerans,\"mutabakat sağlandı\",\"mutabakat farkı var, dönem kayıtlarını kontrol edin\"))",
      "A43": "T6 Kırılım Oranı",
      "B43": "=modulT6KirilimOrani",
      "C43": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"T6: Kayıp oranı dikkat eşiğinin \"&TEXT(modulT6KirilimOrani*100,\"0\")&\"% seviyesinde\",IF(modulT6KirilimOrani>=1,\"kayıp kritik bölgede\",\"kayıp eşik altında\"))",
      "A44": "O1 Anomali Sayısı",
      "B44": "=modulO1AnomaliSayisi",
      "C44": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"O1: Anomali — \"&modulO1AnomaliSayisi&\" endeks hareketi Z eşiğini aşıyor\",IF(modulO1AnomaliSayisi>0,\"uç endeksleri TÜİK yayınıyla mutabakat edin\",\"endeks hareketleri tutarlı\"))",
      "A45": "O2 Tornado Zirve",
      "B45": "=modulO2TornadoZirve",
      "C45": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"O2: Duyarlılık — katsayıyı en çok etkileyen değişken: \"&modulO2TornadoZirve,IF(modulO2TornadoZirve=\"İşçilik Endeksi\",\"işçilik verisini sözleşme ve TÜİK endekslerinden teyit edin\",\"ana değişken netleşti\"))",
      "A46": "O3 Senaryo Baz",
      "B46": "=modulO3SenaryoBaz",
      "C46": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"O3: Senaryo motoru — baz senaryo katsayısı \"&TEXT(modulO3SenaryoBaz,\"0,0%\"),IF(modulO3SenaryoBaz<=0,\"baz senaryo fiyat farkı üretmiyor\",\"senaryo aralığı karar için yeterli\"))",
      "A47": "O4 Nakit Dönüşüm Günü",
      "B47": "=modulO4NakitGunu",
      "C47": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"O4: Ortalama geç ödeme \"&modulO4NakitGunu&\" gün\",IF(modulO4NakitGunu>ODemeGecikmeEsik,\"ödemeler eşik üstü gecikiyor, nakit planını gözden geçirin\",\"ödemeler eşik içinde\"))",
      "A48": "O8 Veri Kalite Skoru",
      "B48": "=modulO8KaliteSkoru",
      "C48": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"O8: Veri kalitesi \"&modulO8KaliteSkoru&\"/100\",IF(modulO8KaliteSkoru<VeriKaliteOrtaEsik,\"girişler eksik, karar güvenilir değil\",\"giriş kalitesi karar için yeterli\"))",
      "A49": "I1 Tahmin Orta",
      "B49": "=modulI1TahminOrta",
      "C49": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"I1: Tahmin — sonraki dönem endeksi \"&TEXT(modulI1TahminOrta,\"#,##0\")&\" öngörülüyor\",IF(modulI1TahminOrta>MAX(tblEndeks[Dönem Endeksi]),\"tahmin mevcut endekslerin üzerinde\",\"tahmin mevcut seviyeye yakın\"))",
      "A50": "I2 Yüzdelik P90",
      "B50": "=modulI2P90",
      "C50": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"I2: Dağılım — endekslerin %90'ı \"&TEXT(modulI2P90,\"#,##0\")&\" değerinin altında\",IF(modulI2P90>0,\"dağılım genişliği okunabilir\",\"veri az, dağılım güvenilir değil\"))",
      "A51": "I7 Nakit Açığı",
      "B51": "=modulI7NakitAcigi",
      "C51": "=_xlfn.TEXTJOIN(\" | \",TRUE(),\"I7: Geç ödeme kaynaklı tahmini nakit ihtiyacı \"&TEXT(modulI7NakitAcigi,\"#,##0\")&\" TL\",IF(modulI7NakitAcigi>0,\"nakit akışına eşik üstü gecikme maliyeti yansıyor\",\"gecikme kaynaklı ek maliyet yok\"))",
      "A53": "Fiyat farkı katsayısı sözleşme ağırlıkları ve endeks değişimlerinden üretilir; modül yorumları makinedir."
    },
    "KONTROL": {
      "A1": "KONTROL — HAKEDİŞ FİYAT FARKI VE HAK KAYBI CETVELİ",
      "A3": "Veri Kalitesi ve Sağlık Kontrolü",
      "A5": "A. GİRİŞ TAMLIK KONTROLÜ",
      "A7": "Sözleşme Adı Boş",
      "B7": "=IF(SozlesmeAdi=\"\",\"FAIL\",\"PASS\")",
      "A8": "Sözleşme Bedeli Boş/Sıfır",
      "B8": "=IF(OR(SozlesmeBedeli=\"\",SozlesmeBedeli<=0),\"FAIL\",\"PASS\")",
      "A9": "Ağırlık Toplamı ≠ 1",
      "B9": "=IF(ABS(AgirlikToplam-1)>AgirlikTolerans,\"FAIL\",\"PASS\")",
      "A10": "Fiyat Farkı Maddesi Boş",
      "B10": "=IF(FiyatFarkiVarMi=\"\",\"FAIL\",\"PASS\")",
      "A11": "Endeks Kaydı Yok",
      "B11": "=IF(COUNT(tblEndeks[Dönem Endeksi])=0,\"FAIL\",\"PASS\")",
      "A12": "Hakediş Kalemi Yok",
      "B12": "=IF(COUNT(tblKalem[Hakediş Tutarı (₺)])=0,\"WARN\",\"PASS\")",
      "A13": "Hak Kaybı Dikkat",
      "B13": "=IF(KayipDurumu=\"DİKKAT\",\"WARN\",IF(KayipDurumu=\"KRİTİK\",\"FAIL\",\"PASS\"))",
      "A15": "B. SKOR VE SAĞLIK",
      "A16": "Dolu Giriş Hücresi",
      "B16": "=COUNTIF(tblKalem[Hakediş Miktarı],\">0\")+COUNTIF(tblEndeks[Dönem Endeksi],\">0\")+COUNTIF(tblDonem[Hakediş Tutarı (₺)],\">0\")",
      "A17": "PASS Sayısı",
      "B17": "=COUNTIF(B7:B13,\"PASS\")",
      "A18": "FAIL Sayısı",
      "B18": "=COUNTIF(B7:B13,\"FAIL\")",
      "A19": "Veri Kalite Skoru (0-100)",
      "B19": "=IF(COUNTIF(B7:B13,\"FAIL\")=0,ROUND(100-COUNTIF(B7:B13,\"WARN\")*VeriKaliteUyariCeza,0),0)",
      "A20": "Güven Seviyesi",
      "B20": "=IF(VeriKaliteSkoru=0,\"VERİ YETERSİZ\",IF(VeriKaliteSkoru>=VeriKaliteIyiEsik,\"YÜKSEK\",IF(VeriKaliteSkoru>=VeriKaliteOrtaEsik,\"ORTA\",\"DÜŞÜK\")))",
      "A22": "Durum",
      "B22": "=IF(FAIL_Sayisi=0,\"SAĞLIKLI\",\"İNCELE\")",
      "A24": "Skor ve sağlık durumu formülle üretilir; sahte veri yoktur."
    },
    "KARAR": {
      "A1": "KARAR — HAKEDİŞ FİYAT FARKI VE HAK KAYBI CETVELİ",
      "A3": "Karar Motoru",
      "A5": "FİYAT FARKI VE HAK KAYBI ÖZETİ",
      "A6": "Fiyat Farkı Katsayısı",
      "B6": "=FiyatFarkiKatsayi",
      "A7": "Dönem Fiyat Farkı",
      "B7": "=DonemFiyatFarki",
      "A8": "Toplam Hak Kaybı",
      "B8": "=HakKaybiToplam",
      "A9": "Hak Kaybı Oranı",
      "B9": "=HakKaybiOran",
      "A11": "KARAR",
      "B11": "=IF(DoluGirisHucre=0,\"VERİ YOK\",IF(VeriKaliteSkoru=0,\"VERİ YETERSİZ\",IF(OR(AgirlikToplam>1+AgirlikTolerans,AgirlikToplam<1-AgirlikTolerans),\"DURDUR\",IF(KayipDurumu=\"KRİTİK\",\"DURDUR\",IF(OR(FiyatFarkiKatsayi<=0,KayipDurumu=\"DİKKAT\"),\"İNCELE\",\"UYGUN\")))))",
      "A12": "GEREKÇE",
      "B12": "=IF(DoluGirisHucre=0,\"Hiç veri girilmedi; lütfen sarı hücreleri doldurun.\",IF(VeriKaliteSkoru=0,\"Girdi eksik; lütfen sarı hücreleri doldurun.\",IF(ABS(AgirlikToplam-1)>AgirlikTolerans,\"Ağırlık toplamı 1 değil: \"&TEXT(AgirlikToplam,\"0.0%\")&\". Katsayıları sözleşmeden kontrol edin.\",IF(KayipDurumu=\"KRİTİK\",\"Hak kaybı oranı \"&TEXT(HakKaybiOran,\"0.0%\")&\" ile kritik seviyede.\",IF(FiyatFarkiKatsayi<=0,\"Fiyat farkı katsayısı pozitif değil; endeks ve ağırlıkları inceleyin.\",IF(KayipDurumu=\"DİKKAT\",\"Hak kaybı oranı \"&TEXT(HakKaybiOran,\"0.0%\")&\" ile dikkat seviyesinde.\",\"Fiyat farkı ve hak kaybı kabul edilebilir aralıkta.\"))))))",
      "A14": "AKSİYONLAR",
      "A15": "=IF(OR(KararSonuc=\"VERİ YOK\",KararSonuc=\"VERİ YETERSİZ\",KararSonuc=\"DURDUR\"),\"Ağırlık katsayılarını ve girdileri sözleşme/endeks belgelerinden kontrol edin\",IF(FiyatFarkiKatsayi<=0,\"Endeks kayıtlarını güncelleyin; temel-dönem endeksi sıralamasını doğrulayın\",\"Fiyat farkı tahakkukunu dönem hakedişine yansıtın\"))",
      "A16": "=IF(HakKaybiOran>KayipEsikOran,\"Hak kaybını yüklenici ile görüşün; revize birim fiyat veya zam farkı gündemini değerlendirin\",\"Hak kaybı kabul edilebilir aralıkta\")",
      "A17": "=IF(KayipDurumu=\"KRİTİK\",\"Piyasa birim fiyatlarını üçüncü taraftan teyit edin ve kayıp tutarını belgelendirin\",\"Piyasa verisi normal görünüyor\")",
      "A18": "=IF(AnomaliEndeksAdet>0,\"Uç endeks hareketlerini TÜİK yayınlarıyla mutabakat edin\",\"Endeks hareketleri tutarlı\")",
      "A21": "Karar, gerekçe ve aksiyonlar makine tarafından üretilir; yalnızca sarı hücreler değiştirilebilir."
    },
