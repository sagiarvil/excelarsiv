{
  "pre-tool-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/pre_tool_guard.js"
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/pre_tool_guard.js"
          }
        ]
      }
    ]
  },
  "post-tool-bom-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ensure_utf8_nobom.js"
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ensure_utf8_nobom.js"
          }
        ]
      }
    ]
  }
}
