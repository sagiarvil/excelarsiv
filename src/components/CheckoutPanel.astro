---
import Icon from '../components/Icon.astro';

interface Props {
  productSlug: string;
  name: string;
  priceTL?: number;
}

const { productSlug, name } = Astro.props;
const whatsappNumber = '905393333303';
const message = `Merhaba, ${name} (Kodu: ${productSlug}) sistemi hakkında detaylı bilgi ve teklif almak istiyorum.`;
const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<section
  id="satin-al"
  class="checkout-card"
  data-product-slug={productSlug}
>
  <div class="checkout-card__head">
    <div>
      <p class="checkout-card__kicker">TAM KARAR SİSTEMİ</p>
      <h2>Bu Sistem İçin Teklif Alın</h2>
    </div>
  </div>

  <p class="checkout-card__lead">Şirketinize özel uyarlama, kurulum ve fiyatlandırma seçenekleri için uzmanımızla doğrudan WhatsApp üzerinden görüşebilirsiniz.</p>

  <div class="checkout-card__actions">
    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="wa-button">
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.06-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      WhatsApp'tan Teklif İsteyin
    </a>
  </div>

  <div class="checkout-card__microcopy" aria-label="Teklif bilgileri">
    <span>Hızlı Yanıt</span><i aria-hidden="true"></i><span>Uzman Danışman</span><i aria-hidden="true"></i><span>Kurulum Desteği</span>
  </div>
</section>

<style>
  .checkout-card{height:100%;padding:24px 26px;border:1px solid #c5d4cb;border-radius:20px;background:linear-gradient(180deg,#fff 0%,#f0fdf4 100%);box-shadow:0 12px 30px rgba(21,70,44,.06);display:flex;flex-direction:column;justify-content:center}
  .checkout-card__head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
  .checkout-card__kicker{margin:0;font-family:var(--font-mono);font-size:12px;font-weight:800;letter-spacing:.09em;color:#0b7440}
  .checkout-card h2{margin:6px 0 0;font-family:var(--font-display);font-size:24px;line-height:1.1;letter-spacing:-.025em;color:#14271d}
  .checkout-card__lead{margin:14px 0 0;font-size:15px;line-height:1.55;color:#3a4a41}
  .checkout-card__actions{margin-top:24px}
  .wa-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:54px;border-radius:14px;background:#25D366;color:#fff;font-family:var(--font-body);font-size:16px;font-weight:800;text-decoration:none;transition:all .2s ease;box-shadow:0 8px 20px rgba(37,211,102,.25)}
  .wa-button:hover{background:#1da851;transform:translateY(-2px);box-shadow:0 12px 24px rgba(37,211,102,.3)}
  .checkout-card__microcopy{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:20px;font-family:var(--font-body);font-size:13px;font-weight:700;color:#2f3f36}
  .checkout-card__microcopy i{width:4px;height:4px;border-radius:50%;background:#8a9a90}
  @media(max-width:700px){.checkout-card{padding:20px}.checkout-card h2{font-size:22px}}
</style>
