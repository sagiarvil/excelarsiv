---
import MobileCommerceEngine from './mobile/MobileCommerceEngine.astro';

const pathname = Astro.url.pathname;
const initialTab = pathname.startsWith('/sablon')
  ? 'sablonlar'
  : pathname.startsWith('/ozel')
    ? 'ozel-sistemler'
    : 'home';
---

<MobileCommerceEngine initialTab={initialTab} />
