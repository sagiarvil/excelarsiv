---
const pathname = Astro.url.pathname;
const searchHref = pathname === '/' ? '/#hero-search' : '/sablonlar';
---

<nav class="mobile-commerce-bar" aria-label="Mobil hızlı işlemler">
  <a class="mobile-commerce-bar__search" href={searchHref} data-cta="mobile_dock_search" data-location="mobile_dock">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <span>Ara</span>
  </a>
  <a class="mobile-commerce-bar__ready" href="/sablonlar" data-cta="mobile_dock_ready" data-location="mobile_dock">
    <span>Sistemler</span><small>Hazır çözümler</small>
  </a>
  <a class="mobile-commerce-bar__custom" href="/ozel-excel-sistemleri" data-cta="mobile_dock_custom" data-location="mobile_dock">
    <span>Size Özel</span><small>15 dk ön teşhis</small>
  </a>
</nav>

<style>
  .mobile-commerce-bar { display:none; }

  @media(max-width:720px){
    .mobile-commerce-bar{
      position:fixed;
      left:10px;
      right:10px;
      bottom:calc(8px + env(safe-area-inset-bottom));
      z-index:90;
      display:grid;
      grid-template-columns:58px minmax(0,1fr) minmax(0,1fr);
      gap:7px;
      padding:7px;
      border:1px solid rgba(15,23,42,.09);
      border-radius:20px;
      background:rgba(255,255,255,.97);
      box-shadow:0 20px 55px rgba(15,23,42,.17);
      backdrop-filter:blur(18px) saturate(160%);
    }

    .mobile-commerce-bar a{
      min-width:0;
      min-height:50px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:14px;
      text-decoration:none;
      -webkit-tap-highlight-color:transparent;
    }

    .mobile-commerce-bar__search{
      flex-direction:column;
      gap:3px;
      border:1px solid #e0e7e3;
      background:#f8faf9;
      color:#314239;
      font-family:var(--font-body);
      font-size:10px;
      font-weight:800;
    }

    .mobile-commerce-bar__ready,
    .mobile-commerce-bar__custom{
      flex-direction:column;
      gap:2px;
      padding:7px 9px;
      font-family:var(--font-body);
    }

    .mobile-commerce-bar__ready{
      border:1px solid #cfe5d8;
      background:#f2faf5;
      color:#0b6339;
    }

    .mobile-commerce-bar__custom{
      background:#059669;
      color:#fff;
      box-shadow:0 9px 20px rgba(5,150,105,.22);
    }

    .mobile-commerce-bar__ready span,
    .mobile-commerce-bar__custom span{
      max-width:100%;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
      font-size:13px;
      line-height:1.15;
      font-weight:850;
    }

    .mobile-commerce-bar__ready small,
    .mobile-commerce-bar__custom small{
      max-width:100%;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
      font-size:9.5px;
      line-height:1.2;
      font-weight:650;
      opacity:.76;
    }
  }

  @media(max-width:350px){
    .mobile-commerce-bar{grid-template-columns:52px 1fr 1fr;left:7px;right:7px}
    .mobile-commerce-bar__ready small,.mobile-commerce-bar__custom small{display:none}
  }
</style>
