---
interface Props {
  href: string;
  urunAdi: string;
}

const { href, urunAdi } = Astro.props;
---

<aside class="rehber-cta">
  <p>Hazır uygulama</p>
  <strong>Bu yöntemi hazır Excel sistemiyle uygulayın</strong>
  <a href={href}>{urunAdi} →</a>
</aside>

<style>
  .rehber-cta { margin: 28px 0; padding: 16px 18px; border: 1px solid #d7e2db; border-radius: 0; background: #f6f9f7; }
  .rehber-cta p { margin: 0; font-family: var(--font-mono); font-size: 10px; font-weight: 800; letter-spacing: .08em; color: #0d7040; }
  .rehber-cta strong { display: block; margin-top: 6px; font-size: 15px; color: #173023; }
  .rehber-cta a { display: inline-block; margin-top: 10px; font-size: 12px; font-weight: 800; color: #0d7040; text-decoration: none; }
</style>
