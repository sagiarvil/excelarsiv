                          <span>18 işletme probleminden uygun sistemi bulun →</span>
                        </div>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`site-header__link${active ? ' is-active' : ''}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="site-header__actions">
      <!-- Desktop Hızlı Arama Butonu / Input -->
      <div class="site-header__desktop-search" data-header-search-box>
        <form action="/sablonlar" method="get" class="site-header__desktop-search-form" role="search" data-header-search-form>
