---
interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
const pathname = Astro.url.pathname;

const menu = [
  { label: 'Şablonlar', href: '/sablonlar' },
  { label: 'Size Özel', href: '/ozel-excel-sistemleri' },
  { label: 'Ücretsiz Demo', href: '/demo' },
  { label: 'Nasıl Çalışır', href: '/nasil-calisir' },
  { label: 'Rehber', href: '/rehber' },
  { label: 'Hakkımızda', href: '/hakkinda' },
  { label: 'İletişim', href: '/iletisim' },
];

const isActive = (href: string) =>
  href === '/sablonlar' ? pathname.startsWith('/sablon') : pathname === href;

const mobileBrandMark = "/images/brand/excelarsiv-header-logo.png";
---

<header class="site-header" data-mobile-premium-header>
  <div class="site-container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Excel Arşiv ana sayfa">
      <picture class="site-header__logo-wrap">
        <source media="(min-width: 761px)" srcset="/images/brand/excelarsiv-header-logo.png" />
        <img
          src="/images/brand/excelarsiv-header-logo.png"
          alt="Excel Arşiv"
          width="40"
          height="40"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="site-header__logo"
        />
      </picture>
      <span class="site-header__brand-text">
        <span class="site-header__wordmark">Excel Arşiv</span>
        <span class="site-header__tagline">Hazır Excel işletme sistemleri</span>
      </span>
      <span class="site-header__mobile-pill" aria-hidden="true">51+ Çözüm</span>
    </a>

    <nav class="site-header__nav" aria-label="Ana menü">
      {
        menu.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`site-header__link${active ? ' is-active' : ''}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="site-header__actions">
      <!-- Mobil Hızlı Arama Butonu -->
      <a class="site-header__mobile-search-btn" href="/sablonlar" aria-label="Excel sistemlerinde ara" data-cta="mobile_header_search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <a class="site-header__cta" href="/sablonlar" data-cta="header_systems" data-location="header">
        <span class="site-header__cta-desktop">Sistemleri İncele</span>
        <span class="site-header__cta-mobile">Sistem Bul</span>
      </a>

      <details class="site-header__menu" id="site-header-menu">
        <summary aria-label="Menüyü aç/kapat">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </summary>
        <div class="site-header__backdrop" id="site-header-backdrop" aria-hidden="true"></div>
        <div class="site-header__mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobil gezinme menüsü">
          <div class="site-header__drawer-top">
            <a href="/" class="site-header__drawer-brand" aria-label="Excel Arşiv ana sayfa">
              <picture class="site-header__logo-wrap">
                <img
                  src={mobileBrandMark}
                  alt="Excel Arşiv"
                  width="36"
                  height="36"
                  class="site-header__logo"
                />
              </picture>
              <div class="site-header__drawer-brand-text">
                <strong>Excel Arşiv</strong>
                <span>İşletme Karar Sistemleri</span>
              </div>
            </a>
            <button type="button" class="site-header__drawer-close" id="site-header-close-btn" aria-label="Menüyü kapat">
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div class="site-header__drawer-body">
            <!-- Hızlı Arama Input Formu -->
            <form action="/sablonlar" method="get" class="site-header__drawer-search-form" role="search">
              <svg viewBox="0 0 24 24" width="17" height="17" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="search" name="q" placeholder="51+ Excel şablonunda ara..." autocomplete="off" aria-label="Şablon ara" />
              <button type="submit">Ara</button>
            </form>

            <!-- 2 Büyük Aksiyon Kartı -->
            <div class="site-header__drawer-primary">
              <a href="/sablonlar" class="site-header__card-ready" data-cta="mobile_menu_ready" data-location="mobile_menu">
                <div class="site-header__card-head">
                  <span class="site-header__card-badge">51+ Çözüm</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </div>
                <strong>Hazır Excel Sistemleri</strong>
                <span>İncele · Gerçek Ekran Gör · Anında İndir</span>
              </a>
              <a href="/ozel-excel-sistemleri" class="site-header__card-custom" data-cta="mobile_menu_custom" data-location="mobile_menu">
                <div class="site-header__card-head">
                  <span class="site-header__card-badge site-header__card-badge--blue">15 Dk Ön Teşhis</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </div>
                <strong>Size Özel Excel Çözümü</strong>
                <span>İşletmenizin Akışına Birebir Kurulum</span>
              </a>
            </div>

            <!-- Yatay Kategori Rayı (Horizontal Touch Scroll Rail) -->
            <div class="site-header__drawer-section">
              <div class="site-header__drawer-subtitle-row">
                <span class="site-header__drawer-subtitle">UZMANLIK ALANLARI</span>
                <a href="/sablonlar" class="site-header__drawer-all-link">Tümü →</a>
              </div>
              <div class="site-header__drawer-chips" role="navigation" aria-label="Kategori kısayolları">
                <a href="/sablonlar/finansal-analiz" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#0b7440"></span>
                  <span>Finansal Analiz</span>
                </a>
                <a href="/sablonlar/nakit-akisi" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#0f6cbd"></span>
                  <span>Nakit Akışı & Kasa</span>
                </a>
                <a href="/sablonlar/muhasebe-ve-vergi" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#854d0e"></span>
                  <span>Muhasebe & Vergi</span>
                </a>
                <a href="/sablonlar/butce-ve-planlama" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#4f46e5"></span>
                  <span>Bütçe & Planlama</span>
                </a>
                <a href="/sablonlar/stok-ve-uretim" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#0d9488"></span>
                  <span>Stok & Üretim</span>
                </a>
                <a href="/sablonlar/satis-ve-fiyatlama" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#d97706"></span>
                  <span>Satış & Prim</span>
                </a>
                <a href="/sablonlar/personel-ve-bordro" class="site-header__cat-chip">
                  <span class="site-header__cat-dot" style="background:#e11d48"></span>
                  <span>Personel & Maaş</span>
                </a>
              </div>
            </div>

            <!-- Karar Rehberleri Kısayol Kartı -->
            <a href="/karar" class="site-header__drawer-decision-bridge">
              <div class="site-header__decision-badge">KARAR REHBERİ</div>
              <strong>Ne Aradığınızı Bilmiyor musunuz?</strong>
              <p>18 işletme probleminden size uygun sistemi belirleyin →</p>
            </a>

            <!-- Kurumsal Navigasyon (2 Sütunlu Temiz Grid) -->
            <div class="site-header__drawer-section">
              <span class="site-header__drawer-subtitle">KURUMSAL & REHBER</span>
              <nav class="site-header__drawer-grid-nav" aria-label="Mobil kurumsal gezinme">
                <a href="/demo">Ücretsiz Demo</a>
                <a href="/nasil-calisir">Nasıl Çalışır?</a>
                <a href="/rehber">Finans Rehberi</a>
                <a href="/hakkinda">Uzman Profili</a>
                <a href="/iletisim">İletişim & Destek</a>
                <a href="/neden-excel-arsiv">Neden Excel Arşiv?</a>
              </nav>
            </div>

            <!-- Danışma Hattı Footer -->
            <div class="site-header__drawer-footer">
              <a href="/ozel-excel-sistemleri" class="site-header__drawer-wa">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <div>
                  <strong>İşletme Finans Hattı</strong>
                  <span>15 Dk Ön Teşhis &amp; Çözüm Mimarisi</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function initMobileNav() {
      const menu = document.getElementById('site-header-menu');
      const backdrop = document.getElementById('site-header-backdrop');
      const closeBtn = document.getElementById('site-header-close-btn');
      if (!menu) return;

      function closeMenu() {
        menu.removeAttribute('open');
        document.body.classList.remove('ea-menu-active');
      }

      function openMenu() {
        document.body.classList.add('ea-menu-active');
      }

      menu.addEventListener('toggle', function() {
        if (menu.open) {
          openMenu();
        } else {
          closeMenu();
        }
      });

      if (backdrop) {
        backdrop.addEventListener('click', function(e) {
          e.preventDefault();
          closeMenu();
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          closeMenu();
        });
      }

      // Menü içindeki linklere tıklanınca menüyü kapat
      const links = menu.querySelectorAll('.site-header__mobile-drawer a');
      links.forEach(function(link) {
        link.addEventListener('click', function() {
          closeMenu();
        });
      });

      // Escape tuşu ile kapat
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && menu.hasAttribute('open')) {
          closeMenu();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileNav);
    } else {
      initMobileNav();
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--xl-grid);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-header__logo-wrap { display:block;width:40px;height:40px;flex:none; }
  .site-header__logo { width:40px;height:40px;object-fit:contain;display:block;flex:none; }
  .site-header__brand-text { display:flex;flex-direction:column;line-height:1.15; }
  .site-header__wordmark { font-family:var(--font-display);font-size:18px;font-weight:800;letter-spacing:-.01em;color:var(--xl-ink-900);white-space:nowrap; }
  .site-header__tagline { font-size:9px;letter-spacing:.02em;color:var(--xl-ink-3); }
  .site-header__nav { display:flex;align-items:center;gap:4px;margin-inline:auto; }
  .site-header__link { padding:9px;border-radius:9px;font-size:13px;font-weight:550;color:var(--xl-ink-3);text-decoration:none;transition:color 150ms ease-out,background 150ms ease-out; }
  .site-header__link:hover,.site-header__link.is-active { color:var(--xl-green-dark);background:var(--xl-accent-soft); }
  .site-header__actions { display:flex;align-items:center;gap:8px;flex-shrink:0; }
  .site-header__cta { display:inline-flex;align-items:center;justify-content:center;height:42px;padding-inline:16px;border-radius:11px;background:var(--xl-green);color:#fff;font-family:var(--font-mono);font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 8px 20px rgba(11,116,64,.14); }
  .site-header__cta:hover { background:var(--xl-accent-dark); }
  .site-header__cta-mobile,.site-header__menu { display:none; }

  @media (max-width: 1020px) {
    .site-header__nav { display:none; }
    .site-header__menu { display:block;position:static; }
    .site-header__menu summary {
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:4.5px;
      width:42px;
      height:42px;
      border:1px solid #dce5df;
      border-radius:12px;
      background:#fff;
      cursor:pointer;
      list-style:none;
      box-shadow:0 4px 14px rgba(15,23,42,.05);
      transition:background .15s ease,border-color .15s ease;
      -webkit-tap-highlight-color:transparent;
    }
    .site-header__menu summary::-webkit-details-marker { display:none; }
    .site-header__menu summary .bar {
      display:block;
      width:18px;
      height:2px;
      background:var(--xl-ink-900);
      border-radius:2px;
      transition:transform .2s ease,opacity .2s ease;
    }

    /* Menü açıkken hamburger -> X animasyonu */
    .site-header__menu[open] summary .bar-1 {
      transform:translateY(6.5px) rotate(45deg);
    }
    .site-header__menu[open] summary .bar-2 {
      opacity:0;
      transform:scaleX(0);
    }
    .site-header__menu[open] summary .bar-3 {
      transform:translateY(-6.5px) rotate(-45deg);
    }

    /* Koyu Backdrop Perde (Overlay) */
    .site-header__backdrop {
      display:none;
      position:fixed;
      inset:0;
      top:0;
      left:0;
      right:0;
      bottom:0;
      width:100vw;
      height:100vh;
      height:100dvh;
      background:rgba(15,23,42,.62);
      backdrop-filter:blur(6px);
      -webkit-backdrop-filter:blur(6px);
      z-index:9998;
    }
    .site-header__menu[open] .site-header__backdrop {
      display:block;
    }

    /* Mobil Drawer — Katı Opak #ffffff Arka Plan */
    .site-header__mobile-drawer {
      display:none;
      position:fixed;
      top:0;
      right:0;
      bottom:0;
      width:min(420px,100vw);
      height:100vh;
      height:100dvh;
      background:#ffffff !important;
      z-index:9999;
      box-shadow:-10px 0 45px rgba(15,23,42,.22);
      display:flex;
      flex-direction:column;
      overflow:hidden;
      border-left:1px solid #e2e8e4;
      opacity:0;
      pointer-events:none;
      transform:translateX(100%);
      transition:transform .25s cubic-bezier(.16,1,.3,1),opacity .2s ease;
    }

    .site-header__menu[open] .site-header__mobile-drawer {
      opacity:1;
      pointer-events:auto;
      transform:translateX(0);
    }

    .site-header__drawer-top {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:16px 20px;
      border-bottom:1px solid #edf2ef;
      background:#ffffff;
      flex-shrink:0;
    }

    .site-header__drawer-brand {
      display:flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
    }
    .site-header__drawer-brand-text strong {
      display:block;
      font-size:16px;
      font-weight:800;
      color:var(--xl-ink-900);
      line-height:1.2;
    }
    .site-header__drawer-brand-text span {
      display:block;
      font-size:11px;
      color:#64748b;
      line-height:1.2;
    }

    .site-header__drawer-close {
      display:flex;
      align-items:center;
      justify-content:center;
      width:38px;
      height:38px;
      border-radius:11px;
      border:1px solid #e2e8e4;
      background:#f8faf9;
      color:#0f172a;
      cursor:pointer;
      transition:background .15s ease;
      -webkit-tap-highlight-color:transparent;
    }
    .site-header__drawer-close:active {
      background:#eef4f0;
    }

    .site-header__drawer-body {
      flex:1 1 auto;
      overflow-y:auto;
      -webkit-overflow-scrolling:touch;
      padding:16px 18px 36px;
      display:flex;
      flex-direction:column;
      gap:18px;
      background:#ffffff;
    }

    /* Canlı Arama Input Formu */
    .site-header__drawer-search-form {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 6px 6px 14px;
      border-radius: 14px;
      background: #f4f7f5;
      border: 1px solid #dfe7e2;
      color: #0f172a;
      transition: border-color .15s ease, background .15s ease;
    }
    .site-header__drawer-search-form:focus-within {
      background: #ffffff;
      border-color: var(--xl-green);
      box-shadow: 0 0 0 3px rgba(16,124,65,.12);
    }
    .site-header__drawer-search-form svg {
      flex-shrink: 0;
      color: #64748b;
    }
    .site-header__drawer-search-form input {
      flex: 1;
      min-width: 0;
      border: none;
      background: transparent;
      font-size: 16px;
      color: #0f172a;
      outline: none;
      font-family: inherit;
    }
    .site-header__drawer-search-form input::placeholder {
      color: #94a3b8;
      font-size: 14px;
    }
    .site-header__drawer-search-form button {
      padding: 8px 14px;
      border: none;
      border-radius: 10px;
      background: var(--xl-green);
      color: #fff;
      font-size: 12.5px;
      font-weight: 750;
      cursor: pointer;
      flex-shrink: 0;
      transition: background .15s ease;
    }
    .site-header__drawer-search-form button:active {
      background: var(--xl-accent-dark);
    }

    /* 2 Büyük Kart */
    .site-header__drawer-primary {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .site-header__card-ready,
    .site-header__card-custom {
      display: flex;
      flex-direction: column;
      padding: 14px 16px;
      border-radius: 16px;
      text-decoration: none;
      transition: transform .12s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .site-header__card-ready:active,
    .site-header__card-custom:active {
      transform: scale(0.985);
    }
    .site-header__card-ready {
      background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
      border: 1px solid #bbf7d0;
      color: #166534;
    }
    .site-header__card-custom {
      background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
      border: 1px solid #bae6fd;
      color: #0369a1;
    }
    .site-header__card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    .site-header__card-badge {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 6px;
      background: #ffffff;
      color: #15803d;
      box-shadow: 0 2px 6px rgba(22,101,52,.08);
    }
    .site-header__card-badge--blue {
      color: #0284c7;
      box-shadow: 0 2px 6px rgba(2,132,199,.08);
    }
    .site-header__card-ready strong,
    .site-header__card-custom strong {
      font-size: 15px;
      font-weight: 800;
      line-height: 1.25;
      color: #0f172a;
    }
    .site-header__card-ready span,
    .site-header__card-custom span {
      margin-top: 4px;
      font-size: 12px;
      opacity: .85;
      line-height: 1.3;
    }

    /* Başlıklar & Bölümler */
    .site-header__drawer-section {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .site-header__drawer-subtitle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-inline: 4px;
    }
    .site-header__drawer-subtitle {
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .08em;
      color: #94a3b8;
      text-transform: uppercase;
    }
    .site-header__drawer-all-link {
      font-size: 11.5px;
      font-weight: 750;
      color: var(--xl-green);
      text-decoration: none;
    }

    /* Yatay Kaydırılabilir Kategori Rayı */
    .site-header__drawer-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 3px;
      margin: 0 -18px;
      padding-inline: 18px;
    }
    .site-header__drawer-chips::-webkit-scrollbar {
      display: none;
