<script is:inline>
  (function() {
    // 1. Mobil Menü Yönetimi
    function initMobileNav() {
      const menu = document.getElementById('site-header-menu');
      const backdrop = document.getElementById('site-header-backdrop');
      const closeBtn = document.getElementById('site-header-close-btn');
      if (!menu) return;

      function closeMenu() {
        menu.removeAttribute('open');
        document.body.classList.remove('ea-menu-active');
      }

      function openMenu() {
        document.body.classList.add('ea-menu-active');
      }

      menu.addEventListener('toggle', function() {
        if (menu.open) {
          openMenu();
        } else {
          closeMenu();
        }
      });

      if (backdrop) {
        backdrop.addEventListener('click', function(e) {
          e.preventDefault();
          closeMenu();
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          closeMenu();
        });
      }

      // Menü içindeki linklere tıklanınca menüyü kapat
      const links = menu.querySelectorAll('.site-header__mobile-drawer a');
      links.forEach(function(link) {
        link.addEventListener('click', function() {
          closeMenu();
        });
      });

      // Escape tuşu ile kapat
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && menu.hasAttribute('open')) {
          closeMenu();
        }
      });
    }

    // 2. Sticky Header & Glassmorphism Cam Efekti
    function initStickyHeader() {
      const header = document.querySelector('.site-header');
      if (!header) return;

      function handleScroll() {
        if (window.scrollY > 15) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // 3. Desktop Mega Menu (Fade & Slide-down Dropdown) Etkileşimi
    function initMegaMenu() {
      const megaWrapper = document.querySelector('[data-megamenu-item]');
      const trigger = document.querySelector('[data-megamenu-trigger]');
      if (!megaWrapper || !trigger) return;

      function closeMega() {
        megaWrapper.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }

      function openMega() {
        megaWrapper.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }

      trigger.addEventListener('click', function(e) {
        // Geniş ekranda dropdown toggle
        if (window.innerWidth >= 992) {
          e.preventDefault();
          if (megaWrapper.classList.contains('is-open')) {
            closeMega();
          } else {
            openMega();
          }
        }
      });

      // Dışarı tıklandığında kapat
      document.addEventListener('click', function(e) {
        if (!megaWrapper.contains(e.target)) {
          closeMega();
        }
      });

      // Escape tuşu ile kapat
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeMega();
        }
      });
    }

    // 4. Scroll Reveal & On-Scroll Fade-In Animation (IntersectionObserver)
    function initScrollReveal() {
      const revealElements = document.querySelectorAll(
        '.scroll-reveal, .fade-in, .fade-in-left, .stagger-animation'
      );
      if (!revealElements.length) return;

      if (!('IntersectionObserver' in window)) {
        revealElements.forEach(function(el) {
          el.classList.add('visible');
        });
        return;
      }

      document.documentElement.classList.add('ea-scroll-fx');

      const revealObserver = new IntersectionObserver(
        function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        {
          rootMargin: '0px 0px -30px 0px',
          threshold: 0.1,
        }
      );

      revealElements.forEach(function(el) {
        revealObserver.observe(el);
      });
    }

    function initAll() {
      initMobileNav();
      initStickyHeader();
      initMegaMenu();
      initScrollReveal();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
</script>

<script type="application/json" id="header-search-data" set:html={JSON.stringify(searchData)}></script>

<script>
  function initHeaderSearch() {
    const raw = document.getElementById('header-search-data');
    if (!raw) return;
    let items: Array<{ name: string; summary: string; category: string; url: string; slug: string }> = [];
    try {
      items = JSON.parse(raw.textContent || '[]');
    } catch {
      items = [];
    }

    function normalize(text: string): string {
      return (text || '')
        .trim()
        .toLocaleLowerCase('tr-TR')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/ı/g, 'i')
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c');
    }

    const searchBoxes = document.querySelectorAll<HTMLElement>('[data-header-search-box]');
    searchBoxes.forEach((box) => {
      const form = box.querySelector<HTMLFormElement>('[data-header-search-form]');
      const input = box.querySelector<HTMLInputElement>('[data-header-search-input]');
      const dropdown = box.querySelector<HTMLElement>('[data-header-search-dropdown]');
      const resultsList = box.querySelector<HTMLElement>('[data-header-search-results]');
      const countEl = box.querySelector<HTMLElement>('[data-header-search-count]');
      const viewAll = box.querySelector<HTMLAnchorElement>('[data-header-search-view-all]');

      if (!form || !input || !dropdown || !resultsList) return;

      function render(q: string) {
        const normQ = normalize(q);
        if (!normQ) {
          dropdown!.setAttribute('hidden', 'true');
          return;
        }

        const matches = items.filter((item) => {
          return (
            normalize(item.name).includes(normQ) ||
            normalize(item.summary).includes(normQ) ||
            normalize(item.category).includes(normQ)
          );
        }).slice(0, 6);

        if (countEl) countEl.textContent = `${matches.length} Sistem`;
        if (viewAll) viewAll.href = `/sablonlar?q=${encodeURIComponent(q.trim())}`;

        if (matches.length === 0) {
          resultsList!.innerHTML = '<li class="site-header__search-empty">Eşleşen hazır şablon bulunamadı.</li>';
        } else {
          resultsList!.innerHTML = matches
            .map(
              (m) => `
            <li class="site-header__search-item">
              <a href="${m.url}">
                <span class="site-header__search-title">${m.name}</span>
                <span class="site-header__search-meta">${m.category}</span>
              </a>
            </li>
          `
            )
            .join('');
        }
        dropdown!.removeAttribute('hidden');
      }

      input.addEventListener('input', () => render(input.value));
      input.addEventListener('focus', () => {
        if (input.value.trim().length > 0) render(input.value);
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = input.value.trim();
        window.location.href = q ? `/sablonlar?q=${encodeURIComponent(q)}` : '/sablonlar';
      });
      document.addEventListener('click', (e) => {
        if (!box.contains(e.target as Node)) dropdown!.setAttribute('hidden', 'true');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderSearch);
  } else {
    initHeaderSearch();
  }
</script>

