---
import { getAllTemplates } from '../lib/templates';

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
const pathname = Astro.url.pathname;

const menu = [
  { label: 'Şablonlar', href: '/sablonlar' },
  { label: 'Size Özel', href: '/ozel-excel-sistemleri' },
  { label: 'Demo Kataloğu', href: '/demo' },
  { label: 'Nasıl Çalışır', href: '/nasil-calisir' },
  { label: 'Rehber', href: '/rehber' },
  { label: 'Hakkımızda', href: '/hakkinda' },
  { label: 'İletişim', href: '/iletisim' },
];

const isActive = (href: string) =>
  href === '/sablonlar' ? pathname.startsWith('/sablon') : pathname === href;

const mobileBrandMark = "/images/brand/excelarsiv-header-logo.png";

const allTemplates = await getAllTemplates();
const searchData = allTemplates.map((t) => ({
  name: t.name,
  summary: t.summary,
  category: t.categoryName,
  url: t.url,
  slug: t.slug,
}));
---

<header class="site-header" data-mobile-premium-header>
  <div class="site-container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Excel Arşiv ana sayfa">
      <picture class="site-header__logo-wrap">
        <source media="(min-width: 761px)" srcset="/images/brand/excelarsiv-header-logo.png" />
        <img
          src="/images/brand/excelarsiv-header-logo.png"
          alt="Excel Arşiv"
          width="40"
          height="40"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="site-header__logo"
        />
      </picture>
      <span class="site-header__brand-text">
        <span class="site-header__wordmark">Excel Arşiv</span>
        <span class="site-header__tagline">Hazır Excel işletme sistemleri</span>
      </span>
      <span class="site-header__mobile-pill" aria-hidden="true">51+ Çözüm</span>
    </a>

    <nav class="site-header__nav" aria-label="Ana menü">
      {
        menu.map((item) => {
          const active = isActive(item.href);
          const isTemplates = item.href === '/sablonlar';

          if (isTemplates) {
            return (
              <div class="site-header__nav-item site-header__nav-item--has-megamenu" data-megamenu-item>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  aria-haspopup="true"
                  aria-expanded="false"
                  class={`site-header__link site-header__link--megamenu-trigger${active ? ' is-active' : ''}`}
                  data-megamenu-trigger
                >
                  <span>{item.label}</span>
                  <svg class="site-header__chevron-svg" viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 8 10 12 14 8"></polyline>
                  </svg>
                </a>

                {/* Fade & Slide-down Mega Menu Dropdown */}
                <div class="site-header__megamenu" data-megamenu-dropdown role="region" aria-label="Kategoriler ve Karar Sistemleri">
                  <div class="site-header__megamenu-inner">
                    <!-- 1. Sütun: Uzmanlık Alanları & Kategori Açılışları (7 Temel Kategori) -->
                    <div class="site-header__megamenu-col site-header__megamenu-col--cats">
                      <div class="site-header__megamenu-col-head">
                        <span class="site-header__megamenu-eyebrow">UZMANLIK ALANLARI</span>
                        <a href="/sablonlar" class="site-header__megamenu-head-link">Tüm 12 Alan →</a>
                      </div>
                      <div class="site-header__mega-cat-grid">
                        <a href="/sablonlar/finansal-analiz" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#e6f4ea;color:#0b7440;">📊</span>
                          <div>
                            <strong>Finansal Analiz</strong>
                            <span>Kârlılık, bilanço, rasyo & oran analizleri</span>
                          </div>
                        </a>
                        <a href="/sablonlar/nakit-akisi" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#e1f0fe;color:#0f6cbd;">💧</span>
                          <div>
                            <strong>Nakit Akışı & Kasa</strong>
                            <span>13 haftalık nakit açığı & likidite tahmini</span>
                          </div>
                        </a>
                        <a href="/sablonlar/muhasebe-ve-vergi" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#fef3c7;color:#854d0e;">📑</span>
                          <div>
                            <strong>Muhasebe & Vergi</strong>
                            <span>Mizan, KDV, stopaj & vergi hesaplayıcılar</span>
                          </div>
                        </a>
                        <a href="/sablonlar/butce-ve-planlama" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#ede9fe;color:#4f46e5;">🎯</span>
                          <div>
                            <strong>Bütçe & Planlama</strong>
                            <span>Dinamik şirket bütçesi & sapma kontrolü</span>
                          </div>
                        </a>
                        <a href="/sablonlar/stok-ve-uretim" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#ccfbf1;color:#0d9488;">📦</span>
                          <div>
                            <strong>Stok & Üretim</strong>
                            <span>Kapasite, stok devri & bağlanan nakit</span>
                          </div>
                        </a>
                        <a href="/sablonlar/satis-ve-fiyatlama" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#ffedd5;color:#d97706;">🏷️</span>
                          <div>
                            <strong>Satış & Prim</strong>
                            <span>Fiyatlandırma, prim matrisi & net tahsilat</span>
                          </div>
                        </a>
                        <a href="/sablonlar/personel-ve-bordro" class="site-header__mega-cat-card">
                          <span class="site-header__mega-cat-badge" style="background:#ffe4e6;color:#e11d48;">👥</span>
