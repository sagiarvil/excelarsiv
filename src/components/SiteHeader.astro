                          <span class="site-header__pop-dot" style="background:#7c3aed;"></span>
                          <div class="site-header__pop-text">
                            <strong>Aylık Patron Finans Paneli</strong>
                            <span>CFO düzeyinde şirket özet karar kokpiti</span>
                          </div>
