---
interface Props {
  activeTab?: 'today' | 'templates' | 'custom' | 'demo' | 'guide' | 'contact';
}

const { activeTab = 'today' } = Astro.props;

const navItems = [
  { id: 'today', name: 'Bugün', href: '/', icon: 'today' },
  { id: 'templates', name: 'Şablonlar', href: '/sablonlar', icon: 'templates' },
  { id: 'custom', name: 'Size Özel', href: '/ozel-excel-sistemleri', icon: 'custom' },
  { id: 'demo', name: 'Ürün Bulucu', href: '/urun-bulucu', icon: 'demo' },
  { id: 'guide', name: 'Rehber', href: '/rehber', icon: 'guide' },
  { id: 'contact', name: 'İletişim', href: '/iletisim', icon: 'contact' },
];

const categories = [
  { name: 'Finansal Analiz', href: '/sablonlar/finansal-analiz', icon: 'chart' },
  { name: 'Nakit Akışı', href: '/sablonlar/nakit-akisi', icon: 'cash' },
  { name: 'Muhasebe ve Vergi', href: '/sablonlar/muhasebe-ve-vergi', icon: 'calc' },
  { name: 'Stok ve Üretim', href: '/sablonlar/stok-ve-uretim', icon: 'box' },
  { name: 'Bütçe ve Planlama', href: '/sablonlar/butce-ve-planlama', icon: 'trend' },
  { name: 'Satış ve Fiyatlama', href: '/sablonlar/satis-ve-fiyatlama', icon: 'tag' },
  { name: 'Personel ve Bordro', href: '/sablonlar/personel-ve-bordro', icon: 'users' },
];
---

<aside class="appstore-sidebar" aria-label="App Store Gezintisi">
  <!-- macOS Pencere Düğmeleri ● ● ● -->
  <div class="appstore-window-controls" aria-hidden="true">
    <span class="win-btn win-close"></span>
    <span class="win-btn win-minimize"></span>
    <span class="win-btn win-zoom"></span>
  </div>

  <!-- Logo & Marka -->
  <a href="/" class="appstore-brand" aria-label="Excel Arşiv Ana Sayfa">
    <div class="appstore-logo-box">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="9" y1="13" x2="15" y2="19"></line>
        <line x1="15" y1="13" x2="9" y2="19"></line>
      </svg>
    </div>
    <span class="appstore-brand-text">Excel Arşiv</span>
  </a>

  <!-- Arama Çubuğu (Someka Stil: Beyaz Kutu + Okyanus Mavisi Arama Butonu) -->
  <div class="appstore-search-box">
    <form action="/sablonlar" method="get" class="appstore-search-form" role="search">
      <input type="search" name="q" placeholder="Excel sistemlerinde ara..." aria-label="Excel sistemleri içinde ara" autocomplete="off" />
      <button type="submit" class="appstore-search-btn" aria-label="Ara" title="Ara">
        <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="9" r="6"></circle>
          <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
        </svg>
      </button>
    </form>
  </div>

  <!-- Ana Menü -->
  <nav class="appstore-nav-menu" aria-label="Birincil Menü">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`appstore-nav-item ${activeTab === item.id ? 'is-active' : ''}`}
        aria-current={activeTab === item.id ? 'page' : undefined}
      >
        <span class="nav-item-icon" aria-hidden="true">
          {item.icon === 'today' && (
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          )}
          {item.icon === 'templates' && (
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
          )}
          {item.icon === 'custom' && (
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          )}
          {item.icon === 'demo' && (
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
              <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
          )}
          {item.icon === 'guide' && (
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          )}
          {item.icon === 'contact' && (
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          )}
        </span>
        <span class="nav-item-title">{item.name}</span>
      </a>
    ))}
  </nav>
</aside>

<!-- iOS Mobil Üst Başlık (Apple App Store Large Title Header) -->
<header class="as-ios-topbar" aria-label="Mobil App Store Başlığı">
  <div class="as-ios-topbar-header">
    <div class="as-ios-topbar-left">
      <span class="as-ios-date">
        {activeTab === 'today' ? 'GÜNÜN ÖNE ÇIKANLARI' : activeTab === 'templates' ? 'HAZIR SİSTEMLER' : activeTab === 'custom' ? 'TERZİ USULÜ' : activeTab === 'guide' ? 'DOKÜMANTASYON' : activeTab === 'demo' ? 'KEŞİF & ARAMA' : 'EXCEL ARŞİV'}
      </span>
      <h1 class="as-ios-large-title">
        {activeTab === 'today' ? 'Bugün' : activeTab === 'templates' ? 'Şablonlar' : activeTab === 'custom' ? 'Size Özel' : activeTab === 'demo' ? 'Arayın' : activeTab === 'guide' ? 'Rehber' : 'İletişim'}
      </h1>
    </div>
    <a href="/hakkinda" class="as-ios-profile-btn" aria-label="Profil ve Hakkımızda">
      <div class="as-ios-avatar" title="Excel Arşiv">EA</div>
    </a>
  </div>

  <!-- iOS App Store Arama Çubuğu (Görsellerdeki Arayın & Arama Alanı) -->
  <div class="as-ios-search-wrap">
    <form action="/sablonlar" method="get" class="as-ios-search-form" role="search">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="as-ios-search-svg" aria-hidden="true">
        <circle cx="9" cy="9" r="6"></circle>
        <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
      </svg>
      <input type="search" name="q" placeholder="Excel sistemleri, modeller ve fazlası..." aria-label="Excel sistemleri içinde ara" autocomplete="off" />
    </form>
  </div>
</header>

<!-- iOS Mobil Alt Sekme Çubuğu (Apple iOS Bottom Tab Bar — 5 Sekme Birebir Model) -->
<nav class="as-ios-tabbar" aria-label="App Store Mobil Alt Gezinme">
  <!-- 1. Bugün -->
  <a href="/" class={`as-tab-link ${activeTab === 'today' ? 'is-active' : ''}`} aria-label="Bugün sekmesi">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>Bugün</span>
  </a>

  <!-- 2. Şablonlar -->
  <a href="/sablonlar" class={`as-tab-link ${activeTab === 'templates' ? 'is-active' : ''}`} aria-label="Şablonlar sekmesi">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
      <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
      <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
      <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
    </svg>
    <span>Şablonlar</span>
  </a>

  <!-- 3. Size Özel -->
  <a href="/ozel-excel-sistemleri" class={`as-tab-link ${activeTab === 'custom' ? 'is-active' : ''}`} aria-label="Size Özel sistemler">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    <span>Size Özel</span>
  </a>

  <!-- 4. Rehber -->
  <a href="/rehber" class={`as-tab-link ${activeTab === 'guide' ? 'is-active' : ''}`} aria-label="Rehber ve Dokümanlar">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
    </svg>
    <span>Rehber</span>
  </a>

  <!-- 5. Arayın -->
  <a href="/urun-bulucu" class={`as-tab-link ${activeTab === 'demo' ? 'is-active' : ''}`} aria-label="Arayın ve Sistem Bulucu">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>Arayın</span>
  </a>
</nav>

<style>
  .appstore-sidebar {
    width: 240px;
    flex-shrink: 0;
    background: #f8fafc;
    border-right: 1.5px solid #cbd5e1;
    padding: 16px 14px 28px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 16px;
    height: calc(100vh - 32px);
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    border-top-left-radius: var(--as-radius-window, 18px);
    border-bottom-left-radius: var(--as-radius-window, 18px);
  }

  /* macOS Pencere Düğmeleri */
  .appstore-window-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    padding-left: 4px;
  }
  .win-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .win-close { background: #ff5f56; border: 1px solid #e0443e; }
  .win-minimize { background: #ffbd2e; border: 1px solid #dea123; }
  .win-zoom { background: #27c93f; border: 1px solid #1aab29; }

  /* Marka & Logo */
  .appstore-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 14px;
    text-decoration: none;
    color: #0f172a;
  }
  .appstore-logo-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: linear-gradient(135deg, #107c41 0%, #0a5a2f 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(16, 124, 65, 0.32);
  }
  .appstore-brand-text {
    font-size: 17.5px;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #0f172a;
  }

  /* Arama (Someka Paleti: Beyaz Input + Okyanus Mavisi #4b97c3 Buton) */
  .appstore-search-box {
    margin-bottom: 18px;
  }
  .appstore-search-form {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .appstore-search-form:focus-within {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
  }
  .appstore-search-form input {
    flex: 1;
    height: 34px;
    padding: 0 10px 0 12px;
    border: none;
    background: transparent;
    font-size: 13.5px;
    color: #0f172a;
    outline: none;
  }
  .appstore-search-form input::placeholder {
    color: #64748b;
  }
  .appstore-search-btn {
    width: 36px;
    height: 34px;
    background: #0284c7;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease;
    flex-shrink: 0;
  }
  .appstore-search-btn:hover {
    background: #0369a1;
  }

  /* Ana Menü */
  .appstore-nav-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .appstore-nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 14.5px;
    font-weight: 650;
    color: #1e293b;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .appstore-nav-item:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .appstore-nav-item.is-active {
    background: #e0f2fe;
    color: #0369a1;
    font-weight: 800;
    border-left: 3.5px solid #0284c7;
  }
  .nav-item-icon {
    width: 21px;
    height: 21px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
  }
  .appstore-nav-item.is-active .nav-item-icon {
    color: #0284c7;
  }
  .appstore-nav-item:hover .nav-item-icon {
    color: #0f172a;
  }

  /* Ayırıcı */
  .appstore-nav-divider {
    height: 1px;
    background: #cbd5e1;
    margin: 12px 6px;
  }

  /* Masaüstünde mobil öğeleri gizle */
  .as-ios-topbar,
  .as-ios-tabbar {
    display: none;
  }

  @media (max-width: 900px) {
    .appstore-sidebar {
      display: none !important;
    }

    /* iOS Mobil Üst Başlık (Large Title Navigation & Search Bar) */
    .as-ios-topbar {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 14px 16px 12px;
      background: #ffffff;
      border-bottom: 1.5px solid #e2e8f0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .as-ios-topbar-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      width: 100%;
    }

    .as-ios-topbar-left {
      display: flex;
      flex-direction: column;
    }

    .as-ios-date {
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: #64748b;
      margin-bottom: 2px;
    }

    .as-ios-large-title {
      font-size: 30px;
      font-weight: 850;
      letter-spacing: -0.03em;
      color: #0f172a;
      margin: 0;
      line-height: 1.1;
    }

    .as-ios-profile-btn {
      text-decoration: none;
      margin-bottom: 2px;
    }

    .as-ios-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      color: #ffffff;
      font-size: 13px;
      font-weight: 800;
      display: grid;
      place-items: center;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.25);
    }

    /* iOS Arama Girişi */
    .as-ios-search-wrap {
      width: 100%;
    }

    .as-ios-search-form {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 8px 12px;
      transition: all 0.15s ease;
    }

    .as-ios-search-form:focus-within {
      background: #ffffff;
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
    }

    .as-ios-search-svg {
      color: #64748b;
      flex-shrink: 0;
    }

    .as-ios-search-form input {
      border: none;
      background: transparent;
      outline: none;
      font-size: 14.5px;
      color: #0f172a;
      width: 100%;
      font-family: inherit;
      -webkit-appearance: none;
    }

    .as-ios-search-form input::placeholder {
      color: #64748b;
    }

    /* iOS Mobil Alt Sekme Çubuğu (Yüksek Kontrast & Belirgin Tab Bar) */
    .as-ios-tabbar {
      display: flex;
      align-items: center;
      justify-content: space-around;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 64px;
      background: #ffffff;
      border-top: 1.5px solid #cbd5e1;
      z-index: 9999;
      padding-bottom: max(6px, env(safe-area-inset-bottom, 8px));
      box-shadow: 0 -6px 20px rgba(15, 23, 42, 0.12), 0 -1px 3px rgba(15, 23, 42, 0.08);
    }

    .as-tab-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      text-decoration: none;
      color: #334155;
      font-size: 11.5px;
      font-weight: 700;
      padding: 6px 4px;
      transition: all 0.15s ease;
      flex: 1;
      max-width: 76px;
      min-height: 50px;
      border-radius: 9px;
    }

    .as-tab-link svg {
      width: 23px;
      height: 23px;
      color: #475569;
      transition: transform 0.15s ease, stroke 0.15s ease;
    }

    .as-tab-link.is-active {
      color: #0284c7;
      font-weight: 850;
      background: #eff6ff;
    }

    .as-tab-link.is-active svg {
      stroke: #0284c7;
      color: #0284c7;
      transform: scale(1.1);
    }
  }
  }
</style>
