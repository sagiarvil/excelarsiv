---
interface Props {
  theme?: 'emerald' | 'blue' | 'purple' | 'amber' | 'coral' | 'indigo';
  title?: string;
  subtitle?: string;
  badge?: string;
  sourceLabel?: string;
  sourceType?: string;
  step1Title?: string;
  step1Sub?: string;
  step2Title?: string;
  step2Sub?: string;
  aiTitle1?: string;
  aiRole1?: string;
  aiTitle2?: string;
  aiRole2?: string;
  aiTitle3?: string;
  aiRole3?: string;
  step3Title?: string;
  step3Sub?: string;
  output1Title?: string;
  output2Title?: string;
  compact?: boolean;
}

const {
  theme = 'emerald',
  title = "Endüstriyel Veri & Otomasyon Mimarisi",
  subtitle = "Şirket verisinden Excel karar kokpitine ve anlık uyarılara uzanan otonom hat",
  badge = "OTOMASYON & AI KARAR HATTI",
  sourceLabel = "ERP / PDF / Banka Ekstresi",
  sourceType = "Girdi Verisi",
  step1Title = "Veri Ayrıştırma & Temizleme",
  step1Sub = "PDF, Mizan & Ekstre Parsing",
  step2Title = "Normalizasyon & Yapılandırma",
  step2Sub = "Dinamik AST Veri Haritası",
  aiTitle1 = "GPT-4o",
  aiRole1 = "Finansal Muhakeme & Stres",
  aiTitle2 = "Claude 3.7",
  aiRole2 = "Mevzuat & Formül Denetimi",
  aiTitle3 = "Gemini 2.5",
  aiRole3 = "Çoklu Veri Çapraz Teyit",
  step3Title = "Sınıflandır & Doğrula",
  step3Sub = "Sıfır Hata Çapraz Kontrol",
  output1Title = "Excel Karar Kokpiti",
  output2Title = "Slack & WhatsApp Bildirimi",
  compact = false
} = Astro.props;

// Unique ID for SVG gradients to prevent multi-instance collisions
const uid = Math.random().toString(36).substring(2, 7);
---

<div class:list={["n8n-workflow-container", `theme-${theme}`, { "is-compact": compact }]} aria-label="n8n ve Çoklu LLM Otomasyon Akış Şeması">
  {badge && (
    <div class="n8n-header-meta">
      <span class="n8n-badge-kicker">
        <span class="n8n-pulse-dot" aria-hidden="true"></span>
        {badge}
      </span>
      <h3 class="n8n-workflow-title">{title}</h3>
      {subtitle && <p class="n8n-workflow-sub">{subtitle}</p>}
    </div>
  )}

  <!-- Canvas Window -->
  <div class="n8n-canvas-frame">
    <!-- Window Bar -->
    <div class="n8n-canvas-bar">
      <div class="n8n-bar-left">
        <span class="n8n-bar-dot red"></span>
        <span class="n8n-bar-dot yellow"></span>
        <span class="n8n-bar-dot green"></span>
        <span class="n8n-bar-title">excelarsiv-decision-os · n8n-pipeline.active</span>
      </div>
      <div class="n8n-bar-stats">
        <span class="n8n-stat-pill"><span class="stat-live-dot"></span> 3 AI Modeli Aktif</span>
        <span class="n8n-stat-pill">Gecikme: &lt;110ms</span>
        <span class="n8n-stat-pill is-theme-accent">Hata Oranı: %0.00</span>
      </div>
    </div>

    <!-- Graph Body -->
    <div class="n8n-graph-body">
      <!-- Animated SVG Connecting Lines Layer -->
      <svg class="n8n-wire-layer" viewBox="0 0 1000 420" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <!-- Gradient 1: n8n to Node 1 -->
          <linearGradient id={`grad-n8n-1-${uid}`} x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--theme-n8n-start, #ea4b35)" />
            <stop offset="100%" stop-color="var(--theme-n8n-end, #ef4444)" />
          </linearGradient>

          <!-- Gradient 2: Node 1 to Node 2 -->
          <linearGradient id={`grad-1-2-${uid}`} x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--theme-wire-step1, #ef4444)" />
            <stop offset="100%" stop-color="var(--theme-wire-step2, #0d9488)" />
          </linearGradient>

          <!-- Gradient 3: Branch to AI Model 1 -->
          <linearGradient id={`grad-llm-1-${uid}`} x1="0%" y1="50%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--theme-wire-step2, #0d9488)" />
            <stop offset="100%" stop-color="#8b5cf6" />
          </linearGradient>

          <!-- Gradient 4: Branch to AI Model 2 -->
          <linearGradient id={`grad-llm-2-${uid}`} x1="0%" y1="50%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--theme-wire-step2, #0d9488)" />
            <stop offset="100%" stop-color="#f59e0b" />
          </linearGradient>

          <!-- Gradient 5: Branch to AI Model 3 -->
          <linearGradient id={`grad-llm-3-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="var(--theme-wire-step2, #0d9488)" />
            <stop offset="100%" stop-color="#0284c7" />
          </linearGradient>

          <!-- Gradient 6: Converging LLMs to Classifier -->
          <linearGradient id={`grad-converge-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6366f1" />
            <stop offset="100%" stop-color="var(--theme-primary, #107c41)" />
          </linearGradient>

          <!-- Gradient 7: Classifier to Output -->
          <linearGradient id={`grad-output-${uid}`} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="var(--theme-primary, #107c41)" />
            <stop offset="100%" stop-color="var(--theme-output-end, #047857)" />
          </linearGradient>

          <!-- Arrow Markers -->
          <marker id={`arrow-1-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--theme-wire-step1, #ef4444)" />
          </marker>
          <marker id={`arrow-2-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--theme-wire-step2, #0d9488)" />
          </marker>
          <marker id={`arrow-3-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--theme-primary, #107c41)" />
          </marker>
          <marker id={`arrow-out-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--theme-output-end, #047857)" />
          </marker>
        </defs>

        <!-- PATH 1: n8n Hub -> Node 1 (ANIMATION TIP 1: Yüksek Hızlı Lazer Paketi) -->
        <path d="M 125 210 L 220 210" class="wire-track-bg" />
        <path d="M 125 210 L 220 210" class="wire-live anim-laser-packet" stroke={`url(#grad-n8n-1-${uid})`} marker-end={`url(#arrow-1-${uid})`} />

        <!-- PATH 2: Node 1 -> Node 2 (ANIMATION TIP 2: Kesintisiz Sıvı Neon Akışı) -->
        <path d="M 330 210 L 415 210" class="wire-track-bg" />
        <path d="M 330 210 L 415 210" class="wire-live anim-liquid-stream" stroke={`url(#grad-1-2-${uid})`} marker-end={`url(#arrow-2-${uid})`} />

        <!-- BRANCHING PATHS 3: Node 2 -> 3 AI Models (ANIMATION TIP 3: Üçlü Enerji Işını) -->
        <!-- Branch 1: GPT-4 -->
        <path d="M 525 210 C 585 210, 595 105, 660 90" class="wire-track-bg" />
        <path d="M 525 210 C 585 210, 595 105, 660 90" class="wire-live anim-beam-gpt" stroke={`url(#grad-llm-1-${uid})`} />

        <!-- Branch 2: Claude -->
        <path d="M 525 210 C 600 210, 680 135, 780 90" class="wire-track-bg" />
        <path d="M 525 210 C 600 210, 680 135, 780 90" class="wire-live anim-beam-claude" stroke={`url(#grad-llm-2-${uid})`} />

        <!-- Branch 3: Gemini -->
        <path d="M 525 210 C 585 210, 640 185, 695 180" class="wire-track-bg" />
        <path d="M 525 210 C 585 210, 640 185, 695 180" class="wire-live anim-beam-gemini" stroke={`url(#grad-llm-3-${uid})`} />

        <!-- CONVERGING PATHS 4: AI Models -> Node 3 Classifier (ANIMATION TIP 4: Birleşen Çok Tonlu Manyetik Dalga) -->
        <path d="M 700 115 C 710 180, 755 200, 755 240" class="wire-track-bg" />
        <path d="M 815 115 C 815 180, 755 200, 755 240" class="wire-track-bg" />
        <path d="M 755 185 C 755 210, 755 220, 755 240" class="wire-track-bg" />
        <path d="M 755 185 L 755 240" class="wire-live anim-converge-wave" stroke={`url(#grad-converge-${uid})`} marker-end={`url(#arrow-3-${uid})`} />

        <!-- PATH 5: Node 3 -> Output Hub (ANIMATION TIP 5: Çift Çıktı Karar Nabzı) -->
        <path d="M 755 330 L 755 355" class="wire-track-bg" />
        <path d="M 755 330 L 755 355" class="wire-live anim-decision-pulse" stroke={`url(#grad-output-${uid})`} marker-end={`url(#arrow-out-${uid})`} />
      </svg>

      <!-- HTML Nodes Interactive Grid Layer -->
      <div class="n8n-nodes-layer">
        <!-- NODE 0: n8n Master Trigger (Image 3 & 4 style) -->
        <div class="n8n-node n8n-hub-node" style="left: 20px; top: 165px;" tabindex="0" role="region" aria-label="n8n Açık Kaynak Otomasyon Motoru">
          <div class="n8n-hub-badge">
            <svg class="n8n-logo-svg" viewBox="0 0 80 80" width="38" height="38" fill="none">
              <circle cx="24" cy="40" r="14" fill="#ea4b35" />
              <circle cx="56" cy="24" r="11" fill="#ea4b35" />
              <circle cx="56" cy="56" r="11" fill="#ea4b35" />
              <path d="M 28 35 L 50 26" stroke="#ea4b35" stroke-width="6" stroke-linecap="round" />
              <path d="M 28 45 L 50 54" stroke="#ea4b35" stroke-width="6" stroke-linecap="round" />
            </svg>
            <div class="n8n-hub-titles-wrap">
              <span class="n8n-hub-brand">n8n</span>
              <span class="n8n-hub-subtag">Otomasyon</span>
            </div>
          </div>
          <span class="n8n-hub-trigger-pill">Webhook Trigger</span>
        </div>

        <!-- NODE 1: Veri Ayrıştırma & Temizleme (Siteye Özgü) -->
        <div class="n8n-node n8n-task-node node-step1" style="left: 215px; top: 155px;" tabindex="0" role="region" aria-label={step1Title}>
          <div class="node-icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="node-meta">
            <span class="node-step-tag">01 · {sourceType}</span>
            <strong class="node-title">{step1Title}</strong>
            <span class="node-desc">{step1Sub}</span>
          </div>
          <div class="node-status-dot is-active" title="Canlı Veri Doğrulandı"></div>
        </div>

        <!-- NODE 2: Normalizasyon & Yapılandırma -->
        <div class="n8n-node n8n-task-node node-step2" style="left: 410px; top: 155px;" tabindex="0" role="region" aria-label={step2Title}>
          <div class="node-icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
              <line x1="7" y1="8" x2="17" y2="8"></line>
              <line x1="7" y1="12" x2="13" y2="12"></line>
            </svg>
          </div>
          <div class="node-meta">
            <span class="node-step-tag">02 · Matris</span>
            <strong class="node-title">{step2Title}</strong>
            <span class="node-desc">{step2Sub}</span>
          </div>
          <div class="node-status-dot is-active" title="Normalizasyon Tamam"></div>
        </div>

        <!-- MULTI-LLM CLOUD CLUSTER (Image 4 & 5 style) -->
        <!-- Cloud 1: GPT-4o -->
        <div class="n8n-cloud-node is-gpt" style="left: 620px; top: 40px;" tabindex="0" role="region" aria-label={`${aiTitle1} Denetim Motoru`}>
          <div class="cloud-shape">
            <svg class="cloud-svg" viewBox="0 0 120 70" width="105" height="60">
              <path d="M25,55 A18,18 0 0,1 15,35 A22,22 0 0,1 42,20 A30,30 0 0,1 82,18 A22,22 0 0,1 108,35 A18,18 0 0,1 98,55 Z" fill="#ffffff" stroke="#8b5cf6" stroke-width="2.5" />
            </svg>
            <div class="cloud-content">
              <span class="cloud-badge-label" style="color: #6d28d9;">{aiTitle1}</span>
              <span class="cloud-badge-sub">{aiRole1}</span>
            </div>
          </div>
        </div>

        <!-- Cloud 2: Claude 3.7 -->
        <div class="n8n-cloud-node is-claude" style="left: 745px; top: 40px;" tabindex="0" role="region" aria-label={`${aiTitle2} Mevzuat Motoru`}>
          <div class="cloud-shape">
            <svg class="cloud-svg" viewBox="0 0 120 70" width="105" height="60">
              <path d="M25,55 A18,18 0 0,1 15,35 A22,22 0 0,1 42,20 A30,30 0 0,1 82,18 A22,22 0 0,1 108,35 A18,18 0 0,1 98,55 Z" fill="#ffffff" stroke="#f59e0b" stroke-width="2.5" />
            </svg>
            <div class="cloud-content">
              <span class="cloud-badge-label" style="color: #d97706;">{aiTitle2}</span>
              <span class="cloud-badge-sub">{aiRole2}</span>
            </div>
          </div>
        </div>

        <!-- Cloud 3: Gemini 2.5 -->
        <div class="n8n-cloud-node is-gemini" style="left: 680px; top: 125px;" tabindex="0" role="region" aria-label={`${aiTitle3} Çoklu Doğrulama Motoru`}>
          <div class="cloud-shape">
            <svg class="cloud-svg" viewBox="0 0 120 70" width="105" height="60">
              <path d="M25,55 A18,18 0 0,1 15,35 A22,22 0 0,1 42,20 A30,30 0 0,1 82,18 A22,22 0 0,1 108,35 A18,18 0 0,1 98,55 Z" fill="#ffffff" stroke="#0284c7" stroke-width="2.5" />
            </svg>
            <div class="cloud-content">
              <span class="cloud-badge-label" style="color: #0369a1;">{aiTitle3}</span>
              <span class="cloud-badge-sub">{aiRole3}</span>
            </div>
          </div>
        </div>

        <!-- NODE 3: Sınıflandır & Denetle -->
        <div class="n8n-node n8n-task-node node-step3" style="left: 690px; top: 235px;" tabindex="0" role="region" aria-label={step3Title}>
          <div class="node-icon-box">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="3" width="6" height="4" rx="1"></rect>
              <rect x="3" y="17" width="6" height="4" rx="1"></rect>
              <rect x="15" y="17" width="6" height="4" rx="1"></rect>
              <path d="M12 7v5m0 0H6v5m6-5h6v5"></path>
            </svg>
          </div>
          <div class="node-meta">
            <span class="node-step-tag">03 · Karar</span>
            <strong class="node-title">{step3Title}</strong>
            <span class="node-desc">{step3Sub}</span>
          </div>
          <div class="node-status-dot is-active" title="Çapraz Denetim Onaylandı"></div>
        </div>

        <!-- NODE 4: Excel Kokpiti & Bildirim Dağıtımı -->
        <div class="n8n-node n8n-output-node" style="left: 685px; top: 350px;" tabindex="0" role="region" aria-label="Excel Karar Kokpiti ve Bildirim Çıktıları">
          <div class="output-chips-row">
            <div class="output-chip is-excel" title="Canlı Excel Karar Modeli (.xlsx)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 8l10 8M17 8L7 16"/></svg>
              <span>{output1Title}</span>
            </div>
            <div class="output-chip is-slack" title="Slack / WhatsApp / Webhook Alarmı">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="4" height="8" rx="2" fill="#E01E5A"/>
                <circle cx="13" cy="5" r="2" fill="#36C5F0"/>
                <rect x="11" y="9" width="8" height="4" rx="2" fill="#2EB67D"/>
                <rect x="17" y="13" width="4" height="8" rx="2" fill="#ECB22E"/>
              </svg>
              <span>{output2Title}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Execution Status Bar -->
    <div class="n8n-status-footer">
      <div class="footer-step">
        <span class="step-indicator done">✓</span>
        <span>Kaynak: <strong>{sourceLabel}</strong></span>
      </div>
      <div class="footer-step">
        <span class="step-indicator pulse">●</span>
        <span>AI Karar Hattı: <strong>3 Model Çapraz Teyit</strong></span>
      </div>
      <div class="footer-step">
        <span class="step-indicator done">✓</span>
        <span>Güvence: <strong>%100 Makrosuz &amp; Yerel</strong></span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     TEMA DEĞİŞKENLERİ (Farklı sayfalarda farklı renkler)
     ========================================================================== */
  /* 1. Emerald (Varsayılan - Finansal Analiz & Nakit Akışı) */
  .n8n-workflow-container.theme-emerald {
    --theme-primary: #107c41;
    --theme-primary-hover: #0d6635;
    --theme-primary-soft: #f0fdf4;
    --theme-primary-border: #bbf7d0;
    --theme-n8n-start: #ea4b35;
    --theme-n8n-end: #ef4444;
    --theme-wire-step1: #ef4444;
    --theme-wire-step2: #059669;
    --theme-output-end: #047857;
  }

  /* 2. Blue (Bütçe & Planlama / Nasıl Çalışır) */
  .n8n-workflow-container.theme-blue {
    --theme-primary: #1d4ed8;
    --theme-primary-hover: #1e40af;
    --theme-primary-soft: #eff6ff;
    --theme-primary-border: #bfdbfe;
    --theme-n8n-start: #0284c7;
    --theme-n8n-end: #2563eb;
    --theme-wire-step1: #0284c7;
    --theme-wire-step2: #2563eb;
    --theme-output-end: #1e3a8a;
  }

  /* 3. Purple (Muhasebe, Vergi & VUK) */
  .n8n-workflow-container.theme-purple {
    --theme-primary: #7c3aed;
    --theme-primary-hover: #6d28d9;
    --theme-primary-soft: #faf5ff;
    --theme-primary-border: #e9d5ff;
    --theme-n8n-start: #9333ea;
    --theme-n8n-end: #7c3aed;
    --theme-wire-step1: #9333ea;
    --theme-wire-step2: #6366f1;
    --theme-output-end: #5b21b6;
  }

  /* 4. Amber (Stok, Üretim & Birim Maliyet) */
  .n8n-workflow-container.theme-amber {
    --theme-primary: #d97706;
    --theme-primary-hover: #b45309;
    --theme-primary-soft: #fffbeb;
    --theme-primary-border: #fde68a;
    --theme-n8n-start: #ea580c;
    --theme-n8n-end: #d97706;
    --theme-wire-step1: #ea580c;
    --theme-wire-step2: #d97706;
    --theme-output-end: #92400e;
  }

  /* 5. Coral (Personel, Bordro & İK) */
  .n8n-workflow-container.theme-coral {
    --theme-primary: #e11d48;
    --theme-primary-hover: #be123c;
    --theme-primary-soft: #fff1f2;
    --theme-primary-border: #fecdd3;
    --theme-n8n-start: #f43f5e;
    --theme-n8n-end: #e11d48;
    --theme-wire-step1: #f43f5e;
    --theme-wire-step2: #e11d48;
    --theme-output-end: #9f1239;
  }

  /* 6. Indigo (Özel Sistemler & Kurumsal Mimari) */
  .n8n-workflow-container.theme-indigo {
    --theme-primary: #4338ca;
    --theme-primary-hover: #3730a3;
    --theme-primary-soft: #eef2ff;
    --theme-primary-border: #c7d2fe;
    --theme-n8n-start: #4f46e5;
    --theme-n8n-end: #4338ca;
    --theme-wire-step1: #4f46e5;
    --theme-wire-step2: #0284c7;
    --theme-output-end: #312e81;
  }

  /* Container */
  .n8n-workflow-container {
    margin: 32px 0 44px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .n8n-workflow-container.is-compact {
    margin: 18px 0 26px;
  }

  .n8n-header-meta {
    text-align: center;
    margin-bottom: 22px;
  }
  .n8n-badge-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 13px;
    border-radius: 999px;
    background: var(--theme-primary-soft);
    border: 1px solid var(--theme-primary-border);
    color: var(--theme-primary);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .n8n-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--theme-primary);
    box-shadow: 0 0 0 0 rgba(16, 124, 65, 0.7);
    animation: n8n-pulse 1.8s infinite;
  }
  @keyframes n8n-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 124, 65, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 124, 65, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 124, 65, 0); }
  }
  .n8n-workflow-title {
    margin: 10px 0 5px;
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
