---
interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  sourceLabel?: string;
  compact?: boolean;
}

const {
  title = "Endüstriyel Veri & Otomasyon Mimarisimiz",
  subtitle = "n8n iş akışları, LLM zekası ve Excel karar motorunun canlı entegrasyonu",
  badge = "OTOMASYON & AI HATTI",
  sourceLabel = "ERP / PDF / Banka Ekstresi",
  compact = false
} = Astro.props;
---

<div class:list={["n8n-workflow-container", { "is-compact": compact }]} aria-label="n8n ve Çoklu LLM Otomasyon Akış Şeması">
  {badge && (
    <div class="n8n-header-meta">
      <span class="n8n-badge-kicker">
        <span class="n8n-pulse-dot" aria-hidden="true"></span>
        {badge}
      </span>
      <h3 class="n8n-workflow-title">{title}</h3>
      {subtitle && <p class="n8n-workflow-sub">{subtitle}</p>}
    </div>
  )}

  <!-- Canvas Window -->
  <div class="n8n-canvas-frame">
    <!-- Window Bar -->
    <div class="n8n-canvas-bar">
      <div class="n8n-bar-left">
        <span class="n8n-bar-dot red"></span>
        <span class="n8n-bar-dot yellow"></span>
        <span class="n8n-bar-dot green"></span>
        <span class="n8n-bar-title">workflow-engine.n8n · active</span>
      </div>
      <div class="n8n-bar-stats">
        <span class="n8n-stat-pill"><span class="stat-live-dot"></span> Canlı Dağıtım</span>
        <span class="n8n-stat-pill">Gecikme: &lt;140ms</span>
      </div>
    </div>

    <!-- Graph Body -->
    <div class="n8n-graph-body">
      <!-- Animated SVG Connecting Lines Layer -->
      <svg class="n8n-wire-layer" viewBox="0 0 1000 420" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <!-- Gradient 1: n8n to Node 1 (Orange/Red to Coral) -->
          <linearGradient id="grad-n8n-1" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ea4b35" />
            <stop offset="100%" stop-color="#ef4444" />
          </linearGradient>

          <!-- Gradient 2: Node 1 to Node 2 (Coral to Teal) -->
          <linearGradient id="grad-1-2" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ef4444" />
            <stop offset="100%" stop-color="#0d9488" />
          </linearGradient>

          <!-- Gradient 3: LLM Branch 1 (Teal to GPT Purple) -->
          <linearGradient id="grad-llm-gpt" x1="0%" y1="50%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0d9488" />
            <stop offset="100%" stop-color="#8b5cf6" />
          </linearGradient>

          <!-- Gradient 4: LLM Branch 2 (Teal to Claude Amber) -->
          <linearGradient id="grad-llm-claude" x1="0%" y1="50%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0d9488" />
            <stop offset="100%" stop-color="#f59e0b" />
          </linearGradient>

          <!-- Gradient 5: LLM Branch 3 (Teal to Gemini Blue) -->
          <linearGradient id="grad-llm-gemini" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0d9488" />
            <stop offset="100%" stop-color="#0284c7" />
          </linearGradient>

          <!-- Gradient 6: Converging LLMs to Classifier (Purple to Indigo) -->
          <linearGradient id="grad-converge" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6366f1" />
            <stop offset="100%" stop-color="#4f46e5" />
          </linearGradient>

          <!-- Gradient 7: Classifier to Output (Indigo to Emerald/Slack) -->
          <linearGradient id="grad-output" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#4f46e5" />
            <stop offset="100%" stop-color="#107c41" />
          </linearGradient>

          <!-- Glow Filters -->
          <filter id="glow-light" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>

          <!-- Arrow Markers -->
          <marker id="arrow-coral" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="#ef4444" />
          </marker>
          <marker id="arrow-teal" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="#0d9488" />
          </marker>
          <marker id="arrow-indigo" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="#4f46e5" />
          </marker>
          <marker id="arrow-green" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 9 5 L 0 9 z" fill="#107c41" />
          </marker>
        </defs>

        <!-- PATH 1: n8n Hub -> PDF Extractor (Animation Type 1: Rapid Marching Pulse) -->
        <path d="M 125 210 L 220 210" class="wire-base" />
        <path d="M 125 210 L 220 210" class="wire-animated wire-pulse-red" stroke="url(#grad-n8n-1)" marker-end="url(#arrow-coral)" />

        <!-- PATH 2: PDF Extractor -> Özetle (Animation Type 2: Liquid Dash Flow) -->
        <path d="M 330 210 L 415 210" class="wire-base" />
        <path d="M 330 210 L 415 210" class="wire-animated wire-flow-teal" stroke="url(#grad-1-2)" marker-end="url(#arrow-teal)" />

        <!-- BRANCHING PATHS 3: Özetle -> Cloud AI Models (Animation Type 3: Triple Beam Expansion) -->
        <!-- Branch to GPT-4 -->
        <path d="M 525 210 C 585 210, 595 105, 660 90" class="wire-base" />
        <path d="M 525 210 C 585 210, 595 105, 660 90" class="wire-animated wire-beam-gpt" stroke="url(#grad-llm-gpt)" />

        <!-- Branch to Claude -->
        <path d="M 525 210 C 600 210, 680 135, 780 90" class="wire-base" />
        <path d="M 525 210 C 600 210, 680 135, 780 90" class="wire-animated wire-beam-claude" stroke="url(#grad-llm-claude)" />

        <!-- Branch to Gemini -->
        <path d="M 525 210 C 585 210, 640 185, 695 180" class="wire-base" />
        <path d="M 525 210 C 585 210, 640 185, 695 180" class="wire-animated wire-beam-gemini" stroke="url(#grad-llm-gemini)" />

        <!-- CONVERGING PATHS 4: AI Models -> Sınıflandır (Animation Type 4: Multi-Model Convergence) -->
        <path d="M 700 115 C 710 180, 755 200, 755 240" class="wire-base" />
        <path d="M 815 115 C 815 180, 755 200, 755 240" class="wire-base" />
        <path d="M 755 185 C 755 210, 755 220, 755 240" class="wire-base" />
        <!-- Dynamic combined flow -->
        <path d="M 755 185 L 755 240" class="wire-animated wire-flow-indigo" stroke="url(#grad-converge)" marker-end="url(#arrow-indigo)" />

        <!-- PATH 5: Sınıflandır -> Slack & Excel Kokpiti (Animation Type 5: Dual Decision Output Stream) -->
        <path d="M 755 330 L 755 355" class="wire-base" />
        <path d="M 755 330 L 755 355" class="wire-animated wire-flow-green" stroke="url(#grad-output)" marker-end="url(#arrow-green)" />
      </svg>

      <!-- HTML Nodes Interactive Grid Layer -->
      <div class="n8n-nodes-layer">
        <!-- NODE 0: n8n Master Trigger -->
        <div class="n8n-node n8n-hub-node" style="left: 20px; top: 165px;" tabindex="0" role="region" aria-label="n8n Otomasyon Motoru">
          <div class="n8n-hub-badge">
            <svg class="n8n-logo-svg" viewBox="0 0 80 80" width="38" height="38" fill="none">
              <circle cx="24" cy="40" r="14" fill="#ea4b35" />
              <circle cx="56" cy="24" r="11" fill="#ea4b35" />
              <circle cx="56" cy="56" r="11" fill="#ea4b35" />
              <path d="M 28 35 L 50 26" stroke="#ea4b35" stroke-width="6" stroke-linecap="round" />
              <path d="M 28 45 L 50 54" stroke="#ea4b35" stroke-width="6" stroke-linecap="round" />
            </svg>
            <span class="n8n-hub-title">n8n</span>
          </div>
          <span class="n8n-hub-sub">Otomasyon Motoru</span>
        </div>

        <!-- NODE 1: PDF & Veri Çıkarıcı -->
        <div class="n8n-node n8n-task-node is-red" style="left: 215px; top: 155px;" tabindex="0" role="region" aria-label="PDF ve Veri Çıkarma Adımı">
          <div class="node-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="node-meta">
            <span class="node-tag">ADIM 1</span>
            <strong class="node-title">PDF'ten Metin &amp; Tablo Çıkar</strong>
            <span class="node-desc">{sourceLabel}</span>
          </div>
          <div class="node-status-dot is-green" title="Durum: Aktif"></div>
        </div>

        <!-- NODE 2: Özetle & Yapılandır -->
        <div class="n8n-node n8n-task-node is-teal" style="left: 410px; top: 155px;" tabindex="0" role="region" aria-label="Özetleme ve Yapılandırma Adımı">
          <div class="node-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              <line x1="8" y1="9" x2="16" y2="9"></line>
              <line x1="8" y1="13" x2="14" y2="13"></line>
            </svg>
          </div>
          <div class="node-meta">
            <span class="node-tag">ADIM 2</span>
            <strong class="node-title">Özetle &amp; Yapılandır</strong>
            <span class="node-desc">AST Normalizasyonu</span>
          </div>
          <div class="node-status-dot is-green" title="Durum: Aktif"></div>
        </div>

        <!-- MULTI-LLM CLOUD CLUSTER -->
        <!-- Cloud 1: GPT-4 -->
        <div class="n8n-cloud-node is-gpt" style="left: 620px; top: 40px;" tabindex="0" role="region" aria-label="OpenAI GPT-4 Modeli">
          <div class="cloud-shape">
            <svg class="cloud-svg" viewBox="0 0 120 70" width="105" height="60">
              <path d="M25,55 A18,18 0 0,1 15,35 A22,22 0 0,1 42,20 A30,30 0 0,1 82,18 A22,22 0 0,1 108,35 A18,18 0 0,1 98,55 Z" fill="#ffffff" stroke="#8b5cf6" stroke-width="2.5" />
            </svg>
            <div class="cloud-content">
              <span class="cloud-badge-label" style="color: #6d28d9;">GPT-4o</span>
              <span class="cloud-badge-sub">Finansal Muhakeme</span>
            </div>
          </div>
        </div>

        <!-- Cloud 2: Claude -->
        <div class="n8n-cloud-node is-claude" style="left: 745px; top: 40px;" tabindex="0" role="region" aria-label="Anthropic Claude Modeli">
          <div class="cloud-shape">
            <svg class="cloud-svg" viewBox="0 0 120 70" width="105" height="60">
              <path d="M25,55 A18,18 0 0,1 15,35 A22,22 0 0,1 42,20 A30,30 0 0,1 82,18 A22,22 0 0,1 108,35 A18,18 0 0,1 98,55 Z" fill="#ffffff" stroke="#f59e0b" stroke-width="2.5" />
            </svg>
            <div class="cloud-content">
              <span class="cloud-badge-label" style="color: #d97706;">Claude</span>
              <span class="cloud-badge-sub">Mevzuat &amp; Kod</span>
            </div>
          </div>
        </div>

        <!-- Cloud 3: Gemini -->
        <div class="n8n-cloud-node is-gemini" style="left: 680px; top: 125px;" tabindex="0" role="region" aria-label="Google Gemini Modeli">
          <div class="cloud-shape">
            <svg class="cloud-svg" viewBox="0 0 120 70" width="105" height="60">
              <path d="M25,55 A18,18 0 0,1 15,35 A22,22 0 0,1 42,20 A30,30 0 0,1 82,18 A22,22 0 0,1 108,35 A18,18 0 0,1 98,55 Z" fill="#ffffff" stroke="#0284c7" stroke-width="2.5" />
            </svg>
            <div class="cloud-content">
              <span class="cloud-badge-label" style="color: #0369a1;">Gemini</span>
              <span class="cloud-badge-sub">Çoklu Veri Akışı</span>
            </div>
          </div>
        </div>

        <!-- NODE 3: Sınıflandır & Denetle -->
        <div class="n8n-node n8n-task-node is-purple" style="left: 690px; top: 235px;" tabindex="0" role="region" aria-label="Sınıflandırma ve Doğrulama Adımı">
          <div class="node-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="3" width="6" height="4" rx="1"></rect>
              <rect x="3" y="17" width="6" height="4" rx="1"></rect>
              <rect x="15" y="17" width="6" height="4" rx="1"></rect>
              <path d="M12 7v5m0 0H6v5m6-5h6v5"></path>
            </svg>
          </div>
          <div class="node-meta">
            <span class="node-tag">ADIM 3</span>
            <strong class="node-title">Sınıflandır &amp; Denetle</strong>
            <span class="node-desc">Anomali &amp; Çapraz Test</span>
          </div>
          <div class="node-status-dot is-green" title="Durum: Doğrulandı"></div>
        </div>

        <!-- NODE 4: Excel Kokpiti & Dağıtım (Slack/WhatsApp) -->
        <div class="n8n-node n8n-output-node" style="left: 690px; top: 350px;" tabindex="0" role="region" aria-label="Excel Karar Kokpiti ve Bildirim Çıktısı">
          <div class="output-chips-row">
            <div class="output-chip is-excel" title="Canlı Excel Karar Modeli">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#107c41" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="3" stroke="#107c41"/><path d="M7 8l10 8M17 8L7 16" stroke="#107c41"/></svg>
              <span>Excel Kokpiti</span>
            </div>
            <div class="output-chip is-slack" title="Slack & WhatsApp Bildirimi">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="4" height="8" rx="2" fill="#E01E5A"/>
                <circle cx="13" cy="5" r="2" fill="#36C5F0"/>
                <rect x="11" y="9" width="8" height="4" rx="2" fill="#2EB67D"/>
                <rect x="17" y="13" width="4" height="8" rx="2" fill="#ECB22E"/>
              </svg>
              <span>Slack &amp; WhatsApp</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Execution Status Bar -->
    <div class="n8n-status-footer">
      <div class="footer-step">
        <span class="step-indicator done">✓</span>
        <span>Kaynak Veri: <strong>Doğrulandı</strong></span>
      </div>
      <div class="footer-step">
        <span class="step-indicator pulse">●</span>
        <span>AI Karar Hattı: <strong>3 Model Çapraz Doğrulama</strong></span>
      </div>
      <div class="footer-step">
        <span class="step-indicator done">✓</span>
        <span>Çıktı Güvencesi: <strong>%100 Makrosuz .xlsx</strong></span>
      </div>
    </div>
  </div>
</div>

<style>
  .n8n-workflow-container {
    margin: 28px 0 40px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .n8n-workflow-container.is-compact {
    margin: 16px 0 24px;
  }

  .n8n-header-meta {
    text-align: center;
    margin-bottom: 20px;
  }
  .n8n-badge-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 12px;
    border-radius: 999px;
    background: #fff1ee;
    border: 1px solid #fecdd3;
    color: #e11d48;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .n8n-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e11d48;
    box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.7);
    animation: n8n-pulse 1.8s infinite;
  }
  @keyframes n8n-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 7px rgba(225, 29, 72, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
  }
  .n8n-workflow-title {
    margin: 10px 0 4px;
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .n8n-workflow-sub {
    margin: 0;
    font-size: 13.5px;
    color: #64748b;
  }

  /* Canvas Frame */
  .n8n-canvas-frame {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05), 0 2px 6px rgba(15, 23, 42, 0.03);
    position: relative;
  }

  .n8n-canvas-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  .n8n-bar-left {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .n8n-bar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .n8n-bar-dot.red { background: #f87171; }
  .n8n-bar-dot.yellow { background: #fbbf24; }
  .n8n-bar-dot.green { background: #34d399; }
  .n8n-bar-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11.5px;
    font-weight: 600;
    color: #64748b;
    margin-left: 6px;
  }
  .n8n-bar-stats {
    display: flex;
    gap: 8px;
  }
  .n8n-stat-pill {
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 3px 9px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .stat-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  /* Graph Body */
  .n8n-graph-body {
    position: relative;
    height: 440px;
    background-color: #fbfcfd;
    background-image: 
      radial-gradient(#e2e8f0 1.2px, transparent 1.2px), 
      radial-gradient(#f1f5f9 1.2px, #fbfcfd 1.2px);
    background-size: 24px 24px;
    background-position: 0 0, 12px 12px;
    overflow-x: auto;
    overflow-y: hidden;
  }

  /* SVG Wire Layer */
  .n8n-wire-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 1000px;
    height: 440px;
    pointer-events: none;
    z-index: 1;
  }

  .wire-base {
    fill: none;
    stroke: #e2e8f0;
    stroke-width: 3.5px;
    stroke-linecap: round;
  }
  .wire-animated {
    fill: none;
    stroke-width: 3px;
    stroke-linecap: round;
  }

  /* ANIMATION TYPE 1: Fast Pulse Stream */
  .wire-pulse-red {
    stroke-dasharray: 6 12;
    animation: dashStream 1.5s linear infinite;
  }

  /* ANIMATION TYPE 2: Liquid Dash Flow */
  .wire-flow-teal {
    stroke-dasharray: 8 8;
    animation: dashStream 1.8s linear infinite;
  }

  /* ANIMATION TYPE 3: Multi-Beam Glowing Pulses */
  .wire-beam-gpt {
    stroke-dasharray: 10 16;
    animation: dashStream 2.2s linear infinite;
  }
  .wire-beam-claude {
    stroke-dasharray: 7 14;
    animation: dashStream 2s linear infinite;
  }
  .wire-beam-gemini {
    stroke-dasharray: 9 12;
    animation: dashStream 1.7s linear infinite;
  }

  /* ANIMATION TYPE 4: Converging Beam */
  .wire-flow-indigo {
    stroke-dasharray: 6 8;
    animation: dashStream 1.2s linear infinite;
  }

  /* ANIMATION TYPE 5: Output Stream */
  .wire-flow-green {
    stroke-dasharray: 6 6;
    animation: dashStream 1.4s linear infinite;
  }

  @keyframes dashStream {
    from {
      stroke-dashoffset: 60;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Nodes Layer */
  .n8n-nodes-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 1000px;
    height: 440px;
    z-index: 2;
  }

  /* Node 0: n8n Hub */
  .n8n-hub-node {
    position: absolute;
    width: 105px;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: default;
    transition: transform 0.2s ease;
  }
  .n8n-hub-node:hover {
    transform: scale(1.05);
  }
  .n8n-hub-badge {
    background: #ffffff;
    border: 2px solid #ea4b35;
    border-radius: 16px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 16px rgba(234, 75, 53, 0.15);
  }
  .n8n-hub-title {
    font-size: 22px;
    font-weight: 850;
    color: #1e293b;
    letter-spacing: -0.04em;
  }
  .n8n-hub-sub {
    margin-top: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-align: center;
  }

  /* Standard Task Nodes */
  .n8n-task-node {
    position: absolute;
    width: 115px;
    min-height: 105px;
    background: #ffffff;
    border-radius: 16px;
    border: 2.5px solid #cbd5e1;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
