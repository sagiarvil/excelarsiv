---

<section class="catalog-hero" aria-labelledby="catalog-title">
  <div class="catalog-hero__glow" aria-hidden="true"></div>
  <div class="site-container catalog-hero__grid">
    <div class="catalog-hero__copy">
      <div class="catalog-hero__kicker"><span></span> {activeConfig.kicker}</div>
      <h1 id="catalog-title" class="catalog-hero__title">{title}</h1>
      <p class="catalog-hero__lead">{description}</p>

      <div class="catalog-hero__actions">
        <a class="catalog-hero__primary" href="#katalog">Sistemleri keşfet <span aria-hidden="true">↓</span></a>
        <a class="catalog-hero__secondary" href="/nasil-calisir">Nasıl çalışır?</a>
      </div>

      <dl class="catalog-hero__stats" aria-label="Katalog özeti">
        <div><dt>{templateCount}</dt><dd>hazır sistem</dd></div>
        <div><dt>{categoryCount}</dt><dd>işletme alanı</dd></div>
        <div><dt>WhatsApp</dt><dd>hızlı teklif</dd></div>
      </dl>
    </div>

    <div class="catalog-hero__visual" aria-hidden="true">
      <div class="workbook">
        <div class="workbook__topbar">
          <div class="workbook__dots"><i></i><i></i><i></i></div>
          <span>{activeConfig.fileName}</span>
          <b>Excel Arşiv</b>
        </div>
        <div class="workbook__ribbon">
          {activeConfig.tabs.map((tab, idx) => (
            <span class={idx === 0 ? 'is-active' : ''}>{tab}</span>
          ))}
        </div>
        <div class="workbook__canvas">
          <div class="workbook__title">
            <span>{activeConfig.kicker}</span>
            <b>Karar için tek ekran</b>
          </div>
          <div class="workbook__kpis">
            {activeConfig.kpis.map((kpi) => (
              <div style={`background:${kpi.bg}; border-color:${kpi.color}25;`}>
                <small style={`color:${kpi.color}; font-weight:800;`}>{kpi.label}</small>
                <strong style={`color:${kpi.color};`}>{kpi.val}</strong>
                <span>{kpi.desc}</span>
              </div>
            ))}
          </div>
          <div class="workbook__body">
            <div class="workbook__chart">
              <div class="workbook__chart-head">
                <span>{activeConfig.chartTitle}</span>
                <div class="workbook__chart-legend">
                  <span class="dot-blue"></span>
                  <span class="dot-green"></span>
                  <span class="dot-yellow"></span>
                  <span class="dot-red"></span>
                </div>
              </div>

              <!-- Dinamik ve Renkli Grafik Türleri (Kırmızı, Mavi, Sarı, Yeşil) -->
              {activeConfig.chartType === 'cash-flow' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
                  <!-- Nakit Akışı: Yeşil Giriş, Kırmızı Çıkış Barları ve Mavi Bakiye Eğrisi -->
                  <defs>
                    <linearGradient id="cfBlue" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#0284c7" stop-opacity="0.3" />
                      <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <!-- Kılavuz çizgileri -->
                  <line x1="0" y1="42" x2="320" y2="42" stroke="#e2e8f0" stroke-dasharray="3,3" />
                  <!-- Giriş Barları (Yeşil) -->
                  <rect x="20" y="20" width="10" height="22" rx="2" fill="#107c41" />
                  <rect x="60" y="12" width="10" height="30" rx="2" fill="#107c41" />
                  <rect x="100" y="8" width="10" height="34" rx="2" fill="#107c41" />
                  <rect x="140" y="15" width="10" height="27" rx="2" fill="#107c41" />
                  <rect x="180" y="10" width="10" height="32" rx="2" fill="#107c41" />
                  <rect x="220" y="6" width="10" height="36" rx="2" fill="#107c41" />
                  <rect x="260" y="14" width="10" height="28" rx="2" fill="#107c41" />
                  <!-- Çıkış Barları (Kırmızı) -->
                  <rect x="33" y="42" width="10" height="26" rx="2" fill="#e11d48" />
                  <rect x="73" y="42" width="10" height="18" rx="2" fill="#e11d48" />
                  <rect x="113" y="42" width="10" height="32" rx="2" fill="#e11d48" />
                  <rect x="153" y="42" width="10" height="20" rx="2" fill="#e11d48" />
                  <rect x="193" y="42" width="10" height="36" rx="2" fill="#e11d48" />
                  <rect x="233" y="42" width="10" height="16" rx="2" fill="#e11d48" />
                  <rect x="273" y="42" width="10" height="22" rx="2" fill="#e11d48" />
                  <!-- Kümülatif Bakiye Eğrisi (Mavi) -->
                  <polyline points="25,35 65,28 105,20 145,26 185,18 225,12 265,16 300,10" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" />
                  <!-- Kritik Risk Noktası (Sarı) -->
                  <circle cx="185" cy="18" r="4" fill="#f59e0b" stroke="#ffffff" stroke-width="1.5" />
                </svg>
              )}

              {activeConfig.chartType === 'tax-breakdown' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
                  <!-- Vergi Dağılımı: Kırmızı KDV, Sarı Muhtasar, Mavi Kurumlar/Geçici, Yeşil SGK Teşvik -->
                  <!-- 1. KDV Barı (Kırmızı) -->
                  <text x="5" y="18" font-size="7" fill="#64748b" font-family="monospace">KDV</text>
                  <rect x="42" y="10" width="170" height="11" rx="3" fill="#e11d48" />
                  <rect x="215" y="10" width="45" height="11" rx="3" fill="#fda4af" />
                  <!-- 2. Muhtasar Barı (Sarı) -->
                  <text x="5" y="36" font-size="7" fill="#64748b" font-family="monospace">MUHT</text>
                  <rect x="42" y="28" width="130" height="11" rx="3" fill="#d97706" />
                  <rect x="175" y="28" width="55" height="11" rx="3" fill="#fde68a" />
                  <!-- 3. Geçici Vergi (Mavi) -->
                  <text x="5" y="54" font-size="7" fill="#64748b" font-family="monospace">GEÇİCİ</text>
                  <rect x="42" y="46" width="195" height="11" rx="3" fill="#0284c7" />
                  <rect x="240" y="46" width="35" height="11" rx="3" fill="#bae6fd" />
                  <!-- 4. SGK Teşvik Avantajı (Yeşil) -->
                  <text x="5" y="72" font-size="7" fill="#107c41" font-weight="bold" font-family="monospace">TEŞVİK</text>
                  <rect x="42" y="64" width="85" height="11" rx="3" fill="#107c41" />
                  <text x="135" y="73" font-size="7.5" fill="#107c41" font-weight="bold">+₺42.850 İndirim</text>
                </svg>
              )}

              {activeConfig.chartType === 'stock-levels' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
                  <!-- Stok & Depo: Amber barlar, Kırmızı Kritik Eşik çizgisi, Mavi devir hızı -->
                  <line x1="0" y1="35" x2="320" y2="35" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4,3" />
                  <text x="250" y="32" font-size="6.5" fill="#ef4444" font-weight="bold">KRİTİK EŞİK</text>
                  <!-- Stok Barları (Sarı & Yeşil & Kırmızı) -->
                  <rect x="20" y="40" width="18" height="40" rx="3" fill="#f59e0b" />
                  <rect x="55" y="22" width="18" height="58" rx="3" fill="#107c41" />
                  <rect x="90" y="50" width="18" height="30" rx="3" fill="#e11d48" /> <!-- Kritik! -->
                  <rect x="125" y="15" width="18" height="65" rx="3" fill="#107c41" />
                  <rect x="160" y="48" width="18" height="32" rx="3" fill="#e11d48" /> <!-- Kritik! -->
                  <rect x="195" y="28" width="18" height="52" rx="3" fill="#0284c7" />
                  <rect x="230" y="18" width="18" height="62" rx="3" fill="#107c41" />
                  <!-- Trend Eğrisi (Mavi) -->
                  <polyline points="29,38 64,20 99,48 134,14 169,46 204,26 239,16 270,22" fill="none" stroke="#0284c7" stroke-width="2" stroke-linecap="round" />
                </svg>
              )}

              {activeConfig.chartType === 'budget-variance' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
                  <!-- Bütçe vs Gerçekleşen: İndigo Bütçe, Mavi Gerçekleşen, Sarı Sapma -->
                  <rect x="25" y="15" width="14" height="60" rx="3" fill="#4f46e5" />
                  <rect x="42" y="20" width="14" height="55" rx="3" fill="#0284c7" />
                  <rect x="85" y="10" width="14" height="65" rx="3" fill="#4f46e5" />
                  <rect x="102" y="8" width="14" height="67" rx="3" fill="#107c41" />
                  <rect x="145" y="18" width="14" height="57" rx="3" fill="#4f46e5" />
                  <rect x="162" y="30" width="14" height="45" rx="3" fill="#f59e0b" /> <!-- Sapma -->
                  <rect x="205" y="12" width="14" height="63" rx="3" fill="#4f46e5" />
                  <rect x="222" y="16" width="14" height="59" rx="3" fill="#0284c7" />
                  <!-- Hedef İlerleme Çizgisi (Kırmızı & Yeşil) -->
                  <polyline points="33,12 93,6 153,16 213,10 260,8" fill="none" stroke="#107c41" stroke-width="2" stroke-linecap="round" />
                  <circle cx="153" cy="16" r="3.5" fill="#e11d48" stroke="#fff" stroke-width="1.5" />
                </svg>
              )}

              {activeConfig.chartType === 'sales-funnel' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
                  <!-- Satış Hunisi & Ciro: Mavi Lead, Sarı Teklif, Yeşil Satış, Kırmızı Komisyon -->
                  <polygon points="20,10 130,10 110,26 40,26" fill="#0284c7" />
                  <text x="140" y="20" font-size="7" fill="#0284c7" font-weight="bold">Teklif Aşaması (₺1.8M)</text>
                  <polygon points="40,29 110,29 95,45 55,45" fill="#f59e0b" />
                  <text x="125" y="39" font-size="7" fill="#d97706" font-weight="bold">Müzakere (%65)</text>
                  <polygon points="55,48 95,48 85,64 65,64" fill="#107c41" />
                  <text x="110" y="58" font-size="7" fill="#107c41" font-weight="bold">Kapanan Satış (₺840K)</text>
                  <rect x="65" y="67" width="20" height="12" rx="2" fill="#e11d48" />
                  <text x="95" y="76" font-size="7" fill="#e11d48" font-weight="bold">Prim Havuzu (₺84.5K)</text>
                </svg>
              )}

              {activeConfig.chartType === 'payroll-dist' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
                  <!-- Bordro Maliyet Dilimleri: Mavi Net, Sarı SGK, Kırmızı Vergi, Yeşil Teşvik -->
                  <rect x="25" y="12" width="220" height="14" rx="4" fill="#0284c7" />
                  <text x="255" y="23" font-size="7.5" fill="#0284c7" font-weight="bold">Net Ücret %52</text>
                  <rect x="25" y="30" width="160" height="14" rx="4" fill="#f59e0b" />
                  <text x="195" y="41" font-size="7.5" fill="#d97706" font-weight="bold">SGK Primi %22.5</text>
                  <rect x="25" y="48" width="110" height="14" rx="4" fill="#e11d48" />
                  <text x="145" y="59" font-size="7.5" fill="#e11d48" font-weight="bold">Gelir/Damga %15</text>
                  <rect x="25" y="66" width="60" height="14" rx="4" fill="#107c41" />
                  <text x="95" y="77" font-size="7.5" fill="#107c41" font-weight="bold">5510 Teşviki -%5</text>
                </svg>
              )}

              {activeConfig.chartType === 'finance-trend' && (
                <svg viewBox="0 0 320 85" preserveAspectRatio="none">
