---
interface Props {
  title?: string;
  description?: string;
  templateCount?: number;
  categoryCount?: number;
  minPriceTL?: number;
}

const {
  title = 'Hazır tablo değil. İşletmeniz için çalışan Excel sistemleri.',
  description = 'Nakit akışından kârlılığa, tahsilattan stok yönetimine kadar işletmenin kritik kararlarını tek bakışta görünür hale getiren hazır Excel çalışma sistemleri.',
  templateCount = 0,
  categoryCount = 0,
  minPriceTL,
} = Astro.props;

const minPrice = typeof minPriceTL === 'number' ? minPriceTL.toLocaleString('tr-TR') : null;
---

<section class="catalog-hero" aria-labelledby="catalog-title">
  <div class="catalog-hero__glow" aria-hidden="true"></div>
  <div class="site-container catalog-hero__grid">
    <div class="catalog-hero__copy">
      <div class="catalog-hero__kicker"><span></span> EXCEL ARŞİV · İŞLETME KARAR ARAÇLARI</div>
      <h1 id="catalog-title" class="catalog-hero__title">{title}</h1>
      <p class="catalog-hero__lead">{description}</p>

      <div class="catalog-hero__actions">
        <a class="catalog-hero__primary" href="#katalog">Sistemleri keşfet <span aria-hidden="true">↓</span></a>
        <a class="catalog-hero__secondary" href="/nasil-calisir">Nasıl çalışır?</a>
      </div>

      <dl class="catalog-hero__stats" aria-label="Katalog özeti">
        <div><dt>{templateCount}</dt><dd>hazır sistem</dd></div>
        <div><dt>{categoryCount}</dt><dd>işletme alanı</dd></div>
        <div><dt>WhatsApp</dt><dd>hızlı teklif</dd></div>
      </dl>
    </div>

    <div class="catalog-hero__visual" aria-hidden="true">
      <div class="workbook">
        <div class="workbook__topbar">
          <div class="workbook__dots"><i></i><i></i><i></i></div>
          <span>Yönetim_Panosu.xlsx</span>
          <b>Excel Arşiv</b>
        </div>
        <div class="workbook__ribbon">
          <span class="is-active">PANO</span><span>GİRDİLER</span><span>KONTROL</span><span>RAPOR</span>
        </div>
        <div class="workbook__canvas">
          <div class="workbook__title"><span>YÖNETİM ÖZETİ</span><b>Karar için tek ekran</b></div>
          <div class="workbook__kpis">
            <div><small>NAKİT</small><strong>GÖRÜNÜR</strong><span>Giriş / çıkış dengesi</span></div>
            <div><small>RİSK</small><strong>KONTROL</strong><span>Vade / tahsilat görünümü</span></div>
            <div><small>KÂRLILIK</small><strong>KARAR</strong><span>Gerçek sonuç takibi</span></div>
          </div>
          <div class="workbook__body">
            <div class="workbook__chart">
              <div class="workbook__chart-head"><span>12 HAFTALIK GÖRÜNÜM</span><i></i></div>
              <svg viewBox="0 0 320 128" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="areaFill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#107c41" stop-opacity=".22" />
                    <stop offset="100%" stop-color="#107c41" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path d="M0 105 L38 92 L76 98 L114 69 L152 78 L190 48 L228 58 L266 31 L320 20 L320 128 L0 128 Z" fill="url(#areaFill)" />
                <polyline points="0,105 38,92 76,98 114,69 152,78 190,48 228,58 266,31 320,20" fill="none" stroke="#107c41" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="workbook__decisions">
              <span>KARAR AKIŞI</span>
              <ul>
                <li><i class="good"></i><b>Veri</b><em>girildi</em></li>
                <li><i class="good"></i><b>Kontrol</b><em>çalıştı</em></li>
                <li><i class="warn"></i><b>Karar</b><em>görünür</em></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="workbook__tabs"><span class="is-active">PANO</span><span>NAKİT</span><span>KÂRLILIK</span><span>RAPOR</span><b>+</b></div>
      </div>
      <div class="catalog-hero__badge"><span>✓</span><div><b>Gerçek ekranlarla inceleyin</b><small>Ürün sayfalarında 3+ ön izleme</small></div></div>
    </div>
  </div>
</section>

<style>
  .catalog-hero {
    position: relative;
    overflow: hidden;
    padding-block: 28px 24px;
    border-bottom: 1px solid var(--xl-grid);
    background:
      linear-gradient(rgba(16,124,65,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16,124,65,.03) 1px, transparent 1px),
      linear-gradient(145deg, #fbfdfb 0%, #f6faf7 52%, #eff6f1 100%);
    background-size: 28px 28px, 28px 28px, auto;
  }
  .catalog-hero__glow {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -120px;
    top: -180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(16,124,65,.12), rgba(16,124,65,0) 68%);
    pointer-events: none;
  }
  .catalog-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: 32px;
    align-items: center;
  }
  .catalog-hero__copy { min-width: 0; }
  .catalog-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    padding: 0 9px;
    border: 1px solid var(--xl-accent-border);
    border-radius: 999px;
    background: rgba(255,255,255,.85);
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: .08em;
    color: var(--xl-green-dark);
  }
  .catalog-hero__kicker span { width: 5px; height: 5px; border-radius: 50%; background: var(--xl-green); box-shadow: 0 0 0 3px rgba(16,124,65,.1); }
  .catalog-hero__title {
    max-width: 720px;
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1.1;
    color: #13271c;
  }
  .catalog-hero__lead {
    max-width: 620px;
    margin: 10px 0 0;
    font-size: clamp(13.5px, 1.2vw, 15px);
    line-height: 1.55;
    color: var(--xl-ink-3);
  }
  .catalog-hero__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .catalog-hero__primary,
  .catalog-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 0 15px;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .catalog-hero__primary { border: 1px solid #0a6235; background: #0d7040; color: #fff; box-shadow: 0 6px 16px rgba(13,112,64,.18); }
  .catalog-hero__primary:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(13,112,64,.22); }
  .catalog-hero__secondary { border: 1px solid var(--xl-border); background: rgba(255,255,255,.9); color: var(--xl-ink-900); }
  .catalog-hero__secondary:hover { background: #fff; }
  .catalog-hero__stats { display: flex; flex-wrap: wrap; gap: 0; margin: 18px 0 0; }
  .catalog-hero__stats div { min-width: 90px; padding: 0 14px; border-right: 1px solid var(--xl-border); }
  .catalog-hero__stats div:first-child { padding-left: 0; }
  .catalog-hero__stats div:last-child { border-right: 0; }
  .catalog-hero__stats dt { font-family: var(--font-mono); font-size: 14px; font-weight: 800; color: var(--xl-ink-900); }
  .catalog-hero__stats dd { margin: 2px 0 0; font-size: 10px; color: var(--xl-ink-3); }

  .catalog-hero__visual { position: relative; min-width: 0; padding: 0; max-width: 420px; justify-self: end; width: 100%; }
  .workbook {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(20,61,39,.15);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 16px 36px rgba(17,56,35,.1), 0 2px 0 rgba(255,255,255,.7) inset;
  }
  .workbook__topbar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; height: 32px; padding: 0 11px; background: #0f6f40; color: #fff; }
  .workbook__dots { display: flex; gap: 4px; }
  .workbook__dots i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.5); }
  .workbook__topbar > span { font-family: var(--font-mono); font-size: 8.5px; opacity: .88; }
  .workbook__topbar > b { font-family: var(--font-mono); font-size: 7.5px; letter-spacing: .06em; opacity: .85; }
  .workbook__ribbon { display: flex; align-items: center; gap: 14px; height: 28px; padding: 0 12px; border-bottom: 1px solid #dfe7e2; background: #f5f7f6; font-family: var(--font-mono); font-size: 7px; font-weight: 700; color: #718078; }
  .workbook__ribbon span.is-active { color: #0c6e3e; }
  .workbook__canvas { padding: 12px; background: linear-gradient(#edf1ef 1px, transparent 1px), linear-gradient(90deg,#edf1ef 1px,transparent 1px), #fff; background-size: 20px 20px; }
  .workbook__title { display: flex; align-items: end; justify-content: space-between; gap: 12px; padding: 0 2px 8px; }
  .workbook__title span { font-family: var(--font-mono); font-size: 7px; font-weight: 800; letter-spacing: .07em; color: #0c6e3e; }
  .workbook__title b { font-size: 8px; color: #647169; }
  .workbook__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .workbook__kpis div { display: grid; gap: 3px; min-width: 0; padding: 8px; border: 1px solid #dde6e0; border-radius: 8px; background: rgba(255,255,255,.94); box-shadow: 0 4px 10px rgba(30,61,43,.03); }
  .workbook__kpis small { font-family: var(--font-mono); font-size: 6px; font-weight: 800; letter-spacing: .06em; color: #7d8982; }
  .workbook__kpis strong { font-family: var(--font-mono); font-size: 10.5px; color: #163b28; }
  .workbook__kpis span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 6.5px; color: #7d8982; }
  .workbook__body { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(110px,.75fr); gap: 6px; margin-top: 6px; }
  .workbook__chart,
  .workbook__decisions { border: 1px solid #dde6e0; border-radius: 8px; background: rgba(255,255,255,.95); }
  .workbook__chart { padding: 8px 8px 4px; }
  .workbook__chart-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 4px; font-family: var(--font-mono); font-size: 6px; font-weight: 800; color: #6e7c74; }
  .workbook__chart-head i { width: 28px; height: 4px; border-radius: 999px; background: #d8eee1; }
  .workbook__chart svg { display: block; width: 100%; height: 75px; }
  .workbook__decisions { padding: 8px; }
  .workbook__decisions > span { font-family: var(--font-mono); font-size: 6px; font-weight: 800; letter-spacing: .06em; color: #6e7c74; }
  .workbook__decisions ul { display: grid; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }
  .workbook__decisions li { display: grid; grid-template-columns: 7px 1fr; gap: 1px 5px; align-items: center; padding-bottom: 6px; border-bottom: 1px solid #edf1ef; }
  .workbook__decisions li:last-child { border-bottom: 0; }
  .workbook__decisions i { grid-row: span 2; width: 6px; height: 6px; border-radius: 50%; }
  .workbook__decisions i.good { background: #107c41; box-shadow: 0 0 0 2px #e0f2e7; }
  .workbook__decisions i.warn { background: #c48616; box-shadow: 0 0 0 2px #f9edcf; }
  .workbook__decisions b { font-size: 7px; color: #26372e; }
  .workbook__decisions em { grid-column: 2; font-style: normal; font-size: 6px; color: #829087; }
  .workbook__tabs { display: flex; align-items: center; gap: 2px; height: 26px; padding: 0 8px; border-top: 1px solid #dfe7e2; background: #f3f5f4; }
  .workbook__tabs span { height: 18px; padding: 0 7px; border-radius: 4px 4px 0 0; font-family: var(--font-mono); font-size: 6px; line-height: 18px; color: #6f7c74; }
  .workbook__tabs span.is-active { background: #fff; color: #0c6e3e; box-shadow: inset 0 -2px #107c41; }
  .workbook__tabs b { margin-left: auto; font-size: 11px; font-weight: 400; color: #708078; }
  .catalog-hero__badge { position: absolute; right: -2px; bottom: -8px; display: flex; align-items: center; gap: 7px; padding: 6px 10px; border: 1px solid #d6e3da; border-radius: 10px; background: rgba(255,255,255,.98); box-shadow: 0 8px 18px rgba(18,55,34,.1); }
  .catalog-hero__badge > span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; background: #e6f4eb; color: #0c6e3e; font-size: 10px; font-weight: 800; }
  .catalog-hero__badge div { display: grid; gap: 1px; }
  .catalog-hero__badge b { font-size: 8px; color: #23352b; }
  .catalog-hero__badge small { font-size: 6.5px; color: #7a887f; }

  @media (max-width: 960px) {
    .catalog-hero__grid { grid-template-columns: 1fr; gap: 20px; }
    .catalog-hero__copy { max-width: 100%; }
    .catalog-hero__visual { display: none; }
  }
  @media (max-width: 620px) {
    .catalog-hero { padding-block: 20px 18px; }
    .catalog-hero__title { margin-top: 10px; font-size: 24px; }
    .catalog-hero__lead { margin-top: 8px; font-size: 13px; }
    .catalog-hero__actions { margin-top: 14px; }
    .catalog-hero__primary,
    .catalog-hero__secondary { width: 100%; min-height: 36px; }
    .catalog-hero__stats { margin-top: 16px; }
    .catalog-hero__stats div { min-width: 80px; padding: 0 10px; }
  }
</style>
