---
interface Props { slug: string; name: string; compact?: boolean; }
const { slug, name, compact = false } = Astro.props;

type Theme = {
  eyebrow: string; sheet: string; labels: [string,string,string,string]; metrics: [string,string,string,string];
  accent: string; accent2: string; accent3: string; accent4: string; tint: string; family: string;
};

const themes: Record<string, Partial<Theme>> = {
  '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi': { eyebrow:'13 HAFTALIK NAKİT', sheet:'NAKİT AKIŞI', labels:['GİRİŞ','ÇIKIŞ','NET','MİN. NAKİT'], metrics:['₺3,45M','₺2,43M','₺1,02M','₺210K'], family:'cashflow' },
  'akilli-kasa-defteri-ve-nakit-kontrol-sistemi': { eyebrow:'KASA KONTROL', sheet:'KASA DEFTERİ', labels:['BAKİYE','GÜNLÜK GİRİŞ','GÜNLÜK ÇIKIŞ','FARK'], metrics:['₺56.890','₺18.250','₺12.480','₺6.590'], family:'cashbook' },
  'aylik-patron-finans-paneli': { eyebrow:'PATRON FİNANS', sheet:'YÖNETİM PANELİ', labels:['CİRO','NET KÂR','MARJ','NAKİT'], metrics:['₺2,45M','₺630K','%25,7','₺1,12M'], family:'executive' },
  'banka-kredi-ve-taksit-takip-sistemi': { eyebrow:'BORÇ & TAKSİT', sheet:'ÖDEME PLANI', labels:['BORÇ','KALAN','TAKSİT','GECİKEN'], metrics:['₺2,24M','₺1,42M','₺95K','₺20K'], family:'debt' },
  'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi': { eyebrow:'CARİ RİSK', sheet:'ALACAK YAŞLANDIRMA', labels:['ALACAK','VADESİ GEÇEN','TAHSİLAT','VADE'], metrics:['₺3,12M','₺620K','%78,5','45 gün'], family:'receivables' },
  'cek-senet-ve-vade-risk-sistemi': { eyebrow:'VADE RİSKİ', sheet:'VADE TAKVİMİ', labels:['EVRAK','TOPLAM','YAKLAŞAN','GEÇEN'], metrics:['125','₺1,85M','₺320K','₺85K'], family:'maturity' },
  'gunluk-gelir-gider-ve-gercek-karlilik-sistemi': { eyebrow:'GERÇEK KÂRLILIK', sheet:'KÂR KÖPRÜSÜ', labels:['GELİR','GİDER','NET KÂR','MARJ'], metrics:['₺985K','₺742K','₺243K','%24,7'], family:'profit' },
  'kobi-finans-yonetim-paketi': { eyebrow:'KOBİ FİNANS', sheet:'FİNANS MERKEZİ', labels:['KASA','BANKA','CARİ','POS'], metrics:['₺7.900','₺83.500','₺214K','₺415K'], family:'suite' },
  'pos-komisyon-ve-net-tahsilat-kontrol-sistemi': { eyebrow:'POS MUTABAKAT', sheet:'POS KONTROL', labels:['BRÜT','KOMİSYON','NET','FARK'], metrics:['₺684K','₺17,8K','₺666K','₺2,4K'], family:'pos' },
  'proje-ve-is-bazinda-gercek-karlilik-sistemi': { eyebrow:'PROJE KÂRLILIĞI', sheet:'PROJE MATRİSİ', labels:['PROJE','CİRO','MARJ','RİSK'], metrics:['8','₺4,8M','%31,4','2'], family:'project' },
  'stok-satis-ve-nakit-baglanma-sistemi': { eyebrow:'STOK & NAKİT', sheet:'STOK HAREKETİ', labels:['SKU','STOK DEĞERİ','DEVİR','KRİTİK'], metrics:['2.450','₺1,24M','3,2','18'], family:'stock' },
  'vergi-sgk-ve-maas-karsilik-ayirma-sistemi': { eyebrow:'VERGİ · SGK · MAAŞ', sheet:'BORDRO YÜKÜ', labels:['MAAŞ','SGK','VERGİ','PERSONEL'], metrics:['₺286K','₺91K','₺62K','24'], family:'payroll' },
  'ithalat-depo-teslim-rafa-gelen-net-birim-maliyet': { eyebrow:'İTHALAT MALİYETİ', sheet:'MALİYET KÖPRÜSÜ', labels:['FOB','CIF','RAFA GELEN','BİRİM'], metrics:['$42,5K','$47,8K','₺1,83M','₺457'], family:'import' },
  'kacirilan-sgk-tesvikleri-ve-gercek-iscilik-maliyeti-analizi': { eyebrow:'SGK TEŞVİK', sheet:'TEŞVİK MATRİSİ', labels:['İŞÇİLİK','TEŞVİK','NET','KAZANIM'], metrics:['₺184K','₺71K','₺113K','%38,6'], family:'sgk' },
  'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici': { eyebrow:'KIDEM · İHBAR', sheet:'PERSONEL YÜKÜ', labels:['KIDEM','İHBAR','İZİN','TOPLAM'], metrics:['₺492K','₺137K','₺48K','₺677K'], family:'severance' },
  'asgari-ucret-zam-etkisi-fiyat-ayarlama-cetveli': { eyebrow:'ZAM ETKİSİ', sheet:'FİYAT AYARLAMA', labels:['ÜCRET','MALİYET','FİYAT','MARJ'], metrics:['%24,8','%14,2','%9,6','%22,1'], family:'wage' },
  'fazla-mesai-ve-isci-dava-riski-tespit-dosyasi': { eyebrow:'FAZLA MESAİ RİSKİ', sheet:'MESAİ TAKVİMİ', labels:['SAAT','PERSONEL','YÜKSEK RİSK','KARŞILIK'], metrics:['428','17','5','₺186K'], family:'overtime' },
  'ihaleye-kac-tl-teklif-vermeliyim': { eyebrow:'TEKLİF KARAR MOTORU', sheet:'TEKLİF BANDI', labels:['TABAN','HEDEF','TEKLİF','MARJ'], metrics:['₺7,61M','₺8,05M','₺8,42M','%11,8'], family:'tender' },
  'asiri-dusuk-teklif-savunma-robotu': { eyebrow:'SAVUNMA ROBOTU', sheet:'KANIT DOSYASI', labels:['KALEM','KANIT','TAMLIK','RİSK'], metrics:['14','9','%96','2'], family:'defense' },
  'hakedis-fiyat-farki-hak-kaybi-cetveli': { eyebrow:'HAKEDİŞ FARKI', sheet:'ENDEKS KÖPRÜSÜ', labels:['HAKEDİŞ','FİYAT FARKI','KAYIP','TAHSİL'], metrics:['₺3,28M','₺214K','₺63K','₺151K'], family:'progress' },
  'yillara-sari-insaat-stopaj-nakit-akis-planlayici': { eyebrow:'STOPAJ NAKİT', sheet:'STOPAJ TAKVİMİ', labels:['TAHAKKUK','STOPAJ','NET','DÖNEM'], metrics:['₺12,8M','₺640K','₺12,16M','18 ay'], family:'withholding' },
  'taseron-hakedis-kesinti-mutabakati': { eyebrow:'TAŞERON MUTABAKAT', sheet:'KESİNTİ CETVELİ', labels:['BRÜT','KESİNTİ','NET','FARK'], metrics:['₺2,14M','₺186K','₺1,95M','₺4,8K'], family:'subcontract' },
  'amortisman-ve-sabit-kiymet-satis-zamanlama-stratejisti': { eyebrow:'AMORTİSMAN', sheet:'SATIŞ ZAMANLAMA', labels:['NET DEFTER','SATIŞ','VERGİ','DÖNEM'], metrics:['₺2,86M','₺3,42M','₺614K','Q4'], family:'asset' },
  'doviz-acik-pozisyonu-ve-kur-riski-stres-testi': { eyebrow:'KUR RİSK STRESİ', sheet:'DÖVİZ SENARYOLARI', labels:['USD AÇIK','EUR AÇIK','STRES','VAR'], metrics:['$482K','€215K','₺3,7M','%14,2'], family:'fx' },
  'kdv-iadesi-azami-alacak-hesabi-dosya-hazirlayici': { eyebrow:'KDV İADE', sheet:'İADE KONTROLÜ', labels:['TEORİK','AZAMİ','DOSYA','EKSİK'], metrics:['₺1,42M','₺1,18M','14','3'], family:'vat' },
  'kkeg-ve-finansman-gider-kisitlamasi-vergi-savunma-seti': { eyebrow:'KKEG · FGK', sheet:'VERGİ SAVUNMA', labels:['FİN. GİDER','KISIT','MATRAH','KANIT'], metrics:['₺864K','₺216K','₺648K','12'], family:'taxdefense' },
  'mutfak-kayip-kacak-hesaplayici': { eyebrow:'MUTFAK FİRE', sheet:'REÇETE VARYANSI', labels:['HAMMADDE','FİRE','KAYIP','MARJ'], metrics:['₺286K','%8,4','₺24K','%31'], family:'kitchen' },
  'nakliye-maliyeti-hesaplayici': { eyebrow:'NAKLİYE MALİYETİ', sheet:'SEFER MALİYETİ', labels:['KM','YAKIT','TONAJ','SEFER'], metrics:['1.280','₺14,2K','18 ton','₺36,6K'], family:'logistics' },
  'ortaklar-cari-ve-kasa-adat-faiz-faturasi-hesaplayici': { eyebrow:'ADAT FAİZ', sheet:'ADAT HESABI', labels:['BAKİYE','FAİZ','KDV','FATURA'], metrics:['₺1,12M','₺94K','₺18,8K','₺112,8K'], family:'adat' },
  'pazaryeri-net-kar-ve-eksik-hakedis-yakalayici': { eyebrow:'PAZARYERİ KÂR', sheet:'HAKEDİŞ MUTABAKAT', labels:['SATIŞ','KESİNTİ','NET','EKSİK'], metrics:['₺742K','₺128K','₺614K','₺41K'], family:'marketplace' },
  'sirket-oz-kaynagi-eridi-mi-ttk-376-sermaye-tamamlama-cetveli': { eyebrow:'TTK 376', sheet:'SERMAYE TESTİ', labels:['SERMAYE','ÖZ KAYNAK','KAYIP','EŞİK'], metrics:['₺6,4M','₺2,1M','%67','2/3'], family:'capital' },
  'sube-karlilik-ve-nakit-hesaplayici': { eyebrow:'ŞUBE KÂRLILIĞI', sheet:'ŞUBE MATRİSİ', labels:['ŞUBE','CİRO','MARJ','NEGATİF'], metrics:['8','₺6,2M','%18,6','2'], family:'branch' },
  'uretim-recetesi-ve-zam-yansitma-hesaplayici': { eyebrow:'ÜRETİM REÇETESİ', sheet:'REÇETE MALİYETİ', labels:['BİRİM','GİRDİ ZAMMI','FİYAT ETKİSİ','FİRE'], metrics:['₺128,4','%17,2','%11,6','%3,1'], family:'recipe' },
  'vergi-sgk-borcunu-tecil-etmeli-miyim-kredi-mi-tecil-mi': { eyebrow:'KREDİ Mİ TECİL Mİ', sheet:'FİNANSMAN KIYASI', labels:['BORÇ','KREDİ','TECİL','FARK'], metrics:['₺1,8M','₺312K','₺246K','₺66K'], family:'financing' },
  'yeniden-degerleme-yapmali-miyim-vergi-tasarruf-analizi': { eyebrow:'YENİDEN DEĞERLEME', sheet:'DEĞERLEME KARARI', labels:['YENİ DEĞER','ARTIŞ','VERGİ','TASARRUF'], metrics:['₺12,4M','₺3,1M','₺740K','₺2,36M'], family:'revaluation' },
};

const paletteByFamily: Record<string,[string,string,string,string,string]> = {
  cashflow:['#0d8a4b','#2563eb','#f59e0b','#e5484d','#f2fbf6'], cashbook:['#0f766e','#2563eb','#f59e0b','#e5484d','#f0fdfa'], executive:['#166534','#7c3aed','#f59e0b','#2563eb','#f5f3ff'], debt:['#2563eb','#f97316','#e5484d','#16a34a','#eff6ff'], receivables:['#0f766e','#f59e0b','#e5484d','#2563eb','#f0fdfa'], maturity:['#b42318','#f97316','#f59e0b','#0f766e','#fff7ed'], profit:['#15803d','#2563eb','#f59e0b','#dc2626','#f0fdf4'], suite:['#075985','#15803d','#7c3aed','#f59e0b','#eff6ff'], pos:['#7c3aed','#2563eb','#16a34a','#f97316','#faf5ff'], project:['#0369a1','#16a34a','#f59e0b','#e5484d','#f0f9ff'], stock:['#7c3aed','#2563eb','#16a34a','#f59e0b','#faf5ff'], payroll:['#0891b2','#7c3aed','#16a34a','#f59e0b','#ecfeff'], import:['#0e7490','#2563eb','#f59e0b','#e5484d','#ecfeff'], sgk:['#15803d','#f59e0b','#2563eb','#7c3aed','#f0fdf4'], severance:['#9a3412','#e5484d','#f59e0b','#2563eb','#fff7ed'], wage:['#a16207','#f97316','#2563eb','#16a34a','#fffbeb'], overtime:['#9f1239','#e5484d','#f59e0b','#2563eb','#fff1f2'], tender:['#1d4ed8','#0f766e','#f59e0b','#e5484d','#eff6ff'], defense:['#5b21b6','#2563eb','#e5484d','#f59e0b','#f5f3ff'], progress:['#0f766e','#2563eb','#f59e0b','#e5484d','#f0fdfa'], withholding:['#854d0e','#f59e0b','#2563eb','#16a34a','#fffbeb'], subcontract:['#475569','#2563eb','#f59e0b','#16a34a','#f8fafc'], asset:['#475569','#0f766e','#f59e0b','#2563eb','#f8fafc'], fx:['#1d4ed8','#0f766e','#e5484d','#f59e0b','#eff6ff'], vat:['#7c3aed','#2563eb','#16a34a','#f59e0b','#faf5ff'], taxdefense:['#6b21a8','#e5484d','#f59e0b','#2563eb','#faf5ff'], kitchen:['#b45309','#e5484d','#16a34a','#2563eb','#fff7ed'], logistics:['#0369a1','#f97316','#16a34a','#e5484d','#f0f9ff'], adat:['#475569','#2563eb','#f59e0b','#e5484d','#f8fafc'], marketplace:['#7c3aed','#f97316','#2563eb','#16a34a','#faf5ff'], capital:['#991b1b','#e5484d','#f59e0b','#2563eb','#fff1f2'], branch:['#0f766e','#2563eb','#16a34a','#f59e0b','#f0fdfa'], recipe:['#4d7c0f','#f59e0b','#f97316','#2563eb','#f7fee7'], financing:['#1e40af','#7c3aed','#f59e0b','#16a34a','#eff6ff'], revaluation:['#166534','#0f766e','#f59e0b','#2563eb','#f0fdf4']
};

const fallback: Theme = { eyebrow:'EXCEL KARAR SİSTEMİ', sheet:'YÖNETİM PANELİ', labels:['TOPLAM','KONTROL','SONUÇ','RİSK'], metrics:['CANLI','OTOMATİK','HAZIR','İZLE'], accent:'#107c41', accent2:'#2563eb', accent3:'#f59e0b', accent4:'#e5484d', tint:'#f4faf6', family:'generic' };
const partial = themes[slug] ?? {};
const family = partial.family ?? 'generic';
const palette = paletteByFamily[family] ?? [fallback.accent,fallback.accent2,fallback.accent3,fallback.accent4,fallback.tint];
const config: Theme = { ...fallback, ...partial, accent:palette[0], accent2:palette[1], accent3:palette[2], accent4:palette[3], tint:palette[4], family };
let hash = 0; for (const ch of slug) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const chartTypes = ['cluster-bars', 'spark-area', 'waterfall-flow', 'stacked-metrics'] as const;
const chartType = chartTypes[hash % chartTypes.length];
const gradId = `pv-grad-${slug.slice(0, 10)}-${hash % 997}`;
---

<div class={`product-visual pv-family-${config.family}${compact ? ' is-compact' : ''}`} style={`--pv-a:${config.accent};--pv-b:${config.accent2};--pv-c:${config.accent3};--pv-d:${config.accent4};--pv-tint:${config.tint}`} aria-label={`${name} ürününe özel Excel önizlemesi`}>
  <div class="pv-card-window">
    <div class="pv-header">
      <div class="pv-window-dots" aria-hidden="true">
        <span class="dot dot-close"></span>
        <span class="dot dot-min"></span>
        <span class="dot dot-max"></span>
      </div>
      <div class="pv-badge-pill">{config.eyebrow}</div>
      <span class="pv-file-name">{name.slice(0,26)}.xlsx</span>
    </div>

    <div class="pv-kpi-grid">
      {config.labels.map((label, i) => (
        <div class={`pv-kpi-box pv-kpi-${i}`}>
          <span class="pv-kpi-label">{label}</span>
          <strong class="pv-kpi-val">{config.metrics[i]}</strong>
        </div>
      ))}
    </div>

    {!compact && (
      <div class="pv-body">
        <div class="pv-chart-card">
          <div class="pv-chart-top">
            <span class="pv-sheet-title">{config.sheet} ANALİZİ</span>
            <div class="pv-chart-badge-group">
              <span class="pv-live-pill">Otomatik</span>
              <div class="pv-chart-dots" aria-hidden="true">
                <i style="background:#107c41;"></i>
                <i style="background:#0284c7;"></i>
                <i style="background:#f59e0b;"></i>
                <i style="background:#e11d48;"></i>
              </div>
            </div>
          </div>

          <div class="pv-chart-render-zone" aria-hidden="true">
            {chartType === 'cluster-bars' && (
              <svg viewBox="0 0 160 48" class="pv-chart-svg" fill="none">
                <line x1="0" y1="42" x2="160" y2="42" stroke="#edf2ee" stroke-width="1" />
                <line x1="0" y1="24" x2="160" y2="24" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="2 2" />
                <!-- Çok Renkli Barlar: Yeşil, Mavi, Sarı, Kırmızı varyasyonları -->
                <rect x="8" y={42 - (20 + (hash % 16))} width="11" height={20 + (hash % 16)} fill="#107c41" rx="2" />
                <rect x="23" y={42 - (15 + ((hash >> 1) % 18))} width="11" height={15 + ((hash >> 1) % 18)} fill="#0284c7" rx="2" />
                <rect x="38" y={42 - (24 + ((hash >> 2) % 15))} width="11" height={24 + ((hash >> 2) % 15)} fill="#f59e0b" rx="2" />
                <rect x="53" y={42 - (12 + ((hash >> 3) % 14))} width="11" height={12 + ((hash >> 3) % 14)} fill="#e11d48" rx="2" />
                <rect x="68" y={42 - (28 + ((hash >> 4) % 12))} width="11" height={28 + ((hash >> 4) % 12)} fill="#107c41" rx="2" />
                <rect x="83" y={42 - (34 + ((hash >> 1) % 7))} width="11" height={34 + ((hash >> 1) % 7)} fill="#0284c7" rx="2" />
                <rect x="98" y={42 - (18 + ((hash >> 3) % 15))} width="11" height={18 + ((hash >> 3) % 15)} fill="#f59e0b" rx="2" />
                <rect x="113" y={42 - (30 + ((hash >> 2) % 10))} width="11" height={30 + ((hash >> 2) % 10)} fill="#107c41" rx="2" />
                <rect x="128" y={42 - (22 + (hash % 14))} width="11" height={22 + (hash % 14)} fill="#0284c7" rx="2" />
                <rect x="143" y={42 - (14 + ((hash >> 4) % 12))} width="11" height={14 + ((hash >> 4) % 12)} fill="#e11d48" rx="2" />
              </svg>
            )}

            {chartType === 'spark-area' && (
              <svg viewBox="0 0 160 48" class="pv-chart-svg" fill="none">
                <defs>
                  <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0284c7" stop-opacity="0.32" />
                    <stop offset="100%" stop-color="#107c41" stop-opacity="0.02" />
                  </linearGradient>
                </defs>
                <line x1="0" y1="42" x2="160" y2="42" stroke="#edf2ee" stroke-width="1" />
                <path d={`M 5 36 Q 35 ${16 + (hash % 14)}, 65 ${26 - (hash % 10)} T 115 ${14 + ((hash >> 2) % 12)} T 155 ${8 + ((hash >> 3) % 8)} L 155 42 L 5 42 Z`} fill={`url(#${gradId})`} />
                <path d={`M 5 36 Q 35 ${16 + (hash % 14)}, 65 ${26 - (hash % 10)} T 115 ${14 + ((hash >> 2) % 12)} T 155 ${8 + ((hash >> 3) % 8)}`} stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" />
                <!-- 3 Renkli Karar Noktaları -->
                <circle cx="35" cy={16 + (hash % 14)} r="2.8" fill="#f59e0b" />
                <circle cx="65" cy={26 - (hash % 10)} r="2.8" fill="#e11d48" />
                <circle cx="115" cy={14 + ((hash >> 2) % 12)} r="2.8" fill="#107c41" />
                <circle cx="155" cy={8 + ((hash >> 3) % 8)} r="3.2" fill="#0284c7" stroke="#ffffff" stroke-width="1" />
              </svg>
            )}

            {chartType === 'waterfall-flow' && (
              <svg viewBox="0 0 160 48" class="pv-chart-svg" fill="none">
                <line x1="0" y1="42" x2="160" y2="42" stroke="#edf2ee" stroke-width="1" />
                <!-- 1. Başlangıç (Yeşil) -->
                <rect x="8" y="14" width="16" height="28" fill="#107c41" rx="2" />
                <line x1="24" y1="14" x2="36" y2="14" stroke="#94a3b8" stroke-dasharray="2 1.5" />
                <!-- 2. Maliyet / Düşüş (Kırmızı) -->
                <rect x="36" y="14" width="16" height="12" fill="#e11d48" rx="2" />
                <line x1="52" y1="26" x2="64" y2="26" stroke="#94a3b8" stroke-dasharray="2 1.5" />
                <!-- 3. Operasyonel Gider (Kırmızı) -->
                <rect x="64" y="26" width="16" height="8" fill="#e11d48" rx="2" />
                <line x1="80" y1="34" x2="92" y2="34" stroke="#94a3b8" stroke-dasharray="2 1.5" />
                <!-- 4. Vergi / Teşvik Düzeltmesi (Sarı) -->
                <rect x="92" y="28" width="16" height="6" fill="#f59e0b" rx="2" />
                <line x1="108" y1="28" x2="120" y2="28" stroke="#94a3b8" stroke-dasharray="2 1.5" />
                <!-- 5. Diğer Gelir (Mavi) -->
                <rect x="120" y="20" width="16" height="8" fill="#0284c7" rx="2" />
                <line x1="136" y1="20" x2="140" y2="20" stroke="#94a3b8" stroke-dasharray="2 1.5" />
                <!-- 6. Net Sonuç (Koyu Yeşil / Mavi) -->
                <rect x="140" y="18" width="14" height="24" fill="#107c41" rx="2" />
              </svg>
            )}

            {chartType === 'stacked-metrics' && (
              <svg viewBox="0 0 160 48" class="pv-chart-svg" fill="none">
                <line x1="0" y1="42" x2="160" y2="42" stroke="#edf2ee" stroke-width="1" />
                <!-- Kolon 1 -->
                <rect x="10" y="28" width="18" height="14" fill="#107c41" rx="1.5" />
                <rect x="10" y="18" width="18" height="9" fill="#0284c7" rx="1.5" />
                <rect x="10" y="12" width="18" height="5" fill="#f59e0b" rx="1.5" />
                <!-- Kolon 2 -->
