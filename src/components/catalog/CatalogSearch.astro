---
interface CatalogCommandItem {
  name: string;
  summary: string;
  category: string;
  categorySlug: string;
  url: string;
  priceTL: number;
}

interface Props {
  items?: CatalogCommandItem[];
}

const { items = [] } = Astro.props;
---

<div class="catalog-search" data-catalog-command>
  <div class="catalog-search__topline">
    <span class="catalog-search__eyebrow">AKILLI KATALOG ARAMASI</span>
    <span class="catalog-search__shortcut">⌘K</span>
  </div>

  <div class="catalog-search__control">
    <span class="catalog-search__leading" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </span>
    <div class="catalog-search__field">
      <label for="catalog-search-input">İhtiyacınızı, sorununuzu veya ürün adını yazın</label>
      <input
        id="catalog-search-input"
        type="search"
        class="catalog-search__input"
        data-catalog-search
        name="q"
        placeholder="Örn. nakit akışı, cari, stok, kârlılık, amortisman…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="catalog-command-results"
      />
    </div>
    <button type="button" class="catalog-search__clear" data-catalog-search-clear hidden aria-label="Aramayı temizle">×</button>
    <span class="catalog-search__send" aria-hidden="true">↗</span>
  </div>

  <div class="catalog-search__panel" data-catalog-command-panel hidden>
    <div class="catalog-search__panel-head">
      <div><strong>Önerilen sistemler</strong><span>En yakın eşleşmeler</span></div>
      <span data-catalog-command-count></span>
    </div>
    <ul class="catalog-search__results" id="catalog-command-results" data-catalog-command-results></ul>
    <div class="catalog-search__panel-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> gezin</span>
      <span><kbd>Enter</kbd> aç</span>
      <span><kbd>Esc</kbd> kapat</span>
    </div>
  </div>
</div>

<script type="application/json" id="catalog-command-index" set:html={JSON.stringify(items)}></script>
<script>
  import { searchEngine, type SearchItem } from '../../lib/search-engine';

  type CatalogCommandItem = SearchItem & {
    priceTL: number;
  };

  const root = document.querySelector<HTMLElement>('[data-catalog-command]');
  const input = root?.querySelector<HTMLInputElement>('[data-catalog-search]');
  const panel = root?.querySelector<HTMLElement>('[data-catalog-command-panel]');
  const list = root?.querySelector<HTMLUListElement>('[data-catalog-command-results]');
  const count = root?.querySelector<HTMLElement>('[data-catalog-command-count]');
  const clear = root?.querySelector<HTMLButtonElement>('[data-catalog-search-clear]');
  const indexEl = document.getElementById('catalog-command-index');

  const escapeHtml = (value: string) => value
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#39;');

  const collectFromCards = (): CatalogCommandItem[] =>
    [...document.querySelectorAll<HTMLElement>('[data-template-card]')].map((card) => {
      const detailLink = card.querySelector<HTMLAnchorElement>('.card__title a, .card__frame');
      const rawPrice = card.querySelector<HTMLElement>('.card__price-value')?.textContent ?? '0';
      const numericPrice = Number((rawPrice.match(/[\d.]+/g)?.join('') ?? '0').replaceAll('.', '')) || 0;
      return {
        name: card.dataset.name ?? card.getAttribute('aria-label') ?? 'Excel Sistemi',
        summary: card.dataset.summary ?? '',
        category: card.dataset.categoryLabel ?? 'Excel Sistemi',
        categorySlug: card.dataset.category ?? '',
        url: detailLink?.getAttribute('href') ?? '/sablonlar',
        priceTL: numericPrice,
      };
    });

  if (root && input && panel && list && indexEl) {
    const provided = JSON.parse(indexEl.textContent ?? '[]') as CatalogCommandItem[];
    const items = provided.length ? provided : collectFromCards();
    let activeIndex = -1;

    const open = () => {
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    };

    const renderCardList = (displayItems: CatalogCommandItem[]): string =>
      displayItems.map((item, index) => `
        <li class="catalog-command__item">
          <a class="catalog-command__card" href="${escapeHtml(item.url)}" data-command-index="${index}">
            <span class="catalog-command__icon" aria-hidden="true">XL</span>
            <span class="catalog-command__body">
              <span class="catalog-command__title-row">
                <strong class="catalog-command__title">${escapeHtml(item.name)}</strong>
                ${item.priceTL > 0 ? `<span class="catalog-command__price">${new Intl.NumberFormat('tr-TR').format(item.priceTL)} TL</span>` : ''}
              </span>
              <span class="catalog-command__summary">${escapeHtml(item.summary)}</span>
              <span class="catalog-command__badges">
                <span class="catalog-command__badge catalog-command__badge--type">ÜRÜN</span>
                <span class="catalog-command__badge">${escapeHtml(item.category)}</span>
              </span>
            </span>
            <span class="catalog-command__arrow" aria-hidden="true">→</span>
          </a>
        </li>`).join('');

    const render = () => {
      const query = input.value.trim();
      const response = searchEngine(items, query, { limit: 6 });
      const { results, didYouMean, suggestedItems } = response;
      const matched = results as CatalogCommandItem[];
      const suggested = suggestedItems as CatalogCommandItem[];

      activeIndex = -1;
      let html = '';

      if (didYouMean) {
        html += `
          <li class="catalog-command__suggestion-item">
            <button type="button" class="catalog-command__did-you-mean" data-catalog-suggest="${escapeHtml(didYouMean)}">
              <span class="catalog-command__dym-label">Bunu mu demek istediniz?</span>
              <strong class="catalog-command__dym-term">“${escapeHtml(didYouMean)}”</strong>
              <span class="catalog-command__dym-action">Düzelt ↵</span>
            </button>
          </li>
        `;
      }

      if (matched.length > 0) {
        if (count) count.textContent = `${matched.length} sonuç`;
        html += renderCardList(matched);
      } else if (suggested.length > 0) {
        if (count) count.textContent = `${suggested.length} yakın eşleşme`;
        html += `
          <li class="catalog-command__info-banner">
            <span>“<strong>${escapeHtml(query)}</strong>” için tam eşleşme bulunamadı. En yakın ilgili sistemler:</span>
          </li>
        `;
        html += renderCardList(suggested);
      } else {
        if (count) count.textContent = '0 sonuç';
        html += `<li class="catalog-command__empty"><strong>Sonuç bulunamadı</strong><span>Başka bir anahtar kelime deneyin veya kategori filtresini kullanın.</span></li>`;
      }

      list.innerHTML = html;

      const suggestBtn = list.querySelector<HTMLButtonElement>('[data-catalog-suggest]');
      if (suggestBtn) {
        suggestBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const term = suggestBtn.dataset.catalogSuggest;
          if (term) {
            input.value = term;
            render();
            input.focus();
          }
        });
      }

      open();
    };

    const setActive = (next: number) => {
      const links = [...list.querySelectorAll<HTMLAnchorElement>('[data-command-index]')];
      if (!links.length) return;
      activeIndex = (next + links.length) % links.length;
      links.forEach((link, index) => link.classList.toggle('is-active', index === activeIndex));
      links[activeIndex]?.scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('focus', render);
    input.addEventListener('input', () => {
      root.classList.toggle('has-query', input.value.trim().length > 0);
      render();
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { event.preventDefault(); close(); input.blur(); return; }
      if (event.key === 'ArrowDown') { event.preventDefault(); setActive(activeIndex + 1); return; }
      if (event.key === 'ArrowUp') { event.preventDefault(); setActive(activeIndex - 1); return; }
      if (event.key === 'Enter' && activeIndex >= 0) {
        const active = list.querySelector<HTMLAnchorElement>('.is-active');
        if (active) { event.preventDefault(); window.location.href = active.href; }
      }
    });
    clear?.addEventListener('click', () => { close(); });
    document.addEventListener('click', (event) => { if (!root.contains(event.target as Node)) close(); });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        input.focus();
        input.select();
      }
    });
  }
</script>

<style>
  :global(.catalog-command__search){max-width:920px!important}
  .catalog-search{position:relative;isolation:isolate}
  .catalog-search__topline{display:flex;align-items:center;justify-content:space-between;margin:0 4px 8px}
  .catalog-search__eyebrow{font:800 11px/1.2 var(--font-mono)!important;letter-spacing:.1em;color:#166534!important}
  .catalog-search__shortcut{display:inline-flex;align-items:center;justify-content:center;height:26px;min-width:38px;padding:0 9px;border:1px solid #dbe4de;border-radius:8px;background:#f8faf8;font:700 11px/1 var(--font-mono)!important;color:#68766e!important}
  .catalog-search__control{display:grid;grid-template-columns:28px minmax(0,1fr) auto 44px;align-items:center;gap:10px;min-height:76px;padding:8px 10px 8px 18px;border:1px solid rgba(16,124,65,.2);border-radius:20px;background:rgba(255,255,255,.99);box-shadow:0 16px 40px rgba(20,54,35,.09),0 2px 8px rgba(20,54,35,.04);transition:.18s ease}
  .catalog-search:focus-within .catalog-search__control{border-color:rgba(16,124,65,.45);box-shadow:0 22px 54px rgba(20,54,35,.13),0 0 0 4px rgba(16,124,65,.07);transform:translateY(-1px)}
  .catalog-search__leading{display:grid;place-items:center;color:#168348}
  .catalog-search__field{display:grid;gap:4px;min-width:0}
  .catalog-search__field label{font:700 12px/1.2 var(--font-body)!important;color:#536158!important}
  .catalog-search__input{width:100%;height:34px;padding:0;border:0;outline:0;background:transparent;font:650 17px/1.3 var(--font-body)!important;color:#15251b!important;appearance:none}
  .catalog-search__input::placeholder{color:#89958e!important;font-weight:450!important;opacity:1}
  .catalog-search__input::-webkit-search-cancel-button{display:none}
  .catalog-search__clear{display:grid;place-items:center;width:34px;height:34px;padding:0;border:1px solid #e0e6e2;border-radius:10px;background:#f7f9f7;color:#69776f;font-size:20px;line-height:1;cursor:pointer}.catalog-search__clear[hidden]{display:none}
  .catalog-search__send{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:#168348;color:#fff;font:800 18px/1 var(--font-body)!important;box-shadow:0 8px 18px rgba(22,131,72,.22);transition:.18s ease}
  .catalog-search.has-query .catalog-search__send{transform:rotate(45deg)}
  .catalog-search__panel{position:absolute;top:112px;left:0;right:0;z-index:80;overflow:hidden;border:1px solid #dbe3de;border-radius:20px;background:rgba(255,255,255,.995);box-shadow:0 28px 70px rgba(15,23,42,.19),0 8px 24px rgba(15,23,42,.08);animation:catalogPanelIn .16s ease both}.catalog-search__panel[hidden]{display:none}@keyframes catalogPanelIn{from{opacity:0;transform:translateY(-7px) scale(.992)}to{opacity:1;transform:none}}
  .catalog-search__panel-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px 11px;border-bottom:1px solid #edf1ee;background:linear-gradient(180deg,#fff,#fbfcfb)}
  .catalog-search__panel-head>div{display:grid;gap:2px}.catalog-search__panel-head strong{font:800 14px/1.2 var(--font-body)!important;color:#14251a!important}.catalog-search__panel-head span{font:600 11px/1.2 var(--font-body)!important;color:#849088!important}.catalog-search__panel-head>[data-catalog-command-count]{padding:6px 9px;border:1px solid #dfe8e2;border-radius:999px;background:#f3f8f5;font:800 10px/1 var(--font-mono)!important;color:#166534!important}
  .catalog-search__results{max-height:430px;margin:0!important;padding:9px!important;overflow-y:auto;list-style:none!important;scrollbar-width:thin;scrollbar-color:#cfd8d2 transparent}
  :global(.catalog-command__item){margin:0!important;padding:0!important;list-style:none!important}
  :global(.catalog-command__card){display:grid!important;grid-template-columns:46px minmax(0,1fr) 28px!important;align-items:center!important;gap:13px!important;margin:0 0 7px!important;padding:13px!important;border:1px solid transparent!important;border-radius:14px!important;background:#fff!important;color:#17251c!important;text-decoration:none!important;transition:background .14s ease,border-color .14s ease,box-shadow .14s ease,transform .14s ease!important}
  :global(.catalog-command__card:hover),:global(.catalog-command__card.is-active){background:linear-gradient(135deg,#f4faf6,#eef8f2)!important;border-color:#c9e5d4!important;box-shadow:0 8px 22px rgba(21,94,52,.08)!important;transform:translateX(2px)!important}
  :global(.catalog-command__icon){display:grid!important;place-items:center!important;width:44px!important;height:44px!important;border-radius:12px!important;background:linear-gradient(145deg,#168348,#0f6b39)!important;color:#fff!important;font:850 11px/1 var(--font-mono)!important;box-shadow:0 7px 16px rgba(16,124,65,.18)!important}
  :global(.catalog-command__body){display:grid!important;gap:5px!important;min-width:0!important}
