  :global(.catalog-command__title){overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;font:800 15px/1.25 var(--font-body)!important;color:#14251a!important}
  :global(.catalog-command__price){flex:0 0 auto!important;font:850 12px/1.2 var(--font-mono)!important;color:#166534!important}
  :global(.catalog-command__summary){display:-webkit-box!important;overflow:hidden!important;-webkit-box-orient:vertical!important;-webkit-line-clamp:1!important;font:500 12px/1.45 var(--font-body)!important;color:#6f7c74!important}
  :global(.catalog-command__badges){display:flex!important;align-items:center!important;gap:6px!important;min-width:0!important}
  :global(.catalog-command__badge){display:inline-flex!important;align-items:center!important;max-width:210px!important;height:22px!important;padding:0 8px!important;overflow:hidden!important;border:1px solid #e0e6e2!important;border-radius:999px!important;background:#f7f9f7!important;text-overflow:ellipsis!important;white-space:nowrap!important;font:750 9px/1 var(--font-mono)!important;letter-spacing:.02em!important;color:#647168!important}
  :global(.catalog-command__badge--type){border-color:#cfe9d8!important;background:#eaf7ef!important;color:#126b39!important}
  :global(.catalog-command__arrow){display:grid!important;place-items:center!important;width:28px!important;height:28px!important;border-radius:9px!important;background:#f1f5f2!important;font:800 14px/1 var(--font-body)!important;color:#5c6c62!important;transition:.14s ease!important}:global(.catalog-command__card:hover .catalog-command__arrow),:global(.catalog-command__card.is-active .catalog-command__arrow){background:#168348!important;color:#fff!important;transform:translateX(2px)!important}
  :global(.catalog-command__suggestion-item){margin:0 0 6px!important;padding:0!important;list-style:none!important}
  :global(.catalog-command__did-you-mean){display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;width:100%!important;padding:10px 14px!important;border:1px solid #b8e0c8!important;border-radius:12px!important;background:linear-gradient(90deg,#effaf3 0%,#f8fcf9 100%)!important;color:#14532d!important;cursor:pointer!important;text-align:left!important;transition:background .15s ease,border-color .15s ease,transform .15s ease!important}
  :global(.catalog-command__did-you-mean:hover){background:#e3f6ea!important;border-color:#86d2a3!important;transform:translateY(-1px)!important}
  :global(.catalog-command__dym-label){font:700 11px/1 var(--font-mono)!important;color:#166534!important}
  :global(.catalog-command__dym-term){font:800 13.5px/1.2 var(--font-body)!important;color:#0f5127!important;text-decoration:underline!important;text-decoration-color:rgba(15,81,39,.4)!important}
  :global(.catalog-command__dym-action){margin-left:auto!important;padding:3px 8px!important;border-radius:6px!important;background:#168348!important;color:#fff!important;font:800 10px/1 var(--font-mono)!important}
  :global(.catalog-command__info-banner){display:block!important;margin:0 0 4px!important;padding:8px 12px!important;border-radius:8px!important;background:#f6f8f7!important;font:600 12px/1.4 var(--font-body)!important;color:#55635a!important;list-style:none!important}
  :global(.catalog-command__empty){display:grid!important;gap:5px!important;padding:24px 18px!important;text-align:center!important}:global(.catalog-command__empty strong){font:800 15px/1.3 var(--font-body)!important;color:#1d2c22!important}:global(.catalog-command__empty span){font:500 12px/1.5 var(--font-body)!important;color:#7a8780!important}
  .catalog-search__panel-foot{display:flex;align-items:center;justify-content:flex-end;gap:14px;padding:10px 14px;border-top:1px solid #edf1ee;background:#fafcfb;color:#7d8a82}.catalog-search__panel-foot span{display:inline-flex;align-items:center;gap:5px;font:650 10px/1 var(--font-body)!important}.catalog-search__panel-foot kbd{padding:3px 5px;border:1px solid #dbe3de;border-bottom-width:2px;border-radius:5px;background:#fff;font:700 9px/1 var(--font-mono)!important;color:#58665d!important}
  @media(max-width:720px){:global(.catalog-command__search){max-width:none!important}.catalog-search__control{grid-template-columns:24px minmax(0,1fr) auto 42px;min-height:70px;padding-left:14px;border-radius:17px}.catalog-search__input{font-size:16px!important}.catalog-search__field label{font-size:11px!important}.catalog-search__panel{top:106px;border-radius:16px}.catalog-search__results{max-height:340px!important}:global(.catalog-command__card){grid-template-columns:40px minmax(0,1fr) 26px!important;padding:11px!important;gap:10px!important}:global(.catalog-command__icon){width:38px!important;height:38px!important;border-radius:10px!important}:global(.catalog-command__title-row){display:grid!important;gap:4px!important}:global(.catalog-command__title){font-size:14px!important}:global(.catalog-command__price){font-size:11px!important}:global(.catalog-command__summary){display:none!important}:global(.catalog-command__badge){max-width:145px!important}.catalog-search__panel-foot{display:none}.catalog-search__shortcut{display:none}}
  @media(prefers-reduced-motion:reduce){.catalog-search__control,.catalog-search__send,.catalog-search__panel,:global(.catalog-command__card),:global(.catalog-command__arrow){animation:none!important;transition:none!important}}
</style>
