---
import KatalogUrunKarti from './KatalogUrunKarti.astro';
import { categories } from '../../lib/categories';
import { getAllTemplates, type TemplateViewModel } from '../../lib/templates';

interface Props {
  templates: TemplateViewModel[];
  allTemplates?: TemplateViewModel[];
  activeCategory?: string;
  isCategoryPage?: boolean;
}

const { templates, activeCategory = 'all', isCategoryPage = false } = Astro.props;
const baseTemplates = Astro.props.allTemplates ?? (isCategoryPage || templates.length < 124 ? await getAllTemplates() : templates);
const totalAllCount = baseTemplates.length;

const categoryCounts = categories.reduce((acc, cat) => {
  acc[cat.slug] = baseTemplates.filter((t) => t.categorySlug === cat.slug).length;
  return acc;
}, {} as Record<string, number>);
---

<div class="template-grid-wrap" data-template-grid-wrap>
  <!-- KATEGORİ FİLTRELEME SEKMELERİ (Someka Tabbed Filter Bar) -->
  <div class="catalog-category-filter-bar" aria-label="Şablon Kategorileri">
    <div class="soho-tabs-nav" role="tablist">
      {isCategoryPage ? (
        <a href="/sablonlar" class={`soho-tab-btn ${activeCategory === 'all' ? 'is-active' : ''}`}>
          Tüm Şablonlar <span class="tab-count">({totalAllCount})</span>
        </a>
      ) : (
        <button type="button" class={`soho-tab-btn ${activeCategory === 'all' ? 'is-active' : ''}`} data-cat-filter="all">
          Tüm Şablonlar <span class="tab-count">({totalAllCount})</span>
        </button>
      )}
      {categories.map((cat) => {
        const count = categoryCounts[cat.slug] ?? 0;
        const isActive = activeCategory === cat.slug;
        return isCategoryPage ? (
          <a
            href={`/sablonlar/${cat.slug}`}
            class={`soho-tab-btn ${isActive ? 'is-active' : ''}`}
          >
            {cat.name} <span class="tab-count">({count})</span>
          </a>
        ) : (
          <button
            type="button"
            class={`soho-tab-btn ${isActive ? 'is-active' : ''}`}
            data-cat-filter={cat.slug}
          >
            {cat.name} <span class="tab-count">({count})</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- ÜRÜN IZGARASI (Ana Sayfa ile %100 Birebir Aynı Someka 4 Sütunlu Grid) -->
  <div class="soho-product-grid" data-template-grid>
    {templates.map((template, index) => (
      <div
        class="soho-card-col"
        data-template-item
        data-category={template.categorySlug}
        data-name={`${template.name} ${template.summary} ${template.categoryName}`.toLocaleLowerCase('tr-TR')}
      >
        <KatalogUrunKarti template={template} priority={index < 4} />
      </div>
    ))}
  </div>

  <!-- BOŞ DURUM (Sonuç Bulunamadı) -->
  <div class="catalog-empty-state" data-catalog-empty style="display: none;">
    <span class="empty-icon" aria-hidden="true">🔍</span>
    <h3 class="empty-title">Aradığınız kriterlere uygun şablon bulunamadı</h3>
    <p class="empty-desc">Farklı bir kelime aramayı deneyebilir veya kategori filtresini sıfırlayabilirsiniz.</p>
    <button type="button" class="btn-clear-filter" data-btn-reset-filter>Tüm Şablonları Göster</button>
  </div>
</div>

<script>
  function initCatalogFilter() {
    const gridWrap = document.querySelector('[data-template-grid-wrap]');
    if (!gridWrap) return;

    const items = Array.from(gridWrap.querySelectorAll<HTMLElement>('[data-template-item]'));
    const buttons = Array.from(gridWrap.querySelectorAll<HTMLButtonElement>('[data-cat-filter]'));
    const searchInput = document.querySelector<HTMLInputElement>('#catalog-search-input') ||
                        document.querySelector<HTMLInputElement>('[data-catalog-search]');
    const emptyState = gridWrap.querySelector<HTMLElement>('[data-catalog-empty]');
    const resetBtn = gridWrap.querySelector<HTMLButtonElement>('[data-btn-reset-filter]');

    let activeCategory = 'all';

    function applyFilters() {
      const rawQuery = (searchInput?.value ?? '').trim().toLocaleLowerCase('tr-TR');
      let visibleCount = 0;

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category') ?? '';
        const itemName = item.getAttribute('data-name') ?? '';

        const matchesCat = activeCategory === 'all' || itemCat === activeCategory;
        const matchesSearch = rawQuery.length === 0 || itemName.includes(rawQuery);

        if (matchesCat && matchesSearch) {
          item.style.display = '';
          item.removeAttribute('hidden');
          visibleCount++;
        } else {
          item.style.display = 'none';
          item.setAttribute('hidden', 'true');
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-cat-filter') ?? 'all';
        buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeCategory = 'all';
        buttons.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-cat-filter') === 'all'));
        if (searchInput) searchInput.value = '';
        applyFilters();
      });
    }

    // URL parametre kontrolü: ?kategori=slug
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get('kategori');
    const qParam = urlParams.get('q');

    if (catParam) {
      const matchingBtn = buttons.find((b) => b.getAttribute('data-cat-filter') === catParam);
      if (matchingBtn) {
        matchingBtn.click();
      }
    } else if (qParam && searchInput) {
      searchInput.value = qParam;
      applyFilters();
    }
  }

  // DOM hazır olduğunda veya Astro sayfa geçişlerinde çalıştır
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalogFilter);
  } else {
    initCatalogFilter();
  }
  document.addEventListener('astro:page-load', initCatalogFilter);
</script>

<style>
  .template-grid-wrap {
    width: 100%;
    margin-inline: auto;
  }

  /* KATEGORİ FİLTRELEME SEKMELERİ (PREMIUM APPLE CAPSULE DOCK — SAĞA KAYMAZ, WRAP EDER) */
  .catalog-category-filter-bar {
    margin-bottom: 24px;
    padding: 10px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    width: 100%;
    max-width: 100%;
  }
  .soho-tabs-nav {
    display: flex;
    flex-wrap: wrap !important;
    gap: 8px 10px;
    align-items: center;
    width: 100%;
    max-width: 100%;
  }
  .soho-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    white-space: nowrap;
    user-select: none;
    text-decoration: none;
  }
  .soho-tab-btn:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
  }
  .soho-tab-btn.is-active {
    background: #107c41 !important;
    border-color: #107c41 !important;
    color: #ffffff !important;
    box-shadow: 0 3px 12px rgba(16, 124, 65, 0.25);
    font-weight: 700;
  }
  .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    background: #f1f5f9;
    color: #64748b;
    transition: all 0.18s ease;
  }
  .soho-tab-btn.is-active .tab-count {
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }
  .soho-tab-btn:hover:not(.is-active) .tab-count {
    background: #e2e8f0;
    color: #1e293b;
  }

  @media (max-width: 640px) {
    .catalog-category-filter-bar {
      padding: 8px 10px;
      border-radius: 12px;
      margin-bottom: 18px;
    }
    .soho-tabs-nav {
      gap: 6px;
    }
    .soho-tab-btn {
      padding: 6px 11px;
      font-size: 12px;
    }
    .tab-count {
      font-size: 10px;
      padding: 1px 5px;
    }
  }

  /* SOMEKA 4 SÜTUNLU KART IZGARASI */
  .soho-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 36px;
    list-style: none;
    padding: 0;
  }
  .soho-card-col {
    display: flex;
    min-width: 0;
  }

  @media (max-width: 1200px) {
    .soho-product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (max-width: 860px) {
    .soho-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }
  @media (max-width: 580px) {
    .soho-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .soho-tabs-nav {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .soho-tabs-nav::-webkit-scrollbar {
      display: none;
    }
    .soho-tab-btn {
      white-space: nowrap;
      flex-shrink: 0;
    }
  }

  /* BOŞ DURUM */
  .catalog-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    text-align: center;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    margin-bottom: 40px;
  }
  .empty-icon {
    font-size: 40px;
    margin-bottom: 12px;
  }
  .empty-title {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 8px;
  }
  .empty-desc {
    font-size: 14px;
    color: #64748b;
    margin: 0 0 20px;
    max-width: 440px;
  }
  .btn-clear-filter {
    padding: 9px 18px;
    background: #107c41;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .btn-clear-filter:hover {
    background: #0b6333;
  }
</style>
