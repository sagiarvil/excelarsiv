---
interface Props {
  className?: string;
  spotlightColor?: string;
}

const { className = '', spotlightColor = 'rgba(23, 50, 77, 0.08)' } = Astro.props;
---

<div
  class:list={['spotlight-card-wrapper relative overflow-hidden rounded-xl border border-slate-200/80 bg-white transition-all', className]}
  data-spotlight-color={spotlightColor}
>
  <div
    class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-300"
    style={`background: radial-gradient(400px circle at var(--mouse-x, -999px) var(--mouse-y, -999px), ${spotlightColor}, transparent 70%);`}
  ></div>
  <div class="relative z-10">
    <slot />
  </div>
</div>

<script>
  function initSpotlights() {
    const cards = document.querySelectorAll<HTMLElement>('.spotlight-card-wrapper');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
        const overlay = card.querySelector<HTMLElement>('.spotlight-overlay');
        if (overlay) overlay.style.opacity = '1';
      });

      card.addEventListener('mouseleave', () => {
        const overlay = card.querySelector<HTMLElement>('.spotlight-overlay');
        if (overlay) overlay.style.opacity = '0';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotlights);
  } else {
    initSpotlights();
  }
  document.addEventListener('astro:page-load', initSpotlights);
</script>
