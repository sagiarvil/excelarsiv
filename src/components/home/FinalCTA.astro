---
const problems = [
  { label: 'Nakit akışımı planlamak istiyorum', href: '/sablonlar/nakit-akisi', hint: '13 haftalık plan, kasa, ödeme' },
  { label: 'Cari ve tahsilatı kontrol etmek istiyorum', href: '/sablon/cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi', hint: 'Cari risk, vade, tahsilat' },
  { label: 'Gerçek ürün kârlılığını görmek istiyorum', href: '/sablonlar/satis-ve-fiyatlama', hint: 'POS, pazaryeri, net marj' },
  { label: 'Vergi hesaplarımı kontrol etmek istiyorum', href: '/sablonlar/muhasebe-ve-vergi', hint: 'KDV, amortisman, SGK' },
  { label: 'Stok riskini azaltmak istiyorum', href: '/sablonlar/stok-ve-uretim', hint: 'Stok, üretim, nakit bağlanması' },
  { label: 'Personel maliyetini hesaplamak istiyorum', href: '/sablonlar/personel-ve-bordro', hint: 'İşçilik, kıdem, teşvik' },
];
---

<section class="problem-nav" aria-labelledby="problem-nav-title">
  <div class="site-container">
    <div class="problem-nav__head">
      <span>EN ÇOK ÇÖZÜM ARANAN İŞ PROBLEMLERİ</span>
      <h2 id="problem-nav-title">Hangi işletme problemini bugün netleştirmek istiyorsunuz?</h2>
      <p>Generic şablon listesi yerine problemi seçin; sizi ilgili kategori veya ürüne götürelim.</p>
    </div>
    <ul class="problem-nav__grid">
      {problems.map((item) => (
        <li>
          <a href={item.href}>
            <strong>{item.label}</strong>
            <small>{item.hint}</small>
          </a>
        </li>
      ))}
    </ul>
    <p class="problem-nav__finder">
      Emin değilmisiniz? <a href="/urun-bulucu">Ürün bulucu ile 1 ana sistem + en fazla 2 ilgili sistem görün.</a>
    </p>
  </div>
</section>

<style>
  .problem-nav { padding-block: clamp(64px, 8vw, 104px); background: #f6f9f7; border-top: 1px solid #dce6e0; }
  .problem-nav__head { max-width: 720px; }
  .problem-nav__head span { font-family: var(--font-mono); font-size: 10px; font-weight: 800; letter-spacing: .12em; color: #0d7040; }
  .problem-nav h2 { margin: 12px 0 0; font-family: var(--font-display); font-size: clamp(30px, 4vw, 48px); line-height: 1.05; letter-spacing: -.04em; color: #14291d; }
  .problem-nav__head p { margin: 14px 0 0; font-size: 15px; line-height: 1.65; color: #5b6b62; }
  .problem-nav__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 32px 0 0; padding: 0; list-style: none; }
  .problem-nav__grid a { display: grid; gap: 8px; min-height: 132px; padding: 20px; border: 1px solid #d7e2db; border-radius: 0; background: #fff; color: #173023; text-decoration: none; }
  .problem-nav__grid a:hover { border-color: #0d7040; }
  .problem-nav__grid strong { font-size: 16px; line-height: 1.3; }
  .problem-nav__grid small { font-size: 12px; color: #66756c; }
  .problem-nav__finder { margin: 22px 0 0; font-size: 13px; color: #5b6b62; }
  .problem-nav__finder a { font-weight: 800; color: #0d7040; }
  @media (max-width: 900px) { .problem-nav__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .problem-nav__grid { grid-template-columns: 1fr; } .problem-nav__grid a { min-height: 0; } }
</style>
