---
import type { SearchItem } from '../../lib/search';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;

const quickLinks = [
  { label: 'Nakit Akışı', href: '/sablonlar?q=nakit' },
  { label: 'Kasa', href: '/sablonlar?q=kasa' },
  { label: 'Cari Hesap', href: '/sablonlar?q=cari' },
  { label: 'Stok', href: '/sablonlar?q=stok' },
  { label: 'Kârlılık', href: '/sablonlar?q=kârlılık' },
];
---

<div class="hero-search" data-hero-search>
  <div class="hero-search__label-row">
    <span class="hero-search__label">Excel sistemlerinde ara</span>
    <span class="hero-search__hint">⌘K</span>
  </div>
  <form class="hero-search__form" action="/sablonlar" method="get" role="search">
    <svg class="hero-search__icon hero-search__icon--search" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      name="q"
      class="hero-search__input"
      placeholder="Ne arıyorsunuz? Örn: nakit akışı, cari, stok…"
      autocomplete="off"
      role="combobox"
      aria-label="Excel sistemlerinde ara"
      aria-expanded="false"
      aria-controls="hero-search-results"
    />
    <button type="submit" class="hero-search__button" aria-label="Ara">
      <svg class="hero-search__button-icon hero-search__button-icon--search" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M10.5 3a7.5 7.5 0 0 1 6.05 12.02l4.22 4.21-1.42 1.42-4.2-4.22A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" fill="currentColor" />
      </svg>
      <svg class="hero-search__button-icon hero-search__button-icon--send" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M3.4 4.2 21 12 3.4 19.8l2.2-6.2L14 12l-8.4-1.6-2.2-6.2Z" fill="currentColor" />
      </svg>
    </button>
  </form>
  <div class="hero-search__panel" data-search-panel hidden>
    <ul class="hero-search__results" id="hero-search-results"></ul>
    <div class="hero-search__panel-footer">
      <span>↑↓ gezin · Enter aç</span>
      <span>ESC kapat</span>
    </div>
  </div>
  <div class="hero-search__quick-wrap" aria-label="Popüler aramalar">
    <span class="hero-search__quick-label">Popüler</span>
    <div class="hero-search__quick">
      {quickLinks.map((link) => <a class="hero-search__quick-link" href={link.href}>{link.label}</a>)}
    </div>
  </div>
</div>

<script type="application/json" id="hero-search-index" set:html={JSON.stringify(searchIndex)}></script>
<script>
  import { mountHeroSearch } from '../../scripts/hero-search';
  const root = document.querySelector<HTMLElement>('[data-hero-search]');
  const indexEl = document.getElementById('hero-search-index');
  if (root && indexEl) mountHeroSearch(root, JSON.parse(indexEl.textContent ?? '[]'));
</script>

<style>
  .hero-search{position:relative}
  .hero-search__label-row{display:flex;align-items:center;justify-content:space-between;margin:0 8px 7px;color:#5f6c64;font-size:12px;font-weight:700}
  .hero-search__hint{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:24px;padding:0 8px;border:1px solid #dce4de;border-radius:7px;background:rgba(255,255,255,.9);font-family:var(--font-mono);font-size:11px;color:#7a8780}
  .hero-search__form{display:grid;grid-template-columns:22px minmax(0,1fr) 46px;align-items:center;min-height:62px;padding:7px 8px 7px 18px;border:1px solid rgba(16,124,65,.18);border-radius:18px;background:rgba(255,255,255,.985);box-shadow:0 18px 42px rgba(24,55,38,.14),0 3px 9px rgba(24,55,38,.05);transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease}
  .hero-search:focus-within .hero-search__form{border-color:rgba(16,124,65,.42);box-shadow:0 22px 52px rgba(24,55,38,.17),0 0 0 4px rgba(16,124,65,.07);transform:translateY(-1px)}
  .hero-search__icon{color:#77837c}
  .hero-search__input{width:100%;min-width:0;height:46px;padding-inline:12px;border:0;outline:0;background:transparent;font-family:var(--font-body);font-size:16px;color:var(--xl-ink-900)}
  .hero-search__input::placeholder{color:#849087;opacity:1}
  .hero-search__button{display:inline-grid;place-items:center;width:46px;height:46px;padding:0;border:0;border-radius:13px;background:var(--xl-green);color:#fff;cursor:pointer;transition:background .18s ease,transform .18s ease}
  .hero-search__button:hover{background:var(--xl-accent-dark);transform:translateY(-1px)}
  .hero-search__button-icon{grid-area:1/1;transition:opacity .18s ease,transform .18s ease}
  .hero-search__button-icon--send{opacity:0;transform:translateY(-7px)}
  .hero-search.has-query .hero-search__button-icon--search{opacity:0;transform:translateY(7px)}
  .hero-search.has-query .hero-search__button-icon--send{opacity:1;transform:translateY(0)}
  .hero-search__panel{position:absolute;top:96px;left:0;right:0;z-index:30;overflow:hidden;border:1px solid #dce4de;border-radius:16px;background:#fff;box-shadow:0 22px 55px rgba(16,24,40,.18);transform-origin:top;animation:searchPanelIn .18s ease both}
  .hero-search__panel[hidden]{display:none}
  @keyframes searchPanelIn{from{opacity:0;transform:translateY(-6px) scale(.992)}to{opacity:1;transform:translateY(0) scale(1)}}
  .hero-search__results{margin:0;padding:7px;list-style:none;max-height:310px;overflow-y:auto}
  .hero-search__results a{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;text-decoration:none;color:inherit;transition:background .14s ease,transform .14s ease}
  .hero-search__results a:hover,.hero-search__results a.is-highlighted{background:#f0f7f2;transform:translateX(2px)}
  .hero-search__result-main{display:flex;align-items:center;gap:10px;min-width:0}
  .hero-search__result-dot{width:8px;height:8px;flex:0 0 8px;border-radius:50%;background:#1a8a4b;box-shadow:0 0 0 4px #edf8f1}
  .hero-search__name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;font-weight:700;color:var(--xl-ink-900)}
  .hero-search__summary{display:block;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:#7a8780}
  .hero-search__meta{font-family:var(--font-mono);font-size:10.5px;color:#89958e;white-space:nowrap}
  .hero-search__empty{padding:14px 12px;font-size:13px;color:#7a8780}
  .hero-search__panel-footer{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:9px 13px;border-top:1px solid #edf0ee;background:#fafcfb;font-family:var(--font-mono);font-size:10.5px;color:#85918a}
  .hero-search__quick-wrap{display:flex;align-items:center;gap:8px;margin-top:9px;min-width:0;font-family:var(--font-mono);font-size:10.5px}
  .hero-search__quick-label{flex:0 0 auto;color:var(--xl-ink-3)}
  .hero-search__quick{display:flex;gap:7px;min-width:0;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}.hero-search__quick::-webkit-scrollbar{display:none}
  .hero-search__quick-link{flex:0 0 auto;display:inline-flex;align-items:center;min-height:28px;padding:0 9px;border:1px solid var(--xl-grid);border-radius:999px;background:rgba(255,255,255,.82);color:var(--xl-ink-900);text-decoration:none;white-space:nowrap}.hero-search__quick-link:hover{color:var(--xl-green-dark);border-color:var(--xl-accent-border)}
  @media(max-width:720px){.hero-search__label-row{margin-inline:4px}.hero-search__form{grid-template-columns:20px minmax(0,1fr) 44px;min-height:58px;padding:6px 7px 6px 15px;border-radius:16px;box-shadow:0 12px 28px rgba(24,55,38,.11)}.hero-search__input{height:44px;font-size:16px}.hero-search__button{width:44px;height:44px;border-radius:12px}.hero-search__panel{top:92px}.hero-search__panel-footer{display:none}.hero-search__results{max-height:260px}.hero-search__results a{grid-template-columns:1fr}.hero-search__meta{display:none}.hero-search__quick-wrap{margin-top:8px}}
  @media(prefers-reduced-motion:reduce){.hero-search__form,.hero-search__button,.hero-search__button-icon,.hero-search__results a,.hero-search__panel{animation:none!important;transition:none!important}}
</style>
