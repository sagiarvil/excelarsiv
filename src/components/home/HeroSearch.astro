---
import type { SearchItem } from '../../lib/search';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;

const quickLinks = [
  { label: 'Nakit Akışı', href: '/sablonlar?q=nakit' },
  { label: 'Kasa', href: '/sablonlar?q=kasa' },
  { label: 'Cari Hesap', href: '/sablonlar?q=cari' },
  { label: 'Stok', href: '/sablonlar?q=stok' },
  { label: 'Kârlılık', href: '/sablonlar?q=kârlılık' },
];
---

<div class="hero-search hero-search--premium" data-hero-search>
  <div class="hero-search__label-row">
    <span class="hero-search__label">Excel sistemlerinde ara</span>
    <span class="hero-search__hint">⌘K</span>
  </div>

  <form class="hero-search__form" action="/sablonlar" method="get" role="search">
    <span class="hero-search__leading-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </span>
    <input
      type="search"
      name="q"
      class="hero-search__input"
      placeholder="Ne arıyorsunuz? Örn: nakit akışı, cari, stok…"
      autocomplete="off"
      role="combobox"
      aria-label="Excel sistemlerinde ara"
      aria-expanded="false"
      aria-controls="hero-search-results"
    />
    <button type="submit" class="hero-search__button" aria-label="Ara">
      <svg class="hero-search__button-icon hero-search__button-icon--search" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M10.5 3a7.5 7.5 0 0 1 6.05 12.02l4.22 4.21-1.42 1.42-4.2-4.22A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" fill="currentColor" />
      </svg>
      <svg class="hero-search__button-icon hero-search__button-icon--send" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M3.5 4.5 21 12 3.5 19.5l2.1-6.1L14.4 12 5.6 10.6 3.5 4.5Z" fill="currentColor" />
      </svg>
    </button>
  </form>

  <div class="hero-search__panel" data-search-panel hidden>
    <div class="hero-search__panel-head">
      <div>
        <span class="hero-search__panel-kicker">ÖNERİLEN SONUÇLAR</span>
        <strong class="hero-search__panel-title">İhtiyacınıza en yakın sistemler</strong>
      </div>
      <span class="hero-search__panel-count" data-result-count>0 sonuç</span>
    </div>
    <ul class="hero-search__results" id="hero-search-results"></ul>
    <div class="hero-search__panel-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> gezin</span>
      <span><kbd>Enter</kbd> aç</span>
      <span><kbd>Esc</kbd> kapat</span>
    </div>
  </div>

  <div class="hero-search__quick-wrap" aria-label="Popüler aramalar">
    <span class="hero-search__quick-label">Popüler</span>
    <div class="hero-search__quick">
      {quickLinks.map((link) => <a class="hero-search__quick-link" href={link.href}>{link.label}</a>)}
    </div>
  </div>
</div>

<script type="application/json" id="hero-search-index" set:html={JSON.stringify(searchIndex)}></script>
<script>
  import { mountHeroSearch } from '../../scripts/hero-search';
  const root = document.querySelector<HTMLElement>('[data-hero-search]');
  const indexEl = document.getElementById('hero-search-index');
  if (root && indexEl) mountHeroSearch(root, JSON.parse(indexEl.textContent ?? '[]'));
</script>

<style>
  .hero-search--premium{position:relative;z-index:70}
  .hero-search--premium .hero-search__label-row{display:flex;align-items:center;justify-content:space-between;margin:0 10px 8px;color:#56645b;font-family:var(--font-body);font-size:14px!important;font-weight:800;letter-spacing:-.01em}
  .hero-search--premium .hero-search__hint{display:inline-flex;align-items:center;justify-content:center;min-width:38px;height:28px;padding:0 9px;border:1px solid #d9e1db;border-radius:9px;background:rgba(255,255,255,.94);box-shadow:0 2px 8px rgba(16,24,40,.04);font-family:var(--font-mono);font-size:12px!important;color:#748078}

  .hero-search--premium .hero-search__form{display:grid;grid-template-columns:28px minmax(0,1fr) 54px;align-items:center;min-height:68px;padding:7px 8px 7px 20px;border:1px solid rgba(16,124,65,.22);border-radius:20px;background:rgba(255,255,255,.985);box-shadow:0 22px 56px rgba(24,55,38,.15),0 3px 10px rgba(24,55,38,.05);transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease}
  .hero-search--premium:focus-within .hero-search__form{border-color:rgba(16,124,65,.48);box-shadow:0 28px 68px rgba(24,55,38,.18),0 0 0 5px rgba(16,124,65,.07);transform:translateY(-1px)}
  .hero-search--premium .hero-search__leading-icon{display:grid;place-items:center;color:#66756b}
  .hero-search--premium .hero-search__input{width:100%;min-width:0;height:52px;padding:0 14px;border:0!important;outline:0!important;background:transparent!important;box-shadow:none!important;font-family:var(--font-body);font-size:18px!important;font-weight:500;line-height:1.2;color:#152019}
  .hero-search--premium .hero-search__input::placeholder{color:#7f8b83;opacity:1}
  .hero-search--premium .hero-search__button{display:inline-grid!important;place-items:center;width:54px;height:54px;padding:0;border:0!important;border-radius:16px;background:#168445!important;color:#fff!important;box-shadow:0 10px 22px rgba(22,132,69,.24);cursor:pointer;transition:background .18s ease,transform .18s ease,box-shadow .18s ease}
  .hero-search--premium .hero-search__button:hover{background:#126d39!important;transform:translateY(-1px);box-shadow:0 13px 28px rgba(22,132,69,.28)}
  .hero-search--premium .hero-search__button-icon{grid-area:1/1;transition:opacity .18s ease,transform .18s ease}
  .hero-search--premium .hero-search__button-icon--send{opacity:0;transform:translateY(-8px)}
  .hero-search--premium.has-query .hero-search__button-icon--search{opacity:0;transform:translateY(8px)}
  .hero-search--premium.has-query .hero-search__button-icon--send{opacity:1;transform:translateY(0)}

  .hero-search--premium .hero-search__panel{position:absolute;top:108px;left:0;right:0;z-index:99999;overflow:hidden;border:1px solid #d8e1da;border-radius:20px;background:rgba(255,255,255,.985);box-shadow:0 30px 80px rgba(15,23,42,.20),0 8px 24px rgba(15,23,42,.07);backdrop-filter:blur(16px);transform-origin:top;animation:searchPanelIn .18s ease both}
  .hero-search--premium .hero-search__panel[hidden]{display:none!important}
  @keyframes searchPanelIn{from{opacity:0;transform:translateY(-8px) scale(.992)}to{opacity:1;transform:translateY(0) scale(1)}}

  .hero-search--premium .hero-search__panel-head{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 20px 12px;border-bottom:1px solid #edf1ee;background:linear-gradient(180deg,#fff 0%,#fbfdfb 100%)}
  .hero-search--premium .hero-search__panel-kicker{display:block;margin:0 0 4px;font-family:var(--font-mono);font-size:10.5px!important;font-weight:900;letter-spacing:.11em;color:#168445}
  .hero-search--premium .hero-search__panel-title{display:block;font-family:var(--font-body);font-size:15px!important;font-weight:800;color:#17201b}
  .hero-search--premium .hero-search__panel-count{flex:0 0 auto;padding:5px 9px;border:1px solid #dce5de;border-radius:999px;background:#f7faf8;font-family:var(--font-mono);font-size:10.5px!important;font-weight:700;color:#78847c}

  .hero-search--premium .hero-search__results{display:grid!important;gap:8px!important;margin:0!important;padding:10px!important;list-style:none!important;max-height:390px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:#cbd5ce transparent}
  .hero-search--premium .hero-search__results>li{display:block!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important}
  .hero-search--premium .hero-search__results>li>a{display:grid!important;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:12px;width:100%;padding:13px 14px!important;border:1px solid #e6ebe7!important;border-radius:14px!important;background:#fff!important;text-decoration:none!important;color:#17201b!important;box-shadow:0 1px 2px rgba(16,24,40,.025);transition:border-color .14s ease,background .14s ease,box-shadow .14s ease,transform .14s ease}
  .hero-search--premium .hero-search__results>li>a:hover,.hero-search--premium .hero-search__results>li>a.is-highlighted{border-color:#b8ddc5!important;background:linear-gradient(90deg,#f2fbf5 0%,#fbfdfb 100%)!important;box-shadow:0 8px 22px rgba(16,124,65,.08);transform:translateY(-1px)}
  .hero-search--premium .hero-search__result-icon{display:grid;place-items:center;width:42px;height:42px;border:1px solid #dce8df;border-radius:12px;background:linear-gradient(145deg,#f8fbf9,#edf7f0);color:#168445}
  .hero-search--premium .hero-search__result-copy{min-width:0}
  .hero-search--premium .hero-search__name{display:block!important;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--font-body);font-size:15px!important;font-weight:800!important;line-height:1.25!important;color:#17201b!important}
  .hero-search--premium .hero-search__summary{display:-webkit-box!important;margin-top:4px!important;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:1;font-family:var(--font-body);font-size:12.5px!important;font-weight:500!important;line-height:1.45!important;color:#6f7c74!important}
  .hero-search--premium .hero-search__result-side{display:flex;align-items:flex-end;flex-direction:column;gap:7px;min-width:112px}
  .hero-search--premium .hero-search__kind{display:inline-flex;align-items:center;min-height:24px;padding:0 8px;border:1px solid #cfe6d6;border-radius:999px;background:#eef9f2;font-family:var(--font-mono);font-size:10px!important;font-weight:900;color:#13763f}
  .hero-search--premium .hero-search__category{max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--font-body);font-size:11.5px!important;font-weight:600;color:#829087}
  .hero-search--premium .hero-search__arrow{font-size:16px!important;font-weight:900;color:#9aa59e;transition:transform .14s ease,color .14s ease}
  .hero-search--premium .hero-search__results>li>a:hover .hero-search__arrow,.hero-search--premium .hero-search__results>li>a.is-highlighted .hero-search__arrow{color:#168445;transform:translateX(2px)}
  .hero-search--premium .hero-search__suggestion-item{display:block!important;margin:0 0 6px!important;padding:0!important}
  .hero-search--premium .hero-search__did-you-mean{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:10px 14px;border:1px solid #b8e0c8;border-radius:12px;background:linear-gradient(90deg,#effaf3 0%,#f8fcf9 100%);color:#14532d;cursor:pointer;text-align:left;transition:background .15s ease,border-color .15s ease,transform .15s ease}
  .hero-search--premium .hero-search__did-you-mean:hover{background:#e3f6ea;border-color:#86d2a3;transform:translateY(-1px)}
  .hero-search--premium .hero-search__dym-label{font-family:var(--font-mono);font-size:11px!important;font-weight:700;color:#166534}
  .hero-search--premium .hero-search__dym-term{font-family:var(--font-body);font-size:13.5px!important;font-weight:800;color:#0f5127;text-decoration:underline;text-decoration-color:rgba(15,81,39,.4)}
  .hero-search--premium .hero-search__dym-action{margin-left:auto;padding:3px 8px;border-radius:6px;background:#168445;color:#fff;font-family:var(--font-mono);font-size:10px!important;font-weight:800}
  .hero-search--premium .hero-search__info-banner{display:block!important;margin:0 0 4px!important;padding:8px 12px!important;border-radius:8px;background:#f6f8f7;font-family:var(--font-body);font-size:12px!important;color:#55635a}
  .hero-search--premium .hero-search__empty{display:block!important;margin:0!important;padding:18px 16px!important;border:1px dashed #d6dfd8;border-radius:13px;background:#fafcfb;font-family:var(--font-body);font-size:13px!important;line-height:1.55!important;color:#6f7c74!important}

  .hero-search--premium .hero-search__panel-footer{display:flex!important;align-items:center;justify-content:flex-end;gap:18px;padding:10px 16px;border-top:1px solid #edf1ee;background:#fafcfb;font-family:var(--font-body);font-size:11px!important;color:#7f8a83}
  .hero-search--premium .hero-search__panel-footer span{display:flex;align-items:center;gap:5px}
  .hero-search--premium .hero-search__panel-footer kbd{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:22px;padding:0 6px;border:1px solid #d6ded8;border-bottom-width:2px;border-radius:6px;background:#fff;font-family:var(--font-mono);font-size:10px!important;font-weight:800;color:#657269}

  .hero-search--premium .hero-search__quick-wrap{display:flex;align-items:center;gap:9px;margin-top:10px;min-width:0;font-family:var(--font-body);font-size:12px!important}
  .hero-search--premium .hero-search__quick-label{flex:0 0 auto;font-weight:700;color:#76827a}
  .hero-search--premium .hero-search__quick{display:flex;gap:7px;min-width:0;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}.hero-search--premium .hero-search__quick::-webkit-scrollbar{display:none}
  .hero-search--premium .hero-search__quick-link{flex:0 0 auto;display:inline-flex!important;align-items:center;min-height:30px;padding:0 10px;border:1px solid #dce4de;border-radius:999px;background:rgba(255,255,255,.88);color:#344139!important;font-size:11.5px!important;font-weight:700;text-decoration:none!important;white-space:nowrap}.hero-search--premium .hero-search__quick-link:hover{color:#136f3b!important;border-color:#b9d9c4;background:#f4faf6}

  @media(max-width:720px){
    .hero-search--premium .hero-search__label-row{margin-inline:5px}
    .hero-search--premium .hero-search__form{grid-template-columns:26px minmax(0,1fr) 48px;min-height:62px;padding:6px 7px 6px 16px;border-radius:17px;box-shadow:0 14px 32px rgba(24,55,38,.12)}
    .hero-search--premium .hero-search__input{height:48px;font-size:16px!important}
    .hero-search--premium .hero-search__button{width:48px;height:48px;border-radius:14px}
    .hero-search--premium .hero-search__panel{top:102px;border-radius:17px}
    .hero-search--premium .hero-search__panel-head{padding:14px 14px 10px}
    .hero-search--premium .hero-search__panel-title{font-size:14px!important}
    .hero-search--premium .hero-search__results{max-height:320px;padding:8px!important;gap:7px!important}
    .hero-search--premium .hero-search__results>li>a{grid-template-columns:38px minmax(0,1fr);padding:11px 12px!important}
    .hero-search--premium .hero-search__result-icon{width:38px;height:38px;border-radius:11px}
    .hero-search--premium .hero-search__result-side{display:none}
    .hero-search--premium .hero-search__panel-footer{display:none!important}
    .hero-search--premium .hero-search__quick-wrap{margin-top:8px}
  }

  @media(prefers-reduced-motion:reduce){.hero-search--premium .hero-search__form,.hero-search--premium .hero-search__button,.hero-search--premium .hero-search__button-icon,.hero-search--premium .hero-search__results>li>a,.hero-search--premium .hero-search__panel{animation:none!important;transition:none!important}}
</style>
