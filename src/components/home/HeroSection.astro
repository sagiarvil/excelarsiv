---
import type { SearchItem } from '../../lib/search';
import HeroSearch from './HeroSearch.astro';
interface Props { searchIndex: SearchItem[]; }
const { searchIndex } = Astro.props;
const intents=[['Nakit akışı','nakit'],['Cari & tahsilat','cari'],['Kârlılık','kar'],['Stok','stok']];
---
<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-shell">
    <div class="hero-mobile-copy">
      <div class="hero-mobile-kicker"><span class="hero-mobile-kicker__dot"></span><span>İŞLETMELER İÇİN HAZIR EXCEL SİSTEMLERİ</span></div>
      <h1 id="hero-title" class="hero-title">İşletmenizdeki sorunu seçin.<br/><em>Doğru sistemi bulun.</em></h1>
      <p class="hero-mobile-copy__summary">Nakit, cari, kârlılık, stok ve muhasebe süreçlerini tek bakışta yönetebileceğiniz hazır Excel çalışma sistemlerini gerçek ekranlarıyla inceleyin.</p>
      <div class="hero-mobile-trust" aria-label="Satın alma güven bilgileri"><span><strong>51</strong> hazır sistem</span><span><strong>Demo</strong> ile inceleme</span><span><strong>Tek</strong> ödeme</span></div>
      <div class="hero-mobile-actions" aria-label="Hızlı işlemler"><a href="/sablonlar" class="hero-mobile-actions__primary">Sistemleri keşfet <span aria-hidden="true">→</span></a><a href="/demo" class="hero-mobile-actions__secondary">Demolar</a></div>
      <nav class="hero-mobile-chips" aria-label="Popüler ihtiyaçlar">{intents.map(([label,q])=><a href={`/sablonlar?q=${q}`}>{label}</a>)}</nav>
    </div>
    <picture class="hero-artwork"><source media="(min-width: 721px)" srcset="/images/hero.jpg" /><img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Excel şablonları ve finansal işletme çözümleri" width="1600" height="533" loading="eager" fetchpriority="high" decoding="async" /></picture>
    <div class="hero-search-rail" id="hero-search"><HeroSearch searchIndex={searchIndex} /></div>
  </div>
</section>
<style>
.hero-section{margin-top:28px;margin-bottom:46px}.hero-shell{position:relative;width:min(1680px,calc(100% - 64px));margin-inline:auto;padding-bottom:28px}.hero-mobile-copy{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.hero-mobile-actions,.hero-mobile-chips,.hero-mobile-trust{display:none}.hero-artwork{position:relative;display:block;overflow:hidden;width:100%;margin-inline:auto;aspect-ratio:3/1;border:1px solid rgba(16,124,65,.12);border-radius:24px;background:#eef3f6;box-shadow:0 24px 60px rgba(24,55,38,.13)}.hero-artwork img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.hero-search-rail{position:absolute;left:50%;bottom:0;z-index:10;width:min(690px,calc(100% - 48px));transform:translateX(-50%);scroll-margin-top:90px}
@media(min-width:721px) and (max-width:1180px){.hero-shell{width:calc(100% - 40px)}}
@media(max-width:720px){
.hero-section{margin:0;padding:18px 0 24px;background:radial-gradient(circle at 100% 0,rgba(16,124,65,.08),transparent 38%),linear-gradient(180deg,#f8fbf9 0%,#fff 82%);border-bottom:1px solid #e5ebe7}.hero-shell{width:calc(100% - 32px);padding:0}.hero-mobile-copy{position:relative;width:auto;height:auto;padding:7px 0 0;margin:0;overflow:visible;clip:auto;white-space:normal;border:0}.hero-mobile-kicker{display:flex;align-items:center;gap:7px;font:800 9px/1.2 var(--font-mono);letter-spacing:.105em;color:#356047}.hero-mobile-kicker__dot{width:7px;height:7px;border-radius:50%;background:#107c41;box-shadow:0 0 0 4px rgba(16,124,65,.09)}.hero-title{max-width:560px;margin:14px 0 0;font-family:var(--font-display);font-size:clamp(34px,9.7vw,44px);font-weight:820;line-height:.98;letter-spacing:-.055em;color:#122019;text-wrap:balance}.hero-title em{font-style:normal;color:#107c41}.hero-mobile-copy__summary{max-width:560px;margin:14px 0 0;font:500 14px/1.58 var(--font-body);color:#56665d}.hero-mobile-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:18px;overflow:hidden;border:1px solid #e0e7e2;border-radius:13px;background:#e0e7e2}.hero-mobile-trust span{min-width:0;padding:10px 7px;background:rgba(255,255,255,.96);font:650 9px/1.25 var(--font-body);color:#68766e;text-align:center}.hero-mobile-trust strong{display:block;margin-bottom:3px;font:850 13px/1 var(--font-mono);color:#1b3526}.hero-mobile-actions{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;margin-top:12px}.hero-mobile-actions a{min-height:50px;display:flex;align-items:center;justify-content:center;border-radius:12px;font:800 13px/1 var(--font-body);text-decoration:none}.hero-mobile-actions__primary{gap:10px;padding:0 17px;background:#107c41;color:#fff;box-shadow:0 10px 24px rgba(16,124,65,.19)}.hero-mobile-actions__secondary{padding:0 16px;border:1px solid #d8e2db;background:#fff;color:#25372c}.hero-mobile-chips{display:flex;gap:7px;margin:13px -16px 0;padding:0 16px 3px;overflow-x:auto;scrollbar-width:none;scroll-snap-type:x proximity}.hero-mobile-chips::-webkit-scrollbar{display:none}.hero-mobile-chips a{flex:0 0 auto;min-height:40px;display:flex;align-items:center;scroll-snap-align:start;padding:0 13px;border:1px solid #dce5df;border-radius:999px;background:#fff;color:#405148;font:750 11px/1 var(--font-body);text-decoration:none}.hero-artwork{display:none}.hero-search-rail{position:relative;left:auto;bottom:auto;transform:none;width:100%;margin:16px auto 0;scroll-margin-top:76px}
}
@media(max-width:380px){.hero-shell{width:calc(100% - 28px)}.hero-title{font-size:33px}.hero-mobile-copy__summary{font-size:13px}.hero-mobile-actions a{font-size:12px}.hero-mobile-trust span{font-size:8px}}
@media(prefers-reduced-motion:reduce){.hero-mobile-actions a,.hero-mobile-chips a{scroll-behavior:auto}}
</style>
<style is:global>
@media(max-width:720px){
.home-v2 .home-shell{width:calc(100% - 32px)!important}.home-v2 [data-experience-stage]{contain-intrinsic-size:auto 520px}.home-v2 .catalog-proof,.home-v2 .custom-build,.home-v2 .decision-help,.home-v2 .faq-close{padding:38px 0!important}.home-v2 .section-head{display:grid!important;grid-template-columns:1fr auto;gap:10px!important;align-items:end!important;margin-bottom:17px!important}.home-v2 .section-head h2,.home-v2 .custom-build h2,.home-v2 .decision-intro h2,.home-v2 .authority h2,.home-v2 .faq-close h2,.home-v2 .difference h2{font-size:29px!important;line-height:1.02!important;letter-spacing:-.042em!important}.home-v2 .section-head>a{min-height:40px;display:flex;align-items:center;font-size:11px!important;white-space:nowrap}.home-v2 .price-levels{margin:0 -16px 15px!important;padding:0 16px 3px;flex-wrap:nowrap!important;overflow-x:auto;scrollbar-width:none}.home-v2 .price-levels::-webkit-scrollbar{display:none}.home-v2 .price-levels span{flex:0 0 auto;border-radius:999px!important;background:#fff!important}.home-v2 .featured-grid{display:flex!important;grid-template-columns:none!important;gap:12px!important;margin:0 -16px;padding:0 16px 10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.home-v2 .featured-grid::-webkit-scrollbar{display:none}.home-v2 .featured-grid article{flex:0 0 min(84vw,340px);scroll-snap-align:start;border-radius:16px!important;overflow:hidden;border:1px solid #dfe6e1!important;box-shadow:0 12px 30px rgba(18,42,26,.075)}.home-v2 .featured-grid article>div{padding:16px!important}.home-v2 .featured-grid h3{min-height:auto!important;margin:8px 0!important;font-size:20px!important;line-height:1.12!important}.home-v2 .featured-grid p{min-height:auto!important;margin-bottom:11px!important;font-size:12px!important;line-height:1.5!important}.home-v2 .difference{padding:40px 0!important}.home-v2 .difference-grid,.home-v2 .custom-build-grid,.home-v2 .decision-layout,.home-v2 .faq-grid{grid-template-columns:1fr!important;gap:20px!important}.home-v2 .difference ul{grid-template-columns:1fr 1fr!important;gap:8px!important;margin-top:17px!important}.home-v2 .difference li{padding:11px!important;border-radius:10px}.home-v2 .custom-actions{gap:8px!important}.home-v2 .custom-step{grid-template-columns:36px 1fr!important;padding:13px!important;border-radius:12px;background:#fff}.home-v2 .custom-step p{margin-top:4px!important}.home-v2 .custom-cta-card{display:grid!important;gap:12px!important;padding:16px!important;border-radius:14px!important}.home-v2 .custom-cta-btn{width:100%;min-height:48px;display:flex;align-items:center;justify-content:center}.home-v2 .decision-grid{grid-template-columns:1fr!important;gap:10px!important}.home-v2 .decision-card{border-radius:14px!important}.home-v2 .decision-card-body{padding:15px!important}.home-v2 .decision-card-body h3{font-size:18px!important}.home-v2 .authority{padding:38px 0!important}.home-v2 .authority-panel{grid-template-columns:1fr!important;gap:22px!important}.home-v2 .authority-metrics{grid-template-columns:repeat(3,1fr)!important}.home-v2 .authority-metrics article{min-width:0;padding:13px 7px!important;text-align:center}.home-v2 .authority-metrics strong{font-size:24px!important}.home-v2 .faq-list details{border-radius:11px!important;overflow:hidden}.home-v2 .close-actions{display:grid!important;grid-template-columns:1fr 1fr;gap:8px!important}.home-v2 .close-actions a{min-height:46px;display:flex;align-items:center;justify-content:center}
}
</style>
