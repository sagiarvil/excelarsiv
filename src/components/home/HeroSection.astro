---
import type { SearchItem } from '../../lib/search';
import HeroSearch from './HeroSearch.astro';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-shell">
    <div class="hero-panel">
      <div class="hero-copy">
        <div class="hero-trust">⭐ <strong>17 Yıllık Ticari Bankacılık &amp; Saha Finans Güvencesi</strong></div>
        <h1 id="hero-title">İşletmeler İçin <span>Finansal Karar</span> ve Excel Sistemleri.</h1>
        <p class="hero-summary">Şirketinizin nakit akışını, banka limitlerini, birim maliyetini ve kârlılığını tahminlerle değil, test edilmiş dinamik modellerle yönetin.</p>

        <div class="hero-actions" aria-label="Çözüm seçimi">
          <a href="/sablonlar" class="hero-actions__primary" data-cta="home_ready_systems" data-location="hero">
            <span>Hazır Finansal Sistemleri İnceleyin ↓</span>
            <small>Anında inceleyin ve uygun sistemi seçin</small>
          </a>
          <a href="/ozel-excel-sistemleri" class="hero-actions__secondary" data-cta="home_custom_system" data-location="hero">
            <span>İşletmenize Özel Sistem Kuralım →</span>
            <small>15 dk ön teşhis · Özel sisteme geçin</small>
          </a>
        </div>

        <nav class="hero-chips" aria-label="Finansal karar alanları">
          <a href="/sablonlar?q=nakit">Nakit &amp; likidite</a>
          <a href="/sablonlar?q=kredi">Kredi &amp; limit</a>
          <a href="/sablonlar?q=kar">Kârlılık &amp; fiyatlama</a>
          <a href="/ozel-excel-sistemleri">ERP verisi → yönetici kararı</a>
        </nav>
      </div>

      <picture class="hero-artwork" aria-hidden="true">
        <source media="(min-width: 721px)" srcset="/images/hero.jpg" />
        <img
          src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
          alt=""
          width="1600"
          height="533"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <div class="hero-search-rail" id="hero-search">
      <HeroSearch searchIndex={searchIndex} />
    </div>
  </div>
</section>

<style>
  .hero-section{position:relative;z-index:60;margin:28px 0 46px}
  .hero-shell{position:relative;z-index:60;width:min(1680px,calc(100% - 64px));margin-inline:auto;padding-bottom:30px}
  .hero-panel{position:relative;display:grid;grid-template-columns:minmax(0,.92fr) minmax(520px,1.08fr);align-items:stretch;min-height:520px;overflow:hidden;border:1px solid rgba(15,23,42,.08);border-radius:24px;background:linear-gradient(120deg,#fff 0%,#fff 51%,#f3faf6 100%);box-shadow:0 24px 60px rgba(24,55,38,.13)}
  .hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;padding:48px 28px 58px 50px;min-width:0}
  .hero-trust{width:max-content;max-width:100%;display:inline-flex;align-items:center;gap:7px;margin-bottom:20px;padding:8px 12px;border:1px solid #cfe6d8;border-radius:999px;background:#f6fbf8;color:#234332;font:700 13px/1.25 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.01em}
  .hero-copy h1{max-width:760px;margin:0;color:#0f172a;font:820 clamp(42px,4.1vw,64px)/.99 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.055em;text-wrap:balance}
  .hero-copy h1 span{color:#087a46}
  .hero-summary{max-width:690px;margin:20px 0 0;color:#475569;font:500 18px/1.58 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.015em}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
  .hero-actions a{min-height:72px;display:flex;flex-direction:column;justify-content:center;border-radius:13px;padding:12px 20px;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease,background-color .18s ease}
  .hero-actions a:hover{transform:translateY(-1px)}
  .hero-actions a span{font:800 14px/1.25 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.015em}
  .hero-actions a small{margin-top:5px;font:650 11px/1.2 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;opacity:.78}
  .hero-actions__primary{background:#059669;color:#fff;box-shadow:0 12px 28px rgba(5,150,105,.22)}
  .hero-actions__primary:hover{background:#047857;box-shadow:0 16px 34px rgba(5,150,105,.25)}
  .hero-actions__secondary{border:2px solid #0f172a;background:#fff;color:#0f172a}
  .hero-actions__secondary:hover{background:#f8fafc}
  .hero-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .hero-chips a{padding:8px 10px;border:1px solid #dce5df;border-radius:999px;background:#fff;color:#425066;font:700 11px/1 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-decoration:none}
  .hero-artwork{position:relative;display:block;min-width:0;overflow:hidden;aspect-ratio:3 / 1;background:#eef3f6}
  .hero-artwork::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#fff 0%,rgba(255,255,255,.72) 6%,rgba(255,255,255,0) 26%);pointer-events:none}
  .hero-artwork img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero-search-rail{position:absolute;left:50%;bottom:0;z-index:70;width:min(720px,calc(100% - 48px));transform:translateX(-50%);scroll-margin-top:90px}

  @media (min-width:721px) and (max-width:1180px){
    .hero-shell{width:calc(100% - 40px)}
    .hero-panel{grid-template-columns:minmax(0,1fr) minmax(420px,.95fr);min-height:490px}
    .hero-copy{padding:42px 18px 52px 34px}
    .hero-copy h1{font-size:clamp(38px,4.8vw,52px)}
    .hero-summary{font-size:16px}
  }

  @media (max-width:900px){
    .hero-panel{grid-template-columns:1fr;min-height:0}
    .hero-copy{padding:38px 34px 100px}
    .hero-artwork{position:absolute;inset:0;opacity:.11}
    .hero-artwork::before{background:linear-gradient(90deg,rgba(255,255,255,.96),rgba(255,255,255,.82))}
  }

  @media (max-width:720px){
    .hero-section{margin:0;padding:14px 0 22px;background:linear-gradient(180deg,#f7faf8 0%,#fff 100%);border-bottom:1px solid #e6ece8}
    .hero-shell{width:calc(100% - 28px);padding:0}
    .hero-panel{display:block;border-radius:18px;background:#fff;box-shadow:0 12px 32px rgba(24,55,38,.08)}
    .hero-copy{padding:24px 18px 22px}
    .hero-trust{margin-bottom:14px;font-size:10px;padding:7px 9px}
    .hero-copy h1{font-size:clamp(31px,9vw,42px);line-height:.99}
    .hero-summary{margin-top:14px;font-size:14px;line-height:1.55}
    .hero-actions{display:grid;grid-template-columns:1fr;gap:9px;margin-top:18px}
    .hero-actions a{min-height:58px;padding:10px 14px}
    .hero-actions a span{font-size:13px}
    .hero-actions a small{font-size:10px}
    .hero-chips{flex-wrap:nowrap;margin:14px -18px 0;padding:0 18px 3px;overflow-x:auto;scrollbar-width:none;scroll-snap-type:x proximity}
    .hero-chips::-webkit-scrollbar{display:none}
    .hero-chips a{flex:0 0 auto;scroll-snap-align:start}
    .hero-artwork{display:none}
    .hero-search-rail{position:relative;left:auto;bottom:auto;transform:none;width:100%;margin:16px auto 0;scroll-margin-top:72px}
  }
</style>

<style is:global>
  @media (max-width:720px){
    .home-v2 .home-shell{width:calc(100% - 28px)!important}
    .home-v2 [data-experience-stage]{contain-intrinsic-size:auto 520px}
    .home-v2 .catalog-proof,.home-v2 .custom-build,.home-v2 .decision-help,.home-v2 .faq-close{padding:34px 0!important}
    .home-v2 .section-head{display:grid!important;grid-template-columns:1fr auto;gap:10px!important;align-items:end!important;margin-bottom:16px!important}
    .home-v2 .section-head h2,.home-v2 .custom-build h2,.home-v2 .decision-intro h2,.home-v2 .authority h2,.home-v2 .faq-close h2,.home-v2 .difference h2{font-size:28px!important;line-height:1.02!important;letter-spacing:-.04em!important}
    .home-v2 .section-head>a{font-size:11px!important;white-space:nowrap}
    .home-v2 .price-levels{margin:0 -14px 14px!important;padding:0 14px 2px;flex-wrap:nowrap!important;overflow-x:auto;scrollbar-width:none}
    .home-v2 .price-levels::-webkit-scrollbar{display:none}
    .home-v2 .price-levels span{flex:0 0 auto;border-radius:999px!important;background:#fff!important}
    .home-v2 .featured-grid{display:flex!important;grid-template-columns:none!important;gap:12px!important;margin:0 -14px;padding:0 14px 8px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
    .home-v2 .featured-grid::-webkit-scrollbar{display:none}
    .home-v2 .featured-grid article{flex:0 0 min(82vw,330px);scroll-snap-align:start;border-radius:18px!important;overflow:hidden;box-shadow:0 10px 28px rgba(18,42,26,.08)}
    .home-v2 .featured-grid article>div{padding:15px!important}
    .home-v2 .featured-grid h3{min-height:auto!important;margin:7px 0!important;font-size:19px!important}
    .home-v2 .featured-grid p{min-height:auto!important;margin-bottom:10px!important;font-size:12px!important}
    .home-v2 .difference{padding:38px 0!important}
    .home-v2 .difference-grid{grid-template-columns:1fr!important;gap:16px!important}
    .home-v2 .difference ul{grid-template-columns:1fr 1fr!important;gap:7px!important;margin-top:16px!important}
    .home-v2 .difference li{padding:10px!important;border-radius:10px}
    .home-v2 .custom-build-grid,.home-v2 .decision-layout,.home-v2 .faq-grid{grid-template-columns:1fr!important;gap:20px!important}
    .home-v2 .custom-actions{gap:8px!important}
    .home-v2 .custom-step{grid-template-columns:34px 1fr!important;padding:12px!important;border-radius:13px;background:#fff}
    .home-v2 .custom-step p{margin-top:4px!important}
    .home-v2 .custom-cta-card{display:grid!important;gap:12px!important;padding:15px!important;border-radius:15px!important}
    .home-v2 .custom-cta-btn{width:100%;min-height:46px;display:flex;align-items:center;justify-content:center}
    .home-v2 .decision-grid{grid-template-columns:1fr!important;gap:9px!important}
    .home-v2 .decision-card{border-radius:15px!important}
    .home-v2 .decision-card-body{padding:14px!important}
    .home-v2 .decision-card-body h3{font-size:17px!important}
    .home-v2 .authority{padding:36px 0!important}
    .home-v2 .authority-panel{grid-template-columns:1fr!important;gap:22px!important}
    .home-v2 .authority-metrics{grid-template-columns:repeat(3,1fr)!important}
    .home-v2 .authority-metrics article{min-width:0;padding:12px 7px!important;text-align:center}
    .home-v2 .authority-metrics strong{font-size:24px!important}
    .home-v2 .faq-list details{border-radius:12px!important;overflow:hidden}
    .home-v2 .close-actions{display:grid!important;grid-template-columns:1fr 1fr;gap:8px!important}
    .home-v2 .close-actions a{min-height:44px;display:flex;align-items:center;justify-content:center}
  }
</style>
