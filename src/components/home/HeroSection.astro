---
import type { SearchItem } from '../../lib/search';
import HeroSearch from './HeroSearch.astro';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;
---

<section class="hero-section" aria-labelledby="hero-title" data-mobile-premium-hero>
  <div class="hero-shell">
    <div class="hero-panel">
      <div class="hero-copy">
        <div class="hero-trust">⭐ <strong>17 Yıllık Ticari Bankacılık &amp; Saha Finans Güvencesi</strong></div>
        <h1 id="hero-title">İşletmeler İçin <span>Finansal Karar</span> ve Excel Sistemleri.</h1>
        <p class="hero-summary">Şirketinizin nakit akışını, banka limitlerini, birim maliyetini ve kârlılığını tahminlerle değil, test edilmiş dinamik modellerle yönetin.</p>

        <div class="hero-actions" aria-label="Çözüm seçimi">
          <a href="/sablonlar" class="hero-actions__primary" data-cta="home_ready_systems" data-location="hero">
            <span>Hazır Finansal Sistemleri İnceleyin ↓</span>
            <small>Anında inceleyin ve uygun sistemi seçin</small>
          </a>
          <a href="/ozel-excel-sistemleri" class="hero-actions__secondary" data-cta="home_custom_system" data-location="hero">
            <span>İşletmenize Özel Sistem Kuralım →</span>
            <small>15 dk ön teşhis · Özel sisteme geçin</small>
          </a>
        </div>

        <nav class="hero-chips" aria-label="Finansal karar alanları">
          <a href="/sablonlar?q=nakit"><span aria-hidden="true">↗</span>Nakit &amp; likidite</a>
          <a href="/sablonlar?q=kredi"><span aria-hidden="true">₺</span>Kredi &amp; limit</a>
          <a href="/sablonlar?q=kar"><span aria-hidden="true">%</span>Kârlılık &amp; fiyatlama</a>
          <a href="/ozel-excel-sistemleri"><span aria-hidden="true">▦</span>ERP verisi → yönetici kararı</a>
        </nav>
      </div>

      <picture class="hero-artwork" aria-hidden="true">
        <source media="(min-width: 721px)" srcset="/images/hero.jpg" />
        <img
          src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
          alt=""
          width="1600"
          height="533"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <div class="hero-search-rail" id="hero-search">
      <HeroSearch searchIndex={searchIndex} />
    </div>
  </div>
</section>

<style>
  .hero-section{position:relative;z-index:60;margin:28px 0 46px}
  .hero-shell{position:relative;z-index:60;width:min(1680px,calc(100% - 64px));margin-inline:auto;padding-bottom:30px}
  .hero-panel{position:relative;display:grid;grid-template-columns:minmax(0,.92fr) minmax(520px,1.08fr);align-items:stretch;min-height:520px;overflow:hidden;border:1px solid rgba(15,23,42,.08);border-radius:24px;background:linear-gradient(120deg,#fff 0%,#fff 51%,#f3faf6 100%);box-shadow:0 24px 60px rgba(24,55,38,.13)}
  .hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;padding:48px 28px 58px 50px;min-width:0}
  .hero-trust{width:max-content;max-width:100%;display:inline-flex;align-items:center;gap:7px;margin-bottom:20px;padding:8px 12px;border:1px solid #cfe6d8;border-radius:999px;background:#f6fbf8;color:#234332;font:700 13px/1.25 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.01em}
  .hero-copy h1{max-width:760px;margin:0;color:#0f172a;font:820 clamp(42px,4.1vw,64px)/.99 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.055em;text-wrap:balance}
  .hero-copy h1 span{color:#087a46}
  .hero-summary{max-width:690px;margin:20px 0 0;color:#475569;font:500 18px/1.58 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.015em}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
  .hero-actions a{min-height:72px;display:flex;flex-direction:column;justify-content:center;border-radius:13px;padding:12px 20px;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease,background-color .18s ease}
  .hero-actions a:hover{transform:translateY(-1px)}
  .hero-actions a span{font:800 14px/1.25 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.015em}
  .hero-actions a small{margin-top:5px;font:650 11px/1.2 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;opacity:.78}
  .hero-actions__primary{background:#059669;color:#fff;box-shadow:0 12px 28px rgba(5,150,105,.22)}
  .hero-actions__primary:hover{background:#047857;box-shadow:0 16px 34px rgba(5,150,105,.25)}
  .hero-actions__secondary{border:2px solid #0f172a;background:#fff;color:#0f172a}
  .hero-actions__secondary:hover{background:#f8fafc}
  .hero-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .hero-chips a{display:inline-flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid #dce5df;border-radius:999px;background:#fff;color:#425066;font:700 11px/1 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-decoration:none}
  .hero-chips a>span{font-weight:900;color:#087a46}
  .hero-artwork{position:relative;display:block;min-width:0;overflow:hidden;aspect-ratio:3 / 1;background:#eef3f6}
  .hero-artwork::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#fff 0%,rgba(255,255,255,.72) 6%,rgba(255,255,255,0) 26%);pointer-events:none}
  .hero-artwork img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero-search-rail{position:absolute;left:50%;bottom:0;z-index:70;width:min(720px,calc(100% - 48px));transform:translateX(-50%);scroll-margin-top:90px}

  @media (min-width:721px) and (max-width:1180px){
    .hero-shell{width:calc(100% - 40px)}
    .hero-panel{grid-template-columns:minmax(0,1fr) minmax(420px,.95fr);min-height:490px}
    .hero-copy{padding:42px 18px 52px 34px}
    .hero-copy h1{font-size:clamp(38px,4.8vw,52px)}
    .hero-summary{font-size:16px}
  }

  @media (max-width:900px){
    .hero-panel{grid-template-columns:1fr;min-height:0}
    .hero-copy{padding:38px 34px 100px}
    .hero-artwork{position:absolute;inset:0;opacity:.11}
    .hero-artwork::before{background:linear-gradient(90deg,rgba(255,255,255,.96),rgba(255,255,255,.82))}
  }

  @media (max-width:720px){
    .hero-section{margin:0;padding:14px 0 30px;background:linear-gradient(180deg,#f5faf7 0%,#fff 100%);border-bottom:1px solid #e6ece8}
    .hero-shell{width:calc(100% - 20px);padding:0}
    .hero-panel{display:block;border-radius:24px;border-color:#dfe8e2;background:linear-gradient(145deg,#fff 0%,#fff 72%,#f3faf6 100%);box-shadow:0 16px 40px rgba(15,23,42,.09)}
    .hero-copy{padding:24px 18px 22px}
    .hero-trust{width:100%;justify-content:flex-start;margin-bottom:17px;padding:9px 11px;border-radius:14px;font-size:12px;line-height:1.35;background:#f0faf4}
    .hero-copy h1{max-width:12ch;font-size:clamp(34px,9.7vw,41px);line-height:1.01;letter-spacing:-.055em}
    .hero-summary{max-width:34ch;margin-top:16px;font-size:16px;line-height:1.58;color:#526176}
    .hero-actions{display:grid;grid-template-columns:1fr;gap:10px;margin-top:20px}
    .hero-actions a{min-height:66px;padding:12px 15px;border-radius:16px}
    .hero-actions a span{font-size:15px;line-height:1.2}
    .hero-actions a small{font-size:11px;line-height:1.25}
    .hero-actions__primary{box-shadow:0 12px 26px rgba(5,150,105,.20)}
    .hero-chips{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:16px 0 0;padding:0;overflow:visible}
    .hero-chips a{min-height:50px;justify-content:flex-start;padding:10px 11px;border-radius:14px;font-size:11.5px;line-height:1.25;background:#fff;box-shadow:0 5px 15px rgba(15,23,42,.04)}
    .hero-chips a:nth-child(1){border-color:#cce7d8;background:#f5fbf7}.hero-chips a:nth-child(2){border-color:#d8e4fb;background:#f7f9ff}.hero-chips a:nth-child(3){border-color:#fde2bb;background:#fffaf2}.hero-chips a:nth-child(4){border-color:#e7dcfb;background:#fbf8ff}
    .hero-chips a:nth-child(2)>span{color:#2563eb}.hero-chips a:nth-child(3)>span{color:#d97706}.hero-chips a:nth-child(4)>span{color:#7c3aed}
    .hero-artwork{display:none}
    .hero-search-rail{position:relative;left:auto;bottom:auto;transform:none;width:100%;margin:14px auto 0;scroll-margin-top:74px}
  }

  @media (max-width:370px){
    .hero-shell{width:calc(100% - 16px)}
    .hero-copy{padding:22px 15px 19px}
    .hero-copy h1{font-size:32px}
    .hero-summary{font-size:15px}
    .hero-chips{grid-template-columns:1fr}
  }
</style>

<style is:global>
  @media (max-width:720px){
    .home-v2 .home-shell{width:calc(100% - 24px)!important}
    .home-v2 [data-experience-stage]{contain-intrinsic-size:auto 560px}
    .home-v2 .catalog-proof,.home-v2 .custom-build,.home-v2 .decision-help,.home-v2 .faq-close{padding:44px 0!important}
    .home-v2 .section-head{display:grid!important;grid-template-columns:1fr auto;gap:12px!important;align-items:end!important;margin-bottom:20px!important}
    .home-v2 .section-head h2,.home-v2 .custom-build h2,.home-v2 .decision-intro h2,.home-v2 .authority h2,.home-v2 .faq-close h2,.home-v2 .difference h2{font-size:30px!important;line-height:1.03!important;letter-spacing:-.045em!important;text-wrap:balance}
    .home-v2 .section-head>a{font-size:12px!important;white-space:nowrap}
    .home-v2 .price-levels{margin:0 -12px 17px!important;padding:0 12px 2px;flex-wrap:nowrap!important;overflow-x:auto;scrollbar-width:none}
    .home-v2 .price-levels::-webkit-scrollbar{display:none}
    .home-v2 .price-levels span{flex:0 0 auto;border-radius:999px!important;background:#fff!important}
    .home-v2 .featured-grid{display:grid!important;grid-template-columns:1fr!important;gap:14px!important;margin:0!important;padding:0!important;overflow:visible!important}
    .home-v2 .featured-grid article{border-radius:22px!important;overflow:hidden;box-shadow:0 13px 34px rgba(18,42,26,.08)}
    .home-v2 .featured-grid article>div{padding:18px!important}
    .home-v2 .featured-grid h3{min-height:auto!important;margin:8px 0!important;font-size:21px!important;line-height:1.12!important}
    .home-v2 .featured-grid p{min-height:auto!important;margin-bottom:12px!important;font-size:14px!important;line-height:1.58!important}
    .home-v2 .difference{padding:44px 0!important}
    .home-v2 .difference-grid{grid-template-columns:1fr!important;gap:18px!important}
    .home-v2 .difference p{font-size:15px!important;line-height:1.65!important}
    .home-v2 .difference ul{grid-template-columns:1fr 1fr!important;gap:8px!important;margin-top:18px!important}
    .home-v2 .difference li{min-height:54px;display:flex;align-items:center;padding:11px!important;border-radius:13px;font-size:12px!important}
    .home-v2 .custom-build-grid,.home-v2 .decision-layout,.home-v2 .faq-grid{grid-template-columns:1fr!important;gap:22px!important}
    .home-v2 .custom-actions{gap:10px!important}
    .home-v2 .custom-step{grid-template-columns:38px 1fr!important;padding:15px!important;border:1px solid #e1e8e3;border-radius:17px!important;background:#fff;box-shadow:0 8px 22px rgba(15,23,42,.045)}
    .home-v2 .custom-step strong{font-size:15px!important}.home-v2 .custom-step p{margin-top:5px!important;font-size:13px!important;line-height:1.55!important}
    .home-v2 .custom-cta-card{display:grid!important;gap:13px!important;padding:17px!important;border-radius:18px!important}
    .home-v2 .custom-cta-btn{width:100%;min-height:50px;display:flex;align-items:center;justify-content:center;border-radius:13px!important}
    .home-v2 .decision-grid{grid-template-columns:1fr!important;gap:11px!important}
    .home-v2 .decision-card{border-radius:18px!important;box-shadow:0 8px 20px rgba(15,23,42,.04)}
    .home-v2 .decision-card-body{padding:16px!important}
    .home-v2 .decision-card-body h3{font-size:18px!important;line-height:1.22!important}.home-v2 .decision-card-body p{font-size:13px!important;line-height:1.55!important}
    .home-v2 .authority{padding:42px 0!important}
    .home-v2 .authority-panel{grid-template-columns:1fr!important;gap:24px!important}
    .home-v2 .authority-metrics{grid-template-columns:repeat(3,1fr)!important;gap:7px!important}
    .home-v2 .authority-metrics article{min-width:0;padding:13px 7px!important;text-align:center;border-radius:14px!important}
    .home-v2 .authority-metrics strong{font-size:25px!important}
    .home-v2 .faq-list{display:grid!important;gap:8px!important}.home-v2 .faq-list details{border-radius:15px!important;overflow:hidden}.home-v2 .faq-list summary{min-height:54px;display:flex;align-items:center;padding:0 14px!important;font-size:14px!important}.home-v2 .faq-list details p{font-size:13px!important;line-height:1.6!important}
    .home-v2 .close-actions{display:grid!important;grid-template-columns:1fr 1fr;gap:8px!important}
    .home-v2 .close-actions a{min-height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px!important}
  }
</style>
