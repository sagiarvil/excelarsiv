---
// src/components/mobile/MobileCommerceEngine.astro
import { TEMPLATE_DATA, type TabType } from './template-data';

interface Props {
  initialTab?: TabType;
  whatsappNumber?: string;
}

const {
  initialTab = 'home',
  whatsappNumber = '905419305372'
} = Astro.props;
---

<div class="mobile-commerce-engine-root" data-mobile-commerce-engine data-initial-tab={initialTab} data-wa-number={whatsappNumber}>
  <!-- TOAST NOTIFICATION -->
  <div class="mce-toast hidden" data-mce-toast aria-live="polite">
    <span class="mce-toast__icon">✓</span>
    <p class="mce-toast__text" data-mce-toast-text></p>
  </div>

  <!-- MOBİL HEADER -->
  <header class="mce-header">
    <div class="mce-header__top">
      <div class="mce-header__brand">
        <div class="mce-header__avatar">EX</div>
        <div class="mce-header__titles">
          <div class="mce-header__name-row">
            <span class="mce-header__name">excelarsiv<span class="mce-text-emerald">.com</span></span>
            <span class="mce-badge-pro">PRO</span>
          </div>
          <span class="mce-header__subtitle">17 Yıllık Bankacılık Standartlarında</span>
        </div>
      </div>

      <a
        href="/iletisim"
        data-wa-cta="support"
        data-toast="Finans uzmanı hattına bağlanılıyor..."
        class="mce-btn-live-support"
      >
        <svg class="mce-icon-sm" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
        </svg>
        <span>Uzman Desteği</span>
      </a>
    </div>

    <!-- 3'LÜ NAVİGASYON SEGMENTİ -->
    <nav class="mce-nav-segments" aria-label="Mobil Bölüm Navigasyonu">
      <button type="button" class="mce-segment-btn is-active" data-tab-btn="home">Ana Sayfa</button>
      <button type="button" class="mce-segment-btn" data-tab-btn="sablonlar">Şablonlar</button>
      <button type="button" class="mce-segment-btn" data-tab-btn="ozel-sistemler">Özel Sistem</button>
    </nav>
  </header>

  <!-- 1. SEKME: ANA SAYFA -->
  <section class="mce-tab-panel" data-tab-panel="home">
    <div class="mce-hero-card">
      <div class="mce-hero-pill">
        <svg class="mce-icon-sparkle" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L14.4 8.6L21 11L14.4 13.4L12 20L9.6 13.4L3 11L9.6 8.6L12 2Z" />
        </svg>
        <span>Nakit ve Maliyet Riskini Sıfırla</span>
      </div>

      <h2 class="mce-hero-title">
        Şirketinizin Finansını <span class="mce-hero-highlight">1 Tıkla</span> Güvene Alın.
      </h2>

      <p class="mce-hero-lead">
        Rastgele formüllerle vakit kaybetmeyin. 17 yıllık ticari bankacılık ve finans mühendisliği tecrübesiyle hatasız kodlandı.
      </p>

      <div class="mce-stats-grid">
        <div class="mce-stat-item">
          <span class="mce-stat-val mce-text-amber">2.400+</span>
          <span class="mce-stat-lbl">KOBİ Patronu</span>
        </div>
        <div class="mce-stat-item">
          <span class="mce-stat-val mce-text-emerald-bright">%100</span>
          <span class="mce-stat-lbl">Banka Uyumlu</span>
        </div>
        <div class="mce-stat-item">
          <span class="mce-stat-val mce-text-white">4.9/5</span>
          <span class="mce-stat-lbl">Müşteri Puanı</span>
        </div>
      </div>

      <div class="mce-hero-actions">
        <button type="button" class="mce-hero-btn-primary" data-switch-tab="sablonlar">
          <span>Şablonu Seç</span>
          <span>→</span>
        </button>
        <button type="button" class="mce-hero-btn-secondary" data-switch-tab="ozel-sistemler">
          <span>Özel Çözüm İste</span>
        </button>
      </div>
    </div>

    <!-- Otorite & Saha Mesajı -->
    <div class="mce-authority-card">
      <div class="mce-authority-badge">17 YIL</div>
      <div class="mce-authority-copy">
        <h3 class="mce-authority-heading">Esnaf ve Sanayicinin Diliyle Çözüm</h3>
        <p class="mce-authority-text">
          "Nakit sıkışıklığını, banka kredi risk rasyolarını ve esnafın dertlerini bizzat sahada yaşayarak çözdük. Bu modeller şirketinizin gerçek saha zırhıdır."
        </p>
      </div>
    </div>

    <!-- Hızlı Çözüm Listesi -->
    <div class="mce-quick-list-wrap">
      <div class="mce-quick-list-header">
        <span class="mce-section-kicker">Hemen İndirilebilir Modeller</span>
        <button type="button" class="mce-quick-link" data-switch-tab="sablonlar">Tümünü Gör →</button>
      </div>

      <div class="mce-quick-items">
        {TEMPLATE_DATA.map((item) => (
          <div
            class="mce-quick-card"
            data-open-modal={item.id}
            role="button"
            tabindex="0"
          >
            <div class="mce-quick-card__left">
              <div class="mce-quick-card__icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="8" y1="13" x2="16" y2="13" />
                  <line x1="8" y1="17" x2="16" y2="17" />
                  <line x1="10" y1="9" x2="8" y2="9" />
                </svg>
              </div>
              <div>
                <span class={`mce-tag-pill ${item.badgeColor}`}>{item.authorityBadge}</span>
                <h4 class="mce-quick-card__title">{item.title}</h4>
                <p class="mce-quick-card__metric">
                  <svg class="mce-icon-check" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
                  </svg>
                  <span>{item.solutionMetric}</span>
                </p>
              </div>
            </div>

            <div class="mce-quick-card__right">
              <span class="mce-price-val">₺{item.price}</span>
              <span class="mce-price-orig">₺{item.originalPrice}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. SEKME: ŞABLONLAR -->
  <section class="mce-tab-panel hidden" data-tab-panel="sablonlar">
    <div class="mce-filter-pills" role="tablist">
      <button type="button" class="mce-filter-pill is-active" data-cat-filter="all">Tüm Sistemler</button>
      <button type="button" class="mce-filter-pill" data-cat-filter="finans">Finans & Nakit</button>
      <button type="button" class="mce-filter-pill" data-cat-filter="kobi">KOBİ Yönetim</button>
      <button type="button" class="mce-filter-pill" data-cat-filter="maliyet">Maliyet & Sanayi</button>
    </div>

    <div class="mce-template-cards">
      {TEMPLATE_DATA.map((item) => (
        <article class="mce-template-card" data-template-id={item.id}>
          <div class="mce-template-card__head">
            <div>
              <span class="mce-category-tag">{item.category}</span>
              <h3 class="mce-template-card__title">{item.title}</h3>
            </div>
            <div class="mce-rating-badge">
              <svg class="mce-star-icon" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              <span>{item.rating}</span>
            </div>
          </div>

          <div class="mce-template-card__body">
            <div class="mce-risk-row">
              <span class="mce-dot-rose"></span>
              <span class="mce-risk-text"><strong>Önlenecek Risk:</strong> {item.painPoint}</span>
            </div>
            <div class="mce-value-row">
              <span class="mce-dot-emerald"></span>
              <span class="mce-value-text"><strong>Sağlanan Değer:</strong> {item.solutionMetric}</span>
            </div>
            <div class="mce-tags-row">
              {item.tags.map(t => (
                <span class="mce-tag-item">{t}</span>
              ))}
            </div>
          </div>

          <div class="mce-template-card__foot">
            <div class="mce-price-box">
              <div class="mce-price-row">
                <span class="mce-foot-price">₺{item.price}</span>
                <span class="mce-foot-orig">₺{item.originalPrice}</span>
              </div>
              <span class="mce-foot-hint">
                <svg class="mce-icon-sparkle-sm" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2L14.4 8.6L21 11L14.4 13.4L12 20L9.6 13.4L3 11L9.6 8.6L12 2Z" />
                </svg>
                Anında İndir & Hemen Kullan
              </span>
            </div>

            <div class="mce-foot-actions">
              <button type="button" class="mce-btn-preview" data-open-modal={item.id}>Önizle</button>
              <a
                href={item.shopierUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-toast="Ödeme sayfasına yönlendiriliyorsunuz..."
                class="mce-btn-buy"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                <span>Hemen Al</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 3. SEKME: ÖZEL SİSTEMLER -->
  <section class="mce-tab-panel hidden" data-tab-panel="ozel-sistemler">
    <div class="mce-custom-hero">
      <span class="mce-custom-hero__pill">Terzi Usulü Finans & Yazılım Mimarisi</span>
      <h2 class="mce-custom-hero__title">Şirketinizin Tam İhtiyacına Özel Excel & VBA Modeli</h2>
      <p class="mce-custom-hero__lead">
        Pahalı ERP paketlerine gerek kalmadan; 17 yıllık bankacılık tecrübesiyle tek tuşla çalışan sisteminizi kuralım.
      </p>
    </div>

    <div class="mce-configurator" data-configurator>
      <div class="mce-configurator__head">
        <span class="mce-configurator__title">İhtiyaç Konfigüratörü</span>
        <span class="mce-step-badge" data-step-indicator>Adım 1 / 3</span>
      </div>

      <!-- ADIM 1 -->
      <div class="mce-config-step" data-step="1">
        <span class="mce-step-question">1. İşletmenizin ana ihtiyacı nedir?</span>
        <div class="mce-options-stack">
          {[
            'Nakit Akış, Kredi & Banka Risk Yönetimi',
            'Üretim Reçetesi & SKDM Birim Maliyet',
            'KOBİ Gelir-Gider & Satış Dashboard',
            'Özel VBA Makro / Otomasyon / API'
          ].map((item) => (
            <button type="button" class="mce-option-btn" data-need-choice={item}>
              <span>{item}</span>
              <span>→</span>
            </button>
          ))}
        </div>
      </div>

      <!-- ADIM 2 -->
      <div class="mce-config-step hidden" data-step="2">
        <span class="mce-step-question">2. Aylık veri/işlem hacminiz:</span>
        <div class="mce-options-stack">
          {[
            'Küçük Ölçek (< 1.000 Satır/Ay)',
            'Orta Ölçek (1.000 - 50.000 Satır/Ay)',
            'Büyük Ölçek (50.000+ Satır / Power Query)'
          ].map((vol) => (
            <button type="button" class="mce-option-btn" data-volume-choice={vol}>
              <span>{vol}</span>
              <span>→</span>
            </button>
          ))}
        </div>
        <button type="button" class="mce-btn-back" data-step-goto="1">← Önceki Adıma Dön</button>
      </div>

      <!-- ADIM 3 -->
      <div class="mce-config-step hidden" data-step="3">
        <span class="mce-step-question">3. Proje teslim önceliğiniz:</span>
        <div class="mce-urgency-grid">
          {['24-48 Saat (Acil)', '3-7 İş Günü', '15 Gün İçinde', 'Aylık Danışmanlık'].map((urg) => (
            <button type="button" class="mce-urgency-btn" data-urgency-choice={urg}>
              {urg}
            </button>
          ))}
        </div>

        <div class="mce-summary-box">
          <span class="mce-summary-kicker">Özet Talep</span>
          <div class="mce-summary-need" data-summary-need>Nakit Akış, Kredi & Banka Risk Yönetimi</div>
          <div class="mce-summary-meta" data-summary-meta>Orta Ölçek (1.000 - 50.000 Satır/Ay) • Bu Hafta İçinde</div>
        </div>

        <a
          href="/iletisim"
          data-wa-cta="config-submit"
          class="mce-btn-wa-submit"
          data-wa-submit-btn
        >
          <svg class="mce-icon-sm" viewBox="0 0 24 24" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
          </svg>
          <span>Teklifi WhatsApp'tan Anında Al</span>
        </a>

        <button type="button" class="mce-btn-back" data-step-goto="2">← Seçimleri Düzenle</button>
      </div>
    </div>
  </section>

  <!-- CANLI BOTTOM SHEET MODAL (Önizleme) -->
  <div class="mce-modal-backdrop hidden" data-modal-backdrop>
    <div class="mce-modal-sheet" data-modal-sheet>
      <div class="mce-modal-drag-bar-wrap">
        <div class="mce-modal-drag-bar"></div>
        <button type="button" class="mce-modal-close" data-modal-close aria-label="Kapat">✕</button>
      </div>

      <div>
        <span class="mce-modal-badge" data-modal-badge>17Y Banka Kredi Standardı</span>
        <h3 class="mce-modal-title" data-modal-title>13 Haftalık Dinamik Nakit Akım & Likidite Modeli</h3>
      </div>

      <!-- Simüle Excel Dashboard -->
      <div class="mce-simulated-dashboard">
        <div class="mce-dashboard-header">
          <span class="mce-dash-file">SISTEM_DASHBOARD.XLSX</span>
          <span class="mce-dash-status">● Korumalı Kod</span>
        </div>
        <div class="mce-dash-metrics">
          <div class="mce-dash-box">
            <span class="mce-dash-lbl">Kasa Pozisyonu</span>
            <span class="mce-dash-val mce-text-emerald-bright">₺1.840.000</span>
          </div>
          <div class="mce-dash-box">
            <span class="mce-dash-lbl">Banka DSCR</span>
            <span class="mce-dash-val mce-text-blue">1.45x</span>
          </div>
          <div class="mce-dash-box">
            <span class="mce-dash-lbl">Risk Puanı</span>
            <span class="mce-dash-val mce-text-amber">Güvenli</span>
          </div>
        </div>
      </div>

      <div class="mce-modal-trust-list">
        <div class="mce-modal-trust-item">
          <svg class="mce-icon-check" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
          </svg>
          <span>17 Yıllık bankacılık ve finans risk denetim standartlarında</span>
        </div>
        <div class="mce-modal-trust-item">
          <svg class="mce-icon-check" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
          </svg>
          <span>Ödeme sonrası anında dosya indirme linki ve e-posta teslimatı</span>
        </div>
      </div>

      <div class="mce-modal-actions">
        <div>
          <span class="mce-modal-price" data-modal-price>₺649</span>
          <span class="mce-modal-orig" data-modal-orig>₺1299</span>
        </div>
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="mce-modal-cta"
          data-modal-cta
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Hemen İndir ve Başla</span>
        </a>
      </div>
    </div>
  </div>

  <!-- BAŞPARMAK SABİT DANIŞMA BARI -->
  <nav class="mce-thumb-bar">
    <div>
      <span class="mce-thumb-sub">17 Yıllık Bankacılık Uzmanlığı</span>
      <span class="mce-thumb-main">Doğrudan Uzmanla Görüş</span>
    </div>
    <a
      href="/iletisim"
      data-wa-cta="ask"
      data-toast="WhatsApp canlı hattı açılıyor..."
      class="mce-thumb-wa-btn"
    >
      <svg class="mce-icon-sm" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
      </svg>
      <span>WhatsApp ile Sor</span>
    </a>
  </nav>
</div>

<script type="application/json" id="mce-template-data" set:html={JSON.stringify(TEMPLATE_DATA)}></script>

<script>
  function initMobileCommerceEngine() {
    const root = document.querySelector<HTMLElement>('[data-mobile-commerce-engine]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const dataEl = document.getElementById('mce-template-data');
    const templates = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    const waNumber = root.dataset.waNumber || '905419305372';
    const waBase = `https://wa.me/${waNumber}?text=`;

    // Connect dynamic WhatsApp links on client mount
    root.querySelectorAll<HTMLAnchorElement>('[data-wa-cta]').forEach(a => {
      const type = a.getAttribute('data-wa-cta');
      if (type === 'support') {
        a.href = waBase + encodeURIComponent('Merhaba, excelarsiv.com üzerinden danışmanlık almak istiyorum.');
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      } else if (type === 'ask') {
        a.href = waBase + encodeURIComponent('Merhaba, Excel sistemleri hakkında danışmak istiyorum.');
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      }
    });

    // Toast
    const toast = root.querySelector<HTMLElement>('[data-mce-toast]');
    const toastText = root.querySelector<HTMLElement>('[data-mce-toast-text]');
    let toastTimeout: any = null;

    function showToast(msg: string) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
      }, 2800);
    }

    // Bind generic toast clicks
    root.querySelectorAll<HTMLElement>('[data-toast]').forEach(el => {
      el.addEventListener('click', () => {
        const msg = el.getAttribute('data-toast');
        if (msg) showToast(msg);
      });
    });

    // Tab Switching
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    const tabPanels = root.querySelectorAll<HTMLElement>('[data-tab-panel]');

    function switchTab(targetTab: string) {
      tabBtns.forEach(btn => {
        const isActive = btn.getAttribute('data-tab-btn') === targetTab;
        btn.classList.toggle('is-active', isActive);
        if (isActive) {
          if (targetTab === 'home') btn.style.background = 'linear-gradient(to right, #2563eb, #4f46e5)';
          else if (targetTab === 'sablonlar') btn.style.background = 'linear-gradient(to right, #059669, #0d9488)';
          else btn.style.background = 'linear-gradient(to right, #f59e0b, #ea580c)';
          btn.style.color = '#ffffff';
        } else {
          btn.style.background = 'transparent';
          btn.style.color = '#475569';
        }
      });

      tabPanels.forEach(panel => {
        const match = panel.getAttribute('data-tab-panel') === targetTab;
        panel.classList.toggle('hidden', !match);
      });

      if (targetTab === 'home') showToast('Ana Sayfa');
      else if (targetTab === 'sablonlar') showToast('Hazır şablonlar açıldı');
      else if (targetTab === 'ozel-sistemler') showToast('Özel sistem konfigüratörü aktif');
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab-btn');
        if (tab) switchTab(tab);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-switch-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-switch-tab');
        if (tab) switchTab(tab);
      });
    });

    // Category filter in Şablonlar
    const catPills = root.querySelectorAll<HTMLButtonElement>('[data-cat-filter]');
    catPills.forEach(pill => {
      pill.addEventListener('click', () => {
        catPills.forEach(p => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        const text = pill.textContent?.trim() || '';
        showToast(`${text} listelendi`);
      });
    });

    // Configurator state
    let customData = {
      needType: 'Finansal Modelleme & Nakit Akış',
      dataVolume: 'Orta Ölçek (1.000 - 50.000 Satır/Ay)',
      urgency: 'Bu Hafta İçinde'
    };

    const stepIndicator = root.querySelector<HTMLElement>('[data-step-indicator]');
    const steps = root.querySelectorAll<HTMLElement>('[data-step]');
    const summaryNeed = root.querySelector<HTMLElement>('[data-summary-need]');
    const summaryMeta = root.querySelector<HTMLElement>('[data-summary-meta]');
    const waSubmitBtn = root.querySelector<HTMLAnchorElement>('[data-wa-submit-btn]');

    function updateWaSubmitLink() {
      if (!waSubmitBtn) return;
      const text = `Merhaba, excelarsiv.com üzerinden özel sistem talep ediyorum:\n- Kapsam: ${customData.needType}\n- Hacim: ${customData.dataVolume}\n- Süre: ${customData.urgency}\nMimari değerlendirme ve teklif rica ediyorum.`;
      waSubmitBtn.href = waBase + encodeURIComponent(text);
      waSubmitBtn.target = '_blank';
      waSubmitBtn.rel = 'noopener noreferrer';
      if (summaryNeed) summaryNeed.textContent = customData.needType;
      if (summaryMeta) summaryMeta.textContent = `${customData.dataVolume} • ${customData.urgency}`;
    }

    function gotoStep(stepNum: number) {
      if (stepIndicator) stepIndicator.textContent = `Adım ${stepNum} / 3`;
      steps.forEach(s => {
        const match = s.getAttribute('data-step') === String(stepNum);
        s.classList.toggle('hidden', !match);
      });
      updateWaSubmitLink();
    }

    root.querySelectorAll<HTMLButtonElement>('[data-need-choice]').forEach(btn => {
      btn.addEventListener('click', () => {
        const choice = btn.getAttribute('data-need-choice');
        if (choice) {
          customData.needType = choice;
          gotoStep(2);
          showToast(`Seçildi: ${choice}`);
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-volume-choice]').forEach(btn => {
      btn.addEventListener('click', () => {
        const choice = btn.getAttribute('data-volume-choice');
        if (choice) {
          customData.dataVolume = choice;
          gotoStep(3);
          showToast(`Hacim: ${choice}`);
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-urgency-choice]').forEach(btn => {
      btn.addEventListener('click', () => {
        const choice = btn.getAttribute('data-urgency-choice');
        if (choice) {
          customData.urgency = choice;
          root.querySelectorAll('[data-urgency-choice]').forEach(b => b.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          updateWaSubmitLink();
          showToast(`Süre: ${choice}`);
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-step-goto]').forEach(btn => {
      btn.addEventListener('click', () => {
        const s = parseInt(btn.getAttribute('data-step-goto') || '1', 10);
        gotoStep(s);
      });
    });

    if (waSubmitBtn) {
      waSubmitBtn.addEventListener('click', () => {
        showToast('WhatsApp teklif akışı başlatıldı');
      });
    }

    // Modal Preview
    const modalBackdrop = root.querySelector<HTMLElement>('[data-modal-backdrop]');
    const modalClose = root.querySelector<HTMLElement>('[data-modal-close]');
    const modalBadge = root.querySelector<HTMLElement>('[data-modal-badge]');
    const modalTitle = root.querySelector<HTMLElement>('[data-modal-title]');
    const modalPrice = root.querySelector<HTMLElement>('[data-modal-price]');
    const modalOrig = root.querySelector<HTMLElement>('[data-modal-orig]');
    const modalCta = root.querySelector<HTMLAnchorElement>('[data-modal-cta]');

    function openModal(id: string) {
      const item = templates.find((t: any) => t.id === id);
      if (!item || !modalBackdrop) return;

      if (modalBadge) {
        modalBadge.textContent = item.authorityBadge;
        modalBadge.className = `mce-modal-badge ${item.badgeColor}`;
      }
      if (modalTitle) modalTitle.textContent = item.title;
      if (modalPrice) modalPrice.textContent = `₺${item.price}`;
      if (modalOrig) modalOrig.textContent = `₺${item.originalPrice}`;
      if (modalCta) {
        modalCta.href = item.shopierUrl || `https://www.shopier.com/49652321`;
      }

      modalBackdrop.classList.remove('hidden');
      showToast(`${item.title} önizlemesi açıldı`);
    }

    function closeModal() {
      if (modalBackdrop) modalBackdrop.classList.add('hidden');
    }

    root.querySelectorAll<HTMLElement>('[data-open-modal]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = el.getAttribute('data-open-modal');
        if (id) openModal(id);
      });
    });

    if (modalClose) {
      modalClose.addEventListener('click', closeModal);
    }
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) closeModal();
      });
    }

    // Set initial tab styling
    const initial = root.dataset.initialTab || 'home';
    switchTab(initial);
    updateWaSubmitLink();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileCommerceEngine);
  } else {
    initMobileCommerceEngine();
  }
</script>

