---
import type { UrunGorselManifest } from '../../lib/urun-hikayesi/turler.ts';
import NakitAkisiSahnesi from './sahneler/NakitAkisiSahnesi.astro';
import TahsilatSahnesi from './sahneler/TahsilatSahnesi.astro';
import StokSahnesi from './sahneler/StokSahnesi.astro';
import KarlilikSahnesi from './sahneler/KarlilikSahnesi.astro';
import PosSahnesi from './sahneler/PosSahnesi.astro';
import VadeSahnesi from './sahneler/VadeSahnesi.astro';
import BordroSahnesi from './sahneler/BordroSahnesi.astro';
import KrediSahnesi from './sahneler/KrediSahnesi.astro';
import PremiumPanoSahnesi from './sahneler/PremiumPanoSahnesi.astro';

interface Props {
  visual: UrunGorselManifest;
}

const { visual } = Astro.props;

const sahneHaritasi = {
  'nakit-akisi': NakitAkisiSahnesi,
  'tahsilat-takibi': TahsilatSahnesi,
  'stok-yonetimi': StokSahnesi,
  'karlilik-takibi': KarlilikSahnesi,
  'pos-mutabakat': PosSahnesi,
  'vade-takibi': VadeSahnesi,
  'bordro-yuku': BordroSahnesi,
  'kredi-taksit': KrediSahnesi,
  'premium-pano': PremiumPanoSahnesi,
  'fonksiyon-paketi': PremiumPanoSahnesi,
} as const;

const Sahne = sahneHaritasi[visual.sceneKey] ?? PremiumPanoSahnesi;
---

<Sahne visual={visual} />

<style is:global>
  /* Sahne kütüphanesi ortak dili — Product Story Card görselleri bu sınıflarla kurulur. */
  .sahne-kok {
    --sahne-vurgu: #0d8a4b;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 224px;
    font-family: var(--font-mono);
  }
  .sahne-cerceve {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--xl-border);
    border-radius: 0;
    box-shadow: 0 14px 34px rgba(27, 27, 31, 0.08);
  }
  .sahne-baslik {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--sahne-vurgu) 8%, #ffffff), #ffffff 78%);
    border-bottom: 1px solid var(--xl-grid);
  }
  .sahne-rozet {
    padding: 3px 9px;
    border-radius: 0;
    background: color-mix(in srgb, var(--sahne-vurgu) 14%, #ffffff);
    color: var(--sahne-vurgu);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .sahne-dosya {
    margin-left: auto;
    max-width: 46%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 9px;
    color: var(--xl-ink-3);
  }
  .sahne-govde {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    min-height: 0;
  }
  .sahne-alt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 12px;
    background: #f2f4f1;
    border-top: 1px solid var(--xl-grid);
    font-size: 10px;
    font-weight: 800;
    color: var(--xl-ink-2);
  }
  .sahne-sinyal {
    color: var(--sahne-vurgu);
  }
  .sahne-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }
  .sahne-kpi {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 6px 7px;
    border-radius: 0;
    background: #f8faf9;
  }
  .sahne-kpi-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 8px;
    font-weight: 800;
    color: var(--xl-ink-3);
  }
  .sahne-kpi-deger {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--xl-ink-900);
  }
  .sahne-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 10px;
  }
  .sahne-tablo th {
    padding: 4px 6px;
    border-bottom: 1px solid var(--xl-grid);
    text-align: left;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--xl-ink-3);
  }
  .sahne-tablo td {
    padding: 5px 6px;
    border-bottom: 1px solid var(--xl-grid);
    font-weight: 700;
    color: var(--xl-ink-700);
  }
  .sahne-tablo tr:last-child td {
    border-bottom: 0;
  }
  .sahne-olumlu {
    color: var(--xl-green-dark) !important;
  }
  .sahne-uyari {
    color: #14532d !important;
  }
  .sahne-cip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: 0;
    background: color-mix(in srgb, var(--sahne-vurgu) 10%, #ffffff);
    color: var(--sahne-vurgu);
    font-size: 10px;
    font-weight: 800;
  }
  .sahne-cubuk-grup {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    flex: 1;
    min-height: 48px;
  }
  .sahne-cubuk {
    border-radius: 0;
  }
</style>
