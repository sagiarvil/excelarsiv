---
import type { UrunGorselManifest } from '../../../lib/urun-hikayesi/turler.ts';
import { accentRenk } from '../../../lib/urun-hikayesi/marka-tokenleri.ts';

interface Props {
  visual: UrunGorselManifest;
}

const { visual } = Astro.props;
const vurgu = accentRenk(visual.fingerprint.accent);
const satirlar = visual.ui.rows ?? [];
const olcutler = visual.ui.metrics ?? [];

const kalanOran = 63;
---

<div class="sahne-kok" style={`--sahne-vurgu:${vurgu}`}>
  <div class="sahne-cerceve">
    <div class="sahne-baslik">
      <span class="sahne-rozet">ÖDEME PLANI</span>
      <span class="sahne-dosya">{visual.slug}.xlsx</span>
    </div>
    <div class="sahne-govde">
      <table class="sahne-tablo">
        <thead>
          <tr>
            <th>Dönem</th>
            <th>Tutar</th>
          </tr>
        </thead>
        <tbody>
          {satirlar.map((satir, i) => (
            <tr key={i}>
              <td>{satir.left}</td>
              <td class:list={[satir.tone === 'uyari' ? 'sahne-uyari' : satir.tone === 'olumlu' ? 'sahne-olumlu' : '']}>{satir.right}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div style="display:flex;flex-direction:column;gap:4px;flex:1;justify-content:center;min-height:0">
        <div style="display:flex;justify-content:space-between;font-size:8px;font-weight:800;color:var(--xl-ink-3)">
          <span>KALAN</span>
          <span>₺1,42M / ₺2,24M</span>
        </div>
        <div style="display:flex;width:100%;height:10px;border-radius: 0;background:#eef1ee;overflow:hidden">
          <div style={`width:${kalanOran}%;background:${vurgu}`}></div>
        </div>
      </div>
      <div class="sahne-kpi-grid">
        {olcutler.map((o) => (
          <div class="sahne-kpi">
            <span class="sahne-kpi-label">{o.label}</span>
            <strong class:list={['sahne-kpi-deger', o.tone === 'uyari' ? 'sahne-uyari' : '']}>{o.value}</strong>
          </div>
        ))}
      </div>
      <div class="sahne-cip sahne-sinyal">{visual.resultSignal}</div>
    </div>
    <div class="sahne-alt">
      <span>✓ Formül Güvencesi</span>
      <span>EXCEL ARŞİV</span>
    </div>
  </div>
</div>
