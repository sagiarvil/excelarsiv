---
import type { UrunGorselManifest } from '../../../lib/urun-hikayesi/turler.ts';
import { accentRenk } from '../../../lib/urun-hikayesi/marka-tokenleri.ts';

interface Props {
  visual: UrunGorselManifest;
}

const { visual } = Astro.props;
const vurgu = accentRenk(visual.fingerprint.accent);
const satirlar = visual.ui.rows ?? [];
const olcutler = visual.ui.metrics ?? [];

// POS mutabakat hunisi: Brüt → Komisyon → Net (deterministik genişlikler)
const huni = [
  { genislik: 100, renk: 'var(--xl-ink-2)' },
  { genislik: 52, renk: vurgu },
  { genislik: 96, renk: 'var(--xl-green)' },
];
---

<div class="sahne-kok" style={`--sahne-vurgu:${vurgu}`}>
  <div class="sahne-cerceve">
    <div class="sahne-baslik">
      <span class="sahne-rozet">POS MUTABAKAT</span>
      <span class="sahne-dosya">{visual.slug}.xlsx</span>
    </div>
    <div class="sahne-govde">
      <div style="display:flex;flex-direction:column;gap:6px;flex:1;justify-content:center;min-height:0">
        {satirlar.map((satir, i) => (
          <div key={i} style="display:flex;flex-direction:column;gap:2px;align-items:center">
            <div
              class:list={[satir.tone === 'uyari' ? 'sahne-uyari' : satir.tone === 'olumlu' ? 'sahne-olumlu' : '']}
              style={`width:${huni[i]?.genislik ?? 80}%;height:16px;border-radius: 0;background:${huni[i]?.renk ?? '#c9d4cf'};color:#fff;display:grid;place-items:center;font-size:9px;font-weight:800`}
            >{satir.left}</div>
            <span style="font-size:9px;font-weight:800;color:var(--xl-ink-3)">{satir.right}</span>
          </div>
        ))}
      </div>
      <div class="sahne-kpi-grid">
        {olcutler.map((o) => (
          <div class="sahne-kpi">
            <span class="sahne-kpi-label">{o.label}</span>
            <strong class:list={['sahne-kpi-deger', o.tone === 'uyari' ? 'sahne-uyari' : '']}>{o.value}</strong>
          </div>
        ))}
      </div>
      <div class="sahne-cip sahne-sinyal">{visual.resultSignal}</div>
    </div>
    <div class="sahne-alt">
      <span>✓ Formül Güvencesi</span>
      <span>EXCEL ARŞİV</span>
    </div>
  </div>
</div>
