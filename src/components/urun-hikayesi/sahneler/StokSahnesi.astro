---
import type { UrunGorselManifest } from '../../../lib/urun-hikayesi/turler.ts';
import { accentRenk } from '../../../lib/urun-hikayesi/marka-tokenleri.ts';

interface Props {
  visual: UrunGorselManifest;
}

const { visual } = Astro.props;
const vurgu = accentRenk(visual.fingerprint.accent);
const satirlar = visual.ui.rows ?? [];
const olcutler = visual.ui.metrics ?? [];

const raflar = [34, 58, 46, 70, 52, 40, 62];
---

<div class="sahne-kok" style={`--sahne-vurgu:${vurgu}`}>
  <div class="sahne-cerceve">
    <div class="sahne-baslik">
      <span class="sahne-rozet">STOK & NAKİT</span>
      <span class="sahne-dosya">{visual.slug}.xlsx</span>
    </div>
    <div class="sahne-govde">
      <div class="sahne-kpi-grid">
        {olcutler.map((o) => (
          <div class="sahne-kpi">
            <span class="sahne-kpi-label">{o.label}</span>
            <strong class:list={['sahne-kpi-deger', o.tone === 'uyari' ? 'sahne-uyari' : '']}>{o.value}</strong>
          </div>
        ))}
      </div>
      <table class="sahne-tablo">
        <thead>
          <tr>
            <th>Kod</th>
            <th>Durum</th>
          </tr>
        </thead>
        <tbody>
          {satirlar.map((satir, i) => (
            <tr key={i}>
              <td>{satir.left}</td>
              <td class:list={[satir.tone === 'uyari' ? 'sahne-uyari' : 'sahne-olumlu']}>{satir.right}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="sahne-cubuk-grup" style="min-height:40px;align-items:flex-end">
        {raflar.map((yukseklik, i) => (
          <div key={i} class="sahne-cubuk" style={`height:${yukseklik}%;background:${i % 3 === 0 ? 'var(--sahne-vurgu)' : i % 3 === 1 ? '#93b4a5' : '#c9d4cf'};flex:1`}></div>
        ))}
      </div>
    </div>
    <div class="sahne-alt">
      <span>✓ Formül Güvencesi</span>
      <span class="sahne-sinyal">{visual.resultSignal}</span>
    </div>
  </div>
</div>
