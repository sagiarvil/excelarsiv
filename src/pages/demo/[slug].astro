---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({
    params: { slug: template.id },
    props: { template },
  }));
}

interface Props {
  template: CollectionEntry<'templates'>;
}

const { template } = Astro.props;
const t = template.data;
const productUrl = `/sablon/${template.id}`;
const demoAnchor = `${productUrl}#demo-indir`;
const title = `${t.name} — Ücretsiz Demo | Excel Arşiv`;
const description = `${t.name} için ücretsiz demo: satın almadan önce 20 kayıtlık değerlendirme sürümünü indirin ve gerçek dosya yapısını inceleyin.`;
---

<CommerceLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-8">
    <p class="font-mono text-xs tracking-widest text-ink-400">ÜCRETSİZ DEMO</p>
    <h1 class="display mt-4">{t.name} — ücretsiz demo</h1>
    <p class="lead mt-6">{t.summary}</p>
    <p class="body-sm mt-6">
      Satın almadan önce deneyin. Bu değerlendirme sürümü ürünün formül ve karar mantığını kısıtlı veri ile gösterir;
      tam sürüm satın alma sonrası Excel Arşiv üzerinden indirilir.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={demoAnchor}>Ücretsiz demoyu başlat</Button>
      <Button href={`${productUrl}#satin-al`} variant="secondary">Tam sürümü incele</Button>
    </div>
    <ul class="mt-10 space-y-3 body-sm">
      <li>· Minimum Excel: {t.minExcelVersion}</li>
      <li>· Sayfa sayısı: {t.sheetCount}</li>
      <li>· Fiyat (KDV dahil): {t.priceTL.toLocaleString('tr-TR')} TL</li>
      <li>· Dil / locale: Türkçe arayüz; formül ayıracı virgül. İngilizce Excel’de bölge ayarını TR yapın.</li>
    </ul>
    <section class="demo-unlock mt-12" aria-labelledby="demo-unlock-title">
      <h2 id="demo-unlock-title">Tam sürümde neler açılır?</h2>
      <dl>
        <div>
          <dt>Demo</dt>
          <dd>20 kayıtlık değerlendirme sürümü</dd>
        </div>
        <div>
          <dt>Tam sürüm</dt>
          <dd>Sınırsız operasyonel kayıt, tam raporlama, tüm kontroller ve tam dashboard</dd>
        </div>
      </dl>
      <ul>
        {t.outputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </section>
</CommerceLayout>

<style>
  .demo-unlock { padding: 20px; border: 1px solid #d7e2db; border-radius: 16px; background: #f6f9f7; }
  .demo-unlock h2 { margin: 0; font-size: 18px; }
  .demo-unlock dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0 0; }
  .demo-unlock dt { font-family: var(--font-mono); font-size: 10px; font-weight: 800; color: #0d7040; }
  .demo-unlock dd { margin: 4px 0 0; font-size: 13px; line-height: 1.5; }
  .demo-unlock ul { display: grid; gap: 6px; margin: 16px 0 0; padding-left: 18px; font-size: 13px; }
  @media (max-width: 640px) { .demo-unlock dl { grid-template-columns: 1fr; } }
</style>
