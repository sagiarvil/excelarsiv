    }
    .magic-hud-canvas {
      width: 100%;
      height: 60px;
      display: block;
    }
    .magic-hud-ctrls {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    .magic-hud-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #94A3B8;
      font-size: 10.5px;
      font-weight: 700;
      padding: 7px 4px;
      border-radius: 6px;
