      color: #ffffff !important;
    }
    .magic-cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 22px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      background: #ffffff;
      color: #090B0E;
      border: 1px solid #ffffff;
      border-radius: 4px;
      box-shadow: 0 4px 16px rgba(255, 255, 255, 0.12);
      transition: all 0.25s ease;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .magic-cta-btn:hover {
      background: rgba(255, 255, 255, 0.9);
      border-color: rgba(255, 255, 255, 0.9);
      box-shadow: 0 6px 24px rgba(255, 255, 255, 0.22);
      transform: translateY(-1px);
    }
    .magic-cta-btn--outline {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: #ffffff;
      box-shadow: none;
    }
    .magic-cta-btn--outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: #ffffff;
      color: #ffffff;
      transform: translateY(-1px);
    }

    /* ==========================================================================
       HARDCORE NEXT-GEN KINETIC & 3D MOTION SYSTEM
       ========================================================================== */
    /* Scroll Progress Laser Line */
    .magic-scroll-scanner {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, #38BDF8, #818CF8, #E05A2B);
      box-shadow: 0 0 14px #38BDF8, 0 0 28px #818CF8;
      z-index: 9999;
      pointer-events: none;
      transition: width 0.1s linear;
    }

    /* Ambient Cursor Holographic Follower */
    .magic-mouse-glow {
      position: fixed;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.08) 0%, rgba(224, 90, 43, 0.03) 40%, transparent 70%);
      pointer-events: none;
      z-index: 999;
      transform: translate(-50%, -50%);
      transition: opacity 0.3s ease;
      mix-blend-mode: screen;
    }

    /* Glitch & Hologram Keyframe Animations */
    @keyframes holoGlitch {
      0%, 100% { text-shadow: 0 0 1px transparent; }
      20% { text-shadow: -2px 0 #38BDF8, 2px 0 #E05A2B; }
      40% { text-shadow: 2px 0 #38BDF8, -2px 0 #E05A2B; }
      60% { text-shadow: 0 0 10px rgba(56, 189, 248, 0.6); }
    }
    .glitch-text:hover {
      animation: holoGlitch 0.4s infinite;
    }

    /* Hardcore 3D Card Hover Depth & Dynamic Glare */
    .magic-work-box,
    .magic-work-card,
    .magic-pillar-card,
    .magic-case-card,
    .magic-pricing-card,
    .magic-step-card {
      transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
      transform-style: preserve-3d;
      will-change: transform;
    }
    .magic-work-box:hover,
    .magic-work-card:hover,
    .magic-pillar-card:hover,
    .magic-case-card:hover,
    .magic-pricing-card:hover,
    .magic-step-card:hover {
      border-color: rgba(56, 189, 248, 0.5) !important;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75), 0 0 35px rgba(56, 189, 248, 0.2) !important;
    }

    /* Laser Scanner Line Passing Through Images */
    .magic-work-box::after,
    .magic-work-card::after {
      content: '';
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 60%;
      background: linear-gradient(180deg, transparent 0%, rgba(56, 189, 248, 0.15) 50%, rgba(255, 255, 255, 0.4) 95%, transparent 100%);
      pointer-events: none;
      z-index: 4;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .magic-work-box:hover::after,
    .magic-work-card:hover::after {
      opacity: 1;
      animation: laserSweep 1.2s infinite ease-in-out;
    }
    @keyframes laserSweep {
      0% { top: -60%; }
      100% { top: 120%; }
    }

    /* Kinetic Floating Badge Pulsing */
    .magic-work-box__badge {
      animation: badgeFloat 4s ease-in-out infinite;
    }
    @keyframes badgeFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-4px); }
    }

    /* Hero Section with Video Background */
    .magic-hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      align-items: center;
      padding-top: 76px;
      overflow: hidden;
      background: #090B0E;
    }
    .magic-hero__video-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      overflow: hidden;
    }
    .magic-hero__video {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      object-fit: cover;
      opacity: 0.72;
      filter: saturate(1.15) brightness(1.05) contrast(1.05);
    }
    .magic-hero__gradient {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      background: radial-gradient(circle at 75% 45%, rgba(14, 165, 233, 0.12) 0%, rgba(9, 11, 14, 0.65) 55%, #090B0E 95%),
                  linear-gradient(90deg, rgba(9, 11, 14, 0.92) 0%, rgba(9, 11, 14, 0.65) 55%, rgba(9, 11, 14, 0.35) 100%);
    }
    .magic-hero__3d-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
      pointer-events: none;
      opacity: 0.75;
    }
    .magic-hero__grid-3d {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: center;
      min-height: 80vh;
      padding: 60px 0 40px;
    }
    @media (max-width: 1024px) {
      .magic-hero__grid-3d {
        grid-template-columns: 1fr;
        padding: 40px 0;
      }
    }
    .magic-hero__content {
      position: relative;
      z-index: 4;
    }
    .pulsing-quantum-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #38BDF8;
      box-shadow: 0 0 12px #38BDF8, 0 0 24px #0284C7;
      animation: quantumPulse 2s infinite ease-in-out;
    }
    @keyframes quantumPulse {
      0%, 100% { transform: scale(1); opacity: 0.9; }
      50% { transform: scale(1.6); opacity: 0.4; }
    }
    .magic-cta-btn--glow {
      position: relative;
      background: #ffffff;
      color: #090B0E;
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.35), 0 0 50px rgba(56, 189, 248, 0.2);
      transition: all 0.3s ease;
    }
    .magic-cta-btn--glow:hover {
      box-shadow: 0 0 35px rgba(255, 255, 255, 0.6), 0 0 70px rgba(56, 189, 248, 0.4);
      transform: translateY(-2px) scale(1.02);
    }
    .magic-cta-btn--cyan {
      background: rgba(2, 132, 199, 0.15);
      border: 1px solid #0284C7;
      color: #38BDF8;
      box-shadow: 0 0 20px rgba(2, 132, 199, 0.25);
    }
    .magic-cta-btn--cyan:hover {
      background: #0284C7;
      color: #ffffff;
      box-shadow: 0 0 30px rgba(2, 132, 199, 0.5);
      transform: translateY(-2px);
    }

    /* 3D HUD Cockpit Simulator Widget */
    .magic-hero__hud-wrap {
      position: relative;
      perspective: 1200px;
      z-index: 4;
      display: flex;
      justify-content: center;
    }
    .magic-hud-box {
      width: 100%;
      max-width: 440px;
      background: rgba(14, 18, 24, 0.85);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 16px;
      padding: 28px 24px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(2, 132, 199, 0.15);
      transform: rotateY(-6deg) rotateX(4deg);
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
      position: relative;
    }
    .magic-hud-box:hover {
      transform: rotateY(0deg) rotateX(0deg) translateY(-4px);
      box-shadow: 0 35px 80px rgba(0, 0, 0, 0.8), 0 0 60px rgba(56, 189, 248, 0.25);
      border-color: rgba(56, 189, 248, 0.5);
    }
    .magic-hud-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .magic-hud-status {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hud-live-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 10px #10B981;
      animation: hudBlink 1.5s infinite;
    }
    @keyframes hudBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .hud-mono-text {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
      font-weight: 700;
      color: #38BDF8;
      letter-spacing: 0.8px;
    }
    .magic-hud-badge {
      font-size: 10px;
      font-weight: 700;
      color: #94A3B8;
      background: rgba(255, 255, 255, 0.06);
      padding: 3px 8px;
      border-radius: 4px;
      font-family: ui-monospace, SFMono-Regular, monospace;
    }
    .magic-hud-metric-row {
      margin-bottom: 16px;
    }
    .magic-hud-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: #94A3B8;
      margin-bottom: 6px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .magic-hud-val {
