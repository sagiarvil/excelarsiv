  <style>
    /* ==========================================================================
       ENTERPRISE PRIVATE WEALTH & BESPOKE FINANCIAL ARCHITECTURE
       Design Philosophy: Bespoke Atelier / Human Craftsmanship / Zurich Private Banking
       Color Hierarchy:
       - Deep Obsidian / Midnight Void: #090B0E, #0E1217, #141922
       - Subtle Borders & Separators: rgba(255, 255, 255, 0.08)
       - Primary Typography: #F1F5F9 (Soft Silk White, anti-glare)
       - Secondary Typography: #94A3B8 (Warm Slate, non-distracting)
       - Human Accent: #E05A2B (Warm Tuscan Terracotta / Bespoke Copper)
       - Card Surface: #0E1217 with subtle 1px border
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html, body {
      background-color: #090B0E;
      color: #F1F5F9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    a {
      color: inherit;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    /* Container */
    .magic-container {
      width: 100%;
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 32px;
    }
    @media (max-width: 768px) {
      .magic-container {
        padding: 0 20px;
      }
    }

    /* Header Nav */
    .magic-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(9, 11, 14, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      height: 76px;
      display: flex;
      align-items: center;
    }
    .magic-header__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .magic-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: #F1F5F9;
    }
    .magic-brand__pill {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      background: rgba(224, 90, 43, 0.12);
      border: 1px solid rgba(224, 90, 43, 0.35);
      color: #E05A2B;
      padding: 3px 9px;
      border-radius: 4px;
      letter-spacing: 0.8px;
    }
    .magic-nav {
      display: flex;
      align-items: center;
      gap: 36px;
    }
    .magic-nav a {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.8px;
      color: #94A3B8 !important;
      transition: color 0.2s ease;
    }
    .magic-nav a:hover {
      color: #F1F5F9 !important;
    }
    .magic-nav a.active {
      color: #E05A2B !important;
    }
    .magic-cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 30px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      background: #ffffff;
      color: #090B0E;
      border: 1px solid #ffffff;
      border-radius: 4px;
      box-shadow: 0 4px 16px rgba(255, 255, 255, 0.12);
      transition: all 0.25s ease;
      cursor: pointer;
    }
    .magic-cta-btn:hover {
      background: rgba(255, 255, 255, 0.9);
      border-color: rgba(255, 255, 255, 0.9);
      box-shadow: 0 6px 24px rgba(255, 255, 255, 0.22);
      transform: translateY(-1px);
    }
    .magic-cta-btn--outline {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: #ffffff;
      box-shadow: none;
    }
    .magic-cta-btn--outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: #ffffff;
      color: #ffffff;
      transform: translateY(-1px);
    }

    /* Hero Section with Video Background */
    .magic-hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      align-items: center;
      padding-top: 76px;
      overflow: hidden;
      background: #090B0E;
    }
    .magic-hero__video-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      overflow: hidden;
    }
    .magic-hero__video {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      object-fit: cover;
      opacity: 0.38;
      filter: saturate(0.9) brightness(0.85);
    }
    .magic-hero__gradient {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      background: linear-gradient(
        90deg,
        rgba(9, 11, 14, 0.96) 0%,
        rgba(9, 11, 14, 0.88) 48%,
        rgba(9, 11, 14, 0.55) 100%
      );
    }
    .magic-hero__content {
      position: relative;
      z-index: 3;
      max-width: 820px;
      padding: 90px 0 70px 0;
    }
    .magic-hero__tag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 24px;
    }
    .magic-hero__tag::before {
      content: '';
      display: inline-block;
      width: 18px;
      height: 2px;
      background-color: rgba(255, 255, 255, 0.4);
    }
    .magic-hero__title {
      font-size: clamp(38px, 5.2vw, 68px);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -1.5px;
      color: #ffffff;
      margin-bottom: 24px;
    }
    .magic-hero__title span {
      display: block;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 300;
      letter-spacing: -1px;
    }
    .magic-hero__desc {
      font-size: clamp(16px, 1.4vw, 19px);
      line-height: 1.7;
      color: #94A3B8;
      font-weight: 400;
      margin-bottom: 40px;
      max-width: 660px;
    }
    .magic-hero__actions {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .magic-hero__badge-band {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      margin-top: 56px;
      padding-top: 32px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    @media (max-width: 768px) {
      .magic-hero__badge-band {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .magic-hero__metric {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .magic-hero__metric-val {
      font-size: 24px;
      font-weight: 700;
      color: #F1F5F9;
      letter-spacing: -0.4px;
    }
    .magic-hero__metric-label {
      font-size: 12px;
      color: #64748B;
      font-weight: 500;
      letter-spacing: 0.2px;
    }

    /* Section Header */
    .magic-section {
      padding: 100px 0;
      position: relative;
    }
    .magic-section--dark {
      background: #0B0E13;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .magic-sec-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      color: #E05A2B;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .magic-sec-title::before {
      content: '';
      width: 14px;
      height: 2px;
      background: #E05A2B;
    }
    .magic-heading {
      font-size: clamp(26px, 3.2vw, 42px);
      font-weight: 700;
      letter-spacing: -0.8px;
      line-height: 1.2;
      color: #F1F5F9;
      margin-bottom: 16px;
    }
    .magic-subheading {
      font-size: 16px;
      color: #94A3B8;
      line-height: 1.65;
      max-width: 660px;
      margin-bottom: 50px;
    }

    /* Grid of Works / Systems */
    .magic-works-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    @media (max-width: 1024px) {
      .magic-works-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .magic-works-grid {
        grid-template-columns: 1fr;
      }
    }
    .magic-work-card {
      position: relative;
      background: #0E1218;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 8px;
      overflow: hidden;
      aspect-ratio: 16 / 11;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 28px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .magic-work-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(180deg, rgba(14, 18, 24, 0.15) 0%, rgba(14, 18, 24, 0.95) 75%);
      z-index: 2;
      transition: opacity 0.3s ease;
    }
    .magic-work-card__bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      filter: grayscale(85%) brightness(0.65);
      transition: transform 0.4s ease, filter 0.4s ease;
    }
    .magic-work-card:hover {
      border-color: rgba(224, 90, 43, 0.4);
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    }
    .magic-work-card:hover .magic-work-card__bg {
      transform: scale(1.04);
      filter: grayscale(40%) brightness(0.75);
    }
    .magic-work-card__content {
      position: relative;
      z-index: 3;
    }
    .magic-work-card__tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #E05A2B;
      margin-bottom: 8px;
    }
    .magic-work-card__title {
      font-size: 19px;
      font-weight: 700;
      color: #F1F5F9;
      margin-bottom: 8px;
      line-height: 1.3;
      letter-spacing: -0.3px;
    }
    .magic-work-card__desc {
      font-size: 13.5px;
      color: #94A3B8;
      line-height: 1.55;
    }

    /* Portfolio Showcase: Pure MagiClick Work-Item Architecture */
    .magic-portfolio-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
    @media (max-width: 860px) {
      .magic-portfolio-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    }
    .magic-work-box {
      position: relative;
      display: block;
      overflow: hidden;
      border-radius: 8px;
      background: #0A0D12;
      border: 1px solid rgba(255, 255, 255, 0.09);
      text-decoration: none;
      aspect-ratio: 16 / 10;
      transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }
    .magic-work-box:hover {
      border-color: rgba(255, 255, 255, 0.3);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.7);
      transform: translateY(-2px);
    }
    .magic-work-box__mask {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
    }
    .magic-work-box__mask::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      background: linear-gradient(180deg, rgba(9, 11, 14, 0.15) 0%, rgba(9, 11, 14, 0.4) 40%, rgba(9, 11, 14, 0.95) 100%);
      transition: background 0.3s ease;
    }
    .magic-work-box:hover .magic-work-box__mask::before {
      background: linear-gradient(180deg, rgba(9, 11, 14, 0.05) 0%, rgba(9, 11, 14, 0.25) 35%, rgba(9, 11, 14, 0.92) 100%);
    }
    .magic-work-box__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
      transform: scale(1.001);
    }
    .magic-work-box:hover .magic-work-box__img {
      transform: scale(1.06);
    }
    .magic-work-box__badge {
      position: absolute;
      top: 18px;
      right: 18px;
      z-index: 4;
      background: rgba(9, 11, 14, 0.75);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #F1F5F9;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
      padding: 5px 12px;
      border-radius: 20px;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .magic-work-box__badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 8px #10B981;
    }
    .magic-work-box__caption {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 32px 30px;
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .magic-work-box__tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.65);
    }
    .magic-work-box__title {
      font-size: 23px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.25;
      letter-spacing: -0.4px;
      margin: 0;
    }
    .magic-work-box__desc {
      font-size: 14px;
      color: #CBD5E1;
      line-height: 1.5;
      margin: 0;
      max-width: 90%;
      font-weight: 400;
    }
    .magic-work-box__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 10px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .magic-work-box__url {
      font-family: monospace;
      font-size: 11px;
      color: #94A3B8;
    }
    .magic-work-box__cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: 0.5px;
      transition: gap 0.2s ease;
    }
    .magic-work-box:hover .magic-work-box__cta {
      gap: 10px;
    }

    /* Pillars of Bespoke Financial Engineering */
    .magic-pillars {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 20px;
    }
    @media (max-width: 1024px) {
      .magic-pillars {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .magic-pillars {
        grid-template-columns: 1fr;
      }
    }
    .magic-pillar-card {
      background: #0E1218;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 8px;
      padding: 32px 24px;
      transition: all 0.3s ease;
      position: relative;
    }
    .magic-pillar-card:hover {
      border-color: rgba(224, 90, 43, 0.35);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
    .magic-pillar-card__icon {
      width: 44px;
      height: 44px;
      border-radius: 6px;
      background: rgba(224, 90, 43, 0.1);
      border: 1px solid rgba(224, 90, 43, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #E05A2B;
      margin-bottom: 20px;
    }
    .magic-pillar-card__num {
      position: absolute;
      top: 24px;
      right: 24px;
      font-size: 15px;
      font-weight: 700;
      color: #475569;
      font-family: monospace;
    }
    .magic-pillar-card__title {
      font-size: 17px;
      font-weight: 700;
      color: #F1F5F9;
      margin-bottom: 10px;
      letter-spacing: -0.2px;
    }
    .magic-pillar-card__desc {
      font-size: 13.5px;
      color: #94A3B8;
      line-height: 1.6;
    }

    /* Comparison Table: Standard Web Agency vs. Prime Financial Web */
    .magic-comp-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin-top: 36px;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 8px;
      overflow: hidden;
      background: #0E1218;
    }
    .magic-comp-table th, .magic-comp-table td {
      padding: 20px 24px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 14px;
      line-height: 1.55;
    }
    .magic-comp-table tr:last-child td {
      border-bottom: none;
    }
    .magic-comp-table th {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.8px;
      color: #64748B;
      background: #0A0D12;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .magic-comp-table td {
      color: #94A3B8;
    }
    .magic-comp-table td strong {
      color: #F1F5F9;
    }
    .magic-comp-table th.highlight, .magic-comp-table td.highlight {
      background: rgba(224, 90, 43, 0.04);
      color: #F1F5F9;
    }
    .magic-comp-table th.highlight {
      color: #E05A2B;
      font-weight: 700;
    }

    /* Testimonial & Trust Proof Bar */
    .magic-proof-bar {
      padding: 44px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      background: #0B0E13;
    }
    .magic-proof-logos {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .magic-proof-item {
      display: flex;
