      -ms-overflow-style: none;
    }
    .magic-nav::-webkit-scrollbar {
      display: none;
    }
    .magic-nav a {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.5px;
      color: #E2E8F0 !important;
      transition: all 0.2s ease;
      white-space: nowrap;
