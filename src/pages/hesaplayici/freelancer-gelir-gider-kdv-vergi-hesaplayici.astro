---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Button from '../../components/Button.astro';

const breadcrumbs = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hesaplayıcılar', href: '/hesaplayici' },
  { label: 'Freelancer Gelir-Gider & Vergi Hesaplayıcı', href: '/hesaplayici/freelancer-gelir-gider-kdv-vergi-hesaplayici' },
];

const seoTitle = 'Freelancer & Şahıs Şirketi Gelir-Gider, KDV ve Net Kalan Hesaplayıcı — Excel Arşiv';
const seoDesc = 'Fatura geliriniz, KDV tahakkuku, stopaj, Bağkur ve gelir vergisi dilimleri sonrası elinize net ne kadar para kaldığını kuruşu kuruşuna hesaplayın.';
---

<CommerceLayout
  title={seoTitle}
  description={seoDesc}
>
  <div class="mx-auto max-w-5xl px-4 py-8 md:py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs text-ink-500" aria-label="Breadcrumb">
      {breadcrumbs.map((b, i) => (
        <>
          {i > 0 && <span class="text-rule-strong">/</span>}
          {i === breadcrumbs.length - 1 ? (
            <span class="text-ink-900 font-semibold">{b.label}</span>
          ) : (
            <a href={b.href} class="hover:text-accent-primary transition-colors">{b.label}</a>
          )}
        </>
      ))}
    </nav>

    <div class="mb-8">
      <SectionLabel number={3} label="Vergi & Finansal Net Kazanç" />
      <h1 class="display mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Freelancer & Şahıs Şirketi Net Kazanç Hesaplayıcı
      </h1>
      <p class="lead mt-3 max-w-3xl text-ink-700 text-base sm:text-lg">
        Fatura kestiğinizde kasanıza giren brüt paranın ne kadarı devlete (KDV + Stopaj + Geçici/Gelir Vergisi), ne kadarı Bağkur/işletme giderlerine gidiyor ve net elinize ne kalıyor?
      </p>
    </div>

    <!-- Live Workspace Grid -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Sol: Girdi Formu -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-rule-strong bg-surface-elevated p-6 shadow-sm">
          <div class="mb-6 flex items-center justify-between border-b border-rule-hairline pb-4">
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded bg-accent-primary text-white font-mono text-sm font-bold">
                ₺
              </div>
              <div>
                <h2 class="font-sans text-lg font-bold text-ink-900">Aylık Gelir ve Gider Parametreleri</h2>
                <p class="font-mono text-xs text-ink-500">2026 VERGİ DİLİMLERİ VE KDV MATRAHI</p>
              </div>
            </div>
            <span class="rounded-full bg-emerald-50 px-3 py-1 font-mono text-xs font-semibold text-emerald-800 border border-emerald-200">
              Canlı Simülatör
            </span>
          </div>

          <form id="freelance-calc-form" class="space-y-4" onsubmit="return false;">
            <!-- Fatura Tutarı ve KDV -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="f-gelir" class="block font-mono text-xs font-medium text-ink-700 mb-1">
                  Aylık Kesilen Fatura Tutarı (KDV Hariç)
                </label>
                <div class="relative">
                  <input id="f-gelir" type="number" step="500" min="0" value="85000" class="w-full min-h-11 rounded-lg border border-rule-hairline bg-white px-3 pr-8 font-mono text-sm text-ink-900 focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary" />
                  <span class="absolute right-3 top-3 font-mono text-xs text-ink-500">TL</span>
                </div>
              </div>

              <div>
                <label for="f-kdv-oran" class="block font-mono text-xs font-medium text-ink-700 mb-1">
                  Uygulanan KDV Oranı (%)
                </label>
                <select id="f-kdv-oran" class="w-full min-h-11 rounded-lg border border-rule-hairline bg-white px-3 font-mono text-sm text-ink-900 focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary">
                  <option value="20" selected>%20 (Standart Hizmet / Danışmanlık / Yazılım)</option>
                  <option value="10">%10 (Özel İndirimli Alanlar)</option>
                  <option value="0">%0 (Yurtdışı İhracat / KDV İstisnası)</option>
                </select>
              </div>
            </div>

            <!-- İşletme Giderleri ve İndirilecek KDV -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="f-giderler" class="block font-mono text-xs font-medium text-ink-700 mb-1">
                  Aylık İşletme Giderleri (Faturası Alınan)
                </label>
                <div class="relative">
                  <input id="f-giderler" type="number" step="250" min="0" value="15000" class="w-full min-h-11 rounded-lg border border-rule-hairline bg-white px-3 pr-8 font-mono text-sm text-ink-900 focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary" />
                  <span class="absolute right-3 top-3 font-mono text-xs text-ink-500">TL</span>
                </div>
                <span class="text-[11px] text-ink-500">Yazılım, ekipman, muhasebeci vb.</span>
              </div>

              <div>
                <label for="f-bagkur" class="block font-mono text-xs font-medium text-ink-700 mb-1">
                  Aylık Bağkur / SGK Primi
                </label>
                <div class="relative">
                  <input id="f-bagkur" type="number" step="100" min="0" value="7950" class="w-full min-h-11 rounded-lg border border-rule-hairline bg-white px-3 pr-8 font-mono text-sm text-ink-900 focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary" />
                  <span class="absolute right-3 top-3 font-mono text-xs text-ink-500">TL</span>
                </div>
                <span class="text-[11px] text-ink-500">Düzenli ödeniyorsa vergiden düşer</span>
              </div>
            </div>

            <!-- Stopaj ve Genç Girişimci İstisnası -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="f-stopaj" class="block font-mono text-xs font-medium text-ink-700 mb-1">
                  Aylık Kira Stopajı Tutarı
                </label>
                <div class="relative">
                  <input id="f-stopaj" type="number" step="100" min="0" value="2500" class="w-full min-h-11 rounded-lg border border-rule-hairline bg-white px-3 pr-8 font-mono text-sm text-ink-900 focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary" />
                  <span class="absolute right-3 top-3 font-mono text-xs text-ink-500">TL</span>
                </div>
              </div>

              <div>
                <label for="f-genc-girisimci" class="block font-mono text-xs font-medium text-ink-700 mb-1">
                  Genç Girişimci İstisnası Durumu
                </label>
                <select id="f-genc-girisimci" class="w-full min-h-11 rounded-lg border border-rule-hairline bg-white px-3 font-sans text-sm text-ink-900 focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary">
                  <option value="hayir" selected>Hayır (Normal Vergi Dilimleri)</option>
                  <option value="evet">Evet (3 Yıl Boyunca Gelir Vergisi Muafiyeti)</option>
                </select>
              </div>
            </div>
          </form>

          <div class="mt-6 rounded-lg bg-surface border border-rule-hairline p-3 text-xs text-ink-700">
            <span class="font-semibold text-accent-primary">📌 Yasal Not:</span> KDV müşteriden tahsil edilip devlete aktarılan emanet paradır. Net gelir hesabı yapılırken müşteriden tahsil edilen KDV ve devlete ödenecek fark net kârınızdan ayrı tutulmalıdır.
          </div>
        </div>
      </div>

      <!-- Sağ: Net Ele Kalan Konsolu -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="rounded-2xl border border-rule-strong bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-rule-hairline pb-4">
            <h3 class="font-sans text-base font-bold text-ink-900">Net Ele Kalan Kazanç</h3>
            <span id="f-res-vergi-oran" class="rounded px-2.5 py-0.5 font-mono text-xs font-bold bg-emerald-100 text-emerald-800">
              Efektif Yük: %28.4
            </span>
          </div>

          <!-- Ana KPI: Cebe Kalan -->
          <div class="mt-6 rounded-xl bg-surface-elevated p-5 text-center border border-rule-hairline">
            <div class="font-mono text-xs text-ink-500 uppercase tracking-wider">Aylık Cebe Kalan Net Para</div>
            <div id="f-res-net-kalan" class="mt-2 font-mono text-4xl font-extrabold text-emerald-700">
              47.250 TL
            </div>
            <div class="mt-2 text-xs font-mono text-ink-700">
              Brüt Tahsilat: <span id="f-res-brut-tahsilat" class="font-bold text-ink-900">102.000 TL</span>
            </div>
          </div>

          <!-- Kırılım Detayları -->
          <div class="mt-6 space-y-2.5 font-mono text-xs border-t border-rule-hairline pt-4">
            <div class="flex justify-between text-ink-700">
              <span>Müşteriden Alınan KDV:</span>
              <span id="f-res-alinan-kdv" class="text-ink-900">17.000 TL</span>
            </div>
            <div class="flex justify-between text-ink-700">
              <span>Gider KDV İndirimi:</span>
              <span id="f-res-indirilen-kdv" class="text-ink-900">-2.500 TL</span>
            </div>
            <div class="flex justify-between text-ink-700 font-semibold">
              <span>Devlete Ödenecek Net KDV:</span>
              <span id="f-res-odenecek-kdv" class="text-rose-600">14.500 TL</span>
            </div>
            <div class="flex justify-between text-ink-700">
              <span>İşletme Giderleri + Bağkur:</span>
              <span id="f-res-toplam-gider" class="text-ink-900">22.950 TL</span>
            </div>
            <div class="flex justify-between text-ink-700">
              <span>Kira Stopajı:</span>
              <span id="f-res-stopaj-tutar" class="text-ink-900">2.500 TL</span>
            </div>
            <div class="flex justify-between text-ink-700 font-semibold">
              <span>Tahmini Gelir Vergisi (Dilimli):</span>
              <span id="f-res-gelir-vergisi" class="text-rose-600">14.800 TL</span>
            </div>
          </div>

          <!-- Excel Formül Kutusu -->
          <div class="mt-6 rounded-lg border border-rule-hairline bg-surface p-3">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] font-semibold text-ink-700">Excel Net Kazanç Formülü:</span>
              <button id="btn-copy-freelance-formula" class="font-mono text-[11px] text-accent-primary hover:underline">
                Kopyala
              </button>
            </div>
            <code id="f-formula-text" class="mt-1.5 block overflow-x-auto rounded bg-white p-2 font-mono text-[11px] text-ink-900 border border-rule-hairline">
              =(Gelir-Gider-Bagkur)*(1-VergiOrani)-Stopaj
            </code>
          </div>
        </div>

        <!-- Ticari Köprü: Finans & Vergi Şablonu -->
        <div class="rounded-2xl border-2 border-accent-primary bg-emerald-50/50 p-6 shadow-sm">
          <div class="flex items-start gap-3">
            <div class="text-2xl">📑</div>
            <div>
              <h4 class="font-sans text-base font-bold text-ink-900">Yıllık Vergi ve Kasa Karşılık Sistemi</h4>
              <p class="mt-1 text-xs text-ink-700 leading-relaxed">
                Ay sonunda vergi veya SGK çıktığında nakit sıkışıklığı yaşamayın. <strong>Vergi, SGK ve Maaş Karşılık Ayırma Sistemi</strong> ile banka kasanızı tam korumaya alın.
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <Button href="/sablon/vergi-sgk-ve-maas-karsilik-ayirma-sistemi#satin-al">
                  Karşılık Sistemini İncele
                </Button>
                <Button href="/demo/vergi-sgk-ve-maas-karsilik-ayirma-sistemi" variant="secondary">
                  Demo İncele
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Diğer Hesaplayıcılar -->
    <div class="mt-12 pt-8 border-t border-rule-hairline">
      <h3 class="text-sm font-bold text-ink-900 mb-4">Diğer Karar Hesaplayıcıları</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/hesaplayici/pazaryeri-komisyon-kar-hesaplama" class="p-3.5 rounded-xl border border-rule-strong bg-surface-elevated hover:border-accent-primary transition-all text-xs font-semibold text-ink-900">
          Pazaryeri Komisyon &amp; Net Kâr Hesaplayıcı →
        </a>
        <a href="/hesaplayici/asgari-ucret-zam-etkisi" class="p-3.5 rounded-xl border border-rule-strong bg-surface-elevated hover:border-accent-primary transition-all text-xs font-semibold text-ink-900">
          Asgari Ücret Zam Etkisi &amp; Bordro Maliyeti →
        </a>
        <a href="/hesaplayici/whatsapp-link-ve-telefon-formatlayici" class="p-3.5 rounded-xl border border-rule-strong bg-surface-elevated hover:border-accent-primary transition-all text-xs font-semibold text-ink-900">
          WhatsApp Link &amp; Telefon Formatlayıcı →
        </a>
      </div>
    </div>
  </div>
</CommerceLayout>

<script>
  function calcFreelance() {
    const gelir = Number((document.getElementById('f-gelir') as HTMLInputElement)?.value || 0);
    const kdvOran = Number((document.getElementById('f-kdv-oran') as HTMLSelectElement)?.value || 20) / 100;
    const giderler = Number((document.getElementById('f-giderler') as HTMLInputElement)?.value || 0);
    const bagkur = Number((document.getElementById('f-bagkur') as HTMLInputElement)?.value || 0);
    const stopaj = Number((document.getElementById('f-stopaj') as HTMLInputElement)?.value || 0);
    const isGenc = (document.getElementById('f-genc-girisimci') as HTMLSelectElement)?.value === 'evet';

    // KDV Hesaplama
    const alinanKdv = gelir * kdvOran;
    const giderKdv = giderler * 0.20; // Ortalama %20 gider KDV
    const odenecekKdv = Math.max(0, alinanKdv - giderKdv);

    // Gelir Vergisi Matrahı (Gelir - Giderler - Bağkur)
    const yillikMatrah = Math.max(0, (gelir - giderler - bagkur) * 12);
    
    // 2026 Gelir Vergisi Dilimleri Simülasyonu
    let yillikVergi = 0;
    if (!isGenc) {
      if (yillikMatrah <= 158000) {
        yillikVergi = yillikMatrah * 0.15;
      } else if (yillikMatrah <= 330000) {
        yillikVergi = 23700 + (yillikMatrah - 158000) * 0.20;
      } else if (yillikMatrah <= 800000) {
        yillikVergi = 58100 + (yillikMatrah - 330000) * 0.27;
      } else if (yillikMatrah <= 3000000) {
        yillikVergi = 185000 + (yillikMatrah - 800000) * 0.35;
      } else {
        yillikVergi = 955000 + (yillikMatrah - 3000000) * 0.40;
      }
    }
    const aylikGelirVergisi = yillikVergi / 12;

    // Net Ele Kalan (KDV Hariç Gelir - Giderler - Bağkur - Stopaj - Gelir Vergisi)
    const netKalan = Math.max(0, gelir - giderler - bagkur - stopaj - aylikGelirVergisi);
    const brutTahsilat = gelir + alinanKdv;
    const toplamKesinti = brutTahsilat - netKalan;
    const efektifOran = brutTahsilat > 0 ? (toplamKesinti / brutTahsilat) * 100 : 0;

    const fmt = (v: number) => Math.round(v).toLocaleString('tr-TR') + ' TL';

    const netKalanEl = document.getElementById('f-res-net-kalan');
    const brutTahsilatEl = document.getElementById('f-res-brut-tahsilat');
    const alinanKdvEl = document.getElementById('f-res-alinan-kdv');
    const indirilenKdvEl = document.getElementById('f-res-indirilen-kdv');
    const odenecekKdvEl = document.getElementById('f-res-odenecek-kdv');
    const toplamGiderEl = document.getElementById('f-res-toplam-gider');
    const stopajTutarEl = document.getElementById('f-res-stopaj-tutar');
    const gelirVergisiEl = document.getElementById('f-res-gelir-vergisi');
    const vergiOranBadge = document.getElementById('f-res-vergi-oran');

    if (netKalanEl) netKalanEl.textContent = fmt(netKalan);
    if (brutTahsilatEl) brutTahsilatEl.textContent = fmt(brutTahsilat);
    if (alinanKdvEl) alinanKdvEl.textContent = fmt(alinanKdv);
    if (indirilenKdvEl) indirilenKdvEl.textContent = '-' + fmt(giderKdv);
    if (odenecekKdvEl) odenecekKdvEl.textContent = fmt(odenecekKdv);
    if (toplamGiderEl) toplamGiderEl.textContent = fmt(giderler + bagkur);
    if (stopajTutarEl) stopajTutarEl.textContent = fmt(stopaj);
    if (gelirVergisiEl) gelirVergisiEl.textContent = fmt(aylikGelirVergisi);
    if (vergiOranBadge) vergiOranBadge.textContent = 'Efektif Yük: %' + efektifOran.toFixed(1);
  }

  const fForm = document.getElementById('freelance-calc-form');
  fForm?.querySelectorAll('input, select').forEach((el) => {
    el.addEventListener('input', calcFreelance);
    el.addEventListener('change', calcFreelance);
  });

  document.getElementById('btn-copy-freelance-formula')?.addEventListener('click', () => {
    const f = document.getElementById('f-formula-text')?.textContent?.trim() || '';
    navigator.clipboard.writeText(f).then(() => {
      alert('Formül kopyalandı!');
    });
  });

  calcFreelance();
</script>
