---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Button from '../../components/Button.astro';

const breadcrumbs = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hesaplayıcılar', href: '/hesaplayici' },
];

const calculators = [
  {
    title: 'Pazaryeri Komisyon ve Net Kâr Hesaplayıcı',
    category: 'E-Ticaret & Fiyatlama',
    badge: 'Popüler',
    badgeColor: 'bg-amber-100 text-amber-800 border-amber-200',
    description: 'Trendyol, Hepsiburada, Amazon ve Pazarama satışlarınızda komisyon, kargo baremi, hizmet bedeli ve KDV tevkifatı sonrası net kârınızı ve başa baş fiyatınızı anında görün.',
    href: '/hesaplayici/pazaryeri-komisyon-kar-hesaplama',
    metrics: ['Komisyon Ayrıştırma', 'KDV Tevkifatı', 'Başa Baş Fiyatı'],
    cta: 'Hesaplayıcıyı Başlat'
  },
  {
    title: 'Toplu WhatsApp Linki & Telefon Formatlayıcı',
    category: 'Müşteri & İletişim',
    badge: 'Yeni',
    badgeColor: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    description: 'Karışık müşteri telefon numaralarını tek tıkla standart E.164 uluslararası formatına çevirin, doğrudan çalışan wa.me linkleri ve Excel formülleri üretin.',
    href: '/hesaplayici/whatsapp-link-ve-telefon-formatlayici',
    metrics: ['Toplu Dönüştürme', 'Excel Formül Üretimi', 'Geçersiz Numara Tespiti'],
    cta: 'Numaraları Dönüştür'
  },
  {
    title: 'Freelancer & Şahıs Şirketi Net Kazanç Hesaplayıcı',
    category: 'Finans & Vergi',
    badge: 'Finansal Simülatör',
    badgeColor: 'bg-sky-100 text-sky-800 border-sky-200',
    description: 'Fatura geliriniz, KDV tahakkuku, stopaj, Bağkur primi ve 2026 kümülatif gelir vergisi dilimleri sonrası elinize net ne kadar para kaldığını kuruşu kuruşuna hesaplayın.',
    href: '/hesaplayici/freelancer-gelir-gider-kdv-vergi-hesaplayici',
    metrics: ['2026 Vergi Dilimleri', 'Net KDV Farkı', 'Efektif Vergi Yükü'],
    cta: 'Vergiyi Simüle Et'
  },
  {
    title: 'Asgari Ücret Zam Etkisi ve İşveren Maliyeti',
    category: 'İnsan Kaynakları & Bordro',
    badge: 'Bordro',
    badgeColor: 'bg-slate-100 text-ink-900 border-rule-hairline',
    description: 'Yeni asgari ücret artış oranının personel bütçenize, toplam işveren maliyetinize ve ürün birim fiyatlarınıza yapacağı zam yansıtma etkisini ölçün.',
    href: '/hesaplayici/asgari-ucret-zam-etkisi',
    metrics: ['İşveren Maliyeti', 'Fiyat Yansıtma Oranı', 'Senaryo Analizi'],
    cta: 'Maliyeti Hesapla'
  },
  {
    title: 'Nakit Akışı, CCC ve Başa Baş Karar Konsolu',
    category: 'C-Level Finans & Yönetim',
    badge: 'Kurumsal',
    badgeColor: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    description: 'DSO, DIO, DPO vadeleriniz ve sabit giderlerinizle şirketin nakit dönüşüm süresini, bağlanan işletme sermayesini ve başa baş ciro noktasını simüle edin.',
    href: '/hesaplayici/nakit-akisi-ve-basabas-hesaplayici',
    metrics: ['CCC Döngüsü', 'Başa Baş Ciro', 'C-Level İcra Tavsiyesi'],
    cta: 'Konsolu Başlat'
  }
];

const seoTitle = 'Ücretsiz Excel Hesaplayıcılar ve Karar Konsolları — Excel Arşiv';
const seoDesc = 'E-ticaret pazaryeri komisyonları, WhatsApp link formatlama, freelancer gelir vergisi ve bordro maliyetlerini anında hesaplayan profesyonel ücretsiz karar araçları.';
---

<CommerceLayout
  title={seoTitle}
  description={seoDesc}
>
  <div class="mx-auto max-w-5xl px-4 py-8 md:py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs text-ink-500" aria-label="Breadcrumb">
      {breadcrumbs.map((b, i) => (
        <>
          {i > 0 && <span class="text-rule-strong">/</span>}
          {i === breadcrumbs.length - 1 ? (
            <span class="text-ink-900 font-semibold">{b.label}</span>
          ) : (
            <a href={b.href} class="hover:text-accent-primary transition-colors">{b.label}</a>
          )}
        </>
      ))}
    </nav>

    <div class="mb-10 text-center sm:text-left">
      <SectionLabel number={1} label="Finansal Karar Araçları" />
      <h1 class="display mt-4 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Ücretsiz Karar ve Hesaplama Konsolları
      </h1>
      <p class="lead mt-3 max-w-3xl text-ink-700 text-base sm:text-lg">
        Karmaşık finansal hesaplamaları, pazaryeri komisyonlarını ve iş operasyonlarını tarayıcınızda saniyeler içinde hesaplayın. İhtiyaç duyduğunuzda tek tıkla tam kapsamlı Excel sistemine geçiş yapın.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {calculators.map((c) => (
        <div class="flex flex-col justify-between rounded-2xl border border-rule-strong bg-surface-elevated p-6 shadow-sm transition-all hover:border-accent-primary hover:shadow-md">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="font-mono text-xs font-semibold text-accent-primary uppercase tracking-wider">
                {c.category}
              </span>
              <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-bold ${c.badgeColor}`}>
                {c.badge}
              </span>
            </div>
            <h2 class="font-sans text-xl font-bold text-ink-900">
              <a href={c.href} class="hover:text-accent-primary transition-colors">
                {c.title}
              </a>
            </h2>
            <p class="mt-3 text-xs leading-relaxed text-ink-700">
              {c.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {c.metrics.map((m) => (
                <span class="rounded bg-surface px-2 py-1 font-mono text-[10px] text-ink-700 border border-rule-hairline">
                  ✓ {m}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-rule-hairline flex items-center justify-between">
            <a
              href={c.href}
              class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-accent-primary hover:text-emerald-700 transition-colors"
            >
              <span>{c.cta}</span>
              <span>→</span>
            </a>
            <span class="font-mono text-[11px] text-ink-500">Ücretsiz Web Aracı</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner: Tam Excel Çözümleri -->
    <div class="mt-12 rounded-2xl border-2 border-accent-primary bg-emerald-50/50 p-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="font-sans text-xl font-bold text-ink-900">Tekil Formüller Yerine Tüm Sisteminizi Kurun</h3>
        <p class="mt-2 text-xs sm:text-sm text-ink-700 max-w-xl">
          Finans, muhasebe, nakit akışı ve e-ticaret yönetiminde hata payını sıfırlayan, denetlenmiş 51 profesyonel Excel sistemimizi inceleyin.
        </p>
      </div>
      <div class="flex-shrink-0">
        <Button href="/sablonlar">
          Tüm Excel Sistemlerini Gör
        </Button>
      </div>
    </div>
  </div>
</CommerceLayout>
