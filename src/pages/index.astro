</div>
<p class="text-[11px] text-slate-500 leading-none">Türkiye'nin Hazır Şablon &amp; Makro Merkezi</p>
</div>
</a>
<!-- Masaüstü Menü -->
<nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-slate-600">
