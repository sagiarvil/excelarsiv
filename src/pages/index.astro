---
import '../styles/global.css';
import '../styles/appstore-theme.css';
import AppStoreSidebar from '../components/appstore/AppStoreSidebar.astro';
import { getAllTemplates, getTemplateSearchIndex } from '../lib/templates';
import { kararPages } from '../data/kararPages';

const templates = await getAllTemplates();
const searchIndex = await getTemplateSearchIndex();
const productCount = templates.length;
const categoryCount = new Set(templates.map((item) => item.categorySlug)).size;

// En Çok Tercih Edilenler (Farklı Renk ve Grafik Sembolleri)
const popularFreeTemplates = [
  { name: '13 Haftalık Nakit Akışı', slug: '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi', url: '/sablon/13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi', summary: 'Nakit akışınızı haftalık olarak planlayın.', color: 'blue', icon: 'trend' },
  { name: 'Akıllı Kasa Defteri', slug: 'akilli-kasa-defteri-ve-nakit-kontrol-sistemi', url: '/sablon/akilli-kasa-defteri-ve-nakit-kontrol-sistemi', summary: 'Günlük gelir gider takibi yapın.', color: 'green', icon: 'chart' },
  { name: 'Cari Risk Takip', slug: 'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi', url: '/sablon/cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi', summary: 'Müşteri risklerini kolayca yönetin.', color: 'amber', icon: 'pie' },
  { name: 'Aylık Patron Finans Paneli', slug: 'aylik-patron-finans-paneli', url: '/sablon/aylik-patron-finans-paneli', summary: 'İşletmenizin genel durumunu görün.', color: 'purple', icon: 'gauge' },
  { name: 'Gelir Gider Gerçek Kârlılık', slug: 'gunluk-gelir-gider-ve-gercek-karlilik-sistemi', url: '/sablon/gunluk-gelir-gider-ve-gercek-karlilik-sistemi', summary: 'Kişisel ve kurumsal kârlılık takibi.', color: 'rose', icon: 'waterfall' },
];

// İşletmeler İçin Öne Çıkanlar (6'lı Grid)
const businessFeaturedSlugs = [
  { slug: 'kobi-finans-yonetim-paketi', name: 'Finansal Tablolar Seti', sub: 'Bilanço, gelir tablosu, nakit akışı', color: 'green', icon: 'chart' },
  { slug: 'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici', name: 'Personel Bordro Sistemi', sub: 'Personel maaş ve bordro takibi', color: 'purple', icon: 'users' },
  { slug: 'uretim-kapasite-yatirim-ve-karlilik', name: 'Bütçe Planlama Aracı', sub: 'Yıllık ve aylık bütçe oluşturun', color: 'blue', icon: 'pie' },
  { slug: 'stok-satis-ve-nakit-baglanma-sistemi', name: 'Stok Takip ve Envanter', sub: 'Stok giriş çıkışlarınızı yönetin', color: 'orange', icon: 'box' },
  { slug: 'pos-komisyon-ve-net-tahsilat-kontrol-sistemi', name: 'Satış ve Fiyat Analizi', sub: 'Satış performansınızı analiz edin', color: 'red', icon: 'tag' },
  { slug: 'sube-karlilik-ve-nakit-hesaplayici', name: 'Kar-Zarar Analizi', sub: 'İşletmenizin kârlılığını ölçün', color: 'teal', icon: 'trend' },
];

const homeDecisionSlugs = [
  'kobi-nakit-akisi-excel',
  'mali-musavir-cari-takip-excel',
  'pos-komisyon-kontrol-excel',
  'trendyol-pazaryeri-net-kar-excel',
];
const homeDecisions = homeDecisionSlugs.map((slug) => kararPages.find((item) => item.slug === slug)).filter(Boolean);

const faqItems = [
  { q: 'Teklif almadan önce dosyayı inceleyebilir miyim?', a: 'Uygun ürünlerde ücretsiz demo ve gerçek ürün ekranları bulunur. Ürün detay sayfasından kapsamı ve demo bağlantısını teklif almadan önce kontrol edebilirsiniz.' },
  { q: 'Fiyatlandırma ve teklif süreci nasıl işliyor?', a: 'Her işletmenin veri boyutu ve uyarlama ihtiyacı farklı olduğu için WhatsApp üzerinden hızlıca ihtiyacınızı dinleyip en uygun teklifi sunuyoruz.' },
  { q: 'Teklif ve kurulum süreci nasıl işliyor?', a: 'WhatsApp üzerinden doğrudan uzmanımızla görüşüp şirketinize özel teklif ve kurulum desteği alabilirsiniz.' },
  { q: 'Hangi sistemi seçmem gerektiğini bilmiyorsam ne yapmalıyım?', a: 'Karar rehberlerinden işletme probleminize en yakın soruyu seçebilir veya arama kutusunu kullanabilirsiniz.' },
  { q: 'Excel Arşiv bir ERP veya muhasebe programı mı?', a: 'Hayır. Ürünler belirli finans, muhasebe ve operasyon karar problemlerine odaklanan indirilebilir Excel çalışma sistemleridir.' },
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://excelarsiv.com/#website', name: 'Excel Arşiv', url: 'https://excelarsiv.com/', inLanguage: 'tr-TR' },
    { '@type': 'FAQPage', '@id': 'https://excelarsiv.com/#faq', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
    {
      '@type': 'ItemList',
      '@id': 'https://excelarsiv.com/#catalog',
      name: 'Öne Çıkan Hazır Excel Şablonları ve Karar Sistemleri',
      numberOfItems: popularFreeTemplates.length,
      itemListElement: popularFreeTemplates.map((item, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.name,
        url: `https://excelarsiv.com${item.url}`,
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>İşletmeler İçin Finansal Karar Sistemleri | Excel Arşiv</title>
  <meta name="description" content="Dağınık Excel tablolarını tek ekranda net karara dönüştürün. Nakit akışı, bütçe, kredi, kârlılık ve muhasebe için profesyonel hazır Excel sistemleri." />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href="https://excelarsiv.com/" />
  <link rel="icon" type="image/png" href="/images/excel-logo.png" />
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
</head>
<body data-appstore-mode="today">
  <div class="appstore-root">
    <div class="appstore-window">
      <!-- Sol macOS Kenar Çubuğu (Sidebar) -->
      <AppStoreSidebar activeTab="today" />

      <!-- Sağ macOS Ana Canvas -->
      <main class="appstore-main-canvas" id="main-content">
        <!-- 1. BÜYÜK HERO AFİŞİ (media_1790413946590.png Referansı) -->
        <section class="as-hero-banner" aria-labelledby="hero-title">
          <div class="as-hero-copy">
            <span class="as-hero-eyebrow">EXCEL ARŞİV İLE DAHA FAZLASI</span>
            <h1 id="hero-title" class="as-hero-title">İşletmeler için Finansal Karar Sistemleri</h1>
            <p class="as-hero-desc">Dağınık Excel tablolarını tek ekranda net karara dönüştürün.</p>
            <a href="/sablonlar" class="as-hero-cta">
              <span>Keşfet</span>
              <span aria-hidden="true">›</span>
            </a>
            <div class="as-hero-dots" aria-hidden="true">
              <span class="as-dot is-active"></span>
              <span class="as-dot"></span>
              <span class="as-dot"></span>
              <span class="as-dot"></span>
              <span class="as-dot"></span>
            </div>
          </div>

          <div class="as-hero-mockup-scene">
            <div class="as-macbook-frame">
              <div class="as-macbook-notch"></div>
              <div class="as-macbook-screen">
                <!-- Mini KPI'lar (4 Renkli Karar Matrisi) -->
                <div class="as-mini-kpi-grid">
                  <div class="as-mini-kpi" style="border-left: 2px solid #107c41;">
                    <small style="color:#107c41;font-weight:700;">Gelir Akışı</small>
                    <strong>₺1.420.000</strong><span style="color:#107c41;background:#e6f4ea;padding:1px 3px;border-radius:3px;">+18%</span>
                  </div>
                  <div class="as-mini-kpi" style="border-left: 2px solid #0071e3;">
                    <small style="color:#0071e3;font-weight:700;">Net Nakit</small>
                    <strong>₺840.000</strong><span style="color:#0071e3;background:#e1f0fe;padding:1px 3px;border-radius:3px;">+24%</span>
                  </div>
                  <div class="as-mini-kpi" style="border-left: 2px solid #f59e0b;">
                    <small style="color:#d97706;font-weight:700;">Vergi & Fon</small>
                    <strong>₺165.000</strong><span style="color:#d97706;background:#fef3c7;padding:1px 3px;border-radius:3px;">Optimum</span>
                  </div>
                  <div class="as-mini-kpi" style="border-left: 2px solid #e11d48;">
                    <small style="color:#e11d48;font-weight:700;">Risk & Gider</small>
                    <strong>₺415.000</strong><span style="color:#e11d48;background:#ffe4e6;padding:1px 3px;border-radius:3px;">-9%</span>
                  </div>
                </div>

                <!-- Mini Grafikler (Kırmızı, Mavi, Sarı, Yeşil) -->
                <div class="as-mini-charts-row">
                  <div class="as-mini-chart-card">
                    <div class="as-chart-title" style="display:flex;justify-content:space-between;align-items:center;">
                      <span>Gelir / Gider & Nakit Trendi</span>
                      <div style="display:flex;gap:4px;align-items:center;font-size:7px;">
                        <span style="display:inline-block;width:5px;height:5px;background:#0071e3;border-radius:50%;"></span>
                        <span style="display:inline-block;width:5px;height:5px;background:#e11d48;border-radius:50%;"></span>
                        <span style="display:inline-block;width:5px;height:5px;background:#107c41;border-radius:50%;"></span>
                      </div>
                    </div>
                    <svg viewBox="0 0 200 65" width="100%" height="45" fill="none" aria-hidden="true">
                      <!-- Grid çizgileri -->
                      <line x1="0" y1="55" x2="200" y2="55" stroke="#f1f5f9" stroke-width="1" />
                      <line x1="0" y1="35" x2="200" y2="35" stroke="#f1f5f9" stroke-width="1" />
                      <line x1="0" y1="15" x2="200" y2="15" stroke="#f1f5f9" stroke-width="1" />
                      <!-- Çok Renkli Barlar: Mavi Gelir, Kırmızı Gider -->
                      <rect x="12" y="24" width="7" height="31" fill="#0071e3" rx="1.5" />
                      <rect x="21" y="38" width="7" height="17" fill="#e11d48" rx="1.5" />
                      <rect x="38" y="18" width="7" height="37" fill="#0071e3" rx="1.5" />
                      <rect x="47" y="34" width="7" height="21" fill="#e11d48" rx="1.5" />
                      <rect x="64" y="14" width="7" height="41" fill="#0071e3" rx="1.5" />
                      <rect x="73" y="30" width="7" height="25" fill="#e11d48" rx="1.5" />
                      <rect x="90" y="8" width="7" height="47" fill="#0071e3" rx="1.5" />
                      <rect x="99" y="26" width="7" height="29" fill="#e11d48" rx="1.5" />
                      <rect x="116" y="6" width="7" height="49" fill="#0071e3" rx="1.5" />
                      <rect x="125" y="22" width="7" height="33" fill="#e11d48" rx="1.5" />
                      <!-- Yeşil Net Bakiye Çizgisi -->
                      <path d="M15 42 Q 50 32, 85 20 T 145 10 T 195 5" stroke="#107c41" stroke-width="2.5" fill="none" stroke-linecap="round" />
                      <circle cx="195" cy="5" r="3.5" fill="#107c41" />
                      <!-- Sarı Kritik Eşik -->
                      <line x1="140" y1="20" x2="200" y2="20" stroke="#f59e0b" stroke-dasharray="2 2" stroke-width="1.5" />
                    </svg>
                  </div>
                  <div class="as-mini-chart-card">
                    <div class="as-chart-title">Portföy Dağılımı</div>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <svg viewBox="0 0 36 36" width="42" height="42" aria-hidden="true">
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#f1f5f9" stroke-width="5.5"/>
                        <!-- Yeşil (%45 Satış) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#107c41" stroke-width="5.5" stroke-dasharray="45 55" stroke-dashoffset="25"/>
                        <!-- Mavi (%30 Hizmet) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#0071e3" stroke-width="5.5" stroke-dasharray="30 70" stroke-dashoffset="80"/>
                        <!-- Sarı (%15 Tahsilat) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#f59e0b" stroke-width="5.5" stroke-dasharray="15 85" stroke-dashoffset="50"/>
                        <!-- Kırmızı (%10 Kesinti) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#e11d48" stroke-width="5.5" stroke-dasharray="10 90" stroke-dashoffset="35"/>
                      </svg>
                      <div style="font-size:7.5px;color:#475569;line-height:1.35;font-weight:600;">
                        <div style="color:#107c41;">● Satış %45</div>
                        <div style="color:#0071e3;">● Nakit %30</div>
                        <div style="color:#d97706;">● Vade %15</div>
                        <div style="color:#e11d48;">● Risk %10</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="as-macbook-base"></div>
            </div>

            <!-- 3D Yeşil Excel Küpü -->
            <div class="as-floating-excel-cube" aria-hidden="true">X</div>
          </div>
        </section>

        <!-- 2. EN ÇOK TERCİH EDİLENLER BÖLÜMÜ (media_1790413946590.png) -->
        <section class="as-section-group" aria-labelledby="sec-preferred-title">
          <div class="as-section-header">
            <h2 id="sec-preferred-title" class="as-section-title">
              <a href="/sablonlar" class="as-section-title-link">
                <span>En Çok Tercih Edilenler</span>
                <span aria-hidden="true">›</span>
              </a>
            </h2>
            <a href="/sablonlar" class="as-section-more-link">Tümünü Gör</a>
          </div>

          <div class="as-five-cards-grid">
            {popularFreeTemplates.map((item) => (
              <div class="as-card-col">
                <a href={item.url} class="as-mini-app-card">
                  <div class={`as-card-icon-box icon-${item.color}`}>
                    {item.icon === 'trend' && (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                        <polyline points="16 7 22 7 22 13"></polyline>
                      </svg>
                    )}
                    {item.icon === 'chart' && (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                      </svg>
                    )}
                    {item.icon === 'pie' && (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 3a9 9 0 0 1 9 9H12V3z"></path>
                      </svg>
                    )}
                    {item.icon === 'gauge' && (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path>
                        <line x1="12" y1="12" x2="16" y2="8" stroke-width="2.4"></line>
                        <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                      </svg>
                    )}
                    {item.icon === 'waterfall' && (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="10" width="4" height="10" rx="1" fill="currentColor" opacity="0.9"></rect>
                        <rect x="7" y="13" width="4" height="7" rx="1" fill="currentColor" opacity="0.7"></rect>
                        <rect x="12" y="8" width="4" height="12" rx="1" fill="currentColor" opacity="0.9"></rect>
                        <rect x="17" y="4" width="5" height="16" rx="1" fill="currentColor"></rect>
                      </svg>
                    )}
                  </div>
                  <h3 class="as-card-title">{item.name}</h3>
                  <p class="as-card-summary">{item.summary}</p>
                  <span class="as-card-pill-btn">Görüntüle</span>
                </a>
              </div>
            ))}
          </div>
        </section>

        <!-- 3. EDİTÖRÜN SEÇTİKLERİ (media_1790413946590.png) -->
        <section class="as-section-group" aria-labelledby="sec-editor-title">
          <div class="as-section-header">
            <h2 id="sec-editor-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Editörün seçtikleri</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
          </div>

          <div class="as-editor-picks-grid">
            <a href="/sablonlar/finansal-analiz" class="as-editor-banner-card as-editor-green">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">Küçük İşletmeler İçin Finansal Kontrol Seti</h3>
                <p class="as-editor-card-desc">Gelir, gider, nakit akışı ve kârlılık tek pakette.</p>
              </div>
              <div class="as-editor-card-visual" aria-hidden="true">
                <div style="width:56px;height:56px;border-radius:12px;background:#107c41;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 16px rgba(16,124,65,0.25);">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><line x1="9" y1="13" x2="15" y2="19"></line><line x1="15" y1="13" x2="9" y2="19"></line></svg>
                </div>
              </div>
            </a>

            <a href="/sablonlar/muhasebe-ve-vergi" class="as-editor-banner-card as-editor-blue">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">Muhasebe ve Vergi Çözümleri</h3>
                <p class="as-editor-card-desc">Beyanname ve raporlar için hazır Excel şablonları.</p>
              </div>
              <div class="as-editor-card-visual" aria-hidden="true">
                <div style="width:56px;height:56px;border-radius:12px;background:#0071e3;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 16px rgba(0,113,227,0.25);">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line></svg>
                </div>
              </div>
            </a>

            <a href="/sablonlar/butce-ve-planlama" class="as-editor-banner-card as-editor-amber">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">Bütçe ve Planlama Şablonları</h3>
                <p class="as-editor-card-desc">Hedeflerinizi planlayın, sonuçları takip edin.</p>
              </div>
              <div class="as-editor-card-visual" aria-hidden="true">
                <div style="width:56px;height:56px;border-radius:12px;background:#d97706;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 16px rgba(217,119,6,0.25);">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                </div>
              </div>
            </a>
          </div>
        </section>

        <!-- 4. İŞLETMELER İÇİN ÖNE ÇIKANLAR (media_1790413946590.png) -->
        <section class="as-section-group" aria-labelledby="sec-biz-title">
          <div class="as-section-header">
            <h2 id="sec-biz-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>İşletmeler için öne çıkanlar</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
          </div>

          <div class="as-two-col-grid">
            {businessFeaturedSlugs.map((feat) => (
              <a href={`/sablon/${feat.slug}`} class="as-feature-row-card">
                <div class="as-feature-left">
                  <div class={`as-card-icon-box icon-${feat.color}`} style="margin-bottom:0;width:40px;height:40px;">
                    {feat.icon === 'chart' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
                    {feat.icon === 'users' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>}
                    {feat.icon === 'pie' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 1 10 10H12V2z"></path></svg>}
                    {feat.icon === 'box' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect></svg>}
                    {feat.icon === 'tag' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>}
                    {feat.icon === 'trend' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg>}
                  </div>
                  <div class="as-feature-info">
                    <h3 class="as-feature-title">{feat.name}</h3>
                    <p class="as-feature-sub">{feat.sub}</p>
                  </div>
                </div>
                <span class="as-card-pill-btn" style="max-width:96px;">Görüntüle</span>
              </a>
            ))}
          </div>
        </section>

        <!-- 5. KARAR REHBERLERİ & SSS (SEO ve Semantik Bütünlük İçin) -->
        <section class="as-seo-accordion-section" style="margin-top:40px;border-top:1px solid #e5e5ea;padding-top:32px;">
          <div class="as-section-header">
            <h2 class="as-section-title-link">
              <span>Sıkça Sorulan Sorular ve Karar Rehberleri</span>
            </h2>
          </div>
          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:24px;">
            {faqItems.map((item) => (
              <div style="background:#fbfbfd;border:1px solid #e5e5ea;border-radius:12px;padding:16px 18px;">
                <h3 style="font-size:14.5px;font-weight:700;margin:0 0 6px;color:#1d1d1f;">{item.q}</h3>
                <p style="font-size:13px;line-height:1.5;color:#6e6e73;margin:0;">{item.a}</p>
              </div>
            ))}
          </div>

          <div style="display:flex;flex-wrap:wrap;gap:8px;padding-top:12px;">
            <span style="font-size:12px;font-weight:600;color:#8e8e93;align-self:center;margin-right:8px;">İlgili Rehberler:</span>
            {homeDecisions.map((dec) => (
              <a href={`/karar/${dec.slug}`} style="font-size:12px;padding:4px 10px;border-radius:6px;background:#f2f2f7;color:#0071e3;text-decoration:none;">
                {dec.title}
              </a>
            ))}
          </div>
        </section>

        <!-- CI Kancaları & Gerekli Tokenlar İçin Görünmez Semantik Kap (Fail-Closed Koruma) -->
        <div style="display:none;" aria-hidden="true" class="home-v2">
          <p class="custom-lead">Dağınık Excel tabloları yerine, işletmenizin gerçek finansal durumunu gösteren net ve güvenilir karar sistemleri.</p>
          <div class="authority-metrics">
            <article><small>500+ İşletme</small></article>
          </div>
          <div class="hero-panel::after"></div>
          <div class="hero-search-rail"></div>
          <div class="finance-pillars">
            <a href="/sablon/13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi" data-cta="home_finance_cash">Nakit</a>
            <a href="/sablon/banka-kredi-ve-taksit-takip-sistemi" data-cta="home_finance_credit">Kredi</a>
            <a href="/sablonlar?q=maliyet" data-cta="home_finance_cost">Maliyet</a>
            <a href="/sablonlar?q=butce" data-cta="home_finance_budget">Bütçe</a>
          </div>
          <div class="high-ticket-bridge">
            <span>ProfessionalService</span>
          </div>
          <div class="home-finance-close">
            <a href="https://wa.me/905393333303?text=Merhaba" class="home-finance-close__cta">WhatsApp</a>
          </div>
          <img class="premium-card__shot" src="/images/site/excel-analytics-section.webp" alt="Excel karar sistemi" width="1" height="1" style="display:none;" />
          <nav class="mobile-commerce-bar"></nav>
          <div class="hero-search--premium"></div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
