      },
      {
        id: 'butce-planlama',
        title: 'Yıllık Bütçe Planlama ve Gerçekleşme Analizi',
        category: 'Finans',
        typeBadge: 'Yönetici Raporu',
        updated: '2026 Güncel',
        downloads: 845,
