  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <meta name="theme-color" content="#107c41" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <style>
    :root {
      --color-excel-50: #f0fdf4;
      --color-excel-100: #dcfce7;
      --color-excel-500: #10b981;
      --color-excel-600: #107c41;
      --color-excel-700: #0b5c30;
      --color-excel-800: #064e3b;
      --color-excel-900: #022c22;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .text-excel-600 { color: #107c41; }
    .text-excel-700 { color: #0b5c30; }
    .text-excel-800 { color: #064e3b; }
    .bg-excel-600 { background-color: #107c41; }
    .bg-excel-700 { background-color: #0b5c30; }
    .hover\:bg-excel-700:hover { background-color: #0b5c30; }
    .grid-pattern {
      background-image: linear-gradient(to right, rgba(16, 124, 65, 0.05) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(16, 124, 65, 0.05) 1px, transparent 1px);
      background-size: 28px 28px;
    }
    .scroll-mt-header {
      scroll-margin-top: 5rem;
    }
    footer, footer * {
      box-sizing: border-box;
    }
    footer .grid {
      width: 100% !important;
    }
  </style>
</head>
<body class="antialiased selection:bg-emerald-600 selection:text-white" data-appstore-mode="today" data-home-pro-v2 data-dual-funnel-home-v17 data-mobile-premium-v18 data-desktop-premium-v19>
