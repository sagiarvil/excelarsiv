---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import PremiumFeaturedTemplates from '../components/home/PremiumFeaturedTemplates.astro';
import CategorySection from '../components/home/CategorySection.astro';
import MoatStrip from '../components/home/MoatStrip.astro';
import ProofGallery from '../components/home/ProofGallery.astro';
import ValueSection from '../components/home/ValueSection.astro';
import PurchaseProcess from '../components/home/PurchaseProcess.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import YazarKutusu from '../components/YazarKutusu.astro';
import { getAllTemplates, getTemplateSearchIndex } from '../lib/templates';

const allTemplates = await getAllTemplates();
const featuredTemplates = allTemplates.slice(0, 4);
const searchIndex = await getTemplateSearchIndex();
const showcaseTitle = 'Her ürün kendi karar ekranıyla gelir.';
const homeItemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/#itemlist', Astro.site).toString(),
  name: showcaseTitle,
  numberOfItems: featuredTemplates.length,
  itemListElement: featuredTemplates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${template.slug}`, Astro.site).toString(),
    name: template.name,
  })),
});
---

<CommerceLayout
  title="Excel Şablonları ve Finans Yönetim Sistemleri | Excel Arşiv"
  description="KOBİ kasa defteri, nakit akış, cari hesap ve kârlılık Excel şablonları. Demo ile inceleyin."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={homeItemListLd} />
  </Fragment>
  <HeroSection searchIndex={searchIndex} />
  <TrustStrip />

  <div id="urunler" data-experience-stage>
    <PremiumFeaturedTemplates templates={featuredTemplates} />
  </div>

  <div id="kategoriler" data-experience-stage>
    <CategorySection />
  </div>

  <div id="sistem" data-experience-stage data-mobile-deferred-rich>
    <MoatStrip />
  </div>

  <div id="kanit" data-experience-stage data-mobile-deferred-rich>
    <ProofGallery />
  </div>

  <div id="deger" data-experience-stage data-mobile-deferred-rich>
    <ValueSection />
  </div>

  <div id="satin-alma" data-experience-stage>
    <div data-mobile-deferred-rich>
      <PurchaseProcess />
    </div>
    <FinalCTA />
    <div class="home-yazar">
      <YazarKutusu varyant="sablon" />
    </div>
  </div>
</CommerceLayout>

<style>
  :root {
    --font-sans: ui-sans-serif, system-ui, sans-serif;
    --font-mono-face: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  [data-experience-stage] {
    scroll-margin-top: 92px;
    content-visibility: auto;
    contain-intrinsic-size: auto 760px;
  }

  [data-mobile-deferred-rich] {
    display: none;
  }

  @media (min-width: 721px) {
    [data-mobile-deferred-rich] {
      display: block;
    }
  }

  .home-yazar {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto 72px;
  }

  @media (max-width: 720px) {
    .home-yazar {
      width: calc(100% - 32px);
      margin-bottom: 48px;
    }
  }
</style>


<style is:global>
/* HOME SIMPLIFIED PREMIUM V2 */

/* HERO */
[data-home="hero"] {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

[data-home="hero"]::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(
      90deg,
      rgba(3, 7, 12, .36) 0%,
      rgba(3, 7, 12, .25) 42%,
      rgba(3, 7, 12, .12) 75%,
      rgba(3, 7, 12, .06) 100%
    );
}

[data-home="hero"] img {
  filter: saturate(.94) contrast(1.025);
  transform: scale(1.008);
}

[data-home="hero"] :is(
  h1,h2,h3,p,a,button,span,strong,small,form,input,label
) {
  position: relative;
  z-index: 2;
}

[data-home="hero"] h1 {
  text-shadow:
    0 3px 22px rgba(0,0,0,.22),
    0 1px 4px rgba(0,0,0,.16);
}

/* ANA SAYFA RİTMİ */
[data-home="categories"],
[data-home="products"],
[data-home="proof"],
[data-home="purchase"] {
  position: relative;
  margin-top: clamp(48px, 6vw, 88px);
}

/* KATEGORİLER */
[data-home="categories"] {
  margin-top: clamp(42px, 5vw, 72px);
}

/* ÜRÜNLER */
[data-home="products"] {
  margin-top: clamp(52px, 6vw, 88px);
}

/* GERÇEK EXCEL EKRANLARI */
[data-home="proof"] {
  padding-block: clamp(36px, 5vw, 64px);
}

[data-home="proof"]::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: 28px;
  border: 1px solid rgba(15,23,42,.07);
  background:
    linear-gradient(
      145deg,
      rgba(15,23,42,.035),
      rgba(255,255,255,.4)
    );
}

/* SATIN ALMA */
[data-home="purchase"] {
  margin-bottom: clamp(52px, 7vw, 96px);
  padding-block: clamp(38px, 5vw, 64px);
}

[data-home="purchase"]::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: 28px;
  border: 1px solid rgba(15,23,42,.07);
  background:
    linear-gradient(
      160deg,
      rgba(15,23,42,.045),
      rgba(255,255,255,.25)
    );
}

/* MOBİL */
@media (max-width: 720px) {
  [data-home="hero"]::after {
    background:
      linear-gradient(
        180deg,
        rgba(3,7,12,.30),
        rgba(3,7,12,.18)
      );
  }

  [data-home="hero"] img {
    transform: none;
  }

  [data-home="categories"],
  [data-home="products"],
  [data-home="proof"],
  [data-home="purchase"] {
    margin-top: 40px;
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-home="hero"] img {
    transform: none;
  }
}
</style>
