---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import { getAllTemplates, getTemplateSearchIndex } from '../lib/templates';
import { kararPages } from '../data/kararPages';

const templates = await getAllTemplates();
const searchIndex = await getTemplateSearchIndex();
const productCount = templates.length;
const categoryCount = new Set(templates.map((item) => item.categorySlug)).size;
const minPrice = Math.min(...templates.map((item) => item.priceTL));
const featured = [
  '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi',
  'aylik-patron-finans-paneli',
  'akilli-kasa-defteri-ve-nakit-kontrol-sistemi',
].map((slug) => templates.find((item) => item.slug === slug)).filter(Boolean);
const homeDecisionSlugs = [
  'kobi-nakit-akisi-excel',
  'mali-musavir-cari-takip-excel',
  'pos-komisyon-kontrol-excel',
  'trendyol-pazaryeri-net-kar-excel',
  'kdv-iade-dosyasi-excel',
  'kidem-ihbar-maliyeti-excel',
  'insaat-hakedis-excel',
  'sube-karlilik-analizi-excel',
];
const homeDecisions = homeDecisionSlugs.map((slug) => kararPages.find((item) => item.slug === slug)).filter(Boolean);
const faqItems = [
  { q: 'İşletmemize veya muhasebe ofisimize özel Excel sistemi hazırlıyor musunuz?', a: 'Evet. Mevcut çalışma biçiminizi, tekrar eden işleri, kontrol noktalarını ve yönetim ihtiyacını analiz ederek size özel Excel otomasyon, mini ERP, CRM ve yönetim sistemleri tasarlıyoruz.' },
  { q: 'Elimizdeki mevcut Excel dosyasını geliştirebilir misiniz?', a: 'Evet. Mevcut dosyanızı tamamen değiştirmek zorunda değilsiniz. Kullanışlı bölümleri koruyup formül, kontrol, raporlama, otomasyon ve kullanıcı deneyimi açısından yeniden yapılandırabiliriz.' },
  { q: 'Hazır sistemler ne zaman uygun?', a: 'İhtiyacınız yaygın ve standart bir iş problemine uyuyorsa hazır sistem daha hızlı ve ekonomik olabilir. Önce hazır çözüm uygun mu, yoksa özel çalışma mı gerekiyor bunu ayırmak en doğru adımdır.' },
  { q: 'Özel çalışma nasıl başlıyor?', a: 'İhtiyacınızı, mevcut dosyanızı veya ekran görüntülerini paylaşmanız yeterlidir. Önce kapsam çıkarılır; teslim şekli ve proje bedeli yazılı olarak netleştirilir, ardından üretime geçilir.' },
  { q: 'Ödeme nasıl yapılıyor?', a: 'Hazır ürün ödemeleri Shopier üzerinden tamamlanır. Özel projelerde kapsam ve bedel netleştikten sonra güvenli ödeme bağlantısı paylaşılır.' },
];
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://excelarsiv.com/#website', name: 'Excel Arşiv', url: 'https://excelarsiv.com/', inLanguage: 'tr-TR' },
    { '@type': 'Service', '@id': 'https://excelarsiv.com/#custom-service', name: 'İşletmelere ve Muhasebe Ofislerine Özel Excel Sistemleri', serviceType: 'Özel Excel otomasyon, mini ERP, CRM ve yönetim sistemi geliştirme', areaServed: { '@type': 'Country', name: 'Türkiye' }, url: 'https://excelarsiv.com/ozel-excel-sistemleri' },
    { '@type': 'FAQPage', '@id': 'https://excelarsiv.com/#faq', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  ],
};
---

<CommerceLayout
  title="İşletmelere ve Muhasebe Ofislerine Özel Excel Sistemleri | Excel Arşiv"
  description="İşletmenizin veya muhasebe ofisinizin gerçek iş akışına göre özel Excel otomasyon, mini ERP, CRM, finans ve yönetim sistemleri. Hazır çözüm uygunsa katalogdan, değilse size özel tasarım."
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} /></Fragment>

  <div class="home-v3">
    <HeroSection searchIndex={searchIndex} />

    <section class="audience" data-experience-stage>
      <div class="home-shell">
        <div class="section-intro">
          <p class="eyebrow">KİMİN İÇİN, NEYİ ÇÖZÜYORUZ?</p>
          <h2>Excel dosyası değil; işletmenin günlük işini taşıyan çalışma sistemi.</h2>
          <p>İhtiyaç bazen cari ve tahsilat takibi, bazen müşteri yönetimi, bazen stok ve üretim, bazen de patronun tek ekranda görmek istediği finansal sonuçtur. Sistemi dosya mantığıyla değil, iş akışı mantığıyla kuruyoruz.</p>
        </div>
        <div class="audience-grid">
          <article><span>01</span><h3>Muhasebe Ofisleri</h3><p>Müşteri, sözleşme, tahsilat, görev, dönem, belge ve yönetim takibini tek çalışma düzeninde birleştiren sistemler.</p></article>
          <article><span>02</span><h3>Ticari İşletmeler</h3><p>Cari, kasa, banka, nakit akışı, kredi, stok, satış ve maliyet verilerini yöneticinin karar vereceği yapıya dönüştüren çözümler.</p></article>
          <article><span>03</span><h3>Finans ve Operasyon Ekipleri</h3><p>Tekrarlı veri girişini azaltan, kontrolleri otomatikleştiren, rapor üretimini hızlandıran özel iş akışları.</p></article>
          <article><span>04</span><h3>Mevcut Excel'ini Büyütmek İsteyenler</h3><p>Yıllardır kullanılan dosyayı çöpe atmadan; formül, yetki, doğrulama, panel ve otomasyon katmanlarıyla yeniden kurma.</p></article>
        </div>
      </div>
    </section>

    <section class="custom-primary" data-experience-stage>
      <div class="home-shell custom-grid">
        <div>
          <p class="eyebrow">SİZE ÖZEL ÇALIŞMA</p>
          <h2>Hazır sistemin yetmediği yerde, sizin işleyişinizden başlayıp sistemi sıfırdan kuruyoruz.</h2>
          <p>İlk soru “hangi kolonlar olsun?” değil. Nerede zaman kaybediliyor, hangi kayıt iki kez giriliyor, hangi kontrol unutuluyor, hangi sonuç yöneticiye geç ulaşıyor? Bunları netleştirip Excel'i bu akışın taşıyıcısına dönüştürüyoruz.</p>
          <div class="need-list">
            <span>Cari / tahsilat / nakit</span><span>Müşteri / CRM</span><span>Stok / üretim</span><span>Teklif / fiyatlama</span><span>Bütçe / finans</span><span>Yönetim panosu</span>
          </div>
          <div class="actions"><a class="primary" href="/ozel-excel-sistemleri">Özel sistem hizmetini inceleyin</a><a href="/iletisim">İhtiyacımı anlatayım →</a></div>
        </div>
        <aside class="case-card">
          <p class="eyebrow">GERÇEK PROJE KANITI</p>
          <h3>Muhasebe ofisi için özel yönetim sistemi</h3>
          <div class="case-stats"><div><strong>6 saat</strong><span>ihtiyaç analizi + üretim</span></div><div><strong>10.000 TL</strong><span>gerçekleşen proje bedeli</span></div></div>
          <p>LinkedIn üzerinden gelen ihtiyaç, hazır şablona uydurulmadı. Ofisin müşteri, sözleşme, tahsilat ve yönetim akışı okunarak aynı gün çalışan özel sisteme dönüştürüldü.</p>
          <small>Gerçekleşmiş proje örneğidir; yeni projeler ayrıca kapsamlandırılır.</small>
        </aside>
      </div>
    </section>

    <section class="method" data-experience-stage>
      <div class="home-shell method-grid">
        <div><p class="eyebrow">YAKLAŞIM</p><h2>İşleyişi anlayan, sonra Excel'e çeviren model.</h2></div>
        <div class="method-list">
          <div><b>01</b><strong>İhtiyacı teşhis et</strong><span>Teknik şartname istemeden gerçek iş akışını ve darboğazı anla.</span></div>
          <div><b>02</b><strong>Kontrolü sisteme ver</strong><span>Formül, doğrulama ve kritik alanları kullanıcı hatasına karşı koru.</span></div>
          <div><b>03</b><strong>Kararı görünür yap</strong><span>Ham veri yerine KPI, alarm, özet ve yönetici ekranı üret.</span></div>
          <div><b>04</b><strong>Kapsamı gereksiz büyütme</strong><span>ERP gerekiyorsa ERP; Excel yeterliyse daha hafif ve hızlı çözüm kur.</span></div>
        </div>
      </div>
    </section>

    <section id="hazir-sistemler" class="catalog-proof" data-experience-stage>
      <div class="home-shell">
        <div class="section-head">
          <div><p class="eyebrow">HAZIR ÇÖZÜMLER — İKİNCİ YOL</p><h2>İhtiyacınız standartsa sıfırdan proje yaptırmak zorunda değilsiniz.</h2><p>{productCount} hazır sistem, {categoryCount} işletme alanı. Başlangıç fiyatı {minPrice.toLocaleString('tr-TR')} TL. Hazır çözüm uygunsa gerçek ekranları ve demoyu inceleyip doğrudan satın alabilirsiniz.</p></div>
          <a href="/sablonlar">Tüm hazır sistemler →</a>
        </div>
        <div class="featured-grid">{featured.map((item) => item && <article><a class="shot" href={item.url}><img src={item.kapak} alt={`${item.name} ürün kapağı`} width="1200" height="900" loading="lazy" /></a><div><small>{item.categoryName}</small><h3><a href={item.url}>{item.name}</a></h3><p>{item.summary}</p><strong>{item.priceTL.toLocaleString('tr-TR')} TL</strong></div></article>)}</div>
      </div>
    </section>

    <section class="decision-help" data-experience-stage>
      <div class="home-shell">
        <div class="section-head"><div><p class="eyebrow">SORUNUNUZDAN BAŞLAYIN</p><h2>Ne alacağınızı değil, neyi çözmek istediğinizi seçin.</h2><p>Hazır sistem mi, özel çalışma mı gerektiğini ürün adından değil işletme probleminden hareketle belirleyin.</p></div><a href="/karar">Tüm karar rehberleri →</a></div>
        <div class="decision-grid">{homeDecisions.map((page, index) => page && <a href={`/karar/${page.slug}`}><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{page.title}</h3><p>{page.description}</p></div><b>İncele →</b></a>)}</div>
      </div>
    </section>

    <section class="expert-proof" data-experience-stage>
      <div class="home-shell expert-grid">
        <div><p class="eyebrow">TASARLAYAN / DENETLEYEN</p><h2>Finans, saha ve işletme tecrübesi yazılım üretimiyle birleşiyor.</h2><p><strong>Barış Bağırlar</strong> — uzun yıllar ticari bankacılık, saha ve işletme analizi tecrübesini Excel ve yazılım üretimiyle birleştirir. Amaç size daha fazla tablo vermek değil; gerçekten kullanacağınız sistemi kurmaktır.</p><div class="actions"><a href="/hakkinda">Uzman profili →</a><a href="/neden-excel-arsiv">Yöntem ve farklar →</a></div></div>
        <div class="validation"><a href="https://www.linkedin.com/in/barisbagirlar/" target="_blank" rel="noopener noreferrer external"><span>Profesyonel profil</span><strong>LinkedIn ↗</strong></a><a href="https://www.tarimkon.org/danisma-kurulu/" target="_blank" rel="noopener noreferrer external"><span>Kurumsal kayıt</span><strong>TARIMKON ↗</strong></a><a href="https://www.shopier.com/excelarsiv" target="_blank" rel="noopener noreferrer external"><span>Güvenli ödeme</span><strong>Shopier ↗</strong></a></div>
      </div>
    </section>

    <section class="faq-close" data-experience-stage>
      <div class="home-shell faq-grid">
        <div><p class="eyebrow">HANGİ YOL?</p><h2>Hazır sistem mi, size özel çalışma mı?</h2><p>Standart ihtiyaca hazır çözüm; işletmenize özgü iş akışına özel sistem. Emin değilseniz ihtiyacınızı anlatın, doğru yolu birlikte ayıralım.</p><div class="actions"><a class="primary" href="/ozel-excel-sistemleri">Özel sistem talebi</a><a href="/sablonlar">Hazır sistemleri inceleyin</a></div></div>
        <div class="faq-list">{faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
      </div>
    </section>
  </div>
</CommerceLayout>

<style>
  [data-experience-stage]{content-visibility:auto;contain-intrinsic-size:auto 720px;scroll-margin-top:92px}.home-v3{--green:#166534;--green-dark:#14532d;--ink:#172019;--muted:#667169;--line:#dfe5e0;--soft:#f5f8f5;background:#fff;color:var(--ink)}.home-shell{width:min(1180px,calc(100% - 48px));margin:0 auto}.eyebrow{margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:850;line-height:1.2;letter-spacing:.13em;color:var(--green)}
  .audience,.custom-primary,.method,.catalog-proof,.decision-help,.expert-proof,.faq-close{padding:72px 0;border-bottom:1px solid var(--line)}.section-intro{max-width:820px;margin-bottom:32px}.section-intro h2,.custom-primary h2,.method h2,.section-head h2,.expert-proof h2,.faq-close h2{margin:10px 0 14px;font-size:clamp(32px,4.3vw,54px);line-height:1.02;letter-spacing:-.046em}.section-intro>p:not(.eyebrow),.custom-primary p,.section-head p,.expert-proof p,.faq-close p{color:var(--muted);line-height:1.72}.audience-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.audience-grid article{padding:24px;border:1px solid var(--line);background:#fff}.audience-grid span{font:850 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--green)}.audience-grid h3{margin:16px 0 8px;font-size:21px}.audience-grid p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}
  .custom-primary{background:linear-gradient(135deg,#f8fbf8 0%,#eef7f0 100%)}.custom-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center}.need-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.need-list span{padding:9px 11px;background:#fff;border:1px solid var(--line);font-size:11px;font-weight:760}.actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}.actions a{padding:13px 17px;border:1px solid #b8c6bb;background:#fff;color:var(--ink);font-size:12px;font-weight:820;text-decoration:none}.actions .primary{background:var(--green);border-color:var(--green);color:#fff}.case-card{padding:30px;border:1px solid #c8d8cc;background:#fff;box-shadow:0 22px 54px rgba(22,101,52,.09)}.case-card h3{margin:10px 0;font-size:30px;line-height:1.04;letter-spacing:-.04em}.case-stats{display:grid;grid-template-columns:1fr 1fr;margin:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.case-stats div{padding:17px 0}.case-stats div+div{padding-left:18px;border-left:1px solid var(--line)}.case-stats strong{display:block;font-size:25px;color:var(--green-dark)}.case-stats span,.case-card small{display:block;margin-top:3px;color:#768078;font-size:10px}
  .method{background:#162219;color:#fff}.method-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:54px}.method .eyebrow{color:#77d59a}.method h2{color:#fff}.method-list{display:grid;gap:10px}.method-list>div{display:grid;grid-template-columns:42px 180px 1fr;gap:14px;align-items:center;padding:15px;border:1px solid #35523e;background:#1c2b21}.method-list b{color:#77d59a}.method-list strong{font-size:13px}.method-list span{color:#b9c8bd;font-size:12px;line-height:1.5}
  .section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:28px}.section-head>div{max-width:820px}.section-head>a{white-space:nowrap;color:var(--green-dark);font-weight:820}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.featured-grid article{border:1px solid var(--line);background:#fff}.shot{display:block;aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--line)}.shot img{width:100%;height:100%;object-fit:cover}.featured-grid article>div{padding:18px}.featured-grid small{font:820 9px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--green)}.featured-grid h3{margin:8px 0;font-size:21px;line-height:1.08}.featured-grid h3 a{color:var(--ink);text-decoration:none}.featured-grid p{min-height:56px;color:var(--muted);font-size:12px;line-height:1.6}.featured-grid strong{font-size:18px}
  .decision-help{background:#f7f9f7}.decision-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.decision-grid>a{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:center;padding:16px;border:1px solid var(--line);background:#fff;color:var(--ink);text-decoration:none}.decision-grid>a>span{font:850 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--green)}.decision-grid h3{margin:0;font-size:15px}.decision-grid p{margin:4px 0 0;color:var(--muted);font-size:11px;line-height:1.45}.decision-grid b{font-size:10px;color:var(--green-dark)}
  .expert-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:42px;align-items:start}.validation{display:grid;border:1px solid var(--line)}.validation a{display:flex;justify-content:space-between;gap:20px;padding:17px;border-bottom:1px solid var(--line);color:var(--ink);text-decoration:none}.validation a:last-child{border-bottom:0}.validation span{color:var(--muted);font-size:11px}.validation strong{font-size:12px}.faq-close{background:#f3f7f4}.faq-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px}.faq-list{display:grid;gap:8px}.faq-list details{border:1px solid var(--line);background:#fff}.faq-list summary{padding:16px;cursor:pointer;font-size:13px;font-weight:820}.faq-list p{margin:0;padding:0 16px 16px;font-size:12px;line-height:1.65}
  @media(max-width:940px){.audience-grid{grid-template-columns:1fr 1fr}.custom-grid,.method-grid,.expert-grid,.faq-grid{grid-template-columns:1fr}.featured-grid{grid-template-columns:1fr 1fr}.method-list>div{grid-template-columns:36px 160px 1fr}}
  @media(max-width:650px){.home-shell{width:calc(100% - 28px)}.audience,.custom-primary,.method,.catalog-proof,.decision-help,.expert-proof,.faq-close{padding:54px 0}.audience-grid,.featured-grid,.decision-grid{grid-template-columns:1fr}.section-head{align-items:start;flex-direction:column}.case-card{padding:22px}.case-stats{grid-template-columns:1fr}.case-stats div+div{padding-left:0;border-left:0;border-top:1px solid var(--line)}.method-list>div{grid-template-columns:32px 1fr}.method-list span{grid-column:2}.actions{display:grid}.actions a{text-align:center}}
</style>
