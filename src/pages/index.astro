      }
    ];

    const simulatorConfigs = {
      nakit: {
        fileName: 'Nakit_Akisi_ve_Likidite_Yonetimi_2026.xlsm — Açık Kaynak (Şifresiz)',
        formula: '=ETOPLA(Hareketler!C:C; "Tahsilat"; Hareketler!F:F) - ETOPLA(Hareketler!C:C; "Ödeme"; Hareketler!F:F)',
        tableTitle: 'Aylık Kasa & Banka Nakit Akış Tablosu (Rakamları Değiştirip Test Edin)',
        headers: ['Dönem / Ay', 'Nakit Girişi (₺)', 'Nakit Çıkışı (₺)', 'Net Nakit Akışı'],
        kpiLabels: ['Toplam Tahsilat Girişi', 'Toplam Ödeme Çıkışı', 'Net Kasa Likiditesi'],
        unit: '₺',
        rows: [
          { label: 'Ocak 2026', inVal: 480000, outVal: 320000 },
          { label: 'Şubat 2026', inVal: 530000, outVal: 390000 },
          { label: 'Mart 2026', inVal: 610000, outVal: 410000 },
          { label: 'Nisan 2026', inVal: 720000, outVal: 460000 }
        ]
      },
      satis: {
        fileName: 'Satis_Pipeline_Kanban_ve_Hedef_Dashboard_2026.xlsx',
        formula: '=EĞERHATA(D4/C4; 0) * 100 // Hedef Gerçekleşme ve Pipeline Dönüşüm Oranı',
        tableTitle: 'Bölge & Temsilci Satış Pipeline Tablosu (Rakamları Değiştirip Test Edin)',
        headers: ['Satış Kanalı / Ekip', 'Aylık Hedef (₺)', 'Maliyet / İskonto (₺)', 'Net Ciro Katkısı'],
        kpiLabels: ['Toplam Pipeline Hedefi', 'Toplam İskonto/Maliyet', 'Net Gerçekleşen Ciro'],
        unit: '₺',
        rows: [
          { label: 'Kurumsal B2B Satış', inVal: 850000, outVal: 95000 },
          { label: 'E-Ticaret & Pazaryeri', inVal: 640000, outVal: 110000 },
          { label: 'Bayi & Kanal Satış', inVal: 520000, outVal: 70000 },
          { label: 'İhracat / Yurt Dışı', inVal: 910000, outVal: 130000 }
        ]
      },
      ik: {
        fileName: 'Personel_Izin_Hakedis_ve_Fazla_Mesai_Puantaj_2026.xlsx',
        formula: '=EĞER(KIDEM_YILI>=15; 26; EĞER(KIDEM_YILI>=5; 20; 14)) - KULLANILAN_IZIN',
        tableTitle: 'Departman Fazla Mesai & İzin Maliyet Simülasyonu',
        headers: ['Departman', 'Normal Mesai Bütçesi (₺)', 'Fazla Mesai & İzin Yükü (₺)', 'Net Verimlilik Farkı'],
        kpiLabels: ['Toplam Bordro Bütçesi', 'Fazla Mesai Maliyeti', 'Net Bütçe Dengesi'],
        unit: '₺',
        rows: [
          { label: 'Üretim & Operasyon', inVal: 420000, outVal: 68000 },
          { label: 'Lojistik & Depo', inVal: 290000, outVal: 44000 },
          { label: 'Satış & Saha Ekibi', inVal: 350000, outVal: 32000 },
          { label: 'Finans & İdari İşler', inVal: 240000, outVal: 15000 }
        ]
      }
    };

    // --- 2. UYGULAMA DURUMU (STATE) ---
    let activeCategory = 'all';
    let searchQuery = '';
    let activeSort = 'popular';
    let activeSimKey = 'nakit';
    let simState = JSON.parse(JSON.stringify(simulatorConfigs));
    let simChartInstance = null;

    let cart = [
      { id: 'vip-paket', title: 'VIP Tam Arşiv (2.750+ Şablon) + 152 Saat Eğitim Seti', price: 2000 }
    ];

    // --- 3. YARDIMCI FONKSİYONLAR ---
    function formatTL(num) {
      return Number(num).toLocaleString('tr-TR') + ' ₺';
    }

    function showToast(msg) {
      const banner = document.getElementById('toastBanner');
      const text = document.getElementById('toastMessage');
      text.textContent = msg;
      banner.classList.remove('hidden');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => {
        banner.classList.add('hidden');
      }, 3500);
    }

    // --- 4. CANLI EXCEL SİMÜLATÖRÜ RENDER & CHART ---
    function renderSimulator() {
      const cfg = simState[activeSimKey];
      document.getElementById('simFileName').textContent = cfg.fileName;
      document.getElementById('simFormulaText').textContent = cfg.formula;
      document.getElementById('simTableTitle').textContent = cfg.tableTitle;
      document.getElementById('colHeader1').textContent = cfg.headers[0];
      document.getElementById('colHeader2').textContent = cfg.headers[1];
      document.getElementById('colHeader3').textContent = cfg.headers[2];
      document.getElementById('colHeader4').textContent = cfg.headers[3];

      document.getElementById('kpi1Label').textContent = cfg.kpiLabels[0];
      document.getElementById('kpi2Label').textContent = cfg.kpiLabels[1];
      document.getElementById('kpi3Label').textContent = cfg.kpiLabels[2];

      const tbody = document.getElementById('simTableBody');
      tbody.innerHTML = '';

      let totalIn = 0;
      let totalOut = 0;

      cfg.rows.forEach((row, idx) => {
        const net = row.inVal - row.outVal;
        totalIn += row.inVal;
        totalOut += row.outVal;

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition';
        tr.innerHTML = `
          <td class="border border-slate-300 px-2 py-2 text-center bg-slate-100 font-mono text-slate-500">${idx + 1}</td>
          <td class="border border-slate-300 px-3 py-2 font-semibold text-slate-800">${row.label}</td>
          <td class="border border-slate-300 px-2 py-1.5 text-right">
            <input type="number" step="10000" data-row="${idx}" data-field="inVal" value="${row.inVal}" class="sim-cell-input w-28 text-right px-2 py-1 rounded bg-emerald-50/50 border border-emerald-200 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-excel-600" />
          </td>
          <td class="border border-slate-300 px-2 py-1.5 text-right">
            <input type="number" step="10000" data-row="${idx}" data-field="outVal" value="${row.outVal}" class="sim-cell-input w-28 text-right px-2 py-1 rounded bg-rose-50/50 border border-rose-200 font-bold text-rose-700 focus:outline-none focus:ring-2 focus:ring-excel-600" />
          </td>
          <td class="border border-slate-300 px-3 py-2 text-right font-extrabold bg-emerald-50/60 ${net >= 0 ? 'text-excel-700' : 'text-rose-600'}">
            ${formatTL(net)}
          </td>
        `;
        tbody.appendChild(tr);
      });

      const netTotal = totalIn - totalOut;
      document.getElementById('kpi1Value').textContent = formatTL(totalIn);
      document.getElementById('kpi2Value').textContent = formatTL(totalOut);
      document.getElementById('kpi3Value').textContent = formatTL(netTotal);

      // Input eventlerini bağla
      tbody.querySelectorAll('.sim-cell-input').forEach(inp => {
        inp.addEventListener('input', (e) => {
          const rIdx = parseInt(e.target.getAttribute('data-row'), 10);
          const field = e.target.getAttribute('data-field');
          const val = parseFloat(e.target.value) || 0;
          simState[activeSimKey].rows[rIdx][field] = val;
          updateSimulatorTotalsAndChart();
        });
      });

      updateSimulatorChart();
    }

    function updateSimulatorTotalsAndChart() {
      const cfg = simState[activeSimKey];
      const tbody = document.getElementById('simTableBody');
      let totalIn = 0;
      let totalOut = 0;

      cfg.rows.forEach((row, idx) => {
        const net = row.inVal - row.outVal;
        totalIn += row.inVal;
        totalOut += row.outVal;
        const netCell = tbody.rows[idx].cells[4];
        netCell.textContent = formatTL(net);
      });

      document.getElementById('kpi1Value').textContent = formatTL(totalIn);
      document.getElementById('kpi2Value').textContent = formatTL(totalOut);
      document.getElementById('kpi3Value').textContent = formatTL(totalIn - totalOut);
      updateSimulatorChart();
    }

    function updateSimulatorChart() {
      const cfg = simState[activeSimKey];
      const labels = cfg.rows.map(r => r.label);
      const inData = cfg.rows.map(r => r.inVal);
      const outData = cfg.rows.map(r => r.outVal);
      const netData = cfg.rows.map(r => r.inVal - r.outVal);

      const ctx = document.getElementById('simulatorChart').getContext('2d');
      if (simChartInstance) {
        simChartInstance.data.labels = labels;
        simChartInstance.data.datasets[0].data = inData;
        simChartInstance.data.datasets[1].data = outData;
        simChartInstance.data.datasets[2].data = netData;
        simChartInstance.update();
        return;
      }

      simChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Giriş / Hedef (₺)',
              data: inData,
              backgroundColor: '#10b981',
              borderRadius: 6
            },
            {
              label: 'Çıkış / Maliyet (₺)',
              data: outData,
              backgroundColor: '#f43f5e',
              borderRadius: 6
            },
            {
              label: 'Net Bakiye (₺)',
              data: netData,
              type: 'line',
              borderColor: '#0f172a',
              backgroundColor: '#0f172a',
              borderWidth: 2,
              tension: 0.3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { boxWidth: 10, font: { size: 11 } }
            }
          },
          scales: {
            y: {
              ticks: {
                font: { size: 10 },
                callback: function(val) {
                  return (val / 1000) + 'B ₺';
                }
              }
            },
            x: {
              ticks: { font: { size: 10 } }
            }
          }
        }
      });
    }

    // --- 5. ŞABLON VİTRİNİ RENDER ---
    function renderTemplates() {
      const grid = document.getElementById('templateGrid');
      grid.innerHTML = '';

      let filtered = templates.filter(item => {
        const matchesCat = activeCategory === 'all' || item.category === activeCategory;
        const q = searchQuery.trim().toLowerCase();
        const matchesSearch = !q || item.title.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q) || item.category.toLowerCase().includes(q);
        return matchesCat && matchesSearch;
      });

      if (activeSort === 'popular') {
        filtered.sort((a, b) => b.downloads - a.downloads);
      } else if (activeSort === 'price-asc') {
        filtered.sort((a, b) => a.price - b.price);
      }

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full bg-slate-50 p-8 rounded-2xl text-center border border-slate-200">
            <p class="text-sm font-bold text-slate-800">Aramanızla eşleşen şablon bulunamadı.</p>
            <p class="text-xs text-slate-500 mt-1">Filtreyi sıfırlayabilir veya sağ alttaki Canlı Destek'ten özel tablo talep edebilirsiniz.</p>
          </div>
        `;
        return;
      }

      filtered.forEach(item => {
        const card = document.createElement('div');
        card.className = 'bg-slate-50 rounded-2xl p-5 border border-slate-200 hover:border-excel-600 hover:shadow-lg transition flex flex-col justify-between';
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-emerald-100 text-excel-800">${item.typeBadge}</span>
              <span class="text-[11px] font-semibold text-emerald-700 bg-white px-2 py-0.5 rounded border border-emerald-200">✓ ${item.updated}</span>
            </div>
            <h3 class="font-extrabold text-sm sm:text-base text-slate-900 leading-snug">${item.title}</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">${item.desc}</p>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-200/80 space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-[11px] text-slate-400 block">Sabit Tek Fiyat</span>
                <span class="text-lg font-extrabold text-slate-900">${formatTL(item.price)}</span>
              </div>
              <div class="text-right">
                <span class="inline-block px-2 py-0.5 rounded bg-amber-100 text-amber-900 text-[11px] font-extrabold">VIP Pakette ÜCRETSİZ</span>
                <span class="text-[11px] text-slate-500 block mt-0.5">⬇ ${item.downloads} İndirme</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <button type="button" data-preview-sim="${item.simKey}" class="preview-template-btn py-2 px-3 rounded-xl text-xs font-bold text-slate-700 bg-white hover:bg-slate-100 border border-slate-300 transition">
                🔍 Canlı Önizle
              </button>
              <button type="button" data-add-id="${item.id}" class="add-template-btn py-2 px-3 rounded-xl text-xs font-bold text-white bg-excel-600 hover:bg-excel-700 transition">
                Sepete Ekle
              </button>
            </div>
          </div>
        `;
        grid.appendChild(card);
      });

      // Önizle butonları
      grid.querySelectorAll('.preview-template-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const simKey = btn.getAttribute('data-preview-sim');
          switchSimulatorTab(simKey);
          document.getElementById('canli-onizleme').scrollIntoView({ behavior: 'smooth' });
          showToast('Şablon canlı simülatöre yüklendi!');
        });
      });

      // Sepete ekle butonları
      grid.querySelectorAll('.add-template-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-add-id');
          const found = templates.find(t => t.id === id);
          if (found) {
            addToCart({ id: found.id, title: found.title + ' (Tekil Uygulama)', price: found.price });
          }
        });
      });
    }

    function switchSimulatorTab(simKey) {
      activeSimKey = simKey;
      document.querySelectorAll('.sim-tab-btn').forEach(b => {
        if (b.getAttribute('data-sim') === simKey) {
          b.className = 'sim-tab-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-excel-600 text-white shadow-sm transition';
        } else {
          b.className = 'sim-tab-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition';
        }
      });
      renderSimulator();
    }

    // --- 6. SEPET & CHECKOUT YÖNETİMİ ---
    function addToCart(newItem) {
      const exists = cart.some(c => c.id === newItem.id);
      if (!exists) {
        cart.push(newItem);
      }
      updateCartUI();
      openCheckoutModal();
      showToast(`"${newItem.title}" sepete eklendi.`);
    }

    function removeFromCart(id) {
      cart = cart.filter(c => c.id !== id);
      updateCartUI();
    }

    function updateCartUI() {
      const badge = document.getElementById('cartCountBadge');
      badge.textContent = cart.length;

      const container = document.getElementById('cartItemsContainer');
      container.innerHTML = '';

      if (cart.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-500 py-3 text-center">Sepetinizde henüz ürün yok. VIP Tam Arşiv Paketi (Tek Fiyat: 2.000 ₺) ile tüm dosyalara erişebilirsiniz.</p>`;
      } else {
        cart.forEach(item => {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs';
          row.innerHTML = `
            <div>
              <p class="font-bold text-slate-900">${item.title}</p>
              <p class="text-[11px] text-emerald-700 font-medium">Anında İndirme + Ömür Boyu Lisans</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-extrabold text-sm text-slate-900">${formatTL(item.price)}</span>
              <button type="button" data-remove-id="${item.id}" class="remove-cart-btn text-slate-400 hover:text-rose-600 font-bold text-base">&times;</button>
            </div>
          `;
          container.appendChild(row);
        });
      }

      container.querySelectorAll('.remove-cart-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          removeFromCart(btn.getAttribute('data-remove-id'));
        });
      });

      const total = cart.reduce((sum, i) => sum + i.price, 0);
      document.getElementById('checkoutTotalAmount').textContent = formatTL(total);

      // Eğer sepette tekil 500 TL'lik ürün varsa VIP upsell göster
      const hasSingleApp = cart.some(i => i.id !== "vip-paket" && !String(i.id).startsWith("plan-"));
      const upsellBanner = document.getElementById('vipUpsellBanner');
      if (hasSingleApp) {
        upsellBanner.classList.remove('hidden');
      } else {
        upsellBanner.classList.add('hidden');
      }
    }

    function openCheckoutModal() {
      updateCartUI();
      document.getElementById('checkoutModal').classList.remove('hidden');
    }

    // --- 7. EVENT LISTENERS ---
    window.addEventListener('DOMContentLoaded', () => {
      renderSimulator();
      renderTemplates();
      updateCartUI();

      // Mobil Menü
      document.getElementById('mobileMenuBtn').addEventListener('click', () => {
        document.getElementById('mobileMenuPanel').classList.toggle('hidden');
      });

      // ROI Hesaplayıcı Slider
      const roiSlider = document.getElementById('roiSlider');
      roiSlider.addEventListener('input', (e) => {
        const weeklyHours = parseInt(e.target.value, 10);
        const yearlySavedHours = Math.round(weeklyHours * 52 * 0.8);
        const yearlyMoney = yearlySavedHours * 250;
        document.getElementById('roiHoursLabel').textContent = `Haftada ${weeklyHours} Saat Excel İşi`;
        document.getElementById('roiSavedHours').textContent = `${yearlySavedHours} Saat / Yıl`;
        document.getElementById('roiSavedMoney').textContent = formatTL(yearlyMoney) + ' / Yıl';
      });

      // Hero Arama
      const heroInput = document.getElementById('heroSearchInput');
      document.getElementById('heroSearchBtn').addEventListener('click', () => {
        searchQuery = heroInput.value;
        renderTemplates();
        document.getElementById('sablonlar').scrollIntoView({ behavior: 'smooth' });
      });
      heroInput.addEventListener('keyup', (e) => {
        searchQuery = e.target.value;
        renderTemplates();
        if (e.key === 'Enter') {
          document.getElementById('sablonlar').scrollIntoView({ behavior: 'smooth' });
        }
      });

      // Hızlı Popüler Arama Etiketleri
      document.querySelectorAll('.quick-search-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const cat = tag.getAttribute('data-quick-filter');
          activeCategory = cat;
          searchQuery = '';
          heroInput.value = '';
          updateCategoryButtons();
          renderTemplates();
          document.getElementById('sablonlar').scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Simülatör Sekmeleri
      document.querySelectorAll('.sim-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          switchSimulatorTab(btn.getAttribute('data-sim'));
        });
      });

      // Simülatör Verileri Sıfırla
      document.getElementById('simResetDataBtn').addEventListener('click', () => {
        simState = JSON.parse(JSON.stringify(simulatorConfigs));
        renderSimulator();
        showToast('Tablo varsayılan değerlerine sıfırlandı.');
      });

      // Simülatörden Sepete Ekle
      document.getElementById('simAddToCartBtn').addEventListener('click', () => {
        const cfg = simState[activeSimKey];
        addToCart({
          id: 'sim-' + activeSimKey,
          title: cfg.fileName.split('—')[0].trim(),
          price: 2000
        });
      });

      // Kategori Filtre Butonları
      function updateCategoryButtons() {
        document.querySelectorAll('.cat-btn').forEach(b => {
          if (b.getAttribute('data-cat') === activeCategory) {
            b.className = 'cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 text-white transition';
          } else {
            b.className = 'cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
          }
        });
      }

      document.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeCategory = btn.getAttribute('data-cat');
          updateCategoryButtons();
          renderTemplates();
        });
      });

      // Sıralama
      document.getElementById('sortSelect').addEventListener('change', (e) => {
        activeSort = e.target.value;
        renderTemplates();
      });

      // Paket Seçim Butonları
      document.querySelectorAll('.select-plan-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const planTitle = btn.getAttribute('data-plan');
          const planPrice = parseInt(btn.getAttribute('data-price'), 10);
          cart = [{ id: 'plan-' + planPrice, title: planTitle, price: planPrice }];
          openCheckoutModal();
        });
      });

      // Sepet Aç/Kapat
      document.getElementById('openCartBtn').addEventListener('click', openCheckoutModal);
      document.getElementById('closeCheckoutModalBtn').addEventListener('click', () => {
        document.getElementById('checkoutModal').classList.add('hidden');
      });

      // Tekil Üründen VIP Pakete Tek Tıkla Geçiş (Upsell)
      document.getElementById('switchToVipBtn').addEventListener('click', () => {
        cart = [{ id: 'vip-paket', title: 'VIP Tam Arşiv (2.750+ Şablon) + 152 Saat Eğitim Seti', price: 2000 }];
        updateCartUI();
        showToast('Harika seçim! Sepetiniz VIP Tam Arşiv Paketi (Tek Fiyat: 2.000 ₺) olarak güncellendi.');
      });

      // Ödeme Sekmeleri (Kart vs EFT)
      const payTabCard = document.getElementById('payTabCard');
      const payTabEft = document.getElementById('payTabEft');
      const cardPanel = document.getElementById('cardPaymentPanel');
      const eftPanel = document.getElementById('eftPaymentPanel');

      payTabCard.addEventListener('click', () => {
        payTabCard.className = 'py-2 rounded-lg bg-white text-slate-900 shadow-sm';
        payTabEft.className = 'py-2 rounded-lg text-slate-600 hover:text-slate-900';
        cardPanel.classList.remove('hidden');
        eftPanel.classList.add('hidden');
      });

      payTabEft.addEventListener('click', () => {
        payTabEft.className = 'py-2 rounded-lg bg-white text-slate-900 shadow-sm';
        payTabCard.className = 'py-2 rounded-lg text-slate-600 hover:text-slate-900';
        eftPanel.classList.remove('hidden');
        cardPanel.classList.add('hidden');
      });

      // Kurumsal Fatura Alanı Toggle
      document.getElementById('corporateInvoiceToggle').addEventListener('change', (e) => {
        document.getElementById('corporateInvoiceFields').classList.toggle('hidden', !e.target.checked);
      });

      // Siparişi Tamamla
      document.getElementById('completeOrderBtn').addEventListener('click', () => {
        if (cart.length === 0) {
          showToast('Lütfen önce bir paket veya şablon seçin.');
          return;
        }
        document.getElementById('checkoutModal').classList.add('hidden');
        showToast('Ödeme onaylandı! Tüm arşiv indirme bağlantılarınız ve e-Faturanız hazırlandı.');
      });

      // Ücretsiz Numune Modal
      const freeModal = document.getElementById('freeSampleModal');
      document.getElementById('freeSampleTopBtn').addEventListener('click', () => freeModal.classList.remove('hidden'));
      document.getElementById('freeSampleMobileBtn').addEventListener('click', () => freeModal.classList.remove('hidden'));
      document.getElementById('closeFreeSampleModalBtn').addEventListener('click', () => freeModal.classList.add('hidden'));

      document.getElementById('downloadSampleNowBtn').addEventListener('click', () => {
        const csvContent = "Donem;Gelir_TL;Gider_TL;Net_Bakiye_TL\nOcak 2026;480000;320000;160000\nSubat 2026;530000;390000;140000\nMart 2026;610000;410000;200000";
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ExcelArsiv_2026_Ornek_Nakit_Akisi_Sablonu.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        freeModal.classList.add('hidden');
        showToast('Ücretsiz örnek şablon bilgisayarınıza indirildi!');
      });

      // Kurumsal B2B Teklif Formu
      document.getElementById('b2bQuoteForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const company = document.getElementById('b2bCompany').value;
        e.target.reset();
        showToast(`Teşekkürler! ${company} için kurumsal teklif talebiniz Murat Osma ekibine iletildi.`);
      });

      // SSS Akordeon
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const content = btn.nextElementSibling;
          const icon = btn.querySelector('.faq-icon');
          const isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden', !isHidden);
          icon.textContent = isHidden ? '−' : '+';
        });
      });

      // WhatsApp Widget
      const waPopup = document.getElementById('waChatPopup');
      document.getElementById('toggleWaPopupBtn').addEventListener('click', () => {
        waPopup.classList.toggle('hidden');
      });
      document.getElementById('closeWaPopupBtn').addEventListener('click', () => {
        waPopup.classList.add('hidden');
      });
      document.getElementById('sendWaMsgBtn').addEventListener('click', () => {
        const msg = document.getElementById('waQuickInput').value.trim() || 'Merhaba, Excel Arşivi paketleri hakkında bilgi almak istiyorum.';
        waPopup.classList.add('hidden');
        showToast(`Mesajınız iletildi: "${msg}" — Uzman ekibimiz yanıtlıyor.`);
      });
    });
  </script>
</body>
</html>
