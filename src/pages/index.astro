---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import { getAllTemplates, getTemplateSearchIndex } from '../lib/templates';
import { kararPages } from '../data/kararPages';

const templates = await getAllTemplates();
const searchIndex = await getTemplateSearchIndex();
const productCount = templates.length;
const categoryCount = new Set(templates.map((item) => item.categorySlug)).size;
const minPrice = Math.min(...templates.map((item) => item.priceTL));
const priceLevels = [...new Set(templates.map((item) => item.priceTL))].sort((a, b) => a - b);

// 1. POPÜLER ŞABLONLAR (Someka Popular Templates)
const popularSlugs = [
  '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi',
  'aylik-patron-finans-paneli',
  'banka-kredi-ve-taksit-takip-sistemi',
  'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi',
  'sube-karlilik-ve-nakit-hesaplayici',
  'stok-satis-ve-nakit-baglanma-sistemi',
  'pos-komisyon-ve-net-tahsilat-kontrol-sistemi',
  'akilli-kasa-defteri-ve-nakit-kontrol-sistemi',
];
const popularTemplates = popularSlugs.map((s) => templates.find((t) => t.slug === s)).filter(Boolean);

// 2. YENİ ÇIKANLAR (Someka New Releases)
const newSlugs = [
  'uretim-recetesi-ve-zam-yansitma-hesaplayici',
  'doviz-acik-pozisyonu-ve-kur-riski-stres-testi',
  'ithalat-depo-teslim-rafa-gelen-net-birim-maliyet',
  'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici',
];
const newTemplates = newSlugs.map((s) => templates.find((t) => t.slug === s)).filter(Boolean);

// 3. KATEGORİLERE GÖRE SEKME LİSTELERİ (Someka Tabbed Product Filter)
const nakitList = templates.filter((t) => t.categorySlug === 'nakit-akisi').slice(0, 4);
const finansList = templates.filter((t) => t.categorySlug === 'finansal-analiz').slice(0, 4);
const muhasebeList = templates.filter((t) => t.categorySlug === 'muhasebe-ve-vergi').slice(0, 4);
const butceList = templates.filter((t) => t.categorySlug === 'butce-ve-planlama').slice(0, 4);
const satisList = templates.filter((t) => t.categorySlug === 'satis-ve-fiyatlama').slice(0, 4);
const paketList = templates.filter((t) => t.slug.includes('paket') || t.slug.includes('kobi-finans') || t.priceTL >= 1499).slice(0, 4);
const sortedTemplates = [...templates].sort((a, b) => a.name.localeCompare(b.name, 'tr'));

// 4. KARAR REHBERLERİ
const homeDecisionSlugs = [
  'kobi-nakit-akisi-excel',
  'mali-musavir-cari-takip-excel',
  'pos-komisyon-kontrol-excel',
  'trendyol-pazaryeri-net-kar-excel',
];
const homeDecisions = homeDecisionSlugs.map((slug) => kararPages.find((item) => item.slug === slug)).filter(Boolean);

const faqItems = [
  { q: 'Teklif almadan önce dosyayı inceleyebilir miyim?', a: 'Uygun ürünlerde ücretsiz demo ve gerçek ürün ekranları bulunur. Ürün detay sayfasından kapsamı ve demo bağlantısını teklif almadan önce kontrol edebilirsiniz.' },
  { q: 'Fiyatlandırma ve teklif süreci nasıl işliyor?', a: 'Her işletmenin veri boyutu ve uyarlama ihtiyacı farklı olduğu için WhatsApp üzerinden hızlıca ihtiyacınızı dinleyip en uygun teklifi sunuyoruz.' },
  { q: 'Teklif ve kurulum süreci nasıl işliyor?', a: 'WhatsApp üzerinden doğrudan uzmanımızla görüşüp şirketinize özel teklif ve kurulum desteği alabilirsiniz.' },
  { q: 'Hangi sistemi seçmem gerektiğini bilmiyorsam ne yapmalıyım?', a: 'Karar rehberlerinden işletme probleminize en yakın soruyu seçebilir veya ürün bulucuyu kullanabilirsiniz.' },
  { q: 'Excel Arşiv bir ERP veya muhasebe programı mı?', a: 'Hayır. Ürünler belirli finans, muhasebe ve operasyon karar problemlerine odaklanan indirilebilir Excel çalışma sistemleridir.' },
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://excelarsiv.com/#website', name: 'Excel Arşiv', url: 'https://excelarsiv.com/', inLanguage: 'tr-TR' },
    { '@type': 'FAQPage', '@id': 'https://excelarsiv.com/#faq', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
    {
      '@type': 'ItemList',
      '@id': 'https://excelarsiv.com/#catalog',
      name: 'Öne Çıkan Hazır Excel Şablonları ve Karar Sistemleri',
      numberOfItems: popularTemplates.length,
      itemListElement: popularTemplates.map((item, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.name,
        url: `https://excelarsiv.com${item.url}`,
      })),
    },
  ],
};
---

<CommerceLayout
  title="İşletmeler İçin Hazır Excel Karar Sistemleri | Excel Arşiv"
  description="Nakit akışı, kredi, maliyet, kârlılık ve muhasebe süreçleri için hazır Excel karar sistemleri. Gerçek ekranları ve demoları görün; ihtiyacınıza uygun sistemi seçin."
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} /></Fragment>

  <div class="home-v2 someka-layout-root">
    <!-- HERO BÖLÜMÜ (Kullanıcı Talimatı: Kesinlikle Birebir Korunuyor) -->
    <HeroSection searchIndex={searchIndex} />

    <!-- SOMEKA GÜVEN VE REFERANSLAR BANDI (soho-reviews-row) -->
    <div class="soho-reviews-bar">
      <div class="home-shell soho-reviews-inner">
        <div class="soho-trustpilot-box">
          <span class="soho-tp-score">4.9</span>
          <div class="soho-tp-stars" aria-label="5 üzerinden 4.9 puan">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div class="soho-tp-text">
            <strong>500+ Doğrulanmış İşletme &amp; CFO</strong>
            <small>17 Yıllık Ticari Bankacılık Metodolojisi</small>
          </div>
        </div>
        <div class="soho-companies-strip">
          <span class="soho-company-badge">Üretim &amp; Sanayi</span>
          <span class="soho-company-badge">Perakende &amp; Mağaza</span>
          <span class="soho-company-badge">E-Ticaret &amp; Pazaryeri</span>
          <span class="soho-company-badge">İnşaat &amp; Taahhüt</span>
          <span class="soho-company-badge">Lojistik &amp; Filo</span>
          <span class="soho-company-badge">Mali Müşavir &amp; YMM</span>
        </div>
      </div>
    </div>

    <!-- 1. POPÜLER ŞABLONLAR BÖLÜMÜ (Someka Popular Templates) -->
    <section class="catalog-proof" data-experience-stage>
      <div class="home-shell">
        <div class="soho-category-headband">
          <h2 class="soho-category-title">
            <a href="/sablonlar">
              <span class="soho-title-icon">🏷️</span> EN ÇOK TERCİH EDİLEN ŞABLONLAR
            </a>
          </h2>
          <div class="soho-category-more"><a href="/sablonlar">Tümünü İncele ›</a></div>
        </div>
        <p class="soho-category-desc">İşletmeler tarafından en çok talep edilen Excel ve finansal karar sistemleri. Hem Windows hem Mac ile %100 uyumlu, makro riski olmadan hemen kullanıma hazır.</p>

        <div class="soho-product-grid">
          {popularTemplates.map((item) => item && (
            <div class="soho-card-col">
              <article class="someka-product-custom-card">
                <a class="someka-card-thumb-wrap" href={item.url} aria-label={item.name}>
                  <img class="someka-thumb-img premium-card__shot" src={item.kapak} alt={item.name} width="727" height="373" loading="lazy" />
                  <span class="someka-category-tag">{item.categoryName}</span>
                </a>
                <div class="someka-card-details">
                  <h3 class="single-post-title"><a href={item.url}>{item.name}</a></h3>
                  <div class="vcex-star-rating" aria-label="5 yıldız">
                    <span class="star-active">★</span>
                    <span class="star-active">★</span>
                    <span class="star-active">★</span>
                    <span class="star-active">★</span>
                    <span class="star-active">★</span>
                  </div>
                  <p class="vcex-post-excerpt">{item.summary}</p>
                  
                  <div class="someka-card-bottom">
                    <a href={item.shopierUrl} target="_blank" rel="noopener noreferrer" class="btn-someka-teklif">Teklif Ver</a>
                    <a href={item.url} class="btn-someka-view">Detay</a>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>

        <!-- 2. KATEGORİ FİLTRELEME SEKMELERİ (Someka Tabbed Category Products) -->
        <div class="soho-filter-section" id="kategoriler" x-data="{ tab: 'nakit' }">
          <!-- Someka Divider & Ortalanmış Başlık (media_1790066707581.png Referansı) -->
          <div class="someka-section-divider">
            <div class="someka-divider-line"></div>
            <h2 class="someka-divider-title">DİĞER KATEGORİLER</h2>
            <div class="someka-divider-line"></div>
          </div>

          <!-- Someka Sekme Butonları -->
          <div class="soho-tabs-nav" role="tablist">
            <button type="button" class="soho-tab-btn" :class="{ 'is-active': tab === 'nakit' }" @click="tab = 'nakit'">Nakit Akışı</button>
            <button type="button" class="soho-tab-btn" :class="{ 'is-active': tab === 'finans' }" @click="tab = 'finans'">Finansal Analiz</button>
            <button type="button" class="soho-tab-btn" :class="{ 'is-active': tab === 'muhasebe' }" @click="tab = 'muhasebe'">Muhasebe &amp; Vergi</button>
            <button type="button" class="soho-tab-btn" :class="{ 'is-active': tab === 'butce' }" @click="tab = 'butce'">Bütçe &amp; Maliyet</button>
            <button type="button" class="soho-tab-btn" :class="{ 'is-active': tab === 'index' }" @click="tab = 'index'">İndex Liste</button>
            <a href="/sablonlar" class="soho-tab-btn soho-tab-link">Tüm Kategoriler ›</a>
          </div>

          <!-- Sekme 1: Nakit Akışı -->
          <div class="soho-tab-panel" x-show="tab === 'nakit'">
            <div class="soho-product-grid">
              {nakitList.map((item) => (
                <div class="soho-card-col">
                  <article class="someka-product-custom-card">
                    <a class="someka-card-thumb-wrap" href={item.url} aria-label={item.name}>
                      <img class="someka-thumb-img premium-card__shot" src={item.kapak} alt={item.name} width="727" height="373" loading="lazy" />
                      <span class="someka-category-tag">{item.categoryName}</span>
                    </a>
                    <div class="someka-card-details">
                      <h3 class="single-post-title"><a href={item.url}>{item.name}</a></h3>
                      <div class="vcex-star-rating">
                        <span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span>
                      </div>
                      <p class="vcex-post-excerpt">{item.summary}</p>
                      <div class="someka-card-bottom">
                        <a href={item.shopierUrl} target="_blank" rel="noopener noreferrer" class="btn-someka-teklif">Teklif Ver</a>
                        <a href={item.url} class="btn-someka-view">Detay</a>
                      </div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>

          <!-- Sekme 2: Finansal Analiz -->
          <div class="soho-tab-panel" x-show="tab === 'finans'" style="display:none;">
            <div class="soho-product-grid">
              {finansList.map((item) => (
                <div class="soho-card-col">
                  <article class="someka-product-custom-card">
                    <a class="someka-card-thumb-wrap" href={item.url} aria-label={item.name}>
                      <img class="someka-thumb-img premium-card__shot" src={item.kapak} alt={item.name} width="727" height="373" loading="lazy" />
                      <span class="someka-category-tag">{item.categoryName}</span>
                    </a>
                    <div class="someka-card-details">
                      <h3 class="single-post-title"><a href={item.url}>{item.name}</a></h3>
                      <div class="vcex-star-rating">
                        <span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span>
                      </div>
                      <p class="vcex-post-excerpt">{item.summary}</p>
                      <div class="someka-card-bottom">
                        <a href={item.shopierUrl} target="_blank" rel="noopener noreferrer" class="btn-someka-teklif">Teklif Ver</a>
                        <a href={item.url} class="btn-someka-view">Detay</a>
                      </div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>

          <!-- Sekme 3: Muhasebe & Vergi -->
          <div class="soho-tab-panel" x-show="tab === 'muhasebe'" style="display:none;">
            <div class="soho-product-grid">
              {muhasebeList.map((item) => (
                <div class="soho-card-col">
                  <article class="someka-product-custom-card">
                    <a class="someka-card-thumb-wrap" href={item.url} aria-label={item.name}>
                      <img class="someka-thumb-img premium-card__shot" src={item.kapak} alt={item.name} width="727" height="373" loading="lazy" />
                      <span class="someka-category-tag">{item.categoryName}</span>
                    </a>
                    <div class="someka-card-details">
                      <h3 class="single-post-title"><a href={item.url}>{item.name}</a></h3>
                      <div class="vcex-star-rating">
                        <span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span>
                      </div>
                      <p class="vcex-post-excerpt">{item.summary}</p>
                      <div class="someka-card-bottom">
                        <a href={item.shopierUrl} target="_blank" rel="noopener noreferrer" class="btn-someka-teklif">Teklif Ver</a>
                        <a href={item.url} class="btn-someka-view">Detay</a>
                      </div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>

          <!-- Sekme 4: Bütçe & Maliyet -->
          <div class="soho-tab-panel" x-show="tab === 'butce'" style="display:none;">
            <div class="soho-product-grid">
              {butceList.map((item) => (
                <div class="soho-card-col">
                  <article class="someka-product-custom-card">
                    <a class="someka-card-thumb-wrap" href={item.url} aria-label={item.name}>
                      <img class="someka-thumb-img premium-card__shot" src={item.kapak} alt={item.name} width="727" height="373" loading="lazy" />
                      <span class="someka-category-tag">{item.categoryName}</span>
                    </a>
                    <div class="someka-card-details">
                      <h3 class="single-post-title"><a href={item.url}>{item.name}</a></h3>
                      <div class="vcex-star-rating">
                        <span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span>
                      </div>
                      <p class="vcex-post-excerpt">{item.summary}</p>
                      <div class="someka-card-bottom">
                        <a href={item.shopierUrl} target="_blank" rel="noopener noreferrer" class="btn-someka-teklif">Teklif Ver</a>
                        <a href={item.url} class="btn-someka-view">Detay</a>
                      </div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>

          <!-- Sekme 5: İndex Liste (Tüm Ürünler 4 Kolonda) -->
          <div class="soho-tab-panel" x-show="tab === 'index'" style="display:none;">
            <div class="soho-index-box">
              <div class="soho-index-header">
                <div class="soho-index-title-row">
                  <span class="soho-index-tag">SİSTEM DİZİNİ</span>
                  <span class="soho-index-count">{sortedTemplates.length} Hazır Karar Sistemi</span>
                </div>
                <p class="soho-index-intro">Excel Arşiv bünyesindeki tüm finans, muhasebe, maliyet, vergi ve yönetim modellerine doğrudan erişin.</p>
              </div>
              <div class="soho-index-grid">
                {sortedTemplates.map((item) => (
                  <a href={item.url} class="soho-index-item" title={item.name}>
                    <span class="soho-index-chevron">›</span>
                    <span class="soho-index-name">{item.name}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 3. YENİ ÇIKAN VE GÜNCELLENEN ŞABLONLAR (Someka New Releases) -->
        <div class="soho-category-headband" style="margin-top: 54px;">
          <h2 class="soho-category-title">
            <a href="/sablonlar?orderby=date">
              <span class="soho-title-icon">🚀</span> YENİ ÇIKAN KARAR SİSTEMLERİ
            </a>
          </h2>
          <div class="soho-category-more"><a href="/sablonlar?orderby=date">Tümünü İncele ›</a></div>
        </div>
        <p class="soho-category-desc">En son yayına alınan karar sistemlerimiz. Sürekli yeni finans ve yönetim modelleri ekliyoruz; en güncel çözümleri hemen keşfedin.</p>

        <div class="soho-product-grid">
          {newTemplates.map((item) => (
            <div class="soho-card-col">
              <article class="someka-product-custom-card">
                <a class="someka-card-thumb-wrap" href={item.url} aria-label={item.name}>
                  <img class="someka-thumb-img premium-card__shot" src={item.kapak} alt={item.name} width="727" height="373" loading="lazy" />
                  <span class="someka-category-tag someka-tag--new">Yeni</span>
                </a>
                <div class="someka-card-details">
                  <h3 class="single-post-title"><a href={item.url}>{item.name}</a></h3>
                  <div class="vcex-star-rating" aria-label="5 yıldız">
                    <span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span><span class="star-active">★</span>
                  </div>
                  <p class="vcex-post-excerpt">{item.summary}</p>
                  <div class="someka-card-bottom">
                    <a href={item.shopierUrl} target="_blank" rel="noopener noreferrer" class="btn-someka-teklif">Teklif Ver</a>
                    <a href={item.url} class="btn-someka-view">Detay</a>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. ALTYAPI VE GÜVENLİK STANDARTLARI (Someka Features Grid 6'lı Kutu) -->
    <section class="difference" data-experience-stage>
      <div class="home-shell difference-shell">
        <div class="soho-category-headband" style="margin-bottom: 6px;">
          <h2 class="soho-category-title">
            <span>⚙️</span> NEDEN EXCEL ARŞİV?
          </h2>
        </div>
        <p class="soho-category-desc">Aylık yazılım ücreti veya karmaşık kurulumlar yok. Finansçılar, mali müşavirler ve şirket yöneticileri için sıfır makro riskiyle tasarlanmış kurumsal karar altyapısı.</p>
        
        <div class="soho-features-grid">
          <div class="soho-feature-box">
            <span class="soho-feat-icon">🛡️</span>
            <div class="soho-feat-content">
              <strong>Sıfır Makro &amp; Güvenlik</strong>
              <p>Virüs veya trojan riski taşıyan VBA kodu içermez; saf .xlsx formatında kurumsal IT onaylı çalışır.</p>
            </div>
          </div>
          <div class="soho-feature-box">
            <span class="soho-feat-icon">🔓</span>
            <div class="soho-feat-content">
              <strong>%100 Açık Formül Şeffaflığı</strong>
              <p>Gizli veya şifreli hücre yoktur; tüm formül zinciri açık, incelenebilir ve işletmenize göre uyarlanabilir.</p>
            </div>
          </div>
          <div class="soho-feature-box">
            <span class="soho-feat-icon">💻</span>
            <div class="soho-feat-content">
              <strong>Tüm Cihazlarla Tam Uyum</strong>
              <p>Windows Excel, Mac Excel, iPad ve Microsoft 365 ile tam uyum; harici eklenti veya kurulum gerekmez.</p>
            </div>
          </div>
          <div class="soho-feature-box">
            <span class="soho-feat-icon">♾️</span>
            <div class="soho-feat-content">
              <strong>Aylık Lisans / Abonelik Yok</strong>
              <p>Abonelik dayatması yok. Teklifinizi alın, ömür boyu sınırsız kullanın. Yenileme maliyeti sıfırdır.</p>
            </div>
          </div>
          <div class="soho-feature-box">
            <span class="soho-feat-icon">⚡</span>
            <div class="soho-feat-content">
              <strong>10 Saniyede Teslimat</strong>
              <p>WhatsApp hattımız üzerinden hızlıca teklif alın; sisteminiz anında ve size özel teslim edilsin.</p>
            </div>
          </div>
          <div class="soho-feature-box">
            <span class="soho-feat-icon">🏛️</span>
            <div class="soho-feat-content">
              <strong>17 Yıllık Bankacılık Güvencesi</strong>
              <p>Ticari bankacılık ve saha finans deneyimiyle, gerçek şirket verileriyle test edilmiş karar modelleri.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. SİZE ÖZEL EXCEL SİSTEMLERİ (Someka Custom Jobs) -->
    <section class="custom-build" data-experience-stage>
      <div class="home-shell custom-build-grid">
        <div class="custom-build-copy">
          <div class="soho-category-headband" style="margin-bottom: 8px;">
            <h2 class="soho-category-title">
              <span>🛠️</span> ÖZEL SİSTEM GELİŞTİRME
            </h2>
          </div>
          <h3 class="someka-custom-lead-title">İşletmenize Özel Excel Karar Motoru mu Gerekiyor?</h3>
          <p class="custom-lead">Hazır şablonlar işinizi karşılamıyorsa; dağınık ticari süreçlerinizi, banka limitlerinizi ve maliyet akışınızı 90 dakikalık teşhisle tek ekranda yönetilebilir bir karar sistemine dönüştürüyoruz.</p>
          <div class="custom-trust-chips">
            <span>✓ 17 Yıllık Finans Tecrübesi</span>
