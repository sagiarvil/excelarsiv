<button class="quick-search-tag px-2 py-0.5 rounded-md bg-slate-100 hover:bg-emerald-50 hover:text-excel-700 transition" data-quick-filter="Satış" type="button">Satış Kanban CRM</button>
<button class="quick-search-tag px-2 py-0.5 rounded-md bg-slate-100 hover:bg-emerald-50 hover:text-excel-700 transition" data-quick-filter="Makro" type="button">Toplu PDF &amp; Mail VBA</button>
</div>
</div>
<!-- 4 Net Güven Sözü -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
<div class="bg-white/90 p-3 rounded-xl border border-slate-200/80 flex items-start gap-2.5">
<div class="w-7 h-7 rounded-lg bg-emerald-100 text-excel-700 flex items-center justify-center shrink-0 font-bold text-sm">✓</div>
