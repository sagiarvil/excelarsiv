        <li class="flex items-center gap-2"><span class="text-excel-600 font-bold">✓</span> <span>2026 Gelir-Gider ve Kasa Takip Tablosu.xlsx</span></li>
        <li class="flex items-center gap-2"><span class="text-excel-600 font-bold">✓</span> <span>Personel Yıllık İzin Çizelgesi.xlsx</span></li>
        <li class="flex items-center gap-2"><span class="text-excel-600 font-bold">✓</span> <span>Aylık Karşılaştırmalı Mini Dashboard.xlsx</span></li>
      </ul>
      <button class="min-h-[44px] w-full py-3 rounded-xl bg-excel-600 hover:bg-excel-700 text-white font-bold text-xs sm:text-sm transition flex items-center justify-center" id="downloadSampleNowBtn" type="button">
        Ücretsiz Numune Paketini Hemen İndir (.CSV / .XLSX Önizleme)
      </button>
    </div>
  </div>

  <!-- TOAST BİLDİRİMİ -->
  <div class="hidden fixed top-20 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl border border-emerald-500/40 text-xs font-semibold flex items-center gap-2.5 max-w-sm" id="toastBanner" role="status" aria-live="polite">
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
    <span id="toastMessage">İşlem başarıyla tamamlandı!</span>
  </div>

  <!-- AYRIK, MODÜLER VE SAĞLAM CLIENT SCRIPT (npm chart.js paketli, tam hata toleranslı) -->
  <script>
    import { Chart, registerables } from 'chart.js';
    Chart.register(...registerables);

    // Tekrarlı başlatma koruması (Idempotency)
    declare global {
      interface Window {
        __homeAppInitialized?: boolean;
        __toastTimer?: any;
      }
    }

    if (!window.__homeAppInitialized) {
      window.__homeAppInitialized = true;

      // --- SİMÜLATÖR YAPILANDIRMASI ---
      interface SimRow {
        label: string;
        inVal: number;
        outVal: number;
      }
      interface SimConfig {
        fileName: string;
        formula: string;
        tableTitle: string;
        headers: [string, string, string, string];
        kpiLabels: [string, string, string];
        unit: string;
        rows: SimRow[];
      }

      const defaultSimulatorConfigs: Record<string, SimConfig> = {
        nakit: {
          fileName: 'Nakit_Akisi_ve_Likidite_Yonetimi_2026.xlsm — Açık Kaynak (Şifresiz)',
          formula: '=ETOPLA(Hareketler!C:C; "Tahsilat"; Hareketler!F:F) - ETOPLA(Hareketler!C:C; "Ödeme"; Hareketler!F:F)',
          tableTitle: 'Aylık Kasa & Banka Nakit Akış Tablosu (Rakamları Değiştirip Test Edin)',
          headers: ['Dönem / Ay', 'Nakit Girişi (₺)', 'Nakit Çıkışı (₺)', 'Net Nakit Akışı'],
          kpiLabels: ['Toplam Tahsilat Girişi', 'Toplam Ödeme Çıkışı', 'Net Kasa Likiditesi'],
          unit: '₺',
          rows: [
            { label: 'Ocak 2026', inVal: 480000, outVal: 320000 },
            { label: 'Şubat 2026', inVal: 530000, outVal: 390000 },
            { label: 'Mart 2026', inVal: 610000, outVal: 410000 },
            { label: 'Nisan 2026', inVal: 720000, outVal: 460000 }
          ]
        },
        satis: {
          fileName: 'Satis_Pipeline_Kanban_ve_Hedef_Dashboard_2026.xlsx',
          formula: '=EĞERHATA(D4/C4; 0) * 100 // Hedef Gerçekleşme ve Pipeline Dönüşüm Oranı',
          tableTitle: 'Bölge & Temsilci Satış Pipeline Tablosu (Rakamları Değiştirip Test Edin)',
          headers: ['Satış Kanalı / Ekip', 'Aylık Hedef (₺)', 'Maliyet / İskonto (₺)', 'Net Ciro Katkısı'],
          kpiLabels: ['Toplam Pipeline Hedefi', 'Toplam İskonto/Maliyet', 'Net Gerçekleşen Ciro'],
          unit: '₺',
          rows: [
            { label: 'Kurumsal B2B Satış', inVal: 850000, outVal: 95000 },
            { label: 'E-Ticaret & Pazaryeri', inVal: 640000, outVal: 110000 },
            { label: 'Bayi & Kanal Satış', inVal: 520000, outVal: 70000 },
            { label: 'İhracat / Yurt Dışı', inVal: 910000, outVal: 130000 }
          ]
        },
        ik: {
          fileName: 'Personel_Izin_Hakedis_ve_Fazla_Mesai_Puantaj_2026.xlsx',
          formula: '=EĞER(KIDEM_YILI>=15; 26; EĞER(KIDEM_YILI>=5; 20; 14)) - KULLANILAN_IZIN',
          tableTitle: 'Departman Fazla Mesai & İzin Maliyet Simülasyonu',
          headers: ['Departman', 'Normal Mesai Bütçesi (₺)', 'Fazla Mesai & İzin Yükü (₺)', 'Net Verimlilik Farkı'],
          kpiLabels: ['Toplam Bordro Bütçesi', 'Fazla Mesai Maliyeti', 'Net Bütçe Dengesi'],
          unit: '₺',
          rows: [
            { label: 'Üretim & Operasyon', inVal: 420000, outVal: 68000 },
            { label: 'Lojistik & Depo', inVal: 290000, outVal: 44000 },
            { label: 'Satış & Saha Ekibi', inVal: 350000, outVal: 32000 },
            { label: 'Finans & İdari İşler', inVal: 240000, outVal: 15000 }
          ]
        }
      };

      let activeSimKey = 'nakit';
      let simState: Record<string, SimConfig> = JSON.parse(JSON.stringify(defaultSimulatorConfigs));
      let simChartInstance: Chart | null = null;

      // --- SEPET VE UYGULAMA DURUMU ---
      interface CartItem {
        id: string;
        title: string;
        price: number;
      }
      let cart: CartItem[] = [];

      function formatTL(num: number | string): string {
        return Number(num).toLocaleString('tr-TR') + ' ₺';
      }

      function showToast(msg: string) {
        const banner = document.getElementById('toastBanner');
        const text = document.getElementById('toastMessage');
        if (!banner || !text) return;
        text.textContent = msg;
        banner.classList.remove('hidden');
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => {
          banner.classList.add('hidden');
        }, 3500);
      }

      // --- 1. AYRIK MODÜL: MENÜ VE NAVİGASYON ---
      function initNavigation() {
        const menuBtn = document.getElementById('mobileMenuBtn');
        const menuPanel = document.getElementById('mobileMenuPanel');
        const menuBackdrop = document.getElementById('mobileMenuBackdrop');
        const menuCloseBtn = document.getElementById('mobileMenuCloseBtn');
        if (!menuBtn || !menuPanel) return;

        function toggleMenu(open?: boolean) {
          const isCurrentlyOpen = menuBtn.getAttribute('aria-expanded') === 'true';
          const nextState = typeof open === 'boolean' ? open : !isCurrentlyOpen;
          menuBtn.setAttribute('aria-expanded', String(nextState));

          if (nextState) {
            menuPanel.classList.remove('translate-x-full', 'pointer-events-none');
            menuPanel.classList.add('translate-x-0', 'pointer-events-auto');
            if (menuBackdrop) {
              menuBackdrop.classList.remove('opacity-0', 'pointer-events-none');
              menuBackdrop.classList.add('opacity-100', 'pointer-events-auto');
            }
            document.body.classList.add('overflow-hidden');
            if (menuCloseBtn) menuCloseBtn.focus();
          } else {
            menuPanel.classList.add('translate-x-full', 'pointer-events-none');
            menuPanel.classList.remove('translate-x-0', 'pointer-events-auto');
            if (menuBackdrop) {
              menuBackdrop.classList.add('opacity-0', 'pointer-events-none');
              menuBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
            }
            document.body.classList.remove('overflow-hidden');
          }
        }

        menuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        if (menuCloseBtn) {
          menuCloseBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleMenu(false);
          });
        }

        if (menuBackdrop) {
          menuBackdrop.addEventListener('click', () => {
            toggleMenu(false);
          });
        }

        // Menü içindeki linke basınca menüyü kapat
        menuPanel.querySelectorAll('a, button').forEach(link => {
          link.addEventListener('click', () => {
            toggleMenu(false);
          });
        });

        // Escape tuşu ile menüyü kapat ve odağı butona geri ver
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
            toggleMenu(false);
            menuBtn.focus();
          }
        });
      }

      // --- 2. AYRIK MODÜL: SEPET VE MODALLAR ---
      function updateCartUI() {
        const badge = document.getElementById('cartCountBadge');
        if (badge) badge.textContent = String(cart.length);

        const container = document.getElementById('cartItemsContainer');
        if (container) {
          container.innerHTML = '';
          if (cart.length === 0) {
            container.innerHTML = '<p class="text-xs text-slate-500 py-3 text-center m-0">Sepetinizde henüz ürün bulunmuyor. Katalogdan dilediğiniz Excel tablosunu sepete ekleyebilirsiniz.</p>';
          } else {
            cart.forEach(item => {
              const row = document.createElement('div');
              row.className = 'flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs';
              row.innerHTML = `
                <div class="min-w-0 pr-2">
                  <p class="font-bold text-slate-900 m-0 truncate">${item.title}</p>
                  <p class="text-[11px] text-emerald-700 font-medium m-0">Anında İndirme + Ömür Boyu Lisans</p>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="font-extrabold text-sm text-slate-900">${formatTL(item.price)}</span>
                  <button type="button" data-remove-id="${item.id}" class="remove-cart-btn text-slate-400 hover:text-rose-600 font-bold text-base p-1" aria-label="${item.title} ürününü sepetten çıkar">&times;</button>
                </div>
              `;
              container.appendChild(row);
            });
          }

          container.querySelectorAll<HTMLElement>('.remove-cart-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const removeId = btn.getAttribute('data-remove-id');
              cart = cart.filter(c => c.id !== removeId);
              updateCartUI();
            });
          });
        }

        const total = cart.reduce((sum, i) => sum + i.price, 0);
        const totalElem = document.getElementById('checkoutTotalAmount');
        if (totalElem) totalElem.textContent = formatTL(total);
      }

      function openCheckoutModal() {
        updateCartUI();
        const modal = document.getElementById('checkoutModal');
        if (modal) modal.classList.remove('hidden');
      }

      function addToCart(newItem: CartItem) {
        if (!cart.some(c => c.id === newItem.id)) {
          cart.push(newItem);
        }
        updateCartUI();
        openCheckoutModal();
        showToast(`"${newItem.title}" sepete eklendi.`);
      }

      function initCartAndModals() {
        const openCartBtn = document.getElementById('openCartBtn');
        const checkoutModal = document.getElementById('checkoutModal');
        const closeCheckoutModalBtn = document.getElementById('closeCheckoutModalBtn');

        if (openCartBtn) openCartBtn.addEventListener('click', openCheckoutModal);
        if (closeCheckoutModalBtn && checkoutModal) {
          closeCheckoutModalBtn.addEventListener('click', () => checkoutModal.classList.add('hidden'));
        }

        // Ödeme Sekmeleri
        const payTabCard = document.getElementById('payTabCard');
        const payTabEft = document.getElementById('payTabEft');
        const cardPanel = document.getElementById('cardPaymentPanel');
        const eftPanel = document.getElementById('eftPaymentPanel');

        if (payTabCard && payTabEft && cardPanel && eftPanel) {
          payTabCard.addEventListener('click', () => {
            payTabCard.className = 'min-h-[40px] py-2 px-3 rounded-lg bg-white text-slate-900 shadow-sm';
            payTabEft.className = 'min-h-[40px] py-2 px-3 rounded-lg text-slate-600 hover:text-slate-900';
            cardPanel.classList.remove('hidden');
            eftPanel.classList.add('hidden');
          });

          payTabEft.addEventListener('click', () => {
            payTabEft.className = 'min-h-[40px] py-2 px-3 rounded-lg bg-white text-slate-900 shadow-sm';
            payTabCard.className = 'min-h-[40px] py-2 px-3 rounded-lg text-slate-600 hover:text-slate-900';
            eftPanel.classList.remove('hidden');
            cardPanel.classList.add('hidden');
          });
        }

        // Kurumsal Fatura Toggle
        const corpToggle = document.getElementById('corporateInvoiceToggle') as HTMLInputElement | null;
        const corpFields = document.getElementById('corporateInvoiceFields');
        if (corpToggle && corpFields) {
          corpToggle.addEventListener('change', () => {
            corpFields.classList.toggle('hidden', !corpToggle.checked);
          });
        }

        // Siparişi Tamamla
        const completeOrderBtn = document.getElementById('completeOrderBtn');
        if (completeOrderBtn && checkoutModal) {
          completeOrderBtn.addEventListener('click', () => {
            if (cart.length === 0) {
              showToast('Lütfen önce bir Excel tablosu seçin.');
              return;
            }
            checkoutModal.classList.add('hidden');
            showToast('Ödeme onaylandı! Satın aldığınız Excel modeli indirme bağlantınız ve e-Faturanız hazırlandı.');
          });
        }

        // Model Satın Alma Butonları (#paketler)
        document.querySelectorAll<HTMLElement>('.select-plan-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const planTitle = btn.getAttribute('data-plan') || 'Kurumsal Karar Modeli';
            const planPrice = parseInt(btn.getAttribute('data-price') || '2000', 10);
            cart = [{ id: 'plan-' + planPrice, title: planTitle, price: planPrice }];
            openCheckoutModal();
          });
        });

        // Ücretsiz Numune Modalı
        const freeModal = document.getElementById('freeSampleModal');
        const freeTopBtn = document.getElementById('freeSampleTopBtn');
        const freeMobileBtn = document.getElementById('freeSampleMobileBtn');
        const closeFreeModalBtn = document.getElementById('closeFreeSampleModalBtn');
        const downloadSampleBtn = document.getElementById('downloadSampleNowBtn');

        if (freeTopBtn && freeModal) freeTopBtn.addEventListener('click', () => freeModal.classList.remove('hidden'));
        if (freeMobileBtn && freeModal) freeMobileBtn.addEventListener('click', () => freeModal.classList.remove('hidden'));
        if (closeFreeModalBtn && freeModal) closeFreeModalBtn.addEventListener('click', () => freeModal.classList.add('hidden'));

        if (downloadSampleBtn && freeModal) {
          downloadSampleBtn.addEventListener('click', () => {
            const csvContent = "Donem;Gelir_TL;Gider_TL;Net_Bakiye_TL\nOcak 2026;480000;320000;160000\nSubat 2026;530000;390000;140000\nMart 2026;610000;410000;200000";
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'ExcelArsiv_2026_Ornek_Nakit_Akisi_Sablonu.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            freeModal.classList.add('hidden');
            showToast('Ücretsiz örnek şablon bilgisayarınıza indirildi!');
          });
        }
      }

      // --- 3. AYRIK MODÜL: ŞABLON VİTRİNİ VE FİLTRELEME (PROGRESİF GELİŞTİRME) ---
      function initTemplateShowcase() {
        const grid = document.getElementById('templateGrid');
        const emptyState = document.getElementById('templateEmptyState');
        const clearFiltersBtn = document.getElementById('clearFiltersBtn');
        const searchInput = document.getElementById('heroSearchInput') as HTMLInputElement | null;
        const searchBtn = document.getElementById('heroSearchBtn');
        const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement | null;
        const catButtons = document.querySelectorAll<HTMLElement>('.cat-btn');

        if (!grid) return;

        let activeCategory = 'all';
        let searchQuery = '';
        let activeSort = 'popular';

        function applyFilters() {
          const cards = Array.from(grid.querySelectorAll<HTMLElement>('.template-card'));
          let visibleCount = 0;
          const q = searchQuery.trim().toLowerCase();

          cards.forEach(card => {
            const cat = card.getAttribute('data-cat') || '';
            const title = (card.getAttribute('data-title') || '').toLowerCase();
            const desc = (card.getAttribute('data-desc') || '').toLowerCase();

            const matchesCategory = activeCategory === 'all' || cat === activeCategory;
            const matchesQuery = !q || title.includes(q) || desc.includes(q) || cat.toLowerCase().includes(q);

            if (matchesCategory && matchesQuery) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          // Sıralama
          if (activeSort === 'popular') {
            cards.sort((a, b) => parseInt(b.getAttribute('data-downloads') || '0', 10) - parseInt(a.getAttribute('data-downloads') || '0', 10));
          } else if (activeSort === 'price-asc') {
            cards.sort((a, b) => parseInt(a.getAttribute('data-price') || '0', 10) - parseInt(b.getAttribute('data-price') || '0', 10));
          } else if (activeSort === 'newest') {
            // Ters sıra
            cards.reverse();
          }

          cards.forEach(card => grid.appendChild(card));

          // Boş Durum Gösterimi
          if (emptyState) {
            if (visibleCount === 0) {
              emptyState.classList.remove('hidden');
            } else {
              emptyState.classList.add('hidden');
            }
          }
        }

        function updateCategoryButtons() {
          catButtons.forEach(b => {
            if (b.getAttribute('data-cat') === activeCategory) {
              b.className = 'cat-btn min-h-[40px] px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 text-white shadow-sm transition flex items-center justify-center';
            } else {
              b.className = 'cat-btn min-h-[40px] px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 shadow-sm transition flex items-center justify-center';
            }
          });
        }

        catButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            activeCategory = btn.getAttribute('data-cat') || 'all';
            updateCategoryButtons();
            applyFilters();
          });
        });

        if (clearFiltersBtn) {
          clearFiltersBtn.addEventListener('click', () => {
            activeCategory = 'all';
            searchQuery = '';
            if (searchInput) searchInput.value = '';
            updateCategoryButtons();
            applyFilters();
          });
        }

        if (sortSelect) {
          sortSelect.addEventListener('change', () => {
            activeSort = sortSelect.value;
            applyFilters();
          });
        }

        if (searchBtn && searchInput) {
          searchBtn.addEventListener('click', () => {
            searchQuery = searchInput.value;
            applyFilters();
            const sablonSection = document.getElementById('sablonlar');
            if (sablonSection) sablonSection.scrollIntoView({ behavior: 'smooth' });
          });

          searchInput.addEventListener('input', () => {
            searchQuery = searchInput.value;
            applyFilters();
          });

          searchInput.addEventListener('keyup', (e) => {
            if (e.key === 'Enter') {
              searchQuery = searchInput.value;
              applyFilters();
              const sablonSection = document.getElementById('sablonlar');
              if (sablonSection) sablonSection.scrollIntoView({ behavior: 'smooth' });
            }
          });
        }

        // Hızlı Arama Etiketleri
        document.querySelectorAll<HTMLElement>('.quick-search-tag').forEach(tag => {
          tag.addEventListener('click', () => {
            const filterCat = tag.getAttribute('data-quick-filter') || 'all';
            activeCategory = filterCat;
            searchQuery = '';
            if (searchInput) searchInput.value = '';
            updateCategoryButtons();
            applyFilters();
            const sablonSection = document.getElementById('sablonlar');
            if (sablonSection) sablonSection.scrollIntoView({ behavior: 'smooth' });
          });
        });

        // Canlı Önizle Butonları
        grid.querySelectorAll<HTMLElement>('.preview-template-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const simKey = btn.getAttribute('data-preview-sim') || 'nakit';
            switchSimulatorTab(simKey);
            const simSection = document.getElementById('canli-onizleme');
            if (simSection) simSection.scrollIntoView({ behavior: 'smooth' });
            showToast('Şablon canlı simülatöre yüklendi!');
          });
        });

        // Sepete Ekle Butonları
        grid.querySelectorAll<HTMLElement>('.add-template-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-add-id') || 'sablon';
            const title = (btn.getAttribute('data-add-title') || 'Hazır Şablon') + ' (Tekil Uygulama)';
            const price = parseInt(btn.getAttribute('data-add-price') || '2000', 10);
            addToCart({ id, title, price });
          });
        });
      }

      // --- 4. AYRIK MODÜL: SİMÜLATÖR TABLOSU & HESAPLAMALARI ---
      function renderSimulatorTable() {
        const cfg = simState[activeSimKey];
        if (!cfg) return;

        const nameElem = document.getElementById('simFileName');
        const formElem = document.getElementById('simFormulaText');
        const titleElem = document.getElementById('simTableTitle');
        const h1 = document.getElementById('colHeader1');
        const h2 = document.getElementById('colHeader2');
        const h3 = document.getElementById('colHeader3');
        const h4 = document.getElementById('colHeader4');

        if (nameElem) nameElem.textContent = cfg.fileName;
        if (formElem) formElem.textContent = cfg.formula;
        if (titleElem) titleElem.textContent = cfg.tableTitle;
        if (h1) h1.textContent = cfg.headers[0];
        if (h2) h2.textContent = cfg.headers[1];
        if (h3) h3.textContent = cfg.headers[2];
        if (h4) h4.textContent = cfg.headers[3];

        const kpi1L = document.getElementById('kpi1Label');
        const kpi2L = document.getElementById('kpi2Label');
        const kpi3L = document.getElementById('kpi3Label');
        if (kpi1L) kpi1L.textContent = cfg.kpiLabels[0];
        if (kpi2L) kpi2L.textContent = cfg.kpiLabels[1];
        if (kpi3L) kpi3L.textContent = cfg.kpiLabels[2];

        const tbody = document.getElementById('simTableBody');
        if (!tbody) return;

        tbody.innerHTML = '';
        let totalIn = 0;
        let totalOut = 0;

        cfg.rows.forEach((row, idx) => {
          const net = row.inVal - row.outVal;
          totalIn += row.inVal;
          totalOut += row.outVal;

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50 transition';
          tr.innerHTML = `
            <td class="border border-slate-300 px-2 py-2 text-center bg-slate-100 font-mono text-slate-500">${idx + 1}</td>
            <td class="border border-slate-300 px-3 py-2 font-semibold text-slate-800">${row.label}</td>
            <td class="border border-slate-300 px-2 py-1.5 text-right">
              <input type="number" step="10000" data-row="${idx}" data-field="inVal" value="${row.inVal}" class="sim-cell-input w-28 text-right px-2 py-1 rounded bg-emerald-50/50 border border-emerald-200 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-excel-600" />
            </td>
            <td class="border border-slate-300 px-2 py-1.5 text-right">
              <input type="number" step="10000" data-row="${idx}" data-field="outVal" value="${row.outVal}" class="sim-cell-input w-28 text-right px-2 py-1 rounded bg-rose-50/50 border border-rose-200 font-bold text-rose-700 focus:outline-none focus:ring-2 focus:ring-excel-600" />
            </td>
            <td class="border border-slate-300 px-3 py-2 text-right font-extrabold bg-emerald-50/60 ${net >= 0 ? 'text-excel-700' : 'text-rose-600'}">
              ${formatTL(net)}
            </td>
          `;
          tbody.appendChild(tr);
        });

        const kpi1V = document.getElementById('kpi1Value');
        const kpi2V = document.getElementById('kpi2Value');
        const kpi3V = document.getElementById('kpi3Value');
        if (kpi1V) kpi1V.textContent = formatTL(totalIn);
        if (kpi2V) kpi2V.textContent = formatTL(totalOut);
        if (kpi3V) kpi3V.textContent = formatTL(totalIn - totalOut);

        // Input dinleyicileri
        tbody.querySelectorAll<HTMLInputElement>('.sim-cell-input').forEach(inp => {
          inp.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            const rIdx = parseInt(target.getAttribute('data-row') || '0', 10);
            const field = target.getAttribute('data-field') as 'inVal' | 'outVal';
            const val = parseFloat(target.value) || 0;
            simState[activeSimKey].rows[rIdx][field] = val;
            updateSimulatorTotalsAndChart();
          });
        });

        updateSimulatorChartSafe();
      }

      function updateSimulatorTotalsAndChart() {
        const cfg = simState[activeSimKey];
        const tbody = document.getElementById('simTableBody') as HTMLTableSectionElement | null;
        if (!cfg || !tbody) return;

        let totalIn = 0;
        let totalOut = 0;

        cfg.rows.forEach((row, idx) => {
          const net = row.inVal - row.outVal;
          totalIn += row.inVal;
          totalOut += row.outVal;
          if (tbody.rows[idx]) {
            const netCell = tbody.rows[idx].cells[4];
            if (netCell) {
              netCell.textContent = formatTL(net);
              netCell.className = `border border-slate-300 px-3 py-2 text-right font-extrabold bg-emerald-50/60 ${net >= 0 ? 'text-excel-700' : 'text-rose-600'}`;
            }
          }
        });

        const kpi1V = document.getElementById('kpi1Value');
        const kpi2V = document.getElementById('kpi2Value');
        const kpi3V = document.getElementById('kpi3Value');
        if (kpi1V) kpi1V.textContent = formatTL(totalIn);
        if (kpi2V) kpi2V.textContent = formatTL(totalOut);
        if (kpi3V) kpi3V.textContent = formatTL(totalIn - totalOut);

        updateSimulatorChartSafe();
      }

      function switchSimulatorTab(simKey: string) {
        activeSimKey = simKey;
        document.querySelectorAll<HTMLElement>('.sim-tab-btn').forEach(b => {
          if (b.getAttribute('data-sim') === simKey) {
            b.className = 'sim-tab-btn min-h-[38px] px-4 py-2 rounded-xl text-xs font-bold bg-excel-600 text-white shadow-sm transition whitespace-nowrap';
          } else {
            b.className = 'sim-tab-btn min-h-[38px] px-4 py-2 rounded-xl text-xs font-bold bg-transparent text-slate-700 hover:text-slate-900 transition whitespace-nowrap';
          }
        });
        renderSimulatorTable();
      }

      // --- 5. AYRIK MODÜL: SİMÜLATÖR GRAFİĞİ (BAĞIMSIZ, HATA KORUMALI) ---
      function updateSimulatorChartSafe() {
        const cfg = simState[activeSimKey];
        if (!cfg) return;

        // 1. Canlı Yerel Bar Görünümünü Güncelle (Anında CSS animasyonu & Asla Boş Kalmaz)
        const maxVal = Math.max(...cfg.rows.map(r => Math.max(r.inVal, r.outVal)), 1);
        cfg.rows.forEach((r, idx) => {
          const inPct = Math.min(100, Math.max(10, Math.round((r.inVal / maxVal) * 100)));
          const outPct = Math.min(100, Math.max(10, Math.round((r.outVal / maxVal) * 100)));
          const net = r.inVal - r.outVal;

          const barIn = document.getElementById(`barIn${idx}`);
          const barOut = document.getElementById(`barOut${idx}`);
          const valLabel = document.getElementById(`liveBarVal${idx}`);
          const titleLabel = document.getElementById(`liveBarLabel${idx}`);

          if (barIn) barIn.style.height = `${inPct}%`;
          if (barOut) barOut.style.height = `${outPct}%`;
          if (valLabel) {
            const shortVal = (net >= 0 ? '+' : '') + Math.round(net / 1000) + 'B ₺';
            valLabel.textContent = shortVal;
            valLabel.className = `text-[10px] font-extrabold ${net >= 0 ? 'text-slate-800' : 'text-rose-600'}`;
          }
          if (titleLabel) titleLabel.textContent = r.label;
        });

        // 2. Chart.js (Varsa senkronize güncelle)
        const canvas = document.getElementById('simulatorChart') as HTMLCanvasElement | null;
        const liveBar = document.getElementById('liveBarChart');
        const fallback = document.getElementById('chartFallback');
        if (!canvas) return;

        try {
          const labels = cfg.rows.map(r => r.label);
          const inData = cfg.rows.map(r => r.inVal);
          const outData = cfg.rows.map(r => r.outVal);
          const netData = cfg.rows.map(r => r.inVal - r.outVal);

          // Canvas'ı görünür kıl, yerel DOM çubuğunu gizle
          if (liveBar) liveBar.classList.add('hidden');
          canvas.classList.remove('hidden', 'pointer-events-none');

          if (simChartInstance) {
            simChartInstance.data.labels = labels;
            simChartInstance.data.datasets[0].data = inData;
            simChartInstance.data.datasets[1].data = outData;
            simChartInstance.data.datasets[2].data = netData;
            simChartInstance.update();
            if (fallback) fallback.classList.add('hidden');
            return;
          }

          const ctx = canvas.getContext('2d');
          if (!ctx) throw new Error('Canvas 2D context oluşturulamadı');

          simChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
              labels,
              datasets: [
                {
                  label: 'Giriş / Hedef',
                  data: inData,
                  backgroundColor: '#10b981',
                  borderRadius: 4,
                  barPercentage: 0.65,
                  categoryPercentage: 0.75,
                  order: 2
                },
                {
                  label: 'Çıkış / Maliyet',
                  data: outData,
                  backgroundColor: '#f43f5e',
                  borderRadius: 4,
                  barPercentage: 0.65,
                  categoryPercentage: 0.75,
                  order: 3
                },
                {
                  label: 'Net Bakiye',
                  data: netData,
                  type: 'line',
                  borderColor: '#0f172a',
                  backgroundColor: '#0f172a',
                  borderWidth: 2.5,
                  pointRadius: 4,
                  pointHoverRadius: 6,
                  pointBackgroundColor: '#ffffff',
                  pointBorderColor: '#0f172a',
                  pointBorderWidth: 2,
                  tension: 0.25,
                  order: 1
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              layout: {
                padding: {
                  top: 10,
                  bottom: 4,
                  left: 2,
                  right: 2
                }
              },
              plugins: {
                legend: {
                  position: 'bottom',
                  align: 'center',
                  labels: {
                    boxWidth: 8,
                    boxHeight: 8,
                    usePointStyle: true,
                    pointStyle: 'circle',
                    font: { size: 11, family: 'Inter, system-ui, -apple-system, sans-serif', weight: '600' },
                    color: '#475569',
                    padding: 14
                  }
                },
                tooltip: {
                  backgroundColor: '#0f172a',
                  padding: 10,
                  cornerRadius: 8,
                  titleFont: { size: 12, weight: 'bold' },
                  bodyFont: { size: 11 },
                  callbacks: {
                    label: function(context) {
                      const val = context.parsed.y;
                      return ' ' + context.dataset.label + ': ' + formatTL(val);
                    }
                  }
                }
              },
              scales: {
                y: {
                  grid: { color: '#f1f5f9' },
                  ticks: {
                    color: '#64748b',
                    font: { size: 10, weight: '500' },
                    callback: function(val) {
                      return (Number(val) / 1000) + 'B ₺';
                    }
                  }
                },
                x: {
                  grid: { display: false },
                  ticks: {
                    color: '#475569',
                    font: { size: 10, weight: '600' },
                    maxRotation: 0,
                    autoSkip: false,
                    callback: function(val) {
                      const lbl = this.getLabelForValue(val as number);
                      if (typeof lbl === 'string') {
                        if (lbl.includes('&')) {
                          return lbl.split('&').map((s: string) => s.trim());
                        }
                        const words = lbl.split(' ');
                        if (words.length >= 3) {
                          return [words.slice(0, 2).join(' '), words.slice(2).join(' ')];
                        }
                        if (words.length === 2 && lbl.length > 11) {
                          return words;
                        }
                      }
                      return lbl;
                    }
                  }
                }
              }
            }
          });

          if (fallback) fallback.classList.add('hidden');
        } catch (err) {
          console.warn('Simülatör grafik render hatası:', err);
          if (liveBar) liveBar.classList.remove('hidden');
          if (canvas) canvas.classList.add('hidden');
          if (fallback) fallback.classList.remove('hidden');
        }
      }

      function initSimulator() {
        renderSimulatorTable();

        // Simülatör Sekmeleri
        document.querySelectorAll<HTMLElement>('.sim-tab-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const sim = btn.getAttribute('data-sim') || 'nakit';
            switchSimulatorTab(sim);
          });
        });

        // Verileri Sıfırla
        const resetBtn = document.getElementById('simResetDataBtn');
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            simState = JSON.parse(JSON.stringify(defaultSimulatorConfigs));
            renderSimulatorTable();
            showToast('Tablo varsayılan değerlerine sıfırlandı.');
          });
        }

        // Sepete Ekle Butonu
        const simAddBtn = document.getElementById('simAddToCartBtn');
        if (simAddBtn) {
          simAddBtn.addEventListener('click', () => {
            const cfg = simState[activeSimKey];
            addToCart({
              id: 'sim-' + activeSimKey,
              title: cfg.fileName.split('—')[0].trim(),
              price: 2000
            });
          });
        }

        // Yeniden Dene Butonu
        const retryBtn = document.getElementById('retryChartBtn');
        if (retryBtn) {
          retryBtn.addEventListener('click', () => {
            if (simChartInstance) {
              simChartInstance.destroy();
              simChartInstance = null;
            }
            updateSimulatorChartSafe();
          });
        }
      }

      // --- 6. AYRIK MODÜL: ROI HESAPLAYICI ---
      function initRoiCalculator() {
        const roiSlider = document.getElementById('roiSlider') as HTMLInputElement | null;
        const roiHoursLabel = document.getElementById('roiHoursLabel');
        const roiSavedHours = document.getElementById('roiSavedHours');
        const roiSavedMoney = document.getElementById('roiSavedMoney');

        if (!roiSlider || !roiHoursLabel || !roiSavedHours || !roiSavedMoney) return;

        roiSlider.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const weeklyHours = parseInt(target.value, 10);
          const yearlySavedHours = Math.round(weeklyHours * 52 * 0.8);
          const yearlyMoney = yearlySavedHours * 250;
          roiHoursLabel.textContent = `Haftada ${weeklyHours} Saat Excel İşi`;
          roiSavedHours.textContent = `${yearlySavedHours} Saat / Yıl`;
          roiSavedMoney.textContent = formatTL(yearlyMoney) + ' / Yıl';
        });
      }

      // --- 7. AYRIK MODÜL: SSS AKORDEON & B2B & DESTEK ---
      function initB2bFormAndSupport() {
        // SSS Akordeon
        document.querySelectorAll<HTMLElement>('.faq-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const content = btn.nextElementSibling as HTMLElement | null;
            const icon = btn.querySelector('.faq-icon');
            if (!content || !icon) return;
            const isHidden = content.classList.contains('hidden');
            content.classList.toggle('hidden', !isHidden);
            btn.setAttribute('aria-expanded', String(isHidden));
            icon.textContent = isHidden ? '−' : '+';
          });
        });

        // B2B Teklif Formu
        const quoteForm = document.getElementById('b2bQuoteForm');
        if (quoteForm) {
          quoteForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const companyInput = document.getElementById('b2bCompany') as HTMLInputElement | null;
            const company = companyInput?.value || 'Şirketiniz';
            (e.target as HTMLFormElement).reset();
            showToast(`Teşekkürler! ${company} için kurumsal teklif talebiniz uzman ekibimize iletildi.`);
          });
        }

        // WhatsApp Widget
        const waPopup = document.getElementById('waChatPopup');
        const toggleWaBtn = document.getElementById('toggleWaPopupBtn');
        const closeWaBtn = document.getElementById('closeWaPopupBtn');
        const sendWaBtn = document.getElementById('sendWaMsgBtn');
        const waInput = document.getElementById('waQuickInput') as HTMLInputElement | null;

        if (toggleWaBtn && waPopup) {
          toggleWaBtn.addEventListener('click', () => waPopup.classList.toggle('hidden'));
        }
        if (closeWaBtn && waPopup) {
          closeWaBtn.addEventListener('click', () => waPopup.classList.add('hidden'));
        }
        if (sendWaBtn && waPopup) {
          sendWaBtn.addEventListener('click', () => {
            const msg = waInput?.value.trim() || 'Merhaba, Excel Arşivi paketleri hakkında bilgi almak istiyorum.';
            waPopup.classList.add('hidden');
            window.open(`https://wa.me/905393333303?text=${encodeURIComponent(msg)}`, '_blank', 'noopener,noreferrer');
            showToast(`WhatsApp açılıyor: "${msg}"`);
          });
        }
      }

      // --- BAŞLATMA ZİNCİRİ (TAM İZOLASYONLU) ---
      function bootstrap() {
        try { initNavigation(); } catch (e) { console.error('Navigation init error:', e); }
        try { initCartAndModals(); } catch (e) { console.error('Cart init error:', e); }
        try { initTemplateShowcase(); } catch (e) { console.error('Showcase init error:', e); }
        try { initRoiCalculator(); } catch (e) { console.error('ROI init error:', e); }
        try { initB2bFormAndSupport(); } catch (e) { console.error('B2B/Support init error:', e); }
        try { initSimulator(); } catch (e) { console.error('Simulator init error:', e); }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap);
      } else {
        bootstrap();
      }
    }
  </script>
</body>
</html>
