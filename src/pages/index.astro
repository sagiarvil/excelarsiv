const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'Excel Arşiv',
      url: `${site}/`,
      description: 'Excel Arşiv — Türkiye\'nin hazır Excel şablon, dinamik yönetim dashboard ve VBA makro arşivi.',
      logo: {
        '@type': 'ImageObject',
        url: `${site}/og.png`,
        width: 1200,
        height: 1200,
      },
      email: YAZAR.eposta,
      taxID: SATICI.vkn,
      sameAs: [
        'https://www.wikidata.org/wiki/Q11261',
        'https://www.wikidata.org/wiki/Q380',
        'https://www.wikidata.org/wiki/Q1313364',
        'https://www.wikidata.org/wiki/Q11589432',
        'https://www.wikidata.org/wiki/Q11190',
        'https://www.linkedin.com/company/excelarsiv',
        'https://www.linkedin.com/in/barisbagirlar/',
        ...YAZAR.sameAs,
      ],
      founder: { '@id': yazarPersonId(site) },
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'TR',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: YAZAR.eposta,
        telephone: SATICI.telefonE164,
        contactType: 'customer support',
        availableLanguage: 'tr-TR',
        areaServed: 'TR',
      },
    },
    yazarPersonLd(site),
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Excel Arşiv',
      url: `${site}/`,
      inLanguage: 'tr-TR',
      publisher: { '@id': `${site}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${site}/sablonlar?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${site}/#webpage`,
      url: `${site}/`,
      name: 'ExcelArşiv Pro | Türkiye\'nin Hazır Excel Şablon, Dashboard ve VBA Arşivi',
      description: 'Sıfırdan tablo kurmakla saatler harcamayın: 124 profesyonel Excel şablonu, dinamik yönetim dashboardları ve tek tıkla çalışan VBA makrolarını güvenle indirin.',
      inLanguage: 'tr-TR',
      isPartOf: { '@id': `${site}/#website` },
      about: { '@id': `${site}/#organization` },
      author: { '@id': yazarPersonId(site) },
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Ödeme yaptıktan sonra dosyaları hemen indirebiliyor muyum?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Evet! Kredi kartı veya banka kartı ile 3D Secure üzerinden ödemenizi tamamladığınız saniye hesabınız otomatik olarak aktifleşir. Ödeme bildirimi formu doldurmanıza veya onay beklemenize gerek kalmadan tüm dosyaları tek tıkla indirebilirsiniz.'
          }
        },
        {
          '@type': 'Question',
          name: 'İndirdiğim Excel şablonlarında şifre veya kullanım süresi sınırı var mı?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Hayır. Tüm Excel tablolarımız ve VBA makrolarımız tamamen açık kaynaklıdır. Kendi şirket logonuzu ekleyebilir, satır/sütun ve formülleri dilediğiniz gibi değiştirebilirsiniz. Aylık ya da yıllık abonelik ücreti yoktur.'
          }
        },
        {
          '@type': 'Question',
          name: 'Kurumsal Excel Karar Modellerinin lisanslama ve fiyatlandırması nasıl çalışır?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Tüm kurumsal Excel karar destek ve yönetim modellerimiz bağımsız olarak adet başına 2.000 ₺ lisans bedeliyle sunulmaktadır. Satın aldığınız model açık formülleriyle, şifresiz, 10 kullanıcıya kadar şirket içi kullanım lisansıyla ve ömür boyu ücretsiz mevzuat güncellemeleriyle teslim edilir.'
          }
        },
        {
          '@type': 'Question',
          name: 'Şirketimiz adına kurumsal e-Fatura kesiyor musunuz?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Elbette. ExcelArşiv olarak tüm bireysel ve kurumsal satın alımlarda KDV dahil resmi e-Arşiv / e-Fatura düzenlemekteyiz. Ödeme adımında vergi dairesi ve VKN bilgilerinizi girmeniz yeterlidir.'
          }
        }
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${site}/#catalog`,
      name: 'Öne Çıkan Hazır Excel Şablonları ve Dashboard Sistemleri',
      numberOfItems: showcaseTemplates.length,
      itemListElement: showcaseTemplates.map((item, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: item.title,
        url: item.url.startsWith('http') ? item.url : `${site}${item.url}`,
      })),
    },
  ],
};

function formatTL(num: number | string): string {
  return Number(num).toLocaleString('tr-TR') + ' ₺';
}
