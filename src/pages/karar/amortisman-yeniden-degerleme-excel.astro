---
import CommerceLayout from '../../layouts/CommerceLayout.astro';

const primarySlug = "amortisman-2026-yeniden-degerleme";
const siteUrl = Astro.site ?? 'https://excelarsiv.com/';
const pageUrl = new URL('/karar/amortisman-yeniden-degerleme-excel', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      'itemListElement': [
