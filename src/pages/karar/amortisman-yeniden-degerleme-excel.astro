        { '@type': 'ListItem', 'position': 2, 'name': 'Kararlar', 'item': new URL('/karar', siteUrl).href },
        { '@type': 'ListItem', 'position': 3, 'name': "Amortisman ve 2026 yeniden değerleme hesaplama Excel'i", 'item': pageUrl }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      'mainEntity': [{"@type": "Question", "name": "Normal ve azalan bakiyeler yöntemi destekleniyor mu?", "acceptedAnswer": {"@type": "Answer", "text": "Evet, her iki amortisman yöntemi de yasal oranlarıyla formüllere dahil edilmiştir."}}, {"@type": "Question", "name": "Geçici 32 ve Mükerrer 298/Ç farkı nedir?", "acceptedAnswer": {"@type": "Answer", "text": "Geçici 32 geçmiş dönem birikimli değerlemeyi, 298/Ç ise cari dönem sürekli yeniden değerlemeyi kapsar."}}, {"@type": "Question", "name": "Faydalı ömür listesi güncel mi?", "acceptedAnswer": {"@type": "Answer", "text": "GİB amortisman tebliğlerindeki güncel faydalı ömür ve oran tablosu sisteme işlenmiştir."}}, {"@type": "Question", "name": "Net vergi tasarrufu nasıl hesaplanır?", "acceptedAnswer": {"@type": "Answer", "text": "Değerleme sonrası artan amortisman giderinin kurumlar vergisi matrahına etkisi hesaplanır."}}, {"@type": "Question", "name": "Binek oto amortisman gider kısıtlaması var mı?", "acceptedAnswer": {"@type": "Answer", "text": "Binek araçlar için mevzuattaki KDV/ÖTV ve amortisman tavan sınırları dikkate alınır."}}]
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#itemlist`,
      'name': "Amortisman ve 2026 yeniden değerleme hesaplama Excel'i",
      'itemListElement': [{"@type": "ListItem", "position": 1, "item": {"@type": "Product", "name": "Amortisman + 2026 Yeniden Değerleme", "url": "https://excelarsiv.com/sablon/amortisman-2026-yeniden-degerleme", "offers": {"@type": "Offer", "price": 499, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Product", "name": "Amortisman & Sabit Kıymet Satış Zamanlama Stratejisti", "url": "https://excelarsiv.com/sablon/amortisman-ve-sabit-kiymet-satis-zamanlama-stratejisti", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Product", "name": "Yeniden Değerleme Yapmalı Mıyım? (Vergi Tasarruf Analizi)", "url": "https://excelarsiv.com/sablon/yeniden-degerleme-yapmali-miyim-vergi-tasarruf-analizi", "offers": {"@type": "Offer", "price": 999, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}]
    }
  ]
};
---

<CommerceLayout
  title="Amortisman Yeniden Değerleme Excel | Excel Arşiv"
  description="VUK geçici 32 ve mükerrer 298/Ç kapsamında duran varlık amortismanı, yeniden değerleme oranları ve vergi avantajı hesaplayan profesyonel Excel sistemi."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-neutral-500 mb-4 font-mono" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Ana Sayfa</a> / <a href="/karar" class="hover:underline">Kararlar</a> / <span>amortisman-yeniden-degerleme-excel</span>
    </nav>

    <article>
      <header class="border-b border-neutral-200 pb-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
          Amortisman ve 2026 yeniden değerleme hesaplama Excel'i
        </h1>
        <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 font-mono">
          <time datetime="2026-08-20">Son güncelleme: 2026-08-20</time>
          <span>·</span>
          <span>Excel Arşiv Finansal Denetim Masası</span>
        </div>
      </header>

      {/* CEVAP BLOĞU (40-60 KELİME) */}
