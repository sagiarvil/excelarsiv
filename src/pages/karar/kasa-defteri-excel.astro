---
import CommerceLayout from '../../layouts/CommerceLayout.astro';

const primarySlug = "akilli-kasa-defteri-ve-nakit-kontrol-sistemi";
const siteUrl = Astro.site ?? 'https://excelarsiv.com/';
const pageUrl = new URL('/karar/kasa-defteri-excel', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Ana Sayfa', 'item': siteUrl },
        { '@type': 'ListItem', 'position': 2, 'name': 'Kararlar', 'item': new URL('/karar', siteUrl).href },
        { '@type': 'ListItem', 'position': 3, 'name': "Günlük kasa defteri Excel: Kasa sayım farkı takibi", 'item': pageUrl }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      'mainEntity': [{"@type": "Question", "name": "Kasa sayım farkı nasıl hesaplanır?", "acceptedAnswer": {"@type": "Answer", "text": "Gün sonu fiziki nakit sayımı girildiğinde, sistem hesaplanan bakiye ile farkı alarak açık veya fazla tutarını gösterir."}}, {"@type": "Question", "name": "Birden fazla para birimi (TL, USD, EUR) destekleniyor mu?", "acceptedAnswer": {"@type": "Answer", "text": "Evet, döviz kasası modülü ile farklı para birimleri ayrı tablolarda izlenebilir."}}, {"@type": "Question", "name": "Günlük devir bakiyesi otomatik aktarılır mı?", "acceptedAnswer": {"@type": "Answer", "text": "Formüller bir önceki günün kapanışını otomatik olarak ertesi günün açılış bakiyesi yapar."}}, {"@type": "Question", "name": "Kategori bazında harcama raporu alınabilir mi?", "acceptedAnswer": {"@type": "Answer", "text": "Aylık özet tablosu yemek, yakıt, malzeme gibi masraf kalemlerini otomatik gruplar."}}, {"@type": "Question", "name": "Yazıcı çıktısı alınabilir mi?", "acceptedAnswer": {"@type": "Answer", "text": "Tüm sayfalar A4 yatay ve dikey baskı alanları ayarlanmış olarak tasarlanmıştır."}}]
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#itemlist`,
      'name': "Günlük kasa defteri Excel: Kasa sayım farkı takibi",
      'itemListElement': [{"@type": "ListItem", "position": 1, "item": {"@type": "Product", "name": "Akıllı Kasa Defteri ve Nakit Kontrol Sistemi", "url": "https://excelarsiv.com/sablon/akilli-kasa-defteri-ve-nakit-kontrol-sistemi", "offers": {"@type": "Offer", "price": 499, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Product", "name": "13 Haftalık Nakit Akışı ve Ödeme Planlama Sistemi", "url": "https://excelarsiv.com/sablon/13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi", "offers": {"@type": "Offer", "price": 999, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Product", "name": "Günlük Gelir–Gider ve Gerçek Kârlılık Sistemi", "url": "https://excelarsiv.com/sablon/gunluk-gelir-gider-ve-gercek-karlilik-sistemi", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}]
    }
  ]
};
---

<CommerceLayout
  title="Günlük Kasa Defteri Excel Şablonu | Excel Arşiv"
  description="Günlük kasa defteri ve nakit kontrol Excel modeli: Gün sonu fiili sayım farklarını, masraf dağılımını ve kasa devir bakiyesini anında takip edin."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-neutral-500 mb-4 font-mono" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Ana Sayfa</a> / <a href="/karar" class="hover:underline">Kararlar</a> / <span>kasa-defteri-excel</span>
    </nav>

    <article>
      <header class="border-b border-neutral-200 pb-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
          Günlük kasa defteri Excel: Kasa sayım farkı takibi
        </h1>
        <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 font-mono">
          <time datetime="2026-08-20">Son güncelleme: 2026-08-20</time>
          <span>·</span>
          <span>Excel Arşiv Finansal Denetim Masası</span>
        </div>
      </header>

      {/* CEVAP BLOĞU (40-60 KELİME) */}
