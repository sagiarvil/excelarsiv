        { '@type': 'ListItem', 'position': 3, 'name': "Mali müşavir için cari takip Excel'i: Müşteri risk yönetimi", 'item': pageUrl }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      'mainEntity': [{"@type": "Question", "name": "Yaşlandırma dilimleri nasıl belirlenir?", "acceptedAnswer": {"@type": "Answer", "text": "0-30, 31-60, 61-90 ve 90+ gün vadeli standart yaşlandırma matrisi üzerinden otomatik hesaplanır."}}, {"@type": "Question", "name": "Müşteri bazında kredi limiti tanımlanabilir mi?", "acceptedAnswer": {"@type": "Answer", "text": "Evet, her müşteri kartında risk limiti belirlenebilir ve limit aşıldığında uyarı verilir."}}, {"@type": "Question", "name": "Dövizli cari hesaplar desteklenir mi?", "acceptedAnswer": {"@type": "Answer", "text": "TL ve yabancı para cinsinden borç-alacak hareketleri ayrı sütunlarda takip edilir."}}, {"@type": "Question", "name": "Mutabakat mektubu çıktısı alınabilir mi?", "acceptedAnswer": {"@type": "Answer", "text": "Standart cari bakiye mutabakat formatında yazdırma alanı mevcuttur."}}, {"@type": "Question", "name": "Logo ve diğer ERP sistemlerinden aktarım yapılabilir mi?", "acceptedAnswer": {"@type": "Answer", "text": "Excel mizan ve muavin dökümleri kopyalanarak sisteme kolayca entegre edilir."}}]
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#itemlist`,
      'name': "Mali müşavir için cari takip Excel'i: Müşteri risk yönetimi",
      'itemListElement': [{"@type": "ListItem", "position": 1, "item": {"@type": "Product", "name": "Cari Hesap, Tahsilat ve Müşteri Risk Takip Sistemi", "url": "https://excelarsiv.com/sablon/cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Product", "name": "Cari ve Ba-Bs Toplu Mutabakat Motoru", "url": "https://excelarsiv.com/sablon/cari-ba-bs-toplu-mutabakat", "offers": {"@type": "Offer", "price": 499, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Product", "name": "Çek–Senet ve Vade Risk Sistemi", "url": "https://excelarsiv.com/sablon/cek-senet-ve-vade-risk-sistemi", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}]
    }
  ]
};
---

<CommerceLayout
  title="Mali Müşavir Cari Takip Excel Şablonu | Excel Arşiv"
  description="Mali müşavirler ve muhasebeciler için cari hesap, müşteri risk ve yaşlandırma Excel sistemi: Vadesi geçen alacakları ve riskleri hatasız yönetin."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-neutral-500 mb-4 font-mono" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Ana Sayfa</a> / <a href="/karar" class="hover:underline">Kararlar</a> / <span>mali-musavir-cari-takip-excel</span>
    </nav>

    <article>
      <header class="border-b border-neutral-200 pb-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
          Mali müşavir için cari takip Excel'i: Müşteri risk yönetimi
        </h1>
        <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 font-mono">
          <time datetime="2026-08-20">Son güncelleme: 2026-08-20</time>
          <span>·</span>
          <span>Excel Arşiv Finansal Denetim Masası</span>
