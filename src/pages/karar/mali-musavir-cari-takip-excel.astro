                <th class="p-3">Önerilen sistem</th>
                <th class="p-3">Fiyat</th>
                <th class="p-3">Neden</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 bg-white">
              <tr>
                <td class="p-3 font-medium text-neutral-900">Cari yaşlandırma ve risk puanı</td>
                <td class="p-3 font-semibold text-emerald-800">Cari Hesap. Tahsilat ve Müşteri Risk Takip Sistemi</td>
                <td class="p-3 font-mono text-neutral-700 whitespace-nowrap">799 TL</td>
                <td class="p-3 text-xs text-neutral-600">30-60-90 gün vade dilimlerine göre alacakları gruplar</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-neutral-900">Ba-Bs toplu mutabakat kontrolü</td>
                <td class="p-3 font-semibold text-emerald-800">Cari Ba-Bs Toplu Mutabakat</td>
                <td class="p-3 font-mono text-neutral-700 whitespace-nowrap">499 TL</td>
                <td class="p-3 text-xs text-neutral-600">GİB sınırlarına göre fatura adet ve tutar farkını bulur</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-neutral-900">Çek-senet portföy risk analizi</td>
                <td class="p-3 font-semibold text-emerald-800">Çek–Senet ve Vade Risk Sistemi</td>
                <td class="p-3 font-mono text-neutral-700 whitespace-nowrap">799 TL</td>
                <td class="p-3 text-xs text-neutral-600">Karşılıksız çek riskini ve banka teminatlarını takip eder</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      {/* BİRİNCİL ÖNERİ */}
