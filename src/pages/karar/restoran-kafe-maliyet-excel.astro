        { '@type': 'ListItem', 'position': 2, 'name': 'Kararlar', 'item': new URL('/karar', siteUrl).href },
        { '@type': 'ListItem', 'position': 3, 'name': "Restoran ve kafe reçete maliyeti hesaplama Excel'i", 'item': pageUrl }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      'mainEntity': [{"@type": "Question", "name": "Pişme ve ayıklama fireleri nasıl hesaplanır?", "acceptedAnswer": {"@type": "Answer", "text": "Hammadde bazında çiğ-pişmiş fire yüzdeleri girilerek net porsiyon maliyeti formüle edilir."}}, {"@type": "Question", "name": "Hammadde fiyat artışları menüye otomatik yansır mı?", "acceptedAnswer": {"@type": "Answer", "text": "Ana hammadde tablosundaki birim fiyat değiştiğinde tüm reçeteler anında güncellenir."}}, {"@type": "Question", "name": "İçecek ve bar reçeteleri destekleniyor mu?", "acceptedAnswer": {"@type": "Answer", "text": "Mililitre ve shot bazında kokteyl, kahve ve meşrubat reçeteleri mevcuttur."}}, {"@type": "Question", "name": "Menü mühendisliği (Stars, Puzzles) analizi var mı?", "acceptedAnswer": {"@type": "Answer", "text": "Satış adedi ve kâr marjı matrisiyle en çok kazandıran ürünler sınıflandırılır."}}, {"@type": "Question", "name": "KDV ve servis bedeli ayrıştırılıyor mu?", "acceptedAnswer": {"@type": "Answer", "text": "Mutfak KDV oranları ile yeme-içme satış KDV'si ayrı ayrı hesaplanır."}}]
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#itemlist`,
      'name': "Restoran ve kafe reçete maliyeti hesaplama Excel'i",
      'itemListElement': [{"@type": "ListItem", "position": 1, "item": {"@type": "Product", "name": "Restoran Reçete Maliyet ve Fire Sistemi", "url": "https://excelarsiv.com/sablon/restoran-recete-maliyet-fire", "offers": {"@type": "Offer", "price": 499, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Product", "name": "Mutfak Kayıp/Kaçak Tespiti & Menü Kârlılık Analizi", "url": "https://excelarsiv.com/sablon/mutfak-kayip-kacak-hesaplayici", "offers": {"@type": "Offer", "price": 999, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Product", "name": "Günlük Gelir–Gider ve Gerçek Kârlılık Sistemi", "url": "https://excelarsiv.com/sablon/gunluk-gelir-gider-ve-gercek-karlilik-sistemi", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}]
    }
  ]
};
---

<CommerceLayout
  title="Restoran Kafe Reçete Maliyet Excel | Excel Arşiv"
  description="Restoran, kafe ve mutfak işletmeleri için porsiyon reçete maliyeti, fire oranı ve menü kârlılık analizi sunan profesyonel Excel karar sistemi."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-neutral-500 mb-4 font-mono" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Ana Sayfa</a> / <a href="/karar" class="hover:underline">Kararlar</a> / <span>restoran-kafe-maliyet-excel</span>
    </nav>

    <article>
      <header class="border-b border-neutral-200 pb-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
          Restoran ve kafe reçete maliyeti hesaplama Excel'i
        </h1>
        <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 font-mono">
          <time datetime="2026-08-20">Son güncelleme: 2026-08-20</time>
          <span>·</span>
          <span>Excel Arşiv Finansal Denetim Masası</span>
        </div>
      </header>

      {/* CEVAP BLOĞU (40-60 KELİME) */}
