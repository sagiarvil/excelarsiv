    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      'mainEntity': [{"@type": "Question", "name": "Hangi SGK kanunları kapsama dahildir?", "acceptedAnswer": {"@type": "Answer", "text": "5510 (5 puanlık indirim), 6111 (genç/kadın istihdamı), 7103 ve engelli istihdam teşvikleri dahildir."}}, {"@type": "Question", "name": "Ortalama işçi sayısı şartı nasıl denetlenir?", "acceptedAnswer": {"@type": "Answer", "text": "İşe alım öncesi son 6 aylık ortalama personel sayısı girilerek ilave istihdam şartı kontrol edilir."}}, {"@type": "Question", "name": "Aylık prim kazancı nasıl hesaplanır?", "acceptedAnswer": {"@type": "Answer", "text": "Her personel için kanunlar ayrı ayrı çalıştırılarak en yüksek prim tasarrufu sağlayan kanun işaretlenir."}}, {"@type": "Question", "name": "Geçmişe dönük teşvik hesaplanabilir mi?", "acceptedAnswer": {"@type": "Answer", "text": "Geriye dönük dönemler için kaçırılan toplam teşvik tutarı simülasyonu yapılabilir."}}, {"@type": "Question", "name": "Bordro programlarıyla uyumlu mu?", "acceptedAnswer": {"@type": "Answer", "text": "Bordro çıktıları Excel'e aktarılarak teşvikli ve teşviksiz maliyet farkı tek tabloda görülür."}}]
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#itemlist`,
      'name': "SGK teşvik hesaplama Excel'i: Kaçırılan prim avantajı",
      'itemListElement': [{"@type": "ListItem", "position": 1, "item": {"@type": "Product", "name": "Kaçırılan SGK Teşvikleri ve Gerçek İşçilik Maliyeti Analizi", "url": "https://excelarsiv.com/sablon/kacirilan-sgk-tesvikleri-ve-gercek-iscilik-maliyeti-analizi", "offers": {"@type": "Offer", "price": 999, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Product", "name": "Teşvikli Bordro Optimizasyon", "url": "https://excelarsiv.com/sablon/tesvikli-bordro-optimizasyon", "offers": {"@type": "Offer", "price": 1499, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Product", "name": "Teşvikli Bordro ve En Avantajlı Teşvik Seçen", "url": "https://excelarsiv.com/sablon/tesvikli-bordro-avantajli-tesvik", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}]
    }
  ]
};
---

<CommerceLayout
  title="SGK Teşvik Hesaplama Excel Şablonu | Excel Arşiv"
  description="6111, 7103 ve 5510 sayılı SGK istihdam teşviklerini karşılaştırıp işletmeniz için en avantajlı prim desteğini seçen profesyonel optimizasyon Excel modeli."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-neutral-500 mb-4 font-mono" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Ana Sayfa</a> / <a href="/karar" class="hover:underline">Kararlar</a> / <span>sgk-tesvik-optimizasyon-excel</span>
    </nav>

    <article>
      <header class="border-b border-neutral-200 pb-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
          SGK teşvik hesaplama Excel'i: Kaçırılan prim avantajı
        </h1>
        <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 font-mono">
          <time datetime="2026-08-20">Son güncelleme: 2026-08-20</time>
          <span>·</span>
          <span>Excel Arşiv Finansal Denetim Masası</span>
        </div>
      </header>

      {/* CEVAP BLOĞU (40-60 KELİME) */}
