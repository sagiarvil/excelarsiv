---
import CommerceLayout from '../../layouts/CommerceLayout.astro';

const primarySlug = "stok-satis-ve-nakit-baglanma-sistemi";
const siteUrl = Astro.site ?? 'https://excelarsiv.com/';
const pageUrl = new URL('/karar/stok-devir-nakit-baglanma-excel', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Ana Sayfa', 'item': siteUrl },
        { '@type': 'ListItem', 'position': 2, 'name': 'Kararlar', 'item': new URL('/karar', siteUrl).href },
        { '@type': 'ListItem', 'position': 3, 'name': "Stok takip ve devir hızı Excel'i: Nakit bağlanma analizi", 'item': pageUrl }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      'mainEntity': [{"@type": "Question", "name": "Stok devir süresi (gün) nasıl hesaplanır?", "acceptedAnswer": {"@type": "Answer", "text": "Ortalama stok tutarı, satılan malın maliyetine bölünerek stokların kaç günde bir tükendiği bulunur."}}, {"@type": "Question", "name": "ABC analizi ne işe yarar?", "acceptedAnswer": {"@type": "Answer", "text": "Cironun %80'ini oluşturan A grubu ürünleri belirleyerek depoda nakit optimizasyonu sağlar."}}, {"@type": "Question", "name": "Kritik sipariş seviyesi uyarısı var mı?", "acceptedAnswer": {"@type": "Answer", "text": "Minimum emniyet stoku altına düşen ürünler için otomatik sipariş uyarısı üretilir."}}, {"@type": "Question", "name": "Stokta bağlı nakit finansman maliyeti hesaplanır mı?", "acceptedAnswer": {"@type": "Answer", "text": "Depoda yatan paranın kredi faiz veya fırsat maliyeti raporlanır."}}, {"@type": "Question", "name": "SKT ve bozulma riski olan ürünler için uygun mu?", "acceptedAnswer": {"@type": "Answer", "text": "Gıda ve hızlı tüketim malları için stok bekleme süreleri analiz edilebilir."}}]
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#itemlist`,
      'name': "Stok takip ve devir hızı Excel'i: Nakit bağlanma analizi",
      'itemListElement': [{"@type": "ListItem", "position": 1, "item": {"@type": "Product", "name": "Stok, Satış ve Nakit Bağlanma Sistemi", "url": "https://excelarsiv.com/sablon/stok-satis-ve-nakit-baglanma-sistemi", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 2, "item": {"@type": "Product", "name": "İthalat Depo Teslim (Rafa Gelen) Net Birim Maliyet", "url": "https://excelarsiv.com/sablon/ithalat-depo-teslim-rafa-gelen-net-birim-maliyet", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}, {"@type": "ListItem", "position": 3, "item": {"@type": "Product", "name": "trendyol-pazaryeri-net-kar-excel", "url": "https://excelarsiv.com/sablon/trendyol-pazaryeri-net-kar-excel", "offers": {"@type": "Offer", "price": 799, "priceCurrency": "TRY", "availability": "https://schema.org/InStock"}}}]
    }
  ]
};
---

<CommerceLayout
  title="Stok Takip ve Devir Hızı Excel | Excel Arşiv"
  description="Depodaki atıl stokları, stok devir süresini ve raflarda bağlanan nakit tutarını analiz eden profesyonel finansal stok yönetim Excel sistemi."
>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 py-12">
    <nav class="text-xs text-neutral-500 mb-4 font-mono" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Ana Sayfa</a> / <a href="/karar" class="hover:underline">Kararlar</a> / <span>stok-devir-nakit-baglanma-excel</span>
    </nav>

    <article>
      <header class="border-b border-neutral-200 pb-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 tracking-tight leading-tight">
          Stok takip ve devir hızı Excel'i: Nakit bağlanma analizi
        </h1>
        <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 font-mono">
          <time datetime="2026-08-20">Son güncelleme: 2026-08-20</time>
          <span>·</span>
          <span>Excel Arşiv Finansal Denetim Masası</span>
        </div>
      </header>

      {/* CEVAP BLOĞU (40-60 KELİME) */}
      <div class="p-5 bg-emerald-50 border-l-4 border-emerald-800 my-6">
        <p class="text-base text-emerald-950 font-medium leading-relaxed">
          Depodaki ürünlerin stok devir hızını, atıl kalan sermaye tutarını ve kritik sipariş seviyelerini denetlemek isteyen işletmeler için Stok, Satış ve Nakit Bağlanma Sistemi (799 TL, 15 sayfa) tasarlanmıştır. Raflarda bağlanan nakit maliyetini ve ABC ürün sınıflandırmasını kuruşu kuruşuna eksiksiz hesaplar.
        </p>
      </div>

      {/* KARAR TABLOSU */}
      <section class="my-8" aria-label="Karar Tablosu">
        <h2 class="text-xl font-bold text-neutral-900 mb-3">Kullanım Durumuna Göre Sistem Karşılaştırması</h2>
        <div class="overflow-x-auto border border-neutral-200">
          <table class="w-full text-left text-sm divide-y divide-neutral-200">
            <thead class="bg-neutral-100 text-xs font-mono uppercase text-neutral-700">
              <tr>
                <th class="p-3">Durumunuz</th>
                <th class="p-3">Önerilen sistem</th>
                <th class="p-3">Fiyat</th>
                <th class="p-3">Neden</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 bg-white">
              <tr>
                <td class="p-3 font-medium text-neutral-900">Stok devir hızı ve nakit bağlanma</td>
                <td class="p-3 font-semibold text-emerald-800">Stok. Satış ve Nakit Bağlanma Sistemi</td>
                <td class="p-3 font-mono text-neutral-700 whitespace-nowrap">799 TL</td>
                <td class="p-3 text-xs text-neutral-600">Raflarda atıl kalan sermayeyi ve devir gününü verir</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-neutral-900">İthalat depo teslim birim maliyet</td>
                <td class="p-3 font-semibold text-emerald-800">İthalat Birim Maliyet Hesaplayıcı</td>
                <td class="p-3 font-mono text-neutral-700 whitespace-nowrap">799 TL</td>
                <td class="p-3 text-xs text-neutral-600">Gümrük ve navlun masraflarını ürün maliyetine ekler</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-neutral-900">E-ticaret stok ve kâr takibi</td>
                <td class="p-3 font-semibold text-emerald-800">Trendyol Komisyon Sonrası Net Kâr</td>
                <td class="p-3 font-mono text-neutral-700 whitespace-nowrap">499 TL</td>
                <td class="p-3 text-xs text-neutral-600">Pazaryeri satışlarındaki ürün marjını denetler</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      {/* BİRİNCİL ÖNERİ */}
      <section class="my-8 border border-neutral-300 bg-neutral-50 p-6 sm:p-8" aria-label="Birincil Öneri">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">BİRİNCİL SİSTEM TAVSİYESİ</span>
        <h2 class="text-2xl font-bold text-neutral-900 mt-2">Stok. Satış ve Nakit Bağlanma Sistemi</h2>
        <p class="text-sm text-neutral-700 mt-3 leading-relaxed">
          Mevzuata ve sahaya tam uyumlu finansal karar sistemi.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-neutral-200">
          <div>
            <span class="text-2xl font-extrabold text-neutral-900 font-mono">799 TL</span>
            <span class="block text-xs text-neutral-500 font-mono">KDV dahil · tek ödeme</span>
          </div>
          <a
            href="/sablon/stok-satis-ve-nakit-baglanma-sistemi"
            class="bg-emerald-800 hover:bg-emerald-900 text-white font-semibold px-6 py-3 text-sm transition-colors"
          >
            Sistemi İnceleyin →
          </a>
        </div>
      </section>

      {/* ALTERNATİFLER */}
      <section class="my-8" aria-label="Alternatif Sistemler">
        <h2 class="text-xl font-bold text-neutral-900 mb-3">Alternatif Karar Seçenekleri</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="border border-neutral-200 p-5 bg-white">
            <h3 class="text-base font-bold text-neutral-900">
              <a href="/sablon/ithalat-depo-teslim-rafa-gelen-net-birim-maliyet" class="hover:text-emerald-800 hover:underline">İthalat Depo Teslim (Rafa Gelen) Net Birim Maliyet</a>
            </h3>
            <p class="text-xs text-neutral-600 mt-2 leading-relaxed">İthalat gümrük ve navlun masraflarını birim maliyete dağıtmak için İthalat Birim Maliyet modelini seçin.</p>
            <div class="mt-4 pt-3 border-t border-neutral-100 flex justify-between items-center text-xs">
              <span class="font-mono text-neutral-500">799 TL</span>
              <a href="/sablon/ithalat-depo-teslim-rafa-gelen-net-birim-maliyet" class="text-emerald-800 font-semibold hover:underline">Detaylar →</a>
            </div>
          </div>
          <div class="border border-neutral-200 p-5 bg-white">
            <h3 class="text-base font-bold text-neutral-900">
              <a href="/sablon/trendyol-pazaryeri-net-kar-excel" class="hover:text-emerald-800 hover:underline">trendyol-pazaryeri-net-kar-excel</a>
            </h3>
            <p class="text-xs text-neutral-600 mt-2 leading-relaxed">E-ticaret pazar yerlerindeki stok kârlılığını izlemek için Trendyol Net Kâr sistemini kullanın.</p>
            <div class="mt-4 pt-3 border-t border-neutral-100 flex justify-between items-center text-xs">
              <span class="font-mono text-neutral-500">799 TL</span>
              <a href="/sablon/trendyol-pazaryeri-net-kar-excel" class="text-emerald-800 font-semibold hover:underline">Detaylar →</a>
            </div>
          </div>
        </div>
      </section>

      {/* DÜRÜST SINIR BLOĞU: BU SİSTEMİ ALMAYIN EĞER... */}
      <section class="my-8 border-l-4 border-amber-600 bg-amber-50/50 p-6" aria-label="Dürüst Sınır">
        <h2 class="text-lg font-bold text-neutral-900 mb-3">Bu sistemi almayın eğer…</h2>
        <ul class="space-y-2 text-sm text-neutral-700">
          <li class="flex items-start gap-2">
            <span class="text-amber-700 font-bold">✕</span>
            <span>Depo raflarında el terminaliyle barkod okutan WMS yazılımı arıyorsanız.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-700 font-bold">✕</span>
            <span>Otomatik tedarikçi satın alma siparişi gönderen ERP modülü istiyorsanız.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-700 font-bold">✕</span>
            <span>Stok giriş-çıkış miktarlarını ve maliyetlerini Excel'e aktarmak istemiyorsanız.</span>
          </li>
        </ul>
      </section>

      {/* DETAYLI İÇERİK METNİ */}
      <section class="prose prose-neutral max-w-none my-8 text-sm sm:text-base leading-relaxed text-neutral-700 space-y-4">
        <h2 class="text-xl font-bold text-neutral-900">Karar Modelinin Metodolojisi ve Uygulama Alanları</h2>
        <p>Depoda atıl bekleyen her stok kalemi, işletmenin nakit kasasından çekilmiş ve raflara kilitlenmiş sermayedir. Stok devir hızının düşmesi depolama maliyetlerini artırırken şirketi likidite krizine sokar.</p>
        <p>Stok ve Nakit Bağlanma Sistemi, ürün bazında satış hızını ve stokta kalma gün süresini hesaplar. ABC analizi ile cironun yüzde seksenini oluşturan kritik ürünleri öne çıkarırken ölü stokları listeler.</p>
        <p>Optimum sipariş miktarı ve emniyet stoku seviyeleri formüle edilerek satın alma bütçesi doğru ürünlere tahsis edilir. Depoda bağlanan nakit finansman maliyeti aylık bazda raporlanır.</p>
        <p>Tedarikçi teslim süreleri ve sipariş karşılama performansları izlenerek yok satma riskleri ve fazla stok maliyetleri dengelenir.</p>
        <p>Stok finansman maliyeti aylık ticari kredi faiz oranları üzerinden simüle edilir. Depoda fazla ürün tutmanın şirkete maliyeti açıkça görülür.</p>
        <p>Ürün bazında brüt kâr marjı ile stok devir hızının çarpımından elde edilen GMROI (Brüt Kâr Yatırım Getirisi) metriği, hangi ürün grubunun şirket sermayesini en verimli şekilde katladığını ortaya koyar.</p>
        <p>Stok devir süresi uzayan ürünler için erken indirim ve tasfiye kampanyaları düzenlemek, depoda kilitli kalan nakdin kurtarılarak yüksek devirli kârlı ürünlere yatırılmasını sağlar. Şirketin likiditesi rahatlar.</p>
        <p>Tedarikçi bazında sipariş teslim süreleri ve gecikme oranları takip edilerek emniyet stoku seviyeleri optimize edilir. Depo kiralama ve finansman maliyetleri asgari düzeye indirilir.</p>
        <p>Depoda atıl bekleyen her stok kalemi, işletmenin nakit kasasından çekilmiş ve raflara kilitlenmiş sermayedir. Stok devir hızının düşmesi depolama maliyetlerini artırırken şirketi likidite krizine sokar. Stok ve Nakit Bağlanma Sistemi, ürün bazında satış hızını ve stokta kalma gün süresini hesaplar.</p>
        <p>ABC analizi ile cironun yüzde seksenini oluşturan kritik ürünleri öne çıkarırken ölü stokları listeler. Optimum sipariş miktarı ve emniyet stoku seviyeleri formüle edilerek satın alma bütçesi doğru ürünlere tahsis edilir. Depoda bağlanan nakit finansman maliyeti aylık bazda raporlanır.</p>
        <p>Tedarikçi teslim süreleri ve sipariş karşılama performansları izlenerek yok satma riskleri ve fazla stok maliyetleri dengelenir. Stok finansman maliyeti aylık ticari kredi faiz oranları üzerinden simüle edilir. Depoda fazla ürün tutmanın şirkete maliyeti açıkça görülür.</p>
        <p>Ürün bazında brüt kâr marjı ile stok devir hızının çarpımından elde edilen GMROI (Brüt Kâr Yatırım Getirisi) metriği, hangi ürün grubunun şirket sermayesini en verimli şekilde katladığını ortaya koyar.</p>
        <p>Stok devir süresi uzayan ürünler için erken indirim ve tasfiye kampanyaları düzenlemek, depoda kilitli kalan nakdin kurtarılarak yüksek devirli kârlı ürünlere yatırılmasını sağlar. Şirketin likiditesi rahatlar.</p>
        <p>Tedarikçi bazında sipariş teslim süreleri ve gecikme oranları takip edilerek emniyet stoku seviyeleri optimize edilir. Depo kiralama ve finansman maliyetleri asgari düzeye indirilir.</p>
      </section>

      {/* SSS */}
      <section class="my-8" aria-label="Sık Sorulan Sorular">
        <h2 class="text-xl font-bold text-neutral-900 mb-3">Sık Sorulan Sorular</h2>
        <div class="divide-y divide-neutral-200 border-y border-neutral-200">
          <details class="group py-4">
            <summary class="flex justify-between items-center font-bold text-neutral-900 cursor-pointer text-sm sm:text-base list-none">
              <span>Stok devir süresi (gün) nasıl hesaplanır?</span>
              <span class="text-emerald-800 group-open:rotate-45 transition-transform text-lg">+</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-600 leading-relaxed pr-6">
              Ortalama stok tutarı, satılan malın maliyetine bölünerek stokların kaç günde bir tükendiği bulunur.
            </p>
          </details>
          <details class="group py-4">
            <summary class="flex justify-between items-center font-bold text-neutral-900 cursor-pointer text-sm sm:text-base list-none">
              <span>ABC analizi ne işe yarar?</span>
              <span class="text-emerald-800 group-open:rotate-45 transition-transform text-lg">+</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-600 leading-relaxed pr-6">
              Cironun %80'ini oluşturan A grubu ürünleri belirleyerek depoda nakit optimizasyonu sağlar.
            </p>
          </details>
          <details class="group py-4">
            <summary class="flex justify-between items-center font-bold text-neutral-900 cursor-pointer text-sm sm:text-base list-none">
              <span>Kritik sipariş seviyesi uyarısı var mı?</span>
              <span class="text-emerald-800 group-open:rotate-45 transition-transform text-lg">+</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-600 leading-relaxed pr-6">
              Minimum emniyet stoku altına düşen ürünler için otomatik sipariş uyarısı üretilir.
            </p>
          </details>
          <details class="group py-4">
            <summary class="flex justify-between items-center font-bold text-neutral-900 cursor-pointer text-sm sm:text-base list-none">
              <span>Stokta bağlı nakit finansman maliyeti hesaplanır mı?</span>
              <span class="text-emerald-800 group-open:rotate-45 transition-transform text-lg">+</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-600 leading-relaxed pr-6">
              Depoda yatan paranın kredi faiz veya fırsat maliyeti raporlanır.
            </p>
          </details>
          <details class="group py-4">
            <summary class="flex justify-between items-center font-bold text-neutral-900 cursor-pointer text-sm sm:text-base list-none">
              <span>SKT ve bozulma riski olan ürünler için uygun mu?</span>
              <span class="text-emerald-800 group-open:rotate-45 transition-transform text-lg">+</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-600 leading-relaxed pr-6">
              Gıda ve hızlı tüketim malları için stok bekleme süreleri analiz edilebilir.
            </p>
          </details>
        </div>
      </section>

      {/* İLGİLİ KARARLAR */}
      <section class="my-8 bg-neutral-50 border border-neutral-200 p-6" aria-label="İlgili Kararlar">
        <h2 class="text-sm font-mono uppercase tracking-wider text-neutral-500 mb-3">İLGİLİ KARAR REHBERLERİ</h2>
        <div class="flex flex-wrap gap-3 text-xs">
          <a href="/karar/trendyol-pazaryeri-net-kar-excel" class="bg-white border border-neutral-300 px-3 py-2 text-neutral-800 hover:border-emerald-800 font-medium">
            /karar/trendyol-pazaryeri-net-kar-excel →
          </a>
          <a href="/karar/kobi-nakit-akisi-excel" class="bg-white border border-neutral-300 px-3 py-2 text-neutral-800 hover:border-emerald-800 font-medium">
            /karar/kobi-nakit-akisi-excel →
          </a>
          <a href="/karar/sube-karlilik-analizi-excel" class="bg-white border border-neutral-300 px-3 py-2 text-neutral-800 hover:border-emerald-800 font-medium">
            /karar/sube-karlilik-analizi-excel →
          </a>
        </div>
      </section>

      {/* KAPANIŞ CTA */}
      <footer class="my-10 text-center border-t border-neutral-200 pt-8">
        <h3 class="text-xl font-bold text-neutral-900 mb-2">Doğru Excel karar altyapısını hemen kurun.</h3>
        <p class="text-xs sm:text-sm text-neutral-600 mb-6">Açık formüllü, denetlenmiş ve kullanıma hazır sistemi anında indirin.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/sablon/stok-satis-ve-nakit-baglanma-sistemi"
            class="bg-emerald-800 hover:bg-emerald-900 text-white font-semibold px-8 py-3 text-sm transition-colors"
          >
            Stok, Satış ve Nakit Bağlanma Sistemi İncele →
          </a>
          <a
            href="/demo"
            class="border border-neutral-300 bg-white hover:bg-neutral-100 text-neutral-800 font-semibold px-8 py-3 text-sm transition-colors"
          >
            Ücretsiz Demo İndir
          </a>
        </div>
      </footer>
    </article>
  </main>
</CommerceLayout>
