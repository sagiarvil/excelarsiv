---
import CommerceLayout from '../../layouts/CommerceLayout.astro';

const title = 'ExcelArşiv vs ChatGPT vs Boş Excel | Hangisi Ne Zaman?';
const description = 'ExcelArşiv, ChatGPT ve boş Excel yaklaşımını kullanım amacı, tekrar edilebilirlik, özelleştirme ve karar desteği açısından tarafsız biçimde karşılaştırın.';
const pageUrl = new URL('/karsilastir/excelarsiv-vs-chatgpt-vs-bos-excel', Astro.site).href;
const comparisonRows = [
  ['Hazır iş akışı', 'Güçlü', 'Orta', 'Zayıf'],
  ['Tekrarlanabilir süreç', 'Güçlü', 'Orta', 'Kullanıcının kurduğu yapıya bağlı'],
  ['Serbest soru-cevap / fikir üretimi', 'Sınırlı', 'Güçlü', 'Sınırlı'],
  ['Tamamen özel model kurma', 'Sınırlı', 'Destekleyici', 'Güçlü'],
  ['Hazır girdi → çıktı disiplini', 'Güçlü', 'Prompt ve bağlama bağlı', 'Kullanıcının tasarımına bağlı'],
  ['Satın almadan önce gerçek ürün ekranı', 'Var', 'Uygulanmaz', 'Uygulanmaz'],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
};
---

<CommerceLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="compare-page">
    <p class="eyebrow">KARŞILAŞTIRMA</p>
    <h1>ExcelArşiv, ChatGPT ve boş Excel: hangi iş için hangisi doğru?</h1>
    <p class="lead">Üç yaklaşım birbirinin yerine geçmek zorunda değildir. Doğru seçim; işin tekrar sıklığına, ne kadar serbest analiz gerektiğine ve hazır bir karar akışına ihtiyaç olup olmadığına bağlıdır.</p>

    <section aria-labelledby="comparison-title">
      <h2 id="comparison-title">Kısa karşılaştırma</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Kriter</th><th>ExcelArşiv</th><th>ChatGPT</th><th>Boş Excel</th></tr></thead>
          <tbody>{comparisonRows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="cards" aria-label="Hangi durumda hangisi">
      <article>
        <h2>ExcelArşiv ne zaman daha uygundur?</h2>
        <p>Aynı finans, muhasebe, operasyon veya kontrol işini tekrar tekrar yürütüyor; girdi alanları, hesap akışı ve karar çıktıları önceden kurgulanmış bir Excel sistemi istiyorsanız.</p>
        <a href="/sablonlar">Excel sistemlerini inceleyin →</a>
      </article>
      <article>
        <h2>ChatGPT ne zaman daha uygundur?</h2>
        <p>Bir problemi keşfetmek, soru sormak, alternatif üretmek, metin veya ilk taslak hazırlamak ve sabit bir şablona bağlı kalmadan analiz yapmak istiyorsanız.</p>
      </article>
      <article>
        <h2>Boş Excel ne zaman daha uygundur?</h2>
        <p>İhtiyacınız çok basitse veya modeli, formülleri, kontrolleri ve raporlamayı tamamen kendiniz tasarlamak istiyorsanız boş çalışma kitabı en esnek başlangıçtır.</p>
      </article>
    </section>

    <section class="decision">
      <h2>Pratik seçim kuralı</h2>
      <p><strong>Keşif ve serbest düşünme:</strong> ChatGPT. <strong>Tam özel model:</strong> boş Excel. <strong>Tekrarlanan ve tanımlı bir iş akışını hazır sistemle yürütme:</strong> ExcelArşiv.</p>
      <p>ExcelArşiv’in iddiası “her durumda daha iyi” olmak değildir; belirli iş akışlarında kurulumu ve standardizasyon yükünü azaltan hazır dijital Excel sistemleri sunmaktır.</p>
    </section>
  </main>
</CommerceLayout>

<style>
  .compare-page{width:min(1060px,calc(100% - 40px));margin:auto;padding:64px 0 96px}.eyebrow{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.12em;color:var(--xl-green)}h1{max-width:900px;margin:10px 0 18px;font-family:var(--font-display);font-size:clamp(38px,6vw,66px);line-height:.98;letter-spacing:-.045em;color:var(--xl-ink-900)}.lead{max-width:790px;margin:0 0 54px;font-size:17px;line-height:1.7;color:#526158}.compare-page section{margin-top:48px}.compare-page h2{font-family:var(--font-display);font-size:clamp(24px,3vw,34px);letter-spacing:-.03em;color:var(--xl-ink-900)}.table-wrap{overflow-x:auto;border:1px solid var(--xl-grid);border-radius:16px;background:#fff}table{width:100%;border-collapse:collapse;min-width:720px}th,td{padding:15px 16px;border-bottom:1px solid var(--xl-grid);text-align:left;font-size:13px;line-height:1.45}th{background:#f5f8f6;font-size:11px;letter-spacing:.03em}tbody tr:last-child td{border-bottom:0}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.cards article,.decision{padding:24px;border:1px solid var(--xl-grid);border-radius:16px;background:#fff}.cards h2{margin:0 0 12px;font-size:22px}.cards p,.decision p{font-size:13px;line-height:1.7;color:#526158}.cards a{font-size:12px;font-weight:800;color:var(--xl-green);text-decoration:none}.decision{background:#f6f8f7}.decision h2{margin-top:0}@media(max-width:780px){.cards{grid-template-columns:1fr}.compare-page{padding-top:42px}}
</style>
