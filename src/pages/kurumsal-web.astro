  <!-- 3D Kinetic Background Canvas Script -->
  <script is:inline>
    (function initBgCanvas() {
      const canvas = document.getElementById('kw-hero-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let w, h;
      function resize() {
        w = canvas.width = window.innerWidth;
        h = canvas.height = canvas.parentElement ? canvas.parentElement.clientHeight : window.innerHeight;
      }
      window.addEventListener('resize', resize, { passive: true });
      resize();

      const dots = Array.from({ length: 45 }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
      }));

      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = 'rgba(56, 189, 248, 0.4)';
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.1)';

        for (let i = 0; i < dots.length; i++) {
          const d = dots[i];
          d.x += d.vx;
          d.y += d.vy;
          if (d.x < 0 || d.x > w) d.vx *= -1;
          if (d.y < 0 || d.y > h) d.vy *= -1;

          ctx.beginPath();
          ctx.arc(d.x, d.y, 2, 0, Math.PI * 2);
          ctx.fill();

          for (let j = i + 1; j < dots.length; j++) {
            const d2 = dots[j];
            const dist = Math.hypot(d.x - d2.x, d.y - d2.y);
            if (dist < 120) {
              ctx.beginPath();
              ctx.moveTo(d.x, d.y);
              ctx.lineTo(d2.x, d2.y);
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(draw);
      }
      draw();

      // Multi-Card 3D Gyroscope Tilt Physics across all Cards
      const cards = document.querySelectorAll('.kw-3d-card, .kw-step-card, .kw-bento-card, .kw-table-wrap');
      cards.forEach((c) => {
        c.addEventListener('mousemove', (e) => {
          const rect = c.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          c.style.transform = `perspective(1000px) rotateX(${-y * 0.06}deg) rotateY(${x * 0.06}deg) translateY(-8px) scale3d(1.03, 1.03, 1.03)`;
        });
        c.addEventListener('mouseleave', () => {
          c.style.transform = '';
        });
      });

      // Scroll Progress Laser Bar & Mouse Follower
      const laser = document.getElementById('kwScrollLaser');
      const follower = document.getElementById('kwMouseFollower');

      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (laser) laser.style.width = progress + '%';
      }, { passive: true });

      window.addEventListener('mousemove', (e) => {
        if (follower) {
          follower.style.left = e.clientX + 'px';
          follower.style.top = e.clientY + 'px';
        }
      }, { passive: true });
    })();
  </script>
