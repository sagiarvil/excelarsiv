  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html, body {
      background-color: #080B0F;
      color: #F1F5F9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    a {
      color: inherit;
      text-decoration: none;
      transition: all 0.25s ease;
    }
    .kw-container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 32px;
    }
    @media (max-width: 768px) {
      .kw-container { padding: 0 20px; }
    }

    /* Header Nav (Strict Single Line - No Wrap) */
    .kw-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      background: rgba(8, 11, 15, 0.94);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      height: 72px;
      display: flex;
      align-items: center;
      white-space: nowrap;
    }
    .kw-header__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 16px;
      flex-wrap: nowrap;
    }
    .kw-brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 16px;
      font-weight: 700;
      color: #F1F5F9;
      flex-shrink: 0;
      white-space: nowrap;
    }
    .kw-brand__badge {
      font-size: 9.5px;
      font-weight: 800;
      text-transform: uppercase;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: #38BDF8;
      padding: 3px 8px;
      border-radius: 4px;
      letter-spacing: 0.6px;
      white-space: nowrap;
    }
    .kw-nav {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-shrink: 1;
      white-space: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .kw-nav::-webkit-scrollbar {
      display: none;
    }
    .kw-nav a {
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.5px;
      color: #94A3B8;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .kw-nav a:hover {
      color: #F1F5F9;
    }
    .kw-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 22px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.6px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.25s ease;
      text-transform: uppercase;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .kw-btn--primary {
      background: #0284C7;
      color: #ffffff;
      border: 1px solid #38BDF8;
      box-shadow: 0 0 20px rgba(2, 132, 199, 0.35);
    }
    .kw-btn--primary:hover {
      background: #0369A1;
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(56, 189, 248, 0.5);
    }
    .kw-btn--ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #F1F5F9;
    }
    .kw-btn--ghost:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: #ffffff;
    }

    /* ==========================================================================
       HARDCORE KINETIC 3D MOTION & LASER SHOW SYSTEM
       ========================================================================== */
    .kw-scroll-laser {
      position: fixed;
      top: 0; left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, #38BDF8, #818CF8, #0284C7);
      box-shadow: 0 0 14px #38BDF8, 0 0 28px #818CF8;
      z-index: 9999;
      pointer-events: none;
      transition: width 0.1s linear;
    }
    .kw-mouse-follower {
      position: fixed;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.09) 0%, rgba(2, 132, 199, 0.03) 40%, transparent 70%);
      pointer-events: none;
      z-index: 999;
      transform: translate(-50%, -50%);
      mix-blend-mode: screen;
    }
    .kw-step-card,
    .kw-bento-card,
    .kw-3d-card {
      transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
      transform-style: preserve-3d;
      will-change: transform;
      position: relative;
    }
    .kw-step-card:hover,
    .kw-bento-card:hover,
    .kw-3d-card:hover {
      border-color: rgba(56, 189, 248, 0.6) !important;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(56, 189, 248, 0.25) !important;
    }
    .kw-step-card::after,
    .kw-bento-card::after {
      content: '';
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 60%;
      background: linear-gradient(180deg, transparent 0%, rgba(56, 189, 248, 0.12) 50%, rgba(255, 255, 255, 0.4) 95%, transparent 100%);
      pointer-events: none;
      z-index: 3;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .kw-step-card:hover::after,
    .kw-bento-card:hover::after {
      opacity: 1;
      animation: kwLaserSweep 1.2s infinite ease-in-out;
    }
    @keyframes kwLaserSweep {
      0% { top: -60%; }
      100% { top: 120%; }
    }

    /* Hero Section */
    .kw-hero {
      position: relative;
      min-height: 90vh;
      display: flex;
      align-items: center;
      padding: 120px 0 80px;
      background: radial-gradient(circle at 70% 30%, rgba(2, 132, 199, 0.18) 0%, rgba(8, 11, 15, 0.95) 60%);
      overflow: hidden;
    }
    .kw-hero__canvas {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.7;
    }
    .kw-hero__grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: center;
      position: relative;
      z-index: 2;
    }
    @media (max-width: 992px) {
      .kw-hero__grid {
        grid-template-columns: 1fr;
      }
    }
    .kw-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      color: #38BDF8;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.25);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 24px;
    }
    .kw-tag-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #38BDF8;
      box-shadow: 0 0 10px #38BDF8;
      animation: kwBlink 1.8s infinite;
    }
    @keyframes kwBlink {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(1.4); }
    }
    .kw-hero h1 {
      font-size: clamp(36px, 4.8vw, 62px);
      font-weight: 800;
      letter-spacing: -1.4px;
      line-height: 1.12;
      color: #ffffff;
      margin-bottom: 24px;
    }
    .kw-hero h1 span {
      background: linear-gradient(135deg, #38BDF8 0%, #0284C7 60%, #E05A2B 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .kw-hero__p {
      font-size: clamp(16px, 1.3vw, 18.5px);
      color: #94A3B8;
      line-height: 1.7;
      margin-bottom: 36px;
      max-width: 620px;
    }
    .kw-price-banner {
      display: inline-flex;
      align-items: baseline;
      gap: 12px;
      background: rgba(14, 18, 24, 0.9);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 16px 28px;
      border-radius: 12px;
      margin-bottom: 32px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    .kw-price-val {
      font-size: 38px;
      font-weight: 800;
      color: #F1F5F9;
      letter-spacing: -1px;
    }
    .kw-price-sub {
      font-size: 13px;
      color: #38BDF8;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .kw-hero__actions {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    /* 3D Kinetic Device / Tech Matrix Card */
    .kw-3d-card-wrap {
      perspective: 1200px;
      display: flex;
      justify-content: center;
    }
    .kw-3d-card {
      width: 100%;
      max-width: 440px;
      background: rgba(14, 18, 24, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 16px;
      padding: 32px 28px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7), 0 0 50px rgba(2, 132, 199, 0.18);
      transform: rotateY(-8deg) rotateX(5deg);
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
      position: relative;
    }
    .kw-3d-card:hover {
      transform: rotateY(0deg) rotateX(0deg) translateY(-6px);
      box-shadow: 0 40px 90px rgba(0, 0, 0, 0.85), 0 0 70px rgba(56, 189, 248, 0.3);
      border-color: rgba(56, 189, 248, 0.5);
    }
    .kw-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 14px;
      margin-bottom: 20px;
    }
    .kw-card-title {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.2px;
      color: #38BDF8;
      text-transform: uppercase;
      font-family: ui-monospace, SFMono-Regular, monospace;
    }
    .kw-card-status {
      font-size: 10px;
      color: #10B981;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 700;
    }
    .kw-checklist {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 24px;
    }
    .kw-checklist li {
      font-size: 13.5px;
      color: #CBD5E1;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      line-height: 1.5;
    }
    .kw-checklist li svg {
      color: #10B981;
      flex-shrink: 0;
      margin-top: 3px;
    }

    /* Section Global */
    .kw-section {
      padding: 100px 0;
      position: relative;
    }
    .kw-section--dark {
      background: #0B0E14;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .kw-sec-tag {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #38BDF8;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .kw-sec-h2 {
      font-size: clamp(28px, 3.4vw, 42px);
      font-weight: 800;
      letter-spacing: -0.8px;
      color: #F1F5F9;
      margin-bottom: 16px;
      line-height: 1.25;
    }
    .kw-sec-sub {
      font-size: 16px;
      color: #94A3B8;
      max-width: 680px;
      line-height: 1.65;
      margin-bottom: 50px;
    }

    /* Comparison Matrix */
    .kw-table-wrap {
      overflow-x: auto;
      background: #0E1218;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
    }
    .kw-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 14px;
    }
    .kw-table th {
      padding: 20px 24px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #94A3B8;
      background: #0A0D12;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .kw-table td {
      padding: 18px 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: #CBD5E1;
      line-height: 1.5;
    }
    .kw-table th.highlight,
    .kw-table td.highlight {
      background: rgba(2, 132, 199, 0.08);
      color: #F1F5F9;
      border-left: 1px solid rgba(56, 189, 248, 0.2);
      border-right: 1px solid rgba(56, 189, 248, 0.2);
    }

    /* 7-Day Roadmap */
    .kw-roadmap-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    @media (max-width: 992px) {
      .kw-roadmap-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .kw-roadmap-grid { grid-template-columns: 1fr; }
    }
    .kw-step-card {
      background: #0E1218;
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 10px;
      padding: 28px 22px;
      transition: all 0.3s ease;
    }
    .kw-step-card:hover {
      border-color: rgba(56, 189, 248, 0.4);
      transform: translateY(-4px);
    }
    .kw-step-num {
      font-size: 11px;
      font-weight: 800;
      color: #38BDF8;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .kw-step-title {
      font-size: 17px;
      font-weight: 700;
      color: #F1F5F9;
      margin-bottom: 10px;
    }
    .kw-step-desc {
      font-size: 13px;
      color: #94A3B8;
      line-height: 1.6;
    }

    /* Deliverables Bento */
    .kw-bento-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    @media (max-width: 900px) {
      .kw-bento-grid { grid-template-columns: 1fr; }
    }
    .kw-bento-card {
      background: #0E1218;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 32px 26px;
      transition: all 0.3s ease;
    }
    .kw-bento-card:hover {
      border-color: rgba(56, 189, 248, 0.4);
      transform: translateY(-4px);
    }
    .kw-bento-icon {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.3);
      color: #38BDF8;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .kw-bento-title {
      font-size: 18px;
      font-weight: 700;
      color: #F1F5F9;
      margin-bottom: 10px;
    }
    .kw-bento-desc {
      font-size: 13.5px;
      color: #94A3B8;
      line-height: 1.6;
    }

    /* CTA Bottom */
    .kw-cta-box {
      background: radial-gradient(circle at 50% 50%, rgba(2, 132, 199, 0.15) 0%, #0E1218 80%);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 16px;
      padding: 60px 36px;
      text-align: center;
      max-width: 820px;
      margin: 0 auto;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
    }
    .kw-cta-box h2 {
      font-size: clamp(26px, 3.4vw, 40px);
      font-weight: 800;
      letter-spacing: -0.6px;
      color: #ffffff;
      margin-bottom: 16px;
    }
    .kw-cta-box p {
      font-size: 16px;
      color: #94A3B8;
      max-width: 600px;
      margin: 0 auto 32px;
      line-height: 1.6;
    }

    /* Footer */
    .kw-footer {
      background: #06080B;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 40px 0;
      font-size: 13px;
      color: #64748B;
    }
    .kw-footer__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
    }
    .kw-footer__links {
      display: flex;
      gap: 20px;
    }
    .kw-footer__links a:hover { color: #F1F5F9; }
  </style>
</head>
<body>
  <!-- Laser Progress Bar & Mouse Follower -->
  <div class="kw-scroll-laser" id="kwScrollLaser" aria-hidden="true"></div>
  <div class="kw-mouse-follower" id="kwMouseFollower" aria-hidden="true"></div>

  <!-- Header -->
  <header class="kw-header">
    <div class="kw-container kw-header__inner">
      <a href="/kurumsal-web" class="kw-brand">
        <img src="/images/brand/excelarsiv-header-logo.png?v=20261011" alt="Excel Arşiv" width="28" height="28" style="object-fit: contain; border-radius: 6px;" />
        <span>EXCELARŞİV <span style="font-weight: 400; opacity: 0.8;">PRIME</span></span>
        <span class="kw-brand__badge">30.000 ₺</span>
      </a>

      <nav class="kw-nav">
        <a href="#karsilastirma">KARŞILAŞTIRMA</a>
        <a href="#teslimat">7 GÜNDE TESLİM</a>
        <a href="#kapsam">PAKET KAPSAMI</a>
        <a href="/finansal-web">FİNANSAL WEB</a>
      </nav>

      <a href="https://wa.me/905393333303?text=Merhaba%2C%20Standart%20Kurumsal%20Web%20Sitesi%20(30.000%20TL)%20paketi%20hakk%C4%B1nda%20g%C3%B6r%C3%BC%C5%9Fmek%20istiyorum." target="_blank" rel="noopener noreferrer" class="kw-btn kw-btn--primary">
        HEMEN BAŞLAT
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="kw-hero">
    <canvas id="kw-hero-canvas" class="kw-hero__canvas" aria-hidden="true"></canvas>

    <div class="kw-container">
      <div class="kw-hero__grid">
        <div>
          <div class="kw-tag">
