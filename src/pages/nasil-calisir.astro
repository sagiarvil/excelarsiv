---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';

const steps = [
  {
    step: '01',
    title: 'Ürünü Seçin & Sepetsiz Hızlı Başlayın',
    kicker: 'ANINDA SEÇİM',
    description: 'İhtiyacınıza uygun hazır karar sistemini belirleyin. Ürün sayfasında e-posta adresinizi girip "Satın Al — Shopier ile öde" düğmesine basarsınız. ExcelArşiv seçtiğiniz gerçek ürünü güvenli ödeme oturumuna bağlar.',
    badges: ['Sepet Bekletme Yok', '120+ Onaylı Karar Sistemi', 'Canlı Ekran Demoları'],
  },
  {
    step: '02',
    title: '256-Bit SSL ile Güvenli Ödeme & Doğrulama',
    kicker: 'SIFIR RİSK',
    description: 'Kart bilgileriniz asla ExcelArşiv sunucularında tutulmaz. BDDK lisanslı Shopier altyapısında 256-bit SSL güvencesiyle ödeme tamamlanır. Sistem anlık kriptografik sunucu doğrulaması yaparak siparişi onaylar.',
    badges: ['256-Bit SSL Şifreleme', 'Tüm Kartlara Taksit', 'Resmi E-Arşiv Fatura'],
  },
  {
    step: '03',
    title: '10 Saniyede Teslimat & E-posta Bildirimi',
    kicker: 'ANINDA ERİŞİM',
    description: 'Ödeme onaylandığı an tarayıcı ekranınızda "Excel\'i İndir" düğmesi açılır. Aynı anda e-posta adresinize kalıcı indirme bağlantısı ve lisans kaydı iletilir. Dosyanıza /teslimat adresinden dilediğiniz zaman erişebilirsiniz.',
    badges: ['10 Saniyede E-posta Teslimi', 'Kalıcı İndirme Linki', 'Ömür Boyu Sınırsız Kullanım'],
  },
  {
    step: '04',
    title: 'Sıfır Kurulum: Doğrudan Excel\'de Çalıştırın',
    kicker: 'EVRENSEL UYUM',
    description: 'Hiçbir ek program, eklenti, sürücü veya karmaşık kurulum gerekmez. Saf orijinal .xlsx dosyasını çift tıklayarak açın. Verinizi girin, hazır formüller ve yönetici kokpitiyle anında karar almaya başlayın.',
    badges: ['Windows & Mac Uyumlu', '%100 Açık Formül', 'Sıfır Makro Güvenliği'],
  },
];

const pillars = [
  {
    title: 'Müşteri',
    kicker: 'YALIN VE HIZLI',
    desc: 'Aylarca ERP ve yazılım entegrasyonu beklemek yerine; nakit, maliyet, bütçe veya stok kararlarınızı aynı gün netleştiren hazır finansal modeller.',
    icon: 'M',
    tag: 'Aynı Gün Başlangıç',
  },
  {
    title: 'Güven',
    kicker: 'ALTIN KALKAN',
    desc: '17 yıllık ticari bankacılık ve saha finans disiplini. %100 açık formül, sıfır makro, sıfır gizli kod. Verileriniz buluta gitmez, şirketinizde kalır.',
    icon: 'G',
    tag: 'Sıfır Veri Sızıntısı',
  },
  {
    title: 'Dağıtım',
    kicker: '10 SANİYEDE TESLİM',
    desc: 'Ödeme bittiği an ekranda ve e-postanızda. Sıfır kurulum, ömür boyu lisans. Her ay kartınızdan yinelenen abonelik ücreti çekilmez.',
    icon: 'D',
    tag: 'Sıfır Abonelik Tuzağı',
  },
  {
    title: 'Referans',
    kicker: '24 SEKTÖR KANITI',
    desc: 'Mali müşavirler, KOBİ\'ler ve finans direktörleri tarafından test edilmiş 120+ sistem. İnşaattan e-ticarete, kafeden üretime onaylı saha başarısı.',
    icon: 'R',
    tag: '500+ Aktif İşletme',
  },
  {
    title: 'Satış Kanalı',
    kicker: 'ESNEK ÖDEME',
    desc: 'Şirketinize ve ihtiyaçlarınıza göre özel fiyat teklifi, resmi e-arşiv fatura ve anında teslimat desteği.',
    icon: 'S',
    tag: 'Tüm Kartlara Taksit',
  },
];

const platforms = [
  { name: 'Microsoft Windows', versions: 'Excel 2016, 2019, 2021, M365', status: 'Tam Uyumlu' },
  { name: 'Apple macOS', versions: 'Excel for Mac 2019, 2021, M365', status: 'Tam Uyumlu' },
  { name: 'Apple iPad & Tablet', versions: 'Excel Mobile & Dokunmatik Arayüz', status: 'Tam Uyumlu' },
  { name: 'Web & Bulut', versions: 'Excel Online & Google E-Tablolar', status: 'Tam Uyumlu' },
];

const howToLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Ana Sayfa', 'item': 'https://excelarsiv.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Nasıl Çalışır', 'item': 'https://excelarsiv.com/nasil-calisir' }
      ]
    },
    {
      '@type': 'Article',
      'name': 'Excel Arşiv şablonu satın alma ve güvenli indirme',
      'headline': '10 Saniyede E-postanıza Teslim: Sıfır Kurulum, %100 Açık Formül, Anında Karar',
      'description': 'Excel şablonunu seçme, Shopier ile 256-bit SSL ödeme, 10 saniyede e-posta teslimatı ve sıfır kurulumla Excel\'de çalıştırma süreci.',
      'url': 'https://excelarsiv.com/nasil-calisir',
      'articleBody': steps.map((s, idx) => `${idx + 1}. ${s.title}: ${s.description}`).join('\n')
    }
  ]
});
---

<CommerceLayout
  title="Nasıl Çalışır? 10 Saniyede Teslimat | Excel Arşiv"
  description="Excel şablonunu seçme, Shopier ile 256-bit SSL ödeme, 10 saniyede e-posta teslimatı ve sıfır kurulumla Excel'de çalıştırma süreci."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={howToLd} />
  </Fragment>

  <main class="how-it-works-page">
    <section class="how-hero">
      <div class="wrap-shell">
        <SectionLabel address="A1" label="DAĞITIM & TESLİMAT SİSTEMİ" />
        <h1 class="how-title">10 Saniyede E-postanıza Teslim:<br /><em>Sıfır Kurulum, %100 Açık Formül, Anında Karar.</em></h1>
        <p class="how-lead">
          Ürünü seçersiniz, Shopier 256-bit SSL ile ödersiniz, 10 saniyede e-postanıza teslim edilir ve Excel'de çift tıklayıp anında çalıştırırsınız. Aylarca süren yazılım kurulumları yok; tek seferlik ödeme, ömür boyu sınırsız kullanım.
        </p>

        <div class="how-quick-badges" aria-label="Sistem Özellikleri">
          <span class="qbadge is-green">⚡ 10 Saniyede Teslimat</span>
          <span class="qbadge is-blue">🛡️ 256-Bit SSL Güvenli Ödeme</span>
          <span class="qbadge is-teal">✓ %100 Açık Formüller</span>
          <span class="qbadge is-amber">✕ Sıfır Makro / Sıfır Risk</span>
          <span class="qbadge is-violet">∞ Tek Seferlik Ödeme</span>
        </div>
      </div>
    </section>

    <!-- 4 Aşamalı İnfografik Akış Hattı (Pay'nkolay Tarzı Bento Pipeline) -->
    <section class="pipeline-section">
      <div class="wrap-shell">
        <div class="section-kicker-head">
          <span class="kicker-tag">ADIM ADIM TESLİMAT SÜRECİ</span>
          <h2>Satın almadan ilk yönetici raporunuza kadar 4 adımlı akış</h2>
          <p>Her aşama şeffaf, güvenli ve tamamen otomatik işler. Bekleme veya karmaşık onay süreçleri yoktur.</p>
        </div>

        <div class="pipeline-grid">
          {steps.map((item) => (
            <article class="pipeline-card">
              <div class="pipeline-card__header">
                <span class="pipeline-no">{item.step}</span>
                <span class="pipeline-kicker">{item.kicker}</span>
              </div>
              <h3>{item.title}</h3>
              <p class="pipeline-card__desc">{item.description}</p>
              <div class="pipeline-badges">
                {item.badges.map((b) => (
                  <span class="pbadge">{b}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 5 Temel Direk Bento Izgarası: Müşteri, Güven, Dağıtım, Referans, Satış Kanalı -->
    <section class="pillars-section">
      <div class="wrap-shell">
        <div class="section-kicker-head">
          <span class="kicker-tag">KURUMSAL TEMELLER</span>
          <h2>ExcelArşiv'i vazgeçilmez kılan 5 temel direk</h2>
          <p>Müşteri ihtiyacından güvenli satış kanalına kadar her detay işletme sahibinin huzuru için kurgulandı.</p>
        </div>

        <div class="pillars-bento">
          {pillars.map((p, index) => (
            <article class={`pillar-card pillar-${index + 1}`}>
              <div class="pillar-top">
                <span class="pillar-avatar">{p.icon}</span>
                <span class="pillar-badge">{p.tag}</span>
              </div>
              <small class="pillar-kicker">{p.kicker}</small>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Platform ve Cihaz Uyum Matrisi -->
    <section class="platforms-section">
      <div class="wrap-shell">
        <div class="platforms-card">
          <div class="platforms-header">
            <span class="kicker-tag">EVRENSEL ÇALIŞMA ORTAMI</span>
            <h2>Tüm cihazlarda sıfır ayarla sorunsuz çalışır</h2>
            <p>Windows, Mac veya iPad. Kurulum dosyası veya dll bağımlılığı yoktur; saf standart Excel (.xlsx) yapısıdır.</p>
          </div>
          <div class="platforms-grid">
            {platforms.map((plat) => (
              <div class="platform-item">
                <div class="platform-indicator">✓</div>
                <div>
                  <strong>{plat.name}</strong>
                  <span>{plat.versions}</span>
                </div>
                <span class="platform-status">{plat.status}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Satış Kanalı ve Taksit Seçenekleri -->
    <section class="payment-channels-section">
      <div class="wrap-shell">
        <div class="payment-box">
          <div class="payment-copy">
            <span class="kicker-tag">GÜVENLİ SATIŞ KANALI</span>
            <h2>Tüm kurumsal ve bireysel kartlara 12 taksit</h2>
            <p>
              Şirketinize özel teklif ve kurumsal e-arşiv fatura avantajı. Detaylı bilgi ve teklif için doğrudan WhatsApp uzman hattımızla iletişime geçebilirsiniz.
            </p>
            <div class="card-brands">
              <span>Axess</span>
              <span>Bonus</span>
              <span>World</span>
              <span>Maximum</span>
              <span>CardFinans</span>
              <span>Paraf</span>
            </div>
          </div>
          <div class="payment-trust-seal">
            <div class="seal-icon">🛡️</div>
            <strong>256-Bit SSL Koruması</strong>
            <span>BDDK Lisanslı Ödeme Ağ Geçidi</span>
            <small>Kredi kartı bilgileriniz kaydedilmez.</small>
          </div>
        </div>
      </div>
    </section>

    <!-- Soru & SSS Rehberi -->
    <section class="faq-helper-section">
      <div class="wrap-shell helper-grid">
        <div class="helper-box">
          <h3>51 Karar Sistemi İçin Detaylı Soru-Cevap Rehberi</h3>
          <p>Hangi ürünün hangi muhasebe, finans veya nakit akış sorununu çözdüğünü adım adım anlatan rehberimizi inceleyin.</p>
          <a href="/rehber/excel-sablonlari-sik-sorulan-sorular" class="btn-link">51 ürünün sık sorulan sorularını aç →</a>
        </div>
        <div class="helper-box is-cta">
          <h3>Aklınıza takılan bir soru mu var?</h3>
          <p>İhtiyacınızı ve tablonuzu WhatsApp üzerinden anlatın; 15 dakikada en uygun sistemi belirleyelim.</p>
          <a href="/sablonlar" class="btn-hero-primary">Şablonları İnceleyin →</a>
        </div>
      </div>
    </section>
  </main>
</CommerceLayout>

<style>
.how-it-works-page {
  padding-bottom: 96px;
  background: #ffffff;
  color: #0f172a;
}
.wrap-shell {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

/* HERO */
.how-hero {
  padding: 48px 0 40px;
  border-bottom: 1px solid #e2e8f0;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
}
.how-title {
  margin: 20px 0 16px;
  font-size: clamp(34px, 4.2vw, 54px);
  line-height: 1.06;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #0f172a;
}
.how-title em {
  font-style: normal;
  color: #059669;
}
.how-lead {
  max-width: 780px;
  margin: 0 0 28px;
  font-size: 18px;
  line-height: 1.65;
  color: #475569;
}
.how-quick-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.qbadge {
  display: inline-flex;
  align-items: center;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  border: 1px solid transparent;
}
.qbadge.is-green { background: #ecfdf5; color: #047857; border-color: #a7f3d0; }
.qbadge.is-blue { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
.qbadge.is-teal { background: #f0fdfa; color: #0f766e; border-color: #99f6e4; }
.qbadge.is-amber { background: #fffbeb; color: #b45309; border-color: #fde68a; }
.qbadge.is-violet { background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe; }

/* HEADERS */
.section-kicker-head {
  max-width: 760px;
  margin-bottom: 36px;
}
.kicker-tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #059669;
  margin-bottom: 8px;
}
.section-kicker-head h2 {
  margin: 0 0 10px;
  font-size: clamp(28px, 3.2vw, 40px);
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #0f172a;
}
.section-kicker-head p {
  margin: 0;
  font-size: 16px;
  line-height: 1.6;
  color: #64748b;
}

/* 4-ADIMLI PIPELINE GRID */
.pipeline-section {
  padding: 64px 0;
  border-bottom: 1px solid #f1f5f9;
}
.pipeline-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}
.pipeline-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 26px 22px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.pipeline-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(15, 23, 42, 0.08);
  border-color: #cbd5e1;
}
.pipeline-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}
.pipeline-no {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: #0f172a;
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
.pipeline-card:nth-child(2) .pipeline-no { background: #2563eb; }
.pipeline-card:nth-child(3) .pipeline-no { background: #059669; }
.pipeline-card:nth-child(4) .pipeline-no { background: #d97706; }

.pipeline-kicker {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #64748b;
  text-transform: uppercase;
}
.pipeline-card h3 {
  margin: 0 0 12px;
  font-size: 18px;
  line-height: 1.3;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.02em;
}
.pipeline-card__desc {
  flex-grow: 1;
  margin: 0 0 20px;
  font-size: 13.5px;
  line-height: 1.6;
  color: #475569;
}
.pipeline-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.pbadge {
  padding: 4px 9px;
  border-radius: 7px;
  background: #f1f5f9;
  color: #334155;
  font-size: 11px;
  font-weight: 700;
}

/* 5 TEMEL DİREK BENTO IZGARASI */
.pillars-section {
  padding: 64px 0;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}
.pillars-bento {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}
.pillar-card {
  padding: 26px 24px;
  border-radius: 20px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}
.pillar-card.pillar-4, .pillar-card.pillar-5 {
  grid-column: span 1;
}
@media (min-width: 1024px) {
  .pillar-card.pillar-1 { grid-column: span 2; }
  .pillar-card.pillar-2 { grid-column: span 1; }
  .pillar-card.pillar-3 { grid-column: span 1; }
  .pillar-card.pillar-4 { grid-column: span 1; }
  .pillar-card.pillar-5 { grid-column: span 1; }
}
.pillar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.pillar-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #e2e8f0;
  color: #0f172a;
  font-weight: 800;
  font-size: 14px;
}
.pillar-badge {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  background: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
}
.pillar-kicker {
  display: block;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #64748b;
  margin-bottom: 4px;
}
.pillar-card h3 {
  margin: 0 0 10px;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
}
.pillar-card p {
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
  color: #475569;
}

/* PLATFORMLAR */
.platforms-section {
  padding: 64px 0 0;
}
.platforms-card {
  padding: 36px;
  border-radius: 24px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
}
.platforms-header {
  margin-bottom: 28px;
}
.platforms-header h2 {
  margin: 0 0 8px;
  font-size: 26px;
  font-weight: 800;
  color: #0f172a;
}
.platforms-header p {
  margin: 0;
  font-size: 15px;
  color: #64748b;
}
.platforms-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
.platform-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #edf2f7;
}
.platform-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 999px;
  background: #ecfdf5;
  color: #059669;
  font-weight: 900;
}
.platform-item strong {
  display: block;
  font-size: 15px;
  color: #0f172a;
}
.platform-item span {
  display: block;
  font-size: 13px;
  color: #64748b;
}
.platform-status {
  margin-left: auto;
  font-size: 12px;
  font-weight: 700;
  color: #059669;
  background: #ffffff;
  padding: 4px 10px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
}

/* SATIŞ KANALI VE TAKSİTLER */
.payment-channels-section {
  padding: 64px 0 0;
}
.payment-box {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
  gap: 32px;
  align-items: center;
  padding: 36px;
  border-radius: 24px;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #ffffff;
}
.payment-copy .kicker-tag {
  color: #34d399;
}
.payment-copy h2 {
  margin: 0 0 12px;
  font-size: 28px;
  font-weight: 800;
  color: #ffffff;
}
.payment-copy p {
  margin: 0 0 22px;
  font-size: 15px;
  line-height: 1.6;
  color: #cbd5e1;
}
.card-brands {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.card-brands span {
  padding: 6px 14px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  border: 1px solid rgba(255, 255, 255, 0.2);
}
.payment-trust-seal {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 28px 20px;
