      margin-bottom: 16px;
    }
    .ea-hero__title {
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 800;
      color: var(--ea-navy);
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }
    .ea-hero__desc {
      font-size: clamp(15px, 2vw, 17px);
