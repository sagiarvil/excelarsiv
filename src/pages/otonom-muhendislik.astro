      border-bottom: 1px solid var(--ea-border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .ea-showcase-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 700;
      color: var(--ea-green);
      background: #ECFDF5;
      padding: 4px 10px;
      border-radius: 6px;
    }
    .ea-showcase-body {
      padding: 24px;
    }
    .ea-cockpit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 18px;
    }
    .ea-cockpit-item {
      border: 1px solid var(--ea-border);
      border-radius: 10px;
      padding: 16px;
      background: #FFFFFF;
    }
    .ea-cockpit-item h4 {
      font-size: 14px;
      font-weight: 700;
      color: var(--ea-navy);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ea-cockpit-item ul {
      list-style: none;
      font-size: 12.5px;
      color: var(--ea-sub);
      line-height: 1.6;
    }
    .ea-cockpit-item ul li {
      padding-left: 16px;
      position: relative;
      margin-bottom: 4px;
    }
    .ea-cockpit-item ul li::before {
      content: "•";
      position: absolute;
      left: 4px;
      color: var(--ea-blue);
      font-weight: bold;
    }

    /* Modules Grid (6 Modules) */
    .ea-modules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }
    .ea-module-card {
      background: #FFFFFF;
      border: 1px solid var(--ea-border);
      border-radius: 12px;
      padding: 22px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .ea-module-card:hover {
      border-color: var(--ea-blue);
      transform: translateY(-2px);
    }
    .ea-module-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .ea-module-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .ea-module-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--ea-navy);
    }
    .ea-module-desc {
      font-size: 13px;
      color: var(--ea-sub);
      line-height: 1.55;
      margin-bottom: 14px;
    }
    .ea-module-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .ea-module-pill {
      font-size: 11px;
      font-weight: 600;
      background: var(--ea-canvas);
      color: var(--ea-navy-light);
      padding: 3px 8px;
      border-radius: 5px;
      border: 1px solid var(--ea-border);
    }

    /* Comparison Table */
    .ea-table-wrap {
      overflow-x: auto;
      border: 1px solid var(--ea-border);
      border-radius: 12px;
      background: #FFFFFF;
      margin-bottom: 24px;
    }
    .ea-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    .ea-table th {
      background: var(--ea-canvas);
      padding: 14px 18px;
      font-weight: 700;
      color: var(--ea-navy);
      border-bottom: 1px solid var(--ea-border);
    }
    .ea-table td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--ea-border);
      color: var(--ea-sub);
    }
    .ea-table tr:last-child td {
      border-bottom: none;
    }
    .ea-table-badge-good {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #065F46;
      background: #D1FAE5;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 6px;
      font-size: 12px;
    }
    .ea-table-badge-bad {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #991B1B;
      background: #FEE2E2;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 6px;
      font-size: 12px;
    }

    /* Sector Grid */
    .ea-sectors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .ea-sector-card {
      background: #FFFFFF;
      border: 1px solid var(--ea-border);
      border-radius: 10px;
      padding: 18px;
    }
    .ea-sector-card h4 {
      font-size: 14px;
      font-weight: 700;
      color: var(--ea-navy);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ea-sector-card p {
      font-size: 12.5px;
      color: var(--ea-muted);
      line-height: 1.45;
    }

    /* Process Flow */
    .ea-flow-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    .ea-flow-step {
      background: var(--ea-canvas);
      border: 1px solid var(--ea-border);
      border-radius: 10px;
      padding: 20px;
      position: relative;
    }
    .ea-step-num {
      width: 28px;
      height: 28px;
      background: var(--ea-navy);
      color: #FFFFFF;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }
    .ea-flow-step h4 {
      font-size: 14px;
      font-weight: 700;
      color: var(--ea-navy);
      margin-bottom: 6px;
    }
    .ea-flow-step p {
      font-size: 12.5px;
      color: var(--ea-sub);
      line-height: 1.45;
    }

    /* FAQ Accordion */
    .ea-faq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .ea-faq-item {
      border: 1px solid var(--ea-border);
      border-radius: 10px;
      background: #FFFFFF;
      overflow: hidden;
    }
    .ea-faq-item summary {
      padding: 16px 20px;
      font-size: 14.5px;
      font-weight: 700;
      color: var(--ea-navy);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      user-select: none;
    }
    .ea-faq-item summary::-webkit-details-marker {
      display: none;
    }
    .ea-faq-item p {
      padding: 0 20px 18px;
      font-size: 13.5px;
      color: var(--ea-sub);
      line-height: 1.6;
    }

    /* CTA Banner */
    .ea-cta-banner {
      background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
      color: #FFFFFF;
      border-radius: 16px;
      padding: 40px 32px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin: 48px 0;
    }
    .ea-cta-content h3 {
      font-size: clamp(20px, 3vw, 26px);
      font-weight: 800;
      margin-bottom: 8px;
    }
    .ea-cta-content p {
      font-size: 14.5px;
      color: #CBD5E1;
      max-width: 620px;
      line-height: 1.5;
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      .ea-header__nav {
        display: none;
      }
      .ea-hero {
        padding: 32px 0 24px;
      }
      .ea-cta-banner {
        padding: 28px 20px;
      }
    }
  </style>
</head>
