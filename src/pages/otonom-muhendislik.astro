      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--ea-font);
      background-color: var(--ea-bg);
      color: var(--ea-text);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 80px;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .ea-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px;
    }

    /* Top Bar Header */
    .ea-header {
      border-bottom: 1px solid var(--ea-border);
      background: #FFFFFF;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .ea-header__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }
    .ea-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 17px;
      color: var(--ea-navy);
    }
    .ea-brand img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }
    .ea-header__nav {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ea-sub);
    }
    .ea-header__nav a:hover {
      color: var(--ea-blue);
    }
    .ea-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--ea-navy);
      color: #FFFFFF !important;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .ea-btn-primary:hover {
      background: var(--ea-navy-light);
      transform: translateY(-1px);
    }
    .ea-btn-whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #25D366;
      color: #FFFFFF !important;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .ea-btn-whatsapp:hover {
      background: #1EBE5B;
      transform: translateY(-1px);
    }
    .ea-btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--ea-border-strong);
      background: #FFFFFF;
      color: var(--ea-navy);
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .ea-btn-outline:hover {
      background: var(--ea-canvas);
      border-color: var(--ea-navy);
    }

    /* Hero Section */
    .ea-hero {
      padding: 48px 0 36px;
      background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
      border-bottom: 1px solid var(--ea-border);
    }
