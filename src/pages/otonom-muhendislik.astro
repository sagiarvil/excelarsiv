      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-top: 24px;
    }
    .ea-metric-card {
      background: #FFFFFF;
      border: 1px solid var(--ea-border);
      border-radius: 10px;
      padding: 16px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }
    .ea-metric-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .ea-metric-card h3 {
      font-size: 14px;
      font-weight: 700;
      color: var(--ea-navy);
      margin-bottom: 3px;
    }
    .ea-metric-card p {
      font-size: 12px;
      color: var(--ea-muted);
      line-height: 1.4;
    }

    /* Section Headers */
    .ea-section {
      padding: 56px 0;
      border-bottom: 1px solid var(--ea-border);
    }
    .ea-section-tag {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--ea-blue);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
    }
    .ea-section-title {
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 800;
      color: var(--ea-navy);
      letter-spacing: -0.015em;
      margin-bottom: 12px;
    }
    .ea-section-subtitle {
      font-size: 15px;
      color: var(--ea-sub);
      max-width: 820px;
      line-height: 1.6;
      margin-bottom: 32px;
    }

    /* Live Case Study / Architecture Showcase */
    .ea-showcase-box {
      background: #FFFFFF;
      border: 1px solid var(--ea-border-strong);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
      margin-bottom: 32px;
    }
    .ea-showcase-header {
      background: var(--ea-canvas);
