              <div class="panel"><div class="panel-title">Yaklaşan Tahsilatlar</div><div class="data-list"><div class="data-row"><span>ABC Ltd. Şti.</span><strong>₺ 120.000</strong><span>15 May</span></div><div class="data-row"><span>XYZ Ticaret</span><strong>₺ 85.000</strong><span>18 May</span></div><div class="data-row"><span>QRS A.Ş.</span><strong>₺ 75.000</strong><span>22 May</span></div></div></div>
              <div class="panel"><div class="panel-title">Kritik Uyarılar</div><div class="alert-list"><div class="alert-row"><i></i><span>Eksik hesap tanımı</span><strong>2</strong></div><div class="alert-row"><i></i><span>Vadesi yaklaşan ödeme</span><strong>3</strong></div><div class="alert-row"><i></i><span>Mutabakat bekleyen</span><strong>1</strong></div></div></div>
            </div>
          </div>
