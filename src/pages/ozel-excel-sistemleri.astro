    :root{color-scheme:light;--bg:#f8fbff;--surface:#fff;--surface-soft:#f7faff;--ink:#0b1f41;--ink-2:#2d4266;--muted:#66758f;--line:#dfe7f2;--line-2:#cbd7e8;--blue:#1168e8;--blue-2:#0d56bd;--blue-soft:#edf5ff;--green:#21a64a;--green-2:#168339;--green-soft:#effaf2;--cyan:#1a9bd7;--shadow:0 18px 50px rgba(26,55,101,.10);--shadow-sm:0 8px 24px rgba(26,55,101,.07);--radius:18px;--radius-lg:28px;--max:1420px}
    *{box-sizing:border-box}html{scroll-behavior:smooth;background:#fff}body{margin:0;background:#fff;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.wrap{width:min(var(--max),calc(100% - 64px));margin-inline:auto}.section{padding:78px 0}.section-soft{background:#f8fbff;border-block:1px solid #edf2f8}.eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;color:var(--blue);font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.eyebrow::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green)}.section-title{margin:0;max-width:800px;font-size:clamp(30px,3.4vw,48px);line-height:1.05;letter-spacing:-.045em}.section-copy{max-width:760px;margin:16px 0 0;color:var(--muted);font-size:16px;line-height:1.75}.btn{min-height:50px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 21px;border:1px solid transparent;border-radius:10px;font-size:14px;font-weight:800;transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease}.btn:hover{transform:translateY(-1px)}.btn-primary{background:linear-gradient(180deg,#31b957,#1e9d46);color:#fff;box-shadow:0 9px 20px rgba(33,166,74,.22)}.btn-primary:hover{background:linear-gradient(180deg,#28ad4e,#188a3d)}.btn-secondary{background:#fff;border-color:#bfd0e8;color:var(--ink)}.btn-secondary:hover{border-color:#86a6d3;box-shadow:var(--shadow-sm)}

    .site-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.96);backdrop-filter:blur(16px);border-bottom:1px solid #e6edf7}.nav-inner{height:70px;display:flex;align-items:center;gap:32px}.brand{display:flex;align-items:center;gap:11px;min-width:255px}.brand img{width:38px;height:38px;object-fit:contain}.brand-copy{display:flex;flex-direction:column;line-height:1.05}.brand-copy strong{font-size:19px;letter-spacing:.02em}.brand-copy small{margin-top:5px;color:#66758f;font-size:9px;font-weight:700;letter-spacing:.07em}.nav-links{display:flex;align-items:center;gap:28px;margin-inline:auto;font-size:12px;font-weight:700;color:#172f55}.nav-links a{position:relative;padding:26px 0}.nav-links a:first-child{color:var(--green)}.nav-links a:first-child::after{content:"";position:absolute;left:0;right:0;bottom:18px;height:2px;background:var(--green);border-radius:999px}.nav-actions{display:flex;align-items:center;gap:18px}.phone{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;white-space:nowrap}.phone svg{width:17px;height:17px;color:var(--green)}.nav-cta{min-height:42px;padding:0 18px;border-radius:7px;font-size:12px}.mobile-menu{display:none;position:relative}.mobile-menu summary{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);border-radius:10px;background:#fff;cursor:pointer;list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}.burger,.burger::before,.burger::after{display:block;width:18px;height:2px;border-radius:2px;background:#173257}.burger{position:relative}.burger::before,.burger::after{content:"";position:absolute;left:0}.burger::before{top:-6px}.burger::after{top:6px}.mobile-panel{position:absolute;right:0;top:50px;width:240px;padding:10px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow)}.mobile-panel a{display:block;padding:12px;border-radius:9px;font-size:13px;font-weight:700}.mobile-panel a:hover{background:var(--blue-soft)}

    .hero{position:relative;overflow:hidden;padding:42px 0 14px;background:linear-gradient(180deg,#fff 0%,#fbfdff 100%)}.hero::before{content:"";position:absolute;left:-160px;top:40px;width:520px;height:520px;background-image:radial-gradient(#76b6ff 1.4px,transparent 1.4px);background-size:14px 14px;opacity:.18;mask-image:linear-gradient(to right,#000,transparent 72%)}.hero::after{content:"";position:absolute;right:-280px;top:65px;width:720px;height:720px;border-radius:50%;border:1px solid #d6e8ff;box-shadow:0 0 0 90px rgba(226,240,255,.42),0 0 0 180px rgba(241,247,255,.8);opacity:.75}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,.93fr) minmax(580px,1.07fr);gap:52px;align-items:center}.hero-kicker{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid #cfe0f3;border-radius:999px;background:rgba(255,255,255,.88);color:#12345f;font-size:11px;font-weight:800;letter-spacing:.03em}.hero-kicker .shield{color:var(--green)}.hero h1{margin:22px 0 0;max-width:660px;font-size:clamp(44px,5vw,68px);line-height:1.02;letter-spacing:-.055em}.hero h1 span{display:block;margin-top:7px;color:var(--green)}.hero-copy{max-width:650px;margin:22px 0 0;color:#394e70;font-size:16px;line-height:1.72}.hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:25px}.micro-proof{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:30px;max-width:700px}.micro-item{padding:0 20px;border-left:1px solid #dfe7f2}.micro-item:first-child{padding-left:0;border-left:0}.micro-icon{width:30px;height:30px;color:var(--green);margin-bottom:9px}.micro-item b{display:block;font-size:13px;line-height:1.25}.micro-item span{display:block;margin-top:7px;color:var(--muted);font-size:10px;line-height:1.55}

    .product-shot{position:relative}.product-window{position:relative;overflow:hidden;border:1px solid #d7e0eb;border-radius:15px;background:#fff;box-shadow:0 22px 56px rgba(25,49,88,.14)}.product-top{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid #e7edf5;background:#fbfcfe}.product-brand{display:flex;align-items:center;gap:7px;font-size:9px;font-weight:800}.product-brand img{width:18px;height:18px}.period{padding:5px 9px;border:1px solid #dde5ef;border-radius:6px;background:#fff;color:#5c6d88;font-size:9px}.product-body{display:grid;grid-template-columns:92px 1fr;min-height:390px}.dash-side{padding:12px 9px;border-right:1px solid #e4eaf2;background:#f7f9fc}.dash-menu-title{padding:8px 7px 10px;color:#3b4d68;font-size:9px;font-weight:800}.dash-link{display:flex;align-items:center;gap:7px;padding:9px 8px;border-radius:6px;color:#445572;font-size:9px;font-weight:600}.dash-link.active{background:#eaf3ff;color:#0c5bc5}.dash-link svg{width:12px;height:12px}.dash-main{padding:12px;background:#f9fbfd}.dash-title{margin:0 0 11px;font-size:13px;font-weight:800}.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.kpi{padding:10px;border:1px solid #e3e9f1;border-radius:7px;background:#fff}.kpi small{display:block;color:#6f7f98;font-size:8px}.kpi strong{display:block;margin-top:4px;font-size:13px}.kpi em{display:block;margin-top:4px;color:var(--green);font-size:8px;font-style:normal;font-weight:800}.dash-panels{display:grid;grid-template-columns:1.15fr .85fr;gap:8px;margin-top:8px}.panel{min-height:142px;padding:10px;border:1px solid #e3e9f1;border-radius:7px;background:#fff}.panel-title{font-size:9px;font-weight:800}.bar-chart{height:94px;display:flex;align-items:flex-end;gap:8px;padding:15px 8px 5px;border-bottom:1px solid #e8edf4}.bar-chart i{flex:1;border-radius:2px 2px 0 0;background:linear-gradient(180deg,#1c75e8,#6ca9ef)}.bar-chart i:nth-child(1){height:44%}.bar-chart i:nth-child(2){height:6