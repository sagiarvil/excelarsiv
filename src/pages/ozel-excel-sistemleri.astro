              <div class="panel"><div class="panel-title">Gider Dağılımı</div><div class="donut-wrap"><div class="donut" aria-hidden="true"></div><div class="donut-list"><span><i style="background:var(--blue)"></i>Tedarik</span><span><i style="background:var(--green)"></i>Personel</span><span><i style="background:var(--amber)"></i>Kira</span><span><i style="background:var(--coral)"></i>Finansman</span><span><i style="background:var(--violet)"></i>Diğer</span></div></div></div>
            </div>
