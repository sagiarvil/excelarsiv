    .proof-strip{position:relative;z-index:3;margin-top:26px}.proof-shell{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #dfe7f2;border-radius:13px;background:#fff;box-shadow:0 8px 24px rgba(25,49,88,.05)}.proof-stat{display:flex;align-items:center;justify-content:center;gap:13px;min-height:72px;padding:10px 22px;border-left:1px solid #e2e8f0}.proof-stat:first-child{border-left:0}.proof-stat svg{width:26px;height:26px;color:var(--blue)}.proof-stat strong{display:block;font-size:24px;letter-spacing:-.04em}.proof-stat span{display:block;margin-top:2px;color:#61718a;font-size:10px}

