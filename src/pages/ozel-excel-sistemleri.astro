    .delivery-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:18px;align-items:stretch}.delivery-card,.fit-card{min-width:0;border-radius:20px;padding:28px}.delivery-card{border:1px solid var(--line);background:#fff}.fit-card{border:1px solid #cce7d6;background:linear-gradient(135deg,#edf9f2,#f8fff9)}.delivery-card h3,.fit-card h3{margin:0;font-size:27px;line-height:1.16;font-weight:700;letter-spacing:-.032em}.delivery-list{margin:20px 0 0;padding:0;list-style:none;display:grid;gap:0}.delivery-list li{position:relative;padding:12px 0 12px 27px;border-top:1px solid #e8edf1;font-size:16px;line-height:1.5}.delivery-list li:first-child{border-top:0}.delivery-list li::before{content:"✓";position:absolute;left:0;top:13px;width:18px;height:18px;display:grid;place-items:center;border-radius:50%;background:var(--green);color:#fff;font-size:11px;font-weight:800}.fit-card p{margin:14px 0 0;color:#456152;font-size:16px;line-height:1.55}.fit-card .btn{margin-top:22px}

    .faq-grid{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:54px;align-items:start}.faq-copy h2{margin:0;font-size:clamp(34px,3.6vw,46px);line-height:1.08;font-weight:720;letter-spacing:-.04em}.faq-copy p{margin:16px 0 0;color:var(--muted);font-size:17px;line-height:1.55}.faq-list{border-top:1px solid var(--line)}.faq-list details{border-bottom:1px solid var(--line)}.faq-list summary{position:relative;list-style:none;cursor:pointer;padding:20px 42px 20px 0;font-size:18px;line-height:1.35;font-weight:650}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary::after{content:"+";position:absolute;right:4px;top:17px;font-size:26px;line-height:1;color:var(--green);font-weight:350}.faq-list details[open] summary::after{content:"−"}.faq-list details p{margin:0;padding:0 42px 20px 0;color:var(--muted);font-size:16px;line-height:1.55}

