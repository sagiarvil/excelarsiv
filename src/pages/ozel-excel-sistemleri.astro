  <script is:inline>
    (function() {
      function initDynamicWorkbook() {
        var wb = document.querySelector('.workbook');
        if (!wb) return;
        var tabs = Array.prototype.slice.call(wb.querySelectorAll('.wb-tab'));
        var sheets = Array.prototype.slice.call(wb.querySelectorAll('.wb-sheet'));
        var badge = wb.querySelector('.wb-badge');
        var badgeLabels = ['● 13-Hafta Nakit Akışı', '● Banka Limit & Kredi Riski', '● Dinamik Birim Kârlılık', '● TTK 376 & Yönetim Kokpiti'];
        var badgeClasses = ['is-green', 'is-blue', 'is-amber', 'is-violet'];
        var currentIndex = 0;
        var timer = null;

        function switchTab(index) {
          currentIndex = index;
          tabs.forEach(function(tab, i) {
            if (i === index) {
              tab.classList.add('active');
              tab.setAttribute('aria-selected', 'true');
            } else {
              tab.classList.remove('active');
              tab.setAttribute('aria-selected', 'false');
            }
          });
          sheets.forEach(function(sheet, i) {
            if (i === index) {
              sheet.classList.add('active');
            } else {
              sheet.classList.remove('active');
            }
          });
          if (badge) {
            badge.textContent = badgeLabels[index];
            badge.className = 'wb-badge ' + badgeClasses[index];
          }
        }

        tabs.forEach(function(tab, i) {
          tab.addEventListener('click', function(e) {
            e.preventDefault();
            switchTab(i);
            restartTimer();
          });
        });

        function nextTab() {
          var next = (currentIndex + 1) % tabs.length;
          switchTab(next);
        }

        function startTimer() {
          stopTimer();
          timer = setInterval(nextTab, 4200);
        }

        function stopTimer() {
          if (timer) clearInterval(timer);
        }

        function restartTimer() {
          startTimer();
        }

        wb.addEventListener('mouseenter', stopTimer);
        wb.addEventListener('mouseleave', startTimer);

        switchTab(0);
        startTimer();
      }

      function initNavigation() {
        var menuBtn = document.getElementById('mobileMenuBtn');
        var closeBtn = document.getElementById('mobileMenuCloseBtn');
        var panel = document.getElementById('mobileMenuPanel');
        var backdrop = document.getElementById('mobileMenuBackdrop');

        if (!menuBtn || !panel || !backdrop) return;

        function openDrawer() {
          panel.classList.remove('translate-x-full', 'pointer-events-none');
          panel.classList.add('translate-x-0');
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          menuBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          panel.classList.remove('translate-x-0');
          panel.classList.add('translate-x-full', 'pointer-events-none');
          backdrop.classList.remove('opacity-100');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          menuBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        menuBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isOpen = panel.classList.contains('translate-x-0');
          if (isOpen) closeDrawer();
          else openDrawer();
        });

        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        backdrop.addEventListener('click', closeDrawer);

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') closeDrawer();
        });

        panel.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() {
            setTimeout(closeDrawer, 150);
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          initDynamicWorkbook();
          initNavigation();
        });
      } else {
        initDynamicWorkbook();
        initNavigation();
      }
    })();
  </script>
