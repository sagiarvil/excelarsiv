        "sameAs":[
          "https://www.wikidata.org/wiki/Q11589432",
          "https://drfin.com.tr",
          "https://skdmhesapla.com",
          "https://inversioncore.com"
        ]
      },
      {
        "@type":"WebPage",
        "@id":"https://excelarsiv.com/ozel-excel-sistemleri#webpage",
        "url":"https://excelarsiv.com/ozel-excel-sistemleri",
        "name":"İşletmeye Özel Excel Karar Sistemleri | ExcelArşiv",
        "description":"Hazır Excel dosyaları işinize uymuyorsa; nakit akışı, banka-kredi, maliyet, bütçe, fizibilite ve yönetim raporlaması için işletmenize özel Excel sistemi kuruyoruz.",
