    /* 05 SÜREÇ ADIMLARI (4 Kart) */
    .process-app-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
      margin-bottom:36px;
    }
    .process-card{
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      padding:16px;
      display:flex;
      flex-direction:column;
      box-shadow:0 2px 6px rgba(0,0,0,.02);
      transition:transform .15s ease,box-shadow .15s ease;
    }
    .process-card:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 18px rgba(0,0,0,.05);
      border-color:#cbd5e1;
    }
    .process-head{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:10px;
    }
    .process-icon-box{
      width:36px;
      height:36px;
      border-radius:8px;
      display:grid;
      place-items:center;
      font-size:18px;
      flex-shrink:0;
    }
    .process-head strong{
      font-size:14px;
      font-weight:750;
      color:#111827;
      line-height:1.25;
    }
    .process-card p{
      margin:0;
      font-size:12.5px;
      line-height:1.5;
      color:#64748b;
    }

    /* ==========================================================================
       İnteraktif Karar Kokpiti (.workbook)
       ========================================================================== */
    .workbook{
      border:1px solid #dce8e0;
      border-radius:16px;
      background:#fff;
      overflow:hidden;
      box-shadow:0 12px 32px rgba(15,23,42,.06);
      margin:28px 0 40px;
    }
    .wb-top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 14px;border-bottom:1px solid var(--line);background:#fafcfb}
    .wb-dots{display:flex;gap:5px}
    .wb-dot{width:9px;height:9px;border-radius:50%;background:#e2e8f0}
    .wb-dot.red{background:#f87171}.wb-dot.yellow{background:#fbbf24}.wb-dot.green{background:#34d399}
    .wb-title{display:flex;align-items:center;gap:6px;min-width:0;font-size:12.5px;font-weight:750;color:#1e293b}
    .wb-title img{width:16px;height:16px}
    .wb-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:750}
    .wb-badge.is-green{background:#ecfdf5;border:1px solid #a7f3d0;color:#047857}
    .wb-badge.is-blue{background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8}
    .wb-badge.is-amber{background:#fffbeb;border:1px solid #fde68a;color:#b45309}
    .wb-badge.is-violet{background:#f5f3ff;border:1px solid #ddd6fe;color:#6d28d9}

    .wb-tabs{display:flex;gap:4px;padding:6px 12px;background:#f8fafc;border-bottom:1px solid var(--line);overflow-x:auto}
    .wb-tab{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:none;background:transparent;border-radius:6px;font-size:12.5px;font-weight:600;color:#64748b;cursor:pointer;white-space:nowrap;transition:all .15s ease}
    .wb-tab:hover{color:#1e293b;background:#e2e8f0}
    .wb-tab.active{background:#ffffff;color:#0f172a;font-weight:750;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .tab-dot{width:6px;height:6px;border-radius:50%;background:#cbd5e1}
    .wb-tab.active .tab-dot{background:#107c41}

    .wb-sheet{display:none;padding:16px}
    .wb-sheet.active{display:block}
    .wb-fx-bar{display:flex;align-items:center;gap:8px;padding:6px 10px;background:#f1f5f9;border-radius:6px;border:1px solid #e2e8f0;margin-bottom:14px;font-family:ui-monospace,monospace;font-size:12px}
    .wb-fx-cell{font-weight:750;color:#1e293b;background:#e2e8f0;padding:2px 6px;border-radius:4px}
    .wb-fx-icon{font-style:italic;font-weight:800;color:#0284c7}
    .wb-fx-code{color:#334155;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

    .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:16px}
    .metric{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 12px}
    .metric small{display:block;font-size:11px;color:#64748b;font-weight:600}
    .metric strong{display:block;font-size:16px;color:#0f172a;font-weight:800;margin:3px 0}
    .metric span{font-size:11px;font-weight:700}
    .c-green{color:#059669}.c-blue{color:#2563eb}.c-amber{color:#d97706}.c-violet{color:#7c3aed}

    .wb-chart-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:12px;margin-bottom:16px}
    .panel{background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:12px}
    .panel-title{display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:750;color:#1e293b;margin-bottom:8px}
    .chart-legend{display:flex;gap:10px;font-size:10.5px;color:#64748b;margin-bottom:6px}
    .chart-legend span{display:flex;align-items:center;gap:4px}
    .chart-legend i{width:8px;height:8px;border-radius:2px;display:inline-block}

    .donut-wrap{display:flex;align-items:center;gap:14px;padding:6px 0}
    .donut-svg-box{position:relative;width:68px;height:68px;flex-shrink:0}
    .donut-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
    .donut-inner strong{font-size:11px;font-weight:800;color:#0f172a;line-height:1.1}
    .donut-inner small{font-size:8.5px;color:#64748b}
    .donut-list{display:grid;gap:4px;flex:1;font-size:11px}
    .donut-list span{display:flex;align-items:center;justify-content:space-between}
    .donut-list span span{display:flex;align-items:center;gap:5px;color:#475569}
    .donut-list i{width:6px;height:6px;border-radius:50%;display:inline-block}

    .wb-lists{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .data-list,.alert-list{display:grid;gap:6px}
    .data-row{display:flex;align-items:center;justify-content:space-between;font-size:11.5px;padding:4px 0;border-bottom:1px solid #f1f5f9}
    .data-row:last-child{border-bottom:none}
    .alert-row{display:flex;align-items:center;gap:8px;font-size:11.5px;padding:4px 0}
    .alert-row i{width:6px;height:6px;border-radius:50%;flex-shrink:0}
    .alert-row strong{margin-left:auto}

    .bank-bars-list{display:grid;gap:6px;padding:4px 0}
    .bank-bar-row{display:flex;align-items:center;gap:8px;font-size:11px}
    .bank-bar-row span{width:54px;color:#475569;font-weight:600}
    .bank-bar-track{flex:1;height:8px;background:#e2e8f0;border-radius:4px;overflow:hidden}
    .bank-bar-fill{height:100%;background:#2563eb;border-radius:4px}
    .bank-bar-row b{width:30px;text-align:right;color:#1e293b}

    /* ==========================================================================
       Ek Güvence, Karşılaştırma ve FAQ Bölümleri
       ========================================================================== */
    .section{padding:36px 0}
    .section-head{margin-bottom:24px}
    .section-kicker{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:6px}
    .section-head h2{margin:0 0 8px;font-size:24px;line-height:1.2;font-weight:750;letter-spacing:-.025em;color:#111827}
    .section-head p{margin:0;color:#555555;font-size:14.5px;line-height:1.55}

    .areas-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:28px}
    .area-card{padding:16px;border-radius:12px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm)}
    .area-card-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
    .area-icon-box{width:28px;height:28px;border-radius:6px;display:grid;place-items:center;font-size:14px;background:#edf9f2;color:var(--green-dark)}
    .area-card h3{margin:0;font-size:15px;line-height:1.3;font-weight:750;color:#222222}
    .area-card p{margin:0;font-size:13px;line-height:1.5;color:#555555}

    .comparison-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm);margin-bottom:28px}
    .comparison{min-width:600px;display:grid}
    .comparison-head,.comparison-row{display:grid;grid-template-columns:160px repeat(3,minmax(0,1fr));align-items:stretch}
    .comparison-head{background:var(--soft);border-bottom:1px solid var(--line);font-size:13px;font-weight:750;color:#222222}.comparison-head div{padding:12px 14px}
    .comparison-row{border-bottom:1px solid #edf1f5;font-size:13.5px;line-height:1.45}.comparison-row:last-child{border-bottom:none}
    .comparison-row div{padding:12px 14px;display:flex;align-items:center}.comparison-row [role="rowheader"]{font-weight:650;color:#222222;background:rgba(246,248,251,.5)}
    .comparison-row [data-label="Size özel sistem"]{background:var(--green-soft);font-weight:600;color:var(--green-dark)}

    .faq-list{display:grid;gap:8px;margin-bottom:32px}
    .faq-list details{border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden;padding:12px 16px;transition:background .15s ease}
    .faq-list details[open]{background:#fafbfc}
    .faq-list summary{font-size:14.5px;font-weight:700;color:#222222;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between}
    .faq-list summary::-webkit-details-marker{display:none}
    .faq-list summary::after{content:"+";font-size:16px;color:var(--muted);font-weight:400}
    .faq-list details[open] summary::after{content:"−"}
    .faq-list p{margin:8px 0 0;font-size:13.5px;line-height:1.55;color:#444444}

    /* Final CTA */
    .cta{padding:36px;border-radius:16px;background:linear-gradient(135deg,#0a4425 0%,#0f5f38 100%);color:#fff;margin-bottom:32px}
    .cta-shell{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:24px;align-items:center}
    .cta h2{margin:0 0 10px;font-size:24px;line-height:1.2;font-weight:750;color:#fff}
    .cta p{margin:0 0 14px;font-size:14.5px;line-height:1.55;color:#d1fae5}
    .cta-points{display:flex;flex-wrap:wrap;gap:6px}
    .cta-points span{padding:4px 10px;border-radius:6px;background:rgba(255,255,255,.12);font-size:12px;font-weight:600;color:#fff}
    .cta-actions{display:flex;flex-direction:column;gap:8px}
    .btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 18px;border:1px solid transparent;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none}
    .btn-primary{background:#fff;color:#064e29;box-shadow:0 6px 16px rgba(0,0,0,.1)}
    .btn-primary:hover{background:#f0fdf4}

    /* macOS Styled Footer */
    .appstore-footer{
      padding:24px 0 8px;
      border-top:1px solid #e5e5ea;
      font-size:12px;
      color:#86868b;
      display:flex;
      align-items:center;
      justify-content:space-between;
    }
    .appstore-footer a{color:#86868b;text-decoration:none;margin-left:14px}
    .appstore-footer a:hover{color:#1d1d1f}

    /* Responsive */
    @media(max-width:1100px){
      .appstore-hero-showcase{grid-template-columns:1fr;gap:24px}
      .how-it-works-rail{grid-template-columns:repeat(3,minmax(0,1fr))}
      .value-pillars-grid,.solutions-app-grid,.process-app-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .areas-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .cta-shell{grid-template-columns:1fr}
      .wb-chart-grid{grid-template-columns:1fr}
      .metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    @media(max-width:800px){
      .appstore-window{flex-direction:column;margin:0;border-radius:0;border:none}
      .appstore-sidebar{width:100%;border-right:none;border-bottom:1px solid #e5e5ea;padding:12px 14px}
      .appstore-canvas{padding:16px}
      .how-it-works-rail{grid-template-columns:1fr}
      .value-pillars-grid,.solutions-app-grid,.process-app-grid{grid-template-columns:1fr}
      .areas-grid{grid-template-columns:1fr}
      .step-connector{display:none}
      .appstore-hero-showcase{padding:24px 20px}
    }
  </style>
</head>

