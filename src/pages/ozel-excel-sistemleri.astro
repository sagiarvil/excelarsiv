  <style>
    :root{
      color-scheme:light;
      --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Helvetica Neue",Arial,sans-serif;
      font-size:17px;
      --ink:#1d1d1f;
      --ink-2:#333336;
      --muted:#86868b;
      --line:#e5e5ea;
      --paper:#ffffff;
      --soft:#f5f5f7;
      --appstore-bg:#f5f5f7;
      --green:#107c41;
      --green-dark:#0a5a2f;
      --green-soft:#eef8f3;
      --green-mid:#c7ebd5;
      --blue:#2f6fe4;
      --blue-soft:#eef4ff;
      --amber:#f59f1a;
      --amber-soft:#fff6e7;
      --coral:#ef5e5e;
      --coral-soft:#fff0f0;
      --violet:#7c4fe0;
      --violet-soft:#f5f0ff;
      --teal:#188d8d;
      --teal-soft:#eaf8f8;
      --shadow:0 20px 60px rgba(0,0,0,.08),0 1px 3px rgba(0,0,0,.04);
      --shadow-sm:0 4px 14px rgba(0,0,0,.04);
      --radius:18px;
      --radius-sm:10px;
    }

    *{box-sizing:border-box}
    html{font-size:16px;scroll-behavior:smooth;background:var(--appstore-bg)}
    body{margin:0;background:var(--appstore-bg);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.55;font-weight:400;letter-spacing:-.015em;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    img,svg{display:block;max-width:100%}
    button,input,select,textarea{font:inherit}
    p,h1,h2,h3{overflow-wrap:break-word}
    [id]{scroll-margin-top:72px}

    .skip-link{position:fixed;left:16px;top:12px;z-index:1000;transform:translateY(-160%);padding:8px 12px;border-radius:8px;background:var(--ink);color:#fff;font-size:13px;font-weight:650}.skip-link:focus{transform:none}
    a:focus-visible,summary:focus-visible{outline:3px solid rgba(0,113,227,.4);outline-offset:2px;border-radius:8px}

    /* ==========================================================================
       macOS App Store Window Container
       ========================================================================== */
    .appstore-window{
      max-width:1440px;
      margin:16px auto 32px;
      background:#ffffff;
      border-radius:18px;
      border:1px solid #e2e2e8;
      box-shadow:var(--shadow);
      display:flex;
      overflow:hidden;
      min-height:92vh;
    }

    /* Sol Sabit Kenar Çubuğu (macOS Sidebar) */
    .appstore-sidebar{
      width:240px;
      flex-shrink:0;
      background:#fbfbfd;
      border-right:1px solid #e5e5ea;
      padding:16px 14px 28px;
      display:flex;
      flex-direction:column;
    }

    /* Pencere Düğmeleri ● ● ● */
    .appstore-window-controls{
      display:flex;
      align-items:center;
      gap:8px;
      margin-bottom:20px;
      padding-left:4px;
    }
    .win-btn{
      width:12px;
      height:12px;
      border-radius:50%;
      display:inline-block;
    }
    .win-close{background:#ff5f56;border:1px solid #e0443e}
    .win-minimize{background:#ffbd2e;border:1px solid #dea123}
    .win-zoom{background:#27c93f;border:1px solid #1aab29}

    /* Logo & Marka */
    .appstore-brand{
      display:flex;
      align-items:center;
      gap:10px;
      padding:4px 6px 14px;
      text-decoration:none;
    }
    .appstore-logo-box{
      width:34px;
      height:34px;
      border-radius:8px;
      background:linear-gradient(135deg,#107c41 0%,#0a5a2f 100%);
      display:grid;
      place-items:center;
      color:#fff;
      font-weight:900;
      font-size:18px;
      box-shadow:0 3px 8px rgba(16,124,65,.25);
      flex-shrink:0;
    }
    .appstore-brand-text{
      font-size:17px;
      font-weight:750;
      letter-spacing:-.02em;
      color:#1d1d1f;
    }

    /* Arama Çubuğu */
    .appstore-search{
      position:relative;
      margin:2px 0 16px;
    }
    .appstore-search input{
      width:100%;
      height:32px;
      border-radius:8px;
      background:#ebebf0;
      border:none;
      padding:0 10px 0 30px;
      font-size:13px;
      color:#1d1d1f;
      outline:none;
      transition:background .15s ease,box-shadow .15s ease;
    }
    .appstore-search input:focus{
      background:#fff;
      box-shadow:0 0 0 2px rgba(0,113,227,.4);
    }
    .search-icon{
      position:absolute;
      left:9px;
      top:9px;
      color:#86868b;
      pointer-events:none;
    }

    /* Gezinti Menüsü */
    .appstore-nav{
      display:flex;
      flex-direction:column;
      gap:2px;
    }
    .appstore-nav-item{
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 10px;
      border-radius:8px;
      font-size:13.5px;
      font-weight:550;
      color:#1d1d1f;
      text-decoration:none;
      transition:background .15s ease,color .15s ease;
    }
    .appstore-nav-item svg{
      flex-shrink:0;
      color:#0071e3;
    }
    .appstore-nav-item:hover{
      background:#f0f0f4;
    }
    .appstore-nav-item.is-active{
      background:#e8f0fe;
      color:#0071e3;
      font-weight:650;
    }
    .appstore-nav-item.is-active svg{
      color:#0071e3;
    }

    /* Kategoriler Bölümü */
    .appstore-categories-header{
      font-size:11px;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.04em;
      color:#86868b;
      margin:22px 0 8px 10px;
    }
    .appstore-category-list{
      display:flex;
      flex-direction:column;
      gap:1px;
    }
    .appstore-cat-item{
      display:flex;
      align-items:center;
      gap:10px;
      padding:7px 10px;
      border-radius:8px;
      font-size:13px;
      font-weight:500;
      color:#333336;
      text-decoration:none;
      transition:background .15s ease,color .15s ease;
    }
    .appstore-cat-item:hover{
      background:#f0f0f4;
      color:#1d1d1f;
    }
    .cat-icon{
      font-size:14px;
      display:inline-grid;
      place-items:center;
      width:18px;
      height:18px;
    }

    /* ==========================================================================
       Sağ Ana İçerik Alanı (Canvas)
       ========================================================================== */
    .appstore-canvas{
      flex:1;
      min-width:0;
      background:#ffffff;
      padding:24px 32px 48px;
      overflow-y:auto;
    }

    /* 01 App Store Hero Showcase */
    .appstore-hero-showcase{
      border-radius:20px;
      background:linear-gradient(135deg,#f4f7f5 0%,#eaf1ec 100%);
      border:1px solid #dce8e0;
      padding:36px 40px;
      margin-bottom:32px;
      display:grid;
      grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);
      gap:32px;
      align-items:center;
      position:relative;
      overflow:hidden;
      box-shadow:0 10px 30px rgba(16,124,65,.05);
    }
    .appstore-hero-copy{
      min-width:0;
      z-index:2;
    }
    .appstore-hero-kicker{
      font-size:12px;
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:#107c41;
      display:inline-block;
      margin-bottom:10px;
    }
    .appstore-hero-copy h1{
      margin:0;
      font-size:clamp(28px,2.6vw,38px);
      line-height:1.16;
      font-weight:800;
      letter-spacing:-.03em;
      color:#111827;
      text-wrap:balance;
    }
    .appstore-hero-copy h1 em{
      font-style:normal;
      color:#107c41;
    }
    .appstore-hero-sub{
      margin:14px 0 24px;
      font-size:15.5px;
      line-height:1.55;
      color:#4b5563;
      max-width:480px;
    }
    .appstore-hero-actions{
      display:flex;
      align-items:center;
      gap:14px;
    }
    .appstore-hero-btn{
      background:#0f5132!important;
      color:#ffffff!important;
      border-radius:999px!important;
      padding:11px 26px!important;
      font-size:14.5px!important;
      font-weight:700!important;
      display:inline-flex!important;
      align-items:center!important;
      gap:6px!important;
      box-shadow:0 8px 20px rgba(15,81,50,.24)!important;
      transition:transform .18s ease,background .18s ease!important;
      text-decoration:none!important;
    }
    .appstore-hero-btn:hover{
      background:#0b3d25!important;
      transform:translateY(-1px);
    }
    .appstore-carousel-dots{
      display:flex;
      gap:6px;
      margin-top:20px;
    }
    .appstore-carousel-dots .dot{
      width:7px;
      height:7px;
      border-radius:50%;
      background:#cbd5e1;
    }
    .appstore-carousel-dots .dot.active{
      background:#107c41;
      width:18px;
      border-radius:4px;
    }

    /* Laptop & Canlı Kokpit Mockup */
    .appstore-hero-visual{
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      z-index:2;
    }
    .laptop-frame{
      width:100%;
      max-width:540px;
      background:#111827;
      border-radius:14px 14px 4px 4px;
      padding:10px 10px 0;
      box-shadow:0 24px 50px rgba(15,23,42,.18),0 4px 12px rgba(15,23,42,.08);
      position:relative;
    }
    .laptop-screen{
      background:#ffffff;
      border-radius:8px 8px 0 0;
      overflow:hidden;
      border:1px solid #1e293b;
    }
    .laptop-base{
      width:calc(100% + 40px);
      height:14px;
      background:linear-gradient(180deg,#e2e8f0 0%,#cbd5e1 100%);
      margin-left:-20px;
      border-radius:0 0 12px 12px;
      position:relative;
      box-shadow:0 8px 16px rgba(0,0,0,.15);
    }
    .laptop-base::after{
      content:"";
      position:absolute;
      left:50%;
      top:0;
      transform:translateX(-50%);
      width:60px;
      height:4px;
      background:#94a3b8;
      border-radius:0 0 4px 4px;
    }

    /* Canlı Mockup İçi */
    .cockpit-preview{
      font-size:11px;
      padding:10px 12px;
      background:#fafbfc;
    }
    .cockpit-nav-bar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      border-bottom:1px solid #e2e8f0;
      padding-bottom:8px;
      margin-bottom:8px;
    }
    .cockpit-logo-title{
      display:flex;
      align-items:center;
      gap:6px;
      font-weight:750;
      color:#1e293b;
      font-size:12px;
    }
    .cockpit-logo-title span.badge-sub{
      font-size:10px;
      font-weight:600;
      color:#107c41;
      background:#e8f5ed;
      padding:2px 6px;
      border-radius:4px;
    }

    .cockpit-kpi-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:6px;
      margin-bottom:8px;
    }
    .kpi-card{
      background:#ffffff;
      border:1px solid #e2e8f0;
      border-radius:6px;
      padding:6px 8px;
    }
    .kpi-card small{display:block;color:#64748b;font-size:9.5px;font-weight:600}
    .kpi-card strong{display:block;color:#0f172a;font-size:13px;font-weight:800;margin:2px 0}
    .kpi-card span{font-size:9.5px;font-weight:700}
    .kpi-up{color:#107c41}
    .kpi-warn{color:#ea580c}

    .cockpit-charts-row{
      display:grid;
      grid-template-columns:minmax(0,1.3fr) minmax(0,.9fr);
      gap:8px;
      margin-bottom:8px;
    }
    .cockpit-chart-box{
      background:#ffffff;
      border:1px solid #e2e8f0;
      border-radius:6px;
      padding:6px 8px;
    }
    .chart-box-title{
      font-size:10px;
      font-weight:750;
      color:#334155;
      margin-bottom:4px;
      display:flex;
      justify-content:space-between;
    }

    .floating-excel-cube{
      position:absolute;
      right:-20px;
      bottom:-10px;
      width:52px;
      height:52px;
      border-radius:12px;
      background:linear-gradient(135deg,#107c41 0%,#064e29 100%);
      box-shadow:0 12px 28px rgba(16,124,65,.35);
      display:grid;
      place-items:center;
      color:#ffffff;
      font-size:26px;
      font-weight:900;
      z-index:10;
      border:2px solid rgba(255,255,255,.4);
    }

    /* ==========================================================================
       Bölüm Başlıkları (App Store Standardı)
       ========================================================================== */
    .appstore-section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin:36px 0 16px;
      padding-bottom:6px;
      border-bottom:1px solid #f0f0f4;
    }
    .appstore-section-head h2{
      margin:0;
      font-size:20px;
      font-weight:750;
      letter-spacing:-.02em;
      color:#111827;
      display:flex;
      align-items:center;
      gap:6px;
    }
    .head-arrow{
      color:#86868b;
      font-weight:500;
    }

    /* 02 NASIL ÇALIŞIR? (5 Adım Bağlantılı Ray) */
    .how-it-works-rail{
      display:grid;
      grid-template-columns:repeat(5,minmax(0,1fr));
      gap:10px;
      align-items:stretch;
      margin-bottom:36px;
    }
    .step-card{
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      padding:16px 14px;
      position:relative;
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      box-shadow:0 2px 6px rgba(0,0,0,.02);
      transition:transform .15s ease,box-shadow .15s ease;
    }
    .step-card:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 18px rgba(0,0,0,.05);
      border-color:#cbd5e1;
    }
    .step-badge{
      width:22px;
      height:22px;
      border-radius:50%;
      background:#e0f2fe;
      color:#0284c7;
      font-size:11px;
      font-weight:800;
      display:grid;
      place-items:center;
      margin-bottom:10px;
    }
    .step-icon{
      font-size:24px;
      margin-bottom:8px;
    }
    .step-card strong{
      display:block;
      font-size:14.5px;
      font-weight:750;
      color:#111827;
      margin-bottom:6px;
    }
    .step-card p{
      margin:0;
      font-size:12.5px;
      line-height:1.45;
      color:#64748b;
    }
    .step-connector{
      position:absolute;
      right:-8px;
      top:50%;
      transform:translateY(-50%);
      color:#94a3b8;
      font-size:14px;
      z-index:2;
      pointer-events:none;
    }

    /* 03 İŞLETMENİZE DEĞER KATANLAR (4 Kart) */
    .value-pillars-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
      margin-bottom:36px;
    }
    .value-card{
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      padding:18px 16px;
      display:flex;
      align-items:flex-start;
      gap:14px;
      box-shadow:0 2px 6px rgba(0,0,0,.02);
      transition:transform .15s ease,box-shadow .15s ease;
    }
    .value-card:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 20px rgba(0,0,0,.05);
      border-color:#cbd5e1;
    }
    .value-icon-box{
      width:44px;
      height:44px;
      border-radius:10px;
      display:grid;
      place-items:center;
      font-size:22px;
      flex-shrink:0;
    }
    .value-icon-box.is-green{background:#dcfce7;color:#166534}
    .value-icon-box.is-blue{background:#dbeafe;color:#1e40af}
    .value-icon-box.is-purple{background:#f3e8ff;color:#6b21a8}
    .value-icon-box.is-orange{background:#ffedd5;color:#9a3412}
    .value-card-body strong{
      display:block;
      font-size:14.5px;
      font-weight:750;
      color:#111827;
      margin-bottom:4px;
    }
    .value-card-body p{
      margin:0;
      font-size:12.5px;
      line-height:1.5;
      color:#64748b;
    }

    /* 04 SİZE ÖZEL ÇÖZÜMLER (4 App Store Kartı) */
    .solutions-app-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:14px;
      margin-bottom:36px;
    }
    .appstore-product-card{
      background:#ffffff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      padding:16px;
      display:flex;
      flex-direction:column;
      box-shadow:0 2px 6px rgba(0,0,0,.02);
      transition:transform .15s ease,box-shadow .15s ease;
    }
    .appstore-product-card:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 20px rgba(0,0,0,.06);
      border-color:#cbd5e1;
    }
    .app-card-top{
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:12px;
    }
    .app-icon{
      width:42px;
      height:42px;
      border-radius:10px;
      display:grid;
      place-items:center;
      font-size:22px;
      flex-shrink:0;
    }
    .app-icon.is-green{background:#107c41;color:#fff}
    .app-icon.is-blue{background:#2563eb;color:#fff}
    .app-icon.is-orange{background:#ea580c;color:#fff}
    .app-icon.is-teal{background:#0d9488;color:#fff}

    .app-meta strong{
      display:block;
      font-size:14px;
      font-weight:750;
      color:#111827;
      line-height:1.25;
    }
    .app-desc{
      font-size:12.5px;
      line-height:1.45;
      color:#64748b;
      margin:0 0 14px;
      flex-grow:1;
    }
    .appstore-pill-btn{
      align-self:flex-start;
      padding:6px 14px;
