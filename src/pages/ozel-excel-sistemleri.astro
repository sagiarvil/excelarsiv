---
// Source-owned /ozel-excel-sistemleri landing page.
import '../styles/global.css';
import '../styles/appstore-theme.css';
import AppStoreSidebar from '../components/appstore/AppStoreSidebar.astro';
import ProcessFlowCards from '../components/automation/ProcessFlowCards.astro';
import N8nWorkflowVisualizer from '../components/automation/N8nWorkflowVisualizer.astro';
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>İşletmeye Özel Excel Karar Sistemleri | ExcelArşiv</title>
  <meta name="description" content="Hazır Excel dosyaları işinize uymuyorsa; nakit akışı, banka-kredi, maliyet, bütçe, fizibilite ve yönetim raporlaması için işletmenize özel Excel sistemi kuruyoruz." />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="https://excelarsiv.com/ozel-excel-sistemleri" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://excelarsiv.com/ozel-excel-sistemleri" />
  <meta property="og:title" content="İşletmeye Özel Excel Karar Sistemleri | ExcelArşiv" />
  <meta property="og:description" content="İşinizi hazır bir dosyaya uydurmak yerine, Excel'i mevcut çalışma düzeninize ve gerçek karar ihtiyacınıza göre kuruyoruz." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="alternate" type="text/markdown" href="https://excelarsiv.com/llms/pages/ozel-excel-sistemleri.md" title="LLM & Agent Grounding Content (Markdown)" />

