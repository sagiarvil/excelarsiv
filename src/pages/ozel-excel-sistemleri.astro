  <style>
    :root{
      color-scheme:light;
      --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Helvetica Neue",Arial,sans-serif;
      --ink:#172033;
      --ink-2:#273246;
      --muted:#647084;
      --line:#dce3ea;
      --paper:#ffffff;
      --soft:#f6f8fb;
      --green:#16834d;
      --green-dark:#0e6a3c;
      --green-soft:#edf9f2;
      --green-mid:#d9f1e3;
      --blue:#2f6fe4;
      --blue-soft:#eef4ff;
      --amber:#f59f1a;
      --amber-soft:#fff6e7;
      --coral:#ef5e5e;
      --coral-soft:#fff0f0;
      --violet:#7c4fe0;
      --violet-soft:#f5f0ff;
      --teal:#188d8d;
      --teal-soft:#eaf8f8;
      --shadow:0 18px 52px rgba(31,55,80,.10);
      --shadow-sm:0 10px 26px rgba(31,55,80,.08);
      --radius:24px;
      --radius-sm:16px;
      --content:1160px;
      --wide:1320px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--paper)}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.47059;font-weight:400;letter-spacing:-.022em;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    img,svg{display:block;max-width:100%}
    button,input,select,textarea{font:inherit}
    p,h1,h2,h3{overflow-wrap:break-word}
    [id]{scroll-margin-top:82px}

    .skip-link{position:fixed;left:16px;top:12px;z-index:1000;transform:translateY(-160%);padding:10px 14px;border-radius:10px;background:var(--ink);color:#fff;font-size:14px;font-weight:650}.skip-link:focus{transform:none}
    a:focus-visible,summary:focus-visible{outline:3px solid rgba(47,111,228,.32);outline-offset:3px;border-radius:9px}
    .wrap{width:min(var(--content),calc(100% - 48px));margin-inline:auto}.wrap-wide{width:min(var(--wide),calc(100% - 48px));margin-inline:auto}

    .site-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.96);border-bottom:1px solid #dfe6e2;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
    .nav-inner{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px;min-width:0}
    .brand{display:inline-flex;align-items:center;gap:10px;min-width:0;flex-shrink:0;text-decoration:none}
    .brand img{width:38px;height:38px;border-radius:8px;flex-shrink:0}
    .brand-copy{display:flex;flex-direction:column;line-height:1.15}
    .brand-copy strong{font-size:18px;line-height:1.1;font-weight:800;letter-spacing:-.015em;color:#14271d;white-space:nowrap}
    .brand-copy small{font-size:10px;font-weight:600;letter-spacing:.02em;color:#64748b;white-space:nowrap;margin-top:2px}
    .nav-links{display:flex;align-items:center;gap:4px;margin-inline:auto;min-width:0}
    .nav-links a{padding:8px 12px;border-radius:9px;font-size:13.5px;line-height:1.25;font-weight:600;color:#374740;text-decoration:none;transition:color 150ms ease,background 150ms ease;white-space:nowrap;letter-spacing:-.01em}
    .nav-links a:hover{color:#0b7440;background:#eef7f2}
    .nav-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .nav-cta{display:inline-flex;align-items:center;justify-content:center;height:42px;padding-inline:16px;border-radius:11px;background:#0b7440;color:#ffffff!important;font-size:13px;font-weight:750;text-decoration:none;box-shadow:0 8px 20px rgba(11,116,64,.14);transition:background 150ms ease,transform 150ms ease;white-space:nowrap}
    .nav-cta:hover{background:#075f34;transform:translateY(-1px)}
    .mobile-menu{display:none;position:relative}
    .mobile-menu summary{width:40px;height:40px;display:grid;place-content:center;gap:4px;border:1px solid #dfe6e2;border-radius:12px;background:#fff;cursor:pointer;list-style:none;box-shadow:0 4px 14px rgba(15,23,42,.05)}
    .mobile-menu summary::-webkit-details-marker{display:none}
    .mobile-menu summary span{display:block;width:17px;height:1.8px;background:#14271d;border-radius:2px}
    .mobile-menu[open]::before{content:"";position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:150;pointer-events:auto}
    .mobile-panel{position:fixed;top:68px;left:12px;right:12px;max-height:calc(100dvh - 90px);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:12px;border:1px solid #dce5df;border-radius:22px;background:#ffffff;box-shadow:0 26px 70px rgba(15,23,42,.28);z-index:160}
    .mobile-panel-head{padding:8px 8px 12px;border-bottom:1px solid #edf2ee}
    .mobile-panel-head strong{display:block;color:#0f172a;font-size:16px;line-height:1.2;font-weight:800}
    .mobile-panel-head span{display:block;margin-top:4px;color:#64748b;font-size:12px;line-height:1.4}
    .mobile-nav-list{display:grid;padding-top:6px}
    .mobile-nav-list a{min-height:46px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;border-radius:11px;color:#14271d;font-size:14px;font-weight:650;text-decoration:none}
    .mobile-nav-list a:hover{background:#eef7f2;color:#0b7440}
    .mobile-nav-list a span{color:#8a958e}
    .mobile-panel-cta{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:10px;border-radius:12px;background:#0b7440;color:#fff!important;font-size:14px;font-weight:750;text-decoration:none}

    .btn{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 20px;border:1px solid transparent;border-radius:12px;font-size:16px;line-height:1.2;font-weight:650;letter-spacing:-.02em;transition:transform .18s ease,background-color .18s ease,border-color .18s ease,box-shadow .18s ease}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green);color:#fff;box-shadow:0 10px 22px rgba(22,131,77,.18)}.btn-primary:hover{background:var(--green-dark);box-shadow:0 12px 26px rgba(22,131,77,.22)}.btn-secondary{background:#fff;border-color:#a8cdb8;color:var(--green-dark)}.btn-secondary:hover{background:var(--green-soft);border-color:#7fba99}

    .hero{position:relative;overflow:hidden;padding:64px 0 60px;background:linear-gradient(90deg,#fff 0%,#fff 54%,#f4fbf7 100%)}
    .hero::after{content:"";position:absolute;right:-90px;top:-70px;width:620px;height:620px;background-image:linear-gradient(rgba(22,131,77,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(22,131,77,.045) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(135deg,transparent 0%,#000 45%,#000 100%);pointer-events:none}
    .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:48px;align-items:center;min-width:0}.hero-copy,.workbook{min-width:0}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0 0 18px;padding:7px 11px;border:1px solid #b9dec8;border-radius:999px;background:#fff;color:var(--green-dark);font-size:14px;line-height:1.2;font-weight:700}.eyebrow::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--green)}
    .hero h1{margin:0;max-width:720px;font-size:clamp(46px,4.6vw,62px);line-height:1.04;font-weight:720;letter-spacing:-.048em;text-wrap:balance}.hero h1 em{font-style:normal;color:var(--green)}
    .hero-lead{max-width:680px;margin:20px 0 0;color:#4c596d;font-size:18.5px;line-height:1.56;letter-spacing:-.01em}
    .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
    .hero-bullets{display:flex;flex-wrap:wrap;gap:12px 20px;margin:22px 0 0;padding:0;list-style:none}.hero-bullets li{display:flex;align-items:center;gap:7px;color:#425066;font-size:14px;line-height:1.35;font-weight:550}.hero-bullets li::before{content:"✓";display:grid;place-items:center;width:19px;height:19px;border:1px solid #82c5a0;border-radius:50%;color:var(--green);font-size:12px;font-weight:800;background:#fff}

    .workbook{border:1px solid #d9e2e8;border-radius:22px;background:#fff;overflow:hidden;box-shadow:var(--shadow)}.wb-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 16px;border-bottom:1px solid var(--line);background:#fff}.wb-title{display:flex;align-items:center;gap:9px;min-width:0;font-size:15px;font-weight:700}.wb-title img{width:24px;height:24px;flex:0 0 auto}.wb-note{font-size:13px;color:var(--muted)}.wb-body{padding:16px;background:linear-gradient(180deg,#fff 0%,#fbfcfe 100%)}
    .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.metric{min-width:0;padding:12px;border-radius:12px;background:#fff;border:1px solid #e2e8ee}.metric small{display:block;color:var(--muted);font-size:13px;line-height:1.35}.metric strong{display:block;margin-top:6px;font-size:20px;line-height:1.18;font-weight:720;letter-spacing:-.03em}.metric span{display:block;margin-top:4px;color:#445066;font-size:12px;line-height:1.35}
    .wb-chart-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.65fr);gap:8px;margin-top:8px}.panel{min-width:0;padding:14px;border-radius:12px;background:#fff;border:1px solid #e2e8ee}.panel h3, .panel .panel-title{margin:0 0 10px;font-size:14px;line-height:1.3;font-weight:700;display:block}.chart-legend{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:10px;color:var(--muted);font-size:12px}.chart-legend span{display:flex;align-items:center;gap:5px}.chart-legend i{width:8px;height:8px;border-radius:2px}.legend-in{background:var(--green)}.legend-out{background:var(--coral)}.legend-bal{background:var(--blue)}
    .chart-area{position:relative;height:150px;border-bottom:1px solid #dfe5eb;background-image:linear-gradient(#eef2f6 1px,transparent 1px);background-size:100% 38px}.bar-pairs{position:absolute;inset:10px 6px 0;display:flex;align-items:flex-end;justify-content:space-around;gap:12px}.bar-pair{position:relative;display:flex;align-items:flex-end;gap:4px;height:100%;flex:1}.bar-pair i{display:block;width:46%;border-radius:4px 4px 0 0}.bar-pair .in{background:var(--green)}.bar-pair .out{background:var(--coral)}.bar-pair:nth-child(1) .in{height:42%}.bar-pair:nth-child(1) .out{height:18%}.bar-pair:nth-child(2) .in{height:61%}.bar-pair:nth-child(2) .out{height:34%}.bar-pair:nth-child(3) .in{height:52%}.bar-pair:nth-child(3) .out{height:27%}.bar-pair:nth-child(4) .in{height:70%}.bar-pair:nth-child(4) .out{height:44%}.bar-pair:nth-child(5) .in{height:60%}.bar-pair:nth-child(5) .out{height:32%}.bar-pair:nth-child(6) .in{height:78%}.bar-pair:nth-child(6) .out{height:46%}.chart-line{position:absolute;left:12%;right:8%;top:43%;height:2px;background:var(--blue);transform:rotate(-7deg);transform-origin:left center}.chart-line::after{content:"";position:absolute;right:-2px;top:-3px;width:8px;height:8px;border-radius:50%;background:var(--blue)}
    .donut-wrap{display:grid;grid-template-columns:92px minmax(0,1fr);gap:14px;align-items:center}.donut{width:92px;aspect-ratio:1;border-radius:50%;background:conic-gradient(var(--blue) 0 28%,var(--green) 28% 47%,var(--amber) 47% 67%,var(--coral) 67% 82%,var(--violet) 82% 100%);position:relative}.donut::after{content:"";position:absolute;inset:22px;border-radius:50%;background:#fff}.donut-list{display:grid;gap:6px;color:#4f5b6e;font-size:12px}.donut-list span{display:flex;align-items:center;gap:7px}.donut-list i{width:8px;height:8px;border-radius:50%}
    .wb-lists{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.75fr);gap:8px;margin-top:8px}.data-list,.alert-list{display:grid;gap:8px}.data-row,.alert-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px;align-items:center;font-size:12px;color:#445066}.alert-row{grid-template-columns:10px minmax(0,1fr) auto}.alert-row i{width:8px;height:8px;border-radius:50%;background:var(--coral)}.alert-row:nth-child(2) i{background:var(--amber)}.alert-row:nth-child(3) i{background:var(--green)}

    .section{padding:78px 0}.section-soft{background:var(--soft)}.section-green{background:linear-gradient(180deg,#f3fbf6 0%,#fff 100%)}.section-head{max-width:870px;margin:0 auto 38px;text-align:center}.section-head h2{margin:0;font-size:clamp(32px,3.4vw,44px);line-height:1.1;font-weight:720;letter-spacing:-.04em;text-wrap:balance}.section-head p{margin:14px auto 0;max-width:760px;color:var(--muted);font-size:17.5px;line-height:1.52}.section-kicker{display:inline-flex;align-items:center;gap:8px;margin-bottom:12px;color:var(--green);font-size:13px;font-weight:750;letter-spacing:.02em}.section-kicker::before{content:"";width:24px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--green) 0 45%,var(--amber) 45% 70%,var(--violet) 70%)}

    /* 3 SOMUT ÇIKTI (ÖRNEK SİSTEMLER) */
    .sample-systems-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:12px}
    .sample-system-card{padding:28px 24px;border-radius:20px;background:#ffffff;border:1px solid #dce4ea;box-shadow:0 8px 24px rgba(15,23,42,.04);display:flex;flex-direction:column;transition:transform .18s ease,box-shadow .18s ease}
    .sample-system-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(15,23,42,.08);border-color:#b9dec8}
    .ssc-tag{display:inline-block;align-self:flex-start;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:800;letter-spacing:.05em;margin-bottom:16px}
    .ssc-tag.is-green{background:#ecfdf5;color:#047857;border:1px solid #a7f3d0}
    .ssc-tag.is-blue{background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe}
    .ssc-tag.is-amber{background:#fffbeb;color:#b45309;border:1px solid #fde68a}
    .sample-system-card h3{margin:0 0 10px;font-size:20px;line-height:1.25;font-weight:750;color:#0f172a}
    .sample-system-card p{margin:0 0 18px;color:#475569;font-size:14.5px;line-height:1.55;flex-grow:1}
    .ssc-list{margin:0;padding:0;list-style:none;display:grid;gap:8px;border-top:1px solid #edf2f7;padding-top:16px}
    .ssc-list li{font-size:13.5px;color:#334155;line-height:1.4;font-weight:550}

    /* KENDİNİ TANI / NE ZAMAN */
    .problem-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
    .problem-card{position:relative;min-width:0;padding:22px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow-sm);transition:transform .18s ease,box-shadow .18s ease}
    .problem-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
    .problem-card::before{content:"";position:absolute;left:22px;right:22px;top:0;height:4px;border-radius:0 0 4px 4px}
    .problem-card.green::before{background:var(--green)}.problem-card.amber::before{background:var(--amber)}.problem-card.coral::before{background:var(--coral)}.problem-card.violet::before{background:var(--violet)}
    .problem-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;font-size:18px;font-weight:800;margin-bottom:16px}
    .problem-card.green .problem-icon{background:var(--green-soft);color:var(--green)}.problem-card.amber .problem-icon{background:var(--amber-soft);color:var(--amber)}.problem-card.coral .problem-icon{background:var(--coral-soft);color:var(--coral)}.problem-card.violet .problem-icon{background:var(--violet-soft);color:var(--violet)}
    .problem-card h3{margin:0 0 8px;font-size:16.5px;line-height:1.3;font-weight:700}.problem-card p{margin:0;color:var(--muted);font-size:14px;line-height:1.5}

    /* SAHA DİYALOĞU BENTO */
    .section-dialog{background:#ffffff}
    .dialog-bento-grid{display:grid;gap:18px;max-width:960px;margin:0 auto}
    .dialog-bubble{padding:26px;border-radius:20px;background:#f8fafc;border:1px solid #e2e8f0;box-shadow:0 6px 20px rgba(15,23,42,.03)}
    .bubble-client{background:#fff8f6;border-color:#fed7aa}
    .bubble-advisor{background:#f0fdf4;border-color:#bbf7d0}
    .bubble-header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
    .bubble-avatar{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:#fff;border:1px solid #e2e8f0;font-size:18px}
    .bubble-header div{display:flex;flex-direction:column}
    .bubble-header strong{font-size:14.5px;font-weight:750;color:#0f172a}
    .bubble-header small{font-size:11px;color:#64748b}
    .bubble-tag{margin-left:auto;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:800;letter-spacing:.04em}
    .tag-problem{background:#ffedd5;color:#c2410c}
    .tag-solution{background:#dcfce7;color:#15803d}
    .bubble-text{margin:0;font-size:15px;line-height:1.6;color:#334155}
    .dialog-flow-connector{display:flex;align-items:center;justify-content:center;gap:16px;padding:6px 0}
    .connector-line{flex-grow:1;height:1px;background:#cbd5e1}
    .connector-badge{padding:6px 14px;border-radius:999px;background:#0f172a;color:#fff;font-size:12px;font-weight:750;letter-spacing:.03em}
    .dialog-outcome-card{padding:20px 24px;border-radius:16px;background:#ffffff;border:2px solid #059669;box-shadow:0 8px 24px rgba(5,150,105,.08)}
    .outcome-pill{font-size:11px;font-weight:850;letter-spacing:.08em;color:#047857;margin-bottom:12px}
    .outcome-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .o-metric strong{display:block;font-size:17px;font-weight:800;color:#0f172a}
    .o-metric span{display:block;margin-top:3px;font-size:12.5px;color:#64748b}

    /* ALANLAR */
    .area-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .area-card{min-width:0;padding:24px;border:1px solid #d4e3d9;border-radius:18px;background:#fff;box-shadow:var(--shadow-sm);transition:transform .18s ease,border-color .18s ease}.area-card:hover{transform:translateY(-2px);border-color:#95cbb0}
    .area-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:var(--green-soft);color:var(--green-dark);font-size:15px;font-weight:800;margin-bottom:16px}
    .area-card h3{margin:0 0 8px;font-size:17px;line-height:1.3;font-weight:700}.area-card p{margin:0;color:#526075;font-size:14px;line-height:1.52}

    /* SÜREÇ */
    .process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
    .process-card{display:flex;flex-direction:column;min-width:0;padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow-sm)}
    .process-step{display:flex;align-items:center;gap:10px;margin-bottom:16px}.step-no{width:28px;height:28px;display:grid;place-items:center;border-radius:50%;background:var(--green-soft);color:var(--green-dark);font-size:13px;font-weight:800}.process-step strong{font-size:13px;color:var(--muted);font-weight:600}
    .process-card h3{margin:0 0 8px;font-size:16.5px;line-height:1.3;font-weight:700}.process-card p{margin:0;color:var(--muted);font-size:14px;line-height:1.52;flex-grow:1}
    .process-art{margin-top:20px;padding:12px;border-radius:10px;background:var(--soft);text-align:center;font-size:18px;color:var(--green)}

    /* KARŞILAŞTIRMA */
    .comparison-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:var(--shadow-sm)}
    .comparison{min-width:620px;display:grid}
    .comparison-head,.comparison-row{display:grid;grid-template-columns:180px repeat(3,minmax(0,1fr));align-items:stretch}
    .comparison-head{background:var(--soft);border-bottom:1px solid var(--line);font-size:13px;font-weight:750;color:#2c3748}.comparison-head div{padding:14px 16px}
    .comparison-row{border-bottom:1px solid #edf1f5;font-size:13.5px;line-height:1.45}.comparison-row:last-child{border-bottom:none}
    .comparison-row div{padding:14px 16px;display:flex;align-items:center}.comparison-row [role="rowheader"]{font-weight:650;color:#1e293b;background:rgba(246,248,251,.5)}
    .comparison-row [data-label="Size özel sistem"]{background:var(--green-soft);font-weight:600;color:var(--green-dark)}

    /* NEDEN BİZ */
    .why-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
    .why-card{min-width:0;padding:24px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow-sm)}
    .why-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:#f0f5ff;color:var(--blue);font-size:18px;font-weight:800;margin-bottom:16px}
    .why-card h3{margin:0 0 8px;font-size:16.5px;line-height:1.3;font-weight:700}.why-card p{margin:0;color:var(--muted);font-size:14px;line-height:1.52}

    /* GÜVENCE BENTO */
    .section-shield{background:#f8fafc}
    .shield-bento-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:20px;align-items:stretch}
    .shield-card.is-gold{padding:32px;border-radius:22px;background:linear-gradient(145deg,#0c1e34,#132f50);color:#fff;display:flex;flex-direction:column;box-shadow:0 14px 36px rgba(12,30,52,.14)}
    .shield-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
    .shield-badge{padding:4px 10px;border-radius:6px;background:rgba(217,119,6,.2);border:1px solid #d97706;color:#fbbf24;font-size:11px;font-weight:800;letter-spacing:.06em}
    .shield-icon-pill{font-size:24px}
    .shield-card.is-gold h3{margin:0 0 12px;font-size:22px;line-height:1.25;font-weight:800;color:#fff}
    .shield-card.is-gold p{margin:0 0 20px;font-size:14.5px;line-height:1.6;color:#cbd5e1;flex-grow:1}
    .shield-features{display:grid;gap:8px;padding-top:16px;border-top:1px solid rgba(255,255,255,.12)}
    .shield-features span{font-size:13.5px;color:#7ee2a8;font-weight:600}

    .five-pillars-subgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .pillar-mini-card{padding:18px;border-radius:16px;background:#fff;border:1px solid #e2e8f0}
    .pillar-mini-card:last-child{grid-column:span 2}
    .pillar-mini-card small{display:block;font-size:10.5px;font-weight:800;color:var(--green);letter-spacing:.05em;margin-bottom:4px}
    .pillar-mini-card strong{display:block;font-size:15px;color:#0f172a;font-weight:750;margin-bottom:6px}
    .pillar-mini-card p{margin:0;font-size:13px;color:#64748b;line-height:1.45}

    /* TESLİM VE ÖZEL SİSTEM GEREKMİYORSA */
    .delivery-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:20px;align-items:stretch}
    .delivery-card,.fit-card{padding:28px;border-radius:20px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm)}
    .delivery-card h3,.fit-card h3{margin:0 0 14px;font-size:19px;line-height:1.3;font-weight:750}
    .delivery-list{margin:0;padding:0;list-style:none;display:grid;gap:10px}
    .delivery-list li{display:flex;align-items:flex-start;gap:8px;font-size:14px;color:#334155;line-height:1.45}
    .delivery-list li::before{content:"✓";color:var(--green);font-weight:800}
    .fit-card{display:flex;flex-direction:column;justify-content:space-between;background:#edf9f2;border-color:#b9dec8}
    .fit-card p{margin:0 0 20px;font-size:15px;line-height:1.55;color:#274332}

    /* SSS */
    .faq-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:44px;align-items:start}
    .faq-copy h2{margin:0 0 12px;font-size:34px;line-height:1.15;font-weight:750;letter-spacing:-.03em}
    .faq-copy p{margin:0;color:var(--muted);font-size:16px;line-height:1.5}
    .faq-list{display:grid;gap:10px}
    .faq-list details{border:1px solid var(--line);border-radius:14px;background:#fff;overflow:hidden;padding:16px 20px;transition:background .15s ease}
    .faq-list details[open]{background:#fafbfc}
    .faq-list summary{font-size:16px;font-weight:700;color:#0f172a;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between}
    .faq-list summary::-webkit-details-marker{display:none}
    .faq-list summary::after{content:"+";font-size:20px;color:var(--muted);font-weight:400}
    .faq-list details[open] summary::after{content:"−"}
    .faq-list p{margin:12px 0 0;font-size:14.5px;line-height:1.55;color:#475569}

    /* FINAL CTA */
    .cta{padding:80px 0;background:linear-gradient(135deg,#0a4425 0%,#0f5f38 100%);color:#fff}
    .cta-shell{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:44px;align-items:center}
    .cta h2{margin:0 0 14px;font-size:clamp(30px,3.2vw,40px);line-height:1.15;font-weight:750;letter-spacing:-.03em}
    .cta p{margin:0 0 20px;font-size:16.5px;line-height:1.55;color:#d1fae5}
    .cta-points{display:flex;flex-wrap:wrap;gap:12px}
    .cta-points span{padding:5px 12px;border-radius:8px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);font-size:13px;font-weight:600;color:#fff}
    .cta-actions{display:flex;flex-direction:column;gap:12px}
    .cta-actions .btn{min-height:52px;font-size:16px}
    .cta-actions .btn-primary{background:#fff;color:#064e29;box-shadow:0 10px 24px rgba(0,0,0,.15)}
    .cta-actions .btn-primary:hover{background:#f0fdf4}
    .cta-actions .btn-secondary{background:transparent;border-color:rgba(255,255,255,.3);color:#fff}
    .cta-actions .btn-secondary:hover{background:rgba(255,255,255,.08)}
    .cta-note{margin:4px 0 0;font-size:13px;color:#a7f3d0}

    /* FOOTER */
    .footer{background:#0b1928;color:#94a3b8;padding:64px 0 36px;font-size:14px}
    .footer-grid{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(3,minmax(0,1fr));gap:40px;margin-bottom:48px}
    .footer-brand{display:flex;align-items:center;gap:10px;color:#fff;font-size:18px;font-weight:800;margin-bottom:12px}
    .footer-copy{margin:0;font-size:14px;line-height:1.55;color:#64748b}
    .footer-col strong{display:block;color:#fff;font-size:14px;font-weight:750;margin-bottom:14px}
    .footer-col a{display:block;color:#94a3b8;padding:4px 0;transition:color .15s ease}
    .footer-col a:hover{color:#34d399}
    .footer-bottom{display:flex;align-items:center;justify-content:space-between;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);font-size:13px;color:#64748b}

    @media(max-width:1080px){
      .hero-grid{grid-template-columns:1fr;gap:36px}
      .problem-grid,.why-grid,.process-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .sample-systems-grid{grid-template-columns:1fr}
      .area-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .shield-bento-grid{grid-template-columns:1fr}
      .delivery-grid{grid-template-columns:1fr}
      .faq-grid{grid-template-columns:1fr;gap:24px}
      .cta-shell{grid-template-columns:1fr;gap:28px}
      .footer-grid{grid-template-columns:1fr 1fr;gap:30px}
    }
    @media(max-width:800px){
      .nav-links{display:none}
      .mobile-menu{display:block}
      .hero{padding:42px 0 36px}
      .hero h1{font-size:36px}
      .hero-lead{font-size:16.5px}
      .section{padding:54px 0}
      .problem-grid,.why-grid,.process-grid,.area-grid{grid-template-columns:1fr}
      .five-pillars-subgrid{grid-template-columns:1fr}
      .pillar-mini-card:last-child{grid-column:auto}
      .footer-grid{grid-template-columns:1fr}
      .footer-bottom{flex-direction:column;gap:8px;text-align:center}
    }
  </style>
</head>

