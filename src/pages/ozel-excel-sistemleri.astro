        "isPartOf":{"@id":"https://excelarsiv.com/#website"},
        "about":{"@id":"https://excelarsiv.com/ozel-excel-sistemleri#service"},
        "breadcrumb":{"@id":"https://excelarsiv.com/ozel-excel-sistemleri#breadcrumb"},
        "speakable":{
          "@type":"SpeakableSpecification",
          "cssSelector":[".appstore-hero-copy h1", ".hero-answer-engine", ".appstore-hero-sub", "#sss details"]
