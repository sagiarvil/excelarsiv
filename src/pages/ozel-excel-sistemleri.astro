  <!-- Script for Interactive Diagnosis -->
  <script is:inline>
    const painCatalog = [
      {id:'tahsilat', label:'Kimden ne zaman tahsilat alacağımız net değil', family:'cash', roles:['smmm','finance','owner','service','other']},
      {id:'nakit', label:'Kâr var ama önümüzdeki haftaların nakit durumunu göremiyoruz', family:'cash', roles:['finance','owner','production','service','other']},
      {id:'kredi', label:'Kredi, limit, taksit ve teminatlar farklı dosyalarda', family:'bank', roles:['finance','owner','other']},
      {id:'pos', label:'POS satışı ile bankaya geçen tutar sık sık uyuşmuyor', family:'bank', roles:['finance','owner','other']},
      {id:'urun-kar', label:'Ürün / hizmet gerçek kârlılığını bilmiyoruz', family:'profit', roles:['finance','owner','production','service','other']},
      {id:'musteri-kar', label:'Hangi müşteri gerçekten kazandırıyor bilmiyoruz', family:'profit', roles:['smmm','finance','owner','service','other']},
      {id:'fiyat', label:'Teklif veya iskonto verirken minimum kârlı fiyat net değil', family:'profit', roles:['finance','owner','production','service','other']},
      {id:'stok', label:'Aylarca duran / ölü stok ve stokta bağlı para görünmüyor', family:'stock', roles:['finance','owner','production','other']},
      {id:'satinalma', label:'Tedarikçi fiyat değişimi ve son alış fiyatı kontrol edilemiyor', family:'stock', roles:['finance','owner','production','other']},
      {id:'evrak', label:'Eksik evrak ve mükellef işleri mesaj/e-posta üzerinden kovalanıyor', family:'office', roles:['smmm','other']},
      {id:'son-tarih', label:'Son tarih, sorumlu personel ve iş durumu tek ekranda değil', family:'office', roles:['smmm','service','other']},
      {id:'ofis-tahsilat', label:'Hizmet bedeli / muhasebe ücreti tahsilatları ayrıca takip ediliyor', family:'office', roles:['smmm','service','other']},
      {id:'uretim', label:'Standart maliyet ile fiili üretim maliyeti uyuşmuyor', family:'production', roles:['production','owner','finance','other']},
      {id:'fire', label:'Fire / hurda / işçilik / makine saat etkisi ölçülmüyor', family:'production', roles:['production','owner','other']},
      {id:'proje', label:'Proje bitince gerçek kârı ancak sonradan öğreniyoruz', family:'service', roles:['service','owner','finance','other']},
      {id:'saat', label:'Müşteri / proje bazında harcanan zaman ve kapasite görünmüyor', family:'service', roles:['service','smmm','other']},
      {id:'dosyalar', label:'Aynı veri farklı kişilerde farklı Excel dosyalarında yaşıyor', family:'control', roles:['smmm','finance','owner','service','production','other']},
      {id:'hata', label:'Formül veya veri hatasını ancak sonuç bozulunca fark ediyoruz', family:'control', roles:['smmm','finance','owner','service','production','other']}
    ];

    const families = {
      cash:{title:'Tahsilat & Nakit Akışı Kontrolü', systems:['Cari yaşlandırma ve tahsilat öncelik sistemi','13 haftalık nakit akışı ve ödeme radarı','Fatura–tahsilat / çek–senet eşleştirme yapısı']},
      bank:{title:'Banka, Kredi & Finansman Kontrolü', systems:['Banka limit–risk–teminat kontrol sistemi','Kredi ve taksit vade projeksiyon takvimi','POS hakediş / komisyon / banka mutabakatı']},
      profit:{title:'Gerçek Kârlılık & Fiyatlama Mimarisi', systems:['Ürün / müşteri / proje bazlı net katkı kârlılığı','Minimum satış fiyatı ve iskonto sınırı radarı','Satışçı / şube kârlılık performans paneli']},
      stock:{title:'Stok & Satın Alma Yönetimi', systems:['Stok yaşlandırma ve ölü stok erken uyarı sistemi','Stokta bağlı nakit ve optimal sipariş noktası','Tedarikçi fiyat geçmişi ve satın alma karşılaştırması']},
      office:{title:'Mali Müşavir & Ofis Operasyon Sistemi', systems:['Mükellef iş ve eksik evrak dijital takip sistemi','Son tarih / sorumlu personel / iş yükü radarı','Büro tahsilat ve mükellef kârlılık sistemi']},
      production:{title:'Üretim, Reçete & Fiili Maliyet', systems:['Dinamik reçete ve güncel maliyet motoru','Standart–fiili maliyet sapma analizi','Fire / kapasite / termin ve kârlı üretim paneli']},
      service:{title:'Hizmet & Proje Kârlılık Sistemi', systems:['Adam/saat ve proje gerçek kârlılık takibi','Personel kapasite, doluluk ve efor radarı','Kapsam dışı iş / ücretsiz mesai kontrol paneli']},
      control:{title:'Merkezi Veri & Kontrol Mimarisi', systems:['Tek veri girişli, hatasız ortak çalışma düzeni','Kontrol merkezi ve formül hata locator yapısı','Yönetici karar paneli ve anlık KPI dashboardu']}
    };

    let currentRole = 'smmm';
    const painList = document.getElementById('pain-list');
    const selectedCount = document.getElementById('selected-count');

    function renderPains() {
      const selected = new Set([...document.querySelectorAll('.pain-check:checked')].map(i => i.value));
      painList.innerHTML = '';
      painCatalog.filter(p => p.roles.includes(currentRole)).forEach(p => {
        const isChecked = selected.has(p.id);
        const label = document.createElement('label');
        label.className = isChecked
          ? 'pain-card flex items-start gap-3 p-3.5 rounded-2xl border-2 border-blue-500 bg-blue-50/80 shadow-md shadow-blue-500/10 cursor-pointer transition-all duration-200 scale-[1.01]'
          : 'pain-card flex items-start gap-3 p-3.5 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50/80 hover:border-blue-300 hover:shadow-sm cursor-pointer transition-all duration-200 hover:translate-x-0.5';
        
        label.innerHTML = `
          <input class="pain-check mt-0.5 w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" type="checkbox" value="${p.id}" ${isChecked ? 'checked' : ''}>
          <span class="pain-label text-sm ${isChecked ? 'font-bold text-navy' : 'font-semibold text-slate-800'} leading-snug select-none">${p.label}</span>
        `;
        painList.appendChild(label);
      });
      document.querySelectorAll('.pain-check').forEach(el => el.addEventListener('change', (e) => {
        const card = e.target.closest('.pain-card');
        const textSpan = card ? card.querySelector('.pain-label') : null;
        if (e.target.checked) {
          if (card) card.className = 'pain-card flex items-start gap-3 p-3.5 rounded-2xl border-2 border-blue-500 bg-blue-50/80 shadow-md shadow-blue-500/10 cursor-pointer transition-all duration-200 scale-[1.01]';
          if (textSpan) textSpan.className = 'pain-label text-sm font-bold text-navy leading-snug select-none';
        } else {
          if (card) card.className = 'pain-card flex items-start gap-3 p-3.5 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50/80 hover:border-blue-300 hover:shadow-sm cursor-pointer transition-all duration-200 hover:translate-x-0.5';
          if (textSpan) textSpan.className = 'pain-label text-sm font-semibold text-slate-800 leading-snug select-none';
        }
        updateDiagnosis();
      }));
      updateDiagnosis();
    }

    document.querySelectorAll('[data-role]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentRole = btn.dataset.role;
        document.querySelectorAll('[data-role]').forEach(b => {
          b.setAttribute('aria-pressed','false');
          b.className = 'role-btn border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-blue-300 hover:shadow-sm rounded-xl p-3 text-left text-sm font-bold text-slate-700 transition-all duration-200 flex items-center justify-between';
          const dot = b.querySelector('.rounded-full');
          if (dot) dot.remove();
        });
        btn.setAttribute('aria-pressed','true');
        btn.className = 'role-btn border border-blue-500 bg-gradient-to-r from-blue to-indigo-600 text-white shadow-md shadow-blue/20 rounded-xl p-3 text-left text-sm font-bold transition-all duration-200 flex items-center justify-between scale-[1.02]';
        btn.innerHTML = `<span class="flex items-center gap-1.5">${btn.textContent.trim()}</span><span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>`;
        renderPains();
      });
    });

    function updateDiagnosis() {
      const selectedIds = [...document.querySelectorAll('.pain-check:checked')].map(i => i.value);
      selectedCount.textContent = `${selectedIds.length} seçildi`;
      
      if (selectedIds.length > 0) {
        selectedCount.className = 'text-xs font-mono font-extrabold px-3.5 py-1.5 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/25 transition-all';
      } else {
        selectedCount.className = 'text-xs font-mono font-bold px-3.5 py-1.5 rounded-full bg-blue/10 text-blue border border-blue/20 transition-all';
      }

      const box = document.getElementById('diagnosis-result');
      if (!selectedIds.length) {
        box.classList.add('hidden');
        return;
      }

      const scores = {};
      selectedIds.forEach(id => {
        const item = painCatalog.find(p => p.id === id);
        if (item) scores[item.family] = (scores[item.family] || 0) + 1;
      });
      const topFamily = Object.entries(scores).sort((a,b) => b[1]-a[1])[0][0];
      const family = families[topFamily];
      const method = document.getElementById('current-method').value;
      const frequency = document.getElementById('frequency').value;
      const selectedLabels = selectedIds.map(id => painCatalog.find(p => p.id === id)?.label).filter(Boolean);

      document.getElementById('result-title').textContent = family.title;
      document.getElementById('result-subtitle').textContent = `${selectedIds.length} belirti seçtiniz · Mevcut takip: ${method} · Sıklık: ${frequency}`;
      document.getElementById('result-systems').innerHTML = family.systems.map(s => `
        <li class="flex items-center gap-3 bg-white p-3 rounded-2xl border border-blue-100 shadow-sm">
          <span class="w-6 h-6 rounded-xl bg-blue-600 text-white flex items-center justify-center text-xs font-black shrink-0 shadow-sm">✓</span>
          <span class="font-bold text-navy text-xs sm:text-sm">${s}</span>
        </li>
      `).join('');

      const roleBtn = document.querySelector('[data-role][aria-pressed="true"]');
      const roleText = roleBtn ? roleBtn.textContent.trim() : currentRole;
      const summary = `Barış Bey merhaba. Özel Excel sistemi ihtiyaç teşhisinden geliyorum.%0A%0ARol: ${roleText}%0AMevcut takip: ${method}%0ASıklık: ${frequency}%0A%0ASeçtiğim sorunlar:%0A- ${selectedLabels.join('%0A- ')}%0A%0AÖn teşhis: ${family.title}. Bu yapıyı bizim işleyişimize göre değerlendirmek istiyorum.`;
      document.getElementById('diagnosis-whatsapp').href = `https://api.whatsapp.com/send?phone=905393333303&text=${encodeURI(summary)}`;
      box.classList.remove('hidden');
    }

    document.getElementById('current-method').addEventListener('change', updateDiagnosis);
    document.getElementById('frequency').addEventListener('change', updateDiagnosis);
    renderPains();
  </script>
