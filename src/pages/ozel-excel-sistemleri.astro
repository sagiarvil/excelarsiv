    .workbook{min-width:0;border:1px solid var(--xl-border);border-radius:var(--r-lg);background:var(--xl-canvas);box-shadow:var(--shadow-lg);overflow:hidden}.wb-titlebar{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;border-bottom:1px solid var(--xl-border);background:var(--xl-header)}.wb-brand{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10px}.wb-brand img{width:18px;height:18px}.wb-live{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:9px;color:var(--xl-ink-3)}.wb-live::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--xl-green)}.wb-tabs{display:flex;gap:1px;padding:7px 8px 0;border-bottom:1px solid var(--xl-border);background:#fafafa}.wb-tab{padding:7px 10px 6px;border:1px solid var(--xl-border);border-bottom:0;border-radius:var(--r-sm) var(--r-sm) 0 0;background:var(--xl-header);font-family:var(--font-mono);font-size:9px;color:var(--xl-ink-3)}.wb-tab.active{background:var(--xl-canvas);color:var(--xl-green);border-top:2px solid var(--xl-green);padding-top:6px}.wb-body{display:grid;grid-template-columns:104px minmax(0,1fr);min-height:410px}.wb-rail{padding:12px 8px;border-right:1px solid var(--xl-border);background:#fbfbfa}.wb-rail-title{padding:5px 7px 10px;font-family:var(--font-mono);font-size:9px;color:var(--xl-ink-3)}.wb-link{display:flex;align-items:center;gap:7px;padding:8px 7px;margin-bottom:3px;border-left:2px solid transparent;font-size:10px;color:var(--xl-ink-2)}.wb-link.active{border-left-color:var(--xl-green);background:var(--xl-green-tint);color:var(--xl-green-dark);font-weight:800}.wb-main{min-width:0;padding:14px;background:var(--xl-paper)}.wb-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:10px}.wb-head h2{margin:0;font-size:15px;letter-spacing:0}.wb-head span{font-family:var(--font-mono);font-size:8px;color:var(--xl-ink-3)}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.kpi{min-width:0;padding:10px;border:1px solid var(--xl-grid);border-top:2px solid var(--xl-blue);border-radius:var(--r-base);background:var(--xl-canvas)}.kpi:nth-child(2){border-top-color:var(--xl-green)}.kpi:nth-child(3){border-top-color:var(--cf-warn-tx)}.kpi:nth-child(4){border-top-color:var(--xl-select)}.kpi small{display:block;font-family:var(--font-mono);font-size:7px;color:var(--xl-ink-3)}.kpi strong{display:block;margin-top:5px;font-size:13px;white-space:nowrap}.kpi em{display:block;margin-top:3px;font-family:var(--font-mono);font-size:7px;font-style:normal;color:var(--cf-good-tx)}.wb-panels{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.65fr);gap:7px;margin-top:7px}.panel{min-width:0;padding:10px;border:1px solid var(--xl-grid);border-radius:var(--r-base);background:var(--xl-canvas)}.panel-title{display:flex;justify-content:space-between;gap:8px;font-size:9px;font-weight:800}.panel-title span{font-family:var(--font-mono);font-size:7px;color:var(--xl-ink-3);font-weight:500}.chart{height:112px;display:flex;align-items:flex-end;gap:6px;padding:14px 4px 6px;border-bottom:1px solid var(--xl-grid)}.chart i{flex:1;min-width:6px;background:var(--xl-blue);opacity:.82}.chart i:nth-child(1){height:42%}.chart i:nth-child(2){height:55%}.chart i:nth-child(3){height:48%}.chart i:nth-child(4){height:72%}.chart i:nth-child(5){height:80%}.chart i:nth-child(6){height:92%;background:var(--xl-green)}.risk-list{display:grid;gap:6px;margin-top:10px}.risk-row{display:grid;grid-template-columns:8px minmax(0,1fr) auto;gap:7px;align-items:center;padding:6px;border-bottom:1px solid var(--xl-grid);font-size:8px}.risk-dot{width:7px;height:7px;border-radius:50%;background:var(--cf-warn-tx)}.risk-row:nth-child(2) .risk-dot{background:var(--cf-bad-tx)}.risk-row:nth-child(3) .risk-dot{background:var(--cf-good-tx)}.risk-row b{font-family:var(--font-mono);font-size:8px}.mini-table{margin-top:7px;border:1px solid var(--xl-grid);border-radius:var(