      },
      {
        "@type":"Person",
        "@id":"https://excelarsiv.com/#baris-bagirlar",
        "name":"Barış Bağırlar",
        "jobTitle":"Ticari Bankacılık Uzmanı ve Finansal Sistem Mimarı",
