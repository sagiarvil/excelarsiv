  <style>
    :root{
      color-scheme:light;
      --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Helvetica Neue",Arial,sans-serif;
      --ink:#172033;
      --ink-2:#273246;
      --muted:#647084;
      --line:#dce3ea;
      --paper:#ffffff;
      --soft:#f6f8fb;
      --green:#16834d;
      --green-dark:#0e6a3c;
      --green-soft:#edf9f2;
      --green-mid:#d9f1e3;
      --blue:#2f6fe4;
      --blue-soft:#eef4ff;
      --amber:#f59f1a;
      --amber-soft:#fff6e7;
      --coral:#ef5e5e;
      --coral-soft:#fff0f0;
      --violet:#7c4fe0;
      --violet-soft:#f5f0ff;
      --teal:#188d8d;
      --teal-soft:#eaf8f8;
      --shadow:0 14px 40px rgba(31,55,80,.08);
      --shadow-sm:0 8px 20px rgba(31,55,80,.05);
      --radius:18px;
      --radius-sm:12px;
      --content:1040px;
      --wide:1120px;
    }

    *{box-sizing:border-box}
    html{font-size:16px;scroll-behavior:smooth;background:var(--paper)}
    body{margin:0;background:var(--paper);color:#444444;font-family:var(--font);font-size:16px;line-height:1.6;font-weight:400;letter-spacing:-.014em;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    img,svg{display:block;max-width:100%}
    button,input,select,textarea{font:inherit}
    p,h1,h2,h3{overflow-wrap:break-word}
    [id]{scroll-margin-top:82px}

    .skip-link{position:fixed;left:16px;top:12px;z-index:1000;transform:translateY(-160%);padding:8px 12px;border-radius:8px;background:var(--ink);color:#fff;font-size:13px;font-weight:650}.skip-link:focus{transform:none}
    a:focus-visible,summary:focus-visible{outline:3px solid rgba(47,111,228,.32);outline-offset:3px;border-radius:9px}
    .wrap{width:min(var(--content),calc(100% - 64px));margin-inline:auto}
    .wrap-wide{width:min(var(--wide),calc(100% - 64px));margin-inline:auto}

    .site-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.96);border-bottom:1px solid #dfe6e2;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
    .nav-inner{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:20px;min-width:0}
    .brand{display:inline-flex;align-items:center;gap:10px;min-width:0;flex-shrink:0;text-decoration:none}
    .brand img{width:34px;height:34px;border-radius:8px;flex-shrink:0}
    .brand-copy{display:flex;flex-direction:column;line-height:1.15}
    .brand-copy strong{font-size:17px;line-height:1.1;font-weight:800;letter-spacing:-.015em;color:#14271d;white-space:nowrap}
    .brand-copy small{font-size:11px;font-weight:600;letter-spacing:.02em;color:#64748b;white-space:nowrap;margin-top:2px}
    .nav-links{display:flex;align-items:center;gap:4px;margin-inline:auto;min-width:0}
    .nav-links a{padding:7px 12px;border-radius:8px;font-size:14.5px;line-height:1.25;font-weight:600;color:#222222;text-decoration:none;transition:color 150ms ease,background 150ms ease;white-space:nowrap;letter-spacing:-.01em}
    .nav-links a:hover{color:#0b7440;background:#eef7f2}
    .nav-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .nav-cta{display:inline-flex;align-items:center;justify-content:center;height:40px;padding-inline:16px;border-radius:9px;background:#0b7440;color:#ffffff!important;font-size:13.5px;font-weight:750;text-decoration:none;box-shadow:0 6px 16px rgba(11,116,64,.12);transition:background 150ms ease,transform 150ms ease;white-space:nowrap}
    .nav-cta:hover{background:#075f34;transform:translateY(-1px)}
    .mobile-menu{display:none;position:relative}
    .mobile-menu summary{width:38px;height:38px;display:grid;place-content:center;gap:4px;border:1px solid #dfe6e2;border-radius:10px;background:#fff;cursor:pointer;list-style:none;box-shadow:0 4px 12px rgba(15,23,42,.04)}
    .mobile-menu summary::-webkit-details-marker{display:none}
    .mobile-menu summary span{display:block;width:16px;height:1.8px;background:#14271d;border-radius:2px}
    .mobile-menu[open]::before{content:"";position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:150;pointer-events:auto}
    .mobile-panel{position:fixed;top:64px;left:12px;right:12px;max-height:calc(100dvh - 84px);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:12px;border:1px solid #dce5df;border-radius:20px;background:#ffffff;box-shadow:0 24px 60px rgba(15,23,42,.25);z-index:160}
    .mobile-panel-head{padding:6px 8px 10px;border-bottom:1px solid #edf2ee}
    .mobile-panel-head strong{display:block;color:#0f172a;font-size:16px;line-height:1.2;font-weight:800}
    .mobile-panel-head span{display:block;margin-top:3px;color:#64748b;font-size:12.5px;line-height:1.4}
    .mobile-nav-list{display:grid;padding-top:6px}
    .mobile-nav-list a{min-height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;border-radius:10px;color:#14271d;font-size:14.5px;font-weight:650;text-decoration:none}
    .mobile-nav-list a:hover{background:#eef7f2;color:#0b7440}
    .mobile-nav-list a span{color:#8a958e}
    .mobile-panel-cta{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:8px;border-radius:10px;background:#0b7440;color:#fff!important;font-size:14.5px;font-weight:750;text-decoration:none}

    .btn{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 20px;border:1px solid transparent;border-radius:10px;font-size:15px;line-height:1.2;font-weight:650;letter-spacing:-.015em;transition:transform .18s ease,background-color .18s ease,border-color .18s ease,box-shadow .18s ease}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green);color:#fff;box-shadow:0 8px 18px rgba(22,131,77,.16)}.btn-primary:hover{background:var(--green-dark);box-shadow:0 10px 22px rgba(22,131,77,.20)}.btn-secondary{background:#fff;border-color:#a8cdb8;color:var(--green-dark)}.btn-secondary:hover{background:var(--green-soft);border-color:#7fba99}

    /* 01 NARROW MAGNETIC HERO */
    .hero{position:relative;overflow:hidden;padding:42px 0 38px;background:linear-gradient(135deg,#ffffff 0%,#f8faf9 60%,#eff7f2 100%)}
    .hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(11,116,64,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(11,116,64,.035) 1px,transparent 1px);background-size:24px 24px;mask-image:radial-gradient(ellipse 70% 60% at 50% 40%,#000 60%,transparent 100%);pointer-events:none}
    .hero::after{content:"";position:absolute;right:10%;top:10%;width:380px;height:380px;background:radial-gradient(circle,rgba(5,150,105,.08) 0%,transparent 70%);filter:blur(40px);pointer-events:none}
    .hero>.wrap-wide{width:min(1040px,calc(100% - 48px));margin-inline:auto}
    .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:28px;align-items:center;min-width:0}
    .hero-copy,.workbook{min-width:0}

    .hero-badge{display:inline-flex;align-items:center;gap:7px;margin-bottom:12px;padding:5px 12px;border-radius:999px;background:#fff;border:1px solid #b9dec8;box-shadow:0 2px 8px rgba(11,116,64,.06);font-size:13px;font-weight:700;color:var(--green-dark)}
    .badge-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(22,131,77,.2);animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 3px rgba(22,131,77,.2)}50%{box-shadow:0 0 0 6px rgba(22,131,77,.05)}}
    .badge-sep{color:#cbd5e1}
    .badge-accent{color:#059669;font-weight:600}

    .hero h1{margin:0;max-width:580px;font-size:clamp(34px,3.8vw,44px);line-height:1.15;font-weight:800;letter-spacing:-.03em;text-wrap:balance;color:#222222}
    .hero h1 em{font-style:normal;color:var(--green);position:relative}
    .hero-lead{max-width:560px;margin:14px 0 0;color:#444444;font-size:16.5px;line-height:1.6;letter-spacing:-.01em}

    .hero-answer-engine{margin-top:14px;padding:10px 14px;border-radius:10px;background:rgba(22,131,77,.04);border:1px solid rgba(22,131,77,.14);font-size:13px;line-height:1.5;color:#2e4438}
    .hero-answer{margin:0;}
    .hero-answer strong{color:var(--green-dark);font-weight:750}

    .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
    .btn-magnetic{box-shadow:0 6px 20px rgba(5,150,105,.2)!important}
    .hero-trust-note{margin:12px 0 0;font-size:13.5px;line-height:1.45;color:#555555}
    .hero-trust-note strong{color:var(--green-dark)}
    .hero-bullets{display:flex;flex-wrap:wrap;gap:8px 16px;margin:16px 0 0;padding:0;list-style:none}
    .hero-bullets li{display:flex;align-items:center;gap:7px;color:#444444;font-size:14px;line-height:1.4;font-weight:550}
    .hero-bullets li::before{content:"✓";display:grid;place-items:center;width:18px;height:18px;border:1px solid #82c5a0;border-radius:50%;color:var(--green);font-size:11px;font-weight:800;background:#fff}

    /* DİNAMİK CANLI WORKBOOK SEKME VE RENK TEMALARI */
    .workbook{border:1px solid #cfe0d5;border-radius:16px;background:#fff;overflow:hidden;box-shadow:0 18px 40px -10px rgba(15,23,42,.1),0 6px 16px -4px rgba(15,23,42,.04);transition:all .3s ease}
    .workbook[data-theme="green"]{border-color:#a7f3d0;box-shadow:0 20px 45px -8px rgba(16,185,129,.15)}
    .workbook[data-theme="blue"]{border-color:#bfdbfe;box-shadow:0 20px 45px -8px rgba(37,99,235,.15)}
    .workbook[data-theme="amber"]{border-color:#fde68a;box-shadow:0 20px 45px -8px rgba(245,158,11,.15)}
    .workbook[data-theme="violet"]{border-color:#ddd6fe;box-shadow:0 20px 45px -8px rgba(124,58,237,.15)}
    .workbook:hover{box-shadow:0 24px 50px -8px rgba(15,23,42,.16),0 8px 20px -4px rgba(15,23,42,.06)}
    .wb-top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;border-bottom:1px solid var(--line);background:#fafcfb}
    .wb-dots{display:flex;gap:5px}
    .wb-dot{width:9px;height:9px;border-radius:50%;background:#e2e8f0}
    .wb-dot.red{background:#f87171}.wb-dot.yellow{background:#fbbf24}.wb-dot.green{background:#34d399}
    .wb-title{display:flex;align-items:center;gap:6px;min-width:0;font-size:12.5px;font-weight:750;color:#1e293b}
    .wb-title img{width:16px;height:16px}
    .wb-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:6px;font-size:10.5px;font-weight:750;transition:all .2s ease}
    .wb-badge.is-green{background:#ecfdf5;border:1px solid #a7f3d0;color:#047857}
    .wb-badge.is-blue{background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8}
    .wb-badge.is-amber{background:#fffbeb;border:1px solid #fde68a;color:#b45309}
    .wb-badge.is-violet{background:#f5f3ff;border:1px solid #ddd6fe;color:#6d28d9}
    .wb-tabs{display:flex;gap:4px;padding:6px 12px;background:#f1f5f3;border-bottom:1px solid #e2e9e4;overflow-x:auto}
    .wb-tab{position:relative;padding:5px 10px;border:none;background:transparent;border-radius:6px;font-size:11.5px;font-weight:700;color:#64748b;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .18s ease;white-space:nowrap}
    .wb-tab:hover{color:#0f172a;background:rgba(255,255,255,.6)}
    .wb-tab.active{background:#fff;color:#0f172a;box-shadow:0 2px 6px rgba(0,0,0,.08)}
    .wb-tab .tab-dot{width:7px;height:7px;border-radius:50%;display:inline-block;transition:transform .2s ease}
    .wb-tab.active .tab-dot{transform:scale(1.25)}
    .wb-tab[data-tab="0"] .tab-dot{background:#10b981}
    .wb-tab[data-tab="1"] .tab-dot{background:#2563eb}
    .wb-tab[data-tab="2"] .tab-dot{background:#f59e0b}
    .wb-tab[data-tab="3"] .tab-dot{background:#7c3aed}
    .wb-tab[data-tab="0"].active{color:#047857}
    .wb-tab[data-tab="1"].active{color:#1d4ed8}
    .wb-tab[data-tab="2"].active{color:#b45309}
    .wb-tab[data-tab="3"].active{color:#6d28d9}
    .wb-tab .tab-progress{position:absolute;bottom:0;left:6px;right:6px;height:2px;background:transparent;border-radius:2px;overflow:hidden}
    .wb-tab.active .tab-progress::after{content:"";display:block;height:100%;background:currentColor;animation:wbTabProgress 4.5s linear infinite}
    @keyframes wbTabProgress{from{width:0%}to{width:100%}}

    .wb-sheet{display:none}
    .wb-sheet.active{display:block;animation:sheetFadeIn .22s cubic-bezier(0,0,.2,1)}
    @keyframes sheetFadeIn{from{opacity:.35;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}

    .wb-body{padding:10px;background:#fff}
    .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
    .metric{min-width:0;padding:8px 9px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0;transition:border-color .2s ease}
    .metric small{display:block;color:var(--muted);font-size:10px;line-height:1.25;font-weight:600}
    .metric strong{display:block;margin-top:3px;font-size:14px;line-height:1.2;font-weight:800;letter-spacing:-.02em;color:#0f172a}
    .metric span{display:block;margin-top:2px;font-size:10px;line-height:1.2;font-weight:650}
    .metric span.c-green{color:#059669}
    .metric span.c-blue{color:#2563eb}
    .metric span.c-amber{color:#d97706}
    .metric span.c-violet{color:#7c3aed}

    .wb-fx-bar{display:flex;align-items:center;gap:6px;padding:5px 10px;background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:11px}
    .wb-fx-cell{display:inline-block;padding:1px 5px;background:#fff;border:1px solid #cbd5e1;border-radius:4px;font-weight:750;color:#1e293b;font-size:10px}
    .wb-fx-icon{font-weight:800;font-style:italic;color:#64748b;font-size:11.5px;font-family:serif}
    .wb-fx-code{color:#334155;font-weight:600;font-size:10.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
    .wb-fx-code b{font-weight:750}

    .wb-chart-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:6px;margin-top:6px}
    .panel{min-width:0;padding:9px 11px;border-radius:9px;background:#fff;border:1px solid #e2e8ee}
    .panel h3, .panel .panel-title{margin:0 0 5px;font-size:11.5px;line-height:1.3;font-weight:750;display:flex;justify-content:space-between;align-items:center;color:#1e293b}
    .chart-legend{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:5px;color:var(--muted);font-size:10px}
    .chart-legend span{display:flex;align-items:center;gap:4px}
    .chart-legend i{width:7px;height:7px;border-radius:2px}
    .chart-svg-host{width:100%;height:auto;display:block}
    .chart-svg-host svg{width:100%;height:auto;display:block}

    /* Donut Stilleri */
    .donut-wrap{display:grid;grid-template-columns:58px minmax(0,1fr);gap:10px;align-items:center}
    .donut-svg-box{width:58px;height:58px;position:relative;flex-shrink:0}
    .donut-svg-box svg{width:100%;height:100%;display:block;transform:rotate(-90deg)}
    .donut-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none}
    .donut-inner strong{font-size:9.5px;font-weight:800;color:#0f172a;line-height:1.1}
    .donut-inner small{font-size:7.5px;color:#64748b;font-weight:600}
    .donut-list{display:grid;gap:3px;color:#475569;font-size:10px;min-width:0}
    .donut-list span{display:flex;align-items:center;justify-content:space-between;gap:6px;white-space:nowrap}
    .donut-list span i{width:6px;height:6px;border-radius:50%;display:inline-block;flex-shrink:0}
    .donut-list span b{font-weight:750;color:#0f172a;font-size:10px}

    /* Banka Barları (Mavi Tema) */
    .bank-bars-list{display:grid;gap:5px;margin-top:2px}
    .bank-bar-row{display:grid;grid-template-columns:52px minmax(0,1fr) 34px;gap:6px;align-items:center;font-size:10px}
    .bank-bar-row span{color:#475569;font-weight:600}
    .bank-bar-track{height:8px;border-radius:999px;background:#eff6ff;border:1px solid #dbeafe;overflow:hidden}
    .bank-bar-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#3b82f6,#1d4ed8);animation:barGrow 1.5s ease-out}
    .bank-bar-row b{font-family:ui-monospace,monospace;font-size:9.5px;color:#1e40af;text-align:right}
    @keyframes barGrow{from{width:0%}to{width:var(--w,100%)}}

    .wb-lists{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.75fr);gap:6px;margin-top:6px}
    .data-list,.alert-list{display:grid;gap:5px}
    .data-row,.alert-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:6px;align-items:center;font-size:10.5px;color:#445066}
    .alert-row{grid-template-columns:8px minmax(0,1fr) auto}
    .alert-row i{width:7px;height:7px;border-radius:50%}

    .section{padding:54px 0}.section-soft{background:var(--soft)}.section-green{background:linear-gradient(180deg,#f3fbf6 0%,#fff 100%)}.section-head{max-width:760px;margin:0 auto 28px;text-align:center}.section-head h2{margin:0;font-size:clamp(26px,2.6vw,32px);line-height:1.24;font-weight:750;letter-spacing:-.028em;text-wrap:balance;color:#222222}.section-head p{margin:10px auto 0;max-width:660px;color:#555555;font-size:16px;line-height:1.6}.section-kicker{display:inline-flex;align-items:center;gap:7px;margin-bottom:8px;color:var(--green);font-size:13px;font-weight:750;letter-spacing:.02em}.section-kicker::before{content:"";width:20px;height:2.5px;border-radius:3px;background:linear-gradient(90deg,var(--green) 0 45%,var(--amber) 45% 70%,var(--violet) 70%)}

    /* 01.5 SEO AUTHORITY & STRATEJİK EXCEL ÇÖZÜMLERİ */
    .seo-authority-section{padding:52px 0 46px;background:#ffffff;border-bottom:1px solid #e7eee9}
    .seo-pillar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:28px}
    .seo-pillar-card{display:flex;flex-direction:column;min-width:0;padding:24px 22px;border:1px solid #dbe6df;border-radius:16px;background:#fbfdfc;box-shadow:var(--shadow-sm);transition:transform .18s ease,border-color .18s ease}
    .seo-pillar-card:hover{transform:translateY(-2px);border-color:#97cfb2}
    .seo-pillar-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;border-bottom:1px solid #eef3f0;padding-bottom:12px}
    .seo-pillar-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;font-size:16px;font-weight:800;flex-shrink:0}
    .seo-pillar-card.why .seo-pillar-icon{background:var(--green-soft);color:var(--green-dark)}
    .seo-pillar-card.benefits .seo-pillar-icon{background:var(--blue-soft);color:var(--blue)}
    .seo-pillar-card.solutions .seo-pillar-icon{background:var(--amber-soft);color:var(--amber)}
    .seo-pillar-head h3{margin:0;font-size:17.5px;line-height:1.3;font-weight:750;color:#1e293b}
    .seo-pillar-desc{margin:0 0 14px;color:#555555;font-size:14px;line-height:1.55}
    .seo-pillar-list{list-style:none;padding:0;margin:0;display:grid;gap:12px}
    .seo-pillar-list li{display:flex;flex-direction:column;gap:3px;font-size:13.5px;line-height:1.5;color:#475569;border-left:2px solid #82c5a0;padding-left:10px}
    .seo-pillar-list li strong{color:#1e293b;font-weight:750;font-size:14px}
    .seo-authority-bar{margin-top:26px;padding:18px 22px;border-radius:14px;background:#f3f9f5;border:1px solid #cce5d7;display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;align-items:center}
    .seo-bar-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;background:#0b7440;color:#fff;font-size:12px;font-weight:750;letter-spacing:.02em;white-space:nowrap}
    .seo-bar-tags{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
    .seo-tag-pill{display:inline-flex;align-items:center;padding:4px 10px;border-radius:6px;background:#fff;border:1px solid #bcdbc9;color:#166534;font-size:12.5px;font-weight:650}
    .seo-authority-note{margin-top:14px;text-align:center;font-size:13px;color:#64748b;line-height:1.5}
    .seo-authority-note strong{color:#0e6a3c}

    /* 02 MEKANİZMA (6 ADIM) */
    .mech-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .mech-card{padding:20px 18px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;transition:transform .18s ease,border-color .18s ease}
    .mech-card:hover{transform:translateY(-2px);border-color:#b9dec8}
    .mech-num{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:var(--green-soft);color:var(--green-dark);font-size:12.5px;font-weight:800;margin-bottom:10px}
    .mech-card h3{margin:0 0 6px;font-size:16px;line-height:1.35;font-weight:700;color:#222222}
    .mech-card p{margin:0;font-size:14.5px;line-height:1.55;color:#555555}

    /* 03 SOMUT ÇIKTI (3 KOKPİT) */
    .sample-systems-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .sample-system-card{padding:24px 22px;border-radius:16px;background:#ffffff;border:1px solid #dce4ea;box-shadow:0 6px 20px rgba(15,23,42,.03);display:flex;flex-direction:column;transition:transform .18s ease,box-shadow .18s ease}
    .sample-system-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(15,23,42,.07);border-color:#b9dec8}
    .ssc-tag{display:inline-block;align-self:flex-start;padding:4px 9px;border-radius:6px;font-size:11px;font-weight:800;letter-spacing:.04em;margin-bottom:12px}
    .ssc-tag.is-green{background:#ecfdf5;color:#047857;border:1px solid #a7f3d0}
    .ssc-tag.is-blue{background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe}
    .ssc-tag.is-amber{background:#fffbeb;color:#b45309;border:1px solid #fde68a}
    .sample-system-card h3{margin:0 0 10px;font-size:18px;line-height:1.3;font-weight:750;color:#222222}
    .ssc-box{padding:10px 14px;border-radius:8px;margin-bottom:10px;font-size:13.5px;line-height:1.5}
    .ssc-box.problem{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .ssc-box.output{background:var(--green-soft);border:1px solid #bbf7d0;color:var(--green-dark);margin-bottom:14px}
    .ssc-box strong{display:block;font-weight:750;margin-bottom:2px}
    .ssc-list{margin:0;padding:0;list-style:none;display:grid;gap:8px;border-top:1px solid #edf2f7;padding-top:14px}
    .ssc-list li{font-size:14.5px;color:#334155;line-height:1.45;font-weight:550}

    /* 04 KENDİNİ TANI / NE ZAMAN (6 PROBLEM KARTI) */
    .problem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .problem-card{position:relative;min-width:0;padding:20px 18px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm);transition:transform .18s ease,box-shadow .18s ease}
    .problem-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
    .problem-card::before{content:"";position:absolute;left:18px;right:18px;top:0;height:3px;border-radius:0 0 3px 3px}
    .problem-card.green::before{background:var(--green)}.problem-card.amber::before{background:var(--amber)}.problem-card.coral::before{background:var(--coral)}.problem-card.violet::before{background:var(--violet)}.problem-card.blue::before{background:var(--blue)}.problem-card.teal::before{background:var(--teal)}
    .problem-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:8px;font-size:15px;font-weight:800;margin-bottom:10px}
    .problem-card.green .problem-icon{background:var(--green-soft);color:var(--green)}.problem-card.amber .problem-icon{background:var(--amber-soft);color:var(--amber)}.problem-card.coral .problem-icon{background:var(--coral-soft);color:var(--coral)}.problem-card.violet .problem-icon{background:var(--violet-soft);color:var(--violet)}.problem-card.blue .problem-icon{background:var(--blue-soft);color:var(--blue)}.problem-card.teal .problem-icon{background:var(--teal-soft);color:var(--teal)}
    .problem-card h3{margin:0 0 6px;font-size:16px;line-height:1.35;font-weight:700;color:#222222}.problem-card p{margin:0;color:#555555;font-size:14px;line-height:1.55}

    /* 05 SAHA SENARYOSU (ÖRNEK SENARYO DİYALOĞU) */
    .section-dialog{background:#ffffff}
    .dialog-bento-grid{display:grid;gap:14px;max-width:840px;margin:0 auto}
    .dialog-bubble{padding:20px 22px;border-radius:14px;background:#f8fafc;border:1px solid #e2e8f0;box-shadow:0 4px 16px rgba(15,23,42,.02)}
    .bubble-client{background:#fffaf8;border-color:#fed7aa}
    .bubble-advisor{background:#f0fdf4;border-color:#bbf7d0}
    .bubble-header{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .bubble-avatar{width:34px;height:34px;display:grid;place-items:center;border-radius:8px;background:#fff;border:1px solid #e2e8f0;font-size:15px}
    .bubble-header div{display:flex;flex-direction:column}
    .bubble-header strong{font-size:14.5px;font-weight:750;color:#222222}
    .bubble-header small{font-size:11px;color:#64748b}
    .bubble-tag{margin-left:auto;padding:3px 9px;border-radius:5px;font-size:11px;font-weight:800;letter-spacing:.03em}
    .tag-problem{background:#ffedd5;color:#c2410c}
    .tag-solution{background:#dcfce7;color:#15803d}
    .bubble-text{margin:0;font-size:14.5px;line-height:1.6;color:#334155}
    .dialog-flow-connector{display:flex;align-items:center;justify-content:center;gap:14px;padding:2px 0}
    .connector-line{flex-grow:1;height:1px;background:#cbd5e1}
    .connector-badge{padding:4px 12px;border-radius:999px;background:#0f172a;color:#fff;font-size:11.5px;font-weight:750;letter-spacing:.02em}
    .dialog-outcome-card{padding:18px 22px;border-radius:14px;background:#ffffff;border:1.5px solid #059669;box-shadow:0 6px 20px rgba(5,150,105,.06)}
    .outcome-pill{font-size:11px;font-weight:850;letter-spacing:.06em;color:#047857;margin-bottom:10px}
    .outcome-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .o-metric strong{display:block;font-size:17px;font-weight:800;color:#0f172a}
    .o-metric span{display:block;margin-top:2px;font-size:12.5px;color:#64748b}

    /* 06 ÇALIŞMA ALANLARI (4 KATEGORİ) */
    .areas-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .area-category-card{padding:22px 24px;border-radius:16px;background:#fff;border:1px solid #d4e3d9;box-shadow:var(--shadow-sm);transition:transform .18s ease,border-color .18s ease}
    .area-category-card:hover{transform:translateY(-2px);border-color:#95cbb0}
    .area-cat-head{display:flex;align-items:center;gap:10px;margin-bottom:14px;border-bottom:1px solid #f1f5f9;padding-bottom:12px}
    .area-cat-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:var(--green-soft);color:var(--green-dark);font-size:14px;font-weight:800}
    .area-cat-head h3{margin:0;font-size:17px;font-weight:750;color:#222222}
    .area-items-list{list-style:none;padding:0;margin:0;display:grid;gap:8px}
    .area-items-list li{display:flex;align-items:flex-start;gap:7px;font-size:14.5px;line-height:1.5;color:#334155}
    .area-items-list li::before{content:"✓";color:var(--green);font-weight:800;flex-shrink:0}

    /* 07 HİZMET KAPSAMLARI (3 SEVİYE) */
    .tiers-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .tier-card{padding:24px 22px;border-radius:16px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;transition:transform .18s ease,border-color .18s ease}
    .tier-card:hover{transform:translateY(-2px)}
    .tier-badge{display:inline-block;align-self:flex-start;padding:4px 9px;border-radius:6px;font-size:11.5px;font-weight:800;margin-bottom:12px;background:var(--soft);color:#475569;border:1px solid #e2e8f0}
    .tier-card.featured{border-color:#059669;box-shadow:0 8px 24px rgba(5,150,105,.08)}
    .tier-card.featured .tier-badge{background:var(--green-soft);color:var(--green-dark);border-color:#a7f3d0}
    .tier-card h3{margin:0 0 8px;font-size:18px;line-height:1.3;font-weight:750;color:#222222}
    .tier-card p{margin:0 0 14px;font-size:14.5px;line-height:1.55;color:#555555;flex-grow:1}
    .tier-list{list-style:none;padding:0;margin:0;display:grid;gap:8px;border-top:1px solid #f1f5f9;padding-top:14px}
    .tier-list li{font-size:14px;color:#334155;line-height:1.45}
    .tiers-footer-note{margin-top:16px;text-align:center;font-size:13.5px;color:#64748b;font-weight:600}

    /* 08 SÜREÇ (4 ADIM) */
    .process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
    .process-card{display:flex;flex-direction:column;min-width:0;padding:20px 18px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm)}
    .process-step{display:flex;align-items:center;gap:8px;margin-bottom:12px}.step-no{width:26px;height:26px;display:grid;place-items:center;border-radius:50%;background:var(--green-soft);color:var(--green-dark);font-size:12px;font-weight:800}.process-step strong{font-size:12.5px;color:var(--muted);font-weight:600}
    .process-card h3{margin:0 0 6px;font-size:16px;line-height:1.35;font-weight:700;color:#222222}.process-card p{margin:0;color:#555555;font-size:14px;line-height:1.55;flex-grow:1}
    .process-art{margin-top:14px;padding:8px;border-radius:8px;background:var(--soft);text-align:center;font-size:15px;color:var(--green)}

    /* 09 NEDEN BİZ */
    .why-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
    .why-card{min-width:0;padding:20px 18px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm)}
    .why-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:#f0f5ff;color:var(--blue);font-size:16px;font-weight:800;margin-bottom:12px}
    .why-card h3{margin:0 0 6px;font-size:16px;line-height:1.35;font-weight:700;color:#222222}.why-card p{margin:0;color:#555555;font-size:14px;line-height:1.55}

    /* 10 GÜVENCE BENTO */
    .section-shield{background:#f8fafc}
    .shield-bento-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:16px;align-items:stretch}
    .shield-card.is-gold{padding:26px;border-radius:18px;background:linear-gradient(145deg,#0c1e34,#132f50);color:#fff;display:flex;flex-direction:column;box-shadow:0 12px 30px rgba(12,30,52,.12)}
    .shield-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .shield-badge{padding:4px 9px;border-radius:5px;background:rgba(217,119,6,.2);border:1px solid #d97706;color:#fbbf24;font-size:11px;font-weight:800;letter-spacing:.05em}
    .shield-icon-pill{font-size:20px}
    .shield-card.is-gold h3{margin:0 0 10px;font-size:20px;line-height:1.25;font-weight:800;color:#fff}
    .shield-card.is-gold p{margin:0 0 16px;font-size:14.5px;line-height:1.6;color:#cbd5e1;flex-grow:1}
    .shield-features{display:grid;gap:8px;padding-top:14px;border-top:1px solid rgba(255,255,255,.12)}
    .shield-features span{font-size:13.5px;color:#7ee2a8;font-weight:600}

    .four-pillars-subgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .pillar-mini-card{padding:16px 18px;border-radius:12px;background:#fff;border:1px solid #e2e8f0}
    .pillar-mini-card small{display:block;font-size:11px;font-weight:800;color:var(--green);letter-spacing:.04em;margin-bottom:4px}
    .pillar-mini-card strong{display:block;font-size:15px;color:#222222;font-weight:750;margin-bottom:4px}
    .pillar-mini-card p{margin:0;font-size:13.5px;color:#555555;line-height:1.5}

    /* 11 KARŞILAŞTIRMA & TESLİM */
    .comparison-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:var(--shadow-sm);margin-bottom:24px}
    .comparison{min-width:600px;display:grid}
    .comparison-head,.comparison-row{display:grid;grid-template-columns:160px repeat(3,minmax(0,1fr));align-items:stretch}
    .comparison-head{background:var(--soft);border-bottom:1px solid var(--line);font-size:13.5px;font-weight:750;color:#222222}.comparison-head div{padding:13px 16px}
    .comparison-row{border-bottom:1px solid #edf1f5;font-size:14px;line-height:1.5}.comparison-row:last-child{border-bottom:none}
    .comparison-row div{padding:13px 16px;display:flex;align-items:center}.comparison-row [role="rowheader"]{font-weight:650;color:#222222;background:rgba(246,248,251,.5)}
    .comparison-row [data-label="Size özel sistem"]{background:var(--green-soft);font-weight:600;color:var(--green-dark)}

    .delivery-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:16px;align-items:stretch;margin-bottom:48px}
    .delivery-card,.fit-card{padding:24px;border-radius:16px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm)}
    .delivery-card h3,.fit-card h3{margin:0 0 12px;font-size:18px;line-height:1.3;font-weight:750;color:#222222}
    .delivery-list{margin:0;padding:0;list-style:none;display:grid;gap:8px}
    .delivery-list li{display:flex;align-items:flex-start;gap:7px;font-size:14.5px;color:#334155;line-height:1.5}
    .delivery-list li::before{content:"✓";color:var(--green);font-weight:800}
    .fit-card{display:flex;flex-direction:column;justify-content:space-between;background:#edf9f2;border-color:#b9dec8}
    .fit-card p{margin:0 0 16px;font-size:14.5px;line-height:1.55;color:#274332}

    .faq-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:32px;align-items:start}
    .faq-copy h2{margin:0 0 10px;font-size:28px;line-height:1.22;font-weight:750;letter-spacing:-.025em;color:#222222}
    .faq-copy p{margin:0;color:#555555;font-size:15px;line-height:1.6}
    .faq-list{display:grid;gap:8px}
    .faq-list details{border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;padding:14px 18px;transition:background .15s ease}
    .faq-list details[open]{background:#fafbfc}
    .faq-list summary{font-size:15.5px;font-weight:700;color:#222222;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between}
    .faq-list summary::-webkit-details-marker{display:none}
    .faq-list summary::after{content:"+";font-size:17px;color:var(--muted);font-weight:400}
    .faq-list details[open] summary::after{content:"−"}
    .faq-list p{margin:10px 0 0;font-size:14.5px;line-height:1.6;color:#444444}

    /* 12 FINAL CTA */
    .cta{padding:54px 0;background:linear-gradient(135deg,#0a4425 0%,#0f5f38 100%);color:#fff}
    .cta-shell{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:36px;align-items:center}
    .cta h2{margin:0 0 12px;font-size:clamp(24px,2.4vw,30px);line-height:1.2;font-weight:750;letter-spacing:-.025em;color:#fff}
    .cta p{margin:0 0 16px;font-size:15.5px;line-height:1.6;color:#d1fae5}
    .cta-points{display:flex;flex-wrap:wrap;gap:8px}
    .cta-points span{padding:6px 12px;border-radius:6px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);font-size:13px;font-weight:600;color:#fff}
    .cta-actions{display:flex;flex-direction:column;gap:10px}
    .cta-actions .btn{min-height:48px;font-size:15px;font-weight:700}
    .cta-actions .btn-primary{background:#fff;color:#064e29;box-shadow:0 8px 20px rgba(0,0,0,.12)}
    .cta-actions .btn-primary:hover{background:#f0fdf4}
    .cta-actions .btn-secondary{background:transparent;border-color:rgba(255,255,255,.3);color:#fff}
    .cta-actions .btn-secondary:hover{background:rgba(255,255,255,.08)}
    .cta-note{margin:4px 0 0;font-size:13px;color:#a7f3d0}

    /* FOOTER */
    .footer{background:#0b1928;color:#94a3b8;padding:48px 0 28px;font-size:14px}
    .footer-grid{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(3,minmax(0,1fr));gap:32px;margin-bottom:36px}
    .footer-brand{display:flex;align-items:center;gap:8px;color:#fff;font-size:17px;font-weight:800;margin-bottom:10px}
    .footer-brand img{width:26px;height:26px}
    .footer-copy{margin:0;font-size:14px;line-height:1.6;color:#94a3b8}
    .footer-col strong{display:block;color:#fff;font-size:14px;font-weight:750;margin-bottom:12px}
