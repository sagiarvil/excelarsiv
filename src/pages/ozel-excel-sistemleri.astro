      stock:{title:'Stok & Satın Alma Kontrolü', systems:['Stok yaşlandırma ve ölü stok radarı','Stokta bağlı nakit ve sipariş noktası','Tedarikçi fiyat geçmişi ve satın alma karşılaştırması']},
      office:{title:'Mali Müşavir / Ofis Operasyonu', systems:['Mükellef iş ve eksik evrak takip sistemi','Son tarih / sorumlu / iş yükü kontrolü','Büro tahsilat ve mükellef kârlılık sistemi']},
      production:{title:'Üretim & Fiili Maliyet', systems:['Reçete ve güncel maliyet sistemi','Standart–fiili maliyet sapması','Fire / kapasite / termin ve minimum kârlı üretim']},
      service:{title:'Hizmet & Proje Kârlılığı', systems:['Adam/saat ve proje gerçek kârlılığı','Personel kapasite ve doluluk takibi','Kapsam dışı iş / ücretsiz mesai kontrolü']},
      control:{title:'Tek Dosya & Kontrol Mimarisi', systems:['Tek veri girişli ortak çalışma düzeni','Kontrol merkezi ve hata locator yapısı','Yönetici karar paneli ve standart raporlama']}
    };

    let currentRole = 'smmm';
    const painList = document.getElementById('pain-list');
    const selectedCount = document.getElementById('selected-count');

    function renderPains() {
      const selected = new Set([...document.querySelectorAll('.pain-check:checked')].map(i => i.value));
      painList.innerHTML = '';
      painCatalog.filter(p => p.roles.includes(currentRole)).forEach(p => {
        const label = document.createElement('label');
        label.className = 'flex items-start gap-3 p-3 rounded-xl border border-line bg-canvas cursor-pointer hover:border-blue/30';
        label.innerHTML = `<input class="pain-check mt-0.5" type="checkbox" value="${p.id}" ${selected.has(p.id) ? 'checked' : ''}><span class="text-sm text-slate-600 leading-snug">${p.label}</span>`;
        painList.appendChild(label);
      });
      document.querySelectorAll('.pain-check').forEach(el => el.addEventListener('change', updateDiagnosis));
      updateDiagnosis();
    }

    document.querySelectorAll('[data-role]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentRole = btn.dataset.role;
        document.querySelectorAll('[data-role]').forEach(b => b.setAttribute('aria-pressed','false'));
        btn.setAttribute('aria-pressed','true');
        renderPains();
      });
    });

    function updateDiagnosis() {
      const selectedIds = [...document.querySelectorAll('.pain-check:checked')].map(i => i.value);
      selectedCount.textContent = `${selectedIds.length} seçildi`;
      const box = document.getElementById('diagnosis-result');
      if (!selectedIds.length) {
        box.classList.add('hidden');
        return;
      }

      const scores = {};
      selectedIds.forEach(id => {
        const item = painCatalog.find(p => p.id === id);
        if (item) scores[item.family] = (scores[item.family] || 0) + 1;
      });
      const topFamily = Object.entries(scores).sort((a,b) => b[1]-a[1])[0][0];
      const family = families[topFamily];
      const method = document.getElementById('current-method').value;
      const frequency = document.getElementById('frequency').value;
      const selectedLabels = selectedIds.map(id => painCatalog.find(p => p.id === id)?.label).filter(Boolean);

      document.getElementById('result-title').textContent = family.title;
      document.getElementById('result-subtitle').textContent = `${selectedIds.length} belirti seçtiniz. Mevcut takip: ${method}. Sorun sıklığı: ${frequency}.`;
      document.getElementById('result-systems').innerHTML = family.systems.map(s => `<li class="flex gap-2"><span class="text-blue font-bold">→</span><span>${s}</span></li>`).join('');

      const roleText = document.querySelector('[data-role][aria-pressed="true"]').textContent.trim();
      const summary = `Barış Bey merhaba. Özel Excel sistemi ihtiyaç teşhisinden geliyorum.%0A%0ARol: ${roleText}%0AMevcut takip: ${method}%0ASıklık: ${frequency}%0A%0ASeçtiğim sorunlar:%0A- ${selectedLabels.join('%0A- ')}%0A%0AÖn teşhis: ${family.title}. Bu yapıyı bizim işleyişimize göre değerlendirmek istiyorum.`;
      document.getElementById('diagnosis-whatsapp').href = `https://api.whatsapp.com/send?phone=905393333303&text=${encodeURI(summary)}`;
      box.classList.remove('hidden');
    }

    document.getElementById('current-method').addEventListener('change', updateDiagnosis);
    document.getElementById('frequency').addEventListener('change', updateDiagnosis);
    renderPains();
  </script>
</body>
</html>
