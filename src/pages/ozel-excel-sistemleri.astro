---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import { SATICI } from '../data/satici';

const mailHref = `mailto:${SATICI.eposta}?subject=${encodeURIComponent('İşletmeye / Muhasebe Ofisine Özel Excel Çalışması Talebi')}&body=${encodeURIComponent('İşletme / ofis türü:\nÇözmek istediğimiz iş:\nŞu an nasıl takip ediyoruz:\nEn çok zaman kaybettiren adım:\nEn sık yaşanan hata / kontrol sorunu:\nYaklaşık kullanıcı sayısı:\nVarsa mevcut Excel / ekran görüntüsü / örnek veri:\n')}`;

const officeNeeds = [
  ['Müşteri / Mükellef Takibi', 'Mükellef, sorumlu personel, hizmet kapsamı ve kritik notları tek yapıda izleyin.'],
  ['Sözleşme ve Tahsilat', 'Ücret, dönem, tahsil edilen / bekleyen tutar ve gecikmeleri görünür hale getirin.'],
  ['Görev ve Dönem Kontrolü', 'Tekrarlayan işler, son tarihler, eksik evrak ve tamamlanma durumlarını takip edin.'],
  ['Ofis Yönetim Görünümü', 'Müşteri, iş yükü, tahsilat ve görev durumunu tek yönetim ekranında okuyun.'],
  ['Veri Düzenleme ve Aktarım', 'Farklı kaynaklardan gelen verileri temizleyin, eşleştirin ve kullanılabilir hale getirin.'],
  ['Mevcut Dosyanın Yeniden Kurulması', 'Yıllardır kullanılan Excel dosyanızı daha sade, kontrollü ve raporlanabilir hale getirin.'],
];

const businessNeeds = [
  ['Nakit Akışı ve Ödeme Planı', 'Tahsilat, ödeme, kredi taksiti ve nakit durumunu kendi verinizle izleyin.'],
  ['Cari / Tahsilat / Risk Takibi', 'Alacak, vade, gecikme ve tahsilat durumunu müşteri bazında görün.'],
  ['Teklif ve Gerçek Kârlılık', 'Maliyet, iskonto, komisyon ve hedef marja göre doğru fiyatı hesaplayın.'],
  ['Stok ve Üretim Kontrolü', 'Stok, reçete, tüketim, üretim ve maliyet verilerini ihtiyacınız kadar ayrıntılı izleyin.'],
  ['Yönetim Raporu / Dashboard', 'Dağınık veriyi KPI, trend ve karar ekranına dönüştürün.'],
  ['Size Özgü Operasyon', 'Hazır yazılımların karşılamadığı işletmeye özgü süreci Excel’e taşıyın.'],
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'İşletme ve Muhasebe Ofislerine Özel Excel Çalışmaları',
  serviceType: 'İhtiyaca özel Excel çalışma sistemi tasarımı',
  url: 'https://excelarsiv.com/ozel-excel-sistemleri',
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  provider: { '@type': 'Person', name: SATICI.gercekKisi, url: 'https://excelarsiv.com/hakkinda' },
};
---

<CommerceLayout
  title="İşletme ve Muhasebe Ofislerine Özel Excel Çalışmaları | Excel Arşiv"
  description="Hazır şablon değil. İşletmenizin veya muhasebe ofisinizin gerçek iş akışını analiz ediyor; ihtiyaca özel Excel takip, kontrol, otomasyon ve raporlama çalışmaları hazırlıyoruz."
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(serviceLd)} /></Fragment>

  <div class="exclusive-page">
    <section class="hero-dark">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="kicker">İŞLETMELER · KOBİ’LER · MUHASEBE / SMMM OFİSLERİ</p>
          <h1>Hazır şablon değil. <span>İşleyişinize göre kurulan özel Excel çalışması.</span></h1>
          <p class="lead">Sizi mevcut bir dosyaya uydurmuyoruz. İşin nerede tekrar ettiğini, hangi kontrolün kişiye bağlı kaldığını, verinin nerede dağıldığını ve yönetimin neyi görmek istediğini analiz edip Excel yapısını buna göre kuruyoruz.</p>
          <div class="hero-actions">
            <a class="btn btn-light" href={mailHref}>İhtiyacımı anlatmak istiyorum</a>
            <a class="btn btn-ghost" href="#cozumler">Çalışma alanlarını görün</a>
          </div>
          <div class="trust-row">
            <span><b>01</b> İhtiyaç analizi</span>
            <span><b>02</b> Özel yapı</span>
            <span><b>03</b> Kontrol + raporlama</span>
          </div>
        </div>

        <aside class="case-panel">
          <div class="case-head">
            <span>GERÇEK PROJE ÖRNEĞİ</span>
            <small>Muhasebe ofisi</small>
          </div>
          <h2>Hazır ürün seçilmedi. Ofisin çalışma biçimi dinlendi ve sistem sıfırdan kuruldu.</h2>
          <div class="case-metrics">
            <div><strong>6 saat</strong><small>ihtiyaç analizi + üretim</small></div>
            <div><strong>10.000 TL</strong><small>gerçekleşen proje bedeli</small></div>
          </div>
          <div class="case-flow">
            <p><b>01</b><span>Mevcut işleyiş ve tekrar eden işler çıkarıldı.</span></p>
            <p><b>02</b><span>Müşteri, sözleşme, tahsilat ve yönetim ihtiyacı tek akışta kurgulandı.</span></p>
            <p><b>03</b><span>Çalışan özel Excel sistemi üretildi ve teslim edildi.</span></p>
          </div>
          <small class="case-note">Bu örnek sabit fiyat veya standart teslim süresi değildir.</small>
        </aside>
      </div>
    </section>

    <section class="statement">
      <div class="shell statement-grid">
        <p class="index">01 / HİZMETİN TANIMI</p>
        <div>
          <h2>Önce dosyayı değil, işi inceliyoruz.</h2>
          <p>Hazır ürünlerde problem önceden tanımlıdır. Bu hizmette ise önce sizin süreçleriniz, veri kaynaklarınız, kontrol noktalarınız ve kullanıcı alışkanlıklarınız anlaşılır. Sonra Excel çalışması sıfırdan veya mevcut dosyanız üzerinden yeniden kurulur.</p>
        </div>
      </div>
    </section>

    <section class="audience-block" id="cozumler">
      <div class="shell audience-layout">
        <div class="audience-title">
          <p class="index">02 / MUHASEBE & SMMM</p>
          <h2>Ofiste her ay tekrar eden işi daha kontrollü hale getirin.</h2>
          <p>Mükellef, tahsilat, görev ve dönem kontrolü farklı dosyalara dağılmışsa; çalışma yapısını ofisinizin gerçek düzenine göre kuruyoruz.</p>
        </div>
        <div class="solution-list">
          {officeNeeds.map(([title, desc], i) => (
            <article><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{desc}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <section class="audience-block alt">
      <div class="shell audience-layout">
        <div class="audience-title">
          <p class="index">03 / İŞLETMELER & KOBİ’LER</p>
          <h2>Dağınık Excel işlerini tek tek değil, sistem olarak ele alın.</h2>
          <p>Teklif, tahsilat, stok, nakit, maliyet ve yönetim raporları arasında elle köprü kuruyorsanız, ihtiyacınız olan ara süreci görünür ve yönetilebilir hale getiriyoruz.</p>
        </div>
        <div class="solution-list">
          {businessNeeds.map(([title, desc], i) => (
            <article><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{desc}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <section class="process-section">
      <div class="shell">
        <div class="process-head">
          <p class="index">04 / ÇALIŞMA AKIŞI</p>
          <h2>Teknik şartname yazmanız gerekmez.</h2>
          <p>İşi anlatmanız yeterli. İhtiyacı teknik yapıya biz çeviriyoruz.</p>
        </div>
        <div class="process-line">
          <article><b>01</b><h3>İşleyişi dinleriz</h3><p>Bugün neyi nasıl yaptığınızı ve nerede zorlandığınızı anlarız.</p></article>
          <article><b>02</b><h3>Kapsamı çıkarırız</h3><p>Girişler, hesaplar, kontroller ve raporlar netleşir.</p></article>
          <article><b>03</b><h3>Çalışmayı kurarız</h3><p>Excel yapısı gerçek kullanıcı akışına göre hazırlanır ve test edilir.</p></article>
          <article><b>04</b><h3>Teslim ederiz</h3><p>Kullanım akışı ve proje kapsamı yazılı şekilde net kalır.</p></article>
        </div>
      </div>
    </section>

    <section class="principle-band">
      <div class="shell principle-grid">
        <div><span>01</span><h3>İş akışı odaklı</h3><p>Hangi hücrenin değil, hangi adımın zaman ve kontrol kaybettirdiğine bakarız.</p></div>
        <div><span>02</span><h3>Finansal bakış</h3><p>Nakit, tahsilat, maliyet ve yönetim görünümünü karar açısından ele alırız.</p></div>
        <div><span>03</span><h3>Kontrollü teslim</h3><p>Girdi, hesap, uyarı ve rapor ekranlarını tek yönlü ve okunabilir akışta kurarız.</p></div>
      </div>
    </section>

    <section class="cta-section">
      <div class="shell cta-card">
        <div>
          <p class="kicker green">BAŞLANGIÇ</p>
          <h2>İhtiyacınızı kısa yazın. Çalışmanın kapsamını birlikte netleştirelim.</h2>
          <p>Mevcut dosyanızı, ekran görüntüsünü veya örnek veriyi paylaşmanız yeterli. Önce ne yapılacağını netleştirir, sonra kapsam ve proje bedelini yazılı olarak belirleriz.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-green" href={mailHref}>İhtiyacımı anlatmak istiyorum</a>
          <a class="phone" href={SATICI.telefonTelHref}>{SATICI.telefon}</a>
          <a class="catalog" href="/sablonlar">Hazır sistemlere bakın →</a>
        </div>
      </div>
    </section>
  </div>
</CommerceLayout>

<style>
  .exclusive-page{--ink:#101914;--green:#167a45;--green2:#22a861;--deep:#071a11;--deep2:#0d281b;--muted:#68746d;--line:#dbe4de;--soft:#f3f7f4;background:#fff;color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  .shell{width:min(1220px,calc(100% - 56px));margin:0 auto}
  .hero-dark{background:linear-gradient(135deg,var(--deep) 0%,#0b2418 55%,#103321 100%);color:#fff;padding:78px 0 66px;border-bottom:1px solid #183d29}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(360px,.65fr);gap:70px;align-items:center}
  .kicker,.index{margin:0;font:800 11px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em}.kicker{color:#7be3a5}.index{color:var(--green)}
  .hero-copy h1{max-width:810px;margin:18px 0 22px;font-size:clamp(50px,6.2vw,82px);line-height:.95;letter-spacing:-.055em;font-weight:820}.hero-copy h1 span{color:#7be3a5}
  .lead{max-width:760px;margin:0;color:#c7d4cc;font-size:18px;line-height:1.75}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border-radius:10px;font-weight:800;text-decoration:none}.btn-light{background:#fff;color:#0c2116}.btn-ghost{border:1px solid #456552;color:#fff}.btn-green{background:var(--green);color:#fff}
  .trust-row{display:flex;gap:26px;flex-wrap:wrap;margin-top:34px;padding-top:22px;border-top:1px solid #294b37;color:#c3d2c9;font-size:13px}.trust-row b{color:#7be3a5;margin-right:6px}
  .case-panel{background:#fff;color:var(--ink);padding:30px;border-radius:18px;box-shadow:0 22px 60px rgba(0,0,0,.22);border-top:4px solid #d2a34a}.case-head{display:flex;justify-content:space-between;gap:16px;align-items:center}.case-head span{font:800 10px/1 ui-monospace,monospace;letter-spacing:.12em;color:#9a6410}.case-head small{color:var(--muted)}.case-panel h2{margin:20px 0;font-size:28px;line-height:1.08;letter-spacing:-.035em}.case-metrics{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:12px;overflow:hidden}.case-metrics div{padding:17px}.case-metrics div+div{border-left:1px solid var(--line)}.case-metrics strong{display:block;font-size:27px}.case-metrics small{color:var(--muted)}.case-flow{margin-top:22px}.case-flow p{display:grid;grid-template-columns:30px 1fr;gap:10px;margin:0;padding:12px 0;border-bottom:1px solid #edf1ee}.case-flow b{color:var(--green)}.case-flow span{color:#4d5a52;line-height:1.5}.case-note{display:block;margin-top:15px;color:#7a847e;line-height:1.5}
  .statement{padding:74px 0}.statement-grid{display:grid;grid-template-columns:260px 1fr;gap:44px;align-items:start}.statement h2,.audience-title h2,.process-head h2,.cta-card h2{margin:0;font-size:clamp(38px,4.4vw,58px);line-height:1;letter-spacing:-.045em}.statement p:not(.index){max-width:780px;color:var(--muted);font-size:17px;line-height:1.8;margin:20px 0 0}
  .audience-block{padding:76px 0;border-top:1px solid var(--line)}.audience-block.alt{background:var(--soft)}.audience-layout{display:grid;grid-template-columns:minmax(300px,.8fr) minmax(0,1.2fr);gap:64px;align-items:start}.audience-title{position:sticky;top:110px}.audience-title h2{margin-top:14px}.audience-title p:not(.index){margin:20px 0 0;color:var(--muted);line-height:1.75;font-size:16px}
  .solution-list{border-top:1px solid var(--line)}.solution-list article{display:grid;grid-template-columns:52px 1fr;gap:20px;padding:23px 0;border-bottom:1px solid var(--line)}.solution-list article>span{font:800 11px/1 ui-monospace,monospace;color:var(--green);padding-top:5px}.solution-list h3{margin:0;font-size:23px;letter-spacing:-.025em}.solution-list p{margin:7px 0 0;color:var(--muted);line-height:1.65}
  .process-section{padding:82px 0;background:#fff}.process-head{max-width:700px}.process-head h2{margin-top:14px}.process-head p:not(.index){color:var(--muted);font-size:16px}.process-line{display:grid;grid-template-columns:repeat(4,1fr);margin-top:42px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.process-line article{padding:26px 24px 30px;border-right:1px solid var(--line)}.process-line article:last-child{border-right:0}.process-line b{color:var(--green);font:800 11px/1 ui-monospace,monospace}.process-line h3{font-size:21px;margin:15px 0 8px}.process-line p{margin:0;color:var(--muted);line-height:1.6;font-size:14px}
  .principle-band{background:#0b2116;color:#fff;padding:52px 0}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0}.principle-grid>div{padding:8px 34px;border-right:1px solid #284536}.principle-grid>div:first-child{padding-left:0}.principle-grid>div:last-child{border-right:0}.principle-grid span{color:#7be3a5;font:800 11px/1 ui-monospace,monospace}.principle-grid h3{font-size:24px;margin:13px 0 8px}.principle-grid p{margin:0;color:#b9cbc0;line-height:1.6}
  .cta-section{padding:72px 0}.cta-card{display:grid;grid-template-columns:1.4fr .6fr;gap:50px;align-items:center;padding:42px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 14px 42px rgba(18,54,33,.07)}.kicker.green{color:var(--green)}.cta-card h2{margin-top:14px}.cta-card p:not(.kicker){color:var(--muted);line-height:1.7;max-width:760px}.cta-actions{display:flex;flex-direction:column;gap:14px;align-items:stretch}.phone,.catalog{text-align:center;color:var(--ink);font-weight:800;text-decoration:none}.catalog{color:var(--green);font-size:14px}
  @media(max-width:980px){.hero-grid,.statement-grid,.audience-layout,.cta-card{grid-template-columns:1fr}.hero-grid{gap:38px}.case-panel{max-width:720px}.audience-title{position:static}.process-line{grid-template-columns:1fr 1fr}.process-line article:nth-child(2){border-right:0}.process-line article:nth-child(-n+2){border-bottom:1px solid var(--line)}.principle-grid{grid-template-columns:1fr}.principle-grid>div{padding:24px 0;border-right:0;border-bottom:1px solid #284536}.principle-grid>div:last-child{border-bottom:0}}
  @media(max-width:680px){.shell{width:calc(100% - 28px)}.hero-dark{padding:50px 0}.hero-copy h1{font-size:46px}.lead{font-size:16px}.hero-actions{flex-direction:column}.btn{width:100%}.trust-row{display:grid;grid-template-columns:1fr}.case-panel{padding:22px}.case-panel h2{font-size:25px}.case-metrics{grid-template-columns:1fr}.case-metrics div+div{border-left:0;border-top:1px solid var(--line)}.statement,.audience-block,.process-section,.cta-section{padding:56px 0}.statement h2,.audience-title h2,.process-head h2,.cta-card h2{font-size:36px}.process-line{grid-template-columns:1fr}.process-line article{border-right:0;border-bottom:1px solid var(--line)}.process-line article:last-child{border-bottom:0}.cta-card{padding:26px}.solution-list article{grid-template-columns:40px 1fr}}
</style>
