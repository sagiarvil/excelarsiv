          "itemListElement":[
            {"@type":"Offer","itemOffered":{"@type":"Service","name":"Nakit Akışı & 13 Haftalık Likidite Projeksiyonu"}},
            {"@type":"Offer","itemOffered":{"@type":"Service","name":"Banka Limit-Risk & Teminat Havuzu Takip Sistemi"}},
