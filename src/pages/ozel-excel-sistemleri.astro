<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Özel Excel Finans & Raporlama Sistemleri | excelarsiv.com</title>
  <meta name="description" content="İşletmenize özel Excel finans, muhasebe, nakit akışı, banka-kredi, stok ve yönetim raporlama sistemleri. Şeffaf formül mimarisi, hızlı prototip ve karar odaklı tasarım." />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Excel Arşiv" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content="Özel Excel Finans & Raporlama Sistemleri | excelarsiv.com" />
  <meta property="og:description" content="İşletmenizin çalışma düzenine göre kurulan, yönetim kararını hızlandıran özel Excel sistemleri." />
