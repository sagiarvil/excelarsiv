---
// Clean, source-owned special systems page — no post-build visual ownership.
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>İşletmeye Özel Excel Sistemleri | ExcelArşiv</title>
  <meta name="description" content="Hazır Excel dosyaları işinize uymuyorsa, nakit, tahsilat, banka, kârlılık, muhasebe ve raporlama süreçlerinize göre özel Excel sistemi kuruyoruz." />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="https://excelarsiv.com/ozel-excel-sistemleri" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://excelarsiv.com/ozel-excel-sistemleri" />
  <meta property="og:title" content="İşletmeye Özel Excel Sistemleri | ExcelArşiv" />
  <meta property="og:description" content="İşinizi hazır bir dosyaya uydurmak yerine, Excel'i mevcut çalışma düzeninize göre kuruyoruz." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@graph":[
      {
        "@type":"BreadcrumbList",
        "itemListElement":[
          {"@type":"ListItem","position":1,"name":"Ana Sayfa","item":"https://excelarsiv.com"},
          {"@type":"ListItem","position":2,"name":"Özel Excel Sistemleri","item":"https://excelarsiv.com/ozel-excel-sistemleri"}
        ]
      },
      {
        "@type":"Service",
        "name":"İşletmeye Özel Excel Sistemleri",
        "serviceType":"İşletmeye özel Excel takip, kontrol ve raporlama sistemi tasarımı",
        "provider":{"@type":"Organization","name":"ExcelArşiv","url":"https://excelarsiv.com"},
        "areaServed":{"@type":"Country","name":"Türkiye"},
        "description":"İşletmenin mevcut dosyalarını, veri girişini, hesaplama kurallarını, kontrol noktalarını ve rapor ihtiyacını inceleyerek çalışma düzenine göre Excel sistemi kurma hizmeti.",
        "url":"https://excelarsiv.com/ozel-excel-sistemleri"
      },
      {
        "@type":"FAQPage",
        "mainEntity":[
          {"@type":"Question","name":"Özel Excel sistemi hazır şablondan nasıl ayrılır?","acceptedAnswer":{"@type":"Answer","text":"Hazır şablon önceden belirlenmiş bir düzene göre çalışır. Özel sistemde veri girişi, hesaplama, kontrol ve raporlama sizin mevcut iş akışınıza göre kurulur."}},
          {"@type":"Question","name":"Mevcut Excel dosyalarım kullanılabilir mi?","acceptedAnswer":{"@type":"Answer","text":"Evet. Kullanılabilir bölümler korunabilir. Tekrar, çelişki veya hata üreten bölümler ise yeni yapıya aynen taşınmaz."}},
          {"@type":"Question","name":"Makro kullanmak zorunlu mu?","acceptedAnswer":{"@type":"Answer","text":"Hayır. İhtiyaç standart Excel işlevleriyle çözülebiliyorsa makro kullanılmaz. Otomasyon gerçekten gerekiyorsa kapsam ayrıca belirlenir."}},
          {"@type":"Question","name":"Fiyat nasıl belirleniyor?","acceptedAnswer":{"@type":"Answer","text":"Fiyat; veri yapısı, sayfa ve rapor sayısı, kontrol ihtiyacı, otomasyon düzeyi ve teslim kapsamına göre belirlenir."}},
          {"@type":"Question","name":"Basit bir ihtiyaç için de özel sistem gerekir mi?","acceptedAnswer":{"@type":"Answer","text":"Hayır. Hazır bir sistem veya daha basit bir çalışma yeterliyse özel geliştirme önermek yerine daha uygun çözüm seçilir."}}
        ]
      }
    ]
  }
  </script>

  <style>
    :root{
      color-scheme:light;
      --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Helvetica Neue",Arial,sans-serif;
      --ink:#1d1d1f;
      --muted:#6e6e73;
      --line:#d2d2d7;
      --soft:#f5f5f7;
      --white:#ffffff;
      --green:#107c41;
      --green-dark:#0b5d31;
      --green-soft:#eef8f2;
      --blue:#0066cc;
      --shadow:0 12px 36px rgba(0,0,0,.06);
      --radius:24px;
      --radius-sm:14px;
      --content:1120px;
      --wide:1240px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--white)}
    body{margin:0;background:var(--white);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.47059;font-weight:400;letter-spacing:-.022em;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    img,svg{display:block;max-width:100%}
    button,input,select,textarea{font:inherit}
    p,h1,h2,h3{overflow-wrap:break-word}
    [id]{scroll-margin-top:86px}

    .skip-link{position:fixed;left:16px;top:12px;z-index:1000;transform:translateY(-160%);padding:10px 14px;border-radius:10px;background:var(--ink);color:#fff;font-size:14px;font-weight:600}
    .skip-link:focus{transform:none}
    a:focus-visible,summary:focus-visible{outline:3px solid rgba(0,102,204,.35);outline-offset:3px;border-radius:8px}

    .wrap{width:min(var(--content),calc(100% - 48px));margin-inline:auto}
    .wrap-wide{width:min(var(--wide),calc(100% - 48px));margin-inline:auto}

    .site-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.92);border-bottom:1px solid rgba(210,210,215,.72);backdrop-filter:saturate(180%) blur(18px)}
    .nav-inner{min-height:64px;display:flex;align-items:center;gap:26px;min-width:0}
    .brand{display:flex;align-items:center;gap:10px;min-width:0;flex:0 0 auto}
    .brand img{width:32px;height:32px}
    .brand-copy{display:flex;align-items:baseline;gap:8px;min-width:0}
    .brand-copy strong{font-size:16px;line-height:1.25;font-weight:600;letter-spacing:-.02em;white-space:nowrap}
    .brand-copy small{font-size:12px;line-height:1.33337;color:var(--muted);font-weight:400;letter-spacing:-.01em;white-space:nowrap}
    .nav-links{display:flex;align-items:center;justify-content:center;gap:24px;margin-inline:auto;min-width:0;font-size:13px;line-height:1.23077;color:#424245;letter-spacing:-.01em}
    .nav-links a{padding:22px 0;white-space:nowrap}
    .nav-links a:hover{color:var(--green)}
    .nav-actions{display:flex;align-items:center;gap:10px;flex:0 0 auto}
    .mobile-menu{display:none;position:relative}
    .mobile-menu summary{width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:50%;background:var(--soft);cursor:pointer;list-style:none}
    .mobile-menu summary::-webkit-details-marker{display:none}
    .burger,.burger::before,.burger::after{display:block;width:17px;height:1.5px;background:var(--ink);position:relative}
    .burger::before,.burger::after{content:"";position:absolute;left:0}
    .burger::before{top:-5px}.burger::after{top:5px}
    .mobile-panel{position:absolute;right:0;top:48px;width:min(320px,calc(100vw - 32px));padding:8px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow)}
    .mobile-panel a{display:block;padding:12px 14px;border-radius:12px;font-size:16px;line-height:1.35}
    .mobile-panel a:hover{background:var(--soft)}

    .btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border:1px solid transparent;border-radius:999px;font-size:17px;line-height:1.17648;font-weight:500;letter-spacing:-.022em;transition:background-color .18s ease,color .18s ease,border-color .18s ease}
    .btn-primary{background:var(--green);color:#fff}
    .btn-primary:hover{background:var(--green-dark)}
    .btn-secondary{background:transparent;border-color:var(--line);color:var(--ink)}
    .btn-secondary:hover{background:var(--soft)}
    .nav-cta{min-height:36px;padding-inline:14px;font-size:14px}

    .hero{padding:72px 0 76px;background:var(--white)}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);gap:64px;align-items:center;min-width:0}
    .hero-copy,.workbook{min-width:0}
    .eyebrow{margin:0 0 16px;color:var(--green);font-size:17px;line-height:1.23536;font-weight:600;letter-spacing:-.022em}
    .hero h1{margin:0;max-width:760px;font-size:clamp(48px,5vw,64px);line-height:1.0625;font-weight:600;letter-spacing:-.045em;text-wrap:balance}
    .hero-lead{max-width:720px;margin:24px 0 0;color:var(--muted);font-size:21px;line-height:1.381;letter-spacing:.011em}
    .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
    .trust-line{margin-top:28px;padding-top:22px;border-top:1px solid var(--line);max-width:720px;color:#424245;font-size:15px;line-height:1.46667;letter-spacing:-.01em}

    .workbook{border:1px solid var(--line);border-radius:26px;background:var(--soft);overflow:hidden;box-shadow:var(--shadow)}
    .wb-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 18px;border-bottom:1px solid var(--line);background:#fff}
    .wb-title{display:flex;align-items:center;gap:9px;min-width:0;font-size:14px;font-weight:600}
    .wb-title img{width:24px;height:24px;flex:0 0 auto}
    .wb-title span{min-width:0;white-space:normal}
    .wb-note{font-size:12px;color:var(--muted);text-align:right;flex:0 1 auto}
    .wb-body{padding:18px;min-width:0}
    .wb-heading{display:flex;justify-content:space-between;gap:14px;align-items:flex-end;margin-bottom:14px}
    .wb-heading strong{font-size:18px;line-height:1.22;font-weight:600}
    .wb-heading span{font-size:12px;line-height:1.35;color:var(--muted);text-align:right}
    .metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .metric{min-width:0;padding:14px;border-radius:14px;background:#fff;border:1px solid #e4e4e8}
    .metric small{display:block;color:var(--muted);font-size:12px;line-height:1.33337;letter-spacing:-.01em}
    .metric strong{display:block;margin-top:6px;font-size:22px;line-height:1.18;font-weight:600;letter-spacing:-.03em}
    .metric span{display:block;margin-top:5px;color:#424245;font-size:13px;line-height:1.38}
    .wb-bottom{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:10px;margin-top:10px}
    .mini-panel{min-width:0;padding:14px;border-radius:14px;background:#fff;border:1px solid #e4e4e8}
    .mini-panel h3{margin:0 0 12px;font-size:15px;line-height:1.3;font-weight:600}
    .bars{height:96px;display:flex;align-items:flex-end;gap:7px;padding-top:8px;border-bottom:1px solid var(--line)}
    .bars i{display:block;flex:1;min-width:0;background:#b9d8c7;border-radius:4px 4px 0 0}
    .bars i:nth-child(1){height:43%}.bars i:nth-child(2){height:55%}.bars i:nth-child(3){height:51%}.bars i:nth-child(4){height:69%;background:#85be9e}.bars i:nth-child(5){height:64%}.bars i:nth-child(6){height:82%;background:var(--green)}
    .check-list{display:grid;gap:9px}
    .check-row{display:grid;grid-template-columns:10px minmax(0,1fr) auto;gap:8px;align-items:center;min-width:0;font-size:13px;line-height:1.35}
    .dot{width:8px;height:8px;border-radius:50%;background:#d9a32a}.check-row:nth-child(2) .dot{background:#c74b50}.check-row:nth-child(3) .dot{background:var(--green)}
    .check-row strong{font-size:12px;font-weight:600}

    .section{padding:92px 0}
    .section-soft{background:var(--soft)}
    .section-head{max-width:820px;margin-bottom:42px}
    .section-head h2{margin:0;font-size:clamp(36px,4vw,48px);line-height:1.08349;font-weight:600;letter-spacing:-.038em;text-wrap:balance}
    .section-head p{margin:18px 0 0;color:var(--muted);font-size:19px;line-height:1.47368;letter-spacing:.012em}

    .problem-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:stretch}
    .problem-card{height:100%;min-width:0;padding:28px;border:1px solid #e1e1e6;border-radius:var(--radius);background:#fff;display:flex;flex-direction:column}
    .problem-card h3{margin:0;font-size:24px;line-height:1.16667;font-weight:600;letter-spacing:-.03em}
    .problem-card p{margin:12px 0 0;color:var(--muted);font-size:17px;line-height:1.47059}

    .process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:stretch}
    .process-card{height:100%;min-width:0;padding:28px;border-top:1px solid var(--line)}
    .process-card span{display:block;margin-bottom:14px;color:var(--green);font-size:15px;line-height:1.33333;font-weight:600}
    .process-card h3{margin:0;font-size:26px;line-height:1.15385;font-weight:600;letter-spacing:-.032em}
    .process-card p{margin:12px 0 0;color:var(--muted);font-size:17px;line-height:1.47059}

    .comparison{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff}
    .comparison-head,.comparison-row{display:grid;grid-template-columns:minmax(140px,1.1fr) repeat(2,minmax(0,1fr)) minmax(0,1.12fr);min-width:0}
    .comparison-head>div,.comparison-row>div{min-width:0;padding:17px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);font-size:15px;line-height:1.4;overflow-wrap:anywhere}
    .comparison-head>div:last-child,.comparison-row>div:last-child{border-right:0}
    .comparison-head>div{background:#f0f0f2;font-weight:600;color:#424245}
    .comparison-head>div:last-child{background:var(--green-soft);color:var(--green-dark)}
    .comparison-row:last-child>div{border-bottom:0}
    .comparison-row>div:first-child{font-weight:600;color:var(--ink);background:#fafafa}
    .comparison-row>div:last-child{background:#f7fbf8}

    .area-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:stretch}
    .area-card{height:100%;min-width:0;padding:24px;border:1px solid #e1e1e6;border-radius:20px;background:#fff}
    .area-card h3{margin:0;font-size:21px;line-height:1.19048;font-weight:600;letter-spacing:-.026em}
    .area-card p{margin:9px 0 0;color:var(--muted);font-size:16px;line-height:1.5}

    .delivery-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:24px;align-items:stretch}
    .delivery-card,.fit-card{min-width:0;border-radius:var(--radius);padding:30px}
    .delivery-card{border:1px solid var(--line);background:#fff}
    .delivery-card h3,.fit-card h3{margin:0;font-size:28px;line-height:1.14286;font-weight:600;letter-spacing:-.034em}
    .delivery-list{margin:22px 0 0;padding:0;list-style:none;display:grid;gap:0}
    .delivery-list li{position:relative;padding:14px 0 14px 28px;border-top:1px solid #e7e7eb;font-size:17px;line-height:1.47059}
    .delivery-list li:first-child{border-top:0}
    .delivery-list li::before{content:"";position:absolute;left:2px;top:21px;width:9px;height:9px;border-radius:50%;background:var(--green)}
    .fit-card{background:var(--green-soft);border:1px solid #cfe5d7}
    .fit-card p{margin:14px 0 0;color:#365244;font-size:17px;line-height:1.5}
    .fit-card .btn{margin-top:24px}

    .faq-grid{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:56px;align-items:start}
    .faq-copy h2{margin:0;font-size:clamp(36px,4vw,48px);line-height:1.08349;font-weight:600;letter-spacing:-.038em}
    .faq-copy p{margin:18px 0 0;color:var(--muted);font-size:18px;line-height:1.5}
    .faq-list{border-top:1px solid var(--line)}
    .faq-list details{border-bottom:1px solid var(--line)}
    .faq-list summary{position:relative;list-style:none;cursor:pointer;padding:20px 42px 20px 0;font-size:19px;line-height:1.31579;font-weight:500}
    .faq-list summary::-webkit-details-marker{display:none}
    .faq-list summary::after{content:"+";position:absolute;right:4px;top:17px;font-size:25px;line-height:1;color:var(--muted);font-weight:300}
    .faq-list details[open] summary::after{content:"−"}
    .faq-list details p{margin:0;padding:0 42px 20px 0;color:var(--muted);font-size:17px;line-height:1.5}

    .cta{padding:96px 0;background:var(--ink);color:#fff}
    .cta-shell{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:48px;align-items:center}
    .cta h2{margin:0;max-width:760px;font-size:clamp(40px,4.6vw,56px);line-height:1.07143;font-weight:600;letter-spacing:-.044em;text-wrap:balance}
    .cta p{margin:18px 0 0;max-width:700px;color:#c7c7cc;font-size:19px;line-height:1.47368}
    .cta-actions{display:grid;gap:12px}
    .cta .btn-primary{background:#fff;color:var(--ink)}
    .cta .btn-primary:hover{background:#e8e8ed}
    .cta .btn-secondary{border-color:#5b5b60;color:#fff}
    .cta .btn-secondary:hover{background:#2c2c2e}

    .footer{padding:28px 0;background:#f5f5f7;color:var(--muted);border-top:1px solid #e1e1e6}
    .footer-grid{display:flex;justify-content:space-between;align-items:center;gap:18px;font-size:12px;line-height:1.33337;letter-spacing:-.01em}
    .footer-nav{display:flex;flex-wrap:wrap;gap:18px}
    .footer-nav a:hover{color:var(--ink)}

    @media(max-width:1040px){
      .brand-copy small{display:none}
      .nav-links{gap:18px}
      .hero-grid{gap:38px}
      .hero h1{font-size:clamp(44px,5.5vw,58px)}
      .area-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    @media(max-width:900px){
      .nav-links{display:none}.mobile-menu{display:block}.nav-actions{margin-left:auto}.nav-actions>.nav-cta{display:none}
      .hero{padding:56px 0 64px}.hero-grid{grid-template-columns:1fr;gap:38px}.hero-copy{max-width:760px}.workbook{max-width:760px}
      .process-grid{grid-template-columns:1fr}.process-card{padding:24px 0}
      .delivery-grid,.faq-grid,.cta-shell{grid-template-columns:1fr}
      .faq-grid,.cta-shell{gap:34px}
    }

    @media(max-width:800px){
      .comparison{border:0;border-radius:0;background:transparent;display:grid;gap:12px;overflow:visible}
      .comparison-head{display:none}
      .comparison-row{grid-template-columns:1fr;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff}
      .comparison-row>div{display:grid;grid-template-columns:minmax(112px,.42fr) minmax(0,1fr);gap:14px;border-right:0;border-bottom:1px solid var(--line);padding:14px 16px;font-size:15px;line-height:1.4;background:#fff!important}
      .comparison-row>div::before{content:attr(data-label);color:var(--muted);font-size:13px;line-height:1.35;font-weight:500}
      .comparison-row>div:first-child{display:block;background:#f5f5f7!important;font-size:17px;font-weight:600}
      .comparison-row>div:first-child::before{display:none}
      .comparison-row>div:last-child{border-bottom:0;background:var(--green-soft)!important}
    }

    @media(max-width:640px){
      .wrap,.wrap-wide{width:min(100% - 32px,var(--wide))}
      body{font-size:17px}
      .site-nav{backdrop-filter:saturate(160%) blur(14px)}.nav-inner{min-height:56px}.brand img{width:30px;height:30px}.brand-copy strong{font-size:15px}
      .hero{padding:44px 0 52px}.eyebrow{font-size:15px}.hero h1{font-size:40px;line-height:1.1;letter-spacing:-.04em}.hero-lead{font-size:19px;line-height:1.42105}.hero-actions{display:grid}.hero-actions .btn{width:100%}.trust-line{font-size:15px}
      .wb-top,.wb-heading{align-items:flex-start;flex-direction:column}.wb-note,.wb-heading span{text-align:left}.wb-body{padding:14px}.metric-grid{grid-template-columns:1fr}.wb-bottom{grid-template-columns:1fr}.metric strong{font-size:21px}
      .section{padding:68px 0}.section-head{margin-bottom:30px}.section-head h2,.faq-copy h2{font-size:32px;line-height:1.125}.section-head p,.faq-copy p{font-size:17px;line-height:1.47059}
      .problem-grid,.area-grid{grid-template-columns:1fr}.problem-card{padding:22px}.problem-card h3{font-size:22px}.area-card{padding:22px}.process-card h3{font-size:24px}
      .delivery-card,.fit-card{padding:24px}.delivery-card h3,.fit-card h3{font-size:25px}.delivery-list li{font-size:16px}
      .faq-list summary{font-size:18px;padding-right:36px}.faq-list details p{padding-right:0}
      .cta{padding:72px 0}.cta h2{font-size:38px;line-height:1.10526}.cta p{font-size:17px}.cta-actions .btn{width:100%}
      .footer-grid{align-items:flex-start;flex-direction:column}.footer-nav{gap:14px}
    }

    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
  </style>
</head>
<body data-special-source-v5>
  <a class="skip-link" href="#icerik">İçeriğe geç</a>

  <header class="site-nav">
    <div class="wrap-wide nav-inner">
      <a class="brand" href="/" aria-label="ExcelArşiv ana sayfa">
        <img src="/images/excel-logo.png" alt="" width="32" height="32" />
        <span class="brand-copy"><strong>ExcelArşiv</strong><small>İşletmeye özel Excel sistemleri</small></span>
      </a>
      <nav class="nav-links" aria-label="Ana menü">
