  <style>
    @font-face{font-family:Manrope;src:url('/fonts/manrope-latin-ext.woff2') format('woff2');font-weight:200 800;font-style:normal;font-display:swap}
    @font-face{font-family:Manrope;src:url('/fonts/manrope-latin.woff2') format('woff2');font-weight:200 800;font-style:normal;font-display:swap}
    @font-face{font-family:'IBM Plex Mono';src:url('/fonts/ibm-plex-mono-500-latin-ext.woff2') format('woff2');font-weight:500;font-style:normal;font-display:swap}
    @font-face{font-family:'IBM Plex Mono';src:url('/fonts/ibm-plex-mono-500-latin.woff2') format('woff2');font-weight:500;font-style:normal;font-display:swap}

    :root{
      color-scheme:light;
      --xl-green:#107c41;--xl-green-dark:#0c5a30;--xl-green-tint:#e9f5ee;--xl-select:#217346;
      --xl-canvas:#fff;--xl-paper:#f8f8f7;--xl-header:#f3f2f1;--xl-head-hov:#e9e8e7;
      --xl-grid:#e5e5e3;--xl-border:#d1d1cf;--xl-ink:#1b1b1f;--xl-ink-2:#44444a;--xl-ink-3:#616166;--xl-blue:#0f6cbd;
      --cf-good-bg:#c6efce;--cf-good-tx:#006100;--cf-warn-bg:#ffeb9c;--cf-warn-tx:#8f5d00;--cf-bad-bg:#ffc7ce;--cf-bad-tx:#9c0006;
      --ch-1:#4472c4;--ch-2:#ed7d31;--ch-6:#70ad47;
      --font-sans:Manrope,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      --font-mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
      --container-main:1180px;--container-wide:1320px;--page-pad-desktop:24px;--page-pad-tablet:20px;--page-pad-mobile:16px;
      --space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-6:24px;--space-8:32px;--space-12:48px;--space-16:64px;
      --r-sm:2px;--r-base:4px;--r-lg:6px;--r-xl:6px;
      --blue-soft:#eef5fc;--amber:#c98212;--amber-soft:#fff6e4;--coral:#cc574b;--coral-soft:#fff1ee;--violet:#6f55c7;--violet-soft:#f2effc;--teal:#128087;--teal-soft:#eaf7f7;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--xl-paper)}
    body{margin:0;background:var(--xl-paper);color:var(--xl-ink);font-family:var(--font-sans);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
    a{color:inherit;text-decoration:none}img,svg{display:block;max-width:100%}button,input,select,textarea{font:inherit}
    .skip-link{position:fixed;left:16px;top:16px;z-index:999;transform:translateY(-180%);padding:12px 16px;background:#fff;color:var(--xl-ink);border:2px solid var(--xl-green);border-radius:var(--r-base);font-weight:800}
    .skip-link:focus{transform:none}
    .wrap{width:min(var(--container-main),calc(100% - 48px));margin-inline:auto}.wrap-wide{width:min(var(--container-wide),calc(100% - 48px));margin-inline:auto}
    .btn{min-height:50px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 20px;border:1px solid var(--xl-border);border-radius:var(--r-lg);font-size:16px;font-weight:800;line-height:1.1;transition:transform .16s ease,background .16s ease,border-color .16s ease}
    .btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--xl-green);border-color:var(--xl-green);color:#fff}.btn-primary:hover{background:var(--xl-green-dark);border-color:var(--xl-green-dark)}.btn-secondary{background:#fff;color:var(--xl-ink)}.btn-secondary:hover{background:var(--xl-green-tint);border-color:#91c6a7}
    .btn:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #8ab8e8;outline-offset:3px}

    .site-nav{position:sticky;top:0;z-index:100;border-bottom:1px solid var(--xl-border);background:rgba(255,255,255,.97);backdrop-filter:blur(14px)}
    .nav-inner{height:72px;display:flex;align-items:center;gap:28px}.brand{display:flex;align-items:center;gap:10px;min-width:max-content}.brand img{width:34px;height:34px}.brand-copy{display:grid;line-height:1}.brand-copy strong{font-size:18px}.brand-copy small{margin-top:5px;font:500 12px/1.25 var(--font-mono);color:var(--xl-ink-3)}
    .nav-links{display:flex;align-items:center;gap:24px;margin-inline:auto;font-size:15px;font-weight:750;color:var(--xl-ink-2)}.nav-links a{padding:26px 0 22px;border-bottom:3px solid transparent}.nav-links a:hover{color:var(--xl-green);border-bottom-color:var(--xl-green)}
    .nav-actions{display:flex;align-items:center;gap:10px}.nav-cta{min-height:44px;font-size:15px}.mobile-menu{display:none;position:relative}.mobile-menu summary{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--xl-border);border-radius:var(--r-lg);background:#fff;cursor:pointer;list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}.burger,.burger::before,.burger::after{display:block;width:18px;height:2px;background:var(--xl-ink)}.burger{position:relative}.burger::before,.burger::after{content:"";position:absolute;left:0}.burger::before{top:-6px}.burger::after{top:6px}.mobile-panel{position:absolute;right:0;top:50px;width:min(310px,calc(100vw - 32px));padding:8px;border:1px solid var(--xl-border);border-radius:var(--r-lg);background:#fff;box-shadow:0 20px 50px rgba(24,35,50,.12)}.mobile-panel a{display:block;min-height:46px;padding:12px;border-radius:var(--r-base);font-size:16px;font-weight:750}.mobile-panel a:hover{background:var(--xl-green-tint);color:var(--xl-green-dark)}

    .special-page-v4{background:var(--xl-paper)}
    .special-page-v4 .section{padding:72px 0;position:relative}.special-page-v4 .section-tight{padding:56px 0}.special-page-v4 .section-head{display:grid;grid-template-columns:210px minmax(0,1fr);gap:40px;align-items:start;margin-bottom:36px}.special-page-v4 .section-head>div:last-child{max-width:820px}.special-page-v4 .kicker{display:inline-flex;align-items:center;width:max-content;padding:8px 10px;border-radius:var(--r-lg);background:var(--xl-green);color:#fff;font:700 14px/1.25 var(--font-mono);letter-spacing:.05em;text-transform:uppercase}.special-page-v4 .section h2,.special-page-v4 .section-title{margin:0;font-size:clamp(32px,4vw,50px);line-height:1.07;letter-spacing:-.035em;text-wrap:balance}.special-page-v4 .section-copy{margin:14px 0 0;max-width:790px;font-size:18px;line-height:1.65;color:var(--xl-ink-2)}

    .hero{position:relative;padding:56px 0 48px;background:#fff;border-top:5px solid var(--xl-green);border-bottom:1px solid var(--xl-border)}
    .hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(16,124,65,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,124,65,.035) 1px,transparent 1px);background-size:38px 38px;pointer-events:none}
    .hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}.hero-copy-block{min-width:0}.hero-breadcrumb{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;font:500 14px/1.4 var(--font-mono);color:var(--xl-ink-3)}.hero h1{margin:0;max-width:650px;font-size:clamp(42px,5vw,66px);line-height:1.01;letter-spacing:-.048em;text-wrap:balance}.hero h1 em{font-style:normal;color:var(--xl-green)}.hero-lead{max-width:650px;margin:22px 0 0;font-size:19px;line-height:1.62;color:var(--xl-ink-2)}.hero-lead strong{color:var(--xl-ink)}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.hero-fit{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.fit-pill{padding:8px 10px;border:1px solid var(--xl-border);border-radius:999px;background:#fff;font:600 14px/1.25 var(--font-mono);color:var(--xl-ink-2)}
    .expertise-line{display:grid;grid-template-columns:36px minmax(0,1fr);gap:12px;align-items:start;margin:24px 0 0;padding:16px;border-left:4px solid var(--xl-green);background:var(--xl-green-tint);font-size:16px;line-height:1.58;color:var(--xl-ink-2)}.expertise-line .expertise-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:var(--r-lg);background:#fff;border:1px solid #abd1bb;color:var(--xl-green-dark);font-weight:900}.expertise-line strong{color:var(--xl-ink)}

    .workbook{min-width:0;overflow:hidden;border:1px solid #bfc7c2;border-radius:var(--r-xl);background:#fff;box-shadow:0 24px 58px rgba(25,38,50,.11)}.workbook::before{content:"";display:block;height:6px;background:linear-gradient(90deg,var(--xl-green) 0 22%,var(--xl-blue) 22% 44%,var(--amber) 44% 63%,var(--coral) 63% 81%,var(--violet) 81% 100%)}
    .wb-titlebar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid var(--xl-grid);background:#fbfcfb}.wb-brand{display:flex;align-items:center;gap:9px;min-width:0;font:700 14px/1.3 var(--font-mono)}.wb-brand img{width:24px;height:24px}.wb-status{font-size:14px;color:var(--xl-green-dark);font-weight:800;white-space:nowrap}.wb-tabs{display:flex;gap:0;border-bottom:1px solid var(--xl-border);background:var(--xl-header);overflow:auto}.wb-tab{padding:10px 14px;min-width:max-content;border-right:1px solid var(--xl-border);font:600 14px/1.2 var(--font-mono);color:var(--xl-ink-2)}.wb-tab.active{background:var(--xl-green-tint);color:var(--xl-green-dark);border-top:3px solid var(--xl-green);padding-top:7px}.wb-body{display:grid;grid-template-columns:116px minmax(0,1fr);min-width:0}.wb-side{padding:14px 10px;border-right:1px solid var(--xl-border);background:#fafbfa}.wb-side b,.wb-side span{display:block;padding:9px 8px;font-size:14px;line-height:1.3}.wb-side b{background:var(--xl-green-tint);color:var(--xl-green-dark);border-left:3px solid var(--xl-green)}.wb-canvas{min-width:0;padding:18px}.wb-canvas-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.wb-canvas-head strong{font-size:20px}.wb-canvas-head span{font:600 13px/1.3 var(--font-mono);color:var(--xl-ink-3)}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.kpi{min-width:0;padding:12px;border:1px solid var(--xl-border);border-top:4px solid var(--xl-green);border-radius:var(--r-lg);background:var(--xl-green-tint)}.kpi:nth-child(2){border-top-color:var(--xl-blue);background:var(--blue-soft)}.kpi:nth-child(3){border-top-color:var(--amber);background:var(--amber-soft)}.kpi:nth-child(4){border-top-color:var(--violet);background:var(--violet-soft)}.kpi small{display:block;font:600 13px/1.25 var(--font-mono);color:var(--xl-ink-3)}.kpi strong{display:block;margin-top:5px;font-size:19px;line-height:1.1}.kpi em{display:block;margin-top:5px;font-style:normal;font-size:13px;line-height:1.35;color:var(--xl-ink-2)}
    .wb-lower{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:10px;margin-top:10px}.wb-panel{border:1px solid var(--xl-border);border-radius:var(--r-lg);background:#fff;padding:14px}.wb-panel h3{margin:0 0 12px;font-size:16px}.chart{height:110px;display:flex;align-items:flex-end;gap:7px;border-bottom:1px solid var(--xl-border);padding:0 4px 5px}.chart i{flex:1;min-width:0;background:var(--xl-green);height:48%;border-radius:2px 2px 0 0}.chart i:nth-child(2){height:63%;background:var(--xl-blue)}.chart i:nth-child(3){height:58%;background:#7a9685}.chart i:nth-child(4){height:76%;background:var(--amber)}.chart i:nth-child(5){height:69%;background:var(--xl-blue)}.chart i:nth-child(6){height:86%;background:var(--xl-green)}.risk-list{display:grid;gap:8px}.risk-row{display:grid;grid-template-columns:12px minmax(0,1fr) auto;gap:8px;align-items:center;font-size:14px;line-height:1.35}.risk-dot{width:9px;height:9px;border-radius:2px;background:var(--amber)}.risk-row:nth-child(2) .risk-dot{background:var(--coral)}.risk-row:nth-child(3) .risk-dot{background:var(--xl-green)}.risk-row strong{font-size:13px}.wb-foot{display:flex;justify-content:space-between;gap:12px;padding:12px 16px;border-top:1px solid var(--xl-border);font-size:14px;line-height:1.4;color:var(--xl-ink-2)}.wb-foot strong{color:var(--xl-green-dark)}

    .decision-strip{padding:28px 0;background:#fff;border-bottom:1px solid var(--xl-border)}.decision-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--xl-border);border-radius:var(--r-xl);overflow:hidden}.decision-item{position:relative;min-width:0;padding:22px;border-right:1px solid var(--xl-border);background:var(--xl-green-tint)}.decision-item:nth-child(2){background:var(--blue-soft)}.decision-item:nth-child(3){background:var(--amber-soft)}.decision-item:nth-child(4){background:var(--coral-soft);border-right:0}.decision-item small{display:inline-flex;padding:5px 7px;border-radius:var(--r-base);background:var(--xl-green);color:#fff;font:700 13px/1.2 var(--font-mono)}.decision-item:nth-child(2) small{background:var(--xl-blue)}.decision-item:nth-child(3) small{background:var(--amber)}.decision-item:nth-child(4) small{background:var(--coral)}.decision-item strong{display:block;margin-top:14px;font-size:20px}.decision-item p{margin:8px 0 0;font-size:16px;line-height:1.55;color:var(--xl-ink-2)}

    .credibility{background:#fff;border-top:5px solid var(--xl-green);border-bottom:1px solid var(--xl-border)}.cred-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:48px;align-items:start}.cred-copy h2{margin:14px 0 0;font-size:clamp(34px,4vw,50px);line-height:1.08;letter-spacing:-.035em}.cred-copy p{margin:18px 0 0;font-size:18px;line-height:1.68;color:var(--xl-ink-2)}.cred-copy .field-quote{margin-top:22px;padding:18px 20px;border-left:4px solid var(--xl-green);background:var(--xl-green-tint);font-size:17px;line-height:1.62;color:var(--xl-ink)}.cred-points{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.cred-card{min-width:0;padding:22px;border:1px solid var(--xl-border);border-top:5px solid var(--xl-green);border-radius:var(--r-xl);background:#fff}.cred-card:nth-child(2){border-top-color:var(--xl-blue);background:var(--blue-soft)}.cred-card:nth-child(3){border-top-color:var(--amber);background:var(--amber-soft)}.cred-card:nth-child(4){border-top-color:var(--teal);background:var(--teal-soft)}.cred-card span{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:var(--r-lg);background:var(--xl-green-tint);color:var(--xl-green-dark);font:800 14px/1 var(--font-mono)}.cred-card:nth-child(2) span{background:#fff;color:var(--xl-blue)}.cred-card:nth-child(3) span{background:#fff;color:#8a5908}.cred-card:nth-child(4) span{background:#fff;color:#0d666b}.cred-card h3{margin:14px 0 0;font-size:20px}.cred-card p{margin:8px 0 0;font-size:16px;line-height:1.58;color:var(--xl-ink-2)}

    #teshis{background:#f6faf7;border-bottom:1px solid #cfe2d6}.diagnosis-shell{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:40px;align-items:start}.diagnosis-copy h2{margin:14px 0 0;font-size:clamp(34px,4vw,50px);line-height:1.08;letter-spacing:-.035em}.diagnosis-copy p{margin:16px 0 0;font-size:18px;line-height:1.65;color:var(--xl-ink-2)}.diagnosis-note{margin-top:20px;padding:16px 18px;border-left:4px solid var(--xl-green);background:#fff;font-size:16px;line-height:1.58;color:var(--xl-ink-2)}.diagnosis-table{overflow:hidden;border:1px solid var(--xl-border);border-radius:var(--r-xl);background:#fff}.diagnosis-head,.diagnosis-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.diagnosis-head>div{padding:13px 15px;background:#3d4650;color:#fff;font:700 14px/1.25 var(--font-mono)}.diagnosis-head>div:nth-child(2){background:var(--xl-blue)}.diagnosis-head>div:nth-child(3){background:var(--xl-green)}.diagnosis-row>div{min-width:0;padding:17px 15px;border-top:1px solid var(--xl-border);border-right:1px solid var(--xl-border);font-size:16px;line-height:1.52;color:var(--xl-ink-2)}.diagnosis-row>div:last-child{border-right:0;background:var(--xl-green-tint)}.diagnosis-row>div:nth-child(2){background:var(--blue-soft)}.diagnosis-row b{display:block;margin-bottom:6px;color:var(--xl-ink);font-size:16px}.diagnosis-row small{display:block;margin-bottom:4px;font:700 13px/1.3 var(--font-mono);color:var(--xl-ink-3)}

