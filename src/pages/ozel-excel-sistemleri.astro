  <style>
    :root{
      color-scheme:light;
      --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Helvetica Neue",Arial,sans-serif;
      --ink:#172033;
      --ink-2:#273246;
      --muted:#647084;
      --line:#dce3ea;
      --paper:#ffffff;
      --soft:#f6f8fb;
      --green:#16834d;
      --green-dark:#0e6a3c;
      --green-soft:#edf9f2;
      --green-mid:#d9f1e3;
      --blue:#2f6fe4;
      --blue-soft:#eef4ff;
      --amber:#f59f1a;
      --amber-soft:#fff6e7;
      --coral:#ef5e5e;
      --coral-soft:#fff0f0;
      --violet:#7c4fe0;
      --violet-soft:#f5f0ff;
      --teal:#188d8d;
      --teal-soft:#eaf8f8;
      --shadow:0 14px 40px rgba(31,55,80,.08);
      --shadow-sm:0 8px 20px rgba(31,55,80,.05);
      --radius:18px;
      --radius-sm:12px;
      --content:1040px;
      --wide:1120px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--paper)}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:15.5px;line-height:1.56;font-weight:400;letter-spacing:-.016em;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    img,svg{display:block;max-width:100%}
    button,input,select,textarea{font:inherit}
    p,h1,h2,h3{overflow-wrap:break-word}
    [id]{scroll-margin-top:82px}

    .skip-link{position:fixed;left:16px;top:12px;z-index:1000;transform:translateY(-160%);padding:8px 12px;border-radius:8px;background:var(--ink);color:#fff;font-size:13px;font-weight:650}.skip-link:focus{transform:none}
    a:focus-visible,summary:focus-visible{outline:3px solid rgba(47,111,228,.32);outline-offset:3px;border-radius:9px}
    .wrap{width:min(var(--content),calc(100% - 64px));margin-inline:auto}
    .wrap-wide{width:min(var(--wide),calc(100% - 64px));margin-inline:auto}

    .site-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.96);border-bottom:1px solid #dfe6e2;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
    .nav-inner{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:20px;min-width:0}
    .brand{display:inline-flex;align-items:center;gap:10px;min-width:0;flex-shrink:0;text-decoration:none}
    .brand img{width:34px;height:34px;border-radius:8px;flex-shrink:0}
    .brand-copy{display:flex;flex-direction:column;line-height:1.15}
    .brand-copy strong{font-size:16.5px;line-height:1.1;font-weight:800;letter-spacing:-.015em;color:#14271d;white-space:nowrap}
    .brand-copy small{font-size:10px;font-weight:600;letter-spacing:.02em;color:#64748b;white-space:nowrap;margin-top:2px}
    .nav-links{display:flex;align-items:center;gap:4px;margin-inline:auto;min-width:0}
    .nav-links a{padding:7px 11px;border-radius:8px;font-size:13px;line-height:1.25;font-weight:600;color:#374740;text-decoration:none;transition:color 150ms ease,background 150ms ease;white-space:nowrap;letter-spacing:-.01em}
    .nav-links a:hover{color:#0b7440;background:#eef7f2}
    .nav-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .nav-cta{display:inline-flex;align-items:center;justify-content:center;height:38px;padding-inline:14px;border-radius:9px;background:#0b7440;color:#ffffff!important;font-size:12.5px;font-weight:750;text-decoration:none;box-shadow:0 6px 16px rgba(11,116,64,.12);transition:background 150ms ease,transform 150ms ease;white-space:nowrap}
    .nav-cta:hover{background:#075f34;transform:translateY(-1px)}
    .mobile-menu{display:none;position:relative}
    .mobile-menu summary{width:38px;height:38px;display:grid;place-content:center;gap:4px;border:1px solid #dfe6e2;border-radius:10px;background:#fff;cursor:pointer;list-style:none;box-shadow:0 4px 12px rgba(15,23,42,.04)}
    .mobile-menu summary::-webkit-details-marker{display:none}
    .mobile-menu summary span{display:block;width:16px;height:1.8px;background:#14271d;border-radius:2px}
    .mobile-menu[open]::before{content:"";position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:150;pointer-events:auto}
    .mobile-panel{position:fixed;top:64px;left:12px;right:12px;max-height:calc(100dvh - 84px);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:12px;border:1px solid #dce5df;border-radius:20px;background:#ffffff;box-shadow:0 24px 60px rgba(15,23,42,.25);z-index:160}
    .mobile-panel-head{padding:6px 8px 10px;border-bottom:1px solid #edf2ee}
    .mobile-panel-head strong{display:block;color:#0f172a;font-size:15px;line-height:1.2;font-weight:800}
    .mobile-panel-head span{display:block;margin-top:3px;color:#64748b;font-size:11.5px;line-height:1.4}
    .mobile-nav-list{display:grid;padding-top:6px}
    .mobile-nav-list a{min-height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;border-radius:10px;color:#14271d;font-size:13.5px;font-weight:650;text-decoration:none}
    .mobile-nav-list a:hover{background:#eef7f2;color:#0b7440}
    .mobile-nav-list a span{color:#8a958e}
    .mobile-panel-cta{display:flex;align-items:center;justify-content:center;min-height:42px;margin-top:8px;border-radius:10px;background:#0b7440;color:#fff!important;font-size:13.5px;font-weight:750;text-decoration:none}

    .btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:0 18px;border:1px solid transparent;border-radius:10px;font-size:14px;line-height:1.2;font-weight:650;letter-spacing:-.015em;transition:transform .18s ease,background-color .18s ease,border-color .18s ease,box-shadow .18s ease}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green);color:#fff;box-shadow:0 8px 18px rgba(22,131,77,.16)}.btn-primary:hover{background:var(--green-dark);box-shadow:0 10px 22px rgba(22,131,77,.20)}.btn-secondary{background:#fff;border-color:#a8cdb8;color:var(--green-dark)}.btn-secondary:hover{background:var(--green-soft);border-color:#7fba99}

    /* 01 NARROW MAGNETIC HERO */
    .hero{position:relative;overflow:hidden;padding:38px 0 34px;background:linear-gradient(135deg,#ffffff 0%,#f8faf9 60%,#eff7f2 100%)}
    .hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(11,116,64,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(11,116,64,.035) 1px,transparent 1px);background-size:24px 24px;mask-image:radial-gradient(ellipse 70% 60% at 50% 40%,#000 60%,transparent 100%);pointer-events:none}
    .hero::after{content:"";position:absolute;right:10%;top:10%;width:380px;height:380px;background:radial-gradient(circle,rgba(5,150,105,.08) 0%,transparent 70%);filter:blur(40px);pointer-events:none}
    .hero>.wrap-wide{width:min(1020px,calc(100% - 48px));margin-inline:auto}
    .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:24px;align-items:center;min-width:0}
    .hero-copy,.workbook{min-width:0}

    .hero-badge{display:inline-flex;align-items:center;gap:7px;margin-bottom:12px;padding:4px 10px;border-radius:999px;background:#fff;border:1px solid #b9dec8;box-shadow:0 2px 8px rgba(11,116,64,.06);font-size:12px;font-weight:700;color:var(--green-dark)}
    .badge-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(22,131,77,.2);animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 3px rgba(22,131,77,.2)}50%{box-shadow:0 0 0 6px rgba(22,131,77,.05)}}
    .badge-sep{color:#cbd5e1}
    .badge-accent{color:#059669;font-weight:600}

    .hero h1{margin:0;max-width:580px;font-size:clamp(28px,2.8vw,36px);line-height:1.14;font-weight:800;letter-spacing:-.035em;text-wrap:balance;color:#0f172a}
    .hero h1 em{font-style:normal;color:var(--green);position:relative}
    .hero-lead{max-width:540px;margin:12px 0 0;color:#475569;font-size:14.5px;line-height:1.58;letter-spacing:-.01em}

    .hero-answer-engine{margin-top:12px;padding:9px 12px;border-radius:10px;background:rgba(22,131,77,.04);border:1px solid rgba(22,131,77,.14);font-size:12px;line-height:1.45;color:#2e4438}
    .hero-answer{margin:0;}
    .hero-answer strong{color:var(--green-dark);font-weight:750}

    .hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
    .btn-magnetic{box-shadow:0 6px 20px rgba(5,150,105,.2)!important}
    .hero-trust-note{margin:10px 0 0;font-size:12px;line-height:1.4;color:#475569}
    .hero-trust-note strong{color:var(--green-dark)}
    .hero-bullets{display:flex;flex-wrap:wrap;gap:8px 14px;margin:14px 0 0;padding:0;list-style:none}
    .hero-bullets li{display:flex;align-items:center;gap:6px;color:#475569;font-size:12.5px;line-height:1.35;font-weight:550}
    .hero-bullets li::before{content:"✓";display:grid;place-items:center;width:16px;height:16px;border:1px solid #82c5a0;border-radius:50%;color:var(--green);font-size:10.5px;font-weight:800;background:#fff}

    .workbook{border:1px solid #cfe0d5;border-radius:16px;background:#fff;overflow:hidden;box-shadow:0 18px 40px -10px rgba(15,23,42,.1),0 6px 16px -4px rgba(15,23,42,.04);transition:transform .2s ease,box-shadow .2s ease}
    .workbook:hover{box-shadow:0 22px 48px -8px rgba(15,23,42,.14),0 8px 20px -4px rgba(15,23,42,.06)}
    .wb-top{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;border-bottom:1px solid var(--line);background:#fafcfb}
    .wb-dots{display:flex;gap:5px}
    .wb-dot{width:9px;height:9px;border-radius:50%;background:#e2e8f0}
    .wb-dot.red{background:#f87171}.wb-dot.yellow{background:#fbbf24}.wb-dot.green{background:#34d399}
    .wb-title{display:flex;align-items:center;gap:6px;min-width:0;font-size:12.5px;font-weight:750;color:#1e293b}
    .wb-title img{width:16px;height:16px}
    .wb-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 7px;border-radius:6px;background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;font-size:10.5px;font-weight:700}
    .wb-tabs{display:flex;gap:4px;padding:6px 12px;background:#f1f5f3;border-bottom:1px solid #e2e9e4}
    .wb-tab{padding:3px 9px;border-radius:6px;font-size:11px;font-weight:700;color:#64748b;cursor:default}
    .wb-tab.active{background:#fff;color:#0f172a;box-shadow:0 1px 3px rgba(0,0,0,.06)}
    .wb-body{padding:10px;background:#fff}
    .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
    .metric{min-width:0;padding:8px 9px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0}
    .metric small{display:block;color:var(--muted);font-size:10.5px;line-height:1.25}
    .metric strong{display:block;margin-top:3px;font-size:14.5px;line-height:1.2;font-weight:800;letter-spacing:-.02em;color:#0f172a}
    .metric span{display:block;margin-top:2px;color:#059669;font-size:10.5px;line-height:1.2;font-weight:600}
    .wb-fx-bar{display:flex;align-items:center;gap:6px;padding:5px 10px;background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:11px}
    .wb-fx-cell{display:inline-block;padding:1px 5px;background:#fff;border:1px solid #cbd5e1;border-radius:4px;font-weight:750;color:#1e293b;font-size:10px}
    .wb-fx-icon{font-weight:800;font-style:italic;color:#64748b;font-size:11.5px;font-family:serif}
    .wb-fx-code{color:#334155;font-weight:600;font-size:10.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
    .wb-fx-code b{color:var(--green-dark);font-weight:750}
    .wb-chart-grid{display:grid;grid-template-columns:minmax(0,1.38fr) minmax(0,.62fr);gap:6px;margin-top:6px}
    .panel{min-width:0;padding:9px 11px;border-radius:9px;background:#fff;border:1px solid #e2e8ee}
    .panel h3, .panel .panel-title{margin:0 0 5px;font-size:12px;line-height:1.3;font-weight:750;display:flex;justify-content:space-between;align-items:center}
    .chart-legend{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:5px;color:var(--muted);font-size:10.5px}
    .chart-legend span{display:flex;align-items:center;gap:4px}
    .chart-legend i{width:7px;height:7px;border-radius:2px}
    .legend-in{background:var(--green)}
    .legend-out{background:var(--coral)}
    .legend-bal{background:var(--blue)}
    .chart-svg-host{width:100%;height:auto;display:block}
    .chart-svg-host svg{width:100%;height:auto;display:block}
    .donut-wrap{display:grid;grid-template-columns:72px minmax(0,1fr);gap:8px;align-items:center}
    .donut-svg-box{width:72px;height:72px;position:relative}
    .donut-svg-box svg{width:100%;height:100%;display:block;transform:rotate(-90deg)}
    .donut-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none}
    .donut-inner strong{font-size:10px;font-weight:800;color:#0f172a;line-height:1.1}
    .donut-inner small{font-size:8px;color:#64748b;font-weight:600}
    .donut-list{display:grid;gap:3px;color:#4f5b6e;font-size:10px}
    .donut-list span{display:flex;align-items:center;justify-content:space-between;gap:4px}
    .donut-list span i{width:6px;height:6px;border-radius:50%;display:inline-block}
    .donut-list span b{font-weight:700;color:#1e293b;font-size:9.5px}
    .wb-lists{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.75fr);gap:6px;margin-top:6px}.data-list,.alert-list{display:grid;gap:6px}.data-row,.alert-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:6px;align-items:center;font-size:11px;color:#445066}.alert-row{grid-template-columns:8px minmax(0,1fr) auto}.alert-row i{width:7px;height:7px;border-radius:50%;background:var(--coral)}.alert-row:nth-child(2) i{background:var(--amber)}.alert-row:nth-child(3) i{background:var(--green)}

    .section{padding:54px 0}.section-soft{background:var(--soft)}.section-green{background:linear-gradient(180deg,#f3fbf6 0%,#fff 100%)}.section-head{max-width:740px;margin:0 auto 28px;text-align:center}.section-head h2{margin:0;font-size:clamp(23px,2.2vw,30px);line-height:1.24;font-weight:750;letter-spacing:-.028em;text-wrap:balance}.section-head p{margin:10px auto 0;max-width:640px;color:var(--muted);font-size:14px;line-height:1.55}.section-kicker{display:inline-flex;align-items:center;gap:7px;margin-bottom:8px;color:var(--green);font-size:11.5px;font-weight:750;letter-spacing:.02em}.section-kicker::before{content:"";width:20px;height:2.5px;border-radius:3px;background:linear-gradient(90deg,var(--green) 0 45%,var(--amber) 45% 70%,var(--violet) 70%)}

    /* 02 MEKANİZMA (6 ADIM) */
    .mech-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .mech-card{padding:18px 16px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;transition:transform .18s ease,border-color .18s ease}
    .mech-card:hover{transform:translateY(-2px);border-color:#b9dec8}
    .mech-num{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:var(--green-soft);color:var(--green-dark);font-size:11.5px;font-weight:800;margin-bottom:10px}
    .mech-card h3{margin:0 0 6px;font-size:14.5px;line-height:1.3;font-weight:750;color:#0f172a}
    .mech-card p{margin:0;font-size:12.5px;line-height:1.5;color:#475569}

    /* 03 SOMUT ÇIKTI (3 KOKPİT) */
    .sample-systems-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .sample-system-card{padding:22px 20px;border-radius:16px;background:#ffffff;border:1px solid #dce4ea;box-shadow:0 6px 20px rgba(15,23,42,.03);display:flex;flex-direction:column;transition:transform .18s ease,box-shadow .18s ease}
    .sample-system-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(15,23,42,.07);border-color:#b9dec8}
    .ssc-tag{display:inline-block;align-self:flex-start;padding:3px 8px;border-radius:6px;font-size:10.5px;font-weight:800;letter-spacing:.04em;margin-bottom:12px}
    .ssc-tag.is-green{background:#ecfdf5;color:#047857;border:1px solid #a7f3d0}
    .ssc-tag.is-blue{background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe}
    .ssc-tag.is-amber{background:#fffbeb;color:#b45309;border:1px solid #fde68a}
    .sample-system-card h3{margin:0 0 10px;font-size:16.5px;line-height:1.3;font-weight:750;color:#0f172a}
    .ssc-box{padding:9px 12px;border-radius:8px;margin-bottom:10px;font-size:12px;line-height:1.45}
    .ssc-box.problem{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .ssc-box.output{background:var(--green-soft);border:1px solid #bbf7d0;color:var(--green-dark);margin-bottom:14px}
    .ssc-box strong{display:block;font-weight:750;margin-bottom:2px}
    .ssc-list{margin:0;padding:0;list-style:none;display:grid;gap:6px;border-top:1px solid #edf2f7;padding-top:14px}
    .ssc-list li{font-size:12.5px;color:#334155;line-height:1.4;font-weight:550}

    /* 04 KENDİNİ TANI / NE ZAMAN (6 PROBLEM KARTI) */
    .problem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .problem-card{position:relative;min-width:0;padding:18px 16px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm);transition:transform .18s ease,box-shadow .18s ease}
    .problem-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
    .problem-card::before{content:"";position:absolute;left:18px;right:18px;top:0;height:3px;border-radius:0 0 3px 3px}
    .problem-card.green::before{background:var(--green)}.problem-card.amber::before{background:var(--amber)}.problem-card.coral::before{background:var(--coral)}.problem-card.violet::before{background:var(--violet)}.problem-card.blue::before{background:var(--blue)}.problem-card.teal::before{background:var(--teal)}
    .problem-icon{width:32px;height:32px;display:grid;place-items:center;border-radius:8px;font-size:14px;font-weight:800;margin-bottom:10px}
    .problem-card.green .problem-icon{background:var(--green-soft);color:var(--green)}.problem-card.amber .problem-icon{background:var(--amber-soft);color:var(--amber)}.problem-card.coral .problem-icon{background:var(--coral-soft);color:var(--coral)}.problem-card.violet .problem-icon{background:var(--violet-soft);color:var(--violet)}.problem-card.blue .problem-icon{background:var(--blue-soft);color:var(--blue)}.problem-card.teal .problem-icon{background:var(--teal-soft);color:var(--teal)}
    .problem-card h3{margin:0 0 6px;font-size:14px;line-height:1.32;font-weight:700;color:#0f172a}.problem-card p{margin:0;color:var(--muted);font-size:12.5px;line-height:1.5}

    /* 05 SAHA SENARYOSU (ÖRNEK SENARYO DİYALOĞU) */
    .section-dialog{background:#ffffff}
    .dialog-bento-grid{display:grid;gap:14px;max-width:820px;margin:0 auto}
    .dialog-bubble{padding:18px 20px;border-radius:14px;background:#f8fafc;border:1px solid #e2e8f0;box-shadow:0 4px 16px rgba(15,23,42,.02)}
    .bubble-client{background:#fffaf8;border-color:#fed7aa}
    .bubble-advisor{background:#f0fdf4;border-color:#bbf7d0}
    .bubble-header{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .bubble-avatar{width:32px;height:32px;display:grid;place-items:center;border-radius:8px;background:#fff;border:1px solid #e2e8f0;font-size:15px}
    .bubble-header div{display:flex;flex-direction:column}
    .bubble-header strong{font-size:13.5px;font-weight:750;color:#0f172a}
    .bubble-header small{font-size:10.5px;color:#64748b}
    .bubble-tag{margin-left:auto;padding:2px 8px;border-radius:5px;font-size:10.5px;font-weight:800;letter-spacing:.03em}
    .tag-problem{background:#ffedd5;color:#c2410c}
    .tag-solution{background:#dcfce7;color:#15803d}
    .bubble-text{margin:0;font-size:13.5px;line-height:1.6;color:#334155}
    .dialog-flow-connector{display:flex;align-items:center;justify-content:center;gap:14px;padding:2px 0}
    .connector-line{flex-grow:1;height:1px;background:#cbd5e1}
    .connector-badge{padding:4px 12px;border-radius:999px;background:#0f172a;color:#fff;font-size:11px;font-weight:750;letter-spacing:.02em}
    .dialog-outcome-card{padding:16px 20px;border-radius:14px;background:#ffffff;border:1.5px solid #059669;box-shadow:0 6px 20px rgba(5,150,105,.06)}
    .outcome-pill{font-size:10.5px;font-weight:850;letter-spacing:.06em;color:#047857;margin-bottom:10px}
    .outcome-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .o-metric strong{display:block;font-size:17px;font-weight:800;color:#0f172a}
    .o-metric span{display:block;margin-top:2px;font-size:11.5px;color:#64748b}

    /* 06 ÇALIŞMA ALANLARI (4 KATEGORİ) */
    .areas-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .area-category-card{padding:20px 22px;border-radius:16px;background:#fff;border:1px solid #d4e3d9;box-shadow:var(--shadow-sm);transition:transform .18s ease,border-color .18s ease}
    .area-category-card:hover{transform:translateY(-2px);border-color:#95cbb0}
    .area-cat-head{display:flex;align-items:center;gap:10px;margin-bottom:12px;border-bottom:1px solid #f1f5f9;padding-bottom:10px}
    .area-cat-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:var(--green-soft);color:var(--green-dark);font-size:13px;font-weight:800}
    .area-cat-head h3{margin:0;font-size:15px;font-weight:750;color:#0f172a}
    .area-items-list{list-style:none;padding:0;margin:0;display:grid;gap:8px}
    .area-items-list li{display:flex;align-items:flex-start;gap:7px;font-size:13px;line-height:1.45;color:#334155}
    .area-items-list li::before{content:"✓";color:var(--green);font-weight:800;flex-shrink:0}

    /* 07 HİZMET KAPSAMLARI (3 SEVİYE) */
    .tiers-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .tier-card{padding:22px 20px;border-radius:16px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;transition:transform .18s ease,border-color .18s ease}
    .tier-card:hover{transform:translateY(-2px)}
    .tier-badge{display:inline-block;align-self:flex-start;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:800;margin-bottom:10px;background:var(--soft);color:#475569;border:1px solid #e2e8f0}
    .tier-card.featured{border-color:#059669;box-shadow:0 8px 24px rgba(5,150,105,.08)}
    .tier-card.featured .tier-badge{background:var(--green-soft);color:var(--green-dark);border-color:#a7f3d0}
    .tier-card h3{margin:0 0 8px;font-size:16px;line-height:1.3;font-weight:750;color:#0f172a}
    .tier-card p{margin:0 0 14px;font-size:13px;line-height:1.52;color:#475569;flex-grow:1}
    .tier-list{list-style:none;padding:0;margin:0;display:grid;gap:6px;border-top:1px solid #f1f5f9;padding-top:12px}
    .tier-list li{font-size:12.5px;color:#334155;line-height:1.4}
    .tiers-footer-note{margin-top:16px;text-align:center;font-size:13px;color:#64748b;font-weight:600}

    /* 08 SÜREÇ (4 ADIM) */
    .process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .process-card{display:flex;flex-direction:column;min-width:0;padding:18px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm)}
    .process-step{display:flex;align-items:center;gap:8px;margin-bottom:12px}.step-no{width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:var(--green-soft);color:var(--green-dark);font-size:11.5px;font-weight:800}.process-step strong{font-size:12px;color:var(--muted);font-weight:600}
    .process-card h3{margin:0 0 6px;font-size:14.5px;line-height:1.3;font-weight:700}.process-card p{margin:0;color:var(--muted);font-size:12.5px;line-height:1.5;flex-grow:1}
    .process-art{margin-top:14px;padding:8px;border-radius:8px;background:var(--soft);text-align:center;font-size:15px;color:var(--green)}

    /* 09 NEDEN BİZ */
    .why-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .why-card{min-width:0;padding:18px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm)}
    .why-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:#f0f5ff;color:var(--blue);font-size:15px;font-weight:800;margin-bottom:12px}
    .why-card h3{margin:0 0 6px;font-size:14.5px;line-height:1.3;font-weight:700}.why-card p{margin:0;color:var(--muted);font-size:12.5px;line-height:1.5}

    /* 10 GÜVENCE BENTO */
    .section-shield{background:#f8fafc}
    .shield-bento-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:16px;align-items:stretch}
    .shield-card.is-gold{padding:24px;border-radius:18px;background:linear-gradient(145deg,#0c1e34,#132f50);color:#fff;display:flex;flex-direction:column;box-shadow:0 12px 30px rgba(12,30,52,.12)}
    .shield-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
    .shield-badge{padding:3px 8px;border-radius:5px;background:rgba(217,119,6,.2);border:1px solid #d97706;color:#fbbf24;font-size:10.5px;font-weight:800;letter-spacing:.05em}
    .shield-icon-pill{font-size:20px}
    .shield-card.is-gold h3{margin:0 0 10px;font-size:18px;line-height:1.25;font-weight:800;color:#fff}
    .shield-card.is-gold p{margin:0 0 16px;font-size:13px;line-height:1.55;color:#cbd5e1;flex-grow:1}
    .shield-features{display:grid;gap:6px;padding-top:12px;border-top:1px solid rgba(255,255,255,.12)}
    .shield-features span{font-size:12px;color:#7ee2a8;font-weight:600}

    .four-pillars-subgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .pillar-mini-card{padding:14px 16px;border-radius:12px;background:#fff;border:1px solid #e2e8f0}
    .pillar-mini-card small{display:block;font-size:10px;font-weight:800;color:var(--green);letter-spacing:.04em;margin-bottom:3px}
    .pillar-mini-card strong{display:block;font-size:13.5px;color:#0f172a;font-weight:750;margin-bottom:4px}
    .pillar-mini-card p{margin:0;font-size:12px;color:#64748b;line-height:1.45}

    /* 11 KARŞILAŞTIRMA & TESLİM */
    .comparison-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:var(--shadow-sm);margin-bottom:24px}
    .comparison{min-width:600px;display:grid}
    .comparison-head,.comparison-row{display:grid;grid-template-columns:160px repeat(3,minmax(0,1fr));align-items:stretch}
    .comparison-head{background:var(--soft);border-bottom:1px solid var(--line);font-size:12px;font-weight:750;color:#2c3748}.comparison-head div{padding:11px 14px}
    .comparison-row{border-bottom:1px solid #edf1f5;font-size:12.5px;line-height:1.45}.comparison-row:last-child{border-bottom:none}
    .comparison-row div{padding:11px 14px;display:flex;align-items:center}.comparison-row [role="rowheader"]{font-weight:650;color:#1e293b;background:rgba(246,248,251,.5)}
    .comparison-row [data-label="Size özel sistem"]{background:var(--green-soft);font-weight:600;color:var(--green-dark)}

    .delivery-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:16px;align-items:stretch;margin-bottom:48px}
    .delivery-card,.fit-card{padding:22px;border-radius:16px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm)}
    .delivery-card h3,.fit-card h3{margin:0 0 12px;font-size:16px;line-height:1.3;font-weight:750}
    .delivery-list{margin:0;padding:0;list-style:none;display:grid;gap:8px}
    .delivery-list li{display:flex;align-items:flex-start;gap:7px;font-size:12.5px;color:#334155;line-height:1.45}
    .delivery-list li::before{content:"✓";color:var(--green);font-weight:800}
    .fit-card{display:flex;flex-direction:column;justify-content:space-between;background:#edf9f2;border-color:#b9dec8}
    .fit-card p{margin:0 0 16px;font-size:13px;line-height:1.5;color:#274332}

    .faq-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:32px;align-items:start}
    .faq-copy h2{margin:0 0 10px;font-size:24px;line-height:1.22;font-weight:750;letter-spacing:-.025em}
    .faq-copy p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.5}
    .faq-list{display:grid;gap:8px}
    .faq-list details{border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;padding:12px 15px;transition:background .15s ease}
    .faq-list details[open]{background:#fafbfc}
    .faq-list summary{font-size:13.5px;font-weight:700;color:#0f172a;cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between}
    .faq-list summary::-webkit-details-marker{display:none}
    .faq-list summary::after{content:"+";font-size:17px;color:var(--muted);font-weight:400}
    .faq-list details[open] summary::after{content:"−"}
    .faq-list p{margin:10px 0 0;font-size:13px;line-height:1.5;color:#475569}

    /* 12 FINAL CTA */
    .cta{padding:54px 0;background:linear-gradient(135deg,#0a4425 0%,#0f5f38 100%);color:#fff}
    .cta-shell{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:36px;align-items:center}
    .cta h2{margin:0 0 12px;font-size:clamp(22px,2.2vw,28px);line-height:1.2;font-weight:750;letter-spacing:-.025em}
    .cta p{margin:0 0 16px;font-size:14px;line-height:1.55;color:#d1fae5}
    .cta-points{display:flex;flex-wrap:wrap;gap:8px}
    .cta-points span{padding:4px 10px;border-radius:6px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);font-size:12px;font-weight:600;color:#fff}
    .cta-actions{display:flex;flex-direction:column;gap:10px}
    .cta-actions .btn{min-height:44px;font-size:14px}
    .cta-actions .btn-primary{background:#fff;color:#064e29;box-shadow:0 8px 20px rgba(0,0,0,.12)}
    .cta-actions .btn-primary:hover{background:#f0fdf4}
    .cta-actions .btn-secondary{background:transparent;border-color:rgba(255,255,255,.3);color:#fff}
    .cta-actions .btn-secondary:hover{background:rgba(255,255,255,.08)}
    .cta-note{margin:3px 0 0;font-size:12px;color:#a7f3d0}

    /* FOOTER */
    .footer{background:#0b1928;color:#94a3b8;padding:48px 0 28px;font-size:13px}
    .footer-grid{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(3,minmax(0,1fr));gap:32px;margin-bottom:36px}
    .footer-brand{display:flex;align-items:center;gap:8px;color:#fff;font-size:16px;font-weight:800;margin-bottom:10px}
    .footer-brand img{width:26px;height:26px}
    .footer-copy{margin:0;font-size:13px;line-height:1.5;color:#64748b}
    .footer-col strong{display:block;color:#fff;font-size:13px;font-weight:750;margin-bottom:10px}
    .footer-col a{display:block;color:#94a3b8;padding:3px 0;font-size:13px;transition:color .15s ease}
    .footer-col a:hover{color:#34d399}
    .footer-bottom{display:flex;align-items:center;justify-content:space-between;padding-top:20px;border-top:1px solid rgba(255,255,255,.08);font-size:12px;color:#64748b}

    @media(max-width:1080px){
      .hero-grid{grid-template-columns:1fr;gap:32px}
      .mech-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .sample-systems-grid{grid-template-columns:1fr}
      .problem-grid,.why-grid,.process-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .tiers-grid{grid-template-columns:1fr}
      .areas-grid{grid-template-columns:1fr}
      .shield-bento-grid{grid-template-columns:1fr}
      .delivery-grid{grid-template-columns:1fr}
      .faq-grid{grid-template-columns:1fr;gap:20px}
      .cta-shell{grid-template-columns:1fr;gap:24px}
      .footer-grid{grid-template-columns:1fr 1fr;gap:24px}
    }
    @media(max-width:800px){
      .wrap{width:calc(100% - 32px)}
      .wrap-wide{width:calc(100% - 32px)}
      .nav-links{display:none}
      .mobile-menu{display:block}
      .hero{padding:34px 0 28px}
      .hero h1{font-size:27px}
      .hero-lead{font-size:14px}
      .section{padding:40px 0}
      .mech-grid,.problem-grid,.why-grid,.process-grid{grid-template-columns:1fr}
      .four-pillars-subgrid{grid-template-columns:1fr}
      .footer-grid{grid-template-columns:1fr}
      .footer-bottom{flex-direction:column;gap:8px;text-align:center}
    }
  </style>
</head>

