    .process-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px;align-items:stretch;margin-top:32px}.process-card{padding:30px;border:1px solid #e0e7f0;border-radius:18px;background:#fff;box-shadow:var(--shadow-sm)}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:26px}.step{position:relative;padding-right:17px}.step:not(:last-child)::after{content:"";position:absolute;top:18px;right:4px;width:calc(100% - 50px);height:1px;background:#c8d7e9;transform:translateX(50%)}.step-num{position:relative;z-index:2;width:38px;height:38px;display:grid;place-items:center;border:1px solid #b9cbe1;border-radius:50%;background:#fff;color:var(--blue);font-size:11px;font-weight:900}.step:nth-child(1) .step-num{border-color:#99d9aa;color:var(--green)}.step:nth-child(3) .step-num{border-color:#c9b5f8;color:#7a4fe0}.step:nth-child(4) .step-num{border-color:#f0bd86;color:#d96b12}.step h3{margin:15px 0 7px;font-size:11px}.step p{margin:0;color:#6a7990;font-size:9px;line-height:1.55}.why-card{position:relative;overflow:hidden;padding:30px;border:1px solid #dfe8e2;border-radius:18px;background:linear-gradient(135deg,#fbfffc,#f4fbf6)}.why-card::after{content:"";position:absolute;right:-55px;bottom:-75px;width:220px;height:220px;border-radius:50%;background:rgba(33,166,74,.06);box-shadow:0 0 0 45px rgba(33,166,74,.035)}.why-list{position:relative;z-index:2;display:grid;gap:13px;margin-top:24px}.why-row{display:flex;align-items:flex-start;gap:10px;color:#435573;font-size:11px}.why-row i{flex:0 0 20px;width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:#e3f7e9;color:var(--green);font-style:normal;font-size:11px;font-weight:900}

    .comparison{padding:78px 0;background:#f8fbff;border-block:1px solid #edf2f8}.compare-shell{overflow:hidden;margin-top:30px;border:1px solid #dfe7f2;border-radius:18px;background:#fff;box-shadow:var(--shadow-sm)}.compare-row{display:grid;grid-template-columns:.82fr 1.05fr 1.13fr;border-top:1px solid #e9eef5}.compare-row:first-child{border-top:0;background:#f6f9fd}.compare-row>div{padding:16px 18px;font-size:11px;line-height:1.55}.compare-row .criteria{font-weight:800;color:#2d4266}.compare-row .old{color:#6a7991}.compare-row .new{position:relative;background:#f5fcf7;border-left:1px solid #d9efdf;color:#304e3a;font-weight:650;padding-left:44px}.compare-row .new::before{content:"✓";position:absolute;left:18px;top:16px;width:18px;height:18px;display:grid;place-items:center;border-radius:50%;background:#ddf6e4;color:var(--green);font-size:10px;font-weight:900}.compare-row.header>div{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.05em;color:#65758e}.compare-row.header .new{padding-left:18px;color:var(--green)}.compare-row.header .new::before{display:none}

