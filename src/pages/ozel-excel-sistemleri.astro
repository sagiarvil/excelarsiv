  <style>
    :root { color-scheme: light; }
    body { background:#F4F6F9; }
    .card { background:#fff; border:1px solid #E2E8F0; border-radius:18px; transition: all 0.25s ease; }
    .choice[aria-pressed="true"] {
      border-color: #2563EB;
      background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
      color: #17324D;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
    }
    .pain-card { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    .pain-card:has(.pain-check:checked) {
      background: #EFF6FF;
      border-color: #3B82F6;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08);
    }
    .pain-card:has(.pain-check:checked) span.pain-label {
      color: #17324D;
      font-weight: 700;
    }
    .pain-check:checked { accent-color: #2563EB; }
    .result-bar { background: linear-gradient(135deg, #0B1E32 0%, #17324D 50%, #2563EB 100%); }
    details[open] summary .chev { transform: rotate(45deg); color: #2563EB; }
    .chev { transition: transform .25s ease, color .25s ease; }
    
    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.03); }
    }
    .pulse-badge { animation: pulse-subtle 3s ease-in-out infinite; }
    
    @media (prefers-reduced-motion: reduce) { 
      * { scroll-behavior: auto !important; transition: none !important; animation: none !important; } 
    }
  </style>
</head>

<body class="text-ink antialiased font-sans selection:bg-blue selection:text-white">
