  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://excelarsiv.com' },
          { '@type': 'ListItem', position: 2, name: 'Özel Excel Sistemleri', item: canonical }
        ]
      },
      {
        '@type': 'Service',
        name: 'Özel Excel Finansal Modelleme ve Raporlama Sistemleri',
        provider: { '@type': 'Organization', name: 'Excel Arşiv', url: 'https://excelarsiv.com' },
        description: 'İşletmeler için finans, muhasebe, nakit akışı, banka-kredi, stok ve yönetim raporlama odaklı özel Excel sistemleri.',
        areaServed: 'TR'
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          { '@type': 'Question', name: 'Özel Excel sistemi hazır şablondan nasıl farklıdır?', acceptedAnswer: { '@type': 'Answer', text: 'Hazır şablon sabit bir akış sunar. Özel sistem; işletmenin veri kaynakları, hesaplama kuralları, kontrol noktaları, yetkileri ve yönetim raporlama ihtiyacına göre tasarlanır.' } },
          { '@type': 'Question', name: 'Muhasebe programı verileri kullanılabilir mi?', acceptedAnswer: { '@type': 'Answer', text: 'Proje kapsamına göre Luca, Logo, Zirve, Mikro ve benzeri sistemlerden alınan Excel veya metin dökümleri özel modele bağlanabilir.' } },
          { '@type': 'Question', name: 'Sistem teslimden sonra değiştirilebilir mi?', acceptedAnswer: { '@type': 'Answer', text: 'Formül ve çalışma mantığı şeffaf teslim edilir. Kapsama göre yeni rapor, kontrol veya veri alanları sonraki sürümlere eklenebilir.' } }
        ]
      }
    ]
  })} />
  <style>
    :root{
      color-scheme:light;
      --bg:#f7f9fc;--surface:#fff;--surface-soft:#f8fbff;--ink:#0b1f41;--ink-2:#31415f;--muted:#65728a;
      --line:#dce4ef;--line-strong:#cbd6e5;--green:#2faf4a;--green-2:#188c37;--green-soft:#eef9f0;
      --blue:#1466d9;--blue-soft:#eef5ff;--navy:#0b2449;--shadow:0 18px 50px rgba(20,52,94,.11);--shadow-sm:0 8px 24px rgba(20,52,94,.07);
      --radius:18px;--max:1440px
    }
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;-webkit-font-smoothing:antialiased}a{text-decoration:none;color:inherit}button,input,textarea,select{font:inherit}.wrap{width:min(var(--max),calc(100% - 64px));margin-inline:auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .site-nav{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.96);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}.nav-inner{min-height:74px;display:flex;align-items:center;gap:26px}.brand{display:flex;align-items:center;gap:11px;min-width:245px}.brand img{width:44px;height:44px;object-fit:contain}.brand-copy{line-height:1}.brand-name{display:block;font-size:22px;font-weight:850;letter-spacing:.015em}.brand-sub{display:block;margin-top:5px;font-size:9px;font-weight:750;letter-spacing:.12em;color:#516078}.nav-links{display:flex;align-items:center;gap:7px;margin-left:auto}.nav-links a{padding:10px 12px;border-radius:10px;font-size:13px;font-weight:700;color:#253553;transition:.16s}.nav-links a:hover{background:#f3f7fb;color:var(--blue)}.nav-links a.active{color:var(--green-2);position:relative}.nav-links a.active:after{content:"";position:absolute;left:12px;right:12px;bottom:4px;height:2px;background:var(--green);border-radius:99px}.nav-contact{display:flex;align-items:center;gap:10px;margin-left:12px}.phone{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;color:#142747;white-space:nowrap}.phone svg{width:18px;height:18px;color:var(--green)}.cta{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 18px;border-radius:9px;font-size:12px;font-weight:800;border:1px solid transparent;transition:.18s ease}.cta.primary{background:var(--green);color:#fff;box-shadow:0 8px 18px rgba(47,175,74,.2)}.cta.primary:hover{background:var(--green-2);transform:translateY(-1px)}.cta.secondary{background:#fff;color:var(--ink);border-color:#cdd8e6}.cta.secondary:hover{border-color:#9db1cb;background:#fbfdff}.mobile-menu{display:none;margin-left:auto}.mobile-menu summary{list-style:none;width:40px;height:40px;display:grid;place-content:center;gap:4px;border:1px solid var(--line);border-radius:10px;background:#fff}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{width:18px;height:2px;background:var(--ink);border-radius:2px}.mobile-links{position:absolute;right:24px;top:66px;width:230px;padding:8px;display:grid;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}.mobile-links a{padding:12px;border-radius:9px;font-size:13px;font-weight:700}.mobile-links a:hover{background:#f5f8fc}
    .hero{position:relative;overflow:hidden;background:#fff;border-bottom:1px solid var(--line)}.hero:before{content:"";position:absolute;left:-260px;top:-260px;width:880px;height:880px;border:1px solid #e3edf9;border-radius:50%;box-shadow:0 0 0 82px rgba(234,243,253,.45),0 0 0 164px rgba(240,246,252,.45);pointer-events:none}.hero:after{content:"";position:absolute;right:-140px;bottom:-130px;width:430px;height:430px;background:radial-gradient(circle at center,rgba(38,123,232,.09) 0 1px,transparent 1.5px);background-size:13px 13px;mask-image:radial-gradient(circle,#000 0 58%,transparent 72%);pointer-events:none}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,.92fr) minmax(540px,1.08fr);gap:54px;align-items:center;padding:58px 0 22px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 11px;border:1px solid #cfe4d4;border-radius:999px;background:rgba(255,255,255,.88);font-size:10px;font-weight:850;letter-spacing:.04em}.eyebrow i{width:8px;height:8px;border-radius:50%;border:2px solid var(--green)}.hero h1{max-width:690px;margin:20px 0 0;font-size:clamp(44px,4.55vw,72px);line-height:1.02;letter-spacing:-.045em;font-weight:850}.hero h1 span{display:block;color:var(--green)}.hero-copy{max-width:640px;margin:22px 0 0;color:#42526d;font-size:16px;line-height:1.7}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.benefit-row{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:35px}.benefit{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:0 18px;border-left:1px solid var(--line)}.benefit:first-child{padding-left:0;border-left:0}.benefit svg{width:28px;height:28px;color:var(--green)}.benefit strong{display:block;font-size:12px}.benefit span{display:block;margin-top:6px;color:#647188;font-size:10px;line-height:1.5}
    .product-window{position:relative;border:1px solid #cfd9e6;border-radius:17px;background:#fff;box-shadow:var(--shadow);overflow:hidden}.window-bar{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid var(--line);background:#fafcff}.window-brand{display:flex;align-items:center;gap:8px;font-size:9px;font-weight:850}.window-brand img{width:18px;height:18px}.window-date{font-size:9px;font-weight:750;color:#40516d;padding:6px 9px;border:1px solid var(--line);border-radius:6px;background:#fff}.erp{display:grid;grid-template-columns:112px 1fr;min-height:415px}.erp-side{padding:14px 10px;border-right:1px solid var(--line);background:#f8fafc}.erp-side .side-title{margin:0 0 11px;padding:0 8px;color:#6b7890;font-size:8px;font-weight:800}.erp-side a{display:flex;align-items:center;gap:7px;padding:9px 8px;border-radius:7px;color:#34435e;font-size:9px;font-weight:700}.erp-side a.active{background:#eaf3ff;color:#0d5bc7}.side-dot{width:6px;height:6px;border:1.5px solid currentColor;border-radius:2px}.erp-main{padding:14px;background:#fbfcfe}.erp-title{margin:0 0 10px;font-size:12px;font-weight:850;letter-spacing:.02em}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.kpi{padding:10px;border:1px solid var(--line);border-radius:8px;background:#fff}.kpi label{display:block;color:#637089;font-size:8px;font-weight:700}.kpi b{display:block;margin-top:6px;font-size:14px;letter-spacing:-.02em}.kpi small{display:block;margin-top:5px;color:var(--green-2);font-size:7px;font-weight:800}.dash-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:8px;margin-top:8px}.panel{border:1px solid var(--line);border-radius:8px;background:#fff;overflow:hidden}.panel-head{padding:9px 10px 7px;font-size:8px;font-weight:850}.chart{position:relative;height:130px;padding:12px 10px}.chart-lines{position:absolute;inset:12px 10px;background:repeating-linear-gradient(to bottom,transparent 0 25px,#edf1f6 26px 27px)}.chart-bars{position:absolute;left:24px;right:18px;bottom:20px;height:92px;display:flex;align-items:flex-end;gap:7px}.chart-bars i{flex:1;background:linear-gradient(#418be8,#1e6fd6);border-radius:2px 2px 0 0}.chart-bars i:nth-child(1){height:42%}.chart-bars i:nth-child(2){height:58%}.chart-bars i:nth-child(3){height:55%}.chart-bars i:nth-child(4){height:79%}.chart-bars i:nth-child(5){height:85%}.chart-bars i:nth-child(6){height:72%}.donut-wrap{height:130px;display:grid;grid-template-columns:1fr .85fr;align-items:center;padding:10px}.donut{width:84px;height:84px;margin:auto;border-radius:50%;background:conic-gradient(#1f6fd0 0 62%,#68a5ee 62% 90%,#cfe2f9 90%);position:relative}.donut:after{content:"";position:absolute;inset:20px;border-radius:50%;background:#fff}.legend{display:grid;gap:8px;color:#56647b;font-size:7px}.legend span:before{content:"";display:inline-block;width:6px;height:6px;margin-right:5px;border-radius:50%;background:#1f6fd0}.legend span:nth-child(2):before{background:#68a5ee}.legend span:nth-child(3):before{background:#cfe2f9}.table-panel{margin-top:8px}.table-row{display:grid;grid-template-columns:1.4fr .8fr .8fr .8fr;gap:6px;padding:7px 10px;border-top:1px solid #eef2f6;font-size:7px;color:#45536d}.table-row.header{border-top:0;background:#f7f9fc;color:#6a768c;font-weight:800}.table-row b{font-weight:850}.status-ok{color:var(--green-2);font-weight:850}
    .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:14px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-sm)}.metric{display:grid;grid-template-columns:38px 1fr;align-items:center;gap:10px;padding:16px 22px;border-left:1px solid var(--line)}.metric:first-child{border-left:0}.metric-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:9px;background:var(--blue-soft);color:var(--blue);font-size:16px;font-weight:900}.metric b{display:block;font-size:22px;letter-spacing:-.03em}.metric span{display:block;margin-top:3px;color:#66738a;font-size:9px}.trust{position:relative;z-index:2;display:grid;grid-template-columns:220px 1fr auto;align-items:center;gap:28px;padding:23px 0;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.trust-title{padding-left:max(32px,calc((100vw - var(--max))/2));font-size:12px;font-weight:850;line-height:1.35}.logos{display:flex;align-items:center;justify-content:space-between;gap:20px;color:#a4adba;filter:grayscale(1);font-size:11px;font-weight:850;letter-spacing:.04em}.logos span{white-space:nowrap}.trust-link{padding-right:max(32px,calc((100vw - var(--max))/2));color:var(--green-2);font-size:11px;font-weight:850;white-space:nowrap}
    .section{padding:62px 0}.section-head{text-align:center;max-width:800px;margin:0 auto}.section-kicker{margin:0 0 10px;color:var(--blue);font-size:10px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.section-title{margin:0;font-size:clamp(28px,3vw,42px);line-height:1.1;letter-spacing:-.035em}.section-copy{max-width:720px;margin:14px auto 0;color:var(--muted);font-size:14px;line-height:1.65}.solutions{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;margin-top:32px}.solution{min-height:210px;display:flex;flex-direction:column;padding:20px;border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:0 4px 14px rgba(17,51,92,.035);transition:.18s}.solution:hover{transform:translateY(-3px);border-color:#bfd0e5;box-shadow:var(--shadow-sm)}.solution-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:9px;background:var(--green-soft);color:var(--green-2);font-weight:900;font-size:17px}.solution h3{margin:16px 0 8px;font-size:13px;line-height:1.35}.solution p{margin:0;color:#67748a;font-size:10px;line-height:1.6}.solution a{margin-top:auto;padding-top:18px;color:var(--green-2);font-size:10px;font-weight:850}.feature-band{margin-top:30px;display:grid;grid-template-columns:repeat(6,1fr);gap:0;border:1px solid var(--line);border-radius:13px;background:#fff;overflow:hidden}.feature{display:grid;grid-template-columns:36px 1fr;gap:10px;padding:18px 20px;border-left:1px solid var(--line)}.feature:first-child{border-left:0}.feature-icon{width:32px;height:32px;display:grid;place-items:center;color:var(--blue);font-size:20px}.feature strong{display:block;font-size:10px}.feature span{display:block;margin-top:6px;color:#6d788c;font-size:8.5px;line-height:1.5}
    .comparison-section{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.comparison{margin-top:30px;border:1px solid var(--line-strong);border-radius:16px;overflow:hidden;background:#fff;box-shadow:var(--shadow-sm)}.compare-head,.compare-row{display:grid;grid-template-columns:.8fr 1fr 1fr}.compare-head{background:#f6f8fb}.compare-head>div,.compare-row>div{padding:15px 18px;border-left:1px solid var(--line)}.compare-head>div:first-child,.compare-row>div:first-child{border-left:0}.compare-head>div{font-size:10px;font-weight:850}.compare-head .winner{background:var(--green-soft);color:var(--green-2)}.compare-row{border-top:1px solid var(--line)}.compare-row>div{font-size:11px;line-height:1.55;color:#5e6b80}.compare-row .criterion{color:#243652;font-weight:800}.compare-row .yes{position:relative;padding-left:46px;background:#fbfefb;color:#2a4657;font-weight:650}.compare-row .yes:before{content:"✓";position:absolute;left:18px;top:14px;width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:#dff5e3;color:var(--green-2);font-weight:900}
    .modules{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:32px}.module{padding:21px;border:1px solid var(--line);border-radius:13px;background:#fff}.module-num{color:var(--green);font-size:11px;font-weight:900}.module h3{margin:10px 0 9px;font-size:13px;line-height:1.35}.module p{margin:0;color:#68758a;font-size:10px;line-height:1.6}.mini-chart{height:72px;margin:16px 0 10px;border:1px solid #edf1f6;border-radius:8px;background:linear-gradient(#fff,#fbfcfe);position:relative;overflow:hidden}.mini-chart:after{content:"";position:absolute;left:10px;right:10px;bottom:14px;height:32px;border-bottom:2px solid var(--green);transform:skewY(-6deg);box-shadow:22px -4px 0 -20px var(--green),44px 5px 0 -20px var(--green),66px -9px 0 -20px var(--green)}.module-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}.module-tags span{padding:5px 7px;border-radius:6px;background:#f6f8fb;color:#67748a;font-size:8px;font-weight:750}
    .process{background:#fff;border-top:1px solid var(--line)}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:30px;border:1px solid var(--line);border-radius:14px;background:#fff;overflow:hidden}.step{position:relative;padding:24px;border-left:1px solid var(--line)}.step:first-child{border-left:0}.step-num{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;border:2px solid #cfe0f4;background:#fff;color:var(--blue);font-size:10px;font-weight:900}.step h3{margin:13px 0 7px;font-size:13px}.step p{margin:0;color:#68758a;font-size:10px;line-height:1.6}.final-cta{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;margin-top:28px;padding:26px 30px;border:1px solid #cdd9e7;border-radius:15px;background:linear-gradient(135deg,#f8fbff,#fff);box-shadow:var(--shadow-sm)}.final-cta h2{margin:0;font-size:24px;letter-spacing:-.025em}.final-cta p{margin:8px 0 0;color:#67748a;font-size:12px}.final-actions{display:flex;gap:10px;align-items:center}
    .faq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:28px}.faq{padding:20px;border:1px solid var(--line);border-radius:12px;background:#fff}.faq h3{margin:0;font-size:13px}.faq p{margin:9px 0 0;color:#68758a;font-size:10px;line-height:1.65}.footer{background:#fff;border-top:1px solid var(--line)}.footer-inner{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:28px}.footer-brand{display:flex;align-items:center;gap:10px}.footer-brand img{width:31px;height:31px}.footer-brand b{font-size:14px}.footer-copy{color:#718097;font-size:9px}.footer-links{display:flex;align-items:center;gap:20px;color:#53617a;font-size:10px;font-weight:700}
    @media(max-width:1180px){.wrap{width:min(var(--max),calc(100% - 40px))}.nav-links{display:none}.mobile-menu{display:block}.nav-contact .phone{display:none}.hero-grid{grid-template-columns:1fr 1fr;gap:30px}.hero h1{font-size:50px}.benefit-row{grid-template-columns:repeat(2,1fr);gap:18px}.benefit:nth-child(3){border-left:0;padding-left:0}.solutions{grid-template-columns:repeat(3,1fr)}.feature-band{grid-template-columns:repeat(3,1fr)}.feature:nth-child(4){border-left:0;border-top:1px solid var(--line)}.feature:nth-child(5),.feature:nth-child(6){border-top:1px solid var(--line)}.modules{grid-template-columns:repeat(3,1fr)}}
    @media(max-width:860px){.wrap{width:min(100% - 28px,var(--max))}.site-nav{position:relative}.nav-inner{min-height:64px}.brand{min-width:0}.brand img{width:36px;height:36px}.brand-name{font-size:18px}.brand-sub{display:none}.nav-contact .cta{display:none}.hero-grid{grid-template-columns:1fr;padding-top:36px}.hero h1{font-size:clamp(40px,11vw,60px)}.product-window{margin-top:6px}.metrics{grid-template-columns:repeat(2,1fr)}.metric:nth-child(3){border-left:0;border-top:1px solid var(--line)}.metric:nth-child(4){border-top:1px solid var(--line)}.trust{grid-template-columns:1fr;text-align:center;padding:18px 14px}.trust-title,.trust-link{padding:0}.logos{flex-wrap:wrap;justify-content:center}.solutions{grid-template-columns:repeat(2,1fr)}.comparison{overflow-x:auto}.compare-head,.compare-row{min-width:760px}.modules{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(2,1fr)}.step:nth-child(3){border-left:0;border-top:1px solid var(--line)}.step:nth-child(4){border-top:1px solid var(--line)}.final-cta{grid-template-columns:1fr}.faq-grid{grid-template-columns:1fr}.footer-inner{flex-direction:column;align-items:flex-start;padding:24px 0}.footer-links{flex-wrap:wrap}}
    @media(max-width:560px){.hero{overflow:hidden}.hero-grid{padding:28px 0 18px}.hero h1{font-size:40px}.hero-copy{font-size:14px}.hero-actions{display:grid}.hero-actions .cta{width:100%}.benefit-row{grid-template-columns:1fr}.benefit,.benefit:first-child,.benefit:nth-child(3){padding:12px 0;border-left:0;border-top:1px solid var(--line)}.benefit:first-child{border-top:0}.erp{grid-template-columns:78px 1fr;min-height:350px}.erp-side{padding-inline:6px}.erp-side a{font-size:7px;padding:8px 5px}.kpis{grid-template-columns:repeat(2,1fr)}.kpi:nth-child(n+3){display:none}.dash-grid{grid-template-columns:1fr}.dash-grid .panel:nth-child(2){display:none}.product-window{border-radius:12px}.metrics{grid-template-columns:1fr}.metric,.metric:nth-child(3){border-left:0;border-top:1px solid var(--line)}.metric:first-child{border-top:0}.solutions{grid-template-columns:1fr}.feature-band{grid-template-columns:1fr}.feature,.feature:nth-child(4){border-left:0;border-top:1px solid var(--line)}.feature:first-child{border-top:0}.modules{grid-template-columns:1fr}.steps{grid-template-columns:1fr}.step,.step:nth-child(3){border-left:0;border-top:1px solid var(--line)}.step:first-child{border-top:0}.final-actions{display:grid;width:100%}.final-actions .cta{width:100%}.section{padding:48px 0}}
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
