    .solutions{padding:56px 0 52px;background:linear-gradient(180deg,#fbfdff 0%,#fff 100%)}.solutions-head{text-align:center}.solutions-head .section-title{margin-inline:auto;font-size:30px;letter-spacing:-.035em}.solution-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;margin-top:27px}.solution-card{min-height:185px;padding:18px;border:1px solid #e1e8f1;border-radius:13px;background:#fff;box-shadow:0 9px 24px rgba(23,53,94,.06);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.solution-card:hover{transform:translateY(-3px);border-color:#b9cce5;box-shadow:0 15px 30px rgba(23,53,94,.09)}.solution-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:8px;background:linear-gradient(180deg,#4ac56a,#249d47);color:#fff;box-shadow:0 6px 14px rgba(33,166,74,.2)}.solution-icon svg{width:21px;height:21px}.solution-card h3{margin:16px 0 8px;font-size:12px;line-height:1.35}.solution-card p{margin:0;color:#687892;font-size:9px;line-height:1.6}.solution-link{display:inline-flex;align-items:center;gap:6px;margin-top:18px;color:var(--green);font-size:9px;font-weight:900}.solution-link svg{width:12px;height:12px}

