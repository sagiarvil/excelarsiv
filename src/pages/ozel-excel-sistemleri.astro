---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import { SATICI } from '../data/satici';

const mailHref = `mailto:${SATICI.eposta}?subject=${encodeURIComponent('İşletmeye / Muhasebe Ofisine Özel Excel Çalışması Talebi')}&body=${encodeURIComponent('İşletme / ofis türü:\nÇözmek istediğimiz iş:\nŞu an nasıl takip ediyoruz:\nEn çok zaman kaybettiren adım:\nEn sık yaşanan hata / kontrol sorunu:\nYaklaşık kullanıcı sayısı:\nVarsa mevcut Excel / ekran görüntüsü / örnek veri:\n')}`;

const serviceLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://excelarsiv.com/ozel-excel-sistemleri#service',
      name: 'İşletme ve Muhasebe Ofislerine Özel Excel Çalışma Sistemleri',
      serviceType: 'İhtiyaca özel Excel çalışma sistemi tasarımı ve süreç otomasyonu',
      url: 'https://excelarsiv.com/ozel-excel-sistemleri',
      areaServed: { '@type': 'Country', name: 'Türkiye' },
      provider: {
        '@type': 'Person',
        name: SATICI.gercekKisi,
        url: 'https://excelarsiv.com/hakkinda',
      },
      description: 'Hazır şablon satışı değil; işletmenin veya muhasebe ofisinin mevcut işleyişi analiz edilerek ihtiyaca özel Excel çalışma sistemi hazırlanması.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Excel Arşiv', item: 'https://excelarsiv.com/' },
        { '@type': 'ListItem', position: 2, name: 'Size Özel Excel Çalışmaları', item: 'https://excelarsiv.com/ozel-excel-sistemleri' },
      ],
    },
  ],
};
---

<CommerceLayout
  title="İşletme ve Muhasebe Ofislerine Özel Excel Çalışmaları | Excel Arşiv"
  description="Hazır şablon değil. İşletmenizin veya muhasebe ofisinizin gerçek iş akışını analiz ediyor; kullandığınız verilere, kontrollere ve raporlama ihtiyacına göre size özel Excel çalışma sistemi hazırlıyoruz."
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(serviceLd)} /></Fragment>

  <main class="custom-service-page">
    <section class="service-strip">
      <div class="shell strip-inner">
        <strong>HAZIR ŞABLON DEĞİL</strong>
        <span>İşletmenizin veya muhasebe ofisinizin kendi işleyişine göre hazırlanan özel Excel çalışma sistemleri.</span>
      </div>
    </section>

    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">İŞLETMELER · KOBİ'LER · MUHASEBE / SMMM OFİSLERİ</p>
          <h1>İşinizi bize anlatın. <span>Excel çalışmasını işinize göre biz kuralım.</span></h1>
          <p class="lead">Elinizdeki hazır bir tabloyu size satmıyoruz. Hangi bilgiyi nereden aldığınızı, hangi işi hâlâ elle yaptığınızı, nerede hata çıktığını ve hangi rapora ihtiyaç duyduğunuzu anlayıp Excel dosyasını buna göre hazırlıyoruz.</p>

          <div class="hero-points">
            <div><b>01</b><span><strong>Mevcut işleyişinizi okuruz.</strong> Teknik şartname yazmanız gerekmez.</span></div>
            <div><b>02</b><span><strong>Excel'i işinize göre tasarlarız.</strong> Sizi hazır şablona uydurmaya çalışmayız.</span></div>
            <div><b>03</b><span><strong>Kontrol ve raporlamayı sisteme taşırız.</strong> Tekrarlı işi ve manuel kontrolü azaltırız.</span></div>
          </div>

          <div class="actions">
            <a class="btn primary" href={mailHref}>İhtiyacımı anlatmak istiyorum</a>
            <a class="btn secondary" href={SATICI.telefonTelHref}>Telefonla görüşelim</a>
          </div>

          <p class="micro">Mevcut Excel dosyanızı, ekran görüntüsünü veya çalışma biçiminizi paylaşmanız yeterli. Önce ihtiyacı netleştirir, sonra kapsam ve proje bedelini yazılı olarak belirleriz.</p>
        </div>

        <aside class="proof-card">
          <span class="proof-label">GERÇEK PROJE ÖRNEĞİ</span>
          <p class="proof-type">Muhasebe ofisine özel çalışma</p>
          <h2>Hazır ürün seçilmedi. Ofisin ihtiyacı dinlendi ve çalışma sıfırdan kuruldu.</h2>
          <div class="proof-metrics">
            <div><strong>6 saat</strong><small>ihtiyaç analizi + üretim</small></div>
            <div><strong>10.000 TL</strong><small>gerçekleşen proje bedeli</small></div>
          </div>
          <ol>
            <li><b>1</b><span>Ofisin müşteri ve çalışma düzeni anlatıldı.</span></li>
            <li><b>2</b><span>Müşteri, sözleşme, tahsilat ve yönetim ihtiyacı birlikte ele alındı.</span></li>
            <li><b>3</b><span>İhtiyaca göre çalışan özel Excel sistemi üretildi.</span></li>
          </ol>
          <small class="proof-note">Bu örnek sabit fiyat veya standart teslim süresi değildir; gerçekleşmiş bir proje örneğidir.</small>
        </aside>
      </div>
    </section>

    <section class="distinction">
      <div class="shell">
        <div class="section-head narrow">
          <p class="eyebrow">BURADAKİ HİZMET NEDİR?</p>
          <h2>ExcelArşiv'deki hazır ürünlerden farklı bir çalışma.</h2>
          <p>Hazır sistemlerde ihtiyacı önceden tanımlanmış bir Excel çalışmasını satın alırsınız. Bu sayfadaki hizmette ise önce sizin işiniz analiz edilir; dosya, ekranlar, hesap mantığı ve raporlama yapısı ihtiyacınıza göre hazırlanır.</p>
        </div>

        <div class="difference-grid">
          <article class="muted-card">
            <small>HAZIR ÜRÜNLER</small>
            <h3>Önceden tanımlanmış ihtiyaca hazır Excel sistemi</h3>
            <p>Nakit akışı, cari takip, stok, maliyet gibi belirli bir problem için önceden hazırlanmış çalışma.</p>
            <a href="/sablonlar">Hazır sistemleri inceleyin →</a>
          </article>
          <article class="accent-card">
            <small>SİZE ÖZEL HİZMET</small>
            <h3>Sizin iş akışınıza göre sıfırdan hazırlanan Excel çalışması</h3>
            <p>İşletmenizin veya muhasebe ofisinizin mevcut düzeni, veri kaynakları, kontrol ihtiyacı ve kullanıcı alışkanlıklarına göre tasarlanır.</p>
            <a href={mailHref}>Özel çalışmayı anlatın →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="persona-section" id="muhasebe-ofisleri">
      <div class="shell persona-grid">
        <div class="persona-intro">
          <p class="eyebrow">MUHASEBE / SMMM OFİSLERİ</p>
          <h2>Ofisinizde her ay tekrar edilen işi Excel'e bırakın.</h2>
          <p>Muhasebe ofislerinde sorun çoğu zaman “Excel bilmeme” değildir. Aynı veriyi tekrar tekrar girmek, mükellefleri farklı dosyalarda izlemek, tahsilatı ayrı takip etmek ve dönemsel kontrolleri kişiye bağlı yürütmektir.</p>
          <p>Bu işleyişi dinleyip ofisinize özel takip ve yönetim tabloları hazırlıyoruz.</p>
        </div>

        <div class="needs-grid">
          <article><span>01</span><h3>Müşteri / Mükellef Takibi</h3><p>Mükellef bilgileri, sorumlu personel, hizmet kapsamı, dönem ve kritik notların tek yapıda izlenmesi.</p></article>
          <article><span>02</span><h3>Sözleşme ve Tahsilat</h3><p>Ücret, sözleşme dönemi, tahsil edilen / bekleyen tutar ve gecikmelerin görünür hale gelmesi.</p></article>
          <article><span>03</span><h3>Görev ve Dönem Kontrolü</h3><p>Tekrarlayan işlerin, son tarihlerin, eksik evrakların ve tamamlanma durumlarının kontrollü takibi.</p></article>
          <article><span>04</span><h3>Ofis Yönetim Paneli</h3><p>Müşteri, iş yükü, tahsilat ve görev durumunun yöneticinin tek bakışta okuyacağı özet ekrana dönüşmesi.</p></article>
          <article><span>05</span><h3>Veri Düzenleme ve Aktarım Hazırlığı</h3><p>Farklı kaynaklardan gelen verilerin Excel içinde temizlenmesi, eşleştirilmesi ve kullanılabilir yapıya getirilmesi.</p></article>
          <article><span>06</span><h3>Mevcut Dosyanın Yeniden Kurulması</h3><p>Yıllardır kullanılan ofis Excel'inin daha kontrollü, sade ve raporlanabilir hale getirilmesi.</p></article>
        </div>
      </div>
    </section>

    <section class="persona-section business" id="isletmeler">
      <div class="shell persona-grid reverse">
        <div class="persona-intro">
          <p class="eyebrow">İŞLETMELER / KOBİ'LER</p>
          <h2>ERP'nin dışında kalan günlük işi, size özel Excel sistemiyle kontrol altına alın.</h2>
          <p>Birçok işletmede ERP veya muhasebe programı vardır; fakat teklif, tahsilat, stok kontrolü, nakit planı, maliyet, saha verisi veya yönetim raporu hâlâ ayrı Excel dosyalarında yürür.</p>
          <p>Biz o boşluğu hedefleriz: işletmenin gerçekten kullandığı ara süreci daha kontrollü, hızlı ve yönetilebilir hale getiririz.</p>
        </div>

        <div class="needs-grid">
          <article><span>01</span><h3>Nakit Akışı ve Ödeme Planı</h3><p>Tahsilat, ödeme, kredi taksiti ve nakit durumunu işletmenin kendi verisine göre izleyen çalışma.</p></article>
          <article><span>02</span><h3>Cari / Tahsilat / Risk Takibi</h3><p>Müşteri bazlı alacak, vade, gecikme ve tahsilat durumunun tek ekranda görünmesi.</p></article>
          <article><span>03</span><h3>Teklif ve Gerçek Kârlılık</h3><p>Maliyet, iskonto, komisyon ve hedef marjınıza göre işletmenize özel teklif / fiyatlama tablosu.</p></article>
          <article><span>04</span><h3>Stok ve Üretim Kontrolü</h3><p>Stok, reçete, tüketim, üretim ve maliyet verilerinin ihtiyaç duyulan ayrıntıda izlenmesi.</p></article>
          <article><span>05</span><h3>Yönetim Raporu / Dashboard</h3><p>Dağınık verinin KPI, özet, trend ve yönetim karar ekranına dönüştürülmesi.</p></article>
          <article><span>06</span><h3>Size Özgü Operasyon</h3><p>Piyasadaki hazır yazılımların tam karşılamadığı, yalnız sizin işletmenize özgü süreçlerin Excel'e taşınması.</p></article>
        </div>
      </div>
    </section>

    <section class="method">
      <div class="shell method-grid">
        <div>
          <p class="eyebrow">NASIL ÇALIŞIYORUZ?</p>
          <h2>Önce dosyayı değil, işi inceliyoruz.</h2>
          <p>Bir Excel çalışmasının gerçekten işe yaraması için hesap kadar kullanıcı davranışını, veri kaynağını ve kontrol noktalarını da anlamak gerekir.</p>
        </div>
        <div class="method-steps">
          <div><b>1</b><strong>İhtiyacı anlatın</strong><span>Şu an nasıl çalıştığınızı, nerede zorlandığınızı ve görmek istediğiniz sonucu anlatın.</span></div>
          <div><b>2</b><strong>Mevcut yapıyı inceleyelim</strong><span>Varsa Excel dosyanız, ekran görüntüsü veya örnek veriniz üzerinden gerçek akışı okuyalım.</span></div>
          <div><b>3</b><strong>Kapsamı yazılı netleştirelim</strong><span>Hangi ekranların, kontrollerin, hesapların ve raporların hazırlanacağı net olsun.</span></div>
          <div><b>4</b><strong>Çalışmayı üretip test edelim</strong><span>Excel sistemi hazırlanır; kritik hesaplar ve kullanıcı akışı test edilerek teslim edilir.</span></div>
        </div>
      </div>
    </section>

    <section class="why-us">
      <div class="shell why-grid">
        <div class="why-copy">
          <p class="eyebrow">NEDEN BU YAKLAŞIM?</p>
          <h2>İşletme dilini anlayan Excel çalışması.</h2>
          <p>Ticari bankacılık ve saha tecrübesi sayesinde yalnız “hangi formül lazım?” sorusuna bakmıyoruz. Paranın, tahsilatın, stokun, satışın ve kontrolün işletmede nasıl hareket ettiğini okuyup teknik yapıyı buna göre kuruyoruz.</p>
        </div>
        <div class="why-cards">
          <article><strong>İş akışını anlama</strong><p>Talebi teknik terim beklemeden, işletmenin günlük çalışma dili üzerinden çözümleme.</p></article>
          <article><strong>Kontrollü kullanım</strong><p>Girdi, hesap ve rapor alanlarını birbirinden ayıran; kullanıcı hatası riskini azaltan yapı.</p></article>
          <article><strong>Yönetim görünürlüğü</strong><p>Ham satırları yalnız saklamak yerine sonuç, alarm ve karar bilgisine dönüştürme.</p></article>
        </div>
      </div>
    </section>

    <section class="pricing">
      <div class="shell pricing-box">
        <div>
          <p class="eyebrow">PROJE BEDELİ NASIL BELİRLENİR?</p>
          <h2>Fiyatı dosyanın sayfa sayısı değil, çözülecek iş belirler.</h2>
          <p>Basit bir takip tablosu ile çok kullanıcılı, çok veri kaynaklı bir yönetim sistemi aynı kapsamda değildir. Bu nedenle önce ihtiyacı inceler, teslim kapsamını yazar ve proje bedelini işe başlamadan önce netleştiririz.</p>
        </div>
        <div class="pricing-proof">
          <small>GERÇEKLEŞMİŞ PROJE ÖRNEĞİ</small>
          <strong>10.000 TL</strong>
          <span>Muhasebe ofisine özel yönetim sistemi</span>
          <p>6 saatlik analiz + üretim çalışması. Her yeni proje kendi ihtiyacına göre ayrıca kapsamlandırılır.</p>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="shell cta-box">
        <div>
          <p class="eyebrow">SİZİN İŞİNİZ NASIL ÇALIŞIYOR?</p>
          <h2>“Bize özel bir Excel lazım” diyorsanız, önce neyi çözmek istediğinizi konuşalım.</h2>
          <p>Hazır ürün seçmek zorunda değilsiniz. İşletmenizin veya muhasebe ofisinizin mevcut işleyişini anlatın; Excel ile gerçekten çözülebilecek kısmı birlikte netleştirelim.</p>
        </div>
        <div class="cta-actions">
          <a class="btn primary light" href={mailHref}>İhtiyacımı anlatmak istiyorum</a>
          <a class="btn outline" href={SATICI.telefonTelHref}>{SATICI.telefon}</a>
          <small>Paylaştığınız bilgiler yalnızca talebinizi değerlendirmek amacıyla kullanılır. Gerekirse proje öncesinde karşılıklı gizlilik sözleşmesi (NDA) yapılabilir.</small>
        </div>
      </div>
    </section>
  </main>
</CommerceLayout>

<style>
  .custom-service-page{--ink:#162019;--muted:#66716a;--green:#166534;--green-dark:#0b3d24;--soft:#f4f8f5;--soft2:#edf6ef;--line:#dbe5dd;--gold:#b96d0d;background:#fff;color:var(--ink)}
  .shell{width:min(1160px,calc(100% - 48px));margin:0 auto}.eyebrow{margin:0 0 10px;font-size:11px;font-weight:900;letter-spacing:.14em;color:var(--green)}
  .service-strip{background:#102019;color:#d6e2da;border-bottom:1px solid #294235}.strip-inner{min-height:45px;display:flex;gap:14px;align-items:center;justify-content:center;font-size:12px}.strip-inner strong{color:#fff;font-size:10px;letter-spacing:.12em;background:#1f6a42;padding:5px 8px;border-radius:6px}.strip-inner span{line-height:1.45}
  .hero{padding:78px 0 72px;background:radial-gradient(circle at 89% 8%,#e7f4ea 0,transparent 31%),linear-gradient(135deg,#fff 0%,#f8fbf8 70%,#eef6f0 100%);border-bottom:1px solid var(--line)}
  .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:54px;align-items:center}.hero-copy h1{margin:0 0 20px;max-width:760px;font-size:clamp(44px,5.2vw,70px);line-height:1;letter-spacing:-.055em}.hero-copy h1 span{color:var(--green)}.lead{max-width:760px;margin:0;color:var(--muted);font-size:18px;line-height:1.72}
  .hero-points{display:grid;gap:9px;margin-top:26px}.hero-points>div{display:grid;grid-template-columns:34px 1fr;gap:11px;padding:12px 14px;background:#fff;border:1px solid var(--line);border-radius:12px}.hero-points b{color:var(--green);font-size:11px}.hero-points span{font-size:14px;color:#526057;line-height:1.5}.hero-points strong{color:var(--ink)}
  .actions,.cta-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 19px;border-radius:12px;font-size:14px;font-weight:850;text-decoration:none;border:1px solid transparent}.primary{background:var(--green);color:#fff}.secondary{background:#fff;color:var(--ink);border-color:#bdc9c0}.micro{max-width:700px;margin:14px 0 0;color:#7a857d;font-size:12px;line-height:1.55}
  .proof-card{position:relative;background:#102019;color:#fff;border-radius:22px;padding:30px;box-shadow:0 24px 60px rgba(16,32,25,.18)}.proof-label{display:inline-block;padding:6px 9px;border-radius:7px;background:#d4881f;color:#201506;font-size:10px;font-weight:950;letter-spacing:.11em}.proof-type{margin:20px 0 5px;color:#9fbaaa;font-size:12px;font-weight:800}.proof-card h2{margin:0;font-size:29px;line-height:1.16;letter-spacing:-.03em}.proof-metrics{display:grid;grid-template-columns:1fr 1fr;margin:24px 0;border:1px solid #2b4738;border-radius:14px;overflow:hidden}.proof-metrics div{padding:18px}.proof-metrics div+div{border-left:1px solid #2b4738}.proof-metrics strong{display:block;font-size:24px}.proof-metrics small{display:block;margin-top:4px;color:#9fbaaa}.proof-card ol{list-style:none;padding:0;margin:0 0 20px;display:grid;gap:10px}.proof-card li{display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:start;color:#d9e5dd;font-size:13px}.proof-card li b{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#214a34;color:#bfe0ca}.proof-note{color:#8ea195;line-height:1.5}
  .distinction{padding:68px 0;background:#fff;border-bottom:1px solid var(--line)}.section-head.narrow{max-width:820px}.section-head h2,.persona-intro h2,.method h2,.why-copy h2,.pricing-box h2,.cta-box h2{margin:0 0 12px;font-size:clamp(32px,3.8vw,50px);line-height:1.08;letter-spacing:-.04em}.section-head>p,.persona-intro>p,.method p,.why-copy p,.pricing-box>div>p,.cta-box>div>p{color:var(--muted);line-height:1.7}
  .difference-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:30px}.difference-grid article{padding:28px;border-radius:18px;border:1px solid var(--line)}.difference-grid small{font-size:10px;font-weight:900;letter-spacing:.12em;color:#7a857e}.difference-grid h3{margin:9px 0 10px;font-size:22px;line-height:1.2}.difference-grid p{color:var(--muted);line-height:1.6}.difference-grid a{font-weight:850;color:var(--green);text-decoration:none}.muted-card{background:#f7f9f7}.accent-card{background:linear-gradient(135deg,#edf7ef,#f9fcfa);border-color:#b9d5c1!important}
  .persona-section{padding:82px 0;background:var(--soft);border-bottom:1px solid var(--line)}.persona-section.business{background:#fff}.persona-grid{display:grid;grid-template-columns:.74fr 1.26fr;gap:52px;align-items:start}.persona-grid.reverse{grid-template-columns:.74fr 1.26fr}.persona-intro{position:sticky;top:110px}.persona-intro p{font-size:15px}.needs-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.needs-grid article{background:#fff;border:1px solid var(--line);border-radius:16px;padding:23px}.business .needs-grid article{background:#f7faf8}.needs-grid span{display:inline-block;color:var(--green);font-size:10px;font-weight:900;letter-spacing:.1em}.needs-grid h3{margin:9px 0 8px;font-size:18px}.needs-grid p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}
  .method{padding:82px 0;background:#0e1d16;color:#fff}.method-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:58px}.method .eyebrow{color:#75bd8c}.method h2{color:#fff}.method p{color:#aebdb3}.method-steps{display:grid;gap:10px}.method-steps>div{display:grid;grid-template-columns:38px 190px 1fr;gap:14px;align-items:center;padding:17px 18px;border:1px solid #284236;border-radius:13px;background:#14271d}.method-steps b{color:#75bd8c}.method-steps strong{font-size:14px}.method-steps span{color:#aebdb3;font-size:13px;line-height:1.5}
