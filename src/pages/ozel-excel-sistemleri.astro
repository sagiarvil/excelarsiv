  <!-- CALCULATOR JAVASCRIPT LOGIC -->
  <script is:inline>
    let currentProfile = 'smmm';

    function setProfile(profile, btnElement) {
      currentProfile = profile;
      document.querySelectorAll('.role-btn').forEach(btn => {
        btn.classList.remove('border-brand-terracotta', 'bg-brand-terracotta/10', 'text-brand-terracotta');
        btn.classList.add('border-stone-700', 'bg-stone-800/60', 'text-stone-300');
      });
      btnElement.classList.remove('border-stone-700', 'bg-stone-800/60', 'text-stone-300');
      btnElement.classList.add('border-brand-terracotta', 'bg-brand-terracotta/10', 'text-brand-terracotta');

      const label1 = document.getElementById('slider-label-1');
      if(profile === 'smmm') {
        label1.innerText = 'Aktif Mükellef Sayısı:';
      } else if(profile === 'cfo' || profile === 'kobi') {
        label1.innerText = 'Aylık Fatura / İşlem Adedi (Yüzlük):';
      } else {
        label1.innerText = 'Aktif Müşteri / Proje Sayısı:';
      }
      calculateLoss();
    }

    function calculateLoss() {
      const val1 = parseInt(document.getElementById('input-range-1').value);
      const val2 = parseInt(document.getElementById('input-range-2').value);

      document.getElementById('val-1').innerText = val1;
      document.getElementById('val-2').innerText = val2;

      let hoursLost = 0;
      let hourlyRate = 350; // Ortalama personel adam-saat maliyeti TL

      if(currentProfile === 'smmm') {
        hoursLost = Math.round((val1 * 1.8) + (val2 * 12));
      } else if(currentProfile === 'cfo') {
        hoursLost = Math.round((val1 * 1.2) + (val2 * 20));
      } else if(currentProfile === 'kobi') {
        hoursLost = Math.round((val1 * 1.5) + (val2 * 15));
      } else {
        hoursLost = Math.round((val1 * 2.2) + (val2 * 16));
      }

      const totalLoss = hoursLost * hourlyRate;

      document.getElementById('total-money-loss').innerHTML = `₺${totalLoss.toLocaleString('tr-TR')} <span class="text-xs text-stone-400 font-sans font-normal">/ ay</span>`;
      document.getElementById('total-time-saved').innerText = `${hoursLost} Saat/Ay`;

      const cta = document.getElementById('calc-cta-btn');
      cta.href = `https://api.whatsapp.com/send?phone=905393333303&text=Bar%C4%B1%C5%9F%20Bey%20merhaba,%20${currentProfile.toUpperCase()}%20yap%C4%B1m%C4%B1zda%20ayda%20${hoursLost}%20saatlik%20manuel%20veri%20kayb%C4%B1m%C4%B1z%20var.%20Otomasyon%20sistemi%20kurmak%20istiyoruz.`;
    }

    // İlk çalıştırma
    calculateLoss();
  </script>

