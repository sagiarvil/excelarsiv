      <div class="flex items-center gap-2.5 relative z-10">
        <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-extrabold text-sm shadow-md shadow-emerald-900/50 border border-emerald-400/30">
          X
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-sm text-white tracking-tight">Excel<span class="text-emerald-400">Arşiv</span></span>
