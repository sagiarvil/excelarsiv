---
import '../styles/global.css';
import { PRATIK_SABLONLAR, PRATIK_KATEGORILER } from '../data/pratikSablonlar';

// Schema.org Structured Data for 53 Products
const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://excelarsiv.com/pratik-programlar#itemlist',
  name: 'Pratik Excel Programları ve Dinamik Grafikler (999 ₺)',
  description: 'Kasa, stok, puantaj, fatura takip, çek-senet ve dinamik dashboard grafiklerinden oluşan 53 hazır pratik Excel çözümü.',
  numberOfItems: PRATIK_SABLONLAR.length,
  itemListElement: PRATIK_SABLONLAR.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: item.title,
      description: item.summary,
      image: `https://excelarsiv.com${item.image}`,
      offers: {
        '@type': 'Offer',
        price: '199',
        priceCurrency: 'TRY',
        availability: 'https://schema.org/InStock',
        url: `https://excelarsiv.com/pratik-programlar#${item.slug}`
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: item.rating.toString(),
        reviewCount: item.ratingCount.toString(),
        bestRating: '5',
        worstRating: '1'
      }
    }
  }))
});

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://excelarsiv.com/' },
    { '@type': 'ListItem', position: 2, name: 'Pratik Programlar (999 ₺)', item: 'https://excelarsiv.com/pratik-programlar' }
  ]
});
---

<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pratik Excel Programları & Dinamik Grafikler (999 ₺) | ExcelArşiv PRO</title>
  <meta name="description" content="Kasa, stok, puantaj, fatura, çek-senet ve yönetici dashboard grafiklerinden oluşan 53 hazır pratik Excel çalışması. Makrosuz saf XLSX, anında indirme, tekil 999 ₺." />
  <meta name="keywords" content="excel kasa takip programı, excel stok programı, personel puantaj excel, dinamik waffle grafik, fatura takip excel, çek senet tablosu excel, excel şablonları 199 tl" />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href="https://excelarsiv.com/pratik-programlar" />
  <link rel="icon" type="image/png" href="/images/excel-logo.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://excelarsiv.com/pratik-programlar" />
  <meta property="og:title" content="Pratik Excel Programları & Dinamik Grafikler (999 ₺) | ExcelArşiv PRO" />
  <meta property="og:description" content="Kasa, stok, puantaj, fatura ve dinamik grafiklerden oluşan 53 hazır çalışma. Makrosuz, anında indirme, tekil 999 ₺." />
  <meta property="og:image" content="https://excelarsiv.com/og.png" />

  <script type="application/ld+json" set:html={itemListLd} />
  <script type="application/ld+json" set:html={breadcrumbLd} />
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white font-sans">

  <!-- Üst Bilgi Şeridi -->
  <div class="bg-slate-900 text-slate-100 text-xs py-2 px-4 border-b border-emerald-500/30">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2 font-medium">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500 text-slate-950 shrink-0">999 ₺ TEK FİYAT</span>
        <span class="hidden sm:inline text-slate-300">53 Pratik Excel Programı ve Dinamik Grafik Modeli · Saf XLSX · Sıfır Makro Uyarısı</span>
        <span class="sm:hidden text-slate-300">53 Pratik Excel Şablonu · Tekil 999 ₺</span>
      </div>
      <div class="flex items-center gap-4 text-[11px] text-slate-300">
        <span class="flex items-center gap-1 text-emerald-400 font-bold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
          Anında Otomatik İndirme
        </span>
        <span class="hidden md:inline text-slate-400">Excel 2016 - 365 &amp; Mac Uyumlu</span>
      </div>
    </div>
  </div>

  <!-- Ana Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm transition-all duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0" aria-label="Excel Arşiv Ana Sayfa">
        <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-excel-600 flex items-center justify-center text-white font-extrabold text-base sm:text-xl shadow-md group-hover:scale-105 transition-transform">
          X
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 whitespace-nowrap">Excel<span class="text-excel-600">Arşiv</span></span>
            <span class="text-[9px] sm:text-[10px] font-bold uppercase px-1.5 py-0.5 rounded-md bg-emerald-100 text-excel-700">PRO</span>
