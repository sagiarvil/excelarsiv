      </div>

      <!-- Sağ Aksiyonlar -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a href="/sablonlar" class="min-h-[42px] hidden md:inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-all shadow-sm shrink-0">
