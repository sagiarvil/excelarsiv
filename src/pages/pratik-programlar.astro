        </div>

      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between gap-4 shrink-0">
        <span class="text-xs text-slate-500 font-medium">✓ Ödeme sonrası anında dosya indirme bağlantısı</span>
        <button
          type="button"
          id="modalBuyBtn"
          class="px-6 py-3 rounded-xl bg-excel-600 hover:bg-excel-700 text-white font-extrabold text-xs sm:text-sm shadow-lg shadow-emerald-600/25 transition flex items-center gap-2"
        >
          <span>999 ₺ ile Hemen Satın Al &amp; İndir</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- HIZLI ÖDEME & SİPARİŞ MODALI -->
  <!-- ===================================================================== -->
  <div id="checkoutModal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden animate-in fade-in zoom-in-95 duration-150">
      
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <h3 class="text-sm font-extrabold text-slate-900">Güvenli Sipariş &amp; İndirme</h3>
        </div>
        <button id="closeCheckoutBtn" type="button" class="text-slate-400 hover:text-slate-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        </button>
      </div>

      <div class="p-5 space-y-4">
        
        <!-- Seçilen Ürün Özeti -->
        <div class="p-3.5 rounded-xl bg-emerald-50/60 border border-emerald-100 flex items-center justify-between gap-3">
          <div>
            <h4 class="text-xs font-bold text-slate-900 line-clamp-1" id="checkoutProductName">Excel Şablonu</h4>
            <p class="text-[11px] text-slate-500">Saf XLSX · Anında İndirme Bağlantısı</p>
          </div>
          <span class="text-base font-black text-excel-700 shrink-0">999 ₺</span>
        </div>

        <!-- Müşteri Bilgileri -->
        <div class="space-y-2.5 text-xs">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Adınız Soyadınız / Firma Ünvanı *</label>
            <input type="text" id="buyerName" placeholder="Adınız Soyadınız" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">E-Posta Adresiniz (İndirme Linki Gönderilecek) *</label>
            <input type="email" id="buyerEmail" placeholder="ornek@sirketiniz.com" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
          </div>
        </div>

        <!-- Ödeme Seçeneği -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1.5">
          <div class="flex items-center justify-between font-bold text-slate-800">
            <span>Kurumsal Havale / EFT İle Sipariş</span>
            <span class="text-[10px] text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">Resmî e-Fatura</span>
          </div>
          <p class="text-[11px] text-slate-600">Siparişinizi onayladığınızda kurumsal banka hesap bilgileri ve indirme bağlantınız e-posta adresinize iletilir.</p>
          <p class="text-[10px] text-emerald-700 font-medium">✓ Açıklamaya adınızı yazmanız yeterlidir. Dosya indirme bağlantınız anında açılır.</p>
        </div>

        <button
          type="button"
          id="confirmOrderBtn"
          class="w-full py-3 rounded-xl bg-excel-600 hover:bg-excel-700 text-white font-extrabold text-xs shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-1.5"
        >
          <span>Siparişi Onayla &amp; Dosyayı İndir (999 ₺)</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Toast Bildirim -->
  <div id="toastNotification" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-emerald-500/40 text-xs font-semibold hidden items-center gap-2.5 max-w-sm transition-all duration-200">
    <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
    <span id="toastMsg">İşlem tamamlandı.</span>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-10 mt-16 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 space-y-3">
      <div class="flex items-center justify-center gap-2 font-bold text-slate-800">
        <span class="w-6 h-6 rounded-md bg-excel-600 text-white flex items-center justify-center text-xs">X</span>
        <span>ExcelArşiv PRO</span>
      </div>
      <p>© 2026 ExcelArşiv. Türkiye'nin En Kapsamlı Hazır Excel Şablon ve Karar Destek Sistemleri Merkezi.</p>
      <div class="flex items-center justify-center gap-4 text-slate-400 text-[11px]">
        <a href="/gizlilik-politikasi" class="hover:text-slate-600">Gizlilik Politikası</a>
        <span>·</span>
        <a href="/mesafeli-satis-sozlesmesi" class="hover:text-slate-600">Mesafeli Satış Sözleşmesi</a>
        <span>·</span>
        <a href="/kvkk-aydinlatma" class="hover:text-slate-600">KVKK Aydınlatma</a>
        <span>·</span>
        <a href="/iletisim" class="hover:text-slate-600">İletişim</a>
      </div>
    </div>
  </footer>

  <!-- İstemci Scriptleri: Filtreleme, Arama, Modal ve Sepet -->
  <script is:inline define:vars={{ pratikData: PRATIK_SABLONLAR }}>
    document.addEventListener('DOMContentLoaded', () => {
      let activeCategory = 'tumu';
      let searchQuery = '';

      const searchInput = document.getElementById('searchInput');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const categoryTabs = document.getElementById('categoryTabs');
      const productGrid = document.getElementById('productGrid');
      const noResults = document.getElementById('noResults');
      const resultCountText = document.getElementById('resultCountText');
      const resetFilterBtn = document.getElementById('resetFilterBtn');

      const detailModal = document.getElementById('detailModal');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const modalImage = document.getElementById('modalImage');
      const modalTitle = document.getElementById('modalTitle');
      const modalSummary = document.getElementById('modalSummary');
      const modalCategory = document.getElementById('modalCategory');
      const modalDescription = document.getElementById('modalDescription');
      const modalFeatures = document.getElementById('modalFeatures');
      const modalBuyBtn = document.getElementById('modalBuyBtn');

      const checkoutModal = document.getElementById('checkoutModal');
      const closeCheckoutBtn = document.getElementById('closeCheckoutBtn');
      const checkoutProductName = document.getElementById('checkoutProductName');
      const confirmOrderBtn = document.getElementById('confirmOrderBtn');
      const toastNotification = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMsg');

      let currentActiveProduct = null;

      function showToast(msg) {
        if (!toastNotification || !toastMsg) return;
        toastMsg.textContent = msg;
        toastNotification.classList.remove('hidden');
        toastNotification.classList.add('flex');
        setTimeout(() => {
          toastNotification.classList.add('hidden');
          toastNotification.classList.remove('flex');
        }, 3500);
      }

      function filterProducts() {
        const cards = document.querySelectorAll('.product-card');
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const cardTitle = card.getAttribute('data-title');
          const cardKeywords = card.getAttribute('data-keywords');

          const matchesCat = (activeCategory === 'tumu' || cardCat === activeCategory);
          const matchesSearch = !searchQuery || cardTitle.includes(searchQuery) || cardKeywords.includes(searchQuery);

          if (matchesCat && matchesSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (resultCountText) {
          resultCountText.innerHTML = `Toplam <strong class="text-slate-900 font-extrabold">${visibleCount}</strong> çalışma listeleniyor`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
            productGrid.classList.add('hidden');
          } else {
            noResults.classList.add('hidden');
            productGrid.classList.remove('hidden');
          }
        }
      }

      // Kategori tıklamaları
      if (categoryTabs) {
        categoryTabs.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-cat]');
          if (!btn) return;

          categoryTabs.querySelectorAll('button').forEach((b) => {
            b.className = 'px-3 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all duration-150 shrink-0 bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900';
          });

          btn.className = 'px-3 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all duration-150 shrink-0 bg-slate-900 text-white shadow-sm ring-1 ring-slate-900 active-tab';
          activeCategory = btn.getAttribute('data-cat') || 'tumu';
          filterProducts();
        });
      }

      // Canlı Arama
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          if (clearSearchBtn) {
            if (searchQuery.length > 0) clearSearchBtn.classList.remove('hidden');
            else clearSearchBtn.classList.add('hidden');
          }
          filterProducts();
        });
      }

      if (clearSearchBtn && searchInput) {
        clearSearchBtn.addEventListener('click', () => {
          searchInput.value = '';
          searchQuery = '';
          clearSearchBtn.classList.add('hidden');
          filterProducts();
        });
      }

      if (resetFilterBtn) {
        resetFilterBtn.addEventListener('click', () => {
          activeCategory = 'tumu';
          searchQuery = '';
          if (searchInput) searchInput.value = '';
          if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
          if (categoryTabs) {
            const firstBtn = categoryTabs.querySelector('button[data-cat="tumu"]');
            if (firstBtn) firstBtn.click();
          }
        });
      }

      // Önizleme Modalı
      function openModalBySlug(slug) {
        const prod = pratikData.find((p) => p.slug === slug);
        if (!prod || !detailModal) return;

        currentActiveProduct = prod;

        if (modalImage) {
          modalImage.src = prod.image;
          modalImage.alt = prod.title;
        }
        if (modalTitle) modalTitle.textContent = prod.title;
        if (modalSummary) modalSummary.textContent = prod.summary;
        if (modalCategory) modalCategory.textContent = prod.categoryLabel;

        if (modalDescription) {
          modalDescription.innerHTML = prod.description
            .split('\n\n')
            .map((p) => `<p>${p}</p>`)
            .join('');
        }

        if (modalFeatures) {
          modalFeatures.innerHTML = prod.features
            .map((f) => `<li class="flex items-start gap-1.5"><svg class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg><span>${f}</span></li>`)
            .join('');
        }

        detailModal.classList.remove('hidden');
        detailModal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
      }

      function closeModal() {
        if (detailModal) {
          detailModal.classList.add('hidden');
          detailModal.classList.remove('flex');
        }
        document.body.classList.remove('overflow-hidden');
      }

      document.addEventListener('click', (e) => {
        const previewBtn = e.target.closest('.preview-trigger');
        if (previewBtn) {
          const slug = previewBtn.getAttribute('data-slug');
          if (slug) openModalBySlug(slug);
        }
      });

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (detailModal) {
        detailModal.addEventListener('click', (e) => {
          if (e.target === detailModal) closeModal();
        });
      }

      // Satın Alma Modalı
      function openCheckout(prod) {
        currentActiveProduct = prod;
        if (!checkoutModal) return;
        if (checkoutProductName) checkoutProductName.textContent = prod.title;
        checkoutModal.classList.remove('hidden');
        checkoutModal.classList.add('flex');
      }

      function closeCheckout() {
        if (!checkoutModal) return;
        checkoutModal.classList.add('hidden');
        checkoutModal.classList.remove('flex');
      }

      document.addEventListener('click', (e) => {
        const buyBtn = e.target.closest('.buy-trigger');
        if (buyBtn) {
          const slug = buyBtn.getAttribute('data-slug');
          const prod = pratikData.find((p) => p.slug === slug);
          if (prod) openCheckout(prod);
        }
      });

      if (modalBuyBtn) {
        modalBuyBtn.addEventListener('click', () => {
          if (currentActiveProduct) {
            closeModal();
            openCheckout(currentActiveProduct);
          }
        });
      }

      if (closeCheckoutBtn) closeCheckoutBtn.addEventListener('click', closeCheckout);
      if (checkoutModal) {
        checkoutModal.addEventListener('click', (e) => {
          if (e.target === checkoutModal) closeCheckout();
        });
      }

      if (confirmOrderBtn) {
        confirmOrderBtn.addEventListener('click', () => {
          const name = document.getElementById('buyerName');
          const email = document.getElementById('buyerEmail');

          if (!name || !name.value.trim()) {
            showToast('Lütfen adınızı ve soyadınızı girin.');
            name?.focus();
            return;
          }
          if (!email || !email.value.trim() || !email.value.includes('@')) {
            showToast('Lütfen geçerli bir e-posta adresi girin.');
            email?.focus();
            return;
          }

          closeCheckout();
          showToast(`Siparişiniz alındı! ${currentActiveProduct?.title || 'Şablon'} indirme linki e-postanıza iletiliyor.`);
          
          // Doğrudan dosya indirmesini tetikle
          if (currentActiveProduct && currentActiveProduct.downloadUrl) {
            setTimeout(() => {
              const a = document.createElement('a');
              a.href = currentActiveProduct.downloadUrl;
              a.download = `${currentActiveProduct.slug}.xlsx`;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
            }, 1000);
          }
        });
      }

      // Sandviç Menü Açma / Kapatma Kontrolü
      const menuBtn = document.getElementById('mobileMenuBtn');
      const closeBtn = document.getElementById('mobileMenuCloseBtn');
      const panel = document.getElementById('mobileMenuPanel');
      const backdrop = document.getElementById('mobileMenuBackdrop');

      if (menuBtn && panel && backdrop) {
        const openDrawer = () => {
          panel.classList.remove('translate-x-full', 'pointer-events-none');
          panel.classList.add('translate-x-0');
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          menuBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        const closeDrawer = () => {
          panel.classList.remove('translate-x-0');
          panel.classList.add('translate-x-full', 'pointer-events-none');
          backdrop.classList.remove('opacity-100');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          menuBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        menuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = panel.classList.contains('translate-x-0');
          if (isOpen) closeDrawer();
          else openDrawer();
        });

        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        backdrop.addEventListener('click', closeDrawer);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeDrawer();
        });

        panel.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            setTimeout(closeDrawer, 150);
          });
        });
      }

      // URL Hash ile doğrudan açılış
      if (window.location.hash) {
        const hashSlug = window.location.hash.replace('#', '');
        if (hashSlug) {
          const targetCard = document.getElementById(hashSlug);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth' });
            targetCard.classList.add('ring-2', 'ring-emerald-500');
          }
        }
      }
    });
  </script>

</body>
</html>
