---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';

const urun = Astro.url.searchParams.get('urun') ?? '';
const productUrl = urun ? new URL(`/sablon/${urun}`, Astro.site).toString() : new URL('/', Astro.site).toString();
const shareText = 'Excel Arşiv’de işletmeler için hazırlanmış bu Excel karar sistemine bakmanı öneririm:';
const mailHref = `mailto:?subject=${encodeURIComponent('Excel Arşiv ürün önerisi')}&body=${encodeURIComponent(shareText + ' ' + productUrl)}`;
const waHref = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + ' ' + productUrl)}`;

const sectors = [
  { no: '01', name: 'İnşaat & Taahhüt', tag: 'HAKEDİŞ & STOPAJ', desc: 'Taşeron hakediş kesintisi, yıllara sâri stopaj ve şantiye nakit akış planı.' },
  { no: '02', name: 'E-Ticaret & Pazaryeri', tag: 'NET KÂR KOKPİTİ', desc: 'Trendyol, Hepsiburada komisyon, reklam gideri, kargo ve iade sonrası net kâr.' },
  { no: '03', name: 'Kafe, Restoran & Gıda', tag: 'REÇETE & ZAYİ', desc: 'Porsiyon bazlı birim maliyet, zayi hesaplayıcı ve günlük kasa-banka mutabakatı.' },
  { no: '04', name: 'Üretim & İmalat', tag: 'ZAM YANSITMA', desc: 'Hammadde artışlarını tekliflere anında yansıtan birim maliyet ve başabaş simülatörü.' },
  { no: '05', name: 'Lojistik & Nakliye', tag: 'SEFER BAŞI KÂR', desc: 'Araç bazında km/yakıt endeksi, bakım amortismanı ve filo nakit planlayıcı.' },
  { no: '06', name: 'Toptan & Dağıtım', tag: 'CARİ YAŞLANDIRMA', desc: 'DSO tahsilat süresi, vadesi geçen açık bakiyeler ve gecikme faizi motoru.' },
  { no: '07', name: 'Tekstil & Konfeksiyon', tag: 'FASON KÂRLILIK', desc: 'Sipariş bazında kumaş/iplik fire hesabı ve fason dikim kârlılık takibi.' },
  { no: '08', name: 'Sağlık & Klinik', tag: 'DOKTOR HAKEDİŞ', desc: 'Uzman hekim seans hakedişleri, sarf malzeme maliyeti ve klinik kârlılığı.' },
  { no: '09', name: 'Otomotiv & Filo', tag: 'ALIM-SATIM MARJI', desc: 'İkinci el ekspertiz/onarım sonrası net marj ve filo kiralama getirisi.' },
  { no: '10', name: 'Gayrimenkul & Proje', tag: 'DCF DEĞERLEME', desc: 'Kira çarpanı analizi, proje geri ödeme süresi ve dinamik nakit projeksiyonu.' },
  { no: '11', name: 'Otel & Konaklama', tag: 'REVPAR & DOLULUK', desc: 'Oda başı gelir optimizasyonu, sezonluk nakit bütçesi ve enerji maliyet takibi.' },
  { no: '12', name: 'İthalat & İhracat', tag: 'GÜMRÜK & KUR', desc: 'Kur dalgalanmalarına karşı forward koruma, navlun ve gümrük maliyet dağıtımı.' },
  { no: '13', name: 'Mali Müşavirler & YMM', tag: 'MİZAN DENETİMİ', desc: '100-999 hesap planı tutarlılık kontrolü, KDV tevkifat ve tecil-terkin analizi.' },
  { no: '14', name: 'Yazılım & Dijital Ajans', tag: 'PROJE ADAMLIK GÜN', desc: 'Yazılımcı adam/saat maliyeti, retainer sözleşme kârlılığı ve nakit akışı.' },
  { no: '15', name: 'Perakende & Mağazacılık', tag: 'M² VERİMLİLİĞİ', desc: 'Mağaza başı metrekare cirosu, stok devir hızı ve kasa açığı kontrolü.' },
  { no: '16', name: 'Tarım & Hayvancılık', tag: 'HASAT BÜTÇESİ', desc: 'Dönemsel gübre/yem girdi planlaması ve hasat vadeli nakit dengesi.' },
  { no: '17', name: 'Enerji & Tesis', tag: 'KWH BİRİM MALİYET', desc: 'Güneş santrali (GES) amortisman simülasyonu ve üretim verim endeksi.' },
  { no: '18', name: 'Danışmanlık & Denetim', tag: 'YÖNETİCİ KOKPİTİ', desc: 'Şirket sahipleri için tek ekranda net işletme sermayesi ve KPI paneli.' },
  { no: '19', name: 'Mobilya & Dekorasyon', tag: 'ÖZEL SİPARİŞ', desc: 'Plaka bazlı fire payı, montaj/işçilik payı ve özel imalat teklif motoru.' },
  { no: '20', name: 'Hizmet & Tesis Yönetimi', tag: 'VARDİYA & KIDEM', desc: 'Personel kıdem/ihbar karşılık ayırma ve vardiya bordro optimizasyonu.' },
  { no: '21', name: 'Matbaa & Ambalaj', tag: 'BASKI TİRAJI', desc: 'Kâğıt kur endeksli tiraj maliyetlendirmesi ve kalıp amortismanı.' },
  { no: '22', name: 'Kuyum & Kıymetli Maden', tag: 'ONS / HAS MALİYET', desc: 'Has altın dönüşüm katsayısı, işçilik farkı ve döviz pozisyon riski.' },
  { no: '23', name: 'Eğitim & Kurs', tag: 'TAKSİT & TAHSİLAT', desc: 'Öğrenci dönemlik sözleşme tahsilatı ve eğitmen hakediş mutabakatı.' },
  { no: '24', name: 'Girişim & Startup', tag: 'RUNWAY HESABI', desc: '13 haftalık burn-rate nakit eritme hızı ve yatırımcı sunum simülatörü.' },
];

const schemaLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Ana Sayfa', 'item': 'https://excelarsiv.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Referanslar', 'item': 'https://excelarsiv.com/referans' }
      ]
    },
    {
      '@type': 'ItemPage',
      'name': '24 Sektörde Kurumsal Karar Altyapısı Referansları',
      'headline': '24 Sektörde 1.000+ İşletmenin Güvendiği Finansal Karar Altyapısı',
      'description': '24 sektörde 1.000\'den fazla işletme ve mali müşavir tarafından aktif olarak kullanılan 51+ hazır Excel karar sistemi referansları.',
      'url': 'https://excelarsiv.com/referans',
      'publisher': {
        '@type': 'Organization',
        'name': 'Excel Arşiv',
        'url': 'https://excelarsiv.com/'
      },
      'mainEntity': {
        '@type': 'ItemList',
        'name': '24 Sektörel Karar Çözümleri Haritası',
        'numberOfItems': sectors.length,
        'itemListElement': sectors.map((s, idx) => ({
          '@type': 'ListItem',
          'position': idx + 1,
          'name': s.name,
          'description': `${s.tag}: ${s.desc}`
        }))
      }
    }
  ]
});

const pillars = [
  {
    title: 'Müşteri',
    kicker: 'ODAKTA İŞLETME VAR',
    desc: 'Teknik detaylar yerine işletmenizin gerçek karar ihtiyacını karşılayan, kullanıcı dostu çözümler.',
  },
  {
    title: 'Güven',
    kicker: '17 YILLIK BANKACILIK',
    desc: 'Ticari bankacılık disiplini, %100 açık formüller, sıfır makro. Verileriniz tamamen kendi bilgisayarınızda.',
  },
  {
    title: 'Dağıtım',
    kicker: '10 SANİYEDE TESLİM',
    desc: 'Ödeme tamamlandığı an indirme bağlantınız ekranda ve e-postanızda. Ömür boyu sınırsız kullanım.',
  },
  {
    title: 'Referans',
    kicker: '24 SEKTÖR DENEYİMİ',
    desc: 'Türkiye genelinde 1.000+ KOBİ, mali müşavir ve finans yöneticisi tarafından aktif olarak kullanılıyor.',
  },
  {
    title: 'Satış Kanalı',
    kicker: 'GÜVENLİ & FATURALI',
    desc: 'Shopier 256-bit SSL, tüm kartlara 12 taksit seçeneği ve anında resmi e-arşiv fatura teslimi.',
  },
];
---

<CommerceLayout
  title="Referanslar & Sektörel Çözüm Ortaklığı — Excel Arşiv"
  description="24 sektörde 1.000'den fazla işletme ve mali müşavir tarafından aktif olarak kullanılan 51+ hazır Excel karar sistemi referansları."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schemaLd} />
  </Fragment>
  <main class="referrals-page">
    <section class="referrals-hero">
      <div class="wrap-shell">
        <SectionLabel number={1} label="REFERANSLAR & SEKTÖREL AĞ" />
        <h1 class="hero-title">24 Sektörde 1.000+ İşletmenin Güvendiği<br /><em>Finansal Karar Altyapısı</em></h1>
        <p class="hero-lead">
          İnşaattan e-ticarete, restorandan fabrikaya; mali müşavirler, finans direktörleri ve şirket sahipleri nakit akışı, bütçe, maliyet ve risk yönetimini ExcelArşiv sistemleriyle güvenceye alıyor.
        </p>

        <div class="hero-stats">
          <div class="stat-box">
            <strong>24</strong>
            <span>Aktif Sektör</span>
          </div>
          <div class="stat-box">
            <strong>51+</strong>
            <span>Onaylı Karar Sistemi</span>
          </div>
          <div class="stat-box">
            <strong>1.000+</strong>
            <span>İşletme & Mali Müşavir</span>
          </div>
          <div class="stat-box">
            <strong>17 Yıl</strong>
            <span>Ticari Bankacılık Deneyimi</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 Temel Direk Bento Izgarası -->
    <section class="pillars-section">
      <div class="wrap-shell">
        <div class="section-kicker-head">
          <span class="kicker-tag">5 TEMEL DİREK</span>
          <h2>Kurumsal Güven ve Mükemmelik Standartlarımız</h2>
          <p>Her sistemimiz bu beş temel direğin sağlamlığı üzerine inşa edilir.</p>
        </div>

        <div class="pillars-grid">
          {pillars.map((p, idx) => (
            <article class="pillar-card">
              <span class="pillar-no">0{idx + 1}</span>
              <small class="pillar-kicker">{p.kicker}</small>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))}
        </div>
    <!-- PDF Slayt 23 Stili: Kurumsal Referanslar Izgarası -->
    <section class="brand-references-section">
      <div class="wrap-shell">
        <div class="section-kicker-head">
          <span class="kicker-tag">KURUMSAL REFERANSLARIMIZ</span>
          <h2>Türkiye Çapında 1.000+ İşletmenin Onayladığı Karar Altyapısı</h2>
          <p>Reel sektörün önde gelen markaları ve KOBİ'ler kritik nakit, maliyet, banka kredi ve kârlılık kararlarını Excel Arşiv ile alıyor.</p>
        </div>

        <div class="brand-ref-grid">
          <div class="brand-ref-card"><span class="b-cat">TEKSTİL &amp; MODA</span><strong>Armine · Sarar · Mısırlı</strong><small>Fason Kârlılık &amp; Kumaş Fire Takip Sistemi</small></div>
          <div class="brand-ref-card"><span class="b-cat">PERAKENDE &amp; ZİNCİR</span><strong>Rossmann · Civil · Toys"R"Us</strong><small>M² Verimliliği &amp; Kasa Mutabakat Paneli</small></div>
          <div class="brand-ref-card"><span class="b-cat">ENERJİ &amp; ALTYAPI</span><strong>Aksa · Yedaş Enerji</strong><small>Birim Maliyet &amp; GES Amortisman Sistemi</small></div>
          <div class="brand-ref-card"><span class="b-cat">SAĞLIK &amp; OPTİK</span><strong>Dünyagöz · Atasun Optik</strong><small>Hekim Hakediş &amp; Sarf Malzeme Maliyeti</small></div>
          <div class="brand-ref-card"><span class="b-cat">DAYANIKLI TÜKETİM</span><strong>Tekzen · Evkur Ev Aletleri</strong><small>Taksitli Satış &amp; Cari Yaşlandırma Modeli</small></div>
          <div class="brand-ref-card"><span class="b-cat">ENDÜSTRİYEL MUTFAK</span><strong>Öztiryakiler Mutfak</strong><small>Proje Bazlı Kârlılık &amp; İmalat Maliyeti</small></div>
          <div class="brand-ref-card"><span class="b-cat">GAYRİMENKUL &amp; PROJE</span><strong>Sinpaş Yapı · Birevim</strong><small>Hakediş Kesinti &amp; DCF Proje Değerleme</small></div>
          <div class="brand-ref-card"><span class="b-cat">GIDA &amp; RESTORAN</span><strong>Komagene · Pasaport Pizza</strong><small>Porsiyon Reçete &amp; Zayi Kontrol Robotu</small></div>
          <div class="brand-ref-card"><span class="b-cat">İÇECEK &amp; DAĞITIM</span><strong>Pınar Su · Sarıkız Maden Suyu</strong><small>Depo Teslim Birim Nakliye Maliyet Paneli</small></div>
          <div class="brand-ref-card"><span class="b-cat">ZİNCİR MARKET</span><strong>Happy Center · Kim Market</strong><small>POS Komisyon &amp; Net Tahsilat Kontrolü</small></div>
          <div class="brand-ref-card"><span class="b-cat">OTOMOTİV &amp; FİLO</span><strong>Otonet · OtoSOR · Yiğit Akü</strong><small>Filo Marjı &amp; İkinci El Ekspertiz Kârı</small></div>
          <div class="brand-ref-card"><span class="b-cat">E-TİCARET &amp; YAYIN</span><strong>BKM Kitap · Pazaryeri Satıcıları</strong><small>Trendyol Komisyon &amp; Net Kâr Kokpiti</small></div>
        </div>
      </div>
    </section>

    <!-- 24 Kurumsal Sektör Bento Izgarası -->
    <section class="sectors-section">
      <div class="wrap-shell">
        <div class="section-kicker-head">
          <span class="kicker-tag">SEKTÖREL ÇÖZÜM HARİTASI</span>
          <h2>Hangi Sektörde Hangi Karar Sistemi Kullanılıyor?</h2>
          <p>Her sektörün dinamikleri ve mevzuat gereksinimleri farklıdır. Sistemlerimiz sektöre özel formüllerle çalışır.</p>
        </div>

        <div class="sectors-grid">
          {sectors.map((s) => (
            <article class="sector-card">
              <div class="sector-top">
                <span class="sector-no">{s.no}</span>
                <span class="sector-tag">{s.tag}</span>
              </div>
              <h3>{s.name}</h3>
              <p>{s.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Tavsiye ve Referans Paylaşımı -->
    <section class="share-section">
      <div class="wrap-shell">
        <div class="share-box">
          <div class="share-copy">
            <span class="kicker-tag">İŞİNİZE YARADIYSA DOĞRU KİŞİYE İLETİN</span>
            <h2>Bir işletme sahibine veya mali müşavirinize önerin</h2>
            <p>
              Aynı nakit akışı veya maliyet problemine saatler harcayan bir meslektaşınız varsa, kanonik karar sistemi bağlantısını doğrudan paylaşın.
            </p>
            <div class="share-url-row">
              <code>{productUrl}</code>
              <button type="button" id="copyReferral" class="btn-copy">Bağlantıyı Kopyala</button>
            </div>
            <div class="share-action-buttons">
              <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn-wa">WhatsApp ile Paylaş</a>
              <a href={mailHref} class="btn-mail">E-posta ile İlet</a>
            </div>
          </div>
          <div class="partner-card">
            <span class="kicker-tag">MALİ MÜŞAVİRLER İÇİN</span>
            <h3>Mali Müşavir Pilot Ortaklığı</h3>
            <p>Mükelleflerinizin finansal tablolarını standartlaştıran ve denetimi kolaylaştıran özel çözüm ortaklığımızı inceleyin.</p>
            <a href="/ortaklik-mali-musavir" class="btn-partner">Pilot İş Ortaklığını Gör →</a>
            <div style="margin-top:16px;padding-top:14px;border-top:1px solid #e2e8f0">
              <a href="/rehber/excel-sablonlari-sik-sorulan-sorular" style="font-size:12.5px;font-weight:700;color:#059669;text-decoration:none">51 ürünün soru-cevap rehberi →</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{ productUrl }}>
    document.getElementById('copyReferral')?.addEventListener('click', async (event) => {
      try {
        await navigator.clipboard.writeText(productUrl);
        const button = event.currentTarget;
        if (button instanceof HTMLButtonElement) {
          button.textContent = '✓ Kopyalandı';
          setTimeout(() => { button.textContent = 'Bağlantıyı Kopyala'; }, 2500);
        }
      } catch {}
    });
  </script>
</CommerceLayout>

<style>
.referrals-page {
  padding-bottom: 96px;
  background: #ffffff;
  color: #0f172a;
}
.wrap-shell {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

/* HERO */
.referrals-hero {
  padding: 48px 0 44px;
  border-bottom: 1px solid #e2e8f0;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
}
.hero-title {
  margin: 20px 0 16px;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #0f172a;
}
.hero-title em {
  font-style: normal;
  color: #059669;
}
.hero-lead {
  max-width: 820px;
  margin: 0 0 32px;
  font-size: 18px;
  line-height: 1.65;
  color: #475569;
}
.hero-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}
.stat-box {
  padding: 20px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
}
.stat-box strong {
  display: block;
  font-size: 32px;
  font-weight: 800;
  color: #059669;
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: 6px;
}
.stat-box span {
  font-size: 13px;
  color: #64748b;
  font-weight: 600;
}

/* HEADERS */
.section-kicker-head {
  max-width: 760px;
  margin-bottom: 34px;
}
.kicker-tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #059669;
  margin-bottom: 8px;
}
.section-kicker-head h2 {
  margin: 0 0 10px;
  font-size: clamp(26px, 3.2vw, 38px);
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #0f172a;
}
.section-kicker-head p {
  margin: 0;
  font-size: 16px;
  line-height: 1.6;
  color: #64748b;
}

/* 5 TEMEL DİREK */
.pillars-section {
  padding: 64px 0;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}
.pillars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 14px;
}
.pillar-card {
  padding: 24px;
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
}
.pillar-no {
  display: inline-block;
  font-size: 12px;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  color: #059669;
  margin-bottom: 6px;
}
.pillar-kicker {
  display: block;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #64748b;
  margin-bottom: 4px;
}
.pillar-card h3 {
  margin: 0 0 8px;
  font-size: 18px;
  font-weight: 800;
  color: #0f172a;
}
.pillar-card p {
  margin: 0;
  font-size: 13px;
  line-height: 1.55;
  color: #475569;
}

/* KURUMSAL REFERANSLAR IZGARASI (PDF SLAYT 23) */
.brand-references-section {
  padding: 64px 0;
  background: #ffffff;
  border-bottom: 1px solid #e2e8f0;
}
.brand-ref-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.brand-ref-card {
  padding: 20px 18px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
  display: grid;
  gap: 6px;
  text-align: center;
  transition: all 0.2s ease;
}
.brand-ref-card:hover {
  border-color: #059669;
  box-shadow: 0 12px 28px rgba(5, 150, 105, 0.1);
  transform: translateY(-2px);
}
.b-cat {
  font: 850 10px/1 ui-monospace, monospace;
  letter-spacing: 0.08em;
  color: #059669;
  text-transform: uppercase;
}
.brand-ref-card strong {
  font-size: 14.5px;
  font-weight: 850;
  color: #0f172a;
  line-height: 1.2;
}
.brand-ref-card small {
  font-size: 11.5px;
  color: #64748b;
  line-height: 1.35;
}
@media (max-width: 980px) {
  .brand-ref-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 540px) {
  .brand-ref-grid {
    grid-template-columns: 1fr;
  }
}

/* 24 SEKTÖR BENTO */
.sectors-section {
  padding: 64px 0;
}
.sectors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 14px;
}
.sector-card {
  padding: 20px;
  border-radius: 18px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.sector-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
