---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/categories';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
const templates = (await getCollection('templates')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'tr'));
const guideProductSlugs = new Set(guides.map((guide) => guide.data.productSlug));

const categoryMap = Object.fromEntries(categories.map(c => [c.slug, c.name]));

const allItems = [
  ...guides.map((guide) => ({
    type: 'guide',
    id: guide.id,
    title: guide.data.title,
    description: guide.data.description,
    category: guide.data.category,
    categoryName: categoryMap[guide.data.category] || guide.data.category,
    primaryQuery: guide.data.primaryQuery,
    productSlug: guide.data.productSlug,
    url: `/rehber/${guide.id}`,
  })),
  ...templates
    .filter((template) => !guideProductSlugs.has(template.id))
    .map((template) => ({
      type: 'template',
      id: template.id,
      title: template.data.name,
      description: template.data.summary,
      category: template.data.category,
      categoryName: categoryMap[template.data.category] || template.data.category,
      primaryQuery: 'HAZIR SİSTEM',
      productSlug: template.id,
      url: `/sablon/${template.id}`,
    }))
].sort((a, b) => a.title.localeCompare(b.title, 'tr'));

const guidesLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/rehber#itemlist', Astro.site).toString(),
  numberOfItems: guides.length,
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/rehber/${guide.id}`, Astro.site).toString(),
    name: guide.data.title,
  })),
});
const guidesPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL('/rehber#collection', Astro.site).toString(),
  url: new URL('/rehber', Astro.site).toString(),
  name: 'KOBİ ve İşletmeler İçin Excel Rehberleri',
  description: 'Finansal analiz, nakit akışı, muhasebe, bütçe, stok, satış ve personel yönetimi için uygulamalı Excel rehberleri.',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL('/rehber#itemlist', Astro.site).toString() },
});
const guidesBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Rehberler', item: new URL('/rehber', Astro.site).toString() },
  ],
});
---

<CommerceLayout
  title="KOBİ ve İşletmeler İçin Excel Rehberleri & Bilgi İndeksi | Excel Arşiv"
  description="Nakit akışı, finansal analiz, bütçe, muhasebe, stok, satış ve personel yönetimini Excel'de kurmak için uygulamalı, ürün bağlantılı profesyonel rehberler dizini."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={guidesLd} />
    <script type="application/ld+json" set:html={guidesPageLd} />
    <script type="application/ld+json" set:html={guidesBreadcrumbLd} />
  </Fragment>

  <!-- SCHOLAR HEADER & SEARCH BAR -->
  <header class="bg-white border-b border-slate-200 py-6 md:py-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-xs font-mono text-slate-500 font-semibold">
            <a href="/" class="hover:text-blue">Ana Sayfa</a>
            <span>/</span>
            <span class="text-navy font-bold">Rehber İndeksi & Bilgi Bankası</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-navy mt-1 tracking-tight">
            Excel Arşiv Rehberler Dizin İndeksi
          </h1>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-600 bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span><strong>{guides.length}</strong> Uygulamalı Rehber İndekslendi</span>
        </div>
      </div>

      <!-- SEARCH BAR -->
      <div class="mt-5 relative">
        <div class="relative flex items-center">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input
            id="index-search"
            type="search"
            placeholder="Rehber, formül, konu veya hazır şablon adı ile dizinde arayın (örn: 13 haftalık nakit akışı, hakediş, cari yaşlandırma)..."
            class="w-full pl-11 pr-28 py-3.5 bg-slate-50/80 hover:bg-white focus:bg-white border border-slate-300 focus:border-blue rounded-xl text-sm text-navy placeholder:text-slate-400 focus:outline-none focus:ring-4 focus:ring-blue/10 transition-all shadow-inner"
          />
          <button
            type="button"
            id="search-btn"
            class="absolute right-1.5 px-5 py-2 bg-blue hover:bg-blue-600 text-white font-bold text-xs rounded-lg transition-all shadow-sm"
          >
            Dizinde Ara
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN SCHOLAR INDEX LAYOUT -->
  <main class="py-8 bg-[#F8F9FA] border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid lg:grid-cols-[240px_1fr] gap-8 items-start">
        
        <!-- SOL SIDEBAR: FİLTRELER & DİZİN KÜMELERİ -->
        <aside class="space-y-6">
          <!-- Konu Kümeleri Filtresi -->
          <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <h2 class="text-xs font-mono font-extrabold uppercase tracking-wider text-slate-600 pb-2 border-b border-slate-100 flex items-center justify-between">
              <span>Konu Kümeleri</span>
              <span class="text-[10px] font-normal text-slate-400">{categories.length} küme</span>
            </h2>
            <nav class="mt-3 space-y-1" id="category-filter-nav">
              <button
                type="button"
                data-category="all"
                class="category-btn w-full text-left px-3 py-2 rounded-xl text-xs font-bold transition-all flex items-center justify-between bg-blue text-white shadow-sm"
              >
                <span>Tüm Konular</span>
                <span class="text-[10px] font-mono bg-white/20 px-1.5 py-0.5 rounded">{allItems.length}</span>
              </button>
              {categories.map((cat) => {
                const count = allItems.filter(i => i.category === cat.slug).length;
                return (
                  <button
                    type="button"
                    data-category={cat.slug}
                    class="category-btn w-full text-left px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-blue transition-all flex items-center justify-between"
                  >
                    <span class="truncate">{cat.name}</span>
                    <span class="text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded shrink-0">{count}</span>
                  </button>
                );
              })}
            </nav>
          </div>

          <!-- İçerik Türü Filtresi -->
          <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
            <h2 class="text-xs font-mono font-extrabold uppercase tracking-wider text-slate-600 pb-2 border-b border-slate-100">
              İçerik Türü
            </h2>
            <div class="mt-3 space-y-1.5 text-xs" id="type-filter-group">
              <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-50 cursor-pointer">
                <input type="radio" name="item-type" value="all" checked class="text-blue focus:ring-blue" />
                <span class="font-bold text-slate-800">Tümü</span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-50 cursor-pointer">
                <input type="radio" name="item-type" value="guide" class="text-blue focus:ring-blue" />
                <span class="text-slate-700">Uygulamalı Rehberler ({guides.length})</span>
              </label>
              <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-50 cursor-pointer">
                <input type="radio" name="item-type" value="template" class="text-blue focus:ring-blue" />
                <span class="text-slate-700">Hazır Excel Sistemleri</span>
              </label>
            </div>
          </div>

          <!-- Özel Excel Çözüm Kutusu -->
          <div class="bg-gradient-to-br from-[#0B192C] to-[#102A43] text-white rounded-2xl p-5 border border-slate-700 shadow-sm">
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-amber-400 block">ÖZEL EXCEL SİSTEMİ</span>
            <h3 class="mt-1.5 text-sm font-bold text-white leading-snug">Standart formüller işinizi çözmüyor mu?</h3>
            <p class="mt-2 text-xs text-slate-300 leading-relaxed">
              İşleyişinizi anlatın, işletmenize özel kontrollü Excel mimarisini kuralım.
            </p>
            <a href="/ozel-excel-sistemleri" class="mt-3.5 inline-flex items-center justify-center gap-1.5 w-full bg-blue hover:bg-blue-600 text-white font-bold text-xs py-2.5 rounded-xl transition-all">
              <span>Özel Sistem Talebi</span>
              <span>→</span>
            </a>
          </div>
        </aside>

        <!-- SAĞ ANA ALAN: AKADEMİK / PROFESYONEL İNDEKS LİSTESİ -->
        <section class="space-y-4" aria-label="Rehber listesi">
          <!-- Sonuç Sayacı ve Aktif Filtre Bilgisi -->
          <div class="flex items-center justify-between text-xs text-slate-500 pb-2 border-b border-slate-200">
            <div>
              <span id="results-count" class="font-bold text-navy">{allItems.length}</span> sonuç listelendi (0.01 saniye)
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-400">Aktif Filtre:</span>
              <span id="active-filter-badge" class="font-bold text-blue bg-blue/10 px-2 py-0.5 rounded">Tüm Konular</span>
            </div>
          </div>

          <!-- İNDEKS KAYITLARI -->
          <div id="index-entries" class="space-y-3.5">
            {allItems.map((item) => (
              <article
                class="scholar-item p-5 bg-white rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all duration-200"
                data-category={item.category}
                data-type={item.type}
                data-title={item.title.toLowerCase()}
                data-description={item.description.toLowerCase()}
              >
                <!-- ÜST SATIR: TÜR ROZETİ + BAŞLIK LİNKİ -->
                <div class="flex items-start justify-between gap-3">
                  <div class="space-y-1 w-full">
                    <div class="flex items-center gap-2 flex-wrap">
                      {item.type === 'guide' ? (
                        <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200 shrink-0">
                          [REHBER]
                        </span>
                      ) : (
                        <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 shrink-0">
                          [EXCEL SİSTEMİ]
                        </span>
                      )}
                      <h2 class="text-base sm:text-lg font-bold text-blue-700 hover:text-blue-900 leading-snug">
                        <a href={item.url} class="hover:underline">
                          {item.title}
                        </a>
                      </h2>
                    </div>

                    <!-- META / YAZAR / KÜME SATIRI (SCHOLAR YEŞİL SATIRI) -->
                    <div class="text-xs text-[#006621] font-medium flex items-center gap-2 flex-wrap pt-0.5">
                      <span>Barış Bağırlar</span>
                      <span>·</span>
                      <span class="text-slate-600">Excel Arşiv</span>
                      <span>·</span>
                      <span class="text-slate-600 font-semibold">{item.categoryName}</span>
                      <span>·</span>
                      <span class="text-slate-400">{item.primaryQuery}</span>
                    </div>

                    <!-- ÖZET / SNIPPET -->
                    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed pt-1">
                      {item.description}
                    </p>

                    <!-- ALT AKSİYON / SCHOLAR METADATA BAĞLANTILARI -->
                    <div class="flex items-center gap-4 pt-2.5 text-xs text-slate-500 flex-wrap border-t border-slate-100 mt-3">
                      <a href={item.url} class="font-bold text-blue hover:text-blue-800 hover:underline flex items-center gap-1">
                        <span>📖 {item.type === 'guide' ? 'Adım Adım Rehberi Oku' : 'Excel Sistemini İncele'}</span>
                        <span>→</span>
                      </a>

                      {item.productSlug && item.type === 'guide' && (
                        <a href={`/sablon/${item.productSlug}`} class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-2.5 py-1 rounded-md border border-emerald-200 hover:border-emerald-300 transition-all">
                          <span class="text-emerald-600 font-black">★</span>
                          <span>Hazır Excel Dosyası</span>
                        </a>
                      )}

                      <a href={`/sablonlar/${item.category}`} class="text-slate-500 hover:text-blue hover:underline">
                        Kategori Şablonları
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- ARAMADA SONUÇ BULUNAMADI UYARISI -->
          <div id="no-results" class="hidden p-10 bg-white rounded-2xl border border-slate-200 text-center">
            <span class="text-3xl block mb-2">🔍</span>
            <h3 class="text-base font-bold text-navy">Aramanıza uygun rehber bulunamadı</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
              Farklı bir anahtar kelime deneyebilir veya sol taraftaki tüm konular seçeneğine dönebilirsiniz.
            </p>
            <button type="button" id="reset-filter-btn" class="mt-4 px-4 py-2 bg-blue text-white rounded-xl text-xs font-bold">
              Filtreleri Sıfırla
            </button>
          </div>
        </section>

      </div>
    </div>
  </main>

  <!-- LIVE CLIENT JAVASCRIPT FOR INSTANT FILTERING & SEARCH -->
  <script is:inline>
    const searchInput = document.getElementById('index-search');
    const searchBtn = document.getElementById('search-btn');
    const categoryButtons = document.querySelectorAll('.category-btn');
    const typeRadios = document.querySelectorAll('input[name="item-type"]');
    const items = document.querySelectorAll('.scholar-item');
    const resultsCount = document.getElementById('results-count');
    const activeFilterBadge = document.getElementById('active-filter-badge');
    const noResults = document.getElementById('no-results');
    const resetFilterBtn = document.getElementById('reset-filter-btn');

    let currentCategory = 'all';
    let currentType = 'all';

    function filterItems() {
      const query = (searchInput.value || '').trim().toLowerCase();
      let visibleCount = 0;

      items.forEach((item) => {
        const itemCategory = item.dataset.category;
        const itemType = item.dataset.type;
        const itemTitle = item.dataset.title;
        const itemDesc = item.dataset.description;

        const categoryMatch = currentCategory === 'all' || itemCategory === currentCategory;
        const typeMatch = currentType === 'all' || itemType === currentType;
        const searchMatch = !query || itemTitle.includes(query) || itemDesc.includes(query);

        if (categoryMatch && typeMatch && searchMatch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      resultsCount.textContent = visibleCount;
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.dataset.category;
        categoryButtons.forEach((b) => {
          b.className = 'category-btn w-full text-left px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-blue transition-all flex items-center justify-between';
        });
        btn.className = 'category-btn w-full text-left px-3 py-2 rounded-xl text-xs font-bold transition-all flex items-center justify-between bg-blue text-white shadow-sm';
        activeFilterBadge.textContent = btn.querySelector('span:first-child').textContent.trim();
        filterItems();
      });
    });

    typeRadios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        currentType = e.target.value;
        filterItems();
      });
    });

    searchInput.addEventListener('input', filterItems);
    searchBtn.addEventListener('click', filterItems);
    
    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentCategory = 'all';
        currentType = 'all';
        categoryButtons[0].click();
        typeRadios[0].checked = true;
        filterItems();
      });
    }
  </script>
</CommerceLayout>
