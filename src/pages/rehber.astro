---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/categories';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
const templates = (await getCollection('templates')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'tr'));
const guideProductSlugs = new Set(guides.map((guide) => guide.data.productSlug));

const categoryGroups = categories.map((category) => {
  const categoryGuides = guides.filter((guide) => guide.data.category === category.slug);
  const missingSlots = (3 - (categoryGuides.length % 3)) % 3;
  const fillers = templates
    .filter((template) => template.data.category === category.slug && !guideProductSlugs.has(template.id))
    .slice(0, missingSlots);

  return {
    ...category,
    guides: categoryGuides,
    fillers,
  };
}).filter((group) => group.guides.length > 0);

const guidesLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/rehber#itemlist', Astro.site).toString(),
  numberOfItems: guides.length,
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/rehber/${guide.id}`, Astro.site).toString(),
    name: guide.data.title,
  })),
});
const guidesPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL('/rehber#collection', Astro.site).toString(),
  url: new URL('/rehber', Astro.site).toString(),
  name: 'KOBİ ve İşletmeler İçin Excel Rehberleri',
  description: 'Finansal analiz, nakit akışı, muhasebe, bütçe, stok, satış ve personel yönetimi için uygulamalı Excel rehberleri.',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL('/rehber#itemlist', Astro.site).toString() },
});
const guidesBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Rehberler', item: new URL('/rehber', Astro.site).toString() },
  ],
});
---

<CommerceLayout
  title="KOBİ ve İşletmeler İçin Excel Rehberleri | Excel Arşiv"
  description="Nakit akışı, finansal analiz, bütçe, muhasebe, stok, satış ve personel yönetimini Excel'de kurmak için uygulamalı, ürün bağlantılı profesyonel rehberler."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={guidesLd} />
    <script type="application/ld+json" set:html={guidesPageLd} />
    <script type="application/ld+json" set:html={guidesBreadcrumbLd} />
  </Fragment>

  <!-- HERO SECTION -->
  <section class="bg-gradient-to-b from-white via-slate-50/50 to-white border-b border-line py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-blue bg-blue/10 border border-blue/20 px-3.5 py-1.5 rounded-full shadow-sm">
        <span class="w-2 h-2 rounded-full bg-blue animate-ping"></span>
        UYGULAMA REHBERLERİ
      </div>
      <h1 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.14] text-navy max-w-4xl">
        İşletmenin kritik Excel sistemlerini <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue to-indigo-600">doğru yöntemle nasıl kurarsınız?</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl">
        Bu merkez, KOBİ'lerin ve finans ekiplerinin en sık karşılaştığı karar problemlerini yedi konu kümesinde toplar. Her rehber yalnız formülü anlatmaz; gerekli veri yapısını, kontrol mantığını, hata noktalarını, karar çıktısını ve ilgili hazır Excel sistemini birlikte gösterir.
      </p>

      <!-- İSTATİSTİK KARTLARI -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 max-w-3xl">
        <div class="bg-white rounded-2xl p-4 md:p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-blue/10 text-blue font-extrabold flex items-center justify-center text-xl shrink-0">
            📚
          </div>
          <div>
            <strong class="block text-2xl md:text-3xl font-extrabold text-navy">{guides.length}+</strong>
            <span class="text-xs font-semibold text-slate-500">Uygulamalı Rehber</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-4 md:p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 font-extrabold flex items-center justify-center text-xl shrink-0">
            🎯
          </div>
          <div>
            <strong class="block text-2xl md:text-3xl font-extrabold text-navy">{categoryGroups.length}</strong>
            <span class="text-xs font-semibold text-slate-500">Konu Kümesi</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-4 md:p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 font-extrabold flex items-center justify-center text-xl shrink-0">
            ⚡
          </div>
          <div>
            <strong class="block text-2xl md:text-3xl font-extrabold text-navy">1:1</strong>
            <span class="text-xs font-semibold text-slate-500">Rehber → Sistem Eşleşmesi</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KONU KÜMELERİ HIZLI GEZİNME -->
  <section class="py-8 bg-slate-50/70 border-b border-line">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-between gap-4 mb-4">
        <p class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-400"></span>
          KONU KÜMELERİ HIZLI ERİŞİM
        </p>
        <span class="text-[11px] font-semibold text-slate-400">Tıklayarak ilgili kümeye atlayın</span>
      </div>
      <nav class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5" aria-label="Rehber konu kümeleri">
        {categoryGroups.map((group) => (
          <a href={`#${group.slug}`} class="group flex flex-col justify-between p-3.5 rounded-2xl bg-white border border-slate-200/90 hover:border-blue hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 text-decoration-none">
            <strong class="text-xs sm:text-sm font-extrabold text-navy group-hover:text-blue transition-colors leading-snug">{group.name}</strong>
            <span class="text-[10px] font-mono font-bold text-slate-500 bg-slate-100 group-hover:bg-blue/10 group-hover:text-blue px-2 py-0.5 rounded-md mt-2 w-fit">{group.guides.length} rehber</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- KÜME BÖLÜMLERİ -->
  {categoryGroups.map((group, groupIndex) => (
    <section id={group.slug} class={`py-12 md:py-16 border-b border-line ${groupIndex % 2 === 0 ? 'bg-white' : 'bg-slate-50/40'} scroll-mt-6`}>
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-slate-200/80">
          <div>
            <div class="inline-flex items-center gap-1.5 text-xs font-mono font-extrabold uppercase tracking-wide text-blue bg-blue/10 px-3 py-1 rounded-lg">
              {String(groupIndex + 1).padStart(2, '0')} · {group.primaryQuery}
            </div>
            <h2 class="mt-2.5 text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy tracking-tight">{group.name}</h2>
            <p class="mt-1.5 text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">{group.description}</p>
          </div>
          <a href={`/sablonlar/${group.slug}`} class="inline-flex items-center gap-1.5 text-xs font-extrabold text-blue hover:text-indigo-700 bg-blue/5 hover:bg-blue/10 border border-blue/20 px-4 py-2.5 rounded-xl transition-all shrink-0 w-fit">
            <span>{group.name} şablonlarını karşılaştır</span>
            <span>→</span>
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-8">
          {group.guides.map((guide, index) => (
            <article class="group relative flex flex-col justify-between p-6 rounded-3xl bg-white border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-blue/50 hover:-translate-y-1.5 transition-all duration-300 overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue to-indigo-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div>
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-blue bg-blue/5 px-2.5 py-1 rounded-md inline-block">
                  {String(index + 1).padStart(2, '0')} · {guide.data.primaryQuery}
                </span>
                <h3 class="mt-3.5 text-lg font-extrabold text-navy group-hover:text-blue transition-colors leading-snug">
                  <a href={`/rehber/${guide.id}`} class="hover:underline">{guide.data.title}</a>
                </h3>
                <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {guide.data.description}
                </p>
              </div>
              <div class="mt-6 pt-3.5 border-t border-slate-100 flex items-center justify-between">
                <a class="text-xs font-extrabold text-blue group-hover:text-indigo-600 flex items-center gap-1.5" href={`/rehber/${guide.id}`}>
                  <span>Adım adım rehberi aç</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </article>
          ))}
          {group.fillers.map((template, fillerIndex) => (
            <article class="group relative flex flex-col justify-between p-6 rounded-3xl bg-gradient-to-br from-emerald-50/50 via-white to-teal-50/30 border border-emerald-200/80 shadow-sm hover:shadow-xl hover:border-emerald-500 hover:-translate-y-1.5 transition-all duration-300 overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-80 group-hover:opacity-100 transition-opacity"></div>
              <div>
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100/60 px-2.5 py-1 rounded-md inline-block">
                  {String(group.guides.length + fillerIndex + 1).padStart(2, '0')} · HAZIR EXCEL SİSTEMİ
                </span>
                <h3 class="mt-3.5 text-lg font-extrabold text-navy group-hover:text-emerald-700 transition-colors leading-snug">
                  <a href={`/sablon/${template.id}`} class="hover:underline">{template.data.name}</a>
                </h3>
                <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {template.data.summary}
                </p>
              </div>
              <div class="mt-6 pt-3.5 border-t border-emerald-100/80 flex items-center justify-between">
                <a class="text-xs font-extrabold text-emerald-700 group-hover:text-emerald-800 flex items-center gap-1.5" href={`/sablon/${template.id}`}>
                  <span>Hazır sistemi incele</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- BOTTOM CATALOG CTA SECTION -->
  <section class="py-12 md:py-16 bg-canvas">
    <div class="max-w-4xl mx-auto px-4">
      <div class="relative rounded-3xl overflow-hidden border-2 border-gold/40 shadow-2xl bg-gradient-to-br from-navyDark via-[#132c48] to-navy text-white p-8 sm:p-12 text-center">
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-blue/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-gold/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-goldLight bg-white/10 border border-gold/30 px-4 py-1.5 rounded-full shadow-inner relative z-10">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          HAZIR UYGULAMA KATMANI
        </div>

        <h2 class="mt-4 text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight relative z-10">
          Yöntemi öğrendiniz; hazır sistemi karşılaştırın.
        </h2>

        <p class="mt-3 text-xs sm:text-sm md:text-base text-slate-200 max-w-2xl mx-auto leading-relaxed relative z-10">
          Rehberler doğru yöntemi ve kontrol mantığını açıklar. Şablon kataloğu ise aynı problemlerin hazır Excel sistemlerini, gerçek ekranlarını, çıktılarını ve teknik kapsamını yan yana gösterir.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3.5 relative z-10">
          <a href="/sablonlar" class="px-8 py-4 rounded-xl bg-gradient-to-r from-blue to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-extrabold text-sm sm:text-base shadow-xl shadow-blue/30 hover:scale-[1.02] transition-all flex items-center justify-center gap-2">
            <span>Excel Sistemlerini Karşılaştırın</span>
            <span>→</span>
          </a>
          <a href="/ozel-excel-sistemleri" class="px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm flex items-center justify-center gap-2 transition-all">
            <span>Özel Excel Sistemi Talebi</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</CommerceLayout>
