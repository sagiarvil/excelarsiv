---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import PreviewGallery from '../../components/PreviewGallery.astro';
import SheetMapTable from '../../components/SheetMapTable.astro';
import EligibilityList from '../../components/EligibilityList.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import KatalogUrunKarti from '../../components/catalog/KatalogUrunKarti.astro';
import CellGrid from '../../components/CellGrid.astro';
import { toTemplateViewModel } from '../../lib/templates';
import { kapakYolu } from '../../lib/kapak';
import PurchaseBar from '../../components/PurchaseBar.astro';
import Notice from '../../components/Notice.astro';
import ProductHeroPremium from '../../components/product/ProductHeroPremium.astro';
import CheckoutPanel from '../../components/CheckoutPanel.astro';
import DemoDownloadBox from '../../components/DemoDownloadBox.astro';
import YazarKutusu from '../../components/YazarKutusu.astro';
import { getCommerceProduct } from '../../lib/shopier';
import { yazarPersonId } from '../../data/yazar';
import { IADE_POLITIKASI } from '../../data/satici';
import { getProductAnswerSeo } from '../../data/productAnswerSeo';
import { getProductDecisionAnatomy } from '../../data/productDecisionAnatomy';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({
    params: { slug: template.id },
    props: { template },
  }));
}

interface Props {
  template: CollectionEntry<'templates'>;
}

const { template } = Astro.props;
const t = template.data;
const commerceProduct = getCommerceProduct(template.id);
const answerSeo = getProductAnswerSeo(template.id);
const kapak = kapakYolu(template.id);
const kapakUrl = kapak ? new URL(kapak, Astro.site).href : undefined;

const categoryLabels: Record<string, string> = {
  'finansal-analiz': 'Finansal Analiz',
  'nakit-akisi': 'Nakit Akışı',
  'muhasebe-ve-vergi': 'Muhasebe ve Vergi',
  'butce-ve-planlama': 'Bütçe ve Planlama',
  'stok-ve-uretim': 'Stok ve Üretim',
  'satis-ve-fiyatlama': 'Satış ve Fiyatlama',
  'personel-ve-bordro': 'Personel ve Bordro',
};
const categoryLabel = categoryLabels[t.category] ?? t.category;

const allTemplates = await getCollection('templates');
const related = allTemplates.filter((item) => t.related.includes(item.id));
const productUrl = new URL(`/sablon/${template.id}`, Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const personId = yazarPersonId(Astro.site ?? 'https://excelarsiv.com/');
const productId = `${productUrl}#product`;
const offerId = `${productUrl}#offer`;
const brandId = new URL('/#brand', Astro.site).href;
const webpageId = `${productUrl}#webpage`;
const priceValidUntil = t.updatedAt
  ? new Date(new Date(`${t.updatedAt}T00:00:00.000Z`).setUTCFullYear(new Date(`${t.updatedAt}T00:00:00.000Z`).getUTCFullYear() + 1)).toISOString()
  : new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString();
const returnPolicyUrl = new URL('/teslimat-ve-iade', Astro.site).href;
const coreCommercial: Record<string, { problem: string; result: string }> = {
  'aylik-patron-finans-paneli': {
    problem: 'Ciro, kâr, nakit ve alacak verileri farklı yerlerde kaldığında patron şirketin gerçekten güçlenip güçlenmediğini tek bakışta göremez.',
    result: 'Aylık temel finans göstergelerini tek yönetim ekranında toplayıp yönü, nakit baskısını ve kârlılık değişimini görün.',
  },
  '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi': {
    problem: 'Ödemeler yaklaşırken kasa açığını son anda görmek, kredi ve tedarikçi kararlarını pahalı hale getirir.',
    result: '13 haftalık tahsilat ve ödeme takviminde nakit açığını önceden görün; hangi haftada aksiyon gerektiğini planlayın.',
  },
  'banka-kredi-ve-taksit-takip-sistemi': {
    problem: 'Birden fazla banka, kredi ve taksit ayrı tablolarda izlendiğinde toplam borç yükü ve yaklaşan ödeme baskısı görünmez.',
    result: 'Kredileri, kalan borcu ve taksit takvimini tek dosyada toplayıp yaklaşan ödeme yükünü kontrol edin.',
  },
  'amortisman-2026-yeniden-degerleme': {
    problem: 'Amortisman ve yeniden değerleme hesabını dağınık yapmak vergi etkisini ve seçenekler arasındaki farkı görmeyi zorlaştırır.',
    result: '2026 amortisman ve yeniden değerleme hesabını aynı çalışma sisteminde karşılaştırıp karar için gerekli vergi etkisini görün.',
  },
  'insaat-hakedis-yonetim-sistemi': {
    problem: 'Hakediş, kesinti ve şantiye maliyeti farklı dosyalarda kaldığında tahsilat ve proje kârlılığı gecikmeli görülür.',
    result: 'Hakediş ve şantiye maliyet akışını tek Excel sisteminde izleyip gecikme, kesinti ve maliyet farklarını görün.',
  },
};
const coreOffer = coreCommercial[template.id];
const decision = getProductDecisionAnatomy(template.id, t.summary, t.priceTL, t.inputs, t.outputs);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      url: productUrl,
      name: t.name,
      description: t.summary,
      sku: template.id,
      image: t.screenshots.map((image) => new URL(image.src, Astro.site).href),
      brand: { '@id': brandId },
      creator: { '@id': personId },
      author: { '@id': personId },
      mainEntityOfPage: { '@id': webpageId },
      offers: {
        '@type': 'Offer',
        '@id': offerId,
        price: t.priceTL,
        priceCurrency: 'TRY',
        priceValidUntil,
        itemCondition: 'https://schema.org/NewCondition',
        availability: 'https://schema.org/InStock',
        url: productUrl,
        seller: { '@id': organizationId },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          applicableCountry: 'TR',
          returnPolicyCategory: IADE_POLITIKASI.schemaCategory,
          merchantReturnLink: returnPolicyUrl,
        },
      },
    },
    {
      '@type': 'Brand',
      '@id': brandId,
      name: 'Excel Arşiv',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${productUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Şablonlar', item: new URL('/sablonlar', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: categoryLabel, item: new URL(`/sablonlar/${t.category}`, Astro.site).href },
        { '@type': 'ListItem', position: 4, name: t.name },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${productUrl}#faq`,
      mainEntity: t.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<CommerceLayout
  title={`${t.name} — Excel Arşiv`}
  description={`${t.summary} Ücretsiz demo ile deneyin; Shopier ile güvenli ödeme sonrası ExcelArşiv üzerinden doğrudan indirin.`}
  ogImage={kapakUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="product-page">
    <Breadcrumbs
      crumbs={[
        { label: 'Şablonlar', href: '/sablonlar' },
        { label: categoryLabel, href: `/sablonlar/${t.category}` },
        { label: t.name },
      ]}
    />

    <ProductHeroPremium
      productSlug={template.id}
      name={t.name}
      summary={t.summary}
      categoryLabel={categoryLabel}
      priceTL={t.priceTL}
      screenshots={t.screenshots}
      kapakUrl={kapakUrl}
      outputs={t.outputs}
      sheetCount={t.sheetCount}
      minExcelVersion={t.minExcelVersion}
      macCompatible={t.macCompatible}
      deferCommerce={Boolean(coreOffer)}
    />

    <!-- MANDATE: 7 Zorunlu Soru & Satış Anatomisi (Problem, Acının Fiyatı, Karar Örneği) -->
    <section class="mandate-decision-suite" aria-label="Karar Sistemi Satış Anatomisi">
      <div class="mandate-pain-grid">
        <article class="mandate-pain-card mandate-pain-card--problem">
          <p class="section-kicker">1 · ÇÖZÜLEN PAHALI PROBLEM</p>
          <h2>{decision.problem}</h2>
          <div class="mandate-pain-price">
            <strong>Acının Somut Maliyeti:</strong>
            <p>{decision.painPrice}</p>
          </div>
        </article>

        <article class="mandate-pain-card mandate-pain-card--decision">
          <p class="section-kicker">5 · ALDIRDIĞI SOMUT KARAR</p>
          <h2>{decision.decisionAction}</h2>
          <div class="mandate-concrete-example">
            <strong>Gerçek Karar Örneği:</strong>
            <p>“{decision.concreteDecisionExample}”</p>
          </div>
        </article>
      </div>

      <!-- 7 Soruya Net Cevap Matrisi -->
      <div class="mandate-seven-questions">
        <div class="section-head section-head--compact">
          <div>
            <p class="section-kicker">ŞEFFAF KARAR ANATOMİSİ</p>
            <h2>Satın Almadan Önce 7 Kritik Sorunun Cevabı</h2>
          </div>
          <p>Excel Arşiv ürünleri sıradan şablon veya rapor değil; doğrudan aksiyon aldıran karar sistemleridir.</p>
        </div>

        <div class="seven-q-grid">
          <div class="q-item">
            <span class="q-num">02</span>
            <strong>Kim İçin Tasarlandı?</strong>
            <p>{decision.whoIsItFor}</p>
          </div>
          <div class="q-item">
            <span class="q-num">03</span>
            <strong>Hangi Verileri Giriyorum?</strong>
            <p>{decision.inputs.join(' · ')}</p>
          </div>
          <div class="q-item">
            <span class="q-num">04</span>
            <strong>Sistem Ne Hesaplıyor?</strong>
            <p>{decision.systemComputes}</p>
          </div>
          <div class="q-item">
            <span class="q-num">06</span>
            <strong>Hatalı/Eksik Veride Ne Oluyor?</strong>
            <p>{decision.wrongDataEffect}</p>
          </div>
          <div class="q-item q-item--highlight">
            <span class="q-num">07</span>
            <strong>Neden Teklif Almalıyım?</strong>
            <p>{decision.whyPayPrice}</p>
          </div>
        </div>
      </div>
    </section>

    {answerSeo && (
      <section class="product-answer hero-answer-engine" aria-labelledby="product-answer-title">
        <div class="product-answer__main hero-answer-engine__main">
          <p class="section-kicker">KISA CEVAP</p>
          <h2 id="product-answer-title">{answerSeo.answerQuestion}</h2>
          <p class="hero-answer-engine__summary">{answerSeo.answerSummary}</p>
        </div>
        <dl class="product-answer__facts">
          <div><dt>Temel girdiler</dt><dd>{t.inputs.slice(0, 3).join(' · ')}</dd></div>
          <div><dt>Temel çıktılar</dt><dd>{t.outputs.slice(0, 3).join(' · ')}</dd></div>
          <div><dt>Uyumluluk</dt><dd>{t.minExcelVersion}+ · {t.macCompatible ? 'Windows ve Mac' : 'Windows'}</dd></div>
        </dl>
      </section>
    )}

    <section id="onizleme" class="product-section product-section--preview">
      <div class="section-head">
        <div>
          <p class="section-kicker">GERÇEK ÜRÜN EKRANLARI</p>
          <h2>Satın alacağınız dosyayı görün.</h2>
        </div>
        <p>Temsilî görsel değil; ürünün gerçek çalışma ekranları. Görselleri büyüterek yapıyı satın almadan önce inceleyebilirsiniz.</p>
      </div>
      <PreviewGallery images={t.screenshots} />
    </section>

    {coreOffer && (
      <section class="core-conversion" aria-labelledby="core-conversion-title">
        <div class="section-head">
          <div><p class="section-kicker">DEMO → GÜVEN → SATIN AL</p><h2 id="core-conversion-title">Dosyayı önce inceleyin; uygunsa satın alın.</h2></div>
          <p>Gerçek ekranları gördünüz. Şimdi ücretsiz demoyu deneyebilir veya Shopier üzerinden tek ödeme ile satın alabilirsiniz.</p>
        </div>
        <div class="core-conversion__actions">
          <DemoDownloadBox productSlug={template.id} name={t.name} />
          <CheckoutPanel productSlug={template.id} name={t.name} priceTL={t.priceTL} />
        </div>
        <div class="core-conversion__trust">
          <span>✓ Gerçek ürün ekranları</span><span>✓ Ücretsiz demo</span><span>✓ Shopier güvenli ödeme</span><span>✓ KDV dahil fiyat</span>
        </div>
      </section>
    )}

    <section class="product-section product-section--flow">
      <div class="section-head section-head--light">
        <div>
          <p class="section-kicker">NASIL ÇALIŞIR?</p>
          <h2>Veriyi girin. Karar çıktısını alın.</h2>
        </div>
        <p>Karmaşık özellik listesi yerine sistemin sizden ne istediğini ve size ne verdiğini doğrudan görün.</p>
      </div>

      <div class="io-grid">
        <div class="io-card">
          <span>1 · GİRDİ</span>
          <h3>Siz girersiniz</h3>
          <ul>{t.inputs.map((item) => <li><b>→</b>{item}</li>)}</ul>
        </div>
        <div class="io-card io-card--output">
          <span>2 · ÇIKTI</span>
          <h3>Sistem üretir</h3>
          <ul>{t.outputs.map((item) => <li><b>✓</b>{item}</li>)}</ul>
        </div>
      </div>

      <details class="product-details">
        <summary>Dosyanın içinde hangi sayfalar var? <span>+</span></summary>
        <div class="product-details__body"><SheetMapTable sheets={t.sheetMap} /></div>
      </details>
    </section>

    <section class="product-section">
      <div class="section-head">
        <div>
          <p class="section-kicker">KİMLER İÇİN?</p>
          <h2>Doğru ürünü seçtiğinizden emin olun.</h2>
        </div>
        <p>Yanlış satın almayı azaltmak için uygun ve uygun olmayan kullanım senaryolarını birlikte gösteriyoruz.</p>
      </div>
      <div class="eligibility-grid">
        <EligibilityList title="Bu ürün size uygunsa" items={t.suitableFor} />
        <EligibilityList title="Bu ürün size uygun değilse" items={t.notSuitableFor} negative />
      </div>
    </section>

    <section class="product-section product-section--quiet">
      <div class="section-head">
        <div>
          <p class="section-kicker">TEKNİK BİLGİLER</p>
          <h2>Satın almadan önce bilmeniz gerekenler.</h2>
        </div>
        <p>Excel sürümü, platform, dosya tipi ve güncelleme koşulları burada. Karar için gerekli olmayan teknik detayları üst bölümde kalabalıklaştırmıyoruz.</p>
      </div>

      <details class="product-details" open>
        <summary>Uyumluluk ve dosya bilgileri <span>+</span></summary>
        <div class="product-details__body technical-grid">
          <SpecTable
            fileFormat={t.fileFormat}
            version={t.version}
            updatedAt={t.updatedAt}
            sheetCount={t.sheetCount}
            sizeMB={t.sizeMB}
            hasMacros={t.hasMacros}
            minExcelVersion={t.minExcelVersion}
            macCompatible={t.macCompatible}
            sheetsCompatibility={t.sheetsCompatibility}
          />
          <div class="requirements-card">
            <p class="requirements-card__title">ÇALIŞTIRMA GEREKSİNİMLERİ</p>
            <ul>{t.requirements.map((item) => <li><span>✓</span>{item}</li>)}</ul>
            <div class="requirements-card__policy">
              <small>GÜNCELLEME POLİTİKASI</small>
              <p>{t.updatePolicy}</p>
            </div>
          </div>
        </div>
      </details>

      {
        t.hasMacros && (
          <div class="macro-notice">
            <Notice type="warning">
              Bu dosya makro içerir. İlk açılışta Excel güvenlik uyarısı verir; içeriğe güveniyorsanız "Makroları Etkinleştir" ile açabilirsiniz.
            </Notice>
          </div>
        )
      }
    </section>

    <section id="sss" class="product-section">
      <div class="section-head">
        <div>
          <p class="section-kicker">SIK SORULAN SORULAR</p>
          <h2>Kalan soruları burada kapatın.</h2>
        </div>
      </div>
      <FaqAccordion items={t.faq} />
    </section>

    <section class="product-section product-section--author" aria-label="Tasarlayan ve denetleyen">
      <YazarKutusu varyant="sablon" />
    </section>

    <section class="product-referral" aria-label="Referans ve paylaşım">
      <div>
        <p class="section-kicker">REFERANS</p>
        <h2>Bu sistem başka bir işletmenin işini de kolaylaştırabilir mi?</h2>
        <p>Ürünü bir işletme sahibine veya mali müşavire iletin. Tavsiyenin kaynağı ürün sayfası olarak kalsın; fiyat ve kapsam herkes için aynı yerden görülsün.</p>
      </div>
      <a href={`/referans?urun=${encodeURIComponent(template.id)}`}>Paylaşım seçeneklerini aç →</a>
    </section>

    {
      related.length > 0 && (
        <section class="product-section product-section--related">
          <div class="section-head">
            <div>
              <p class="section-kicker">BU SİSTEMLE BİRLİKTE KULLANILABİLECEK SİSTEMLER</p>
              <h2>Aynı iş akışını tamamlayan ürünler.</h2>
            </div>
            <a href="/sablonlar">Tüm sistemleri görün →</a>
          </div>
          <CellGrid>
            {related.map((item) => (
              <KatalogUrunKarti template={toTemplateViewModel(item)} />
            ))}
          </CellGrid>
        </section>
      )
    }
  </main>

  <PurchaseBar name={t.name} priceTL={t.priceTL} satista={commerceProduct?.satista !== false} />
  <div class="h-20 sm:hidden" aria-hidden="true" />
</CommerceLayout>

<style>
  .product-page{width:min(1180px,calc(100% - 48px));margin-inline:auto;padding:26px 0 104px}.product-section{padding:clamp(54px,6vw,78px) 0;border-top:1px solid #e2e8e4}.section-head{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(280px,.72fr);gap:40px;align-items:end;margin-bottom:24px}.section-kicker{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.11em;color:#0b7440}.section-head h2{max-width:720px;margin:8px 0 0;font-family:var(--font-display);font-size:clamp(29px,3.1vw,42px);line-height:1.03;letter-spacing:-.035em;color:#16291e}.section-head>p{margin:0;font-size:12px;line-height:1.6;color:#69766e}.section-head>a{justify-self:end;color:#0b7440;font-size:10px;font-weight:700;text-decoration:none}.product-answer{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);gap:28px;margin:26px 0 8px;padding:24px;border:1px solid #dbe6df;border-radius:20px;background:#f7faf8}.product-answer__main h2{margin:7px 0 10px;font-family:var(--font-display);font-size:clamp(25px,2.8vw,36px);line-height:1.08;letter-spacing:-.03em;color:#16291e}.product-answer__main>p:last-child{margin:0;max-width:720px;font-size:13px;line-height:1.65;color:#526158}.product-answer__facts{display:grid;gap:0;margin:0;border:1px solid #e0e8e3;border-radius:14px;background:#fff;overflow:hidden}.product-answer__facts div{padding:12px 14px;border-bottom:1px solid #e6ece8}.product-answer__facts div:last-child{border-bottom:0}.product-answer__facts dt{font-family:var(--font-mono);font-size:8px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#0b7440}.product-answer__facts dd{margin:5px 0 0;font-size:11px;line-height:1.5;color:#425149}.product-section--preview{padding-top:58px}.product-section--flow{margin:0 -24px;padding-inline:24px;border:0;border-radius:24px;background:#0b3727;color:#fff}.section-head--light .section-kicker{color:#85d6a7}.section-head--light h2{color:#fff}.section-head--light>p{color:rgba(245,255,249,.66)}
  .io-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.io-card{padding:22px;border:1px solid rgba(255,255,255,.12);border-radius:16px;background:rgba(255,255,255,.05)}.io-card--output{background:rgba(112,218,156,.09);border-color:rgba(112,218,156,.18)}.io-card>span{font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.08em;color:#82d9a5}.io-card h3{margin:8px 0 0;font-size:19px;color:#fff}.io-card ul{display:grid;gap:8px;margin:16px 0 0;padding:0;list-style:none}.io-card li{display:flex;gap:8px;font-size:11.5px;line-height:1.45;color:rgba(245,255,249,.74)}.io-card li b{color:#83dda8;font-family:var(--font-mono)}
