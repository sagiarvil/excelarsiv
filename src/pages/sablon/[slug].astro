---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KatalogUrunKarti from '../../components/catalog/KatalogUrunKarti.astro';
import CellGrid from '../../components/CellGrid.astro';
import { toTemplateViewModel } from '../../lib/templates';
import { kapakYolu } from '../../lib/kapak';
import PurchaseBar from '../../components/PurchaseBar.astro';
import YazarKutusu from '../../components/YazarKutusu.astro';
import { getCommerceProduct } from '../../lib/shopier';
import { yazarPersonId } from '../../data/yazar';
import { IADE_POLITIKASI } from '../../data/satici';
import { getProductFullDescription } from '../../data/productDescriptions';
import ProductGallerySlider from '../../components/product/ProductGallerySlider.astro';
import ProductPurchaseCard from '../../components/product/ProductPurchaseCard.astro';
import ProductTabsSomeka from '../../components/product/ProductTabsSomeka.astro';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({
    params: { slug: template.id },
    props: { template },
  }));
}

interface Props {
  template: CollectionEntry<'templates'>;
}

const { template } = Astro.props;
const t = template.data;
const commerceProduct = getCommerceProduct(template.id);
const kapak = kapakYolu(template.id);
const kapakUrl = kapak ? new URL(kapak, Astro.site).href : undefined;

const categoryLabels: Record<string, string> = {
  'finansal-analiz': 'Finansal Analiz',
  'nakit-akisi': 'Nakit Akışı',
  'muhasebe-ve-vergi': 'Muhasebe ve Vergi',
  'butce-ve-planlama': 'Bütçe ve Planlama',
  'stok-ve-uretim': 'Stok ve Üretim',
  'satis-ve-fiyatlama': 'Satış ve Fiyatlama',
  'personel-ve-bordro': 'Personel ve Bordro',
};
const categoryLabel = categoryLabels[t.category] ?? t.category;

const allTemplates = await getCollection('templates');
const related = allTemplates.filter((item) => t.related.includes(item.id));
const productUrl = new URL(`/sablon/${template.id}`, Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const personId = yazarPersonId(Astro.site ?? 'https://excelarsiv.com/');
const productId = `${productUrl}#product`;
const offerId = `${productUrl}#offer`;
const brandId = new URL('/#brand', Astro.site).href;
const webpageId = `${productUrl}#webpage`;
const priceValidUntil = t.updatedAt
  ? new Date(new Date(`${t.updatedAt}T00:00:00.000Z`).setUTCFullYear(new Date(`${t.updatedAt}T00:00:00.000Z`).getUTCFullYear() + 1)).toISOString()
  : new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString();
const returnPolicyUrl = new URL('/teslimat-ve-iade', Astro.site).href;

// 51 Ürün İçin Zenginleştirilmiş Psikolojisi Güçlü Ürün Açıklaması
const descriptionData = getProductFullDescription({
  id: template.id,
  name: t.name,
  summary: t.summary,
  category: t.category,
  priceTL: t.priceTL,
  sheetMap: t.sheetMap,
  inputs: t.inputs,
  outputs: t.outputs,
  suitableFor: t.suitableFor,
  notSuitableFor: t.notSuitableFor,
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      url: productUrl,
      name: t.name,
      description: t.summary,
      sku: template.id,
      image: t.screenshots.map((image) => new URL(image.src, Astro.site).href),
      brand: { '@id': brandId },
      creator: { '@id': personId },
      author: { '@id': personId },
      mainEntityOfPage: { '@id': webpageId },
      offers: {
        '@type': 'Offer',
        '@id': offerId,
        price: t.priceTL,
        priceCurrency: 'TRY',
        priceValidUntil,
        itemCondition: 'https://schema.org/NewCondition',
        availability: 'https://schema.org/InStock',
        url: productUrl,
        seller: { '@id': organizationId },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          applicableCountry: 'TR',
          returnPolicyCategory: IADE_POLITIKASI.schemaCategory,
          merchantReturnLink: returnPolicyUrl,
        },
      },
    },
    {
      '@type': 'Brand',
      '@id': brandId,
      name: 'Excel Arşiv',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${productUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Şablonlar', item: new URL('/sablonlar', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: categoryLabel, item: new URL(`/sablonlar/${t.category}`, Astro.site).href },
        { '@type': 'ListItem', position: 4, name: t.name },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${productUrl}#faq`,
      mainEntity: t.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<CommerceLayout
  title={`${t.name} — Excel Arşiv`}
  description={`${t.summary} Ücretsiz demo ile deneyin; Shopier ile güvenli ödeme sonrası ExcelArşiv üzerinden doğrudan indirin.`}
  ogImage={kapakUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="product-page-container">
    <!-- Ekmek Kırıntısı (Breadcrumbs) -->
    <div class="product-breadcrumb-wrap">
      <Breadcrumbs
        crumbs={[
          { label: 'Şablonlar', href: '/sablonlar' },
          { label: categoryLabel, href: `/sablonlar/${t.category}` },
          { label: t.name },
        ]}
      />
    </div>

    <!-- Üst Başlık Alanı (Someka Stili) -->
    <header class="product-header">
      <div class="product-category-tag">{categoryLabel}</div>
      <h1 class="product-main-heading">{t.name}</h1>
      <p class="product-subtitle-lead">{descriptionData.subTitle}</p>
    </header>

    <!-- 2 Kolonlu Hero Alanı (Someka Modeli: Sol Galeri, Sağ Satın Alma) -->
    <section class="product-hero-cockpit" aria-label="Ürün Önizleme ve Satın Alma">
      <!-- Sol Kolon: Geniş Görsel Slider & Thumbnails -->
      <div class="hero-col-gallery">
        <ProductGallerySlider
          name={t.name}
          kapakUrl={kapakUrl}
          screenshots={t.screenshots}
        />
      </div>

      <!-- Sağ Kolon: Demo İndir ve Satın Alma Kartı -->
      <aside class="hero-col-purchase">
        <ProductPurchaseCard
          productSlug={template.id}
          name={t.name}
          priceTL={t.priceTL}
          sheetCount={t.sheetCount}
          minExcelVersion={t.minExcelVersion}
          macCompatible={t.macCompatible}
          hasMacros={t.hasMacros}
        />
      </aside>
    </section>

    <!-- Sekmeli Zengin İçerik Alanı (Someka Tabs) -->
    <ProductTabsSomeka
      name={t.name}
      descriptionData={descriptionData}
      sheetMap={t.sheetMap}
      inputs={t.inputs}
      outputs={t.outputs}
      suitableFor={t.suitableFor}
      notSuitableFor={t.notSuitableFor}
      faq={t.faq}
      spec={{
        fileFormat: t.fileFormat,
        version: t.version,
        updatedAt: t.updatedAt,
        sheetCount: t.sheetCount,
        sizeMB: t.sizeMB,
        hasMacros: t.hasMacros,
        minExcelVersion: t.minExcelVersion,
        macCompatible: t.macCompatible,
        sheetsCompatibility: t.sheetsCompatibility,
      }}
      requirements={t.requirements}
      updatePolicy={t.updatePolicy}
    />

    <!-- Tasarlayan ve Denetleyen Yazar Kutusu -->
    <section class="product-author-section" aria-label="Tasarlayan ve Denetleyen">
      <YazarKutusu varyant="sablon" />
    </section>

    <!-- Birlikte Kullanılabilecek İlgili Sistemler -->
    {related.length > 0 && (
      <section class="product-related-section" aria-label="Benzer ve Tamamlayıcı Şablonlar">
        <div class="related-section-header">
          <div>
            <span class="related-kicker">BENZER SİSTEMLER</span>
            <h2>Aynı İş Akışını Tamamlayan Diğer Excel Şablonları</h2>
          </div>
          <a href="/sablonlar" class="all-templates-link">Tüm Şablonları Gör →</a>
        </div>
        <CellGrid>
          {related.map((item) => (
            <KatalogUrunKarti template={toTemplateViewModel(item)} />
          ))}
        </CellGrid>
      </section>
    )}
  </main>

  <PurchaseBar name={t.name} priceTL={t.priceTL} satista={commerceProduct?.satista !== false} />
  <div class="h-20 sm:hidden" aria-hidden="true" />
</CommerceLayout>

<style>
  .product-page-container {
    width: min(1200px, calc(100% - 40px));
    margin-inline: auto;
    padding: 20px 0 80px;
  }

  .product-breadcrumb-wrap {
    margin-bottom: 12px;
  }

  /* Üst Başlık */
  .product-header {
    margin-bottom: 24px;
  }
  .product-category-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0b743f;
    margin-bottom: 6px;
  }
  .product-main-heading {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.15;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }
  .product-subtitle-lead {
    font-size: 14.5px;
    line-height: 1.6;
    color: #475569;
    max-width: 920px;
    margin: 0;
  }

  /* 2 Kolonlu Hero Alanı (Someka Modeli) */
  .product-hero-cockpit {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(360px, 0.9fr);
    gap: 32px;
    align-items: start;
  }

  .hero-col-gallery {
    min-width: 0;
  }

  .hero-col-purchase {
    min-width: 0;
    position: sticky;
    top: 24px;
  }

  /* Yazar Kutusu */
  .product-author-section {
    margin-top: 48px;
  }

  /* İlgili Şablonlar */
  .product-related-section {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid #e2e8f0;
  }
  .related-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
  }
  .related-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #0b743f;
    margin-bottom: 4px;
  }
  .related-section-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .all-templates-link {
    color: #0b743f;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .all-templates-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .product-hero-cockpit {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-col-purchase {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .product-page-container {
      width: calc(100% - 24px);
      padding-top: 14px;
    }
    .product-main-heading {
      font-size: 24px;
    }
    .product-subtitle-lead {
      font-size: 13px;
    }
    .related-section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
