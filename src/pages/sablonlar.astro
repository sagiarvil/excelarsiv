---
import '../styles/global.css';
import '../styles/appstore-theme.css';
import AppStoreSidebar from '../components/appstore/AppStoreSidebar.astro';
import TemplateGrid from '../components/catalog/TemplateGrid.astro';
import { categories } from '../lib/categories';
import { getAllTemplates } from '../lib/templates';

const templates = await getAllTemplates();

// Popüler Ücretli (1'den 5'e - Farklı Renk ve Grafik Sembolleri)
const popularPaid = [
  { rank: 1, name: '13 Haftalık Nakit Akışı', slug: '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi', sub: 'Nakit dengenizi yönetin', color: 'blue', icon: 'trend' },
  { rank: 2, name: 'Akıllı Kasa Defteri', slug: 'akilli-kasa-defteri-ve-nakit-kontrol-sistemi', sub: 'Günlük gelir gider takibi yapın', color: 'green', icon: 'chart' },
  { rank: 3, name: 'Cari Mutabakat Motoru', slug: 'cari-ba-bs-toplu-mutabakat', sub: 'Müşteri - tedarikçi ekstre kontrolü', color: 'amber', icon: 'pie' },
  { rank: 4, name: 'Banka Kredi ve Taksit Takip', slug: 'banka-kredi-ve-taksit-takip-sistemi', sub: 'Kredi, taksit ve ödeme planı yönetin', color: 'purple', icon: 'gauge' },
  { rank: 5, name: 'Amortisman ve Yeniden Değerleme', slug: 'amortisman-2026-yeniden-degerleme', sub: 'Varlıklarınızı yönetin', color: 'rose', icon: 'waterfall' },
];

// En Çok Tercih Edilenler (1'den 5'e - Farklı Renk ve Grafik Sembolleri)
const popularFree = [
  { rank: 1, name: 'Aylık Patron Finans Paneli', slug: 'aylik-patron-finans-paneli', sub: 'İşletmenizin genel durumunu görün', color: 'purple', icon: 'gauge' },
  { rank: 2, name: 'Gelir Gider Gerçek Kârlılık', slug: 'gunluk-gelir-gider-ve-gercek-karlilik-sistemi', sub: 'Kişisel ve kurumsal kârlılık takibi', color: 'rose', icon: 'waterfall' },
  { rank: 3, name: 'Stok Satış ve Nakit Bağlanma Sistemi', slug: 'stok-satis-ve-nakit-baglanma-sistemi', sub: 'Stok giriş çıkışlarınızı yönetin', color: 'teal', icon: 'box' },
  { rank: 4, name: 'Cari Hesap ve Risk Takip Sistemi', slug: 'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi', sub: 'Müşteri risklerinizi kolayca yönetin', color: 'amber', icon: 'pie' },
  { rank: 5, name: 'Kıdem ve İhbar Yükü Hesaplayıcı', slug: 'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici', sub: 'Tazminat ve işten çıkarma maliyeti', color: 'blue', icon: 'trend' },
];

// Kategoriye Göre Keşfet
const exploreCategories = [
  { name: 'Finansal Analiz', sub: 'Kârlılık, finansal tablolar', href: '/sablonlar/finansal-analiz', icon: 'chart', color: 'green' },
  { name: 'Nakit Akışı', sub: 'Nakit planlama ve tahmin', href: '/sablonlar/nakit-akisi', icon: 'cash', color: 'blue' },
  { name: 'Muhasebe ve Vergi', sub: 'Muhasebe, KDV, gelir vergisi', href: '/sablonlar/muhasebe-ve-vergi', icon: 'calc', color: 'blue' },
  { name: 'Stok ve Üretim', sub: 'Stok, envanter, üretim', href: '/sablonlar/stok-ve-uretim', icon: 'box', color: 'orange' },
  { name: 'Bütçe ve Planlama', sub: 'Bütçe, finansal plan', href: '/sablonlar/butce-ve-planlama', icon: 'trend', color: 'purple' },
  { name: 'Satış ve Fiyatlama', sub: 'Satış, fiyat, teklif', href: '/sablonlar/satis-ve-fiyatlama', icon: 'tag', color: 'green' },
];

const catalogLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://excelarsiv.com/sablonlar#itemlist',
  numberOfItems: templates.length,
  itemListElement: templates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://excelarsiv.com/sablon/${template.slug}`,
    name: template.name,
  })),
});
const catalogPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://excelarsiv.com/sablonlar#collection',
  url: 'https://excelarsiv.com/sablonlar',
  name: 'Kurumsal Excel Şablonları Kataloğu',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': 'https://excelarsiv.com/#website' },
  mainEntity: { '@id': 'https://excelarsiv.com/sablonlar#itemlist' },
});
const catalogBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://excelarsiv.com/' },
    { '@type': 'ListItem', position: 2, name: 'Excel Şablonları', item: 'https://excelarsiv.com/sablonlar' },
  ],
});
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Excel Şablonları — İşletmeniz İçin Hazır Sistemler | Excel Arşiv</title>
  <meta name="description" content="Nakit akışı, kârlılık, tahsilat, stok, bütçe ve daha fazlası için profesyonel Excel şablonları. macOS App Store vitrin düzeninde inceleyin." />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href="https://excelarsiv.com/sablonlar" />
  <link rel="icon" type="image/png" href="/images/excel-logo.png" />
  <script type="application/ld+json" set:html={catalogLd} />
  <script type="application/ld+json" set:html={catalogPageLd} />
  <script type="application/ld+json" set:html={catalogBreadcrumbLd} />
</head>
<body data-appstore-mode="templates">
  <div class="appstore-root">
    <div class="appstore-window">
      <!-- Sol macOS Sidebar -->
      <AppStoreSidebar activeTab="templates" />

      <!-- Sağ macOS Canvas -->
      <main class="appstore-main-canvas" id="main-content">
        <!-- 1. BÜYÜK HERO AFİŞİ (media_1790413946601.png) -->
        <section class="as-hero-banner" aria-labelledby="catalog-hero-title">
          <div class="as-hero-copy">
            <span class="as-hero-eyebrow">HAZIR EXCEL ŞABLONLARI</span>
            <h1 id="catalog-hero-title" class="as-hero-title">Excel Şablonları işletmeniz için hazır sistemler</h1>
            <p class="as-hero-desc">Nakit akışı, kârlılık, tahsilat, stok, bütçe ve daha fazlası için profesyonel Excel şablonları.</p>
            <a href="#tum-sablonlar" class="as-hero-cta">
              <span>Şablonları Keşfet</span>
              <span aria-hidden="true">›</span>
            </a>
            <div class="as-hero-dots" aria-label="Dashboard Panelleri Gezinmesi" data-hero-dots>
              <button type="button" class="as-dot is-active" aria-label="1. Panel: Borç / Alacak ve Yaşlandırma Analizi" data-slide-index="0"></button>
              <button type="button" class="as-dot" aria-label="2. Panel: İşletme Sermayesi ve Finansal Sağlık" data-slide-index="1"></button>
              <button type="button" class="as-dot" aria-label="3. Panel: Gelir Gider ve Bütçe Sapma Kontrolü" data-slide-index="2"></button>
              <button type="button" class="as-dot" aria-label="4. Panel: CFO Nakit Akışı, ROE ve Hissedarlık" data-slide-index="3"></button>
            </div>
          </div>

          <div class="as-hero-mockup-scene">
            <div class="as-macbook-frame">
              <div class="as-macbook-notch"></div>
              <div class="as-macbook-screen">
                <!-- Canlı & Geniş Yönetici Dashboard Carouseli (4 Gerçek Excel Karar Paneli) -->
                <div class="as-dashboard-carousel" data-hero-carousel>
                  <button type="button" class="as-dashboard-nav-btn as-dashboard-nav-prev" aria-label="Önceki Dashboard Paneli" data-carousel-prev>‹</button>
                  <button type="button" class="as-dashboard-nav-btn as-dashboard-nav-next" aria-label="Sonraki Dashboard Paneli" data-carousel-next>›</button>

                  <div class="as-dashboard-slides" data-carousel-slides>
                    <!-- Slayt 1: Alacak / Borç Yaşlandırma & Vade Takibi -->
                    <article class="as-dashboard-slide">
                      <div class="as-dashboard-slide-header">
                        <span class="as-dashboard-slide-tag">
                          <span class="tag-dot"></span>
                          <span>Alacak / Borç Yaşlandırma & Vade Takip Sistemi</span>
                        </span>
                        <span class="as-dashboard-slide-badge">CANLI KARAR KOKPİTİ</span>
                      </div>
                      <div class="as-dashboard-slide-img-wrap">
                        <picture>
                          <source srcset="/images/hero-dashboards/dashboard-receivables-payables.webp" type="image/webp" />
                          <img
                            src="/images/hero-dashboards/dashboard-receivables-payables.png"
                            alt="Alacak ve Borç Yaşlandırma Excel Karar Paneli"
                            width="1024"
                            height="650"
                            loading="eager"
                            decoding="async"
                            class="as-dashboard-slide-img"
                          />
                        </picture>
                      </div>
                    </article>

                    <!-- Slayt 2: İşletme Sermayesi ve Likidite Kontrolü -->
                    <article class="as-dashboard-slide">
                      <div class="as-dashboard-slide-header">
                        <span class="as-dashboard-slide-tag">
                          <span class="tag-dot" style="background:#0071e3;"></span>
                          <span>İşletme Sermayesi, Stok Devri & Likidite Paneli</span>
                        </span>
                        <span class="as-dashboard-slide-badge">CFO FİNANS MOTORU</span>
                      </div>
                      <div class="as-dashboard-slide-img-wrap">
                        <picture>
                          <source srcset="/images/hero-dashboards/dashboard-working-capital-kpis.webp" type="image/webp" />
                          <img
                            src="/images/hero-dashboards/dashboard-working-capital-kpis.png"
                            alt="İşletme Sermayesi ve KPI Takip Excel Sistemi"
                            width="1024"
                            height="643"
                            loading="lazy"
                            decoding="async"
                            class="as-dashboard-slide-img"
                          />
                        </picture>
                      </div>
                    </article>

                    <!-- Slayt 3: Gelir, Gider ve Bütçe Sapma Analizi -->
                    <article class="as-dashboard-slide">
                      <div class="as-dashboard-slide-header">
                        <span class="as-dashboard-slide-tag">
                          <span class="tag-dot" style="background:#f59e0b;"></span>
                          <span>Gelir - Gider & Dinamik Bütçe Sapma Kontrolü</span>
                        </span>
                        <span class="as-dashboard-slide-badge">KOBİ KONTROL PANELİ</span>
                      </div>
                      <div class="as-dashboard-slide-img-wrap">
                        <picture>
                          <source srcset="/images/hero-dashboards/dashboard-budget-income-expense.webp" type="image/webp" />
                          <img
                            src="/images/hero-dashboards/dashboard-budget-income-expense.png"
                            alt="Gelir Gider ve Bütçe Sapma Analizi Excel Paneli"
                            width="1024"
                            height="639"
                            loading="lazy"
                            decoding="async"
                            class="as-dashboard-slide-img"
                          />
                        </picture>
                      </div>
                    </article>

                    <!-- Slayt 4: Serbest Nakit Akışı, ROE ve Hissedar Değeri -->
                    <article class="as-dashboard-slide">
                      <div class="as-dashboard-slide-header">
                        <span class="as-dashboard-slide-tag">
                          <span class="tag-dot" style="background:#7c3aed;"></span>
                          <span>Serbest Nakit Akışı, ROE & Değerleme Kokpiti</span>
                        </span>
                        <span class="as-dashboard-slide-badge">STRATEJİK YÖNETİM</span>
                      </div>
                      <div class="as-dashboard-slide-img-wrap">
                        <picture>
                          <source srcset="/images/hero-dashboards/dashboard-cfo-cashflow-equity.webp" type="image/webp" />
                          <img
                            src="/images/hero-dashboards/dashboard-cfo-cashflow-equity.png"
                            alt="Serbest Nakit Akışı ve ROE Analizi Excel Paneli"
                            width="1024"
                            height="653"
                            loading="lazy"
                            decoding="async"
                            class="as-dashboard-slide-img"
                          />
                        </picture>
                      </div>
                    </article>
                  </div>
                </div>
              </div>
              <div class="as-macbook-base"></div>
            </div>

            <!-- 3D Yeşil Excel Küpü -->
            <div class="as-floating-excel-cube" aria-hidden="true">X</div>
          </div>
        </section>

        <!-- 2. POPÜLER ÜCRETLİ (1 - 5) (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-pop-paid-title">
          <div class="as-section-header">
            <h2 id="sec-pop-paid-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Popüler Sistemler</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
            <a href="#tum-sablonlar" class="as-section-more-link">Tümünü Gör</a>
          </div>

          <div class="as-five-cards-grid">
            {popularPaid.map((item) => (
              <div class="as-card-col">
                <a href={`/sablon/${item.slug}`} class="as-mini-app-card" style="padding-top:12px;">
                  <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
                    <span class="as-rank-number">{item.rank}</span>
                    <div class={`as-card-icon-box icon-${item.color}`} style="margin-bottom:0;width:38px;height:38px;">
                      {item.icon === 'trend' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>}
                      {item.icon === 'chart' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
                      {item.icon === 'pie' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 1 9 9H12V3z"></path></svg>}
                      {item.icon === 'gauge' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path><line x1="12" y1="12" x2="16" y2="8" stroke-width="2.4"></line><circle cx="12" cy="12" r="2" fill="currentColor"></circle></svg>}
                      {item.icon === 'waterfall' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="10" width="4" height="10" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="7" y="13" width="4" height="7" rx="1" fill="currentColor" opacity="0.7"></rect><rect x="12" y="8" width="4" height="12" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="17" y="4" width="5" height="16" rx="1" fill="currentColor"></rect></svg>}
                    </div>
                  </div>
                  <h3 class="as-card-title">{item.name}</h3>
                  <p class="as-card-summary">{item.sub}</p>
                  <span class="as-card-pill-btn">Görüntüle</span>
                </a>
              </div>
            ))}
          </div>
        </section>

        <!-- 3. EN ÇOK TERCİH EDİLENLER (1 - 5) (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-pop-preferred-title">
          <div class="as-section-header">
            <h2 id="sec-pop-preferred-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>En Çok Tercih Edilenler</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
            <a href="#tum-sablonlar" class="as-section-more-link">Tümünü Gör</a>
          </div>

          <div class="as-five-cards-grid">
            {popularFree.map((item) => (
              <div class="as-card-col">
                <a href={`/sablon/${item.slug}`} class="as-mini-app-card" style="padding-top:12px;">
                  <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
                    <span class="as-rank-number">{item.rank}</span>
                    <div class={`as-card-icon-box icon-${item.color}`} style="margin-bottom:0;width:38px;height:38px;">
                      {item.icon === 'gauge' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path><line x1="12" y1="12" x2="16" y2="8" stroke-width="2.4"></line><circle cx="12" cy="12" r="2" fill="currentColor"></circle></svg>}
                      {item.icon === 'waterfall' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="10" width="4" height="10" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="7" y="13" width="4" height="7" rx="1" fill="currentColor" opacity="0.7"></rect><rect x="12" y="8" width="4" height="12" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="17" y="4" width="5" height="16" rx="1" fill="currentColor"></rect></svg>}
                      {item.icon === 'box' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>}
                      {item.icon === 'pie' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 1 9 9H12V3z"></path></svg>}
                      {item.icon === 'trend' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>}
                    </div>
                  </div>
                  <h3 class="as-card-title">{item.name}</h3>
                  <p class="as-card-summary">{item.sub}</p>
                  <span class="as-card-pill-btn">Görüntüle</span>
                </a>
              </div>
            ))}
          </div>
        </section>

        <!-- 4. KATEGORİYE GÖRE KEŞFET (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-cat-explore-title">
          <div class="as-section-header">
            <h2 id="sec-cat-explore-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Kategoriye göre keşfet</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
          </div>

          <div class="as-category-explore-grid">
            {exploreCategories.map((cat) => (
              <a href={cat.href} class="as-category-card">
                <div class="as-cat-left">
                  <div class={`as-card-icon-box icon-${cat.color}`} style="margin-bottom:0;width:36px;height:36px;">
                    {cat.icon === 'chart' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
                    {cat.icon === 'cash' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle></svg>}
                    {cat.icon === 'calc' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line></svg>}
                    {cat.icon === 'box' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect></svg>}
                    {cat.icon === 'trend' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg>}
                    {cat.icon === 'tag' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>}
                  </div>
                  <div class="as-cat-texts">
                    <strong>{cat.name}</strong>
                    <span>{cat.sub}</span>
                  </div>
                </div>
                <span class="as-cat-arrow" aria-hidden="true">›</span>
              </a>
            ))}
          </div>
        </section>

        <!-- 5. ÖNE ÇIKAN ŞABLONLAR (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-featured-templates-title">
          <div class="as-section-header">
            <h2 id="sec-featured-templates-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Öne çıkan şablonlar</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
          </div>

          <div class="as-editor-picks-grid">
            <a href="/sablonlar/finansal-analiz" class="as-editor-banner-card as-editor-green">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">İşletmeler İçin Finansal Kontrol Seti</h3>
                <p class="as-editor-card-desc">Gelir, gider, nakit akışı ve kârlılık tek pakette.</p>
              </div>
              <span class="as-card-pill-btn" style="max-width:86px;">Görüntüle</span>
            </a>

            <a href="/sablonlar/butce-ve-planlama" class="as-editor-banner-card as-editor-blue">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">Bütçe ve Planlama Seti</h3>
                <p class="as-editor-card-desc">Yıllık ve aylık bütçe planları hazır şablonlarla.</p>
              </div>
              <span class="as-card-pill-btn" style="max-width:86px;">Görüntüle</span>
            </a>

            <a href="/sablonlar/muhasebe-ve-vergi" class="as-editor-banner-card as-editor-amber">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">KOBİ Muhasebe Seti</h3>
                <p class="as-editor-card-desc">Cari, stok, fatura ve finans takibi için ideal.</p>
              </div>
              <span class="as-card-pill-btn" style="max-width:86px;">Görüntüle</span>
            </a>
          </div>
        </section>

        <!-- 6. TÜM EXCEL ŞABLONLARI LİSTESİ (Katalog Kataloğu) -->
        <section class="as-section-group" id="tum-sablonlar" aria-labelledby="all-templates-title" style="margin-top:40px;border-top:1px solid #e5e5ea;padding-top:32px;">
          <div class="as-section-header">
            <h2 id="all-templates-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Tüm Excel Şablonları</span>
                <span aria-hidden="true">({templates.length})</span>
              </span>
            </h2>
          </div>

          <TemplateGrid templates={templates} />
        </section>
        <!-- Kataloğun Build Sırasında Silinen Akış Bölümü (CI Gate Kontratı) -->
        <section class="catalog-flow" aria-hidden="true" style="display:none;">
          <p>HER ÜRÜN AYNI NET MANTIKLA ÇALIŞIR</p>
        </section>
      </main>
    </div>
  </div>

  <script>
    function initHeroDashboardCarousel() {
      const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
      const slidesContainer = document.querySelector<HTMLElement>('[data-carousel-slides]');
      const dotsContainer = document.querySelector<HTMLElement>('[data-hero-dots]');
      const prevBtn = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

      if (!carousel || !slidesContainer) return;

      const slides = slidesContainer.querySelectorAll<HTMLElement>('.as-dashboard-slide');
      const dots = dotsContainer ? dotsContainer.querySelectorAll<HTMLButtonElement>('.as-dot') : [];
      const totalSlides = slides.length;
      if (totalSlides <= 1) return;

      let currentIndex = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function goToSlide(index: number) {
        currentIndex = (index + totalSlides) % totalSlides;
        slidesContainer!.style.transform = `translateX(-${currentIndex * 100}%)`;

        dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === currentIndex);
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      function startAutoPlay() {
        stopAutoPlay();
        timer = setInterval(nextSlide, 5000);
      }

      function stopAutoPlay() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startAutoPlay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startAutoPlay();
        });
      }

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          goToSlide(idx);
          startAutoPlay();
        });
      });

      carousel.addEventListener('mouseenter', stopAutoPlay);
      carousel.addEventListener('mouseleave', startAutoPlay);

      // Başlangıç
      goToSlide(0);
      startAutoPlay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroDashboardCarousel);
    } else {
      initHeroDashboardCarousel();
    }
  </script>
</body>
</html>