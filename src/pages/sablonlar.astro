---
import '../styles/global.css';
import '../styles/appstore-theme.css';
import AppStoreSidebar from '../components/appstore/AppStoreSidebar.astro';
import TemplateGrid from '../components/catalog/TemplateGrid.astro';
import { categories } from '../lib/categories';
import { getAllTemplates } from '../lib/templates';

const templates = await getAllTemplates();

// Popüler Ücretli (1'den 5'e)
const popularPaid = [
  { rank: 1, name: '13 Haftalık Nakit Akışı', slug: '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi', sub: 'Nakit dengenizi yönetin', color: 'green', icon: 'chart' },
  { rank: 2, name: 'Akıllı Kasa Defteri', slug: 'akilli-kasa-defteri-ve-nakit-kontrol-sistemi', sub: 'Günlük gelir gider takibi yapın', color: 'green', icon: 'wallet' },
  { rank: 3, name: 'Cari Mutabakat Motoru', slug: 'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi', sub: 'Müşteri - tedarikçi ekstre kontrolü', color: 'blue', icon: 'users' },
  { rank: 4, name: 'Banka Kredi ve Taksit Takip', slug: 'banka-kredi-ve-taksit-takip-sistemi', sub: 'Kredi, taksit ve ödeme planı yönetin', color: 'green', icon: 'bank' },
  { rank: 5, name: 'Amortisman ve Yeniden Değerleme', slug: 'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici', sub: 'Varlıklarınızı yönetin', color: 'purple', icon: 'calc' },
];

// Popüler Ücretsiz (1'den 5'e)
const popularFree = [
  { rank: 1, name: 'Aylık Patron Finans Paneli', slug: 'aylik-patron-finans-paneli', sub: 'İşletmenizin genel durumunu görün', color: 'green', icon: 'trend' },
  { rank: 2, name: 'Gelir Gider Takip', slug: 'akilli-kasa-defteri-ve-nakit-kontrol-sistemi', sub: 'Kişisel ve kurumsal finans takibi', color: 'green', icon: 'doc' },
  { rank: 3, name: 'Stok Takip ve Envanter Yönetimi', slug: 'stok-satis-ve-nakit-baglanma-sistemi', sub: 'Stok giriş çıkışlarınızı yönetin', color: 'orange', icon: 'box' },
  { rank: 4, name: 'Müşteri Risk Takip', slug: 'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi', sub: 'Müşteri risklerinizi kolayca yönetin', color: 'blue', icon: 'pie' },
  { rank: 5, name: 'Personel Bordro Sistemi', slug: 'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici', sub: 'Personel maaş ve bordro takibi', color: 'amber', icon: 'users' },
];

// Kategoriye Göre Keşfet
const exploreCategories = [
  { name: 'Finansal Analiz', sub: 'Kârlılık, finansal tablolar', href: '/sablonlar/finansal-analiz', icon: 'chart', color: 'green' },
  { name: 'Nakit Akışı', sub: 'Nakit planlama ve tahmin', href: '/sablonlar/nakit-akisi', icon: 'cash', color: 'blue' },
  { name: 'Muhasebe ve Vergi', sub: 'Muhasebe, KDV, gelir vergisi', href: '/sablonlar/muhasebe-ve-vergi', icon: 'calc', color: 'blue' },
  { name: 'Stok ve Üretim', sub: 'Stok, envanter, üretim', href: '/sablonlar/stok-ve-uretim', icon: 'box', color: 'orange' },
  { name: 'Bütçe ve Planlama', sub: 'Bütçe, finansal plan', href: '/sablonlar/butce-ve-planlama', icon: 'trend', color: 'purple' },
  { name: 'Satış ve Fiyatlama', sub: 'Satış, fiyat, teklif', href: '/sablonlar/satis-ve-fiyatlama', icon: 'tag', color: 'green' },
];

const catalogLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://excelarsiv.com/sablonlar#itemlist',
  numberOfItems: templates.length,
  itemListElement: templates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://excelarsiv.com/sablon/${template.slug}`,
    name: template.name,
  })),
});
const catalogPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://excelarsiv.com/sablonlar#collection',
  url: 'https://excelarsiv.com/sablonlar',
  name: 'Kurumsal Excel Şablonları Kataloğu',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': 'https://excelarsiv.com/#website' },
  mainEntity: { '@id': 'https://excelarsiv.com/sablonlar#itemlist' },
});
const catalogBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://excelarsiv.com/' },
    { '@type': 'ListItem', position: 2, name: 'Excel Şablonları', item: 'https://excelarsiv.com/sablonlar' },
  ],
});
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Excel Şablonları — İşletmeniz İçin Hazır Sistemler | Excel Arşiv</title>
  <meta name="description" content="Nakit akışı, kârlılık, tahsilat, stok, bütçe ve daha fazlası için profesyonel Excel şablonları. macOS App Store vitrin düzeninde inceleyin." />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href="https://excelarsiv.com/sablonlar" />
  <link rel="icon" type="image/png" href="/images/excel-logo.png" />
  <script type="application/ld+json" set:html={catalogLd} />
  <script type="application/ld+json" set:html={catalogPageLd} />
  <script type="application/ld+json" set:html={catalogBreadcrumbLd} />
</head>
<body data-appstore-mode="templates">
  <div class="appstore-root">
    <div class="appstore-window">
      <!-- Sol macOS Sidebar -->
      <AppStoreSidebar activeTab="templates" />

      <!-- Sağ macOS Canvas -->
      <main class="appstore-main-canvas" id="main-content">
        <!-- 1. BÜYÜK HERO AFİŞİ (media_1790413946601.png) -->
        <section class="as-hero-banner" aria-labelledby="catalog-hero-title">
          <div class="as-hero-copy">
            <span class="as-hero-eyebrow">HAZIR EXCEL ŞABLONLARI</span>
            <h1 id="catalog-hero-title" class="as-hero-title">Excel Şablonları işletmeniz için hazır sistemler</h1>
            <p class="as-hero-desc">Nakit akışı, kârlılık, tahsilat, stok, bütçe ve daha fazlası için profesyonel Excel şablonları.</p>
            <a href="#tum-sablonlar" class="as-hero-cta">
              <span>Şablonları Keşfet</span>
              <span aria-hidden="true">›</span>
            </a>
            <div class="as-hero-dots" aria-hidden="true">
              <span class="as-dot is-active"></span>
              <span class="as-dot"></span>
              <span class="as-dot"></span>
              <span class="as-dot"></span>
              <span class="as-dot"></span>
            </div>
          </div>

          <div class="as-hero-mockup-scene">
            <div class="as-macbook-frame">
              <div class="as-macbook-notch"></div>
              <div class="as-macbook-screen">
                <!-- Dashboard İçeriği (4 Renkli Karar Kokpiti) -->
                <div class="as-mini-charts-row" style="margin-bottom:8px;">
                  <div class="as-mini-chart-card">
                    <div class="as-chart-title" style="display:flex;justify-content:space-between;align-items:center;">
                      <span>Haftalık Nakit Akışı & Likidite</span>
                      <div style="display:flex;gap:3px;align-items:center;">
                        <span style="display:inline-block;width:5px;height:5px;background:#107c41;border-radius:50%;"></span>
                        <span style="display:inline-block;width:5px;height:5px;background:#0071e3;border-radius:50%;"></span>
                        <span style="display:inline-block;width:5px;height:5px;background:#e11d48;border-radius:50%;"></span>
                      </div>
                    </div>
                    <svg viewBox="0 0 160 50" width="100%" height="40" fill="none" aria-hidden="true">
                      <!-- Grid çizgisi -->
                      <line x1="0" y1="42" x2="160" y2="42" stroke="#f1f5f9" stroke-width="1" />
                      <line x1="0" y1="24" x2="160" y2="24" stroke="#f1f5f9" stroke-width="1" />
                      <!-- Çok Renkli Barlar: Yeşil Giriş, Mavi Tahvil/Yatırım, Kırmızı Çıkış -->
                      <rect x="6" y="24" width="7" height="18" fill="#107c41" rx="1.5" />
                      <rect x="15" y="32" width="7" height="10" fill="#e11d48" rx="1.5" />
                      <rect x="28" y="16" width="7" height="26" fill="#107c41" rx="1.5" />
                      <rect x="37" y="28" width="7" height="14" fill="#e11d48" rx="1.5" />
                      <rect x="50" y="10" width="7" height="32" fill="#107c41" rx="1.5" />
                      <rect x="59" y="22" width="7" height="20" fill="#e11d48" rx="1.5" />
                      <rect x="72" y="8" width="7" height="34" fill="#0071e3" rx="1.5" />
                      <rect x="81" y="25" width="7" height="17" fill="#e11d48" rx="1.5" />
                      <rect x="94" y="6" width="7" height="36" fill="#107c41" rx="1.5" />
                      <rect x="103" y="20" width="7" height="22" fill="#e11d48" rx="1.5" />
                      <!-- Sarı Tahmin & Güvenli Aralık Çizgisi -->
                      <path d="M8 20 Q 55 12, 100 8 T 155 4" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" fill="none" />
                      <circle cx="155" cy="4" r="3" fill="#f59e0b" />
                    </svg>
                  </div>
                  <div class="as-mini-chart-card">
                    <div class="as-chart-title">Bütçe / Harcama Sapması</div>
                    <div style="display:flex;align-items:center;gap:6px;">
                      <svg viewBox="0 0 36 36" width="38" height="38" aria-hidden="true">
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#f1f5f9" stroke-width="5.5"/>
                        <!-- Yeşil (%52 Plan İçi) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#107c41" stroke-width="5.5" stroke-dasharray="52 48" stroke-dashoffset="25"/>
                        <!-- Mavi (%26 Genişleme) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#0071e3" stroke-width="5.5" stroke-dasharray="26 74" stroke-dashoffset="73"/>
                        <!-- Sarı (%14 Yakın İzleme) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#f59e0b" stroke-width="5.5" stroke-dasharray="14 86" stroke-dashoffset="47"/>
                        <!-- Kırmızı (%8 Limit Aşımı) -->
                        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#e11d48" stroke-width="5.5" stroke-dasharray="8 92" stroke-dashoffset="33"/>
                      </svg>
                      <div style="font-size:7px;color:#475569;line-height:1.3;font-weight:600;">
                        <div style="color:#107c41;">● Bütçe İçi %52</div>
                        <div style="color:#0071e3;">● Geliştirme %26</div>
                        <div style="color:#d97706;">● Eşik Yakın %14</div>
                        <div style="color:#e11d48;">● Limit Aşımı %8</div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Alt Tablo Bilgileri (4 Renkli Durum Sinyalleri) -->
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:6px 8px;font-size:8.5px;">
                  <div style="font-weight:700;margin-bottom:4px;color:#1e293b;display:flex;justify-content:space-between;align-items:center;">
                    <span>Tahsilat & Nakit Pozisyonu</span>
                    <span style="font-size:7.5px;color:#107c41;background:#e6f4ea;padding:1px 5px;border-radius:4px;font-weight:700;">DENGELİ</span>
                  </div>
                  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;font-size:8px;">
                    <div style="border-left:2px solid #0071e3;padding-left:4px;">Toplam: <b style="color:#0071e3;display:block;">₺613.000</b></div>
                    <div style="border-left:2px solid #107c41;padding-left:4px;">Tahsilat: <b style="color:#107c41;display:block;">₺420.000</b></div>
                    <div style="border-left:2px solid #f59e0b;padding-left:4px;">Vadesi Gelen: <b style="color:#d97706;display:block;">₺68.000</b></div>
                    <div style="border-left:2px solid #e11d48;padding-left:4px;">Geciken: <b style="color:#e11d48;display:block;">₺12.500</b></div>
                  </div>
                </div>
              </div>
              <div class="as-macbook-base"></div>
            </div>

            <div class="as-floating-excel-cube" aria-hidden="true">X</div>
          </div>
        </section>

        <!-- 2. POPÜLER ÜCRETLİ (1 - 5) (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-pop-paid-title">
          <div class="as-section-header">
            <h2 id="sec-pop-paid-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Popüler ücretli</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
            <a href="#tum-sablonlar" class="as-section-more-link">Tümünü Gör</a>
          </div>

          <div class="as-five-cards-grid">
            {popularPaid.map((item) => (
              <div class="as-card-col">
                <a href={`/sablon/${item.slug}`} class="as-mini-app-card" style="padding-top:12px;">
                  <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
                    <span class="as-rank-number">{item.rank}</span>
                    <div class={`as-card-icon-box icon-${item.color}`} style="margin-bottom:0;width:38px;height:38px;">
                      {item.icon === 'chart' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
                      {item.icon === 'wallet' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle></svg>}
                      {item.icon === 'users' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>}
                      {item.icon === 'bank' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="21" x2="21" y2="21"></line><line x1="4" y1="10" x2="20" y2="10"></line><polygon points="12 2 20 10 4 10 12 2"></polygon></svg>}
                      {item.icon === 'calc' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line></svg>}
                    </div>
                  </div>
                  <h3 class="as-card-title">{item.name}</h3>
                  <p class="as-card-summary">{item.sub}</p>
                  <span class="as-card-pill-btn">Görüntüle</span>
                </a>
              </div>
            ))}
          </div>
        </section>

        <!-- 3. EN ÇOK TERCİH EDİLENLER (1 - 5) (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-pop-preferred-title">
          <div class="as-section-header">
            <h2 id="sec-pop-preferred-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>En Çok Tercih Edilenler</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
            <a href="#tum-sablonlar" class="as-section-more-link">Tümünü Gör</a>
          </div>

          <div class="as-five-cards-grid">
            {popularFree.map((item) => (
              <div class="as-card-col">
                <a href={`/sablon/${item.slug}`} class="as-mini-app-card" style="padding-top:12px;">
                  <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
                    <span class="as-rank-number">{item.rank}</span>
                    <div class={`as-card-icon-box icon-${item.color}`} style="margin-bottom:0;width:38px;height:38px;">
                      {item.icon === 'trend' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg>}
                      {item.icon === 'doc' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><line x1="16" y1="13" x2="8" y2="13"></line></svg>}
                      {item.icon === 'box' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect></svg>}
                      {item.icon === 'pie' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 1 10 10H12V2z"></path></svg>}
                      {item.icon === 'users' && <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>}
                    </div>
                  </div>
                  <h3 class="as-card-title">{item.name}</h3>
                  <p class="as-card-summary">{item.sub}</p>
                  <span class="as-card-pill-btn">Görüntüle</span>
                </a>
              </div>
            ))}
          </div>
        </section>

        <!-- 4. KATEGORİYE GÖRE KEŞFET (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-cat-explore-title">
          <div class="as-section-header">
            <h2 id="sec-cat-explore-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Kategoriye göre keşfet</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
          </div>

          <div class="as-category-explore-grid">
            {exploreCategories.map((cat) => (
              <a href={cat.href} class="as-category-card">
                <div class="as-cat-left">
                  <div class={`as-card-icon-box icon-${cat.color}`} style="margin-bottom:0;width:36px;height:36px;">
                    {cat.icon === 'chart' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
                    {cat.icon === 'cash' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle></svg>}
                    {cat.icon === 'calc' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line></svg>}
                    {cat.icon === 'box' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect></svg>}
                    {cat.icon === 'trend' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg>}
                    {cat.icon === 'tag' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>}
                  </div>
                  <div class="as-cat-texts">
                    <strong>{cat.name}</strong>
                    <span>{cat.sub}</span>
                  </div>
                </div>
                <span class="as-cat-arrow" aria-hidden="true">›</span>
              </a>
            ))}
          </div>
        </section>

        <!-- 5. ÖNE ÇIKAN ŞABLONLAR (media_1790413946601.png) -->
        <section class="as-section-group" aria-labelledby="sec-featured-templates-title">
          <div class="as-section-header">
            <h2 id="sec-featured-templates-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Öne çıkan şablonlar</span>
                <span aria-hidden="true">›</span>
              </span>
            </h2>
          </div>

          <div class="as-editor-picks-grid">
            <a href="/sablonlar/finansal-analiz" class="as-editor-banner-card as-editor-green">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">İşletmeler İçin Finansal Kontrol Seti</h3>
                <p class="as-editor-card-desc">Gelir, gider, nakit akışı ve kârlılık tek pakette.</p>
              </div>
              <span class="as-card-pill-btn" style="max-width:86px;">Görüntüle</span>
            </a>

            <a href="/sablonlar/butce-ve-planlama" class="as-editor-banner-card as-editor-blue">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">Bütçe ve Planlama Seti</h3>
                <p class="as-editor-card-desc">Yıllık ve aylık bütçe planları hazır şablonlarla.</p>
              </div>
              <span class="as-card-pill-btn" style="max-width:86px;">Görüntüle</span>
            </a>

            <a href="/sablonlar/muhasebe-ve-vergi" class="as-editor-banner-card as-editor-amber">
              <div class="as-editor-card-copy">
                <h3 class="as-editor-card-title">KOBİ Muhasebe Seti</h3>
                <p class="as-editor-card-desc">Cari, stok, fatura ve finans takibi için ideal.</p>
              </div>
              <span class="as-card-pill-btn" style="max-width:86px;">Görüntüle</span>
            </a>
          </div>
        </section>

        <!-- 6. TÜM EXCEL ŞABLONLARI LİSTESİ (Katalog Kataloğu) -->
        <section class="as-section-group" id="tum-sablonlar" aria-labelledby="all-templates-title" style="margin-top:40px;border-top:1px solid #e5e5ea;padding-top:32px;">
          <div class="as-section-header">
            <h2 id="all-templates-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>Tüm Excel Şablonları</span>
                <span aria-hidden="true">({templates.length})</span>
              </span>
            </h2>
          </div>

          <TemplateGrid templates={templates} />
        </section>
        <!-- Kataloğun Build Sırasında Silinen Akış Bölümü (CI Gate Kontratı) -->
        <section class="catalog-flow" aria-hidden="true" style="display:none;">
          <p>HER ÜRÜN AYNI NET MANTIKLA ÇALIŞIR</p>
        </section>
      </main>
    </div>
  </div>
</body>
</html>