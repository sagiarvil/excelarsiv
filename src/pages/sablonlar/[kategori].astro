---
import '../../styles/global.css';
import '../../styles/appstore-theme.css';
import AppStoreSidebar from '../../components/appstore/AppStoreSidebar.astro';
import TemplateGrid from '../../components/catalog/TemplateGrid.astro';
import N8nWorkflowVisualizer from '../../components/automation/N8nWorkflowVisualizer.astro';
import { getCollection } from 'astro:content';
import { getTemplatesByCategory, getAllTemplates } from '../../lib/templates';
import { categories, getCategoryName } from '../../lib/categories';
import { kategoriKarar } from '../../data/kategori-karar';

type WorkflowTheme = 'emerald' | 'blue' | 'purple' | 'amber' | 'coral' | 'indigo';

interface CategoryWorkflowConfig {
  theme: WorkflowTheme;
  badge: string;
  sourceLabel: string;
  sourceType: string;
  step1Title: string;
  step1Sub: string;
  step2Title: string;
  step2Sub: string;
  aiRole1: string;
  aiRole2: string;
  aiRole3: string;
  output1Title: string;
  output2Title: string;
}

const categoryWorkflowMap: Record<string, CategoryWorkflowConfig> = {
  'nakit-akisi': {
    theme: 'emerald',
    badge: '13 HAFTALIK NAKİT & LİKİDİTE HATTI',
    sourceLabel: 'Banka Ekstresi & POS Mizanı',
    sourceType: 'Nakit Girdisi',
    step1Title: 'Ekstre Ayrıştırma & Mizan Çekimi',
    step1Sub: 'MT940, CSV & Banka Entegrasyonu',
    step2Title: 'Likidite Normalizasyonu',
    step2Sub: '13 Haftalık Dinamik Nakit Takvimi',
    aiRole1: 'Nakit Açığı & Stres Simülasyonu',
    aiRole2: 'Vade & Faiz Risk Denetimi',
    aiRole3: 'Çoklu Banka Bakiye Çapraz Kontrol',
    output1Title: 'Nakit Akış Karar Kokpiti',
    output2Title: 'Kritik Bakiye WhatsApp/Slack Alarmı'
  },
  'muhasebe-ve-vergi': {
    theme: 'purple',
    badge: 'VERGİ & MEVZUAT OTONOM DENETİMİ',
    sourceLabel: 'e-Fatura / e-Arşiv / Mizan',
    sourceType: 'Mali Veri',
    step1Title: 'KDV & Tevkifat Ayrıştırma',
    step1Sub: '213 VUK & GVK 2026 Parse',
    step2Title: 'Matrah & Beyan Normalizasyonu',
    step2Sub: 'Kümülatif Vergi & SGK Haritası',
    aiRole1: 'Vergi Matrahı & Beyan Doğrulama',
    aiRole2: 'Mevzuat & İstisna Çapraz Denetimi',
    aiRole3: 'GİB & e-Defter Format Kontrolü',
    output1Title: 'Mali Müşavir Karar Paneli',
    output2Title: 'Vergi/SGK Son Gün SMS & E-posta'
  },
  'personel-ve-bordro': {
    theme: 'coral',
    badge: '4857 İŞ KANUNU & BORDRO MOTORU',
    sourceLabel: 'Puantaj & Personel Kartları',
    sourceType: 'İK Verisi',
    step1Title: 'Puantaj & Vardiya Çözümleme',
    step1Sub: 'Parmak İzi, Kartlı Geçiş & Mesai',
    step2Title: 'Bordro Parametre Normalizasyonu',
    step2Sub: 'SGK Tavanı & Gelir Vergisi Dilimi',
    aiRole1: 'Kıdem/İhbar & Net-Brüt Ayrıştırma',
    aiRole2: '4857 Sayılı Kanun Madde Kontrolü',
    aiRole3: 'Asgari Geçim & Muafiyet Çapraz Teyit',
    output1Title: 'İnsan Kaynakları Yönetim Kokpiti',
    output2Title: 'Bordro Onay & Muhasebe Fişi'
  },
  'stok-ve-uretim': {
    theme: 'amber',
    badge: 'STOK DÖNGÜSÜ & FİRE KONTROLÜ',
    sourceLabel: 'Depo Sayım & İrsaliye Verisi',
    sourceType: 'Depo & Lojistik',
    step1Title: 'Barkod & Lot Ayrıştırma',
    step1Sub: 'FIFO/LIFO & Barkod Verisi',
    step2Title: 'Emniyet Stoku Normalizasyonu',
    step2Sub: 'Optimum Sipariş & Tedarik Süresi',
    aiRole1: 'Stok Devir Hızı & Atıl Sermaye',
    aiRole2: 'Üretim Reçetesi & Fire Analizi',
    aiRole3: 'Tedarikçi Teslimat Sapma Teyidi',
    output1Title: 'Stok & Tedarik Karar Kokpiti',
    output2Title: 'Kritik Stok Seviyesi Telegram/SMS'
  },
  'butce-ve-planlama': {
    theme: 'blue',
    badge: 'DÖNEMSEL BÜTÇE & MALİYET HATTI',
    sourceLabel: 'Gelir-Gider & Masraf Kalemleri',
    sourceType: 'Bütçe Verisi',
    step1Title: 'Masraf Merkezi Ayrıştırma',
    step1Sub: 'Departman Bütçe & Fiili Gerçekleşme',
    step2Title: 'Sapma Analizi & Normalizasyon',
    step2Sub: 'Varyans & Dönemsel Karşılaştırma',
    aiRole1: 'Bütçe Aşımı & Finansal Projeksiyon',
    aiRole2: 'Maliyet Optimizasyonu Önerileri',
    aiRole3: 'Yıllık Hedef Çapraz Doğrulama',
    output1Title: 'Bütçe & Planlama Karar Kokpiti',
    output2Title: 'Aşım Raporu Yönetim Özeti'
  },
  'finansal-analiz': {
    theme: 'indigo',
    badge: 'PATRON PANELİ & EBITDA ANALİZİ',
    sourceLabel: 'Bilanço & Gelir Tablosu',
    sourceType: 'Finansal Tablolar',
    step1Title: 'Rasyo & Marj Ayrıştırma',
    step1Sub: 'Likidite, Kaldıraç & Kârlılık',
    step2Title: 'Konsolide Rapor Normalizasyonu',
    step2Sub: 'TTK 376 Borca Batıklık Matrisi',
    aiRole1: 'EBITDA & Kârlılık Muhakemesi',
    aiRole2: 'Özkaynak & Sermaye Koruma Denetimi',
    aiRole3: 'Sektörel Benchmark Çapraz Teyit',
    output1Title: 'Üst Yönetim Karar Kokpiti',
    output2Title: 'Haftalık Yönetim Kurulu Brifingi'
  },
  'satis-ve-fiyatlama': {
    theme: 'amber',
    badge: 'NET MARJ & POS FİYATLAMA HATTI',
    sourceLabel: 'Satış Verisi & Komisyon Oranları',
    sourceType: 'Satış Girdisi',
    step1Title: 'Komisyon & İskonto Ayrıştırma',
    step1Sub: 'Pazaryeri Kesintileri & POS Vadesi',
    step2Title: 'Birim Kârlılık Normalizasyonu',
    step2Sub: 'Gerçek Net Marj & Eşik Fiyat',
    aiRole1: 'Fiyat Elastikiyeti & Kâr Marjı',
    aiRole2: 'Pazaryeri Komisyon Doğrulaması',
    aiRole3: 'Nakit Tahsilat Günü Çapraz Kontrol',
    output1Title: 'Satış & Fiyatlama Kokpiti',
    output2Title: 'Marj Altı Satış Uyarı Bildirimi'
  }
};

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { kategori: category.slug },
    props: { categoryName: category.name },
  }));
}

interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const categorySlug = Astro.params.kategori!;
const allTemplates = await getAllTemplates();
const templates = allTemplates.filter((t) => t.categorySlug === categorySlug);
const categoryLabel = getCategoryName(categorySlug);
const category = categories.find((item) => item.slug === categorySlug);
const karar = kategoriKarar[categorySlug as keyof typeof kategoriKarar];
const guides = (await getCollection('guides'))
  .filter((guide) => guide.data.category === categorySlug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'))
  .slice(0, 4);
const seoTitle = category?.seoTitle ?? `${categoryLabel} Excel Şablonları | Excel Arşiv`;
const seoDescription = category?.seoDescription ?? `${categoryLabel} alanında hazır Excel çalışma sistemlerini karşılaştırın ve demo ile inceleyin.`;
const primaryQuery = category?.primaryQuery ?? `${categoryLabel.toLocaleLowerCase('tr-TR')} excel`;
const heroDescription = category?.description ?? `${categoryLabel} alanında hazır Excel çalışma sistemleri.`;

const currentWorkflow = categoryWorkflowMap[categorySlug] ?? {
  theme: 'emerald' as WorkflowTheme,
  badge: `${categoryLabel.toUpperCase()} VERİ & OTOMASYON MİMARİSİ`,
  sourceLabel: 'Operasyonel ERP / Veri Kaynağı',
  sourceType: 'Girdi Verisi',
  step1Title: 'Veri Ayrıştırma & Temizleme',
  step1Sub: 'CSV, Tablo & Ekstre Parsing',
  step2Title: 'Normalizasyon & Standartlaştırma',
  step2Sub: 'Dinamik AST Veri Haritası',
  aiRole1: 'Muhakeme & Senaryo Analizi',
  aiRole2: 'Mevzuat & Standart Denetimi',
  aiRole3: 'Çoklu Veri Çapraz Teyit',
  output1Title: `${categoryLabel} Excel Karar Kokpiti`,
  output2Title: 'Otonom Durum & Alarm Bildirimi'
};

const categoryLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL(`/sablonlar/${categorySlug}#itemlist`, Astro.site).toString(),
  numberOfItems: templates.length,
  itemListElement: templates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${template.slug}`, Astro.site).toString(),
    name: template.name,
  })),
});
const categoryPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL(`/sablonlar/${categorySlug}#collection`, Astro.site).toString(),
  url: new URL(`/sablonlar/${categorySlug}`, Astro.site).toString(),
  name: `${categoryLabel} Excel Şablonları`,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL(`/sablonlar/${categorySlug}#itemlist`, Astro.site).toString() },
});
const categoryBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Excel Şablonları', item: new URL('/sablonlar', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: new URL(`/sablonlar/${categorySlug}`, Astro.site).toString() },
  ],
});
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href={new URL(`/sablonlar/${categorySlug}`, Astro.site).toString()} />
  <link rel="icon" type="image/png" href="/images/excel-logo.png" />
  <script type="application/ld+json" set:html={categoryLd} />
  <script type="application/ld+json" set:html={categoryPageLd} />
  <script type="application/ld+json" set:html={categoryBreadcrumbLd} />
</head>
<body data-appstore-mode="templates">
  <div class="appstore-root">
    <div class="appstore-window">
      <!-- Sol macOS Sidebar -->
      <AppStoreSidebar activeTab="templates" />

      <!-- Sağ macOS Canvas -->
      <main class="appstore-main-canvas" id="main-content">
        <!-- 1. Kategori Başlık Afişi (App Store Banner Stili) -->
        <section class="as-category-header-banner" aria-labelledby="cat-header-title">
          <nav class="as-category-breadcrumb" aria-label="Ekmek kırıntısı">
            <a href="/">Ana Sayfa</a>
            <span aria-hidden="true">›</span>
            <a href="/sablonlar">Şablonlar</a>
            <span aria-hidden="true">›</span>
            <span>{categoryLabel}</span>
          </nav>
          <span class="as-category-eyebrow">{primaryQuery}</span>
          <h1 id="cat-header-title" class="as-category-title">{categoryLabel} Excel Şablonları</h1>
          <p class="as-category-desc">{heroDescription} Gerçek ürün ekranlarını ve karar kokpitlerini inceleyin.</p>

          <!-- Diğer Kategoriler Hapları (Hızlı Filtreleme) -->
          <div class="as-category-filter-chips" aria-label="Kategoriler Arası Geçiş">
            {categories.map((cat) => (
              <a
                href={`/sablonlar/${cat.slug}`}
                class={`as-filter-chip ${cat.slug === categorySlug ? 'is-active' : ''}`}
              >
                {cat.name}
              </a>
            ))}
          </div>
        </section>

        <!-- 2. Karar Matrisi / Seçim Rehberi (Varsa) -->
        {karar && (
          <section class="as-category-decision-box" aria-labelledby="category-pick-title">
            <h2 id="category-pick-title">Bu kategoride hangi sistemi seçmeliyim?</h2>
            <ol class="as-category-decision-grid">
              {karar.secim.map((item) => {
                const match = allTemplates.find((template) => template.slug === item.slug);
                return (
                  <li>
                    <a href={`/sablon/${item.slug}`} class="as-decision-card">
                      <span class="as-decision-problem">{item.problem}</span>
                      <strong class="as-decision-name">{match?.name ?? item.slug}</strong>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        <!-- 3. Şablonlar Listesi (App Store Kart Izgarası) -->
        <section class="as-section-group" aria-labelledby="cat-templates-grid-title">
          <div class="as-section-header">
            <h2 id="cat-templates-grid-title" class="as-section-title">
              <span class="as-section-title-link">
                <span>{categoryLabel} Şablonları</span>
                <span aria-hidden="true">({templates.length})</span>
              </span>
            </h2>
          </div>

          <TemplateGrid
            templates={templates}
            allTemplates={allTemplates}
            activeCategory={categorySlug}
            isCategoryPage={true}
          />
        </section>

        <!-- 3.1 Kategori Otomasyon ve Veri Akış Mimarisi (n8n & AI Karar Hattı) -->
        <section class="as-category-flow-section" style="margin: 36px 0 24px; padding-bottom: 24px; border-bottom: 1px solid var(--as-border);" aria-labelledby="cat-flow-heading">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
            <h2 id="cat-flow-heading" class="as-section-headline" style="margin: 0; font-size: 19px; font-weight: 700; letter-spacing: -0.015em;">{categoryLabel} Otomasyon &amp; Veri Akış Hattı ›</h2>
            <span style="font-size: 13px; color: #107c41; font-weight: 700;">● Otonom Karar Altyapısı</span>
          </div>
          <p class="as-section-subline" style="margin-bottom: 18px; color: var(--as-text-secondary); font-size: 14px;">{categoryLabel} operasyonlarınızda ham verilerin temizlenmesi, 3'lü AI doğrulaması ve hatasız Excel kokpitine dökülme süreci</p>

          <N8nWorkflowVisualizer
            compact={true}
            theme={currentWorkflow.theme}
            badge={currentWorkflow.badge}
            title={`${categoryLabel} — Uçtan Uca Otomasyon Hattı`}
            subtitle="Ham girdiden çoklu model çapraz teyidine ve Excel karar kokpitine tam entegre mimari"
            sourceLabel={currentWorkflow.sourceLabel}
            sourceType={currentWorkflow.sourceType}
            step1Title={currentWorkflow.step1Title}
            step1Sub={currentWorkflow.step1Sub}
            step2Title={currentWorkflow.step2Title}
            step2Sub={currentWorkflow.step2Sub}
            aiRole1={currentWorkflow.aiRole1}
            aiRole2={currentWorkflow.aiRole2}
            aiRole3={currentWorkflow.aiRole3}
            output1Title={currentWorkflow.output1Title}
            output2Title={currentWorkflow.output2Title}
          />
        </section>

        <!-- 4. Uygulama Rehberleri (Varsa) -->
        {guides.length > 0 && (
          <aside class="as-category-guides-section" aria-labelledby="category-guides-title">
            <div class="as-section-header">
              <h2 id="category-guides-title" class="as-section-title">
                <span class="as-section-title-link">
                  <span>Uygulama Rehberleri</span>
                  <span aria-hidden="true">›</span>
                </span>
              </h2>
            </div>
            <div class="as-category-guides-grid">
              {guides.map((guide) => (
                <a href={`/rehber/${guide.id}`} class="as-guide-card">
                  <span class="as-guide-eyebrow">{guide.data.primaryQuery}</span>
                  <strong class="as-guide-title">{guide.data.title}</strong>
                  <p class="as-guide-desc">{guide.data.description}</p>
                  <span class="as-guide-arrow" aria-hidden="true">Rehberi Aç ›</span>
                </a>
              ))}
            </div>
          </aside>
        )}

        <!-- 5. Kategori SSS (Varsa) -->
        {karar && karar.faq && karar.faq.length > 0 && (
          <section class="as-privacy-box" style="margin-top:36px;" aria-labelledby="category-faq-title">
            <h2 id="category-faq-title" class="as-privacy-title">Sıkça Sorulan Sorular</h2>
            <div style="display:flex;flex-direction:column;gap:12px;margin-top:14px;">
              {karar.faq.map((item) => (
                <details style="padding:12px 14px;background:#fbfbfd;border:1px solid #e5e5ea;border-radius:10px;">
                  <summary style="font-weight:600;font-size:13.5px;cursor:pointer;color:var(--as-text-primary);">{item.question}</summary>
                  <p style="margin:8px 0 0;font-size:13px;line-height:1.55;color:var(--as-text-secondary);">{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- 6. Footer -->
        <footer class="as-store-footer" style="margin-top:40px;">
          <div class="as-store-footer-top">
            <div class="as-store-footer-links">
              <a href="/sablonlar">Tüm Şablonlar</a>
              <a href="/lisans">Lisans Koşulları</a>
              <a href="/gizlilik-politikasi">Gizlilik Politikası</a>
              <a href="/teslimat-ve-iade">İade ve Teslimat</a>
              <a href="/sss">Destek & SSS</a>
            </div>
            <div class="as-store-footer-badge" style="margin-top: 14px; margin-bottom: 6px;">
              <div class="hh-authority-badge" data-domain="excelarsiv.com" data-theme="light">
                <a href="https://excelarsiv.com" title="Excel Arşiv Teknik Otorite ve Doğrulama Skoru">
                  <img src="/images/brand/verified-authority-seal.svg" alt="Excel Arşiv Doğrulanmış Web Otoritesi" width="220" height="42" loading="lazy" style="border:none;display:inline-block;" />
                </a>
              </div>
            </div>
            <span class="as-store-copyright">© 2026 Excel Arşiv Inc. Tüm hakları saklıdır. macOS App Store Vitrin Deneyimi.</span>
          </div>
        </footer>
      </main>
    </div>
  </div>
</body>
</html>

