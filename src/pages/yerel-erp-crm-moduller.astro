  <style>
    :root {
      --ea-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --ea-navy: #0F172A;
      --ea-navy-light: #1E293B;
      --ea-blue: #0284C7;
      --ea-blue-hover: #0369A1;
      --ea-green: #059669;
      --ea-emerald: #10B981;
      --ea-amber: #D97706;
      --ea-rose: #E11D48;
      --ea-bg: #FFFFFF;
      --ea-canvas: #F8FAFC;
      --ea-border: #E2E8F0;
      --ea-border-strong: #CBD5E1;
      --ea-text: #0F172A;
      --ea-muted: #64748B;
      --ea-sub: #475569;

      /* Pastel Açık Renk Kutular Teması (Zero-Slop Color Palette) */
      --box-amber-bg: #FFFBEB;
      --box-amber-border: #FCD34D;
      --box-sky-bg: #F0F9FF;
      --box-sky-border: #7DD3FC;
      --box-violet-bg: #F5F3FF;
      --box-violet-border: #C4B5FD;
      --box-slate-bg: #F1F5F9;
      --box-slate-border: #94A3B8;
      --box-emerald-bg: #ECFDF5;
      --box-emerald-border: #6EE7B7;
      --box-rose-bg: #FFF1F2;
      --box-rose-border: #FDA4AF;
      --box-teal-bg: #F0FDFA;
      --box-teal-border: #5EEAD4;
      --box-indigo-bg: #EEF2FF;
      --box-indigo-border: #A5B4FC;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--ea-font);
      background-color: var(--ea-bg);
      color: var(--ea-text);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 80px;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .ea-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px;
    }

    /* Top Bar Header */
    .ea-header {
      border-bottom: 1px solid var(--ea-border);
      background: #FFFFFF;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .ea-header__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }
    .ea-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 17px;
      color: var(--ea-navy);
    }
    .ea-brand img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }
    .ea-header__nav {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ea-sub);
    }
    .ea-header__nav a:hover {
      color: var(--ea-blue);
    }
    .ea-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--ea-navy);
      color: #FFFFFF !important;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .ea-btn-primary:hover {
      background: var(--ea-navy-light);
      transform: translateY(-1px);
    }
    .ea-btn-whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #25D366;
      color: #FFFFFF !important;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .ea-btn-whatsapp:hover {
      background: #1EBE5B;
      transform: translateY(-1px);
    }
    .ea-btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--ea-border-strong);
      background: #FFFFFF;
      color: var(--ea-navy);
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .ea-btn-outline:hover {
      background: var(--ea-canvas);
      border-color: var(--ea-navy);
    }

    /* Hero Section */
    .ea-hero {
      padding: 48px 0 36px;
      background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
      border-bottom: 1px solid var(--ea-border);
    }
    .ea-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #E0F2FE;
      color: #0369A1;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 18px;
      border: 1px solid #BAE6FD;
    }
    .ea-hero__title {
      font-size: 34px;
      line-height: 1.25;
      font-weight: 800;
      color: var(--ea-navy);
      letter-spacing: -0.6px;
      max-width: 900px;
      margin-bottom: 16px;
    }
    .ea-hero__desc {
      font-size: 16.5px;
      line-height: 1.6;
      color: var(--ea-sub);
      max-width: 860px;
      margin-bottom: 24px;
    }
    .ea-hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-bottom: 36px;
    }

    /* 4 Temel Garanti Metrik Kartı */
    .ea-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .ea-metric-card {
      border-radius: 12px;
      padding: 18px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .ea-metric-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.05);
    }
    .ea-metric-card--sky {
      background: var(--box-sky-bg);
      border: 1px solid var(--box-sky-border);
    }
    .ea-metric-card--emerald {
      background: var(--box-emerald-bg);
      border: 1px solid var(--box-emerald-border);
    }
    .ea-metric-card--amber {
      background: var(--box-amber-bg);
      border: 1px solid var(--box-amber-border);
    }
    .ea-metric-card--violet {
      background: var(--box-violet-bg);
      border: 1px solid var(--box-violet-border);
    }

    .ea-metric-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .ea-metric-card h3 {
      font-size: 14px;
      font-weight: 700;
      color: var(--ea-navy);
      margin-bottom: 4px;
    }
    .ea-metric-card p {
      font-size: 12.5px;
      color: var(--ea-sub);
      line-height: 1.45;
    }

    /* Section Global Headers */
    .ea-section {
      padding: 56px 0;
      border-bottom: 1px solid var(--ea-border);
    }
    .ea-section-tag {
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--ea-blue);
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .ea-section-title {
      font-size: 26px;
      font-weight: 800;
      color: var(--ea-navy);
      letter-spacing: -0.4px;
      margin-bottom: 12px;
    }
    .ea-section-subtitle {
      font-size: 15px;
      color: var(--ea-sub);
      max-width: 820px;
      line-height: 1.55;
      margin-bottom: 32px;
    }

    /* Canlı Showcase Kutusu */
    .ea-showcase-box {
      border: 1px solid var(--ea-border);
      border-radius: 14px;
      background: #FFFFFF;
      overflow: hidden;
      box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
      margin-bottom: 24px;
    }
    .ea-showcase-header {
      background: var(--ea-canvas);
      padding: 14px 20px;
      border-bottom: 1px solid var(--ea-border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .ea-showcase-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ECFDF5;
      color: #065F46;
      border: 1px solid #A7F3D0;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 11.5px;
      font-weight: 700;
    }
    .ea-showcase-body {
      padding: 24px;
    }
    .ea-cockpit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 18px;
    }
    .ea-cockpit-item {
      border-radius: 12px;
      padding: 18px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .ea-cockpit-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px -4px rgba(0, 0, 0, 0.04);
    }
    .ea-cockpit-item--sky { background: var(--box-sky-bg); border: 1px solid var(--box-sky-border); }
    .ea-cockpit-item--emerald { background: var(--box-emerald-bg); border: 1px solid var(--box-emerald-border); }
    .ea-cockpit-item--rose { background: var(--box-rose-bg); border: 1px solid var(--box-rose-border); }
    .ea-cockpit-item--amber { background: var(--box-amber-bg); border: 1px solid var(--box-amber-border); }
    .ea-cockpit-item--violet { background: var(--box-violet-bg); border: 1px solid var(--box-violet-border); }
    .ea-cockpit-item--teal { background: var(--box-teal-bg); border: 1px solid var(--box-teal-border); }

    .ea-cockpit-item h4 {
      font-size: 14.5px;
      font-weight: 700;
      color: var(--ea-navy);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ea-cockpit-item ul {
      list-style: none;
      font-size: 12.5px;
      color: var(--ea-sub);
      line-height: 1.6;
    }
    .ea-cockpit-item ul li {
      padding-left: 16px;
      position: relative;
      margin-bottom: 4px;
    }
    .ea-cockpit-item ul li::before {
      content: "•";
      position: absolute;
      left: 4px;
      color: var(--ea-blue);
      font-weight: bold;
    }

    /* Modules Grid (6 Modules with Distinct Light Colors) */
    .ea-modules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }
    .ea-module-card {
      border-radius: 14px;
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .ea-module-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px -4px rgba(0, 0, 0, 0.05);
    }
