  <!-- SCRIPT: Navigasyon ve Menü İşleyişi (Ana Sayfa ile Uyumlu) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('menuOpen');
      const menuDialog = document.getElementById('mobileMenu');
      if (menuBtn && menuDialog) {
        menuBtn.addEventListener('click', () => {
          menuDialog.showModal();
          document.body.classList.add('locked');
        });
      }
      document.querySelectorAll('[data-close]').forEach(btn => {
        btn.addEventListener('click', () => {
          const dlg = document.getElementById(btn.getAttribute('data-close'));
          if (dlg) {
            dlg.close();
            document.body.classList.remove('locked');
          }
        });
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.nav-drop')) {
          document.querySelectorAll('.nav-drop').forEach(d => d.removeAttribute('open'));
        }
      });
    });
  </script>
